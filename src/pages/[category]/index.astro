---
// src/pages/[category]/index.astro
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import {
  CALCULATORS,
  CATEGORY_METADATA,
  type CategoryId,
  type CategoryMeta,
} from '../../data/calculatorRegistry';
import { ALL_FRONTEND_CALCULATORS } from '../../data/calculators';
import { SEARCHABLE_CALCULATORS } from '../../data/searchDatabase';
import { CATEGORY_PAGE_CONFIGS } from '../../data/categoryConfig';

const allSearchableToolsJson = JSON.stringify(SEARCHABLE_CALCULATORS);

export async function getStaticPaths() {
  // Exclude categories that have dedicated static directories with index.astro
  const dedicatedCategoryDirs = new Set<CategoryId>(['finance', 'everyday', 'insurance']);
  const categoryKeys = (Object.keys(CATEGORY_METADATA) as CategoryId[]).filter(
    (catId) => !dedicatedCategoryDirs.has(catId)
  );
  return categoryKeys.map((catId) => ({
    params: { category: catId },
    props: {
      categoryKey: catId,
      meta: CATEGORY_METADATA[catId],
    },
  }));
}

interface Props {
  categoryKey: CategoryId;
  meta: CategoryMeta;
}

const { categoryKey, meta } = Astro.props;
const catConfig = CATEGORY_PAGE_CONFIGS[categoryKey];

const cleanCatName = meta.name.replace(/\s+Calculators$/i, '');
const fullCatTitle = `${cleanCatName} Calculators`;
const categoryIcon = catConfig?.icon || '🧮';

const catalogCalcs = ALL_FRONTEND_CALCULATORS.filter((c) => c.category === categoryKey);
const categoryCalcs = CALCULATORS.filter((c) => c.category === categoryKey);

// Combine and deduplicate calculators for this category
const seenSlugs = new Set<string>();
const allCalcs: Array<{
  id: string;
  name: string;
  shortName: string;
  href: string;
  description: string;
  category: string;
  badge: string;
  icon: string;
  subNiche?: string;
}> = [];

// Helper to find override from config
function getOverride(id: string) {
  return catConfig?.tools.find((t) => t.id === id);
}

// 1. Process catalogCalcs
catalogCalcs.forEach((c) => {
  if (!seenSlugs.has(c.slug)) {
    seenSlugs.add(c.slug);
    const ov = getOverride(c.slug);
    allCalcs.push({
      id: c.slug,
      name: ov?.name || c.name,
      shortName: ov?.shortName || c.name.replace(/\s+Calculator$/i, '').trim(),
      href: c.href || `/${c.category}/${c.slug}/`,
      description: ov?.description || (c as any).description || '',
      category: c.category,
      badge: ov?.badge || (c as any).badge || 'Verified',
      icon: ov?.icon || (c as any).icon || categoryIcon,
      subNiche: ov?.subNiche,
    });
  }
});

// 2. Process categoryCalcs
categoryCalcs.forEach((c) => {
  if (!seenSlugs.has(c.id)) {
    seenSlugs.add(c.id);
    const ov = getOverride(c.id);
    allCalcs.push({
      id: c.id,
      name: ov?.name || c.name,
      shortName: ov?.shortName || c.name.replace(/\s+Calculator$/i, '').trim(),
      href: `/${c.category}/${c.id}/`,
      description: ov?.description || c.description || '',
      category: c.category,
      badge: ov?.badge || c.badge || 'Verified',
      icon: ov?.icon || categoryIcon,
      subNiche: ov?.subNiche,
    });
  }
});

// Fallback education cards if category not in config
const defaultEducationCards = [
  {
    icon: '🔒',
    title: '100% Client-Side Privacy',
    desc: 'All computations execute directly in your web browser. No data, inputs, or calculations are ever uploaded to any server.',
  },
  {
    icon: '⚡',
    title: 'Real-Time Edge Calculation',
    desc: 'Instant updates on every slider adjustment and keystroke with sub-millisecond calculation speeds.',
  },
  {
    icon: '📐',
    title: 'Verified Mathematical Precision',
    desc: 'Strict floating-point accuracy tested against reference mathematical, physical, and scientific models.',
  },
];

// Fallback FAQs if category not in config
const defaultFaqs = [
  {
    question: `How accurate are the ${cleanCatName} calculators?`,
    answer: `All calculations are strictly verified against standard academic, scientific, and statutory formulas to eliminate floating-point drift and ensure precision.`,
  },
  {
    question: `Is my personal data saved when using these tools?`,
    answer: `Never. Our calculators run 100% locally in your browser memory. We do not require accounts, and no data is ever transmitted to or stored on external servers.`,
  },
  {
    question: `Can I use these calculators on mobile devices?`,
    answer: `Yes. Every calculator is designed with responsive touch-friendly controls (44px min touch targets) and optimized layouts for phones, tablets, and desktops.`,
  },
  {
    question: `Are these ${cleanCatName.toLowerCase()} tools free to use?`,
    answer: `Yes. All tools on Free Accurate Calculator are completely free with zero subscription fees, paywalls, or hidden usage limits.`,
  },
  {
    question: `Can I export or share my calculation results?`,
    answer: `Yes. Each calculator includes one-click clipboard copying and clean formatting so you can easily paste your results into spreadsheets, reports, or emails.`,
  },
];

const educationCards = catConfig?.educationCards || defaultEducationCards;
const faqs = catConfig?.faqs || defaultFaqs;

const categorySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: fullCatTitle,
  description: meta.description,
  url: `https://freeaccuratecalculator.com/${categoryKey}/`,
};

const pillBadgeText = catConfig?.pillBadge || `Verified ${cleanCatName} Calculators`;
const headlineHighlight = catConfig?.headlineHighlight || 'Fast, Accurate & Private.';
const subheadlineText = catConfig?.subheadline || `Pure ${cleanCatName.toLowerCase()} calculators arranged in a 3-by-3 structure. Each tool runs 100% client-side with zero latency and full privacy.`;
const glowGradient = catConfig?.gradient.glow || 'from-indigo-500/20 via-blue-500/10 to-transparent';
const headlineGradient = catConfig?.gradient.light || 'from-blue-600 via-indigo-600 to-purple-600';
const headlineGradientDark = catConfig?.gradient.dark || 'dark:from-blue-400 dark:via-indigo-300 dark:to-purple-300';
---

<Layout
  title={`${fullCatTitle} — Fast, Accurate & Free Online Tools`}
  description={meta.description}
  jsonLd={categorySchema}
>
  <div class="max-w-7xl mx-auto space-y-8">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={[{ label: cleanCatName }]} />

    <!-- [HERO SECTION]: Startup Presentation Matching Finance & Insurance -->
    <section class="relative overflow-hidden rounded-3xl sm:rounded-[36px] border border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-slate-950/70 px-4 py-8 sm:py-14 md:py-16 text-center hero-mesh-gradient shadow-xs sm:shadow-lg backdrop-blur-xl">
      <!-- Ambient Studio Glow -->
      <div
        class={`absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 sm:w-[580px] h-44 sm:h-72 bg-gradient-to-b ${glowGradient} blur-3xl pointer-events-none`}
        aria-hidden="true"
      ></div>

      <div class="relative z-10 mx-auto max-w-3xl space-y-4 sm:space-y-6">
        <!-- 1. The Startup Pill Badge (NO COUNTS) -->
        <div class="inline-flex items-center gap-2 rounded-full border border-slate-200/90 dark:border-slate-800/90 bg-gradient-to-r from-slate-500/8 via-indigo-500/8 to-purple-500/8 dark:from-slate-500/15 dark:via-indigo-500/15 dark:to-purple-500/15 px-3.5 py-1.5 shadow-2xs backdrop-blur-md select-none">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="font-outfit text-[11px] sm:text-xs font-bold tracking-wider uppercase text-slate-700 dark:text-slate-200">
            {pillBadgeText}
          </span>
          <span class="text-indigo-500 dark:text-indigo-400 text-xs font-bold ml-0.5">✦</span>
        </div>

        <!-- 2. The Main H1 Headline -->
        <h1 class="display-hero font-outfit text-3xl sm:text-5xl lg:text-[56px] xl:text-[60px] font-black tracking-[-0.035em] text-slate-900 dark:text-white leading-[1.12] sm:leading-[1.08] text-balance">
          {cleanCatName} Calculators. <br class="hidden sm:inline" />
          <span class={`bg-gradient-to-r ${headlineGradient} ${headlineGradientDark} bg-clip-text text-transparent`}>
            {headlineHighlight}
          </span>
        </h1>

        <!-- 3. Subtitle Paragraph -->
        <p class="font-sans text-xs sm:text-sm md:text-base text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal text-balance px-2">
          {subheadlineText}
        </p>
      </div>
    </section>

    <!-- [3-BY-3 DIRECTORY]: Strictly 3 Columns on Mobile & Desktop -->
    <section class="space-y-4 sm:space-y-5">
      <!-- Section Header without numbers & Back Link -->
      <div class="flex items-center justify-between border-b border-slate-200/80 dark:border-slate-800/80 pb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">{categoryIcon}</span>
          <h2 class="font-outfit text-sm sm:text-base md:text-lg font-black uppercase tracking-[0.15em] text-slate-900 dark:text-white">
            {cleanCatName} Directory All Tools
          </h2>
        </div>
        <a
          href="/"
          class="inline-flex items-center gap-1 text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline"
        >
          <span>← All Categories</span>
        </a>
      </div>

      <!-- In-Directory Instant Search Bar -->
      <div class="relative w-full max-w-xl mx-auto">
        <div class="relative flex items-center group">
          <span class="absolute left-3.5 text-slate-400 dark:text-slate-500 pointer-events-none group-focus-within:text-indigo-600 dark:group-focus-within:text-indigo-400 transition-colors">
            <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </span>
          <input
            id="directory-filter-input"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder={`Search any calculator here (e.g., '${allCalcs[0]?.shortName.toLowerCase() || 'age'}', 'sip', 'emi', 'tax')...`}
            class="w-full rounded-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white/95 dark:bg-slate-900/95 py-2.5 sm:py-3 pl-10 pr-24 text-xs sm:text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 shadow-2xs focus:border-indigo-500 dark:focus:border-indigo-400 focus:outline-none focus:ring-4 focus:ring-indigo-500/10 dark:focus:ring-indigo-400/10 transition-all backdrop-blur-xl"
            aria-label={`Search ${cleanCatName} calculators`}
          />
          <div class="absolute right-2.5 flex items-center gap-1.5">
            <button
              type="button"
              id="directory-filter-clear"
              class="hidden p-1 rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
              aria-label="Clear search"
            >
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
            <span id="directory-match-counter" class="text-[10px] sm:text-[11px] font-mono font-semibold px-2 py-0.5 rounded-md bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-900/60">
              All Tools
            </span>
          </div>
        </div>

        <!-- Floating Live Suggestions Dropdown -->
        <div
          id="directory-filter-dropdown"
          class="absolute left-0 right-0 top-full mt-2 z-50 rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-2xl shadow-2xl shadow-slate-900/15 dark:shadow-black/50 overflow-hidden text-left transition-all duration-200 origin-top opacity-0 scale-95 pointer-events-none invisible"
          role="listbox"
        >
          <div class="px-3.5 py-2 border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
            <span id="directory-dropdown-title">Suggested Tools</span>
            <span class="text-[10px] lowercase font-normal hidden sm:inline">press enter ↵ to open</span>
          </div>
          <div id="directory-dropdown-list" class="max-h-[280px] overflow-y-auto p-1.5 space-y-1"></div>
        </div>
      </div>

      <!-- THE 3-BY-3 GRID: 3 Columns on Mobile, Tablet & Desktop (Exact 3-by-3 Rhythm) -->
      <div
        id="calculator-grid"
        class="grid grid-cols-3 gap-2 sm:gap-3.5 md:gap-4.5"
      >
        {allCalcs.map((calc) => (
          <a
            href={calc.href}
            title={`Calculate with ${calc.name}`}
            class="calc-card group relative flex flex-col items-center justify-between text-center min-w-0 min-h-[110px] sm:min-h-[140px] md:min-h-[155px] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/80 hover:bg-slate-50 dark:hover:bg-slate-800/80 hover:border-indigo-500/50 hover:shadow-md p-2.5 sm:p-4 md:p-5 transition-all duration-200 shadow-2xs active:scale-[0.98] cursor-pointer"
            data-name={calc.name.toLowerCase()}
            data-desc={(calc.description || '').toLowerCase()}
            data-subniche={(calc.subNiche || '').toLowerCase()}
          >
            <!-- Top Icon Emblem -->
            <div class="flex h-8 w-8 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 text-base sm:text-xl shadow-2xs group-hover:scale-110 group-hover:border-indigo-400/40 transition-transform">
              {calc.icon}
            </div>

            <!-- Title: Optimized for 3-Column Width on all devices -->
            <div class="my-1.5 w-full min-w-0 px-0.5">
              <h3 class="font-outfit text-[11.5px] sm:text-xs md:text-sm font-bold text-slate-800 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">
                <span class="inline sm:hidden">{calc.shortName}</span>
                <span class="hidden sm:inline">{calc.name}</span>
              </h3>
            </div>

            <!-- Bottom Badge & Sub-Niche Tag -->
            <div class="flex items-center justify-center w-full">
              <span class="inline-flex items-center px-1.5 sm:px-2 py-0.5 text-[9px] sm:text-[10px] md:text-[11px] font-mono font-semibold rounded-md bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-900/60 truncate max-w-full">
                {calc.badge}
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Cross-Category Match Results -->
      <div id="cross-category-container" class="hidden space-y-3 pt-2">
        <div class="flex items-center justify-between px-1">
          <h3 class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 flex items-center gap-1.5">
            <span>✦</span>
            <span id="cross-category-title">Matching Tools Found In Other Categories</span>
          </h3>
          <span class="text-[11px] text-slate-500 dark:text-slate-400 font-mono" id="cross-category-badge"></span>
        </div>
        <div id="cross-category-grid" class="grid grid-cols-3 gap-2 sm:gap-3.5 md:gap-4.5">
          <!-- Dynamically populated 3*3 cards for tools found across categories -->
        </div>
      </div>

      <!-- No Results Container -->
      <div id="no-results-msg" class="hidden py-10 text-center space-y-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-900/50">
        <span class="text-3xl">🔍</span>
        <h3 class="text-sm font-bold text-slate-900 dark:text-white">No calculators found</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Try searching for another keyword like "sip", "emi", "tax", "age", or "bmi".
        </p>
        <div>
          <button
            type="button"
            id="reset-directory-search-btn"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 transition-colors cursor-pointer"
          >
            <span>Show All Tools</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Educational & Domain Value Section -->
    <section class="rounded-3xl border border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/70 p-6 sm:p-9 space-y-6 shadow-sm dark:shadow-xl backdrop-blur-xl">
      <div class="flex items-center gap-3 border-b border-slate-200/80 dark:border-slate-800/80 pb-4">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 text-lg font-bold">
          ℹ️
        </span>
        <div>
          <h3 class="font-outfit text-base sm:text-lg font-bold text-slate-900 dark:text-white">
            {catConfig?.educationHeading || `Why Use Free Accurate ${cleanCatName} Calculators?`}
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            {catConfig?.educationSubheading || `Engineered for computational accuracy, verified formulas, and total client privacy`}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {educationCards.map((card) => (
          <div class="space-y-2 p-4 rounded-2xl bg-slate-50/80 dark:bg-slate-800/50 border border-slate-200/60 dark:border-slate-700/60">
            <div class="text-lg">{card.icon}</div>
            <h4 class="font-outfit text-xs sm:text-sm font-bold text-slate-900 dark:text-white">{card.title}</h4>
            <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              {card.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Category FAQs Accordion Section -->
    <section class="rounded-3xl border border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/70 p-6 sm:p-9 space-y-6 shadow-sm dark:shadow-xl backdrop-blur-xl">
      <div class="flex items-center gap-3 border-b border-slate-200/80 dark:border-slate-800/80 pb-4">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 text-lg font-bold">
          ❓
        </span>
        <div>
          <h3 class="font-outfit text-base sm:text-lg font-bold text-slate-900 dark:text-white">
            {catConfig?.faqsHeading || `Frequently Asked Questions About ${cleanCatName} Calculations`}
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            {catConfig?.faqsSubheading || `Clear mathematical and domain answers to help you calculate accurately`}
          </p>
        </div>
      </div>

      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-800/40 p-4 transition-all open:bg-white dark:open:bg-slate-850">
            <summary class="flex cursor-pointer items-center justify-between font-outfit text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100 list-none">
              <span>{faq.question}</span>
              <span class="text-xs text-indigo-600 dark:text-indigo-400 transition-transform group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-3 text-[11px] sm:text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>

<!-- Embedded Database of All Calculators for Instant Cross-Directory Search -->
<script type="application/json" id="category-all-tools-json" set:html={allSearchableToolsJson}></script>

<!-- Client-side Interactive Universal Search & Quick-Launch Engine -->
<script is:inline>
  (function () {
    const dirSearchInput = document.getElementById('directory-filter-input');
    const dirClearBtn = document.getElementById('directory-filter-clear');
    const dirCounter = document.getElementById('directory-match-counter');
    const dirDropdown = document.getElementById('directory-filter-dropdown');
    const dirDropdownList = document.getElementById('directory-dropdown-list');
    const dirDropdownTitle = document.getElementById('directory-dropdown-title');
    const resetBtn = document.getElementById('reset-directory-search-btn');
    const cards = document.querySelectorAll('.calc-card');
    const crossContainer = document.getElementById('cross-category-container');
    const crossGrid = document.getElementById('cross-category-grid');
    const crossBadge = document.getElementById('cross-category-badge');
    const noResults = document.getElementById('no-results-msg');
    const allToolsEl = document.getElementById('category-all-tools-json');

    let allTools = [];
    try {
      allTools = JSON.parse(allToolsEl?.textContent || '[]');
    } catch (_) {
      allTools = [];
    }

    let activeDropdownIndex = -1;
    let currentDropdownMatches = [];
    let firstMatchHref = null;

    function escapeHtml(str) {
      return (str || '').replace(/[&<>"']/g, (m) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      }[m]));
    }

    function openDropdown() {
      if (!dirDropdown) return;
      dirDropdown.classList.remove('opacity-0', 'scale-95', 'pointer-events-none', 'invisible');
      dirDropdown.classList.add('opacity-100', 'scale-100', 'pointer-events-auto', 'visible');
    }

    function closeDropdown() {
      if (!dirDropdown) return;
      dirDropdown.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto', 'visible');
      dirDropdown.classList.add('opacity-0', 'scale-95', 'pointer-events-none', 'invisible');
      activeDropdownIndex = -1;
    }

    function updateActiveDropdownItem() {
      if (!dirDropdownList) return;
      const items = dirDropdownList.querySelectorAll('.fac-dir-suggestion');
      items.forEach((item, idx) => {
        if (idx === activeDropdownIndex) {
          item.classList.add('bg-indigo-50', 'dark:bg-indigo-950/70', 'ring-1', 'ring-indigo-500/30');
          item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } else {
          item.classList.remove('bg-indigo-50', 'dark:bg-indigo-950/70', 'ring-1', 'ring-indigo-500/30');
        }
      });
    }

    function filterTools(query) {
      const q = (query || '').toLowerCase().trim();
      let visibleCount = 0;
      firstMatchHref = null;

      // 1. Filter local cards
      cards.forEach((card) => {
        const name = card.dataset.name || '';
        const desc = card.dataset.desc || '';
        const subniche = card.dataset.subniche || '';
        const match = !q || name.includes(q) || desc.includes(q) || subniche.includes(q);
        card.style.display = match ? 'flex' : 'none';
        if (match) {
          visibleCount++;
          if (!firstMatchHref) {
            firstMatchHref = card.getAttribute('href');
          }
        }
      });

      if (!q) {
        closeDropdown();
        if (crossContainer) crossContainer.classList.add('hidden');
        if (noResults) noResults.style.display = 'none';
        if (dirClearBtn) dirClearBtn.classList.add('hidden');
        if (dirCounter) {
          dirCounter.textContent = 'All Tools';
          dirCounter.className = 'text-[10px] sm:text-[11px] font-mono font-semibold px-2 py-0.5 rounded-md bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-900/60';
        }
        return;
      }

      if (dirClearBtn) dirClearBtn.classList.remove('hidden');

      // 2. Score & Rank across ALL calculators globally
      const matchedAll = [];
      for (const item of allTools) {
        const nameLower = item.name.toLowerCase();
        const catLower = (item.categoryName || item.category || '').toLowerCase();
        const keywords = (item.keywords || []).map((k) => k.toLowerCase());

        let score = 0;
        if (nameLower === q) score += 100;
        else if (nameLower.startsWith(q)) score += 80;
        else if (nameLower.includes(` ${q}`)) score += 60;
        else if (nameLower.includes(q)) score += 40;
        else if (keywords.some((k) => k.includes(q))) score += 35;
        else if (catLower.includes(q)) score += 20;

        if (score > 0) {
          matchedAll.push({ ...item, score });
        }
      }

      matchedAll.sort((a, b) => b.score - a.score);

      // 3. Populate Live Suggestion Dropdown
      currentDropdownMatches = matchedAll.slice(0, 7);
      if (currentDropdownMatches.length > 0) {
        if (!firstMatchHref) {
          firstMatchHref = currentDropdownMatches[0].href;
        }
        if (dirDropdownTitle) {
          dirDropdownTitle.textContent = 'Suggested Tools';
        }
        if (dirDropdownList) {
          dirDropdownList.innerHTML = currentDropdownMatches
            .map(
              (item, idx) => `
              <a
                href="${escapeHtml(item.href)}"
                class="fac-dir-suggestion flex items-center justify-between gap-3 px-3 py-2 rounded-xl hover:bg-indigo-50/80 dark:hover:bg-indigo-950/50 border border-transparent hover:border-indigo-200/50 dark:hover:border-indigo-800/50 transition-colors group cursor-pointer"
                data-index="${idx}"
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="text-base sm:text-lg shrink-0">${item.icon || '🧮'}</span>
                  <div class="min-w-0">
                    <div class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 truncate">
                      ${escapeHtml(item.name)}
                    </div>
                    <div class="text-[10px] text-slate-400 dark:text-slate-500 truncate">
                      ${escapeHtml(item.categoryName || item.category || 'Tool')}
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  <span class="text-[9px] font-mono font-medium px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                    Open ↗
                  </span>
                </div>
              </a>
            `
            )
            .join('');
        }
        openDropdown();
      } else {
        closeDropdown();
      }

      // 4. Update Directory Counter Pill
      if (dirCounter) {
        if (visibleCount > 0) {
          dirCounter.textContent = 'Filtered';
          dirCounter.className = 'text-[10px] sm:text-[11px] font-mono font-semibold px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-900/60';
        } else if (matchedAll.length > 0) {
          dirCounter.textContent = 'Global Match';
          dirCounter.className = 'text-[10px] sm:text-[11px] font-mono font-semibold px-2 py-0.5 rounded-md bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-900/60';
        } else {
          dirCounter.textContent = '0 Matches';
          dirCounter.className = 'text-[10px] sm:text-[11px] font-mono font-semibold px-2 py-0.5 rounded-md bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 border border-rose-200/60 dark:border-rose-900/60';
        }
      }

      // 5. Handle Cross-Category Results Grid
      if (visibleCount === 0 && matchedAll.length > 0) {
        if (crossContainer) crossContainer.classList.remove('hidden');
        if (crossBadge) crossBadge.textContent = 'Suggested Tools';
        if (crossGrid) {
          crossGrid.innerHTML = matchedAll.slice(0, 9).map((calc) => `
            <a
              href="${escapeHtml(calc.href)}"
              title="Calculate with ${escapeHtml(calc.name)}"
              class="group relative flex flex-col items-center justify-between text-center min-w-0 min-h-[110px] sm:min-h-[140px] md:min-h-[155px] rounded-2xl border border-indigo-200/60 dark:border-indigo-900/40 bg-white/90 dark:bg-slate-900/90 hover:bg-indigo-50/40 dark:hover:bg-indigo-950/30 hover:border-indigo-500/50 hover:shadow-md p-2.5 sm:p-4 md:p-5 transition-all duration-200 shadow-2xs active:scale-[0.98] cursor-pointer"
            >
              <div class="flex h-8 w-8 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 text-base sm:text-xl shadow-2xs group-hover:scale-110 group-hover:border-indigo-400/40 transition-transform">
                ${calc.icon || '🧮'}
              </div>
              <div class="my-1.5 w-full min-w-0 px-0.5">
                <h3 class="font-outfit text-[11.5px] sm:text-xs md:text-sm font-bold text-slate-800 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">
                  ${escapeHtml(calc.name)}
                </h3>
              </div>
              <div class="flex items-center justify-center w-full">
                <span class="inline-flex items-center px-1.5 sm:px-2 py-0.5 text-[9px] sm:text-[10px] md:text-[11px] font-mono font-semibold rounded-md bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-900/60 truncate max-w-full">
                  ${escapeHtml(calc.categoryName || calc.category || 'Calculator')}
                </span>
              </div>
            </a>
          `).join('');
        }
      } else {
        if (crossContainer) crossContainer.classList.add('hidden');
      }

      // 6. No Results State
      if (visibleCount === 0 && matchedAll.length === 0) {
        if (noResults) noResults.style.display = 'block';
      } else {
        if (noResults) noResults.style.display = 'none';
      }
    }

    if (dirSearchInput) {
      dirSearchInput.addEventListener('input', (e) => {
        filterTools(e.target.value);
      });

      dirSearchInput.addEventListener('keydown', (e) => {
        if (!dirDropdown || dirDropdown.classList.contains('invisible')) {
          if (e.key === 'Enter' && firstMatchHref) {
            e.preventDefault();
            window.location.href = firstMatchHref;
          }
          return;
        }

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          activeDropdownIndex = Math.min(activeDropdownIndex + 1, currentDropdownMatches.length - 1);
          updateActiveDropdownItem();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          activeDropdownIndex = Math.max(activeDropdownIndex - 1, 0);
          updateActiveDropdownItem();
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (activeDropdownIndex >= 0 && currentDropdownMatches[activeDropdownIndex]) {
            window.location.href = currentDropdownMatches[activeDropdownIndex].href;
          } else if (firstMatchHref) {
            window.location.href = firstMatchHref;
          }
        } else if (e.key === 'Escape') {
          closeDropdown();
        }
      });

      dirSearchInput.addEventListener('focus', () => {
        if (dirSearchInput.value.trim() && currentDropdownMatches.length > 0) {
          openDropdown();
        }
      });
    }

    if (dirClearBtn) {
      dirClearBtn.addEventListener('click', () => {
        if (dirSearchInput) {
          dirSearchInput.value = '';
          dirSearchInput.focus();
        }
        filterTools('');
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (dirSearchInput) dirSearchInput.value = '';
        filterTools('');
      });
    }

    document.addEventListener('click', (e) => {
      if (
        dirDropdown &&
        !dirDropdown.contains(e.target) &&
        dirSearchInput &&
        !dirSearchInput.contains(e.target)
      ) {
        closeDropdown();
      }
    });
  })();
</script>

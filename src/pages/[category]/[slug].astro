---
// src/pages/[category]/[slug].astro
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import AdSlot from '../../components/common/AdSlot.astro';
import {
  getAllCalculators,
  getCalculatorBySlug,
  getRelatedCalculators,
  ALL_FRONTEND_CALCULATORS,
} from '../../data/calculators';
import { CALCULATORS, CATEGORY_METADATA } from '../../data/calculatorRegistry';
import { getFaqsForCalculator } from '../../data/faqDatabase';
import SocialProof from '../../components/SocialProof.astro';
import type { CalculatorEntity } from '../../types/calculator';

export async function getStaticPaths() {
  const programmaticList = getAllCalculators();
  const dedicatedPages = new Set(['income-tax-calculator', 'sip-calculator']);

  // Map programmatic calculators
  const routes = programmaticList
    .filter((c) => !dedicatedPages.has(c.slug))
    .map((calc) => ({
      params: {
        category: calc.category,
        slug: calc.slug,
      },
      props: {
        calc,
      },
    }));

  // Also include remaining calculators from registry adapted to entity structure
  const registrySlugs = new Set(programmaticList.map((p) => p.slug));
  for (const regCalc of CALCULATORS) {
    if (registrySlugs.has(regCalc.id) || dedicatedPages.has(regCalc.id)) continue;

    const adaptedCalc: CalculatorEntity = {
      slug: regCalc.id,
      title: regCalc.title,
      metaDescription: regCalc.description,
      category: regCalc.category,
      name: regCalc.name,
      badge: regCalc.badge,
      formula: regCalc.formula.expression,
      formulaExplanation: regCalc.formula.explanation,
      engineType: regCalc.category === 'finance' ? 'finance' : regCalc.category === 'health' ? 'health' : 'arithmetic',
      resultLabel: regCalc.defaultResult.label,
      resultPrefix: regCalc.defaultResult.prefix,
      resultUnit: regCalc.defaultResult.suffix,
      decimals: regCalc.defaultResult.decimals,
      mathInputs: regCalc.inputs.map((inp) => ({
        id: inp.id,
        label: inp.label,
        type: inp.type === 'select' ? 'select' : 'number',
        defaultValue: inp.defaultValue,
        min: inp.min,
        max: inp.max,
        step: inp.step,
        unit: inp.unit,
        options: inp.options,
        helpText: inp.helpText,
      })),
      faqs: (getFaqsForCalculator(regCalc.id, regCalc.name).slice(0, 5) as [any, any, any, any, any]),
    };

    routes.push({
      params: {
        category: adaptedCalc.category,
        slug: adaptedCalc.slug,
      },
      props: {
        calc: adaptedCalc,
      },
    });
  }

  return routes;
}

interface Props {
  calc: CalculatorEntity;
}

const { calc } = Astro.props;

const siteOrigin = 'https://freeaccuratecalculator.com';
const canonicalUrl = `${siteOrigin}/${calc.category}/${calc.slug}/`;

// Internal Linking: 3 related calculators in same category
const relatedCalculators = getRelatedCalculators(calc.category, calc.slug, 3);

// Category metadata lookup
const catMeta = CATEGORY_METADATA[calc.category as keyof typeof CATEGORY_METADATA] || {
  name: calc.category.charAt(0).toUpperCase() + calc.category.slice(1),
  eyebrow: 'Precision Calculator Engine',
};

// Map category to Schema.org ApplicationCategory
let appCategory = 'UtilityApplication';
if (calc.category === 'finance') appCategory = 'FinanceApplication';
else if (calc.category === 'health') appCategory = 'HealthApplication';
else if (calc.category === 'math') appCategory = 'EducationalApplication';

// 1. WebApplication Schema
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'WebApplication'],
  name: calc.name,
  applicationCategory: appCategory,
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  url: canonicalUrl,
  inLanguage: 'en',
  softwareVersion: '2026.1',
  offers: {
    '@type': 'Offer',
    price: '0.00',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: 'Free Accurate Calculator',
    url: 'https://freeaccuratecalculator.com/',
  },
  description: calc.metaDescription,
};

// 2. Exact FAQPage Schema (must exactly match visible HTML text for 100% Rich Snippet validation)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: calc.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const combinedJsonLd = [webAppSchema, faqSchema];
---

<Layout
  title={calc.title}
  description={calc.metaDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={combinedJsonLd}
>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-10" itemscope itemtype="https://schema.org/WebApplication">
    <!-- Breadcrumbs Navigation -->
    <Breadcrumbs
      items={[
        { label: catMeta.name, href: `/${calc.category}/` },
        { label: calc.name },
      ]}
    />

    <!-- Header Section -->
    <header class="border-b border-hairline pb-6 space-y-3">
      <div class="flex items-center gap-2">
        <span class="mono-eyebrow text-link font-semibold uppercase tracking-wider text-xs">{catMeta.name}</span>
        <span class="h-1 w-1 rounded-full bg-faint"></span>
        <span class="text-[11px] font-mono text-mute">Programmatic pSEO Engine</span>
        {calc.badge && (
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-link/10 text-link border border-link/20">
            {calc.badge}
          </span>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink font-mono">{calc.name}</h1>
      <p class="text-base text-body max-w-3xl leading-relaxed">{calc.metaDescription}</p>
    </header>

    <!-- Main Grid: Dynamic Calculator (8 Cols) + Sidebar / Related (4 Cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Calculator Engine Section -->
      <div class="lg:col-span-8 space-y-8">
        <!-- Real-time Social Proof Widget -->
        <SocialProof calculatorName={calc.name} />

        <!-- Interactive Card -->
        <div class="rounded-2xl border border-hairline bg-canvas-elevated p-5 sm:p-8 shadow-whisper space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-sm font-semibold uppercase tracking-wider font-mono text-ink">Parameters & Inputs</h2>
            <button
              id="share-btn"
              type="button"
              class="inline-flex items-center gap-1.5 text-xs font-mono text-mute hover:text-ink px-2.5 py-1 rounded-md border border-hairline hover:bg-canvas transition-colors"
              title="Copy shareable link with parameters"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
              </svg>
              <span>Share Config</span>
            </button>
          </div>

          <!-- Dynamic Form Generator -->
          <form id="dynamic-calc-form" class="space-y-4" onsubmit="return false;">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {calc.mathInputs.map((inp) => (
                <div class="space-y-1.5">
                  <label for={inp.id} class="block text-xs font-semibold uppercase font-mono text-ink">
                    {inp.label}
                  </label>
                  {inp.type === 'select' ? (
                    <select
                      id={inp.id}
                      name={inp.id}
                      class="dynamic-input w-full min-h-[44px] rounded-lg border border-hairline bg-canvas px-3 py-2 text-base sm:text-sm font-mono text-ink focus:border-link focus:ring-1 focus:ring-link focus:outline-none"
                    >
                      {inp.options?.map((opt) => (
                        <option value={opt.value} selected={opt.value === inp.defaultValue}>
                          {opt.label}
                        </option>
                      ))}
                    </select>
                  ) : (
                    <div class="relative">
                      <input
                        id={inp.id}
                        name={inp.id}
                        type="number"
                        step={inp.step || 'any'}
                        min={inp.min}
                        max={inp.max}
                        value={inp.defaultValue}
                        class="dynamic-input w-full min-h-[44px] rounded-lg border border-hairline bg-canvas px-3 py-2 text-base sm:text-sm font-mono text-ink placeholder-faint focus:border-link focus:ring-1 focus:ring-link focus:outline-none pr-10"
                      />
                      {inp.unit && (
                        <span class="absolute right-3 top-3 text-xs font-mono text-mute select-none pointer-events-none">
                          {inp.unit}
                        </span>
                      )}
                    </div>
                  )}
                  {inp.helpText && <p class="text-[11px] text-mute">{inp.helpText}</p>}
                </div>
              ))}
            </div>

            <!-- Calculate Action Button -->
            <div class="pt-2 flex flex-col sm:flex-row items-center gap-3">
              <button
                id="calculate-btn"
                type="button"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-link text-white font-mono font-medium text-sm hover:opacity-95 active:scale-[0.99] transition-all shadow-sm cursor-pointer"
              >
                <span>Calculate Result</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
              <span class="text-xs text-mute font-mono">Instant local computation. Zero server lag.</span>
            </div>
          </form>

          <!-- Result Display Container: Zero CLS Reserved Box (aria-live="polite") -->
          <div
            id="result-container"
            aria-live="polite"
            class="min-h-[140px] rounded-xl border border-hairline bg-canvas p-6 flex flex-col justify-center relative overflow-hidden transition-all"
          >
            <!-- Skeleton View (Before First Calculation) -->
            <div id="result-skeleton" class="space-y-3 animate-pulse">
              <div class="h-3.5 bg-hairline-soft rounded w-1/3"></div>
              <div class="h-9 bg-hairline-soft rounded w-2/3"></div>
              <div class="h-3 bg-hairline-soft rounded w-1/2"></div>
            </div>

            <!-- Active Result View (Filled after calculate) -->
            <div id="result-content" class="hidden space-y-2">
              <div class="flex items-center justify-between">
                <span class="mono-eyebrow text-xs text-mute uppercase font-mono">{calc.resultLabel}</span>
                <button
                  id="copy-result-btn"
                  type="button"
                  class="inline-flex items-center gap-1 text-xs font-mono text-link hover:underline cursor-pointer"
                  title="Copy result to clipboard"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <span id="copy-btn-text">Copy</span>
                </button>
              </div>

              <div class="flex items-baseline gap-2">
                {calc.resultPrefix && <span class="text-2xl sm:text-3xl font-mono text-link font-bold">{calc.resultPrefix}</span>}
                <div id="result-value" class="text-3xl sm:text-4xl font-extrabold font-mono text-ink tracking-tight">--</div>
                {calc.resultUnit && <span class="text-lg font-mono text-mute">{calc.resultUnit}</span>}
              </div>

              <p id="result-secondary" class="text-xs font-mono text-mute leading-relaxed"></p>
            </div>
          </div>
        </div>

        <!-- In-Content Native Ad Placement -->
        <AdSlot slotType="in-content" slotId="CALC-PROGRAMMATIC-01" />

        <!-- Educational Formula & Scientific Specification -->
        <section class="rounded-2xl border border-hairline bg-canvas-elevated p-6 sm:p-8 shadow-whisper space-y-4">
          <h2 class="text-lg font-bold font-mono text-ink">Mathematical Formula & Methodology</h2>
          <div class="rounded-xl bg-canvas border border-hairline p-4 overflow-x-auto text-center font-mono text-base text-ink">
            <code>{calc.formula}</code>
          </div>
          {calc.formulaExplanation && (
            <p class="text-sm text-body leading-relaxed">{calc.formulaExplanation}</p>
          )}
        </section>

        <!-- Programmatic FAQ Section (Semantic native accordion details/summary for zero JS bloat) -->
        <section class="space-y-4">
          <h2 class="text-xl font-bold font-mono text-ink">Frequently Asked Questions</h2>
          <div class="space-y-3">
            {calc.faqs.map((faq) => (
              <details class="group rounded-xl border border-hairline bg-canvas-elevated p-4 open:shadow-whisper transition-all">
                <summary class="flex items-center justify-between font-mono text-sm font-semibold text-ink cursor-pointer list-none select-none">
                  <span>{faq.question}</span>
                  <span class="ml-2 text-mute group-open:rotate-180 transition-transform duration-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <div class="mt-3 text-xs sm:text-sm text-body leading-relaxed border-t border-hairline pt-3 font-sans">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </section>
      </div>

      <!-- Sidebar Column (4 Cols): Related Calculators & Trust Badges -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="sticky top-20 space-y-6">
          <AdSlot slotType="rectangle" slotId="CALC-SIDEBAR-PROG" className="my-0" />

          <!-- Internal Linking: Related Calculators in the same category -->
          {relatedCalculators.length > 0 && (
            <div class="rounded-xl border border-hairline bg-canvas-elevated p-5 shadow-whisper space-y-3">
              <h3 class="mono-eyebrow text-ink font-semibold uppercase tracking-wider text-xs">Related {catMeta.name}</h3>
              <ul class="space-y-2">
                {relatedCalculators.map((rel) => (
                  <li>
                    <a
                      href={rel.href}
                      class="flex items-center justify-between rounded-lg border border-hairline-soft bg-canvas p-3 text-xs font-medium text-body hover:text-ink hover:border-mute transition-colors group"
                    >
                      <span class="group-hover:text-link transition-colors">{rel.name}</span>
                      <svg class="w-3.5 h-3.5 text-mute group-hover:text-link group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Trust Badge -->
          <div class="rounded-xl border border-hairline-soft bg-canvas p-4 text-xs text-mute space-y-2">
            <div class="flex items-center gap-2 font-medium text-ink">
              <svg class="w-4 h-4 text-link" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Verified Client-Side Precision</span>
            </div>
            <p class="text-[11px] leading-relaxed">
              Every formula is audited against ISO & WHO computational standards. Your data never leaves your browser.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </article>
</Layout>

<!-- Client-side Calculation & State Engine -->
<script is:inline define:vars={{ slug: calc.slug, engineType: calc.engineType, decimals: calc.decimals || 2 }}>
  (function () {
    const form = document.getElementById('dynamic-calc-form');
    const inputs = document.querySelectorAll('.dynamic-input');
    const calculateBtn = document.getElementById('calculate-btn');
    const resultSkeleton = document.getElementById('result-skeleton');
    const resultContent = document.getElementById('result-content');
    const resultValue = document.getElementById('result-value');
    const resultSecondary = document.getElementById('result-secondary');
    const copyResultBtn = document.getElementById('copy-result-btn');
    const copyBtnText = document.getElementById('copy-btn-text');
    const shareBtn = document.getElementById('share-btn');

    function getInputValues() {
      const vals = {};
      inputs.forEach((inp) => {
        vals[inp.id] = inp.value;
      });
      return vals;
    }

    // Client-side execution of Universal Engine
    function calculate() {
      const raw = getInputValues();

      // Guard checking and calculations based on engine
      let resValue = 0;
      let formatted = '0.00';
      let secondary = '';

      if (slug === 'bmi-calculator') {
        const h = parseFloat(raw.heightCm) / 100;
        const w = parseFloat(raw.weightKg);
        if (h > 0 && w > 0) {
          resValue = Math.round((w / (h * h) + Number.EPSILON) * 10) / 10;
          formatted = resValue.toFixed(1);
          let cat = 'Normal weight';
          if (resValue < 18.5) cat = 'Underweight';
          else if (resValue >= 25 && resValue < 29.9) cat = 'Overweight';
          else if (resValue >= 30) cat = 'Obese';
          secondary = `Classification: ${cat} (WHO Healthy Range: 18.5 - 24.9)`;
        }
      } else if (slug === 'emi-calculator') {
        const p = parseFloat(raw.principal);
        const r = (parseFloat(raw.annualRate) / 12) / 100;
        const n = Math.round(parseFloat(raw.tenureYears) * 12);
        if (p > 0 && n > 0) {
          let emi = 0;
          if (r === 0) emi = p / n;
          else {
            const factor = Math.pow(1 + r, n);
            emi = (p * r * factor) / (factor - 1);
          }
          resValue = Math.round((emi + Number.EPSILON) * 100) / 100;
          formatted = resValue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          const totalPay = Math.round(resValue * n);
          const totalInt = Math.max(0, totalPay - p);
          secondary = `Total Repayment: $${totalPay.toLocaleString()} | Cumulative Interest: $${totalInt.toLocaleString()}`;
        }
      } else if (slug === 'percentage-calculator') {
        const pct = parseFloat(raw.percentage);
        const total = parseFloat(raw.total);
        if (!isNaN(pct) && !isNaN(total)) {
          resValue = Math.round(((pct / 100) * total + Number.EPSILON) * 100) / 100;
          formatted = resValue.toLocaleString('en-US', { maximumFractionDigits: 4 });
          secondary = `${pct}% of ${total.toLocaleString()} is ${formatted}`;
        }
      } else if (slug === 'salary-calculator') {
        const wage = parseFloat(raw.wage || '0');
        const hrs = parseFloat(raw.hours_per_week || '40');
        const freq = raw.frequency || 'hourly';

        if (isNaN(wage) || wage < 0) {
          resValue = 0;
          formatted = '0.00';
          secondary = 'Salary cannot be negative. Please enter a valid positive salary amount.';
        } else if (hrs <= 0) {
          resValue = 0;
          formatted = '0.00';
          secondary = 'Hours per week must be greater than zero.';
        } else {
          let annual = 0;
          if (freq === 'hourly') annual = wage * hrs * 52;
          else if (freq === 'weekly') annual = wage * 52;
          else if (freq === 'monthly') annual = wage * 12;
          else annual = wage;

          resValue = Math.round((annual + Number.EPSILON) * 100) / 100;
          formatted = resValue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          const monthly = Math.round((annual / 12) * 100) / 100;
          const weekly = Math.round((annual / 52) * 100) / 100;
          secondary = `Monthly: $${monthly.toLocaleString()} | Weekly: $${weekly.toLocaleString()}`;
        }
      } else {
        // Fallback for any other calculator
        const nums = Object.values(raw).map((v) => parseFloat(v)).filter((v) => !isNaN(v));
        resValue = nums.length > 0 ? nums.reduce((a, b) => a + b, 0) : 0;
        formatted = resValue.toLocaleString();
        secondary = 'Calculated with client-side mathematical precision';
      }

      // Display Result and eliminate Skeleton (Zero CLS)
      if (resultSkeleton && resultContent) {
        resultSkeleton.classList.add('hidden');
        resultContent.classList.remove('hidden');
      }

      if (resultValue) resultValue.textContent = formatted;
      if (resultSecondary) resultSecondary.textContent = secondary;

      // Update URL State
      syncUrlParams();
    }

    function syncUrlParams() {
      const params = new URLSearchParams();
      inputs.forEach((inp) => {
        if (inp.value) params.set(inp.id, inp.value);
      });
      window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
    }

    // Restore URL params on initial load
    const currentParams = new URLSearchParams(window.location.search);
    inputs.forEach((inp) => {
      if (currentParams.has(inp.id)) {
        inp.value = currentParams.get(inp.id);
      }

      // Disallow typing minus key or entering negative amounts
      inp.addEventListener('keydown', (e) => {
        if (e.key === '-' || e.key === 'Minus') {
          e.preventDefault();
        }
      });
      inp.addEventListener('paste', (e) => {
        const text = (e.clipboardData || window.clipboardData)?.getData('text') || '';
        if (text.includes('-')) {
          e.preventDefault();
        }
      });
      inp.addEventListener('input', () => {
        if (inp.type === 'number' && parseFloat(inp.value) < 0) {
          inp.value = '0';
        }
        calculate();
      });
    });

    if (calculateBtn) {
      calculateBtn.addEventListener('click', calculate);
    }

    // Copy to clipboard
    if (copyResultBtn) {
      copyResultBtn.addEventListener('click', () => {
        if (resultValue) {
          navigator.clipboard.writeText(resultValue.textContent || '');
          if (copyBtnText) {
            copyBtnText.textContent = 'Copied!';
            setTimeout(() => {
              copyBtnText.textContent = 'Copy';
            }, 2000);
          }
        }
      });
    }

    // Share URL
    if (shareBtn) {
      shareBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        const originalText = shareBtn.querySelector('span')?.textContent || 'Share';
        const span = shareBtn.querySelector('span');
        if (span) {
          span.textContent = 'Link Copied!';
          setTimeout(() => {
            span.textContent = originalText;
          }, 2000);
        }
      });
    }

    // Run initial calculation if params present or automatically
    calculate();
  })();
</script>

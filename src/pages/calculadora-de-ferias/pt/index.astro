---
// src/pages/calculadora-de-ferias/pt/index.astro
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import FormulaSection from '../../../components/calculator/FormulaSection.astro';
import WorkedExample from '../../../components/calculator/WorkedExample.astro';
import FAQSection from '../../../components/calculator/FAQSection.astro';
import {
  calcularFerias,
  regrasINSS2026,
  regrasIRRF2026,
  formatarMoedaBRL,
  formatarPercentualBRL,
} from '../../../engines/feriasBrasil2026.ts';

// Perguntas frequentes estruturadas em português brasileiro para o schema FAQPage
const faqs = [
  {
    question: 'Como calcular o valor das férias pela CLT em 2026?',
    answer:
      'Para calcular o valor bruto das férias, divide-se o salário bruto mensal por 30 e multiplica-se pelo número de dias de férias a serem gozados. Em seguida, soma-se o adicional constitucional de 1/3 (dividindo o valor das férias por 3). Sobre essa soma, incide o desconto progressivo do INSS oficial de 2026 e, se aplicável, o IRRF com as deduções de dependentes e as novas faixas de isenção de 2026. O valor líquido corresponde ao total bruto menos os descontos legais.',
  },
  {
    question: 'Como funciona o adicional constitucional de 1/3 de férias?',
    answer:
      'Garantido pelo artigo 7º, inciso XVII, da Constituição Federal de 1988, o adicional de férias concede ao trabalhador o direito de receber pelo menos um terço a mais do que o seu salário normal durante o período de descanso. Por exemplo, para um salário de R$ 3.000,00 com 30 dias de férias, o adicional de 1/3 é de R$ 1.000,00, totalizando R$ 4.000,00 brutos.',
  },
  {
    question: 'O que é o abono pecuniário e como funciona a venda de 10 dias de férias?',
    answer:
      'O abono pecuniário é a faculdade que o empregado tem de converter até 1/3 do seu período de férias em dinheiro (CLT, artigo 143), popularmente conhecida como "venda de férias". Para quem tem direito a 30 dias, é possível gozar 20 dias de descanso e receber 10 dias como abono pecuniário. Um grande benefício fiscal é que o valor do abono e seu respectivo 1/3 são 100% isentos de desconto de INSS (Lei nº 8.212/91) e de IRRF (Súmula 125 do STJ).',
  },
  {
    question: 'Quando o pagamento das férias deve ser feito pela empresa?',
    answer:
      'De acordo com o artigo 145 da CLT, o pagamento da remuneração das férias e, se for o caso, do abono pecuniário, deve ser efetuado até 2 (dois) dias antes do início do respectivo período de gozo. O descumprimento desse prazo pode acarretar penalidades administrativas para o empregador.',
  },
  {
    question: 'Como funciona o adiantamento da 1ª parcela do 13º salário nas férias?',
    answer:
      'Conforme a Lei nº 4.749/1965 (art. 2º, § 2º), o empregado pode solicitar o adiantamento da primeira parcela (50%) do seu 13º salário por ocasião das férias, desde que faça o requerimento por escrito à empresa durante o mês de janeiro do ano correspondente. O adiantamento é pago sem descontos de INSS e IRRF no momento das férias, sendo esses encargos apurados apenas na segunda parcela em dezembro.',
  },
  {
    question: 'Incide desconto de INSS e Imposto de Renda (IRRF) sobre as férias?',
    answer:
      'Sim. Sobre a remuneração das férias gozadas e seu 1/3 constitucional incidem tanto o INSS (tabela progressiva oficial) quanto o IRRF (com retenção na fonte no mês do pagamento). Em 2026, quem recebe até R$ 5.000,00 de remuneração bruta mensal conta com isenção total de IRRF. Já sobre o abono pecuniário (dias vendidos) e seu terço, não há incidência de INSS nem de IRRF por se tratarem de verbas indenizatórias.',
  },
  {
    question: 'As férias podem ser divididas em períodos menores?',
    answer:
      'Sim. Desde a Reforma Trabalhista (Lei nº 13.467/2017), havendo concordância entre empregado e empregador, as férias podem ser usufruídas em até 3 (três) períodos, desde que um deles não seja inferior a 14 (quatorze) dias corridos e os demais não sejam inferiores a 5 (cinco) dias corridos cada um.',
  },
  {
    question: 'Os dados informados nesta calculadora de férias são confidenciais?',
    answer:
      'Sim, total e irrestritamente privados. Todos os cálculos matemáticos são executados exclusivamente no navegador do seu dispositivo (processamento local no cliente). Nenhuma informação de salário, dias de descanso ou dependentes é transmitida, armazenada ou rastreada em servidores externos.',
  },
];

// Calculadoras relacionadas em português para linkagem interna de alta relevância
const relatedCalculators = [
  { title: 'Calculadora de Salário Líquido 2026', href: '/calculadora-salario/pt/', badge: 'Trabalho' },
  { title: 'Calculadora de Porcentagem', href: '/percentage-calculator/', badge: 'Matemática' },
  { title: 'Calculadora de Juros Compostos', href: '/compound-interest-calculator/', badge: 'Finanças' },
  { title: 'Calculadora de Empréstimo e Financiamento', href: '/emi-calculator/', badge: 'Crédito' },
  { title: 'Calculadora de Idade', href: '/calculadora-edad/es/', badge: 'Pessoal' },
];

// Exemplo passo a passo verificado matematicamente para Salário R$ 5.000,00 (30 dias)
const workedExampleSteps = [
  {
    number: 1,
    title: 'Apuração do Salário Base das Férias Gozadas',
    description: 'Para um período de 30 dias com salário contratual de R$ 5.000,00, o valor base de férias gozadas é de 30 dias integrais.',
    mathExpression: 'Férias Gozadas = (R$ 5.000,00 / 30) × 30 = R$ 5.000,00',
  },
  {
    number: 2,
    title: 'Cálculo do Adicional Constitucional de 1/3 (CF/88 Art. 7º, XVII)',
    description: 'Calcula-se um terço sobre a remuneração das férias gozadas: R$ 5.000,00 dividido por 3, resultando em R$ 1.666,67.',
    mathExpression: '1/3 Constitucional = R$ 5.000,00 / 3 = R$ 1.666,67',
  },
  {
    number: 3,
    title: 'Composição da Remuneração Bruta Tributável',
    description: 'Soma-se o valor das férias ao terço constitucional para obter a base bruta sujeita aos encargos oficiais.',
    mathExpression: 'Total Bruto Tributável = R$ 5.000,00 + R$ 1.666,67 = R$ 6.666,67',
  },
  {
    number: 4,
    title: 'Aplicação da Tabela Progressiva do INSS 2026',
    description: 'Aplica-se a tabela progressiva: 7,5% na 1ª faixa (R$ 121,58), 9% na 2ª faixa (R$ 115,37), 12% na 3ª faixa (R$ 174,17) e 14% sobre o excedente até R$ 6.666,67 (R$ 323,74). O desconto do INSS resulta em R$ 734,85.',
    mathExpression: 'Desconto INSS 2026 = R$ 734,85 (alíquota efetiva de 11,02%)',
  },
  {
    number: 5,
    title: 'Apuração do IRRF 2026 com Faixa de Transição do Novo IR',
    description: 'Subtrai-se o INSS: R$ 6.666,67 − R$ 734,85 = R$ 5.931,82. Pela tabela base, o imposto seria R$ 722,52. Como a renda bruta situa-se na faixa de transição (R$ 5.000,01 a R$ 7.350,00), aplica-se o redutor oficial de R$ 90,99, apurando R$ 631,53 de IRRF.',
    mathExpression: 'IRRF a Pagar = R$ 722,52 − R$ 90,99 = R$ 631,53',
  },
  {
    number: 6,
    title: 'Determinação do Valor Líquido das Férias a Receber',
    description: 'Subtraem-se o INSS (R$ 734,85) e o IRRF (R$ 631,53) do valor bruto total (R$ 6.666,67). O trabalhador recebe R$ 5.300,29 líquidos na conta até 2 dias antes das férias.',
    mathExpression: 'Valor Líquido = R$ 6.666,67 − R$ 1.366,38 = R$ 5.300,29',
  },
];

// Dados pré-calculados para a tabela comparativa oficial de 30 dias de férias em 2026
const exemplosTabela = [
  { salarioBruto: 2000, terco: 666.67, totalBruto: 2666.67, inss: 215.69, irrf: 0.00, liquido: 2450.98, aliqEfetiva: '8,09%' },
  { salarioBruto: 3000, terco: 1000.00, totalBruto: 4000.00, inss: 368.60, irrf: 0.00, liquido: 3631.40, aliqEfetiva: '9,21%' },
  { salarioBruto: 5000, terco: 1666.67, totalBruto: 6666.67, inss: 734.85, irrf: 631.53, liquido: 5300.29, aliqEfetiva: '20,50%' },
  { salarioBruto: 7000, terco: 2333.33, totalBruto: 9333.33, inss: 988.09, irrf: 1391.22, liquido: 6954.02, aliqEfetiva: '25,49%' },
  { salarioBruto: 10000, terco: 3333.33, totalBruto: 13333.33, inss: 988.09, irrf: 2486.22, liquido: 9859.03, aliqEfetiva: '26,06%' },
];

const dataHojePt = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());
---

<CalculatorLayout
  title="Calculadora de Férias 2026: Calcule o Valor das Férias CLT"
  metaDescription="Calcule suas férias em 2026 com base nas regras da CLT: adicional de 1/3, venda de férias (abono pecuniário), adiantamento do 13º e descontos de INSS e IRRF."
  h1="Calculadora de Férias 2026"
  subtitle="Descubra o valor bruto e líquido a receber nas suas férias pela CLT, com o adicional constitucional de 1/3, venda de férias (abono pecuniário) e as tabelas oficiais de INSS e IRRF de 2026."
  category={{ label: 'Calculadoras Financeiras', href: '/finance/' }}
  calculatorName="Calculadora de Férias 2026"
  relatedCalculators={relatedCalculators}
  faqs={faqs}
  lang="pt-BR"
  canonical="https://freeaccuratecalculator.com/calculadora-de-ferias/pt/"
  disableEmailModal={true}
>
  <!-- Caixa Principal da Calculadora -->
  <div
    id="ferias-calculator-card"
    class="calculator-main-box relative rounded-[20px] border border-hairline bg-canvas-elevated p-4 sm:p-8 shadow-whisper space-y-6 overflow-hidden transition-all pb-24 sm:pb-8"
  >
    <!-- Resplendor Ambiental Sutil -->
    <div class="pointer-events-none absolute -top-32 -right-32 w-80 h-80 rounded-full bg-link/10 blur-3xl print:hidden"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-32 w-80 h-80 rounded-full bg-cyan/10 blur-3xl print:hidden"></div>

    <!-- Relatório Dedicado de Alta Fidelidade para Impressão e PDF (Visível apenas na impressão) -->
    <div id="ferias-print-report" class="hidden print:block font-mono text-slate-900 fac-print-report">
      <!-- Cabeçalho Oficial -->
      <div class="border-b-2 border-slate-900 pb-4 mb-5 flex justify-between items-start">
        <div>
          <div class="text-2xl font-black uppercase tracking-tight">Free Accurate Calculator</div>
          <div class="text-sm font-bold text-blue-700 mt-0.5">Demonstrativo de Cálculo de Férias CLT 2026</div>
          <div class="text-xs text-slate-500 mt-1">freeaccuratecalculator.com • Consolidação das Leis do Trabalho e CF/88 Art. 7º, XVII</div>
        </div>
        <div class="text-right text-xs text-slate-600 space-y-0.5">
          <div><span class="text-slate-400 uppercase">Data da Simulação:</span> <strong id="print-date" class="text-slate-900">{dataHojePt}</strong></div>
          <div><span class="text-slate-400 uppercase">Exercício Fiscal:</span> <strong class="text-slate-900">2026 (Portaria MPS/MF nº 13/2026)</strong></div>
        </div>
      </div>

      <!-- Parâmetros de Entrada -->
      <div class="bg-slate-50 border border-slate-200 rounded-lg p-3.5 mb-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Parâmetros das Férias</div>
        <div class="grid grid-cols-4 gap-4 text-xs">
          <div><span class="text-slate-500 block text-[10px] uppercase">Salário Bruto Mensal</span><span id="print-salario-bruto" class="text-sm font-bold text-slate-900">R$ 5.000,00</span></div>
          <div><span class="text-slate-500 block text-[10px] uppercase">Dias de Férias Gozados</span><span id="print-dias-gozados" class="text-sm font-bold text-slate-900">30 dias</span></div>
          <div><span class="text-slate-500 block text-[10px] uppercase">Venda de Férias (Abono)</span><span id="print-dias-abono" class="text-sm font-bold text-slate-900">Não (0 dias)</span></div>
          <div><span class="text-slate-500 block text-[10px] uppercase">Adiantamento do 13º</span><span id="print-adiantamento-13" class="text-sm font-bold text-slate-900">Não solicitado</span></div>
        </div>
      </div>

      <!-- Destaque do Valor Líquido -->
      <div class="border-2 border-slate-900 rounded-lg p-4 bg-slate-50 mb-6">
        <span class="text-[10px] font-bold uppercase text-slate-900 block">Valor Líquido a Receber (Crédito em Conta)</span>
        <div id="print-valor-liquido" class="text-3xl font-black text-slate-900 mt-1">R$ 5.300,29</div>
        <div id="print-resumo-subtitulo" class="text-xs text-slate-600 mt-1">Total bruto de R$ 6.666,67 com retenções de R$ 1.366,38 (20,50%)</div>
        <div class="text-[11px] font-bold text-emerald-800 mt-2 bg-emerald-50 p-2 rounded border border-emerald-200">
          Prazo Legal: Pagamento obrigatório até 2 dias antes do início do gozo (Artigo 145 da CLT).
        </div>
      </div>

      <!-- Tabela do Demonstrativo de Férias -->
      <div class="space-y-2 mb-6">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Detalhamento de Proventos e Descontos Legais</div>
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b-2 border-slate-300 bg-slate-100 text-slate-700">
              <th class="py-2 px-2.5">Descrição da Rubrica</th>
              <th class="py-2 px-2.5 text-center">Referência</th>
              <th class="py-2 px-2.5 text-right">Proventos (+)</th>
              <th class="py-2 px-2.5 text-right">Descontos (−)</th>
            </tr>
          </thead>
          <tbody id="print-tabela-corpo" class="divide-y divide-slate-200">
            <!-- Preenchido dinamicamente pelo script -->
          </tbody>
        </table>
      </div>

      <!-- Rodapé do Demonstrativo -->
      <div class="mt-8 pt-3 border-t border-slate-200 flex justify-between items-center text-[10px] text-slate-500">
        <div>Free Accurate Calculator • https://freeaccuratecalculator.com/calculadora-de-ferias/pt/</div>
        <div>Os resultados são estimativas informativas baseadas na legislação trabalhista brasileira em vigor.</div>
      </div>
    </div>

    <!-- Interface Interativa na Tela (Oculta na Impressão) -->
    <div class="print:hidden space-y-6">
      <!-- Barra Superior de Identificação e Regime -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-4 text-xs">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <span class="mono-eyebrow text-ink font-semibold">Regras CLT & INSS/IRRF 2026 Ativas</span>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold">
            CF/88 Art. 7º & CLT Art. 129–145
          </span>
        </div>

        <div class="flex items-center gap-2 text-mute font-mono text-[11px]">
          <span>Moeda: <strong>Real Brasileiro (R$)</strong></span>
          <span>•</span>
          <span>Base: <strong>Mensal CLT</strong></span>
        </div>
      </div>

      <!-- Formulário: Parâmetros Principais de Férias -->
      <form id="ferias-calculator-form" class="space-y-5" onsubmit="event.preventDefault();">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Campo 1: Salário Bruto Mensal -->
          <div class="space-y-1.5">
            <label for="salario-bruto-input" class="block text-xs font-semibold text-ink uppercase font-mono">
              Salário bruto mensal <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-mute font-mono text-sm">
                R$
              </span>
              <input
                id="salario-bruto-input"
                name="salarioBruto"
                type="text"
                inputmode="decimal"
                value="5.000,00"
                placeholder="Ex.: 5.000,00"
                aria-label="Salário bruto mensal em reais"
                required
                class="w-full min-h-[44px] rounded-[8px] border border-hairline bg-canvas pl-10 pr-3.5 py-2.5 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link transition-colors"
              />
            </div>
            <p class="text-[11px] text-mute font-mono">Salário fixo registrado na sua carteira de trabalho.</p>
          </div>

          <!-- Campo 2: Dias de Férias a Tirar (Gozo) -->
          <div class="space-y-1.5">
            <label for="dias-ferias-input" class="block text-xs font-semibold text-ink uppercase font-mono">
              Dias de férias a gozar <span class="text-red-500">*</span>
            </label>
            <div class="flex items-center gap-2">
              <input
                id="dias-ferias-input"
                name="diasFerias"
                type="number"
                min="1"
                max="30"
                step="1"
                value="30"
                aria-label="Quantidade de dias corridos de férias a usufruir"
                class="w-24 min-h-[44px] rounded-[8px] border border-hairline bg-canvas px-3 py-2 text-base sm:text-sm font-mono text-ink text-center focus:border-link focus:outline-none"
              />
              <!-- Botões de Seleção Rápida -->
              <div class="flex items-center gap-1">
                <button type="button" class="btn-quick-dias px-2.5 py-1.5 rounded border border-hairline bg-canvas hover:bg-hairline text-xs font-mono text-ink cursor-pointer" data-dias="30">30d</button>
                <button type="button" class="btn-quick-dias px-2.5 py-1.5 rounded border border-hairline bg-canvas hover:bg-hairline text-xs font-mono text-ink cursor-pointer" data-dias="20">20d</button>
                <button type="button" class="btn-quick-dias px-2.5 py-1.5 rounded border border-hairline bg-canvas hover:bg-hairline text-xs font-mono text-ink cursor-pointer" data-dias="15">15d</button>
                <button type="button" class="btn-quick-dias px-2.5 py-1.5 rounded border border-hairline bg-canvas hover:bg-hairline text-xs font-mono text-ink cursor-pointer" data-dias="10">10d</button>
              </div>
            </div>
            <p class="text-[11px] text-mute font-mono">Direito padrão: 30 dias (pode ser fracionado pela CLT).</p>
          </div>

          <!-- Campo 3: Dependentes no IRRF -->
          <div class="space-y-1.5">
            <label for="dependentes-input" class="block text-xs font-semibold text-ink uppercase font-mono">
              Número de dependentes
            </label>
            <div class="relative">
              <input
                id="dependentes-input"
                name="dependentes"
                type="number"
                min="0"
                max="20"
                step="1"
                value="0"
                placeholder="0"
                aria-label="Quantidade de dependentes cadastrados para dedução do IRRF"
                class="w-full min-h-[44px] rounded-[8px] border border-hairline bg-canvas px-3.5 py-2.5 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link transition-colors"
              />
            </div>
            <p class="text-[11px] text-mute font-mono">Dedução legal de R$ 189,59 por dependente no imposto de renda.</p>
          </div>
        </div>

        <!-- Seção de Opções Trabalhistas Estratégicas (Abono e 13º) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
          <!-- Card Vender Férias (Abono Pecuniário) -->
          <div class="rounded-xl border border-hairline bg-canvas/60 p-4 space-y-3 transition-colors hover:border-link/40">
            <div class="flex items-start justify-between gap-3">
              <div class="space-y-1">
                <label for="vender-ferias-checkbox" class="text-xs font-bold text-ink uppercase font-mono cursor-pointer flex items-center gap-2">
                  <input
                    id="vender-ferias-checkbox"
                    type="checkbox"
                    class="w-4 h-4 rounded border-hairline text-link focus:ring-link cursor-pointer"
                  />
                  <span>Vender 1/3 das férias (Abono)</span>
                </label>
                <p class="text-[11px] text-mute font-mono leading-relaxed">
                  Converte até 10 dias em dinheiro (CLT Art. 143). <strong>Isento de INSS e IRRF!</strong>
                </p>
              </div>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold shrink-0">
                Isento de Impostos
              </span>
            </div>

            <!-- Input de Dias Vendidos (Visível quando marcado) -->
            <div id="container-dias-abono" class="hidden pt-2 border-t border-hairline flex items-center justify-between text-xs font-mono">
              <span class="text-ink">Quantidade de dias vendidos:</span>
              <div class="flex items-center gap-2">
                <input
                  id="dias-abono-input"
                  type="number"
                  min="1"
                  max="10"
                  step="1"
                  value="10"
                  class="w-20 rounded border border-hairline bg-canvas px-2 py-1 text-center font-bold text-ink"
                />
                <span class="text-mute text-[11px]">dias (máx. 10)</span>
              </div>
            </div>
          </div>

          <!-- Card Adiantar 1ª Parcela do 13º -->
          <div class="rounded-xl border border-hairline bg-canvas/60 p-4 space-y-3 transition-colors hover:border-link/40">
            <div class="flex items-start justify-between gap-3">
              <div class="space-y-1">
                <label for="adiantar-13-checkbox" class="text-xs font-bold text-ink uppercase font-mono cursor-pointer flex items-center gap-2">
                  <input
                    id="adiantar-13-checkbox"
                    type="checkbox"
                    class="w-4 h-4 rounded border-hairline text-link focus:ring-link cursor-pointer"
                  />
                  <span>Adiantar 1ª parcela do 13º (50%)</span>
                </label>
                <p class="text-[11px] text-mute font-mono leading-relaxed">
                  Receba metade do seu 13º salário junto com as férias (Lei nº 4.749/1965).
                </p>
              </div>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono bg-blue-500/10 text-blue-600 dark:text-blue-400 font-bold shrink-0">
                Sem Descontos Agora
              </span>
            </div>
          </div>
        </div>

        <!-- Seção Expansível: Opções Avançadas e Deduções -->
        <div class="rounded-xl border border-hairline bg-canvas/60 overflow-hidden transition-all">
          <button
            type="button"
            id="toggle-opcoes-avancadas-btn"
            aria-expanded="false"
            aria-controls="secao-opcoes-avancadas"
            class="w-full flex items-center justify-between p-4 text-xs font-mono font-semibold text-ink hover:text-link transition-colors cursor-pointer select-none"
          >
            <div class="flex items-center gap-2">

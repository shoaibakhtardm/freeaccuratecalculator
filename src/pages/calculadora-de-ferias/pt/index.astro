  <!-- Script Cliente Interativo e Reativo -->
  <script>
    import {
      calcularFerias,
      formatarMoedaBRL,
      formatarPercentualBRL,
      parseMoedaBRL,
    } from '../../../engines/feriasBrasil2026.ts';

    function inicializarCalculadoraFerias() {
      // Elementos de Entrada
      const salarioInput = document.getElementById('salario-bruto-input') as HTMLInputElement | null;
      const diasFeriasInput = document.getElementById('dias-ferias-input') as HTMLInputElement | null;
      const dependentesInput = document.getElementById('dependentes-input') as HTMLInputElement | null;
      const venderCheckbox = document.getElementById('vender-ferias-checkbox') as HTMLInputElement | null;
      const containerDiasAbono = document.getElementById('container-dias-abono') as HTMLElement | null;
      const diasAbonoInput = document.getElementById('dias-abono-input') as HTMLInputElement | null;
      const adiantar13Checkbox = document.getElementById('adiantar-13-checkbox') as HTMLInputElement | null;
      const mediaHorasExtrasInput = document.getElementById('media-horas-extras-input') as HTMLInputElement | null;
      const pensaoInput = document.getElementById('pensao-alimenticia-input') as HTMLInputElement | null;
      const outrosDescontosInput = document.getElementById('outros-descontos-input') as HTMLInputElement | null;

      // Botões e Toggles
      const calcularBtn = document.getElementById('calcular-ferias-btn');
      const resetBtn = document.getElementById('limpar-formulario-btn');
      const imprimirBtn = document.getElementById('imprimir-holerite-btn');
      const toggleAvancadasBtn = document.getElementById('toggle-opcoes-avancadas-btn');
      const secaoAvancadas = document.getElementById('secao-opcoes-avancadas');
      const iconeAvancadas = document.getElementById('icone-opcoes-avancadas');
      const quickDiasBtns = document.querySelectorAll('.btn-quick-dias');

      // Elementos de Saída (Hero Card)
      const resValorLiquido = document.getElementById('resultado-valor-liquido');
      const resResumoTexto = document.getElementById('resultado-resumo-texto');
      const badgeStatusIr = document.getElementById('badge-status-ir');
      const barraLiquido = document.getElementById('barra-liquido');
      const barraInss = document.getElementById('barra-inss');
      const barraIrrf = document.getElementById('barra-irrf');
      const barraOutros = document.getElementById('barra-outros');
      const labelProporcaoLiquido = document.getElementById('label-proporcao-liquido');

      // Cards Secundários
      const cardTotalBruto = document.getElementById('card-total-bruto');
      const cardFeriasGozadas = document.getElementById('card-ferias-gozadas');
      const cardDiasGozadasRotulo = document.getElementById('card-dias-gozadas-rotulo');
      const cardTercoFerias = document.getElementById('card-terco-ferias');
      const cardInss = document.getElementById('card-inss');
      const cardAliqInss = document.getElementById('card-aliq-inss');
      const cardIrrf = document.getElementById('card-irrf');
      const cardAliqIrrf = document.getElementById('card-aliq-irrf');
      const cardTotalDescontos = document.getElementById('card-total-descontos');
      const cardAliqTotal = document.getElementById('card-aliq-total');

      // Tabela de Demonstrativo na Tela
      const tabelaCorpo = document.getElementById('tabela-demonstrativo-corpo');
      const tabTotalProventos = document.getElementById('tabela-total-proventos');
      const tabTotalDescontos = document.getElementById('tabela-total-descontos');
      const tabValorLiquidoFinal = document.getElementById('tabela-valor-liquido-final');

      // Elementos do Relatório de Impressão (PDF)
      const printSalarioBruto = document.getElementById('print-salario-bruto');
      const printDiasGozados = document.getElementById('print-dias-gozados');
      const printDiasAbono = document.getElementById('print-dias-abono');
      const printAdiantamento13 = document.getElementById('print-adiantamento-13');
      const printValorLiquido = document.getElementById('print-valor-liquido');
      const printResumoSubtitulo = document.getElementById('print-resumo-subtitulo');
      const printTabelaCorpo = document.getElementById('print-tabela-corpo');

      if (!salarioInput) return;

      // Toggle de Opções Avançadas
      if (toggleAvancadasBtn && secaoAvancadas && iconeAvancadas) {
        toggleAvancadasBtn.addEventListener('click', () => {
          const isHidden = secaoAvancadas.classList.contains('hidden');
          if (isHidden) {
            secaoAvancadas.classList.remove('hidden');
            iconeAvancadas.classList.add('rotate-180');
            toggleAvancadasBtn.setAttribute('aria-expanded', 'true');
          } else {
            secaoAvancadas.classList.add('hidden');
            iconeAvancadas.classList.remove('rotate-180');
            toggleAvancadasBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Toggle do Abono Pecuniário (Venda de Férias)
      if (venderCheckbox && containerDiasAbono) {
        venderCheckbox.addEventListener('change', () => {
          if (venderCheckbox.checked) {
            containerDiasAbono.classList.remove('hidden');
            // Se o usuário selecionou vender férias e os dias de gozo estão em 30, ajusta para 20
            if (diasFeriasInput && parseInt(diasFeriasInput.value, 10) === 30) {
              diasFeriasInput.value = '20';
            }
          } else {
            containerDiasAbono.classList.add('hidden');
            if (diasFeriasInput && parseInt(diasFeriasInput.value, 10) === 20) {
              diasFeriasInput.value = '30';
            }
          }
          executarCalculo();
        });
      }

      // Botões de Seleção Rápida de Dias de Férias
      quickDiasBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const dias = btn.getAttribute('data-dias');
          if (dias && diasFeriasInput) {
            diasFeriasInput.value = dias;
            // Se escolher 30 dias de gozo, desmarca venda de férias
            if (dias === '30' && venderCheckbox && venderCheckbox.checked) {
              venderCheckbox.checked = false;
              if (containerDiasAbono) containerDiasAbono.classList.add('hidden');
            }
            executarCalculo();
          }
        });
      });

      // Função Principal de Execução do Cálculo
      function executarCalculo() {
        const salarioBruto = parseMoedaBRL(salarioInput?.value || '0');
        const diasFerias = parseInt(diasFeriasInput?.value || '30', 10);
        const dependentes = parseInt(dependentesInput?.value || '0', 10);
        const vender = Boolean(venderCheckbox?.checked);
        const diasAbono = vender ? parseInt(diasAbonoInput?.value || '10', 10) : 0;
        const adiantar13 = Boolean(adiantar13Checkbox?.checked);
        const mediaHorasExtras = parseMoedaBRL(mediaHorasExtrasInput?.value || '0');
        const pensao = parseMoedaBRL(pensaoInput?.value || '0');
        const outrosDescontos = parseMoedaBRL(outrosDescontosInput?.value || '0');

        const resultado = calcularFerias({
          salarioBrutoMensal: salarioBruto,
          diasFerias,
          venderFerias: vender,
          diasAbono,
          adiantar13o: adiantar13,
          dependentes,
          mediaHorasExtras,
          pensaoAlimenticia: pensao,
          outrasDeducoes: outrosDescontos,
        });

        // Atualização dos Textos e Valores no Hero Card
        if (resValorLiquido) {
          resValorLiquido.textContent = formatarMoedaBRL(resultado.valorLiquidoReceber);
        }

        const pctLiquido = resultado.totalBrutoRecebido > 0
          ? ((resultado.valorLiquidoReceber / resultado.totalBrutoRecebido) * 100).toFixed(2).replace('.', ',')
          : '0,00';

        if (resResumoTexto) {
          resResumoTexto.innerHTML = `Você receberá aproximadamente <strong>${pctLiquido}%</strong> do total bruto de proventos após ${formatarMoedaBRL(resultado.totalDescontos)} em retenções.`;
        }

        // Status do IRRF
        if (badgeStatusIr) {
          if (resultado.irrf.irrfFinal === 0) {
            badgeStatusIr.textContent = resultado.irrf.isencaoTotal2026
              ? 'Isenção Total do IRRF Aplicada'
              : 'Sem Retenção de IRRF';
            badgeStatusIr.className = 'inline-flex items-center px-2.5 py-1 rounded text-xs font-mono font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400';
          } else if (resultado.irrf.redutor2026 > 0) {
            badgeStatusIr.textContent = 'Novo IR 2026: Redutor de Transição Ativo';
            badgeStatusIr.className = 'inline-flex items-center px-2.5 py-1 rounded text-xs font-mono font-medium bg-blue-500/10 text-blue-600 dark:text-blue-400';
          } else {
            badgeStatusIr.textContent = `IRRF: Alíquota Efetiva de ${formatarPercentualBRL(resultado.irrf.aliquotaEfetiva)}`;
            badgeStatusIr.className = 'inline-flex items-center px-2.5 py-1 rounded text-xs font-mono font-medium bg-hairline text-ink';
          }
        }

        // Atualização da Barra de Composição
        if (resultado.totalBrutoRecebido > 0) {
          const pLiquido = (resultado.valorLiquidoReceber / resultado.totalBrutoRecebido) * 100;
          const pInss = (resultado.inss.totalDesconto / resultado.totalBrutoRecebido) * 100;
          const pIrrf = (resultado.irrf.irrfFinal / resultado.totalBrutoRecebido) * 100;
          const pOutros = ((resultado.pensaoAlimenticia + resultado.outrasDeducoes) / resultado.totalBrutoRecebido) * 100;

          if (barraLiquido) barraLiquido.style.width = `${pLiquido.toFixed(2)}%`;
          if (barraInss) barraInss.style.width = `${pInss.toFixed(2)}%`;
          if (barraIrrf) barraIrrf.style.width = `${pIrrf.toFixed(2)}%`;
          if (barraOutros) barraOutros.style.width = `${pOutros.toFixed(2)}%`;

          if (labelProporcaoLiquido) {
            labelProporcaoLiquido.textContent = `Líquido: ${pLiquido.toFixed(2).replace('.', ',')}%`;
          }
        }

        // Cards Secundários
        if (cardTotalBruto) cardTotalBruto.textContent = formatarMoedaBRL(resultado.totalBrutoRecebido);
        if (cardFeriasGozadas) cardFeriasGozadas.textContent = formatarMoedaBRL(resultado.valorFeriasGozadas);
        if (cardDiasGozadasRotulo) cardDiasGozadasRotulo.textContent = `${resultado.diasGozados} ${resultado.diasGozados === 1 ? 'dia corrido' : 'dias corridos'}`;
        if (cardTercoFerias) cardTercoFerias.textContent = formatarMoedaBRL(resultado.valorTercoConstitucionalFerias);
        if (cardInss) cardInss.textContent = formatarMoedaBRL(resultado.inss.totalDesconto);
        if (cardAliqInss) cardAliqInss.textContent = `Efetiva: ${formatarPercentualBRL(resultado.inss.aliquotaEfetiva)}`;
        if (cardIrrf) cardIrrf.textContent = formatarMoedaBRL(resultado.irrf.irrfFinal);
        if (cardAliqIrrf) cardAliqIrrf.textContent = resultado.irrf.irrfFinal === 0 ? 'Isento em 2026' : `Efetiva: ${formatarPercentualBRL(resultado.irrf.aliquotaEfetiva)}`;
        if (cardTotalDescontos) cardTotalDescontos.textContent = formatarMoedaBRL(resultado.totalDescontos);
        if (cardAliqTotal) cardAliqTotal.textContent = `${formatarPercentualBRL(resultado.percentualDescontosSobreBruto)} do bruto`;

        // Renderização Dinâmica da Tabela na Tela
        if (tabelaCorpo) {
          tabelaCorpo.innerHTML = '';
          resultado.tabelaRubricas.forEach((item) => {
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-hairline/20 transition-colors';
            tr.innerHTML = `
              <td class="py-2.5 pr-4">
                <span class="font-semibold text-ink block">${item.descricao}</span>
              </td>
              <td class="py-2.5 px-3 text-center text-mute">${item.referencia}</td>
              <td class="py-2.5 px-3 text-center text-mute text-[10px]">${item.baseLegal}</td>
              <td class="py-2.5 px-3 text-right font-medium text-emerald-600 dark:text-emerald-400">
                ${item.provento > 0 ? formatarMoedaBRL(item.provento) : '—'}
              </td>
              <td class="py-2.5 pl-3 text-right font-medium text-rose-600 dark:text-rose-400">
                ${item.desconto > 0 ? formatarMoedaBRL(item.desconto) : '—'}
              </td>
            `;
            tabelaCorpo.appendChild(tr);
          });
        }

        if (tabTotalProventos) tabTotalProventos.textContent = formatarMoedaBRL(resultado.totalBrutoRecebido);
        if (tabTotalDescontos) tabTotalDescontos.textContent = formatarMoedaBRL(resultado.totalDescontos);
        if (tabValorLiquidoFinal) tabValorLiquidoFinal.textContent = formatarMoedaBRL(resultado.valorLiquidoReceber);

        // Atualização do Relatório de Impressão (PDF)
        if (printSalarioBruto) printSalarioBruto.textContent = formatarMoedaBRL(resultado.salarioContratual);
        if (printDiasGozados) printDiasGozados.textContent = `${resultado.diasGozados} dias`;
        if (printDiasAbono) printDiasAbono.textContent = resultado.diasAbono > 0 ? `Sim (${resultado.diasAbono} dias vendidos)` : 'Não (0 dias)';
        if (printAdiantamento13) printAdiantamento13.textContent = resultado.solicitouAdiantamento13 ? `Sim (${formatarMoedaBRL(resultado.valorAdiantamento13o)})` : 'Não solicitado';
        if (printValorLiquido) printValorLiquido.textContent = formatarMoedaBRL(resultado.valorLiquidoReceber);
        if (printResumoSubtitulo) {
          printResumoSubtitulo.textContent = `Total bruto de ${formatarMoedaBRL(resultado.totalBrutoRecebido)} com retenções de ${formatarMoedaBRL(resultado.totalDescontos)} (${formatarPercentualBRL(resultado.percentualDescontosSobreBruto)})`;
        }

        if (printTabelaCorpo) {
          printTabelaCorpo.innerHTML = '';
          resultado.tabelaRubricas.forEach((item) => {
            const tr = document.createElement('tr');
            tr.className = 'border-b border-slate-200';
            tr.innerHTML = `
              <td class="py-2 px-2.5">
                <span class="font-bold text-slate-900 block">${item.descricao}</span>
                <span class="text-[10px] text-slate-500 block">${item.baseLegal}</span>
              </td>
              <td class="py-2 px-2.5 text-center text-slate-600">${item.referencia}</td>
              <td class="py-2 px-2.5 text-right font-medium text-emerald-800">
                ${item.provento > 0 ? formatarMoedaBRL(item.provento) : '—'}
              </td>
              <td class="py-2 px-2.5 text-right font-medium text-rose-800">
                ${item.desconto > 0 ? formatarMoedaBRL(item.desconto) : '—'}
              </td>
            `;
            printTabelaCorpo.appendChild(tr);
          });
        }
      }

      // Formatação automática do Salário Bruto ao sair do campo
      salarioInput.addEventListener('blur', () => {
        const val = parseMoedaBRL(salarioInput.value);
        salarioInput.value = val.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        executarCalculo();
      });

      // Eventos de entrada em tempo real
      const inputsMonitorados = [
        salarioInput,
        diasFeriasInput,
        dependentesInput,
        diasAbonoInput,
        mediaHorasExtrasInput,
        pensaoInput,
        outrosDescontosInput,
      ];

      inputsMonitorados.forEach((input) => {
        if (!input) return;
        input.addEventListener('input', executarCalculo);
        input.addEventListener('change', executarCalculo);
      });

      if (adiantar13Checkbox) {
        adiantar13Checkbox.addEventListener('change', executarCalculo);
      }

      if (calcularBtn) {
        calcularBtn.addEventListener('click', executarCalculo);
      }

      // Impressão / Salvar PDF
      if (imprimirBtn) {
        imprimirBtn.addEventListener('click', () => {
          window.print();
        });
      }

      // Botão de Restabelecer Padrões
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (salarioInput) salarioInput.value = '5.000,00';
          if (diasFeriasInput) diasFeriasInput.value = '30';
          if (dependentesInput) dependentesInput.value = '0';
          if (venderCheckbox) {
            venderCheckbox.checked = false;
            if (containerDiasAbono) containerDiasAbono.classList.add('hidden');
          }
          if (diasAbonoInput) diasAbonoInput.value = '10';
          if (adiantar13Checkbox) adiantar13Checkbox.checked = false;
          if (mediaHorasExtrasInput) mediaHorasExtrasInput.value = '0,00';
          if (pensaoInput) pensaoInput.value = '0,00';
          if (outrosDescontosInput) outrosDescontosInput.value = '0,00';
          executarCalculo();
        });
      }

      // Executa o cálculo imediatamente no carregamento da página
      executarCalculo();
    }

    // Inicialização segura no ciclo de vida do Astro e transições de página
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', inicializarCalculadoraFerias);
    } else {
      inicializarCalculadoraFerias();
    }
    document.addEventListener('astro:page-load', inicializarCalculadoraFerias);
  </script>
</CalculatorLayout>

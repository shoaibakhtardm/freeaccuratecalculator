    if (noResultsDiv) {
      noResultsDiv.classList.add('hidden');
      noResultsDiv.style.display = 'none';
    }
    const dataStoreEl = document.getElementById('france-searchable-tools-json');

    let allSearchableTools = [];
    try {
      allSearchableTools = JSON.parse(dataStoreEl ? dataStoreEl.textContent || '[]' : '[]');
    } catch (_) {
      allSearchableTools = [];
    }

    let activeDropdownIndex = -1;
    let currentDropdownMatches = [];

    function escapeHtml(str) {
      return (str || '').replace(/[&<>"']/g, (m) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      }[m]));
    }

    function removeAccents(str) {
      return (str || '').normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    }

    function openDropdown() {
      if (!dirDropdown) return;
      dirDropdown.classList.remove('opacity-0', 'scale-95', 'pointer-events-none', 'invisible');
      dirDropdown.classList.add('opacity-100', 'scale-100', 'pointer-events-auto', 'visible');
      if (searchInput) searchInput.setAttribute('aria-expanded', 'true');
    }

    function closeDropdown() {
      if (!dirDropdown) return;
      dirDropdown.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto', 'visible');
      dirDropdown.classList.add('opacity-0', 'scale-95', 'pointer-events-none', 'invisible');
      activeDropdownIndex = -1;
      if (searchInput) searchInput.setAttribute('aria-expanded', 'false');
    }

    function highlightMatch(text, query) {
      if (!query || !text) return escapeHtml(text);
      const cleanT = removeAccents(text.toLowerCase());
      const cleanQ = removeAccents(query.toLowerCase());
      const idx = cleanT.indexOf(cleanQ);
      if (idx === -1) return escapeHtml(text);
      const before = escapeHtml(text.slice(0, idx));
      const matched = escapeHtml(text.slice(idx, idx + query.length));
      const after = escapeHtml(text.slice(idx + query.length));
      return `${before}<span class="font-black text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/80 rounded px-0.5">${matched}</span>${after}`;
    }

    function updateActiveDropdownItem() {
      if (!dirDropdownList) return;
      const items = dirDropdownList.querySelectorAll('.fac-dir-suggestion');
      items.forEach((item, idx) => {
        if (idx === activeDropdownIndex) {
          item.classList.add('bg-indigo-50', 'dark:bg-indigo-950/70', 'ring-1', 'ring-indigo-500/30');
          item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } else {
          item.classList.remove('bg-indigo-50', 'dark:bg-indigo-950/70', 'ring-1', 'ring-indigo-500/30');
        }
      });
    }

    function filterTools(query) {
      const q = (query || '').toLowerCase().trim();
      const cleanQ = removeAccents(q);
      const isEn = currentLang === 'en';

      if (clearBtn) {
        if (q.length > 0) clearBtn.classList.remove('hidden');
        else clearBtn.classList.add('hidden');
      }

      // If search query is empty: ensure all tools are unconditionally visible, hide all no-results elements, and close suggestions
      if (!q) {
        cards.forEach((card) => {
          card.classList.remove('hidden');
          card.style.display = 'flex';
        });
        if (noResultsDiv) {
          noResultsDiv.classList.add('hidden');
          noResultsDiv.style.display = 'none';
        }
        const noResultsTitle = document.getElementById('no-results-msg-title');
        const noResultsSubtitle = document.getElementById('no-results-msg-subtitle');
        if (noResultsTitle) noResultsTitle.textContent = '';
        if (noResultsSubtitle) noResultsSubtitle.textContent = '';
        if (dirNoResultsPanel) {
          dirNoResultsPanel.classList.add('hidden');
        }
        if (dirNoResultsTitle) dirNoResultsTitle.textContent = '';
        if (dirNoResultsSubtitle) dirNoResultsSubtitle.textContent = '';
        closeDropdown();
        return;
      }

      // 1. Filter local on-page cards (active search query)
      let matchCount = 0;
      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const titleEn = card.getAttribute('data-title-en') || '';
        const shortTitle = card.getAttribute('data-short-title') || '';
        const desc = card.getAttribute('data-description') || '';
        const cat = card.getAttribute('data-category') || '';
        const badge = card.getAttribute('data-badge') || '';
        const keywords = card.getAttribute('data-search') || '';

        const fullHaystack = `${title} ${titleEn} ${shortTitle} ${desc} ${cat} ${badge} ${keywords}`.toLowerCase();
        const cleanHaystack = removeAccents(fullHaystack);

        const isMatch = fullHaystack.includes(q) || cleanHaystack.includes(cleanQ);

        if (isMatch) {
          card.classList.remove('hidden');
          card.style.display = 'flex';
          matchCount++;
        } else {
          card.classList.add('hidden');
          card.style.display = 'none';
        }
      });

      if (noResultsDiv) {
        if (q.length > 0 && matchCount === 0) {
          const noResultsTitle = document.getElementById('no-results-msg-title');
          const noResultsSubtitle = document.getElementById('no-results-msg-subtitle');
          if (noResultsTitle) {
            noResultsTitle.textContent = isEn ? "No calculators found" : "Aucun calculateur trouvé";
          }
          if (noResultsSubtitle) {
            noResultsSubtitle.innerHTML = isEn
              ? "Try searching for loan, vat, salary, apl, mileage or check spelling."
              : 'Essayez avec des termes comme <span class="font-semibold text-indigo-600 dark:text-indigo-400">prêt, tva, salaire, impôt, amortissement</span> ou vérifiez l\'orthographe.';
          }
          noResultsDiv.classList.remove('hidden');
          noResultsDiv.style.display = 'block';
        } else {
          noResultsDiv.classList.add('hidden');
          noResultsDiv.style.display = 'none';
        }
      }

      const scored = [];
      for (const item of allSearchableTools) {
        const nameFr = (item.nameFr || '').toLowerCase();
        const nameEn = (item.nameEn || '').toLowerCase();
        const shortFr = (item.shortNameFr || '').toLowerCase();
        const keywords = (item.searchKeywords || '').toLowerCase();
        const catFr = (item.categoryFr || '').toLowerCase();

        const cleanNameFr = removeAccents(nameFr);
        const cleanShortFr = removeAccents(shortFr);
        const cleanKeywords = removeAccents(keywords);

        let score = 0;
        if (nameFr === q || nameEn === q || cleanNameFr === cleanQ) score += 100;
        else if (cleanNameFr.startsWith(cleanQ) || nameEn.startsWith(q) || cleanShortFr.startsWith(cleanQ)) score += 80;
        else if (cleanNameFr.includes(` ${cleanQ}`) || nameEn.includes(` ${q}`)) score += 60;
        else if (cleanNameFr.includes(cleanQ) || nameEn.includes(q)) score += 40;
        else if (cleanKeywords.includes(cleanQ)) score += 35;
        else if (catFr.includes(cleanQ)) score += 20;

        if (score > 0) {
          scored.push({ ...item, score });
        }
      }

      scored.sort((a, b) => b.score - a.score);
      currentDropdownMatches = scored.slice(0, 7);
      activeDropdownIndex = -1;

      if (currentDropdownMatches.length > 0) {
        if (dirNoResultsPanel) dirNoResultsPanel.classList.add('hidden');
        if (dirDropdownList) {
          dirDropdownList.innerHTML = currentDropdownMatches
            .map((item, idx) => {
              const name = isEn ? (item.nameEn || item.nameFr) : item.nameFr;
              const cat = isEn ? (item.categoryEn || item.categoryFr) : item.categoryFr;
              const openText = isEn ? 'Open ↗' : 'Ouvrir ↗';
              const highlighted = highlightMatch(name, q);

              return `
                <a
                  href="${escapeHtml(item.href)}"
                  class="fac-dir-suggestion flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-xl hover:bg-indigo-50/85 dark:hover:bg-indigo-950/50 border border-transparent hover:border-indigo-200/50 dark:hover:border-indigo-800/50 transition-colors group cursor-pointer"
                  data-index="${idx}"
                >
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="text-base sm:text-lg shrink-0">${item.icon || '🧮'}</span>
                    <div class="min-w-0">
                      <div class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 truncate">
                        ${highlighted}
                      </div>
                      <div class="text-[10px] text-slate-400 dark:text-slate-500 truncate">
                        ${escapeHtml(cat)}
                      </div>
                    </div>
                  </div>
                  <div class="flex items-center gap-1.5 shrink-0">
                    <span class="text-[9px] font-mono font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                      ${openText}
                    </span>
                  </div>
                </a>
              `;
            })
            .join('');
        }
        openDropdown();
      } else {
        if (dirDropdownList) dirDropdownList.innerHTML = '';
        if (dirNoResultsTitle) {
          dirNoResultsTitle.textContent = isEn ? "No calculators found" : "Aucun calculateur trouvé";
        }
        if (dirNoResultsSubtitle) {
          dirNoResultsSubtitle.textContent = isEn ? "Try searching for loan, vat, salary, apl, mileage" : "Essayez avec un terme comme prêt, tva, salaire, impôt ou amortissement";
        }
        if (dirNoResultsPanel) dirNoResultsPanel.classList.remove('hidden');
        openDropdown();
      }
    }

    function updateLanguage(lang) {
      currentLang = lang;
      try {
        localStorage.setItem('fac_france_lang', lang);
      } catch (_) {}

      const data = CONTENT[lang];
      if (!data) return;

      // 1. Update <html lang="...">
      document.documentElement.lang = lang === 'fr' ? 'fr-FR' : 'en';

      // 2. Update Header Toggle Active Highlighting
      const frBtn = document.getElementById('header-lang-fr');
      const enBtn = document.getElementById('header-lang-en');
      if (frBtn && enBtn) {
        if (lang === 'fr') {
          frBtn.className = 'inline-flex items-center gap-1 font-bold text-indigo-600 dark:text-indigo-400 transition-colors';
          enBtn.className = 'inline-flex items-center gap-1 font-medium text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-colors';
        } else {
          frBtn.className = 'inline-flex items-center gap-1 font-medium text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-colors';
          enBtn.className = 'inline-flex items-center gap-1 font-bold text-indigo-600 dark:text-indigo-400 transition-colors';
        }
      }

      // 3. Document Title & Meta Description
      if (data.docTitle) document.title = data.docTitle;
      const metaDescTag = document.querySelector('meta[name="description"]');
      if (metaDescTag && data.metaDesc) metaDescTag.setAttribute('content', data.metaDesc);

      // 4. Breadcrumbs
      const bHome = document.getElementById('breadcrumb-home');
      const bCountries = document.getElementById('breadcrumb-countries');
      if (bHome) bHome.textContent = data.breadcrumbHome;
      if (bCountries) bCountries.textContent = data.breadcrumbCountries;

      // 5. Hero Banner
      const hBadge = document.getElementById('hero-badge-text');
      const hMain = document.getElementById('hero-headline-main');
      const hHighlight = document.getElementById('hero-headline-highlight');
      const hSub = document.getElementById('hero-subtitle');
      if (hBadge) hBadge.textContent = data.heroBadge;
      if (hMain) hMain.textContent = data.heroH1Main;
      if (hHighlight) hHighlight.textContent = data.heroH1Highlight;
      if (hSub) hSub.textContent = data.heroSubtitle;

      // 6. Categories Section & Search Placeholders
      const catHeading = document.getElementById('categories-heading-text');
      if (catHeading) catHeading.textContent = data.categoriesHeading;

      const catSearchInput = document.getElementById('categories-france-search-input');
      if (catSearchInput) {
        catSearchInput.setAttribute('placeholder', '');
        catSearchInput.setAttribute('aria-label', data.categoriesPlaceholder);
      }

      if (dirDropdownTitle && data.dropdownTitle) dirDropdownTitle.textContent = data.dropdownTitle;
      if (dirDropdownEnterHint && data.dropdownEnterHint) dirDropdownEnterHint.textContent = data.dropdownEnterHint;
      if (dirNoResultsTitle && data.noResultsTitle) dirNoResultsTitle.textContent = data.noResultsTitle;
      if (dirNoResultsSubtitle && data.noResultsSubtitle) dirNoResultsSubtitle.textContent = data.noResultsSubtitle;
      if (dirFooterBadge && data.footerBadge) dirFooterBadge.textContent = data.footerBadge;
      if (dirFooterNavHint && data.footerNavHint) dirFooterNavHint.textContent = data.footerNavHint;
      if (dirFooterEscHint && data.footerEscHint) dirFooterEscHint.textContent = data.footerEscHint;

      document.querySelectorAll('.fac-category-label').forEach((label) => {
        const catId = label.getAttribute('data-cat-id');
        if (catId && data.categories[catId]) {
          label.textContent = data.categories[catId];
        }
      });

      // 7. Tools Section
      const toolsHeading = document.getElementById('tools-directory-heading');
      if (toolsHeading) toolsHeading.textContent = data.toolsHeading;

      document.querySelectorAll('.tool-card-prefix, .tool-name-mobile').forEach((el) => {
        const id = el.getAttribute('data-tool-id');
        if (id && data.tools[id]) el.textContent = data.tools[id].short;
      });

      document.querySelectorAll('.tool-card-name, .tool-name-desktop').forEach((el) => {
        const id = el.getAttribute('data-tool-id');
        if (id && data.tools[id]) el.textContent = data.tools[id].name;
      });

      document.querySelectorAll('.tool-badge-text').forEach((el) => {
        const id = el.getAttribute('data-tool-id');
        if (id && data.tools[id]) el.textContent = data.tools[id].badge;
      });

      // 8. Feature Cards Section
      const featHeading = document.getElementById('feature-section-heading');
      const featSubheading = document.getElementById('feature-section-subheading');
      const f1Title = document.getElementById('feature-card-1-title');
      const f1Text = document.getElementById('feature-card-1-text');
      const f2Title = document.getElementById('feature-card-2-title');
      const f2Text = document.getElementById('feature-card-2-text');
      const f3Title = document.getElementById('feature-card-3-title');
      const f3Text = document.getElementById('feature-card-3-text');

      if (featHeading) featHeading.textContent = data.featureHeading;
      if (featSubheading) featSubheading.textContent = data.featureSubheading;
      if (f1Title) f1Title.textContent = data.feature1Title;
      if (f1Text) f1Text.textContent = data.feature1Text;
      if (f2Title) f2Title.textContent = data.feature2Title;
      if (f2Text) f2Text.textContent = data.feature2Text;
      if (f3Title) f3Title.textContent = data.feature3Title;
      if (f3Text) f3Text.textContent = data.feature3Text;

      // 9. FAQ Section
      const faqHeading = document.getElementById('faq-section-heading');
      const faqSubheading = document.getElementById('faq-section-subheading');
      if (faqHeading) faqHeading.textContent = data.faqHeading;
      if (faqSubheading) faqSubheading.textContent = data.faqSubheading;

      document.querySelectorAll('.faq-question-text').forEach((el) => {
        const id = el.getAttribute('data-faq-id');
        if (id && data.faqs[id]) el.textContent = data.faqs[id].q;
      });

      document.querySelectorAll('.faq-answer-text').forEach((el) => {
        const id = el.getAttribute('data-faq-id');
        if (id && data.faqs[id]) el.textContent = data.faqs[id].a;
      });

      if (searchInput && searchInput.value.trim()) {
        filterTools(searchInput.value);
      }
    }

    // Toggle Button Event Listener
    const toggleBtn = document.getElementById('fac-france-lang-toggle');
    const frSpan = document.getElementById('header-lang-fr');
    const enSpan = document.getElementById('header-lang-en');

    if (toggleBtn) {
      toggleBtn.addEventListener('click', function (e) {
        if (enSpan && (e.target === enSpan || enSpan.contains(e.target))) {
          updateLanguage('en');
          return;
        }
        if (frSpan && (e.target === frSpan || frSpan.contains(e.target))) {
          updateLanguage('fr');
          return;
        }
        updateLanguage(currentLang === 'fr' ? 'en' : 'fr');
      });
    }

    // Category Buttons Click Handler (Fix for Finance & other Category Navigation)
    const categoryButtons = document.querySelectorAll('.category-filter-btn');
    categoryButtons.forEach((btn) => {
      btn.addEventListener('click', function (e) {
        const cat = btn.getAttribute('data-category');
        if (cat === 'finance') {
          window.location.href = '/countries/france/finance/';
        } else {
          const href = btn.getAttribute('href');
          if (href) {
            window.location.href = href;
          }
        }
      });
    });

    // Search Input Event Listeners
    if (searchInput) {
      searchInput.addEventListener('input', function (e) {
        filterTools(e.target.value);
      });

      searchInput.addEventListener('focus', function () {
        if (searchInput.value.trim().length > 0) {
          openDropdown();
        }
      });

      searchInput.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown') {
          if (!dirDropdown.classList.contains('visible') && !dirDropdown.classList.contains('opacity-100')) {
            filterTools(searchInput.value);
            return;
          }
          e.preventDefault();
          if (currentDropdownMatches.length > 0) {
            activeDropdownIndex = (activeDropdownIndex + 1) % currentDropdownMatches.length;
            updateActiveDropdownItem();
          }
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (currentDropdownMatches.length > 0) {
            activeDropdownIndex = (activeDropdownIndex - 1 + currentDropdownMatches.length) % currentDropdownMatches.length;
            updateActiveDropdownItem();
          }
        } else if (e.key === 'Enter') {
          if (currentDropdownMatches.length > 0) {
            e.preventDefault();
            const targetItem = activeDropdownIndex >= 0 ? currentDropdownMatches[activeDropdownIndex] : currentDropdownMatches[0];
            if (targetItem && targetItem.href) {
              window.location.href = targetItem.href;
            }
          }
        } else if (e.key === 'Escape') {
          closeDropdown();
        }
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
          filterTools('');
        }
      });
    }

    const resetBtn = document.getElementById('reset-directory-search-btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        filterTools('');
      });
    }

    // Close dropdown on click outside
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.fac-search-wrapper') && !e.target.closest('#directory-filter-dropdown')) {
        closeDropdown();
      }
    });

    // Global Ctrl+K / Cmd+K listener
    document.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        if (searchInput) {
          searchInput.focus();
          searchInput.select();
        }
      }
    });

    // Typewriter effect for France search bar
    let typewriterTimer = null;
    function initFranceTypewriter() {
      const searchWrapper = document.querySelector('.fac-search-wrapper');
      if (searchWrapper) {
        searchWrapper.__facTypewriterInit = true;
      }
      const textEl = document.querySelector('.fac-typewriter-text');
      const container = document.querySelector('.fac-typewriter-container');
      if (!textEl || !searchInput) return;

      let promptIndex = 0;
      let charIndex = 0;
      let isDeleting = false;

      function stepTypewriter() {
        const prompts = CONTENT[currentLang]?.typewriterPrompts || CONTENT['fr'].typewriterPrompts;
        const currentPrompt = prompts[promptIndex % prompts.length];

        if (!isDeleting) {
          charIndex++;
          textEl.textContent = currentPrompt.substring(0, charIndex);
        } else {
          charIndex--;
          textEl.textContent = currentPrompt.substring(0, charIndex);
        }

        let delay = isDeleting ? 25 : 60;
        if (!isDeleting && charIndex === currentPrompt.length) {
          delay = 2200;
          isDeleting = true;
        } else if (isDeleting && charIndex === 0) {
          isDeleting = false;
          promptIndex = (promptIndex + 1) % prompts.length;
          delay = 300;
        }

        typewriterTimer = setTimeout(stepTypewriter, delay);
      }

      if (typewriterTimer) clearTimeout(typewriterTimer);
      typewriterTimer = setTimeout(stepTypewriter, 400);

      searchInput.addEventListener('focus', function () {
        if (typewriterTimer) clearTimeout(typewriterTimer);
        if (container) {
          container.style.display = 'none';
          container.classList.add('opacity-0');
        }
      });

      searchInput.addEventListener('blur', function () {
        if (!searchInput.value.trim()) {
          if (container) {
            container.style.display = 'flex';
            container.classList.remove('opacity-0');
          }
          charIndex = 0;
          isDeleting = false;
          if (typewriterTimer) clearTimeout(typewriterTimer);
          typewriterTimer = setTimeout(stepTypewriter, 300);
        }
      });

      searchInput.addEventListener('input', function () {
        if (searchInput.value.trim().length > 0) {
          if (typewriterTimer) clearTimeout(typewriterTimer);
          if (container) {
            container.style.display = 'none';
            container.classList.add('opacity-0');
          }
        } else if (document.activeElement !== searchInput) {
          if (container) {
            container.style.display = 'flex';
            container.classList.remove('opacity-0');
          }
        }
      });
    }

    if (searchInput) {
      searchInput.value = '';
    }
    initFranceTypewriter();
    filterTools('');

    // Synchronize initial state
    if (currentLang === 'en') {
      updateLanguage('en');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFranceSearchAndFilter);
  } else {
    initFranceSearchAndFilter();
  }
</script>

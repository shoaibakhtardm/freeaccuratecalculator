<Layout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
  lang="fr-FR"
>
  <!-- [PART 9: SEO & HREFLANG HEAD TAGS] -->
  <Fragment slot="head">
    <meta name="geo.region" content="FR" />
    <meta name="geo.placename" content="France" />
    <link rel="alternate" hreflang="fr" href="https://freeaccuratecalculator.com/fr/" />
    <link rel="alternate" hreflang="en" href="https://freeaccuratecalculator.com/en/countries/france/" />
    <link rel="alternate" hreflang="x-default" href="https://freeaccuratecalculator.com/" />
  </Fragment>

  <!-- [PART 1 & PART 10: TOP HEADER WITH FRANCE BADGE AND BILINGUAL TOGGLE] -->
  <Fragment slot="header">
    <header
      id="main-header"
      class="sticky top-0 left-0 right-0 z-50 w-full bg-white/90 dark:bg-gray-950/90 backdrop-blur-xl border-b border-slate-200/80 dark:border-slate-800/80 transition-all duration-300"
    >
      <!-- Royal Jewel Ribbon at Top -->
      <div
        class="h-[2.5px] w-full bg-gradient-to-r from-blue-600 via-indigo-600 via-purple-600 to-pink-500 shadow-[0_1px_6px_rgba(99,102,241,0.4)]"
        aria-hidden="true"
      ></div>

      <div
        class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 flex items-center justify-between h-[66px] sm:h-20 gap-2 sm:gap-4"
      >
        <!-- Logo with France Badge and French Alt -->
        <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
          <a
            href="/countries/france/"
            aria-label="Calculatrices Gratuites France"
            class="group relative inline-flex items-center gap-2 sm:gap-3.5 select-none shrink-0 py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 rounded-2xl transition-all duration-300 hover:scale-[1.015] active:scale-[0.985]"
          >
            <!-- Royal Jewel Emblem -->
            <div class="relative shrink-0 flex items-center justify-center">
              <div
                class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 opacity-25 dark:opacity-40 blur-md group-hover:opacity-75 transition-all duration-500 pointer-events-none"
                aria-hidden="true"
              ></div>
              <div
                class="relative p-[1.2px] sm:p-[1.5px] rounded-2xl bg-gradient-to-b from-blue-400/80 via-indigo-500/60 to-purple-700/80 shadow-sm sm:shadow-md shadow-indigo-500/20 group-hover:shadow-xl group-hover:scale-105 transition-all duration-300 ease-out"
              >
                <div
                  class="relative flex h-8.5 w-8.5 sm:h-10.5 sm:w-10.5 items-center justify-center rounded-[13px] sm:rounded-[14.5px] bg-gradient-to-br from-blue-600 via-indigo-800 to-slate-950 text-white overflow-hidden"
                >
                  <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/10 to-white/30 pointer-events-none" aria-hidden="true"></div>
                  <svg class="h-4.5 w-4.5 sm:h-5.5 sm:w-5.5 text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="3.5" y="2.5" width="17" height="19" rx="3.5"></rect>
                    <rect x="6.5" y="5.5" width="11" height="4" rx="1.5" fill="currentColor" fill-opacity="0.2"></rect>
                    <line x1="8.5" y1="7.5" x2="15.5" y2="7.5" stroke-linecap="round"></line>
                    <circle cx="8" cy="13" r="1.1" fill="currentColor"></circle>
                    <circle cx="12" cy="13" r="1.1" fill="currentColor"></circle>
                    <rect x="15" y="12" width="2.2" height="2.2" rx="0.6" fill="currentColor" class="text-amber-400"></rect>
                    <circle cx="8" cy="17" r="1.1" fill="currentColor"></circle>
                    <circle cx="12" cy="17" r="1.1" fill="currentColor"></circle>
                    <rect x="15" y="16" width="2.2" height="2.2" rx="0.6" fill="currentColor" class="text-cyan-400"></rect>
                  </svg>
                </div>
              </div>
            </div>

            <!-- Brand Wordmark -->
            <div class="flex flex-col justify-center text-left min-w-0">
              <div class="flex items-center gap-1.5 leading-none">
                <span class="font-outfit text-[20px] sm:text-[24px] font-black tracking-tight bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 dark:from-blue-400 dark:via-indigo-300 dark:to-purple-300 bg-clip-text text-transparent inline-block">
                  Free
                </span>
                <span class="relative flex h-2 w-2 -mt-0.5" aria-hidden="true">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
                </span>
              </div>
              <div class="flex items-center gap-1 leading-none mt-0.5 sm:mt-1">
                <span class="font-outfit text-[11px] sm:text-[12.5px] font-extrabold tracking-tight text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors whitespace-nowrap">
                  Accurate
                </span>
                <span class="font-outfit text-[11px] sm:text-[12.5px] font-medium tracking-tight text-slate-500 dark:text-slate-400 whitespace-nowrap">
                  Calculator
                </span>
              </div>
            </div>
          </a>

          <!-- France Badge Next to Logo -->
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg border border-slate-200/90 dark:border-slate-800/90 bg-slate-50 dark:bg-slate-900/80 text-[11px] sm:text-xs font-bold text-slate-800 dark:text-slate-200 shadow-2xs select-none">
            <span>🇫🇷</span>
            <span>France</span>
          </span>
        </div>

        <!-- Right Section: Language Toggle "🇫🇷 FR | 🇬🇧 EN" + Theme Toggle -->
        <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
          <button
            type="button"
            id="fac-france-lang-toggle"
            class="group relative flex items-center justify-between gap-1.5 sm:gap-2 px-2.5 sm:px-3.5 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white/85 dark:bg-slate-900/85 hover:bg-slate-50 dark:hover:bg-slate-800/90 hover:border-indigo-500/40 dark:hover:border-indigo-400/40 shadow-xs hover:shadow-md hover:shadow-indigo-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-950 min-h-[44px] sm:min-h-[38px] h-11 sm:h-9 cursor-pointer transition-all duration-300 select-none text-xs font-semibold"
            aria-label="Changer de langue (FR / EN)"
          >
            <span
              id="header-lang-fr"
              class="inline-flex items-center gap-1 font-bold text-indigo-600 dark:text-indigo-400 transition-colors"
            >
              <span class="text-sm">🇫🇷</span>
              <span>FR</span>
            </span>
            <span class="text-slate-300 dark:text-slate-600 select-none">|</span>
            <span
              id="header-lang-en"
              class="inline-flex items-center gap-1 font-medium text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-colors"
            >
              <span class="text-sm">🇬🇧</span>
              <span>EN</span>
            </span>
          </button>

          <!-- Theme Toggle -->
          <ThemeToggle id="theme-toggle" />
        </div>
      </div>
    </header>
  </Fragment>

  <div class="max-w-7xl mx-auto space-y-8">
    <!-- [PART 1 - ITEM 3: BREADCRUMBS "Accueil > Pays > France"] -->
    <nav
      aria-label="Breadcrumbs"
      class="mb-6 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs text-mute"
    >
      <a href="/" class="hover:text-ink transition-colors flex items-center gap-1 py-1">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
          ></path>
        </svg>
        <span id="breadcrumb-home">Accueil</span>
      </a>

      <div class="flex items-center gap-1.5">
        <svg class="h-3 w-3 text-faint shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <a href="/countries/" class="hover:text-ink transition-colors py-1" id="breadcrumb-countries">
          Pays
        </a>
      </div>

      <div class="flex items-center gap-1.5">
        <svg class="h-3 w-3 text-faint shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="text-ink font-medium select-none py-1" aria-current="page" id="breadcrumb-france">
          France
        </span>
      </div>
    </nav>

    <!-- [PART 1 - ITEMS 2 & 4: HERO BANNER (FRENCH LOCALIZATION)] -->
    <section class="relative overflow-hidden rounded-3xl sm:rounded-[36px] border border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-slate-950/70 px-4 py-8 sm:py-14 md:py-16 text-center hero-mesh-gradient shadow-xs sm:shadow-lg backdrop-blur-xl">
      <!-- Ambient Studio Glow -->
      <div
        class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 sm:w-[580px] h-44 sm:h-72 bg-gradient-to-b from-indigo-500/20 via-blue-500/10 to-transparent blur-3xl pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 mx-auto max-w-3xl space-y-4 sm:space-y-6">
        <!-- Hero Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-slate-200/90 dark:border-slate-800/90 bg-gradient-to-r from-slate-500/8 via-indigo-500/8 to-purple-500/8 dark:from-slate-500/15 dark:via-indigo-500/15 dark:to-purple-500/15 px-3.5 py-1.5 shadow-2xs backdrop-blur-md select-none">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="inline-flex h-3.5 w-5 shrink-0 items-center justify-center rounded-[2px] overflow-hidden border border-slate-200/80 dark:border-slate-700/80 shadow-2xs">
            <img src="/flags/fr.svg" alt="Drapeau France" class="w-full h-full object-cover" loading="lazy" decoding="async" width="20" height="14" />
          </span>
          <span id="hero-badge-text" class="font-outfit text-[11px] sm:text-xs font-bold tracking-wider uppercase text-slate-700 dark:text-slate-200">
            🇫🇷 ÉDITION FRANCE • EUR (€) • Conformité RGPD
          </span>
          <span class="text-indigo-500 dark:text-indigo-400 text-xs font-bold ml-0.5">✦</span>
        </div>

        <!-- Main H1 Headline -->
        <h1 class="display-hero font-outfit text-3xl sm:text-5xl lg:text-[56px] xl:text-[60px] font-black tracking-[-0.035em] text-slate-900 dark:text-white leading-[1.12] sm:leading-[1.08] text-balance">
          <span id="hero-headline-main">Calculatrices pour la France.</span> <br class="hidden sm:inline" />
          <span
            id="hero-headline-highlight"
            class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 dark:from-blue-400 dark:via-indigo-300 dark:to-purple-300 bg-clip-text text-transparent"
          >
            Rapides, Précises et Fiables.
          </span>
        </h1>

        <!-- Subtitle -->
        <p
          id="hero-subtitle"
          class="font-sans text-xs sm:text-sm md:text-base text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal text-balance px-2"
        >
          Calculatrices optimisées pour les conventions financières françaises, formatage EUR (€) et groupements internationaux standards. Démarrage instantané et confidentialité totale.
        </p>
      </div>
    </section>

    <!-- [PART 2 & PART 3: CATEGORIES AND SINGLE FUNCTIONAL SEARCH BAR] -->
    <nav
      id="categories-nav-section"
      aria-label="Catégories de calculatrices France"
      class="w-full max-w-2xl sm:max-w-3xl lg:max-w-4xl mx-auto rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-800/90 bg-white/80 dark:bg-slate-900/80 p-3 sm:p-5 md:p-6 shadow-sm dark:shadow-xl backdrop-blur-xl box-border text-center"
    >
      <div class="flex items-center justify-center border-b border-slate-200/80 dark:border-slate-800/80 pb-3 sm:pb-3.5 mb-3.5 sm:mb-4 px-1 text-center">
        <h2 class="font-outfit text-xs sm:text-sm font-black uppercase tracking-[0.2em] text-slate-900 dark:text-white flex items-center justify-center gap-2">
          <span class="text-base sm:text-lg">📁</span>
          <span id="categories-heading-text">Catégories</span>
        </h2>
      </div>

      <!-- [PART 3 - ITEMS 6 & 7: SINGLE PRIMARY SEARCH BAR WITH LIVE SUGGESTIONS] -->
      <div class="relative mb-4 sm:mb-5 max-w-xl mx-auto w-full px-1">
        <div class="fac-search-wrapper relative flex items-center group rounded-2xl sm:rounded-full transition-shadow duration-300" data-custom-typewriter="true">
          <div class="fac-neon-orbit-wrapper absolute -inset-[2px] rounded-2xl sm:rounded-full overflow-hidden pointer-events-none" aria-hidden="true">
            <div class="fac-neon-orbit-beam"></div>
          </div>
          <div
            class="fac-search-track absolute inset-0 rounded-2xl sm:rounded-full border border-slate-200/90 dark:border-slate-800/90 bg-white/95 dark:bg-slate-900/95 pointer-events-none transition-colors duration-300 group-hover:border-slate-300 dark:group-hover:border-slate-700 z-10"
            aria-hidden="true"
          ></div>
          <svg
            class="absolute left-4 sm:left-4.5 h-4.5 w-4.5 sm:h-5 sm:w-5 text-slate-400 dark:text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-300 group-focus-within:text-blue-600 dark:group-focus-within:text-sky-400 transition-colors duration-200 pointer-events-none z-30"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>

          <!-- Typewriter Suggestion Overlay -->
          <div
            class="fac-typewriter-container absolute left-11.5 sm:left-12.5 right-24 pointer-events-none overflow-hidden flex items-center h-full z-20 select-none transition-opacity duration-200"
            aria-hidden="true"
          >
            <div class="flex items-center whitespace-nowrap overflow-hidden pl-0.5">
              <span class="fac-typewriter-text font-semibold text-slate-700 dark:text-slate-200 text-xs sm:text-sm md:text-base tracking-tight sm:tracking-normal"></span>
              <span class="fac-typewriter-cursor inline-block w-[2px] h-3.5 sm:h-4.5 bg-cyan-500 dark:bg-cyan-400 ml-0.5 rounded-full"></span>
            </div>
          </div>

          <label for="categories-france-search-input" class="sr-only">Rechercher</label>
          <input
            id="categories-france-search-input"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder=""
            class="fac-search-input relative z-20 w-full rounded-2xl sm:rounded-full bg-transparent py-3 sm:py-3.5 pl-11 sm:pl-12 pr-24 text-xs sm:text-sm md:text-base font-bold text-slate-900 dark:text-white placeholder:font-medium placeholder-slate-400 dark:placeholder-slate-400 shadow-sm outline-none border-none ring-0 transition-all tracking-tight sm:tracking-normal"
            aria-label="Rechercher"
            aria-autocomplete="list"
            aria-controls="directory-filter-dropdown"
            aria-expanded="false"
          />

          <!-- Shortcut Chip & Clear Button -->
          <div class="absolute right-3.5 top-1/2 -translate-y-1/2 z-20 flex items-center gap-1.5">
            <button
              type="button"
              id="fac-search-clear-btn"
              class="hidden p-1.5 rounded-full text-slate-400 hover:text-cyan-500 dark:hover:text-cyan-400 hover:bg-cyan-500/10 dark:hover:bg-cyan-500/20 transition-all cursor-pointer focus:outline-none"
              aria-label="Effacer la recherche"
              title="Effacer"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Floating Live Suggestions Dropdown Panel -->
        <div
          id="directory-filter-dropdown"
          class="fac-suggestions-panel absolute left-0 right-0 top-full mt-2.5 z-50 rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-2xl shadow-2xl shadow-slate-900/15 dark:shadow-black/50 overflow-hidden text-left transition-all duration-200 origin-top opacity-0 scale-95 pointer-events-none invisible"
          role="listbox"
        >
          <!-- Results Header -->
          <div class="px-4 py-2.5 border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
            <span id="directory-dropdown-title">Outils suggérés</span>
            <span class="text-[10px] lowercase font-normal hidden sm:inline" id="directory-dropdown-enter-hint">↵ pour ouvrir</span>
          </div>

          <!-- Scrollable Results List -->
          <div id="directory-dropdown-list" class="max-h-[300px] sm:max-h-[360px] overflow-y-auto p-1.5 space-y-1">
            <!-- Injected dynamically by client JS -->
          </div>

          <!-- Empty State in Dropdown -->
          <div id="directory-no-results-panel" class="hidden p-6 text-center space-y-1.5">
            <div class="text-2xl">🔍</div>
            <p class="text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-200" id="directory-no-results-title">
            </p>
            <p class="text-[11px] text-slate-400 dark:text-slate-500" id="directory-no-results-subtitle">
            </p>
          </div>

          <!-- Footer Quick Help -->
          <div class="px-4 py-2 border-t border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/50 flex items-center justify-between text-[10px] text-slate-400 dark:text-slate-500">
            <span class="flex items-center gap-1">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              <span id="directory-footer-badge">Calculatrices Populaires France</span>
            </span>
            <div class="flex items-center gap-2">
              <span class="hidden sm:inline"><kbd class="px-1 py-0.5 rounded bg-slate-200/80 dark:bg-slate-800">↑</kbd> <kbd class="px-1 py-0.5 rounded bg-slate-200/80 dark:border-slate-800">↓</kbd> <span id="directory-footer-nav-hint">↑ ↓ pour naviguer</span></span>
              <span><kbd class="px-1 py-0.5 rounded bg-slate-200/80 dark:border-slate-800">esc</kbd> <span id="directory-footer-esc-hint">esc pour fermer</span></span>
            </div>
          </div>
        </div>
      </div>

      <!-- 20 Categories in 3-Column Grid Layout -->
      <div class="grid grid-cols-3 gap-2 sm:gap-3 md:gap-3.5">
        {CATEGORIES_DATA.map((cat) => (
          <a
            href={`/countries/france/${cat.id}/`}

---
// src/pages/countries/[country]/[category]/[slug].astro
import CountryCalculatorView from '../../../../components/calculator/CountryCalculatorView.astro';
import { COUNTRY_LIST, type CountryConfig } from '../../../../data/countries';
import { CALCULATORS, type CalculatorEntry } from '../../../../data/calculatorRegistry';

export async function getStaticPaths() {
  const paths: Array<{
    params: { country: string; category: string; slug: string };
    props: {
      country: CountryConfig;
      calc: CalculatorEntry;
    };
  }> = [];

  for (const country of COUNTRY_LIST.filter((c) => c.slug !== 'france')) {
    const popularSet = new Set(country.popularCalculators);
    const calcsForCountry = country.slug === 'france'
      ? CALCULATORS.filter(
          (c) =>
            ![
              '401k-calculator',
              'roth-ira-calculator',
              'ppf-calculator',
              'epf-calculator',
              'gratuity-calculator',
              'age-calculator',
              'calorie-calculator',
              'bmi-calculator',
              'date-calculator',
              'percentage-calculator',
            ].includes(c.id)
        )
      : CALCULATORS.filter((c) => {
          if (popularSet.has(c.id)) return true;
          if (popularSet.has('emi-calculator') && c.id === 'loan-calculator') return true;
          if (popularSet.has('stamp-duty-calculator') && c.id === 'property-tax-calculator') return true;
          if (country.slug === 'united-kingdom' && c.id === 'property-tax-calculator') return true;
          if (popularSet.has('vat-calculator') && c.id === 'sales-tax-calculator') return true;
          if (popularSet.has('income-tax-calculator') && c.id === 'salary-calculator') return true;
          if (popularSet.has('salary-calculator') && c.id === 'income-tax-calculator') return true;
          return false;
        });

    for (const calc of calcsForCountry) {
      paths.push({
        params: {
          country: country.slug,
          category: calc.category,
          slug: calc.id,
        },
        props: {
          country,
          calc,
        },
      });

      // Global country aliases — only add if not already a direct popular calc (avoids duplicate route conflicts)
      if (calc.id === 'loan-calculator' && !popularSet.has('emi-calculator')) {
        paths.push({
          params: { country: country.slug, category: 'finance', slug: 'emi-calculator' },
          props: { country, calc },
        });
      }
      if (calc.id === 'salary-calculator' && !popularSet.has('income-tax-calculator') && !popularSet.has('salary-calculator')) {
        paths.push({
          params: { country: country.slug, category: 'finance', slug: 'income-tax-calculator' },
          props: { country, calc },
        });
      }
      if (calc.id === 'sales-tax-calculator' && !popularSet.has('vat-calculator')) {
        paths.push({
          params: { country: country.slug, category: 'finance', slug: 'vat-calculator' },
          props: { country, calc },
        });
      }
      if (country.slug === 'united-kingdom' && calc.id === 'property-tax-calculator' && !popularSet.has('stamp-duty-calculator')) {
        paths.push({
          params: { country: 'united-kingdom', category: 'real-estate', slug: 'stamp-duty-calculator' },
          props: { country, calc },
        });
      }
    }
  }

  return paths;
}

interface Props {
  country: CountryConfig;
  calc: CalculatorEntry;
}

const { country, calc } = Astro.props;
---

<CountryCalculatorView country={country} calc={calc} />

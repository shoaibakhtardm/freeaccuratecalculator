---
// src/pages/countries/[country]/index.astro
import DirectoryPageView from '../../../components/directory/DirectoryPageView.astro';
import { COUNTRY_LIST, type CountryConfig } from '../../../data/countries';
import { getCountryPageConfig } from '../../../data/countryPageConfig';

export async function getStaticPaths() {
  return COUNTRY_LIST.map((country) => ({
    params: { country: country.slug },
    props: { country },
  }));
}

interface Props {
  country: CountryConfig;
}

const { country } = Astro.props;
const config = getCountryPageConfig(country);
---

<DirectoryPageView {...config} />

---
// src/pages/countries/[country]/[slug].astro
import DirectoryPageView from '../../../components/directory/DirectoryPageView.astro';
import CountryCalculatorView from '../../../components/calculator/CountryCalculatorView.astro';
import { COUNTRY_LIST, type CountryConfig } from '../../../data/countries';
import { CALCULATORS, type CalculatorEntry } from '../../../data/calculatorRegistry';
import { getCountryCategories, type CategoryItem } from '../../../data/categories';
import { getCountryCategoryPageConfig, type CountryPageConfig } from '../../../data/countryPageConfig';

export async function getStaticPaths() {
  const paths: Array<{
    params: { country: string; slug: string };
    props: {
      type: 'calculator' | 'category';
      country: CountryConfig;
      calc?: CalculatorEntry;
      category?: CategoryItem;
      categoryConfig?: CountryPageConfig;
    };
  }> = [];

  for (const country of COUNTRY_LIST) {
    // 1. Prerender popular calculators for this country
    const popularSet = new Set(country.popularCalculators);
    const calcsForCountry = CALCULATORS.filter((c) => popularSet.has(c.id));

    for (const calc of calcsForCountry) {
      paths.push({
        params: {
          country: country.slug,
          slug: calc.id,
        },
        props: {
          type: 'calculator',
          country,
          calc,
        },
      });
    }

    // 2. Prerender country category directory pages
    const countryCategories = getCountryCategories(country);
    for (const category of countryCategories) {
      if (country.slug === 'france' && category.id === 'finance') continue;
      paths.push({
        params: {
          country: country.slug,
          slug: category.id,
        },
        props: {
          type: 'category',
          country,
          category,
          categoryConfig: getCountryCategoryPageConfig(country, category.id),
        },
      });
    }
  }

  return paths;
}

interface Props {
  type: 'calculator' | 'category';
  country: CountryConfig;
  calc?: CalculatorEntry;
  category?: CategoryItem;
  categoryConfig?: CountryPageConfig;
}

const { type, country, calc, categoryConfig } = Astro.props;
---

{type === 'category' && categoryConfig ? (
  <DirectoryPageView {...categoryConfig} />
) : (
  calc && <CountryCalculatorView country={country} calc={calc} />
)}

---
// src/pages/countries/[country]/[slug].astro
import DirectoryPageView from '../../../components/directory/DirectoryPageView.astro';
import CountryCalculatorView from '../../../components/calculator/CountryCalculatorView.astro';
import { COUNTRY_LIST, type CountryConfig } from '../../../data/countries';
import { CALCULATORS, type CalculatorEntry } from '../../../data/calculatorRegistry';
import { getCountryCategories, type CategoryItem } from '../../../data/categories';
import { getCountryCategoryPageConfig, type CountryPageConfig } from '../../../data/countryPageConfig';
import { frCategories, frUI } from '../../../data/i18n';

export async function getStaticPaths() {
  const paths: Array<{
    params: { country: string; slug: string };
    props: {
      type: 'calculator' | 'category';
      country: CountryConfig;
      calc?: CalculatorEntry;
      category?: CategoryItem;
      categoryConfig?: CountryPageConfig;
    };
  }> = [];

  for (const country of COUNTRY_LIST.filter((c) => c.slug !== 'france')) {
    // 1. Prerender popular calculators for this country (all non-foreign calculators for France)
    const popularSet = new Set(country.popularCalculators);
    const calcsForCountry = country.slug === 'france'
      ? CALCULATORS.filter(
          (c) =>
            ![
              '401k-calculator',
              'roth-ira-calculator',
              'ppf-calculator',
              'epf-calculator',
              'gratuity-calculator',
            ].includes(c.id)
        )
      : CALCULATORS.filter((c) => {
          if (popularSet.has(c.id)) return true;
          if (popularSet.has('emi-calculator') && c.id === 'loan-calculator') return true;
          if (popularSet.has('stamp-duty-calculator') && c.id === 'property-tax-calculator') return true;
          if (country.slug === 'united-kingdom' && c.id === 'property-tax-calculator') return true;
          if (popularSet.has('vat-calculator') && c.id === 'sales-tax-calculator') return true;
          if (popularSet.has('income-tax-calculator') && c.id === 'salary-calculator') return true;
          if (popularSet.has('salary-calculator') && c.id === 'income-tax-calculator') return true;
          return false;
        });

    for (const calc of calcsForCountry) {
      paths.push({
        params: {
          country: country.slug,
          slug: calc.id,
        },
        props: {
          type: 'calculator',
          country,
          calc,
        },
      });

      // Global country aliases
      if (calc.id === 'loan-calculator') {
        paths.push({
          params: { country: country.slug, slug: 'emi-calculator' },
          props: { type: 'calculator', country, calc },
        });
      }
      if (calc.id === 'salary-calculator') {
        paths.push({
          params: { country: country.slug, slug: 'income-tax-calculator' },
          props: { type: 'calculator', country, calc },
        });
      }
      if (calc.id === 'sales-tax-calculator') {
        paths.push({
          params: { country: country.slug, slug: 'vat-calculator' },
          props: { type: 'calculator', country, calc },
        });
      }
      if (country.slug === 'united-kingdom' && calc.id === 'property-tax-calculator') {
        paths.push({
          params: { country: 'united-kingdom', slug: 'stamp-duty-calculator' },
          props: { type: 'calculator', country, calc },
        });
      }
    }

    // 2. Prerender country category directory pages
    const countryCategories = getCountryCategories(country);
    for (const category of countryCategories) {
      if (country.slug === 'france' && category.id === 'finance') continue;
      paths.push({
        params: {
          country: country.slug,
          slug: category.id,
        },
        props: {
          type: 'category',
          country,
          category,
          categoryConfig: getCountryCategoryPageConfig(country, category.id),
        },
      });
    }
  }

  return paths;
}

interface Props {
  type: 'calculator' | 'category';
  country: CountryConfig;
  calc?: CalculatorEntry;
  category?: CategoryItem;
  categoryConfig?: CountryPageConfig;
}

const { type, country, calc, categoryConfig } = Astro.props;
const isFrench = country?.slug === 'france' || Astro.params.country === 'france';
---

{type === 'category' && categoryConfig ? (
  <DirectoryPageView {...categoryConfig} isFrench={isFrench} />
) : (
  calc && <CountryCalculatorView country={country} calc={calc} />
)}

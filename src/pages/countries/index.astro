---
// src/pages/countries/index.astro
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { COUNTRY_LIST, getCountryBySlug } from '../../data/countries';

const title = 'Online Calculators by Country — Free Accurate Calculator';
const description = 'Select your nation to access mathematically verified calculators customized for your currency, national tax rules, and local number standards.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: description,
  url: 'https://freeaccuratecalculator.com/countries/',
};

// Exact featured countries from official design specification
const FEATURED_SLUGS = [
  'india',
  'united-states',
  'united-kingdom',
  'canada',
  'australia',
  'united-arab-emirates',
  'germany',
  'france',
  'singapore',
  'ireland',
  'netherlands',
  'new-zealand',
  'saudi-arabia',
  'switzerland',
  'south-africa',
];

const featuredCountries = FEATURED_SLUGS
  .map((slug) => getCountryBySlug(slug))
  .filter(Boolean) as typeof COUNTRY_LIST;

const otherCountries = COUNTRY_LIST.filter(
  (c) => !FEATURED_SLUGS.includes(c.slug)
);

const allOrderedCountries = [...featuredCountries, ...otherCountries];
---

<Layout title={title} description={description} jsonLd={schema}>
  <div class="max-w-6xl mx-auto py-6 sm:py-10 px-4 space-y-8">
    <!-- Breadcrumbs Navigation -->
    <Breadcrumbs items={[{ label: 'Countries' }]} />

    <!-- Main Container Matching Exact Screenshot UI Specification -->
    <div class="relative rounded-[28px] border border-[#162238] bg-[#070b15] p-5 sm:p-10 md:p-12 shadow-2xl overflow-hidden">
      <!-- Ambient Glow Orbs -->
      <div class="pointer-events-none absolute -top-32 -right-32 w-80 h-80 rounded-full bg-blue-600/10 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-32 -left-32 w-80 h-80 rounded-full bg-cyan-500/10 blur-3xl"></div>

      <!-- Centered Header Section: Globe + Bold Uppercase Title -->
      <div class="flex flex-col items-center justify-center text-center space-y-4 mb-8 sm:mb-10">
        <div class="inline-flex items-center gap-2.5 select-none">
          <span class="text-xl sm:text-2xl leading-none">🌍</span>
          <h1 class="text-sm sm:text-base font-black tracking-[0.25em] text-white uppercase font-sans">
            COUNTRIES
          </h1>
        </div>

        <!-- Quick Live Filter Search Box -->
        <div class="w-full max-w-sm pt-2">
          <div class="relative flex items-center">
            <svg class="absolute left-3.5 h-4 w-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              id="country-search-input"
              type="search"
              placeholder="Search nation or currency..."
              class="w-full min-h-[42px] rounded-xl border border-[#1c2c4a] bg-[#0c1424] py-2 pl-10 pr-4 text-xs sm:text-sm font-medium text-white placeholder-slate-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none transition-all shadow-inner"
            />
          </div>
        </div>

        <!-- Category View Controls -->
        <div class="flex items-center gap-2 pt-1 text-xs font-mono">
          <button
            type="button"
            id="tab-featured"
            class="px-3 py-1.5 rounded-lg border border-blue-500/30 bg-blue-600/20 text-sky-300 font-bold transition-all cursor-pointer"
          >
            Featured Hubs (15)
          </button>
          <button
            type="button"
            id="tab-all"
            class="px-3 py-1.5 rounded-lg border border-[#1a2944] bg-[#0b1222] text-slate-400 hover:text-white transition-all cursor-pointer"
          >
            All Nations ({allOrderedCountries.length})
          </button>
        </div>
      </div>

      <!-- Countries 3-Column Grid Matching Exact UI Layout -->
      <div id="countries-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-5">
        {allOrderedCountries.map((country, idx) => {
          const isFeatured = idx < 15;
          return (
            <a
              href={`/countries/${country.slug}/`}
              class={`country-tile group relative rounded-[16px] border border-[#182642] bg-[#0c1424] hover:bg-[#111c33] hover:border-sky-500/50 p-5 sm:p-6 flex flex-col items-center justify-center text-center transition-all duration-200 shadow-md hover:shadow-sky-950/40 hover:-translate-y-0.5 active:scale-[0.98] ${
                isFeatured ? 'is-featured' : 'is-additional hidden'
              }`}
              data-name={country.name.toLowerCase()}
              data-slug={country.slug}
              data-currency={country.currency.toLowerCase()}
              data-featured={isFeatured ? 'true' : 'false'}
            >
              <!-- Flag Icon with Rounded Edges -->
              <span class="flex h-7 w-10 shrink-0 items-center justify-center rounded-[5px] overflow-hidden border border-slate-700/60 shadow-md mb-2.5 group-hover:scale-105 transition-transform duration-200">
                <img
                  src={country.flagUrl}
                  alt={`${country.name} flag`}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                  width="40"
                  height="28"
                />
              </span>

              <!-- Clean Country Name -->
              <span class="text-sm sm:text-base font-bold text-white tracking-wide group-hover:text-sky-400 transition-colors">
                {country.name}
              </span>
            </a>
          );
        })}
      </div>

      <!-- Empty Filter State -->
      <div id="no-countries-found" class="hidden py-12 text-center text-sm font-mono text-slate-400 space-y-2">
        <p>No countries matching your search query.</p>
        <button
          type="button"
          id="clear-search-btn"
          class="text-xs text-sky-400 underline hover:text-sky-300 cursor-pointer"
        >
          Clear search
        </button>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    const searchInput = document.getElementById('country-search-input');
    const tabFeatured = document.getElementById('tab-featured');
    const tabAll = document.getElementById('tab-all');
    const tiles = document.querySelectorAll('.country-tile');
    const noResults = document.getElementById('no-countries-found');
    const clearBtn = document.getElementById('clear-search-btn');

    let activeTab = 'featured'; // 'featured' | 'all'

    function updateVisibility() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      tiles.forEach((tile) => {
        const name = tile.getAttribute('data-name') || '';
        const curr = tile.getAttribute('data-currency') || '';
        const isFeatured = tile.getAttribute('data-featured') === 'true';

        const matchesQuery = !query || name.includes(query) || curr.includes(query);

        if (query) {
          // If searching, search across all countries
          if (matchesQuery) {
            tile.classList.remove('hidden');
            visibleCount++;
          } else {
            tile.classList.add('hidden');
          }
        } else {
          // No query: honor active tab
          if (activeTab === 'featured') {
            if (isFeatured) {
              tile.classList.remove('hidden');
              visibleCount++;
            } else {
              tile.classList.add('hidden');
            }
          } else {
            tile.classList.remove('hidden');
            visibleCount++;
          }
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    if (tabFeatured && tabAll) {
      tabFeatured.addEventListener('click', () => {
        activeTab = 'featured';
        tabFeatured.className = 'px-3 py-1.5 rounded-lg border border-blue-500/30 bg-blue-600/20 text-sky-300 font-bold transition-all cursor-pointer';
        tabAll.className = 'px-3 py-1.5 rounded-lg border border-[#1a2944] bg-[#0b1222] text-slate-400 hover:text-white transition-all cursor-pointer';
        if (searchInput) searchInput.value = '';
        updateVisibility();
      });

      tabAll.addEventListener('click', () => {
        activeTab = 'all';
        tabAll.className = 'px-3 py-1.5 rounded-lg border border-blue-500/30 bg-blue-600/20 text-sky-300 font-bold transition-all cursor-pointer';
        tabFeatured.className = 'px-3 py-1.5 rounded-lg border border-[#1a2944] bg-[#0b1222] text-slate-400 hover:text-white transition-all cursor-pointer';
        if (searchInput) searchInput.value = '';
        updateVisibility();
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', updateVisibility);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        updateVisibility();
      });
    }
  })();
</script>

---
// src/pages/countries/index.astro
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { COUNTRY_LIST } from '../../data/countries';

const title = 'Online Calculators by Country — Free Accurate Calculator';
const description = 'Select your nation to access mathematically verified calculators customized for your currency, national tax rules, and local number standards.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: description,
  url: 'https://freeaccuratecalculator.com/countries/',
};
---

<Layout title={title} description={description} jsonLd={schema}>
  <div class="max-w-2xl sm:max-w-3xl lg:max-w-4xl mx-auto py-6 sm:py-10 px-3 sm:px-4 space-y-6 sm:space-y-8">
    <!-- Breadcrumbs Navigation -->
    <Breadcrumbs items={[{ label: 'Countries' }]} />

    <!-- Main Container Matching Exact Home Page Specification -->
    <section
      aria-label="Country-Wise Calculators"
      class="w-full rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-800/90 bg-white/80 dark:bg-slate-900/80 p-3 sm:p-5 md:p-6 shadow-sm dark:shadow-xl backdrop-blur-xl box-border text-center"
    >
      <!-- Header Section: Globe + Bold Uppercase Title -->
      <div class="flex flex-col items-center justify-center border-b border-slate-200/80 dark:border-slate-800/80 pb-3 sm:pb-4 mb-4 sm:mb-5 px-1 text-center space-y-3">
        <h1 class="font-outfit text-xs sm:text-sm md:text-base font-black uppercase tracking-[0.2em] text-slate-900 dark:text-white flex items-center justify-center gap-2">
          <span class="text-base sm:text-xl">🌍</span>
          <span>Countries</span>
        </h1>

        <!-- Live Instant Filter Search Box -->
        <div class="w-full max-w-sm pt-1">
          <div class="relative flex items-center">
            <svg class="absolute left-3.5 h-4 w-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              id="country-search-input"
              type="search"
              placeholder="Search nation or currency..."
              class="w-full min-h-[38px] sm:min-h-[42px] rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 py-1.5 sm:py-2 pl-10 pr-4 text-xs sm:text-sm font-medium text-slate-900 dark:text-white placeholder-slate-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none transition-all shadow-xs"
            />
          </div>
        </div>
      </div>

      <!-- Exact 3-Column Grid Matching Home Page Design (18 Supported Countries) -->
      <div id="countries-grid" class="grid grid-cols-3 gap-2 sm:gap-3 md:gap-3.5">
        {COUNTRY_LIST.map((country) => (
          <a
            href={`/countries/${country.slug}/`}
            title={`Explore ${country.name} Calculators`}
            class="country-tile group relative flex flex-col items-center justify-center text-center w-full min-w-0 min-h-[72px] sm:min-h-[80px] md:min-h-[88px] rounded-xl sm:rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white/90 dark:bg-slate-950/70 hover:bg-slate-50 dark:hover:bg-slate-800/80 hover:border-indigo-500/50 dark:hover:border-indigo-400/50 p-2 sm:p-2.5 md:p-3 cursor-pointer transition-all duration-200 shadow-2xs hover:shadow-md hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-indigo-500 active:scale-[0.97]"
            data-name={country.name.toLowerCase()}
            data-slug={country.slug}
            data-currency={country.currency.toLowerCase()}
          >
            <span class="flex h-8 w-8 sm:h-9 sm:w-9 md:h-10 md:w-10 shrink-0 items-center justify-center rounded-xl sm:rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 overflow-hidden shadow-2xs group-hover:scale-110 group-hover:border-indigo-400/50 transition-transform mb-1 sm:mb-1.5 p-1.5">
              <img
                src={country.flagUrl}
                alt={`${country.name} flag`}
                class="w-full h-full object-cover rounded-[3px] shadow-2xs"
                loading="lazy"
                decoding="async"
                width="32"
                height="24"
              />
            </span>
            <span class="w-full text-center font-semibold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors text-[10px] sm:text-xs md:text-sm leading-[1.15] break-words line-clamp-2 px-0.5">
              {country.name}
            </span>
          </a>
        ))}
      </div>

      <!-- Empty Filter State -->
      <div id="no-countries-found" class="hidden py-8 sm:py-12 text-center text-xs sm:text-sm text-slate-500 dark:text-slate-400 space-y-2">
        <p>No countries matching your search query.</p>
        <button
          type="button"
          id="clear-search-btn"
          class="text-xs text-indigo-600 dark:text-indigo-400 underline hover:opacity-80 cursor-pointer font-medium"
        >
          Clear search
        </button>
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  (function () {
    const searchInput = document.getElementById('country-search-input');
    const tiles = document.querySelectorAll('.country-tile');
    const noResults = document.getElementById('no-countries-found');
    const clearBtn = document.getElementById('clear-search-btn');

    function updateVisibility() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      tiles.forEach((tile) => {
        const name = tile.getAttribute('data-name') || '';
        const curr = tile.getAttribute('data-currency') || '';

        const matchesQuery = !query || name.includes(query) || curr.includes(query);

        if (matchesQuery) {
          tile.classList.remove('hidden');
          visibleCount++;
        } else {
          tile.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', updateVisibility);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        updateVisibility();
      });
    }
  })();
</script>

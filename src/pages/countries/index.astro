---
// src/pages/countries/index.astro
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import AdSlot from '../../components/common/AdSlot.astro';
import { POPULAR_COUNTRIES, COUNTRY_LIST } from '../../data/countries';

const title = 'Online Calculators by Country — International Finance & Utility Tools';
const description = 'Explore mathematically verified online calculators customized for your country. Localized currencies, tax laws, number systems, and financial rules across 100+ nations.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: description,
  url: 'https://freeaccuratecalculator.com/countries/',
};
---

<Layout title={title} description={description} jsonLd={schema}>
  <div class="max-w-7xl mx-auto space-y-10">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={[{ label: 'Countries' }]} />

    <!-- Hero Section -->
    <section class="relative overflow-hidden rounded-[16px] border border-hairline bg-canvas-elevated/70 px-4 py-8 sm:p-12 hero-mesh-gradient shadow-whisper">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas/80 px-3 py-1 text-xs text-body shadow-whisper">
          <span class="flex h-2 w-2 rounded-full bg-cyan"></span>
          <span class="font-mono text-[11px] font-medium tracking-wide uppercase">Global Calculator Network</span>
        </div>

        <h1 class="display-hero text-ink">Calculators by Country</h1>
        <p class="text-base text-body leading-relaxed">
          Calculations customized for national tax codes, local currencies, Lakh/Crore vs. Million/Billion number formatting, and statutory employment laws. Select your nation below for instant localized precision.
        </p>

        <!-- Live Filter Search -->
        <div class="pt-2 max-w-md">
          <div class="relative flex items-center">
            <svg class="absolute left-3.5 h-4 w-4 text-mute pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              id="country-search"
              type="search"
              placeholder="Search by country or currency (e.g. India, US, EUR)..."
              class="w-full min-h-[44px] rounded-[100px] border border-hairline bg-canvas py-2.5 pl-10 pr-4 text-base sm:text-sm text-ink placeholder-faint shadow-whisper focus:border-link focus:outline-none focus:ring-1 focus:ring-link transition-all"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- AdSlot -->
    <AdSlot slotId="countries-dir-top" format="horizontal" />

    <!-- Popular Countries Spotlight -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-hairline pb-3">
        <div>
          <span class="mono-eyebrow text-link">High Demand</span>
          <h2 class="heading-md text-ink mt-0.5">Popular National Hubs</h2>
        </div>
        <span class="text-xs font-mono text-mute">{POPULAR_COUNTRIES.length} Featured Hubs</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {POPULAR_COUNTRIES.map((c) => (
          <a
            href={`/countries/${c.slug}/`}
            class="country-card group relative flex flex-col justify-between rounded-[12px] border border-hairline bg-canvas-elevated p-5 shadow-whisper transition-all duration-200 hover:-translate-y-0.5 hover:border-hairline-focus hover:shadow-card"
            data-name={c.name.toLowerCase()}
            data-native={c.nativeName.toLowerCase()}
            data-curr={c.currency.toLowerCase()}
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2.5">
                  <span class="text-2xl" role="img" aria-label={c.name}>{c.flag}</span>
                  <div>
                    <h3 class="text-sm font-semibold text-ink group-hover:text-link transition-colors">
                      {c.name}
                    </h3>
                    <span class="text-[11px] font-mono text-mute">{c.nativeName}</span>
                  </div>
                </div>
                <span class="rounded-full border border-hairline-soft bg-canvas px-2 py-0.5 text-[10px] font-mono font-medium text-mute">
                  {c.currency} ({c.currencySymbol})
                </span>
              </div>

              {c.taxSystemName && (
                <p class="text-xs text-body line-clamp-1 mb-2 font-mono text-[11px]">
                  {c.taxSystemName}
                </p>
              )}

              <p class="text-xs text-body leading-relaxed">
                {c.popularCalculators.length} verified calculators optimized for {c.numberSystem === 'lakh-crore' ? 'Lakh/Crore' : 'standard'} formatting.
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-hairline-soft flex items-center justify-between text-xs font-medium text-link">
              <span>View {c.name} Calculators</span>
              <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Mid Directory AdSlot -->
    <AdSlot slotId="countries-dir-mid" format="horizontal" className="my-6" />

    <!-- All Countries Alphabetical Directory -->
    <section class="space-y-4 pt-4">
      <div class="border-b border-hairline pb-3">
        <span class="mono-eyebrow text-link">Global Directory</span>
        <h2 class="heading-md text-ink mt-0.5">All Supported Nations</h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {COUNTRY_LIST.map((c) => (
          <a
            href={`/countries/${c.slug}/`}
            class="country-card group flex items-center gap-2 rounded-[8px] border border-hairline bg-canvas-elevated p-2.5 text-xs font-medium text-body hover:text-ink hover:border-mute transition-colors shadow-whisper"
            data-name={c.name.toLowerCase()}
            data-native={c.nativeName.toLowerCase()}
            data-curr={c.currency.toLowerCase()}
          >
            <span class="text-lg shrink-0">{c.flag}</span>
            <div class="truncate">
              <span class="truncate block group-hover:text-link transition-colors">{c.name}</span>
              <span class="text-[10px] font-mono text-mute">{c.currency}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  const searchInput = document.getElementById('country-search');
  const cards = document.querySelectorAll('.country-card');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const native = card.getAttribute('data-native') || '';
        const curr = card.getAttribute('data-curr') || '';
        const matches = !q || name.includes(q) || native.includes(q) || curr.includes(q);
        card.style.display = matches ? 'flex' : 'none';
      });
    });
  }
</script>

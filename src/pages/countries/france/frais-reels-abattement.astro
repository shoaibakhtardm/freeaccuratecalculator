---
// src/pages/countries/france/frais-reels-abattement.astro
import Layout from '../../../layouts/Layout.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
import { getCountryBySlug } from '../../../data/countries';

const country = getCountryBySlug('france')!;

const pageTitle = "Comparateur Frais Réels vs Abattement 10% 2026 | Optimisation Impôt France";
const pageDescription = "Comparez gratuitement vos frais réels et l'abattement forfaitaire de 10%. Calculez l'économie d'impôt exacte selon votre tranche TMI pour votre déclaration de revenus.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FinancialProduct',
      name: "Comparateur Frais Réels vs Abattement 10% France",
      description: pageDescription,
      inLanguage: 'fr-FR',
      url: 'https://freeaccuratecalculator.com/countries/france/frais-reels-abattement/',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://freeaccuratecalculator.com/' },
        { '@type': 'ListItem', position: 2, name: 'Pays', item: 'https://freeaccuratecalculator.com/countries/' },
        { '@type': 'ListItem', position: 3, name: 'France', item: 'https://freeaccuratecalculator.com/countries/france/fr/' },
        { '@type': 'ListItem', position: 4, name: 'Finance', item: 'https://freeaccuratecalculator.com/countries/france/fr/finance/' },
        { '@type': 'ListItem', position: 5, name: 'Frais Réels vs 10%', item: 'https://freeaccuratecalculator.com/countries/france/frais-reels-abattement/' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: "Quel est le plafond de l'abattement forfaitaire de 10% en 2026 ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Pour l'imposition des revenus, l'abattement forfaitaire automatique de 10% est plafonné à 14 171 € par membre du foyer fiscal, avec un plancher minimal de déduction fixé à 495 €.",
          },
        },
        {
          '@type': 'Question',
          name: "Quand est-il avantageux de déclarer ses frais réels aux impôts ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "L'option pour les frais réels est avantageuse dès lors que le cumul de vos dépenses professionnelles (trajets quotidiens domicile-travail, repas hors domicile, fournitures de télétravail) dépasse 10% de vos salaires nets imposables.",
          },
        },
        {
          '@type': 'Question',
          name: "Quels justificatifs fiscaux faut-il conserver en cas de contrôle ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Vous n'avez pas à envoyer vos justificatifs lors de la déclaration en ligne, mais vous devez conserver pendant au moins 3 ans toutes les factures de carburant, factures de cantine/restaurant, carte grise et justificatifs de kilométrage.",
          },
        },
        {
          '@type': 'Question',
          name: "Peut-on changer d'option chaque année ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Oui. L'option pour les frais réels est annuelle et individuelle. Vous pouvez choisir les frais réels une année et revenir à l'abattement automatique de 10% l'année suivante.",
          },
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://freeaccuratecalculator.com/countries/france/frais-reels-abattement/"
  jsonLd={jsonLd}
  lang="fr-FR"
  locale="fr"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Accueil</a>
      <span>/</span>
      <a href="/countries/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Pays</a>
      <span>/</span>
      <a href="/countries/france/fr/" class="hover:text-indigo-600 dark:hover:text-indigo-400">France</a>
      <span>/</span>
      <a href="/countries/france/fr/finance/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Finance</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">Frais Réels vs 10%</span>
    </nav>

    <!-- Hero Title -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/50 dark:border-emerald-800/50">
        <span>Article 83 CGI</span>
        <span>•</span>
        <span>Optimisation Fiscale Déclaration 2026</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white font-outfit">
        Comparateur Frais Réels vs Abattement Forfaitaire de 10%
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-3xl leading-relaxed">
        Découvrez immédiatement quelle option fiscale est la plus avantageuse pour votre déclaration d'impôt sur le revenu et maximisez votre économie d'impôt en quelques clics.
      </p>
    </div>

    <!-- CALCULATOR CONTAINER -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      <!-- FORM INPUTS (7 cols) -->
      <div class="lg:col-span-7 bg-white dark:bg-slate-900/90 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 p-5 sm:p-7 shadow-sm space-y-5">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3">
          1. Vos Revenus & Dépenses Professionnelles
        </h2>

        <!-- Salaire Net Imposable -->
        <div class="space-y-1.5">
          <div class="flex justify-between items-center">
            <label for="fr-salary" class="text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Salaire Net Imposable Annuel
            </label>
            <span class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400" id="fr-salary-display">32 000 €</span>
          </div>
          <div class="relative">
            <input
              type="number"
              id="fr-salary"
              min="5000"
              max="200000"
              step="500"
              value="32000"
              class="w-full px-3.5 py-2.5 pr-10 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            />
            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400 font-bold">€</span>
          </div>
          <input type="range" id="fr-salary-range" min="10000" max="80000" step="1000" value="32000" class="w-full accent-indigo-600 cursor-pointer" />
          <p class="text-[11px] text-slate-500 dark:text-slate-400">Montant figurant en bas de votre fiche de paie de décembre (ou case 1AJ de votre avis d'impôt).</p>
        </div>

        <!-- Tranche Marginale d'Imposition (TMI) -->
        <div class="space-y-1.5">
          <label for="fr-tmi" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Votre Tranche Marginale d'Imposition (TMI)
          </label>
          <select
            id="fr-tmi"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-medium text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer"
          >
            <option value="0">0% (Revenus jusqu'à 11 294 €)</option>
            <option value="11" selected>11% (Revenus de 11 295 € à 28 797 €)</option>
            <option value="30">30% (Revenus de 28 798 € à 82 341 €)</option>
            <option value="41">41% (Revenus de 82 342 € à 177 106 €)</option>
            <option value="45">45% (Revenus supérieurs à 177 106 €)</option>
          </select>
        </div>

        <!-- Frais Réels Détaillés -->
        <div class="space-y-3 pt-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 border-b border-slate-100 dark:border-slate-800 pb-1">
            Estimation de Vos Frais Réels Annuels
          </h3>

          <div class="space-y-1">
            <label for="fr-km-cost" class="text-xs font-medium text-slate-700 dark:text-slate-300">
              1. Frais de Déplacement / Trajets Domicile-Travail (€ / an)
            </label>
            <input
              type="number"
              id="fr-km-cost"
              min="0"
              max="20000"
              step="100"
              value="3400"
              class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-semibold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            />
            <p class="text-[10px] text-slate-400">Application du barème kilométrique officiel sur vos kilomètres annuels.</p>
          </div>

          <div class="space-y-1">
            <label for="fr-meals" class="text-xs font-medium text-slate-700 dark:text-slate-300">
              2. Frais Supplémentaires de Repas Hors Domicile (€ / an)
            </label>
            <input
              type="number"
              id="fr-meals"
              min="0"
              max="6000"
              step="50"
              value="850"
              class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-semibold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            />
            <p class="text-[10px] text-slate-400">Part du repas excédant la valeur forfaitaire d'un repas pris à domicile (5,35 € en 2026).</p>
          </div>

          <div class="space-y-1">
            <label for="fr-others" class="text-xs font-medium text-slate-700 dark:text-slate-300">
              3. Autres Dépenses Professionnelles (Télétravail, Fournitures, Formations) (€ / an)
            </label>
            <input
              type="number"
              id="fr-others"
              min="0"
              max="5000"
              step="50"
              value="250"
              class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-semibold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            />
          </div>
        </div>
      </div>

      <!-- RESULTS PANEL (5 cols) -->
      <div class="lg:col-span-5 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-950 text-white rounded-2xl border border-indigo-800/40 p-5 sm:p-7 shadow-xl space-y-6 sticky top-24">
        <div>
          <span class="text-xs uppercase tracking-wider text-indigo-300 font-semibold">Verdict d'Optimisation Fiscale</span>
          <h3 class="text-xl font-bold font-outfit mt-0.5" id="fr-recommendation-title">Option Frais Réels Gagnante</h3>
        </div>

        <!-- Big Number -->
        <div class="bg-white/5 rounded-2xl p-5 border border-white/10 text-center space-y-1">
          <div class="text-[11px] font-mono tracking-wider text-indigo-300 uppercase">Gain Net d'Impôt Estimé</div>
          <div class="text-4xl sm:text-5xl font-black font-outfit text-emerald-400 tracking-tight" id="fr-tax-gain">
            + 143,00 €
          </div>
          <div class="text-xs text-indigo-200/80 font-medium" id="fr-tax-gain-sub">
            par an par rapport à l'abattement 10%
          </div>
        </div>

        <!-- Comparison Table -->
        <div class="space-y-2.5 text-xs sm:text-sm">
          <div class="flex justify-between items-center py-1.5 border-b border-white/10">
            <span class="text-slate-300">Abattement forfaitaire 10%</span>
            <span class="font-bold text-white font-mono" id="fr-flat-deduction">3 200,00 €</span>
          </div>
          <div class="flex justify-between items-center py-1.5 border-b border-white/10">
            <span class="text-slate-300">Total de vos Frais Réels</span>
            <span class="font-bold text-emerald-400 font-mono" id="fr-total-expenses">4 500,00 €</span>
          </div>
          <div class="flex justify-between items-center py-1.5 border-b border-white/10">
            <span class="text-slate-300">Surplus d'assiette déduite</span>
            <span class="font-bold text-slate-200 font-mono" id="fr-diff-base">+ 1 300,00 €</span>
          </div>
          <div class="flex justify-between items-center py-1.5">
            <span class="text-slate-300">Case déclaration impôt</span>
            <span class="font-bold text-indigo-300 font-mono">Cases 1AK à 1DK</span>
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-indigo-950/70 border border-indigo-500/30 text-[11px] text-indigo-200 leading-relaxed" id="fr-advice-box">
          💡 <strong>Conseil déclaration :</strong> Remplissez le montant de vos frais réels en case 1AK (ou 1BK pour le conjoint). L'administration appliquera automatiquement le calcul le plus avantageux en cas d'erreur.
        </div>
      </div>
    </div>

    <!-- 150-200 WORDS EXPLANATORY CONTENT (CRUCIAL FOR TECHNICAL SEO) -->
    <article class="bg-white dark:bg-slate-900/60 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 p-6 sm:p-8 space-y-4 text-slate-700 dark:text-slate-300 text-sm leading-relaxed">
      <h2 class="text-lg sm:text-xl font-bold font-outfit text-slate-900 dark:text-white">
        Frais réels ou abattement forfaitaire de 10% : comment choisir pour payer moins d'impôts ?
      </h2>
      <p>
        Par défaut, l'administration fiscale applique automatiquement une <strong>déduction forfaitaire de 10%</strong> sur vos traitements et salaires bruts déclarés au titre de vos frais professionnels (article 83 du Code Général des Impôts). Ce forfait annuel est encadré par des seuils stricts revalorisés chaque année : un <strong>minimum de déduction de 495 €</strong> et un <strong>plafond maximal fixé à 14 171 €</strong> par contribuable en 2026.
      </p>
      <p>
        Cependant, tout salarié peut renoncer à cette déduction automatique et opter pour la déduction de ses <strong>frais réels et justifiés</strong> si le total de ses dépenses professionnelles dépasse 10% de sa rémunération imposable. Les trois principaux postes déductibles sont :
      </p>
      <ul class="list-disc pl-5 space-y-1">
        <li>Les <strong>trajets domicile-travail</strong> calculés selon le barème kilométrique officiel de l'administration fiscale (jusqu'à 40 km aller, soit 80 km aller-retour par jour).</li>
        <li>Les <strong>frais supplémentaires de repas</strong> engagés en l'absence de cantine ou d'espace de restauration sur le lieu de travail.</li>
        <li>Les <strong>dépenses liées au télétravail</strong> et à l'équipement professionnel non remboursées par l'employeur.</li>
      </ul>
      <p>
        L'économie d'impôt nette se calcule en multipliant la différence d'assiette déductible par votre <strong>Tranche Marginale d'Imposition (TMI : 11%, 30%, 41% ou 45%)</strong>. En cas d'option pour les frais réels, vous devez conserver l'ensemble des justificatifs (tickets, relevés kilométriques, factures d'entretien du véhicule) pendant une durée de 3 ans afin de pouvoir répondre à une éventuelle demande de contrôle de la DGFiP.
      </p>
    </article>
  </div>
</Layout>

<script is:inline>
  (function () {
    const formatEUR = (val) => {
      return new Intl.NumberFormat('fr-FR', {
        style: 'currency',
        currency: 'EUR',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(val);
    };

    const salaryEl = document.getElementById('fr-salary');
    const salaryRange = document.getElementById('fr-salary-range');
    const salaryDisplay = document.getElementById('fr-salary-display');
    const tmiEl = document.getElementById('fr-tmi');
    const kmCostEl = document.getElementById('fr-km-cost');
    const mealsEl = document.getElementById('fr-meals');
    const othersEl = document.getElementById('fr-others');

    const recTitle = document.getElementById('fr-recommendation-title');
    const taxGainEl = document.getElementById('fr-tax-gain');
    const taxGainSub = document.getElementById('fr-tax-gain-sub');
    const flatDeductionEl = document.getElementById('fr-flat-deduction');
    const totalExpensesEl = document.getElementById('fr-total-expenses');
    const diffBaseEl = document.getElementById('fr-diff-base');
    const adviceBox = document.getElementById('fr-advice-box');

    const MIN_FLAT = 495;
    const MAX_FLAT = 14171;

    function compareExpenses() {
      const salary = parseFloat(salaryEl.value) || 0;
      const tmiRate = (parseFloat(tmiEl.value) || 0) / 100;

      const km = parseFloat(kmCostEl.value) || 0;
      const meals = parseFloat(mealsEl.value) || 0;
      const others = parseFloat(othersEl.value) || 0;

      // 1. Abattement forfaitaire 10%
      let flatDeduction = salary * 0.10;
      flatDeduction = Math.min(MAX_FLAT, Math.max(MIN_FLAT, flatDeduction));

      // 2. Frais Réels
      const totalReal = km + meals + others;

      // 3. Différence
      const diff = totalReal - flatDeduction;

      if (flatDeductionEl) flatDeductionEl.textContent = formatEUR(flatDeduction);
      if (totalExpensesEl) totalExpensesEl.textContent = formatEUR(totalReal);

      if (diff > 0) {
        // Frais réels gagnants
        const taxSavings = diff * tmiRate;
        if (recTitle) {
          recTitle.textContent = 'Option Frais Réels Gagnante 🎯';
          recTitle.className = 'text-xl font-bold font-outfit mt-0.5 text-emerald-400';
        }
        if (taxGainEl) {
          taxGainEl.textContent = `+ ${formatEUR(taxSavings)}`;
          taxGainEl.className = 'text-4xl sm:text-5xl font-black font-outfit text-emerald-400 tracking-tight';
        }
        if (taxGainSub) {
          taxGainSub.textContent = `d'impôt économisé par an (à votre TMI de ${tmiEl.value}%)`;
        }
        if (diffBaseEl) {
          diffBaseEl.textContent = `+ ${formatEUR(diff)}`;
          diffBaseEl.className = 'font-bold text-emerald-400 font-mono';
        }
        if (adviceBox) {
          adviceBox.innerHTML = `💡 <strong>Recommandation :</strong> Déclarez vos <strong>${formatEUR(totalReal)}</strong> en cases 1AK à 1DK. Vous réduisez votre base imposable de <strong>${formatEUR(diff)}</strong> supplémentaires.`;
        }
      } else {
        // Abattement 10% gagnant
        const loss = Math.abs(diff);
        if (recTitle) {
          recTitle.textContent = "Gardez l'Abattement 10% 🛡️";
          recTitle.className = 'text-xl font-bold font-outfit mt-0.5 text-indigo-300';
        }
        if (taxGainEl) {
          taxGainEl.textContent = '0,00 €';
          taxGainEl.className = 'text-4xl sm:text-5xl font-black font-outfit text-white tracking-tight';
        }
        if (taxGainSub) {
          taxGainSub.textContent = "L'abattement forfaitaire est déjà optimal pour vous";
        }
        if (diffBaseEl) {
          diffBaseEl.textContent = `- ${formatEUR(loss)}`;
          diffBaseEl.className = 'font-bold text-slate-400 font-mono';
        }
        if (adviceBox) {
          adviceBox.innerHTML = `🛡️ <strong>Recommandation :</strong> Vos frais réels sont inférieurs à l'abattement forfaitaire de 10% (gain de <strong>${formatEUR(loss)}</strong> en restant au forfait). Ne cochez pas l'option des frais réels.`;
        }
      }
    }

    salaryEl.addEventListener('input', (e) => {
      salaryRange.value = e.target.value;
      salaryDisplay.textContent = `${e.target.value} €`;
      compareExpenses();
    });
    salaryRange.addEventListener('input', (e) => {
      salaryEl.value = e.target.value;
      salaryDisplay.textContent = `${e.target.value} €`;
      compareExpenses();
    });

    tmiEl.addEventListener('change', compareExpenses);
    kmCostEl.addEventListener('input', compareExpenses);
    mealsEl.addEventListener('input', compareExpenses);
    othersEl.addEventListener('input', compareExpenses);

    compareExpenses();
  })();
</script>

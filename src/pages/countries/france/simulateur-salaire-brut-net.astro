---
// src/pages/countries/france/simulateur-salaire-brut-net.astro
import Layout from '../../../layouts/Layout.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
import { getCountryBySlug } from '../../../data/countries';

const country = getCountryBySlug('france')!;

const pageTitle = "Simulateur Salaire Brut en Net 2026 Gratuit | Cadre, Non-Cadre & Impôt PAS";
const pageDescription = "Convertissez instantanément votre salaire Brut en Net 2026 (Cadre, Non-cadre, Fonctionnaire). Calcul précis des cotisations sociales, impôt à la source (PAS) et coût total employeur.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: "Simulateur Salaire Brut en Net 2026 France",
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'All',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'EUR',
      },
      description: pageDescription,
      inLanguage: 'fr-FR',
      url: 'https://freeaccuratecalculator.com/countries/france/simulateur-salaire-brut-net/',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://freeaccuratecalculator.com/' },
        { '@type': 'ListItem', position: 2, name: 'Pays', item: 'https://freeaccuratecalculator.com/countries/' },
        { '@type': 'ListItem', position: 3, name: 'France', item: 'https://freeaccuratecalculator.com/countries/france/fr/' },
        { '@type': 'ListItem', position: 4, name: 'Emploi & Salaires', item: 'https://freeaccuratecalculator.com/countries/france/fr/guides/' },
        { '@type': 'ListItem', position: 5, name: 'Salaire Brut en Net', item: 'https://freeaccuratecalculator.com/countries/france/simulateur-salaire-brut-net/' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: "Quel est le pourcentage moyen de cotisations déduites du salaire brut en 2026 ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Pour un salarié non-cadre dans le secteur privé, les cotisations salariales représentent environ 22 % du salaire brut (soit un coefficient de 0,78). Pour un statut cadre, le taux de retenue est d'environ 25 % (coefficient de 0,75) en raison des cotisations spécifiques pour la retraite complémentaire AGIRC-ARRCO, l'APEC et la prévoyance obligatoire à 1,50 % sous le plafond de la Sécurité Sociale.",
          },
        },
        {
          '@type': 'Question',
          name: "Quel est le montant du SMIC brut et net en 2026 en France ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Pour 35 heures hebdomadaires (151,67 heures mensuelles), le SMIC brut mensuel est d'environ 1 801,80 € brut, ce qui équivaut à un salaire net payé d'environ 1 426 € net avant impôt sur le revenu.",
          },
        },
        {
          '@type': 'Question',
          name: "Comment fonctionne la grille du taux neutre du prélèvement à la source (PAS) ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Si vous ne transmettez pas votre taux personnalisé aux impôts ou lors d'une nouvelle embauche, l'employeur applique la grille légale du taux neutre (barème métropole célibataire sans enfant). Il est de 0 % jusqu'à 1 615 € net imposable/mois, 1,3 % jusqu'à 1 700 €, 2,9 % jusqu'à 1 800 €, et augmente progressivement avec vos revenus.",
          },
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://freeaccuratecalculator.com/countries/france/simulateur-salaire-brut-net/"
  jsonLd={jsonLd}
  lang="fr-FR"
  locale="fr"
>
  <div class="max-w-5xl mx-auto px-3 sm:px-6 py-4 sm:py-8 space-y-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Accueil</a>
      <span>/</span>
      <a href="/countries/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Pays</a>
      <span>/</span>
      <a href="/countries/france/fr/" class="hover:text-indigo-600 dark:hover:text-indigo-400">France</a>
      <span>/</span>
      <a href="/countries/france/fr/guides/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Emploi</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">Salaire Brut en Net</span>
    </nav>

    <!-- Hero Title -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200/50 dark:border-indigo-800/50">
        <span>Cotisations URSSAF & Retraite 2026</span>
        <span>•</span>
        <span>Prélèvement à la Source (PAS)</span>
        <span>•</span>
        <span>Coût Total Employeur</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white font-outfit">
        Simulateur Salaire Brut en Net 2026 : Cadre, Non-Cadre & Coût Employeur
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-3xl leading-relaxed">
        Convertissez votre rémunération en temps réel : salaire brut, salaire net à payer, salaire net après impôt sur le revenu (PAS) et coût global employeur selon votre statut professionnel.
      </p>
    </div>

    <!-- CALCULATOR CONTAINER -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      <!-- FORM INPUTS (7 cols) -->
      <div class="lg:col-span-7 bg-white dark:bg-slate-900/90 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 p-5 sm:p-7 shadow-sm space-y-5">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center justify-between">
          <span>1. Statut & Rémunération</span>
          <span class="text-xs font-normal text-indigo-600 dark:text-indigo-400">PMSS 2026</span>
        </h2>

        <!-- Statut Salarié -->
        <div class="space-y-1.5">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Statut Professionnel
          </label>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
            <button
              type="button"
              id="btn-statut-non-cadre"
              class="statut-btn py-2.5 px-3 rounded-xl border-2 font-bold text-xs text-center transition-all border-indigo-600 bg-indigo-50 text-indigo-700 dark:bg-indigo-950/50 dark:text-indigo-300"
              data-statut="non-cadre"
            >
              Non-Cadre (~22%)
            </button>
            <button
              type="button"
              id="btn-statut-cadre"
              class="statut-btn py-2.5 px-3 rounded-xl border-2 font-bold text-xs text-center transition-all border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-slate-300"
              data-statut="cadre"
            >
              Cadre (~25%)
            </button>
            <button
              type="button"
              id="btn-statut-fonctionnaire"
              class="statut-btn py-2.5 px-3 rounded-xl border-2 font-bold text-xs text-center transition-all border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-slate-300"
              data-statut="fonctionnaire"
            >
              Fonctionnaire (~15%)
            </button>
          </div>
        </div>

        <!-- 4-WAY SALARY INPUTS -->
        <div class="space-y-3 pt-2">
          <span class="text-xs font-bold text-slate-900 dark:text-white block">
            Saisissez votre Salaire (Synchronisation automatique des 4 champs)
          </span>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <!-- Brut Mensuel -->
            <div class="space-y-1">
              <label for="sal-brut-mois" class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                Salaire Brut Mensuel
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="sal-brut-mois"
                  min="500"
                  max="100000"
                  step="50"
                  value="3000"
                  class="w-full px-3.5 py-2.5 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
                />
                <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-bold">€/m</span>
              </div>
            </div>

            <!-- Brut Annuel -->
            <div class="space-y-1">
              <label for="sal-brut-an" class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                Salaire Brut Annuel
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="sal-brut-an"
                  min="6000"
                  max="1200000"
                  step="500"
                  value="36000"
                  class="w-full px-3.5 py-2.5 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
                />
                <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-bold">€/an</span>
              </div>
            </div>

            <!-- Net Avant Impôt Mensuel -->
            <div class="space-y-1">
              <label for="sal-net-mois" class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                Net à Payer Mensuel (Avant impôt)
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="sal-net-mois"
                  min="400"
                  max="80000"
                  step="50"
                  value="2340"
                  class="w-full px-3.5 py-2.5 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm font-bold text-emerald-600 dark:text-emerald-400 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
                />
                <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-bold">€/m</span>
              </div>
            </div>

            <!-- Taux Horaire Brut -->
            <div class="space-y-1">
              <label for="sal-horaire" class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                Taux Horaire Brut (Base 35h)
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="sal-horaire"
                  min="5"
                  max="500"
                  step="0.5"
                  value="19.78"
                  class="w-full px-3.5 py-2.5 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
                />
                <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-bold">€/h</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Options Additionnelles (Mois & PAS) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2">
          <div class="space-y-1">
            <label for="sal-months" class="text-xs font-semibold text-slate-700 dark:text-slate-300">
              Nombre de Mois de Rémunération
            </label>
            <select
              id="sal-months"
              class="w-full px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-medium text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            >
              <option value="12" selected>12 mois (Standard)</option>
              <option value="13">13 mois (Avec 13ème mois)</option>
              <option value="14">14 mois</option>
            </select>
          </div>

          <div class="space-y-1">
            <label for="sal-pas-rate" class="text-xs font-semibold text-slate-700 dark:text-slate-300">
              Taux Prélèvement à la Source (PAS)
            </label>
            <select
              id="sal-pas-rate"
              class="w-full px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-medium text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            >
              <option value="auto" selected>Taux Neutre Automatique 2026 (Grille officielle)</option>
              <option value="0">0 % (Non imposable)</option>
              <option value="2.9">2,9 %</option>
              <option value="5.5">5,5 %</option>
              <option value="7.5">7,5 %</option>
              <option value="10.0">10,0 %</option>
              <option value="15.0">15,0 %</option>
            </select>
          </div>
        </div>
      </div>

      <!-- RESULTS STICKY SUMMARY (5 cols) -->
      <div class="lg:col-span-5 space-y-5 lg:sticky lg:top-24">
        <div class="bg-gradient-to-br from-indigo-950 via-slate-900 to-slate-950 text-white rounded-2xl p-5 sm:p-7 shadow-xl border border-indigo-500/30 relative overflow-hidden">
          <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-indigo-500/10 rounded-full blur-2xl"></div>

          <div class="space-y-4 relative z-10">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-indigo-300">
                Net Payé sur Compte Bancaire (Après Impôt)
              </span>
              <div class="text-3xl sm:text-4xl font-extrabold font-outfit text-emerald-400 tracking-tight mt-0.5" id="sal-net-apres-impot-mois">
                2 195 € / mois
              </div>
              <p class="text-xs text-slate-300 mt-1">
                Net annuel après impôt : <strong id="sal-net-apres-impot-an" class="text-white">26 340 € / an</strong>
              </p>
            </div>

            <!-- TABLEAU RÉCAPITULATIF SYNTHÉTIQUE -->
            <div class="space-y-2 pt-2 border-t border-slate-800 text-xs">
              <div class="flex justify-between text-slate-300">
                <span>Salaire Brut Mensuel :</span>
                <span class="font-bold text-white font-mono" id="disp-brut-mois">3 000 €</span>
              </div>
              <div class="flex justify-between text-slate-300">
                <span>Cotisations Salariales (~22%) :</span>
                <span class="font-bold text-rose-400 font-mono" id="disp-cotis-sal">- 660 €</span>
              </div>
              <div class="flex justify-between text-slate-300 font-semibold border-t border-slate-800 pt-1">
                <span>Net Avant Impôt :</span>
                <span class="font-bold text-white font-mono" id="disp-net-avant-impot">2 340 €</span>
              </div>
              <div class="flex justify-between text-slate-300">
                <span>Impôt sur le Revenu (PAS) :</span>
                <span class="font-bold text-amber-400 font-mono" id="disp-pas-amount">- 145 € (6,2%)</span>
              </div>
            </div>

            <!-- COUT TOTAL EMPLOYEUR -->
            <div class="p-3.5 rounded-xl bg-slate-800/70 border border-slate-700 text-xs space-y-1.5">
              <span class="font-bold text-indigo-300 block">
                Coût Global Pour l'Employeur
              </span>
              <div class="flex justify-between text-slate-300">
                <span>Cotisations Patronales (~42%) :</span>
                <span class="font-bold text-slate-200 font-mono" id="disp-cotis-patronales">+ 1 260 €</span>
              </div>
              <div class="flex justify-between text-slate-300 border-t border-slate-700 pt-1 font-semibold">
                <span>Coût Total Entreprise :</span>
                <span class="font-bold text-white font-mono" id="disp-cout-total">4 260 € / mois</span>
              </div>
            </div>

            <!-- Actions -->
            <div class="pt-2">
              <button
                type="button"
                id="btn-print-sal"
                class="w-full py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition-colors flex items-center justify-center gap-2"
              >
                <span>🖨️</span> Exporter la Fiche de Paie Synthétique
              </button>
            </div>
          </div>
        </div>

        <!-- Contextual Card -->
        <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs space-y-2 text-slate-600 dark:text-slate-400">
          <p class="font-bold text-slate-900 dark:text-white flex items-center gap-1">
            <span>💡</span> Projets et Déclarations Fiscales :
          </p>
          <p>
            Vous utilisez votre véhicule pour aller travailler ? Vous pouvez déduire vos frais réels plutôt que l'abattement forfaitaire de 10 %.
          </p>
          <a href="/countries/france/frais-reels-abattement/" class="font-semibold text-indigo-600 dark:text-indigo-400 hover:underline block pt-1">
            → Comparer Frais Réels vs Abattement 10%
          </a>
        </div>
      </div>
    </div>

    <!-- GUIDE EXPLICATIF PAIE (SEO & DWELL TIME) -->
    <article class="bg-white dark:bg-slate-900/90 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 p-6 sm:p-8 space-y-6 text-slate-800 dark:text-slate-200 leading-relaxed text-sm sm:text-base">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white font-outfit border-b border-slate-100 dark:border-slate-800 pb-3">
        Comprendre la Fiche de Paie en France en 2026
      </h2>

      <div class="space-y-4">
        <p>
          La transition du <strong>salaire brut au salaire net</strong> s'opère par la déduction des cotisations de sécurité sociale (santé, vieillesse, famille), du chômage et de la retraite complémentaire AGIRC-ARRCO.
        </p>

        <h3 class="text-lg font-bold text-slate-900 dark:text-white pt-2">
          1. Différence Cadre vs Non-Cadre
        </h3>
        <p>
          Les cadres supportent des cotisations spécifiques supplémentaires :
        </p>
        <ul class="list-disc pl-5 space-y-1 text-slate-600 dark:text-slate-400 text-xs sm:text-sm">
          <li><strong>APEC :</strong> Association pour l'emploi des cadres (0,024 % part salariale).</li>
          <li><strong>Prévoyance Décès 1,50 % :</strong> Obligatoire sous le Plafond Mensuel de la Sécurité Sociale (PMSS 2026 à 3 925 €/mois).</li>
          <li><strong>Tranches AGIRC-ARRCO :</strong> Tranche 1 (sous PMSS) et Tranche 2 (au-delà du PMSS jusqu'à 8 PMSS).</li>
        </ul>
      </div>

      <!-- FAQ Accordions -->
      <div class="space-y-3 pt-4 border-t border-slate-100 dark:border-slate-800">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">
          Foire Aux Questions : Salaire & Paie
        </h3>

        <details class="group rounded-xl border border-slate-200 dark:border-slate-800 p-3.5 bg-slate-50/50 dark:bg-slate-800/40">
          <summary class="font-bold text-slate-900 dark:text-white cursor-pointer list-none flex justify-between items-center text-sm">
            <span>Qu'est-ce que le Net Imposable par rapport au Net à Payer ?</span>
            <span class="text-indigo-600 dark:text-indigo-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2">
            Le net imposable est supérieur au net à payer car il réintègre la CSG/CRDS non déductible (2,9 %) et la quote-part patronale de la complémentaire santé d'entreprise (mutuelle). C'est sur ce montant que s'applique le prélèvement à la source.
          </p>
        </details>
      </div>
    </article>

    <!-- PROJETS CONNEXES -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
      <a
        href="/countries/france/indemnites-kilometriques/"
        class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-indigo-500 transition-all group"
      >
        <div class="text-xl mb-1">🚗</div>
        <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400">
          Indemnités Kilométriques
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Barème officiel des frais de déplacement pro.
        </p>
      </a>

      <a
        href="/countries/france/indemnite-licenciement/"
        class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-indigo-500 transition-all group"
      >
        <div class="text-xl mb-1">⚖️</div>
        <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400">
          Indemnité de Licenciement
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Calcul légal du Code du travail selon l'ancienneté.
        </p>
      </a>

      <a
        href="/countries/france/frais-reels-abattement/"
        class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-indigo-500 transition-all group"
      >
        <div class="text-xl mb-1">📋</div>
        <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400">
          Frais Réels vs 10%
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Optimisez votre déduction d'impôt sur le revenu.
        </p>
      </a>
    </div>
  </div>

  <script is:inline>
    (function () {
      let currentStatut = 'non-cadre';
      let isUpdating = false;

      const btnNonCadre = document.getElementById('btn-statut-non-cadre');
      const btnCadre = document.getElementById('btn-statut-cadre');
      const btnFonctionnaire = document.getElementById('btn-statut-fonctionnaire');

      const brutMoisInput = document.getElementById('sal-brut-mois');
      const brutAnInput = document.getElementById('sal-brut-an');
      const netMoisInput = document.getElementById('sal-net-mois');
      const horaireInput = document.getElementById('sal-horaire');

      const monthsSelect = document.getElementById('sal-months');
      const pasSelect = document.getElementById('sal-pas-rate');

      const netApresMois = document.getElementById('sal-net-apres-impot-mois');
      const netApresAn = document.getElementById('sal-net-apres-impot-an');

      const dispBrutMois = document.getElementById('disp-brut-mois');
      const dispCotisSal = document.getElementById('disp-cotis-sal');
      const dispNetAvant = document.getElementById('disp-net-avant-impot');
      const dispPas = document.getElementById('disp-pas-amount');
      const dispCotisPat = document.getElementById('disp-cotis-patronales');
      const dispCoutTotal = document.getElementById('disp-cout-total');

      const formatEuro = (val) => new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(val);

      function getCotisationRate() {
        if (currentStatut === 'cadre') return 0.25;
        if (currentStatut === 'fonctionnaire') return 0.15;
        return 0.22; // non-cadre
      }

      function getAutoPasRate(netImposableMois) {
        if (netImposableMois <= 1615) return 0;
        if (netImposableMois <= 1700) return 0.013;
        if (netImposableMois <= 1800) return 0.029;
        if (netImposableMois <= 1920) return 0.044;
        if (netImposableMois <= 2050) return 0.057;
        if (netImposableMois <= 2200) return 0.073;
        if (netImposableMois <= 2450) return 0.09;
        if (netImposableMois <= 2850) return 0.12;
        if (netImposableMois <= 3400) return 0.15;
        if (netImposableMois <= 4200) return 0.18;
        if (netImposableMois <= 5000) return 0.22;
        return 0.28;
      }

      function updateOutputs(brutMois) {
        const months = parseInt(monthsSelect.value, 10) || 12;
        const rateSal = getCotisationRate();
        const ratePat = currentStatut === 'fonctionnaire' ? 0.35 : 0.42;

        const brutAn = brutMois * months;
        const horaire = brutMois / 151.67;
        const cotisSal = brutMois * rateSal;
        const netAvantMois = brutMois - cotisSal;

        // Estimation Net Imposable (+2.9% CSG non déductible)
        const netImposable = netAvantMois + (brutMois * 0.9825 * 0.029);

        let pasRate = 0;
        if (pasSelect.value === 'auto') {
          pasRate = getAutoPasRate(netImposable);
        } else {
          pasRate = parseFloat(pasSelect.value) / 100;
        }

        const pasAmount = netImposable * pasRate;
        const netApresMoisVal = netAvantMois - pasAmount;
        const netApresAnVal = netApresMoisVal * months;

        const cotisPat = brutMois * ratePat;
        const coutTotal = brutMois + cotisPat;

        // Update displays
        netApresMois.textContent = `${formatEuro(netApresMoisVal)} / mois`;
        netApresAn.textContent = `${formatEuro(netApresAnVal)} / an`;

        dispBrutMois.textContent = formatEuro(brutMois);
        dispCotisSal.textContent = `- ${formatEuro(cotisSal)} (${Math.round(rateSal * 100)}%)`;
        dispNetAvant.textContent = formatEuro(netAvantMois);
        dispPas.textContent = `- ${formatEuro(pasAmount)} (${(pasRate * 100).toFixed(1)}%)`;
        dispCotisPat.textContent = `+ ${formatEuro(cotisPat)}`;
        dispCoutTotal.textContent = `${formatEuro(coutTotal)} / mois`;
      }

      function fromBrutMois() {
        if (isUpdating) return;
        isUpdating = true;
        const brutMois = parseFloat(brutMoisInput.value) || 0;
        const months = parseInt(monthsSelect.value, 10) || 12;
        const rateSal = getCotisationRate();

        brutAnInput.value = Math.round(brutMois * months);
        netMoisInput.value = Math.round(brutMois * (1 - rateSal));
        horaireInput.value = (brutMois / 151.67).toFixed(2);

        updateOutputs(brutMois);
        isUpdating = false;
      }

      function fromBrutAn() {
        if (isUpdating) return;
        isUpdating = true;
        const brutAn = parseFloat(brutAnInput.value) || 0;
        const months = parseInt(monthsSelect.value, 10) || 12;
        const brutMois = Math.round(brutAn / months);
        const rateSal = getCotisationRate();

        brutMoisInput.value = brutMois;
        netMoisInput.value = Math.round(brutMois * (1 - rateSal));
        horaireInput.value = (brutMois / 151.67).toFixed(2);

        updateOutputs(brutMois);
        isUpdating = false;
      }

      function fromNetMois() {
        if (isUpdating) return;
        isUpdating = true;
        const netMois = parseFloat(netMoisInput.value) || 0;
        const rateSal = getCotisationRate();
        const brutMois = Math.round(netMois / (1 - rateSal));
        const months = parseInt(monthsSelect.value, 10) || 12;

        brutMoisInput.value = brutMois;
        brutAnInput.value = Math.round(brutMois * months);
        horaireInput.value = (brutMois / 151.67).toFixed(2);

        updateOutputs(brutMois);
        isUpdating = false;
      }

      function fromHoraire() {
        if (isUpdating) return;
        isUpdating = true;
        const horaire = parseFloat(horaireInput.value) || 0;
        const brutMois = Math.round(horaire * 151.67);
        const months = parseInt(monthsSelect.value, 10) || 12;
        const rateSal = getCotisationRate();

        brutMoisInput.value = brutMois;
        brutAnInput.value = Math.round(brutMois * months);
        netMoisInput.value = Math.round(brutMois * (1 - rateSal));

        updateOutputs(brutMois);
        isUpdating = false;
      }

      function setStatut(statut) {
        currentStatut = statut;
        [btnNonCadre, btnCadre, btnFonctionnaire].forEach((b) => {
          if (b.dataset.statut === statut) {
            b.className = 'statut-btn py-2.5 px-3 rounded-xl border-2 font-bold text-xs text-center transition-all border-indigo-600 bg-indigo-50 text-indigo-700 dark:bg-indigo-950/50 dark:text-indigo-300';
          } else {
            b.className = 'statut-btn py-2.5 px-3 rounded-xl border-2 font-bold text-xs text-center transition-all border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-slate-300';
          }
        });
        fromBrutMois();
      }

      brutMoisInput.addEventListener('input', fromBrutMois);
      brutAnInput.addEventListener('input', fromBrutAn);
      netMoisInput.addEventListener('input', fromNetMois);
      horaireInput.addEventListener('input', fromHoraire);

      monthsSelect.addEventListener('change', fromBrutMois);
      pasSelect.addEventListener('change', fromBrutMois);

      btnNonCadre.addEventListener('click', () => setStatut('non-cadre'));
      btnCadre.addEventListener('click', () => setStatut('cadre'));
      btnFonctionnaire.addEventListener('click', () => setStatut('fonctionnaire'));

      document.getElementById('btn-print-sal')?.addEventListener('click', () => {
        window.print();
      });

      fromBrutMois();
    })();
  </script>
</Layout>

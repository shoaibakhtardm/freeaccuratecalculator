---
// src/pages/countries/france/guides/[slug].astro
import Layout from '../../../../layouts/Layout.astro';
import ThemeToggle from '../../../../components/ThemeToggle.astro';
import { FRANCE_GUIDES, getRelatedGuides, type FranceGuide } from '../../../../data/france-guides';

export function getStaticPaths() {
  return FRANCE_GUIDES.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: FranceGuide;
}

const { guide } = Astro.props;

const pageTitle = guide.metaTitle ? `${guide.metaTitle} | Free Accurate Calculator` : `${guide.title} | Guide France 2026`;
const pageDescription = guide.metaDescription || guide.summary;
const canonicalUrl = `https://freeaccuratecalculator.com/countries/france/guides/${guide.slug}/`;

const relatedGuides = getRelatedGuides(guide);

// JSON-LD Structured Data
const jsonLdGraph: any[] = [
  {
    '@type': 'Article',
    headline: guide.title,
    description: guide.summary,
    url: canonicalUrl,
    inLanguage: 'fr-FR',
    author: {
      '@type': 'Organization',
      name: 'Free Accurate Calculator',
      url: 'https://freeaccuratecalculator.com',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Free Accurate Calculator',
      url: 'https://freeaccuratecalculator.com',
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalUrl,
    },
    datePublished: '2026-01-01',
    dateModified: '2026-09-16',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://freeaccuratecalculator.com/' },
      { '@type': 'ListItem', position: 2, name: 'Pays', item: 'https://freeaccuratecalculator.com/countries/' },
      { '@type': 'ListItem', position: 3, name: 'France', item: 'https://freeaccuratecalculator.com/countries/france/' },
      { '@type': 'ListItem', position: 4, name: 'Guides Pratiques', item: 'https://freeaccuratecalculator.com/countries/france/guides/' },
      { '@type': 'ListItem', position: 5, name: guide.categoryLabel, item: 'https://freeaccuratecalculator.com/countries/france/guides/' },
      { '@type': 'ListItem', position: 6, name: guide.title, item: canonicalUrl },
    ],
  },
];

if (guide.faqs && guide.faqs.length > 0) {
  jsonLdGraph.push({
    '@type': 'FAQPage',
    mainEntity: guide.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': jsonLdGraph,
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
  lang="fr-FR"
  locale="fr"
>
  <div class="max-w-4xl mx-auto px-3 sm:px-6 py-4 sm:py-8 space-y-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Accueil</a>
      <span>/</span>
      <a href="/countries/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Pays</a>
      <span>/</span>
      <a href="/countries/france/" class="hover:text-indigo-600 dark:hover:text-indigo-400">France</a>
      <span>/</span>
      <a href="/countries/france/guides/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Guides</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold truncate max-w-xs sm:max-w-md">{guide.title}</span>
    </nav>

    <!-- Article Hero Header -->
    <header class="space-y-4">
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/60">
          <span>{guide.icon}</span>
          <span>{guide.categoryLabel}</span>
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200/50 dark:border-emerald-800/50">
          <span>✓</span>
          <span>{guide.badge}</span>
        </span>
        <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
          ⏱️ {guide.readTime}
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white font-outfit leading-tight">
        {guide.h1 || guide.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        {guide.summary}
      </p>
    </header>

    <!-- ABOVE THE FOLD INTERACTIVE SIMULATOR CTA -->
    <div class="p-5 sm:p-7 rounded-2xl bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white shadow-xl flex flex-col sm:flex-row items-center justify-between gap-5">
      <div class="space-y-1.5 text-center sm:text-left">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white/20 text-white text-[11px] font-bold uppercase tracking-wider">
          <span>Simulateur Gratuit 2026</span>
        </div>
        <h2 class="text-lg sm:text-xl font-bold font-outfit">
          Passez de la théorie au calcul en 10 secondes
        </h2>
        <p class="text-xs sm:text-sm text-blue-100 max-w-xl">
          Calculez instantanément votre résultat exact grâce à notre outil interactif conforme aux barèmes officiels français.
        </p>
      </div>

      <a
        href={guide.calculator.href}
        class="shrink-0 inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white text-indigo-700 hover:bg-indigo-50 font-bold text-sm shadow-md transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
      >
        <span>🧮 {guide.calculator.label}</span>
        <span>→</span>
      </a>
    </div>

    <!-- MAIN ARTICLE BODY -->
    <article class="bg-white dark:bg-slate-900/70 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 p-6 sm:p-10 space-y-10 text-slate-700 dark:text-slate-300 leading-relaxed text-sm sm:text-base shadow-sm">
      {guide.sections.map((section) => (
        <section class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold font-outfit text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-2">
            {section.heading}
          </h2>
          <div class="prose-content space-y-3 leading-relaxed" set:html={section.content} />
        </section>
      ))}

      <!-- FAQs Section if present -->
      {guide.faqs && guide.faqs.length > 0 && (
        <section class="space-y-6 pt-6 border-t border-slate-200 dark:border-slate-800">
          <h2 class="text-xl sm:text-2xl font-bold font-outfit text-slate-900 dark:text-white flex items-center gap-2">
            <span>❓</span>
            <span>Questions Fréquentes (FAQ)</span>
          </h2>

          <div class="space-y-4 divide-y divide-slate-100 dark:divide-slate-800">
            {guide.faqs.map((faq) => (
              <div class="pt-4 space-y-1.5">
                <h3 class="font-bold text-base text-slate-900 dark:text-white">
                  {faq.question}
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                  {faq.answer}
                </p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Bottom Interactive Simulator Banner -->
      <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="font-bold text-base text-slate-900 dark:text-white font-outfit">
            Besoin d'un calcul personnalisé pour votre situation ?
          </h3>
          <p class="text-xs text-slate-600 dark:text-slate-400">
            Notre calculateur en ligne gratuit applique les barèmes 2026 en temps réel sans transmission de données.
          </p>
        </div>
        <a
          href={guide.calculator.href}
          class="shrink-0 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs sm:text-sm transition-colors shadow-sm"
        >
          Ouvrir le simulateur →
        </a>
      </div>
    </article>

    <!-- RELATED GUIDES (SILO ARCHITECTURE) -->
    {relatedGuides.length > 0 && (
      <aside class="space-y-4 pt-4">
        <div class="flex items-center justify-between">
          <h2 class="text-lg sm:text-xl font-bold font-outfit text-slate-900 dark:text-white">
            Autres guides dans {guide.categoryLabel}
          </h2>
          <a
            href="/countries/france/guides/"
            class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline"
          >
            Voir tout →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {relatedGuides.map((rel) => (
            <a
              href={`/countries/france/guides/${rel.slug}/`}
              class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 hover:border-indigo-500 transition-all group flex flex-col justify-between shadow-xs"
            >
              <div class="space-y-2">
                <div class="flex items-center justify-between text-[11px] text-slate-500">
                  <span>{rel.icon} {rel.categoryLabel}</span>
                  <span class="font-mono">{rel.readTime}</span>
                </div>
                <h3 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors line-clamp-2 leading-snug">
                  {rel.title}
                </h3>
              </div>
              <span class="mt-3 text-xs font-semibold text-indigo-600 dark:text-indigo-400 flex items-center gap-1">
                Lire le guide →
              </span>
            </a>
          ))}
        </div>
      </aside>
    )}

    <!-- Navigation Back -->
    <div class="pt-6 border-t border-slate-200 dark:border-slate-800 flex justify-between items-center text-xs font-semibold">
      <a
        href="/countries/france/guides/"
        class="inline-flex items-center gap-1 text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
      >
        <span>← Retour à tous les guides</span>
      </a>
      <a
        href="/countries/france/"
        class="inline-flex items-center gap-1 text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
      >
        <span>Accueil Calculatrices France →</span>
      </a>
    </div>
  </div>
</Layout>

      }
    }

    function calculateTA() {
      const region = regionEl.value;
      const pType = projectTypeEl.value;
      const surface = parseFloat(surfaceEl.value) || 0;
      const parkingCount = parseInt(parkingEl.value, 10) || 0;
      const isMainResidence = mainResidenceEl.checked && (pType === 'house');

      const rateCommunal = (parseFloat(rateCommunalEl.value) || 0) / 100;
      const rateDept = (parseFloat(rateDeptEl.value) || 0) / 100;
      const isIdF = region === 'idf';
      const rateRegion = isIdF ? (parseFloat(rateRegionEl.value) || 0) / 100 : 0;

      const baseValM2 = isIdF ? VALEUR_IDF : VALEUR_PROVINCE;

      let taxableBase = 0;
      let fullBaseNoAbatement = 0;

      if (pType === 'parking') {
        taxableBase = parkingCount * VALEUR_PARKING;
        fullBaseNoAbatement = taxableBase;
      } else if (pType === 'pool') {
        taxableBase = surface * VALEUR_PISCINE;
        fullBaseNoAbatement = taxableBase;
      } else {
        // Maison, extension, abri de jardin
        if (pType === 'garden-shed' && surface <= 5) {
          // Exonération totale abri <= 5 m²
          taxableBase = 0;
          fullBaseNoAbatement = 0;
        } else if (isMainResidence) {
          const surfaceT1 = Math.min(surface, 100);
          const surfaceT2 = Math.max(0, surface - 100);
          taxableBase = (surfaceT1 * (baseValM2 / 2)) + (surfaceT2 * baseValM2);
          fullBaseNoAbatement = surface * baseValM2;
        } else {
          taxableBase = surface * baseValM2;
          fullBaseNoAbatement = taxableBase;
        }
      }

      const partCommune = taxableBase * rateCommunal;
      const partDept = taxableBase * rateDept;
      const partRegion = taxableBase * rateRegion;
      const totalTax = partCommune + partDept + partRegion;

      const fullTaxWithoutAbatement = (fullBaseNoAbatement * rateCommunal) + (fullBaseNoAbatement * rateDept) + (fullBaseNoAbatement * rateRegion);
      const savings = Math.max(0, fullTaxWithoutAbatement - totalTax);

      // UI Display updates
      resultTotalEl.textContent = formatEUR(totalTax);
      breakdownCommunalEl.textContent = formatEUR(partCommune);
      breakdownDeptEl.textContent = formatEUR(partDept);
      if (isIdF && breakdownRegionEl) {
        breakdownRegionEl.textContent = formatEUR(partRegion);
      }
      savingsEl.textContent = savings > 0 ? `- ${formatEUR(savings)}` : "0,00 €";

      if (totalTax === 0) {
        statusBadgeEl.innerHTML = "🎉 Totalement exonéré de taxe d'aménagement";
        statusBadgeEl.className = "text-xs text-emerald-300 font-medium";
        paymentScheduleEl.textContent = "Aucun paiement dû";
      } else if (totalTax < 1500) {
        statusBadgeEl.innerHTML = "💳 Paiement unique (montant < 1 500 €)";
        statusBadgeEl.className = "text-xs text-sky-300 font-medium";
        paymentScheduleEl.textContent = `1 × ${formatEUR(totalTax)} à 90 jours`;
      } else {
        const half = totalTax / 2;
        statusBadgeEl.innerHTML = "💳 Paiement fractionné en 2 échéances légales";
        statusBadgeEl.className = "text-xs text-emerald-300 font-medium";
        paymentScheduleEl.textContent = `2 × ${formatEUR(half)}`;
      }
    }

    // Input Events
    surfaceEl.addEventListener('input', (e) => {
      surfaceRange.value = e.target.value;
      surfaceDisplay.textContent = `${e.target.value} m²`;
      calculateTA();
    });
    surfaceRange.addEventListener('input', (e) => {
      surfaceEl.value = e.target.value;
      surfaceDisplay.textContent = `${e.target.value} m²`;
      calculateTA();
    });

    parkingEl.addEventListener('input', (e) => {
      parkingDisplay.textContent = `${e.target.value} places`;
      calculateTA();
    });

    rateCommunalEl.addEventListener('input', (e) => {
      rateCommunalRange.value = e.target.value;
      rateCommunalDisplay.textContent = `${e.target.value} %`;
      calculateTA();
    });
    rateCommunalRange.addEventListener('input', (e) => {
      rateCommunalEl.value = e.target.value;
      rateCommunalDisplay.textContent = `${e.target.value} %`;
      calculateTA();
    });

    rateDeptEl.addEventListener('input', (e) => {
      rateDeptRange.value = e.target.value;
      rateDeptDisplay.textContent = `${e.target.value} %`;
      calculateTA();
    });
    rateDeptRange.addEventListener('input', (e) => {
      rateDeptEl.value = e.target.value;
      rateDeptDisplay.textContent = `${e.target.value} %`;
      calculateTA();
    });

    rateRegionEl.addEventListener('input', (e) => {
      rateRegionDisplay.textContent = `${e.target.value} %`;
      calculateTA();
    });

    regionEl.addEventListener('change', () => {
      updateVisibility();
      calculateTA();
    });

    projectTypeEl.addEventListener('change', () => {
      updateVisibility();
      calculateTA();
    });

    mainResidenceEl.addEventListener('change', calculateTA);

    // Initial run
    updateVisibility();
    calculateTA();
  })();
</script>

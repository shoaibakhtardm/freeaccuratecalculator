  <script is:inline>
    (function () {
      let propertyType = 'ancien';

      const priceInput = document.getElementById('fn-price');
      const priceRange = document.getElementById('fn-price-range');
      const priceDisplay = document.getElementById('fn-price-display');
      const deptSelect = document.getElementById('fn-department');
      const furnitureInput = document.getElementById('fn-furniture');
      const btnAutoFurniture = document.getElementById('btn-auto-furniture');
      const guaranteeSelect = document.getElementById('fn-guarantee');

      const btnTypeAncien = document.getElementById('btn-type-ancien');
      const btnTypeNeuf = document.getElementById('btn-type-neuf');

      const totalDisplay = document.getElementById('fn-total-display');
      const totalProject = document.getElementById('fn-total-project');
      const ratioBadge = document.getElementById('fn-ratio-badge');
      const furnitureSavingsBox = document.getElementById('fn-furniture-savings-box');
      const furnitureSavingsDisplay = document.getElementById('fn-furniture-savings');

      const barTaxes = document.getElementById('bar-taxes');
      const barEmoluments = document.getElementById('bar-emoluments');
      const barDebours = document.getElementById('bar-debours');
      const barCsi = document.getElementById('bar-csi');

      const detailTaxes = document.getElementById('fn-detail-taxes');
      const detailEmoluments = document.getElementById('fn-detail-emoluments');
      const detailDebours = document.getElementById('fn-detail-debours');
      const detailCsi = document.getElementById('fn-detail-csi');

      const formatEuro = (val) => new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(val);

      function calculateEmolumentsHT(price) {
        let emo = 0;
        if (price > 60000) {
          emo += (price - 60000) * 0.00799;
          emo += (60000 - 17000) * 0.01064;
          emo += (17000 - 6500) * 0.01596;
          emo += 6500 * 0.0387;
        } else if (price > 17000) {
          emo += (price - 17000) * 0.01064;
          emo += (17000 - 6500) * 0.01596;
          emo += 6500 * 0.0387;
        } else if (price > 6500) {
          emo += (price - 6500) * 0.01596;
          emo += 6500 * 0.0387;
        } else {
          emo += price * 0.0387;
        }
        return emo;
      }

      function calculate() {
        const rawPrice = parseFloat(priceInput.value) || 0;
        const furniture = Math.min(parseFloat(furnitureInput.value) || 0, rawPrice * 0.15);
        const taxablePrice = Math.max(0, rawPrice - furniture);
        const deptRate = parseFloat(deptSelect.value) || 4.5;
        const guarantee = guaranteeSelect.value;

        // 1. Émoluments du notaire
        const emolumentsHT = calculateEmolumentsHT(rawPrice);
        const emolumentsTTC = emolumentsHT * 1.2;

        // 2. Droits de Mutation / Trésor Public
        let taxesPublic = 0;
        let dmtoRate = 0;
        if (propertyType === 'ancien') {
          dmtoRate = (deptRate + 1.20 + (deptRate * 0.0237)) / 100; // ~5.807%
          taxesPublic = taxablePrice * dmtoRate;
        } else {
          // Neuf / VEFA : Taxe de publicité foncière allégée 0.715%
          dmtoRate = 0.00715;
          taxesPublic = taxablePrice * dmtoRate;
        }

        // 3. CSI (Contribution de Sécurité Immobilière)
        const csi = Math.max(15, taxablePrice * 0.001);

        // 4. Débours forfaitaires
        let debours = propertyType === 'ancien' ? 1150 : 1350;
        if (guarantee === 'hypotheque') {
          debours += 450;
        }

        const totalNotaire = Math.round(taxesPublic + emolumentsTTC + debours + csi);
        const projectCost = Math.round(rawPrice + totalNotaire);
        const ratio = rawPrice > 0 ? ((totalNotaire / rawPrice) * 100).toFixed(2) : 0;

        // Économie mobilier
        const furnitureSavings = Math.round(furniture * dmtoRate);

        // Update UI
        priceDisplay.textContent = formatEuro(rawPrice);
        totalDisplay.textContent = formatEuro(totalNotaire);
        totalProject.textContent = formatEuro(projectCost);
        ratioBadge.textContent = `${ratio} %`;

        detailTaxes.textContent = formatEuro(taxesPublic);
        detailEmoluments.textContent = formatEuro(emolumentsTTC);
        detailDebours.textContent = formatEuro(debours);
        detailCsi.textContent = formatEuro(csi);

        if (furniture > 0 && furnitureSavings > 0) {
          furnitureSavingsBox.classList.remove('hidden');
          furnitureSavingsDisplay.textContent = formatEuro(furnitureSavings);
        } else {
          furnitureSavingsBox.classList.add('hidden');
        }

        // Ventilation bar
        const pTaxes = totalNotaire > 0 ? ((taxesPublic / totalNotaire) * 100).toFixed(1) : 0;
        const pEmo = totalNotaire > 0 ? ((emolumentsTTC / totalNotaire) * 100).toFixed(1) : 0;
        const pDeb = totalNotaire > 0 ? ((debours / totalNotaire) * 100).toFixed(1) : 0;
        const pCsi = totalNotaire > 0 ? ((csi / totalNotaire) * 100).toFixed(1) : 0;

        barTaxes.style.width = `${pTaxes}%`;
        barEmoluments.style.width = `${pEmo}%`;
        barDebours.style.width = `${pDeb}%`;
        barCsi.style.width = `${pCsi}%`;
      }

      // Event Listeners
      priceInput.addEventListener('input', () => {
        priceRange.value = priceInput.value;
        calculate();
      });

      priceRange.addEventListener('input', () => {
        priceInput.value = priceRange.value;
        calculate();
      });

      deptSelect.addEventListener('change', calculate);
      furnitureInput.addEventListener('input', calculate);
      guaranteeSelect.addEventListener('change', calculate);

      btnAutoFurniture.addEventListener('click', () => {
        const curPrice = parseFloat(priceInput.value) || 0;
        furnitureInput.value = Math.round(curPrice * 0.05);
        calculate();
      });

      btnTypeAncien.addEventListener('click', () => {
        propertyType = 'ancien';
        btnTypeAncien.className = 'type-btn py-3 px-4 rounded-xl border-2 font-bold text-sm text-center transition-all border-indigo-600 bg-indigo-50/70 text-indigo-700 dark:bg-indigo-950/50 dark:text-indigo-300';
        btnTypeNeuf.className = 'type-btn py-3 px-4 rounded-xl border-2 font-bold text-sm text-center transition-all border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-slate-300';
        calculate();
      });

      btnTypeNeuf.addEventListener('click', () => {
        propertyType = 'neuf';
        btnTypeNeuf.className = 'type-btn py-3 px-4 rounded-xl border-2 font-bold text-sm text-center transition-all border-indigo-600 bg-indigo-50/70 text-indigo-700 dark:bg-indigo-950/50 dark:text-indigo-300';
        btnTypeAncien.className = 'type-btn py-3 px-4 rounded-xl border-2 font-bold text-sm text-center transition-all border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-slate-300';
        calculate();
      });

      document.getElementById('btn-print')?.addEventListener('click', () => {
        window.print();
      });

      calculate();
    })();
  </script>

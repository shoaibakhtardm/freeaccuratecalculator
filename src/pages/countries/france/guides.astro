---
// src/pages/countries/france/guides.astro
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/common/Breadcrumbs.astro';
import { FRANCE_GUIDE_CATEGORIES, FRANCE_GUIDES, getGuidesByCategory } from '../../../data/france-guides';

const pageTitle = "Guides Pratiques France 2026 | Fiscalité, Immobilier, Salaires & Droit Social";
const pageDescription = "Dossiers complets, méthodologies officielles et analyses chiffrées pour la France : impôt sur le revenu 2026, frais réels, TVA, APL, prêt HCSF, indemnité de licenciement et conversion brut en net.";
const canonicalUrl = "https://freeaccuratecalculator.com/countries/france/guides/";

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      url: canonicalUrl,
      inLanguage: 'fr-FR',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Accueil',
          item: 'https://freeaccuratecalculator.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Pays',
          item: 'https://freeaccuratecalculator.com/countries/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'France',
          item: 'https://freeaccuratecalculator.com/countries/france/',
        },
        {
          '@type': 'ListItem',
          position: 4,
          name: 'Guides Pratiques',
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: "Comment calculer son impôt sur le revenu avec le barème progressif 2026 en France ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "L'impôt est calculé par tranches marginales progressives (0%, 11%, 30%, 41%, 45%) après déduction de l'abattement forfaitaire de 10% (ou frais réels) et division par le nombre de parts du quotient familial.",
          },
        },
        {
          '@type': 'Question',
          name: "Quand est-il plus avantageux d'opter pour les frais réels plutôt que l'abattement de 10% ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "L'option pour les frais réels est rentable dès que vos dépenses professionnelles justifiées (trajets domicile-travail avec le barème kilométrique, repas, télétravail) dépassent 10% de vos salaires nets imposables.",
          },
        },
        {
          '@type': 'Question',
          name: "Quelles sont les normes obligatoires du HCSF pour obtenir un prêt immobilier ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Le Haut Conseil de Stabilité Financière (HCSF) impose aux banques un taux d'endettement maximal de 35% assurance emprunteur comprise et une durée maximale d'emprunt de 25 ans.",
          },
        },
        {
          '@type': 'Question',
          name: "Quelle est la différence de conversion entre salaire brut et salaire net ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Pour un salarié non-cadre en France, la déduction moyenne de cotisations sociales est d'environ 22% (Net ≈ Brut × 0,78). Pour un cadre, les cotisations supplémentaires portent la déduction à environ 25% (Net ≈ Brut × 0,75).",
          },
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
  lang="fr"
>
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-10 sm:space-y-14">
    <!-- Breadcrumbs Navigation -->
    <Breadcrumbs
      items={[
        { label: 'Pays', href: '/countries/' },
        { label: 'France', href: '/countries/france/' },
        { label: 'Guides Pratiques' },
      ]}
      isFrench={true}
    />

    <!-- Hero Header -->
    <header class="relative rounded-3xl p-6 sm:p-10 bg-gradient-to-br from-indigo-50/70 via-white to-blue-50/50 dark:from-slate-900/90 dark:via-gray-950 dark:to-indigo-950/40 border border-slate-200/80 dark:border-slate-800/80 shadow-sm overflow-hidden space-y-5 text-center sm:text-left">
      <!-- Glow Accent -->
      <div class="absolute top-0 right-0 -mt-8 -mr-8 w-64 h-64 bg-indigo-500/10 dark:bg-indigo-500/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-100/80 dark:bg-indigo-950/80 border border-indigo-200 dark:border-indigo-800/80 text-xs font-bold text-indigo-700 dark:text-indigo-300 shadow-2xs">
        <span>🇫🇷 ÉDITION FRANCE 2026 • 11 DOSSIERS & SIMULATEURS</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight font-outfit leading-tight">
        Guides Pratiques & Décisions Chiffrées pour la France
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
        Consultez nos dossiers complets classés en 11 thématiques officielles. Chaque guide inclut les barèmes légaux 2026, la formule mathématique pas à pas et le simulateur interactif gratuit correspondant.
      </p>

      <!-- Key Trust Badges -->
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5 sm:gap-3 text-xs sm:text-sm font-medium pt-2">
        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white/90 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 shadow-2xs">
          <span class="text-indigo-500">📚</span>
          <span>12 Guides Détaillés</span>
        </div>
        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white/90 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 shadow-2xs">
          <span class="text-emerald-500">⚖️</span>
          <span>Conforme DGFIP, HCSF & CAF 2026</span>
        </div>
        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white/90 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 shadow-2xs">
          <span class="text-sky-500">⚡</span>
          <span>Calcul 100% Côté Client</span>
        </div>
      </div>
    </header>

    <!-- Search & Quick Category Links Bar -->
    <section class="space-y-4" aria-label="Recherche et filtres par catégorie">
      <!-- Search Input Container -->
      <div class="relative max-w-2xl">
        <div class="relative flex items-center">
          <div class="absolute left-4 pointer-events-none text-slate-400 dark:text-slate-500 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>

          <input
            type="text"
            id="france-guides-search-input"
            placeholder="Rechercher un guide (ex. impôt, APL, frais réels, TVA, licenciement, retraite)..."
            aria-label="Rechercher un guide ou un barème fiscal"
            class="w-full pl-12 pr-11 py-3.5 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white/90 dark:bg-slate-900/90 hover:border-slate-300 dark:hover:border-slate-700 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 text-slate-900 dark:text-slate-100 text-sm sm:text-base transition-all shadow-sm focus:outline-none placeholder:text-slate-400 dark:placeholder:text-slate-500"
          />

          <!-- Clear Search Button -->
          <button
            type="button"
            id="france-guides-clear-btn"
            aria-label="Effacer la recherche"
            class="hidden absolute right-3 p-1.5 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Category Quick Jump Navigation (11 Separate Badges) -->
      <div class="space-y-2 pt-1">
        <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">
          Accès rapide par thématique :
        </span>
        <div class="flex flex-wrap items-center gap-2">
          {FRANCE_GUIDE_CATEGORIES.map((cat) => (
            <a
              href={`#category-${cat.id}`}
              class="px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold bg-white/80 dark:bg-slate-900/80 hover:bg-indigo-50 dark:hover:bg-indigo-950/70 border border-slate-200/90 dark:border-slate-800/90 text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400/50 transition-all flex items-center gap-1.5 shadow-2xs hover:scale-[1.02] active:scale-95"
            >
              <span class="text-sm">{cat.icon}</span>
              <span>{cat.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- No Results Placeholder (Search Filter) -->
    <div id="france-guides-no-results" class="hidden text-center py-16 px-4 rounded-3xl border border-slate-200/90 dark:border-slate-800/90 bg-white/60 dark:bg-slate-900/60 my-8">
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Aucun guide ne correspond à votre recherche</h3>
      <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto mb-4">
        Essayez avec d'autres mots-clés comme « TVA », « impôt », « salaire », « APL », « prêt », « retraite » ou « kilométrique ».
      </p>
      <button
        type="button"
        id="france-guides-reset-btn"
        class="px-5 py-2.5 rounded-xl bg-indigo-600 text-white text-xs sm:text-sm font-bold hover:bg-indigo-700 transition-colors shadow-xs"
      >
        Réinitialiser la recherche
      </button>
    </div>

    <!-- SEQUENTIAL CATEGORY-BY-CATEGORY LAYOUT (11 CATEGORIES) -->
    <div class="space-y-12 sm:space-y-16" id="france-categories-container">
      {FRANCE_GUIDE_CATEGORIES.map((category) => {
        const guidesInCategory = getGuidesByCategory(category.id);

        return (
          <section
            id={`category-${category.id}`}
            class="category-section scroll-mt-24 space-y-6 pt-6 border-t first:border-t-0 border-slate-200/80 dark:border-slate-800/80"
            data-category-section={category.id}
          >
            <!-- Category Header -->
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 pb-2">
              <div class="space-y-1.5">
                <div class="flex items-center gap-2.5">
                  <span class="text-2xl sm:text-3xl">{category.icon}</span>
                  <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight font-outfit">
                    {category.name}
                  </h2>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/50">
                    {guidesInCategory.length} {guidesInCategory.length > 1 ? 'guides' : 'guide'}
                  </span>
                </div>
                <p class="text-sm text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
                  {category.description}
                </p>
              </div>
            </div>

            <!-- Guides Grid for this Category -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {guidesInCategory.map((guide) => (
                <article
                  class="france-guide-card group rounded-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900/80 hover:border-indigo-500/50 hover:shadow-lg dark:hover:shadow-indigo-950/30 transition-all duration-300 flex flex-col justify-between overflow-hidden relative"
                  data-category={guide.category}
                  data-keywords={guide.keywords}
                  data-title={guide.title.toLowerCase()}
                  data-slug={guide.slug}
                >
                  <div class="p-6">
                    <!-- Header Row: Category Badge & Read Time -->
                    <div class="flex items-center justify-between gap-2 mb-3">
                      <span class="inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/70 px-2.5 py-1 rounded-lg border border-indigo-200/50 dark:border-indigo-800/40">
                        <span>{guide.icon}</span>
                        <span>{guide.categoryLabel}</span>
                      </span>
                      <span class="text-xs font-mono text-slate-400 dark:text-slate-500">⏱️ {guide.readTime}</span>
                    </div>

                    <!-- Title (Links to Dedicated Single Page) -->
                    <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors leading-snug mb-3">
                      <a href={`/countries/france/guides/${guide.slug}/`} class="focus:outline-none focus:underline">
                        {guide.title}
                      </a>
                    </h3>

                    <!-- Summary / Excerpt -->
                    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4 line-clamp-3">
                      {guide.summary}
                    </p>

                    <!-- Official Badge -->
                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-600 dark:text-slate-400">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      <span>{guide.badge}</span>
                    </div>
                  </div>

                  <!-- Card Footer: Direct Link to Simulator & Dedicated Guide Link -->
                  <div class="p-4 sm:px-6 bg-slate-50/70 dark:bg-slate-950/50 border-t border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between gap-2">
                    <a
                      href={guide.calculator.href}
                      class="inline-flex items-center gap-1 text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors group-hover:translate-x-0.5 transform"
                    >
                      <span>Simulateur</span>
                      <span>→</span>
                    </a>

                    <a
                      href={`/countries/france/guides/${guide.slug}/`}
                      class="px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition-all shadow-2xs hover:shadow-sm"
                    >
                      Consulter le guide →
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</Layout>

<script is:inline>
  (function initFranceGuidesSearch() {
    const searchInput = document.getElementById('france-guides-search-input');
    const clearBtn = document.getElementById('france-guides-clear-btn');
    const resetBtn = document.getElementById('france-guides-reset-btn');
    const noResultsDiv = document.getElementById('france-guides-no-results');
    const cards = document.querySelectorAll('.france-guide-card');
    const categorySections = document.querySelectorAll('.category-section');

    function removeAccents(str) {
      return (str || '').normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    }

    function filterGuides() {
      const rawSearch = (searchInput ? searchInput.value : '').trim().toLowerCase();
      const cleanSearch = removeAccents(rawSearch);
      let totalVisible = 0;

      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const keywords = card.getAttribute('data-keywords') || '';
        const category = card.getAttribute('data-category') || '';
        const full = `${title} ${keywords} ${category}`.toLowerCase();
        const cleanFull = removeAccents(full);

        const matches = !rawSearch || full.includes(rawSearch) || cleanFull.includes(cleanSearch);

        if (matches) {
          card.classList.remove('hidden');
          card.style.display = 'flex';
          totalVisible++;
        } else {
          card.classList.add('hidden');
          card.style.display = 'none';
        }
      });

      // Show/hide category section headers based on whether they have visible cards
      categorySections.forEach((sec) => {
        const visibleCardsInSec = sec.querySelectorAll('.france-guide-card:not(.hidden)');
        if (visibleCardsInSec.length === 0 && rawSearch.length > 0) {
          sec.classList.add('hidden');
        } else {
          sec.classList.remove('hidden');
        }
      });

      if (noResultsDiv) {
        if (totalVisible === 0) {
          noResultsDiv.classList.remove('hidden');
        } else {
          noResultsDiv.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        if (searchInput.value.trim().length > 0) {
          if (clearBtn) clearBtn.classList.remove('hidden');
        } else {
          if (clearBtn) clearBtn.classList.add('hidden');
        }
        filterGuides();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        clearBtn.classList.add('hidden');
        filterGuides();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        if (clearBtn) clearBtn.classList.add('hidden');
        filterGuides();
      });
    }
  })();
</script>

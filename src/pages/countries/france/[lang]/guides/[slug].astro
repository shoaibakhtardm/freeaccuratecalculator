---
// src/pages/countries/france/[lang]/guides/[slug].astro
import Layout from '../../../../../layouts/Layout.astro';
import ThemeToggle from '../../../../../components/ThemeToggle.astro';
import { FRANCE_GUIDES, getRelatedGuides, type FranceGuide } from '../../../../../data/france-guides';

export function getStaticPaths() {
  const languages = ['fr', 'en'];
  const paths: Array<{ params: { lang: string; slug: string }; props: { guide: FranceGuide } }> = [];

  for (const lang of languages) {
    for (const guide of FRANCE_GUIDES) {
      paths.push({
        params: { lang, slug: guide.slug },
        props: { guide },
      });
    }
  }

  return paths;
}

interface Props {
  guide: FranceGuide;
}

const { lang } = Astro.params;
const { guide } = Astro.props;

const isFr = lang === 'fr';
const currentLocale = isFr ? 'fr' : 'en';

const pageTitle = isFr
  ? (guide.metaTitle ? `${guide.metaTitle} | FAC` : `${guide.title} | Guide France 2026`)
  : (guide.metaTitle ? `${guide.metaTitle} (English) | FAC` : `${guide.title} | France Guide 2026`);

const pageDescription = guide.metaDescription || guide.summary;
const pageCanonical = `https://freeaccuratecalculator.com/countries/france/${currentLocale}/guides/${guide.slug}/`;
const frUrl = `https://freeaccuratecalculator.com/countries/france/fr/guides/${guide.slug}/`;
const enUrl = `https://freeaccuratecalculator.com/countries/france/en/guides/${guide.slug}/`;

const relatedGuides = getRelatedGuides(guide);

// JSON-LD Structured Data
const jsonLdGraph: any[] = [
  {
    '@type': 'Article',
    headline: guide.title,
    description: guide.summary,
    url: pageCanonical,
    inLanguage: isFr ? 'fr-FR' : 'en',
    author: {
      '@type': 'Organization',
      name: 'Free Accurate Calculator',
      url: 'https://freeaccuratecalculator.com',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Free Accurate Calculator',
      url: 'https://freeaccuratecalculator.com',
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': pageCanonical,
    },
    datePublished: '2026-01-01',
    dateModified: '2026-09-18',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: isFr ? 'Accueil' : 'Home', item: isFr ? 'https://freeaccuratecalculator.com/fr/' : 'https://freeaccuratecalculator.com/' },
      { '@type': 'ListItem', position: 2, name: isFr ? 'Pays' : 'Countries', item: 'https://freeaccuratecalculator.com/countries/' },
      { '@type': 'ListItem', position: 3, name: 'France', item: `https://freeaccuratecalculator.com/countries/france/${currentLocale}/` },
      { '@type': 'ListItem', position: 4, name: isFr ? 'Guides Pratiques' : 'Practical Guides', item: `https://freeaccuratecalculator.com/countries/france/${currentLocale}/guides/` },
      { '@type': 'ListItem', position: 5, name: guide.categoryLabel, item: `https://freeaccuratecalculator.com/countries/france/${currentLocale}/guides/` },
      { '@type': 'ListItem', position: 6, name: guide.title, item: pageCanonical },
    ],
  },
];

if (guide.faqs && guide.faqs.length > 0) {
  jsonLdGraph.push({
    '@type': 'FAQPage',
    mainEntity: guide.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': jsonLdGraph,
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  hreflangFr={frUrl}
  hreflangEn={enUrl}
  ogLocale={isFr ? 'fr_FR' : 'en_US'}
  lang={currentLocale}
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-3 sm:px-6 py-4 sm:py-8 space-y-8 text-slate-100">
    <!-- Top Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-slate-400 pb-4 border-b border-slate-800">
      <a href={isFr ? '/fr/' : '/'} class="hover:text-indigo-400">{isFr ? 'Accueil' : 'Home'}</a>
      <span>/</span>
      <a href="/countries/" class="hover:text-indigo-400">{isFr ? 'Pays' : 'Countries'}</a>
      <span>/</span>
      <a href={`/countries/france/${currentLocale}/`} class="hover:text-indigo-400">France</a>
      <span>/</span>
      <a href={`/countries/france/${currentLocale}/guides/`} class="hover:text-indigo-400">{isFr ? 'Guides' : 'Guides'}</a>
      <span>/</span>
      <span class="text-slate-200 font-semibold truncate max-w-xs sm:max-w-md">{guide.title}</span>
    </nav>

    <!-- Article Hero Header -->
    <header class="space-y-4">
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-indigo-950/60 text-indigo-300 border border-indigo-800/60">
          <span>{guide.icon}</span>
          <span>{guide.categoryLabel}</span>
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-950/40 text-emerald-300 border border-emerald-800/50">
          <span>✓</span>
          <span>{guide.badge}</span>
        </span>
        <span class="text-xs font-mono text-slate-400">
          ⏱️ {guide.readTime}
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white font-outfit leading-tight">
        {guide.h1 || guide.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
        {guide.summary}
      </p>
    </header>

    <!-- CALCULATOR CTA -->
    <div class="p-5 sm:p-7 rounded-2xl bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white shadow-xl flex flex-col sm:flex-row items-center justify-between gap-5">
      <div class="space-y-1.5 text-center sm:text-left">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white/20 text-white text-[11px] font-bold uppercase tracking-wider">
          <span>{isFr ? 'Simulateur Gratuit 2026' : 'Free Simulator 2026'}</span>
        </div>
        <h2 class="text-lg sm:text-xl font-bold font-outfit">
          {isFr ? 'Passez de la théorie au calcul en 10 secondes' : 'Calculate your exact results instantly'}
        </h2>
        <p class="text-xs sm:text-sm text-blue-100 max-w-xl">
          {isFr
            ? 'Calculez instantanément votre résultat exact grâce à notre outil interactif conforme aux barèmes officiels français.'
            : 'Get instant accurate estimates with our French-compliant calculation tools in Euros (€).'}
        </p>
      </div>

      <a
        href={guide.calculator.href}
        class="shrink-0 inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white text-indigo-700 hover:bg-indigo-50 font-bold text-sm shadow-md transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
      >
        <span>🧮 {guide.calculator.label}</span>
        <span>→</span>
      </a>
    </div>

    <!-- SECTIONS -->
    <div class="space-y-8">
      {guide.sections.map((section, idx) => (
        <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 space-y-4">
          <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-indigo-600/20 text-indigo-400 text-xs font-bold">
              {idx + 1}
            </span>
            <span>{section.heading}</span>
          </h2>
          <div class="text-sm sm:text-base text-slate-300 leading-relaxed whitespace-pre-line">
            {section.content}
          </div>
        </section>
      ))}
    </div>

    <!-- FAQS -->
    {guide.faqs && guide.faqs.length > 0 && (
      <section class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6 space-y-4">
        <h2 class="text-lg sm:text-xl font-bold text-white mb-4">
          {isFr ? 'Questions Fréquentes' : 'Frequently Asked Questions'}
        </h2>
        <div class="space-y-4">
          {guide.faqs.map((faq) => (
            <div class="border-b border-slate-800/80 pb-4 last:border-0 last:pb-0">
              <h3 class="text-sm sm:text-base font-semibold text-white mb-1">{faq.question}</h3>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

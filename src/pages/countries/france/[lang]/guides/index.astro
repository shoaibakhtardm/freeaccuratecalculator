---
// src/pages/countries/france/[lang]/guides/index.astro
import Layout from '../../../../../layouts/Layout.astro';
import ThemeToggle from '../../../../../components/ThemeToggle.astro';
import { FRANCE_GUIDE_CATEGORIES, getFranceGuides } from '../../../../../data/france-guides';

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const isFr = lang === 'fr';
const currentLocale = isFr ? 'fr' : 'en';
const guides = getFranceGuides(currentLocale);

const pageTitle = isFr
  ? "Guides Pratiques France 2026 | Fiscalité, Salaires, Prêts & Droit Social"
  : "Practical France Guides 2026 | Tax, Payroll, Mortgage & Labor Law";

const pageDescription = isFr
  ? "Dossiers complets, méthodologies officielles et analyses chiffrées pour la France : impôt sur le revenu 2026, frais réels, TVA, APL, prêt HCSF et conversion brut en net."
  : "Comprehensive practical guides, official methodologies, and numerical breakdowns for France: 2026 income tax, expenses, VAT, APL, and payroll.";

const pageCanonical = `https://freeaccuratecalculator.com/countries/france/${currentLocale}/guides/`;
const frUrl = 'https://freeaccuratecalculator.com/countries/france/fr/guides/';
const enUrl = 'https://freeaccuratecalculator.com/countries/france/en/guides/';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: pageTitle,
    description: pageDescription,
    url: pageCanonical,
    inLanguage: isFr ? 'fr-FR' : 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: isFr ? 'Accueil' : 'Home',
        item: isFr ? 'https://freeaccuratecalculator.com/fr/' : 'https://freeaccuratecalculator.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: isFr ? 'Pays' : 'Countries',
        item: 'https://freeaccuratecalculator.com/countries/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'France',
        item: `https://freeaccuratecalculator.com/countries/france/${currentLocale}/`,
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: isFr ? 'Guides' : 'Guides',
        item: pageCanonical,
      },
    ],
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  hreflangFr={frUrl}
  hreflangEn={enUrl}
  ogLocale={isFr ? 'fr_FR' : 'en_US'}
  lang={currentLocale}
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-slate-950 text-slate-100 antialiased selection:bg-indigo-500 selection:text-white">
    <!-- HEADER -->
    <header class="border-b border-slate-800/80 bg-slate-900/50 px-4 py-8 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-medium text-slate-400 mb-6">
          <a href={isFr ? '/fr/' : '/'} class="hover:text-indigo-400 transition-colors">{isFr ? 'Accueil' : 'Home'}</a>
          <span class="text-slate-600">/</span>
          <a href="/countries/" class="hover:text-indigo-400 transition-colors">{isFr ? 'Pays' : 'Countries'}</a>
          <span class="text-slate-600">/</span>
          <a href={`/countries/france/${currentLocale}/`} class="hover:text-indigo-400 transition-colors">France</a>
          <span class="text-slate-600">/</span>
          <span class="text-indigo-400 font-semibold">{isFr ? 'Guides Pratiques' : 'Practical Guides'}</span>
        </nav>

        <div class="mt-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-xs font-semibold text-indigo-400 mb-4">
            <span>📚</span>
            <span>France 2026 • {isFr ? 'Documentation Pratique' : 'Documentation Hub'}</span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white">
            {pageTitle}
          </h1>

          <p class="mt-2 text-sm sm:text-base text-slate-300 max-w-3xl leading-relaxed">
            {pageDescription}
          </p>
        </div>
      </div>
    </header>

    <!-- GUIDES LIST -->
    <section class="py-12 px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {guides.map((guide) => (
            <a
              href={`/countries/france/${currentLocale}/guides/${guide.slug}/`}
              class="group relative flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition-all duration-200 hover:-translate-y-1 hover:border-indigo-500/50 hover:bg-slate-900 hover:shadow-xl hover:shadow-indigo-500/10"
            >
              <div>
                <div class="flex items-center gap-3 mb-3">
                  <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-800 text-xl group-hover:scale-110 transition-transform">
                    {guide.icon}
                  </span>
                  <div>
                    <span class="text-xs font-medium text-slate-400 uppercase">{guide.categoryLabel}</span>
                    <h2 class="text-base font-bold text-white group-hover:text-indigo-400 transition-colors">
                      {guide.title}
                    </h2>
                  </div>
                </div>
                <p class="text-xs sm:text-sm text-slate-400 line-clamp-3 leading-relaxed">
                  {guide.summary}
                </p>
              </div>

              <div class="mt-6 flex items-center justify-between border-t border-slate-800/60 pt-4 text-xs font-semibold">
                <span class="text-slate-400">⏱ {guide.readTime}</span>
                <span class="text-indigo-400 group-hover:text-indigo-300 flex items-center gap-1 transition-colors">
                  {isFr ? 'Lire le guide' : 'Read guide'} →
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

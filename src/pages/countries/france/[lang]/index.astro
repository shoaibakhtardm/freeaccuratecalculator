---
// src/pages/countries/france/[lang]/index.astro
import Layout from '../../../../layouts/Layout.astro';
import { CATEGORY_ITEMS } from '../../../../data/categories';
import { getHomepageStrings } from '../../../../i18n/homepageDict';

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const isFr = lang === 'fr';
const currentLocale = isFr ? 'fr' : 'en';

const hpFr = getHomepageStrings('fr');

// Canonical & Hreflang Metadata
const pageTitle = isFr
  ? "Calculatrices et Simulateurs Gratuits France 2026 | Salaire, Impôt, TVA, Prêt"
  : "Free & Accurate Calculators France 2026 | Salary, Income Tax, VAT, Mortgage";

const pageDescription = isFr
  ? "Portail officiel de calculatrices gratuites pour la France : salaire brut en net 2026, impôt sur le revenu, TVA, prêt immobilier HCSF, frais de notaire et retraite. 100% privé, sans inscription et sans publicité."
  : "Official hub of free precision calculators for France: 2026 gross-to-net salary, income tax, VAT, HCSF mortgage capacity, notary fees, and pension. 100% private, zero registration.";

const pageCanonical = `https://freeaccuratecalculator.com/countries/france/${currentLocale}/`;
const frUrl = 'https://freeaccuratecalculator.com/countries/france/fr/';
const enUrl = 'https://freeaccuratecalculator.com/countries/france/en/';

const faqs = isFr
  ? [
      {
        '@type': 'Question',
        name: 'Ces simulateurs sont-ils conformes aux barèmes fiscaux français 2026 ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Oui. Nos simulateurs intègrent les barèmes officiels 2026 : tranches de l'impôt sur le revenu (DGFIP), cotisations sociales (URSSAF), droits de mutation des notaires (DMTO) et critères d'octroi de crédit du HCSF (taux d'effort maximal de 35%).",
        },
      },
      {
        '@type': 'Question',
        name: 'Comment sont formatés les montants et les devises ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Tous les calculs sont configurés par défaut en euros (€) et utilisent l'espace insécable comme séparateur de milliers conformément aux normes typographiques françaises (ex. 1 000 000 €).",
        },
      },
      {
        '@type': 'Question',
        name: 'Mes données personnelles ou financières sont-elles collectées ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Non. Tous les calculs s'exécutent exclusivement en mémoire locale dans votre navigateur (client-side). Aucune donnée financière, fiche de paie ou simulation d'emprunt n'est transmise ni enregistrée sur nos serveurs.",
        },
      },
      {
        '@type': 'Question',
        name: 'Les simulateurs sont-ils entièrement gratuits ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Oui. L’ensemble des calculateurs et simulateurs pour la France sont en accès libre et illimité, sans abonnement, sans création de compte et sans mur payant.',
        },
      },
    ]
  : [
      {
        '@type': 'Question',
        name: 'Are these calculators compliant with official 2026 French statutory rules?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Our calculators integrate statutory 2026 French regulations: progressive income tax brackets (DGFIP), URSSAF social security contributions, notary acquisition costs (DMTO), and HCSF mortgage lending debt ratio limits (35% maximum).',
        },
      },
      {
        '@type': 'Question',
        name: 'How are currencies and amounts formatted?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'All calculations are configured in Euros (€) using statutory French currency formatting and precision math engines.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is personal or financial data collected or transmitted?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. All calculations run strictly client-side in your local browser memory. Zero financial inputs, payroll data, or loan simulations are saved or transmitted to external servers.',
        },
      },
      {
        '@type': 'Question',
        name: 'Are all French calculators free to use?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Every tool is 100% free with unlimited access, zero registration, and zero paywalls.',
        },
      },
    ];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${pageCanonical}#collection`,
    name: pageTitle,
    description: pageDescription,
    url: pageCanonical,
    inLanguage: isFr ? 'fr-FR' : 'en',
    isPartOf: {
      '@type': 'WebSite',
      '@id': 'https://freeaccuratecalculator.com/#website',
      name: 'Free Accurate Calculator',
      url: 'https://freeaccuratecalculator.com/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: isFr ? 'Accueil' : 'Home',
        item: isFr ? 'https://freeaccuratecalculator.com/fr/' : 'https://freeaccuratecalculator.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: isFr ? 'Pays' : 'Countries',
        item: 'https://freeaccuratecalculator.com/countries/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'France',
        item: pageCanonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs,
  },
];

// Categories data mapped to language-authoritative routes
const CATEGORIES_DATA = CATEGORY_ITEMS.map((cat) => ({
  id: cat.id,
  name: isFr ? (hpFr.categoriesSection.categories[cat.id] || cat.name) : cat.name,
  icon: cat.icon,
  href: `/countries/france/${currentLocale}/${cat.id}/`,
}));

// Popular Calculators with language-authoritative routes
const POPULAR_CALCULATORS = [
  {
    id: 'sip-calculator',
    name: isFr ? 'Calculateur SIP & Épargne Programmée' : 'SIP & Investment Calculator',
    shortName: isFr ? 'SIP / Épargne' : 'SIP / Savings',
    icon: '📈',
    badge: isFr ? 'Intérêts Composés' : 'Compound Growth',
    desc: isFr
      ? 'Calculez la valeur future de vos versements mensuels programmés avec réinvestissement des gains en euros.'
      : 'Calculate future wealth accumulation from systematic monthly investments in EUR with compound growth.',
    category: isFr ? 'Finance' : 'Finance',
    href: `/countries/france/${currentLocale}/finance/sip-calculator/`,
  },
  {
    id: 'income-tax-calculator',
    name: isFr ? "Simulateur d'Impôt sur le Revenu" : 'Income Tax Calculator France',
    shortName: isFr ? 'Impôt Revenu' : 'Income Tax',
    icon: '📑',
    badge: isFr ? 'Barème DGFIP 2026' : 'Statutory Slabs 2026',
    desc: isFr
      ? "Calcul de l'impôt sur le revenu par tranches marginales (TMI), quotient familial et décote."
      : 'French progressive income tax calculation based on statutory 2026 tax brackets and family quotient.',
    category: isFr ? 'Finance' : 'Finance',
    href: `/countries/france/${currentLocale}/finance/income-tax-calculator/`,
  },
  {
    id: 'mortgage-calculator',
    name: isFr ? 'Simulateur de Prêt Immobilier' : 'Mortgage & Loan Calculator France',
    shortName: isFr ? 'Prêt Immobilier' : 'Mortgage',
    icon: '🏠',
    badge: isFr ? 'Tableau Amortissement' : 'Amortization Table',
    desc: isFr
      ? "Simulation d'emprunt immobilier, calcul des mensualités, assurance emprunteur et coût total en euros."
      : 'French real estate mortgage amortization, monthly payment calculation, and total borrowing costs in EUR.',
    category: isFr ? 'Finance' : 'Finance',
    href: `/countries/france/${currentLocale}/finance/mortgage-calculator/`,
  },
  {
    id: 'salary-calculator',
    name: isFr ? 'Simulateur Salaire Brut en Net' : 'Gross to Net Salary Calculator France',
    shortName: isFr ? 'Brut en Net' : 'Gross / Net',
    icon: '💼',
    badge: isFr ? 'Cadre / Non-Cadre' : 'Payroll Slabs',
    desc: isFr
      ? 'Conversion brut en net 2026 avec cotisations sociales salariales (22% non-cadre, 25% cadre).'
      : 'Statutory gross-to-net salary conversion factoring French social security contributions and deductions.',
    category: isFr ? 'Finance' : 'Finance',
    href: `/countries/france/${currentLocale}/finance/salary-calculator/`,
  },
  {
    id: 'compound-interest-calculator',
    name: isFr ? "Calculateur d'Intérêts Composés" : 'Compound Interest Calculator France',
    shortName: isFr ? 'Intérêts Composés' : 'Compound Int',
    icon: '📈',
    badge: isFr ? 'Croissance Capital' : 'Wealth Growth',
    desc: isFr
      ? 'Simulation de la capitalisation des gains, rendements exponentiels et versements réguliers en Euros.'
      : 'Simulate compounding returns, variable deposits, and exponential growth in Euros.',
    category: isFr ? 'Finance' : 'Finance',
    href: `/countries/france/${currentLocale}/finance/compound-interest-calculator/`,
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  hreflangFr={frUrl}
  hreflangEn={enUrl}
  ogLocale={isFr ? 'fr_FR' : 'en_US'}
  lang={currentLocale}
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-slate-950 text-slate-100 antialiased selection:bg-indigo-500 selection:text-white">
    <!-- HERO SECTION -->
    <header class="relative overflow-hidden border-b border-slate-800/80 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950 px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <!-- Main Hero Title & Badges -->
        <div class="text-center max-w-3xl mx-auto">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-xs font-semibold text-indigo-400 mb-6">
            <span>🇫🇷</span>
            <span>{isFr ? 'Écosystème Officiel France 2026' : 'Official France 2026 Ecosystem'}</span>
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-emerald-400">{isFr ? 'Barèmes Conformes' : 'Statutory Compliant'}</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
            {isFr ? 'Calculatrices & Simulateurs Gratuits pour la France' : 'Free & Accurate Precision Calculators for France'}
          </h1>

          <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
            {pageDescription}
          </p>

          <!-- Key Metrics / Trust Bar -->
          <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-3 text-center">
              <span class="block text-xl font-bold text-white">€ (EUR)</span>
              <span class="text-xs text-slate-400">{isFr ? 'Devise Nationale' : 'National Currency'}</span>
            </div>
            <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-3 text-center">
              <span class="block text-xl font-bold text-emerald-400">100%</span>
              <span class="text-xs text-slate-400">{isFr ? 'Gratuit & Privé' : 'Free & Private'}</span>
            </div>
            <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-3 text-center">
              <span class="block text-xl font-bold text-indigo-400">2026</span>
              <span class="text-xs text-slate-400">{isFr ? 'Normes Fiscales' : 'Statutory Rules'}</span>
            </div>
            <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-3 text-center">
              <span class="block text-xl font-bold text-amber-400">PDF</span>
              <span class="text-xs text-slate-400">{isFr ? 'Export Clair' : 'Light Export'}</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- FLAGSHIP POPULAR CALCULATORS -->
    <section class="py-12 px-4 sm:px-6 lg:px-8 border-b border-slate-800/80 bg-slate-950">
      <div class="mx-auto max-w-7xl">
        <div class="flex items-center justify-between gap-4 mb-8">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-white">
              {isFr ? 'Simulateurs Phares pour la France' : 'Flagship Calculators for France'}
            </h2>
            <p class="text-xs sm:text-sm text-slate-400 mt-1">
              {isFr ? 'Outils de haute précision avec règles et devises françaises' : 'High-precision tools tailored to French rules and currency'}
            </p>
          </div>
          <a
            href={`/countries/france/${currentLocale}/finance/`}
            class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition-colors flex items-center gap-1"
          >
            <span>{isFr ? 'Voir la Finance' : 'Explore Finance'}</span>
            <span>→</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {POPULAR_CALCULATORS.map((calc) => (
            <a
              href={calc.href}
              class="group relative flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition-all duration-200 hover:-translate-y-1 hover:border-indigo-500/50 hover:bg-slate-900 hover:shadow-xl hover:shadow-indigo-500/10"
            >
              <div>
                <div class="flex items-center justify-between gap-3 mb-4">
                  <div class="flex items-center gap-3">
                    <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-800/80 text-2xl group-hover:scale-110 transition-transform">
                      {calc.icon}
                    </span>
                    <div>
                      <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">{calc.category}</span>
                      <h3 class="text-base font-bold text-white group-hover:text-indigo-400 transition-colors">
                        {calc.name}
                      </h3>
                    </div>
                  </div>
                </div>
                <p class="text-xs sm:text-sm text-slate-400 line-clamp-2 leading-relaxed">
                  {calc.desc}
                </p>
              </div>

              <div class="mt-6 flex items-center justify-between border-t border-slate-800/60 pt-4 text-xs font-semibold">
                <span class="inline-flex items-center rounded-md bg-indigo-500/10 px-2.5 py-1 text-indigo-400 border border-indigo-500/20">
                  {calc.badge}
                </span>
                <span class="text-slate-400 group-hover:text-white flex items-center gap-1 transition-colors">
                  {isFr ? 'Calculer' : 'Calculate'} →
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ALL CATEGORIES -->
    <section class="py-12 px-4 sm:px-6 lg:px-8 bg-slate-900/30 border-b border-slate-800/80">
      <div class="mx-auto max-w-7xl">
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-6">
          {isFr ? 'Toutes les Catégories de Calculatrices France' : 'All France Calculator Categories'}
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
          {CATEGORIES_DATA.map((cat) => (
            <a
              href={cat.href}
              class="flex flex-col items-center justify-center rounded-xl border border-slate-800 bg-slate-900/50 p-4 text-center hover:border-indigo-500/50 hover:bg-slate-900 transition-all group"
            >
              <span class="text-2xl mb-2 group-hover:scale-110 transition-transform">{cat.icon}</span>
              <span class="text-xs font-semibold text-slate-300 group-hover:text-white transition-colors">{cat.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="py-12 px-4 sm:px-6 lg:px-8 bg-slate-950">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-6 text-center">
          {isFr ? 'Foire Aux Questions (FAQ) — France 2026' : 'Frequently Asked Questions (FAQ) — France 2026'}
        </h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-5">
              <h3 class="text-sm sm:text-base font-bold text-white mb-2">{faq.name}</h3>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">{faq.acceptedAnswer.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

---
// src/pages/countries/france/simulateur-ptz.astro
import Layout from '../../../layouts/Layout.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
import { getCountryBySlug } from '../../../data/countries';

const country = getCountryBySlug('france')!;

const pageTitle = "Simulateur PTZ 2026 Gratuit | Éligibilité, Montant & Barème Prêt à Taux Zéro";
const pageDescription = "Calculez gratuitement votre droit au Prêt à Taux Zéro (PTZ 2026). Test d'éligibilité par zone (A, B1, B2, C), 4 tranches de revenus, quotité jusqu'à 50% et calcul du différé.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: "Simulateur PTZ 2026 France",
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'All',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'EUR',
      },
      description: pageDescription,
      inLanguage: 'fr-FR',
      url: 'https://freeaccuratecalculator.com/countries/france/simulateur-ptz/',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://freeaccuratecalculator.com/' },
        { '@type': 'ListItem', position: 2, name: 'Pays', item: 'https://freeaccuratecalculator.com/countries/' },
        { '@type': 'ListItem', position: 3, name: 'France', item: 'https://freeaccuratecalculator.com/countries/france/fr/' },
        { '@type': 'ListItem', position: 4, name: 'Prêt & Crédit', item: 'https://freeaccuratecalculator.com/countries/france/fr/guides/' },
        { '@type': 'ListItem', position: 5, name: 'Simulateur PTZ', item: 'https://freeaccuratecalculator.com/countries/france/simulateur-ptz/' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: "Quelles sont les conditions de ressources pour obtenir le PTZ en 2026 ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "L'éligibilité au PTZ dépend de votre Revenu Fiscal de Référence (RFR N-2), de la composition de votre foyer et de la zone géographique du bien (Zone A, B1, B2 ou C). La réforme a instauré 4 tranches de revenus avec des plafonds rehaussés permettant aux classes moyennes d'accéder au dispositif avec une quotité de 20 % à 50 % du coût de l'opération.",
          },
        },
        {
          '@type': 'Question',
          name: "Quels types de logements sont finançables par le PTZ 2026 ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Le PTZ finance les logements neufs collectifs en zones tendues (A et B1), ainsi que les logements anciens avec un programme de travaux de rénovation énergétique d'au moins 25 % du coût total en zones détendues (B2 et C).",
          },
        },
        {
          '@type': 'Question',
          name: "Comment fonctionne la période de différé de remboursement du PTZ ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Selon votre tranche de revenus (Tranche 1, 2 ou 3), vous bénéficiez d'une période de différé total de 5 à 15 ans pendant laquelle vous ne remboursez aucun centime sur le PTZ (mensualité de 0 €). Le remboursement du capital n'intervient que dans la seconde phase sur 10 à 15 ans.",
          },
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://freeaccuratecalculator.com/countries/france/simulateur-ptz/"
  jsonLd={jsonLd}
  lang="fr-FR"
  locale="fr"
>
  <div class="max-w-5xl mx-auto px-3 sm:px-6 py-4 sm:py-8 space-y-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-cyan-600 dark:hover:text-cyan-400">Accueil</a>
      <span>/</span>
      <a href="/countries/" class="hover:text-cyan-600 dark:hover:text-cyan-400">Pays</a>
      <span>/</span>
      <a href="/countries/france/fr/" class="hover:text-cyan-600 dark:hover:text-cyan-400">France</a>
      <span>/</span>
      <a href="/countries/france/fr/guides/" class="hover:text-cyan-600 dark:hover:text-cyan-400">Prêt Immobilier</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">Simulateur PTZ</span>
    </nav>

    <!-- Hero Title -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-50 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-300 border border-cyan-200/50 dark:border-cyan-800/50">
        <span>Barème Officiel 2026</span>
        <span>•</span>
        <span>Quotité jusqu'à 50%</span>
        <span>•</span>
        <span>Différé de Remboursement Inclus</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white font-outfit">
        Simulateur PTZ 2026 : Calculez Votre Prêt à Taux Zéro
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-3xl leading-relaxed">
        Vérifiez votre éligibilité légale au PTZ 2026, calculez le montant maximum auquel vous avez droit sans intérêts et découvrez la durée exacte de votre différé de remboursement.
      </p>
    </div>

    <!-- CALCULATOR CONTAINER -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      <!-- FORM INPUTS (7 cols) -->
      <div class="lg:col-span-7 bg-white dark:bg-slate-900/90 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 p-5 sm:p-7 shadow-sm space-y-5">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center justify-between">
          <span>1. Critères du Projet & Foyer</span>
          <span class="text-xs font-normal text-cyan-600 dark:text-cyan-400">Zonage 2026</span>
        </h2>

        <!-- Zonage Géographique -->
        <div class="space-y-1.5">
          <label for="ptz-zone" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Zone Géographique du Logement
          </label>
          <select
            id="ptz-zone"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-medium text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none cursor-pointer"
          >
            <option value="A" selected>Zone A / Abis (Paris, Côte d'Azur, Genevois français, grandes métropoles très tendues)</option>
            <option value="B1">Zone B1 (Agglomérations &gt; 250 000 hab, pourtour parisien, grandes villes)</option>
            <option value="B2">Zone B2 (Villes moyennes de 50 000 à 250 000 habitants)</option>
            <option value="C">Zone C (Communes rurales et petites villes hors zones tendues)</option>
          </select>
        </div>

        <!-- Nombre d'occupants -->
        <div class="space-y-1.5">
          <div class="flex justify-between items-center">
            <label for="ptz-occupants" class="text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Nombre de Personnes Destinées à Occuper le Logement
            </label>
            <span class="text-xs font-mono font-bold text-cyan-600 dark:text-cyan-400" id="ptz-occupants-display">2 personnes</span>
          </div>
          <select
            id="ptz-occupants"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-medium text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none cursor-pointer"
          >
            <option value="1">1 personne</option>
            <option value="2" selected>2 personnes</option>
            <option value="3">3 personnes</option>
            <option value="4">4 personnes</option>
            <option value="5">5 personnes ou plus</option>
          </select>
        </div>

        <!-- Revenu Fiscal de Référence N-2 -->
        <div class="space-y-1.5">
          <div class="flex justify-between items-center">
            <label for="ptz-rfr" class="text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Revenu Fiscal de Référence (RFR N-2, avis d'impôt)
            </label>
            <span class="text-xs font-mono font-bold text-cyan-600 dark:text-cyan-400" id="ptz-rfr-display">36 000 €</span>
          </div>
          <div class="relative">
            <input
              type="number"
              id="ptz-rfr"
              min="5000"
              max="200000"
              step="1000"
              value="36000"
              class="w-full px-3.5 py-2.5 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none"
            />
            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400 font-bold">€</span>
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">
            Somme des RFR indiqués sur les avis d'impôt de toutes les personnes vivant dans le futur logement.
          </p>
        </div>

        <!-- Coût Total de l'Opération -->
        <div class="space-y-1.5">
          <div class="flex justify-between items-center">
            <label for="ptz-cost" class="text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Coût Total de l'Acquisition (€ TTC)
            </label>
            <span class="text-xs font-mono font-bold text-cyan-600 dark:text-cyan-400" id="ptz-cost-display">240 000 €</span>
          </div>
          <div class="relative">
            <input
              type="number"
              id="ptz-cost"
              min="20000"
              max="1500000"
              step="5000"
              value="240000"
              class="w-full px-3.5 py-2.5 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none"
            />
            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400 font-bold">€</span>
          </div>
        </div>

        <!-- Primo-accédant checkbox -->
        <div class="p-3.5 rounded-xl border border-cyan-100 dark:border-cyan-950/80 bg-cyan-50/40 dark:bg-cyan-950/20 flex items-start gap-3">
          <input
            type="checkbox"
            id="ptz-primo"
            checked
            class="mt-1 w-4 h-4 rounded text-cyan-600 focus:ring-cyan-500 border-slate-300 dark:border-slate-700"
          />
          <label for="ptz-primo" class="text-xs text-slate-700 dark:text-slate-300 font-medium cursor-pointer">
            <strong class="text-slate-900 dark:text-white">Condition de primo-accession respectée :</strong> vous n'avez pas été propriétaire de votre résidence principale au cours des 2 dernières années.
          </label>
        </div>
      </div>

      <!-- RESULTS STICKY SUMMARY (5 cols) -->
      <div class="lg:col-span-5 space-y-5 lg:sticky lg:top-24">
        <div class="bg-gradient-to-br from-cyan-950 via-slate-900 to-slate-950 text-white rounded-2xl p-5 sm:p-7 shadow-xl border border-cyan-500/30 relative overflow-hidden">
          <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-cyan-500/10 rounded-full blur-2xl"></div>

          <div class="space-y-4 relative z-10">
            <!-- STATUS BADGE -->
            <div id="ptz-status-badge" class="p-3 rounded-xl bg-cyan-500/20 border border-cyan-400/40 text-center">
              <span class="text-[11px] uppercase tracking-wider font-bold text-cyan-300 block">Statut d'Éligibilité</span>
              <div class="text-lg font-extrabold text-white mt-0.5" id="ptz-status-text">
                ÉLIGIBLE AU PTZ (Tranche 2)
              </div>
            </div>

            <!-- MONTANT ACCORDÉ -->
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-cyan-300">
                Montant Maximal du PTZ à 0%
              </span>
              <div class="text-3xl sm:text-4xl font-extrabold font-outfit text-white tracking-tight mt-1" id="ptz-amount-display">
                84 000 €
              </div>
              <p class="text-xs text-slate-300 mt-1">
                Quotité accordée : <strong id="ptz-quotite-display" class="text-white">40 %</strong> du plafond retenu
              </p>
            </div>

            <!-- DETAIL DES PHASES DE REMBOURSEMENT -->
            <div class="p-3.5 rounded-xl bg-slate-800/80 border border-slate-700 text-xs space-y-2.5">
              <span class="font-bold text-slate-200 block border-b border-slate-700 pb-1.5">
                Calendrier de Remboursement Officiel
              </span>

              <div class="flex justify-between items-center text-slate-300">
                <span>Phase 1 (Différé total 100%) :</span>
                <span class="font-bold text-cyan-300 font-mono" id="ptz-differe-display">10 ans (0 €/mois)</span>
              </div>
              <div class="flex justify-between items-center text-slate-300">
                <span>Phase 2 (Remboursement du capital) :</span>
                <span class="font-bold text-white font-mono" id="ptz-remboursement-display">10 ans</span>
              </div>
              <div class="flex justify-between items-center text-slate-300">
                <span>Mensualité du PTZ en phase 2 :</span>
                <span class="font-bold text-emerald-400 font-mono" id="ptz-mensualite-display">700 € / mois</span>
              </div>
            </div>

            <!-- ÉCONOMIE BANCAIRE ESTIMÉE -->
            <div class="p-3 rounded-xl bg-emerald-500/20 border border-emerald-400/40 text-xs text-emerald-200 space-y-1">
              <span class="font-bold text-white block">💰 Économie totale d'intérêts bancaires :</span>
              <p>
                Par rapport à un crédit classique à 3,50 %, ce PTZ vous fait économiser environ <strong id="ptz-savings-display" class="text-white">35 280 €</strong> d'intérêts et assurance.
              </p>
            </div>

            <!-- Actions -->
            <div class="pt-2">
              <button
                type="button"
                id="btn-print-ptz"
                class="w-full py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition-colors flex items-center justify-center gap-2"
              >
                <span>🖨️</span> Télécharger l'Attestation PTZ
              </button>
            </div>
          </div>
        </div>

        <!-- Contextual Card -->
        <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs space-y-2 text-slate-600 dark:text-slate-400">
          <p class="font-bold text-slate-900 dark:text-white flex items-center gap-1">
            <span>💡</span> Montage de Financement :
          </p>
          <p>
            Le PTZ ne finance jamais 100 % d'un bien et doit obligatoirement être complété par un prêt bancaire principal ou un apport.
          </p>
          <a href="/countries/france/capacite-emprunt-hcsf/" class="font-semibold text-cyan-600 dark:text-cyan-400 hover:underline block pt-1">
            → Calculer votre capacité d'emprunt totale
          </a>
        </div>
      </div>
    </div>

    <!-- GUIDE PEDAGOGIQUE PTZ -->
    <article class="bg-white dark:bg-slate-900/90 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 p-6 sm:p-8 space-y-6 text-slate-800 dark:text-slate-200 leading-relaxed text-sm sm:text-base">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white font-outfit border-b border-slate-100 dark:border-slate-800 pb-3">
        Tout Savoir sur le Prêt à Taux Zéro (PTZ 2026)
      </h2>

      <div class="space-y-4">
        <p>
          Le <strong>Prêt à Taux Zéro (PTZ)</strong> est une avance sans intérêt ni frais de dossier accordée par l'État aux ménages primo-accédants pour l'achat de leur résidence principale.
        </p>

        <h3 class="text-lg font-bold text-slate-900 dark:text-white pt-2">
          1. Les 4 Tranches de Quotités du Nouveau Barème
        </h3>
        <p>
          La quotité correspond au pourcentage du plafond d'opération finançable par le PTZ :
        </p>
        <ul class="list-disc pl-5 space-y-1 text-slate-600 dark:text-slate-400 text-xs sm:text-sm">
          <li><strong>Tranche 1 (Ménages très modestes) :</strong> Financement jusqu'à <strong>50 %</strong> avec différé total de 15 ans.</li>
          <li><strong>Tranche 2 (Ménages modestes) :</strong> Financement jusqu'à <strong>40 %</strong> avec différé total de 10 ans.</li>
          <li><strong>Tranche 3 (Classes moyennes intermédiaires) :</strong> Financement jusqu'à <strong>40 %</strong> avec différé de 5 ans.</li>
          <li><strong>Tranche 4 (Classes moyennes supérieures) :</strong> Financement jusqu'à <strong>20 %</strong> avec remboursement direct sur 10 ans.</li>
        </ul>
      </div>

      <!-- FAQ Accordions -->
      <div class="space-y-3 pt-4 border-t border-slate-100 dark:border-slate-800">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">
          Foire Aux Questions : PTZ
        </h3>

        <details class="group rounded-xl border border-slate-200 dark:border-slate-800 p-3.5 bg-slate-50/50 dark:bg-slate-800/40">
          <summary class="font-bold text-slate-900 dark:text-white cursor-pointer list-none flex justify-between items-center text-sm">
            <span>Peut-on mettre en location un bien financé par un PTZ ?</span>
            <span class="text-cyan-600 dark:text-cyan-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2">
            Pendant les 6 premières années suivant l'octroi du prêt, le logement doit impérativement rester votre résidence principale (occupée au moins 8 mois par an). La mise en location n'est possible avant 6 ans qu'en cas de force majeure (mutation professionnelle à plus de 50 km, divorce, invalidité ou chômage de plus d'un an) sous conditions strictes de loyer plafonné.
          </p>
        </details>
      </div>
    </article>

    <!-- PROJETS CONNEXES -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
      <a
        href="/countries/france/capacite-emprunt-hcsf/"
        class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-cyan-500 transition-all group"
      >
        <div class="text-xl mb-1">🏦</div>
        <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400">
          Capacité d'Emprunt HCSF
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Calculez vos mensualités maximales et la règle des 35%.
        </p>
      </a>

      <a
        href="/countries/france/frais-de-notaire/"
        class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-cyan-500 transition-all group"
      >
        <div class="text-xl mb-1">⚖️</div>
        <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400">
          Frais de Notaire 2026
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Droits de mutation et déduction du mobilier.
        </p>
      </a>

      <a
        href="/countries/france/simulateur-apl/"
        class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-cyan-500 transition-all group"
      >
        <div class="text-xl mb-1">🏠</div>
        <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400">
          Simulateur APL 2026
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Aide au logement CAF pour locataires et étudiants.
        </p>
      </a>
    </div>
  </div>

  <script is:inline>
    (function () {
      const zoneSelect = document.getElementById('ptz-zone');
      const occupantsSelect = document.getElementById('ptz-occupants');
      const occupantsDisplay = document.getElementById('ptz-occupants-display');
      const rfrInput = document.getElementById('ptz-rfr');
      const rfrDisplay = document.getElementById('ptz-rfr-display');
      const costInput = document.getElementById('ptz-cost');
      const costDisplay = document.getElementById('ptz-cost-display');
      const primoCheck = document.getElementById('ptz-primo');

      const statusBadge = document.getElementById('ptz-status-badge');
      const statusText = document.getElementById('ptz-status-text');
      const amountDisplay = document.getElementById('ptz-amount-display');
      const quotiteDisplay = document.getElementById('ptz-quotite-display');
      const differeDisplay = document.getElementById('ptz-differe-display');
      const remboursementDisplay = document.getElementById('ptz-remboursement-display');
      const mensualiteDisplay = document.getElementById('ptz-mensualite-display');
      const savingsDisplay = document.getElementById('ptz-savings-display');

      const formatEuro = (val) => new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(val);

      // Coefficients familiaux PTZ
      const coeffFamilial = { 1: 1.0, 2: 1.4, 3: 1.7, 4: 2.0, 5: 2.3 };

      // Plafonds d'opération par zone et nb personnes
      const plafondsOperation = {
        A: { 1: 150000, 2: 210000, 3: 255000, 4: 300000, 5: 345000 },
        B1: { 1: 135000, 2: 189000, 3: 230000, 4: 270000, 5: 311000 },
        B2: { 1: 110000, 2: 154000, 3: 187000, 4: 220000, 5: 253000 },
        C: { 1: 100000, 2: 140000, 3: 170000, 4: 200000, 5: 230000 },
      };

      // Tranches de revenus pondérés (RFR / Coeff)
      // Tranche 1: <= 25000€ (50% quotité)
      // Tranche 2: 25000€ à 31000€ (40% quotité)
      // Tranche 3: 31000€ à 37000€ (40% quotité)
      // Tranche 4: 37000€ à 49000€ (20% quotité)

      function calculate() {
        const zone = zoneSelect.value;
        const occupants = parseInt(occupantsSelect.value, 10) || 1;
        const rfr = parseFloat(rfrInput.value) || 0;
        const cost = parseFloat(costInput.value) || 0;
        const isPrimo = primoCheck.checked;

        occupantsDisplay.textContent = `${occupants} ${occupants > 1 ? 'personnes' : 'personne'}`;
        rfrDisplay.textContent = formatEuro(rfr);
        costDisplay.textContent = formatEuro(cost);

        if (!isPrimo) {
          statusBadge.className = 'p-3 rounded-xl bg-rose-500/20 border border-rose-400/40 text-center';
          statusText.textContent = 'NON ÉLIGIBLE (Condition primo-accédant requise)';
          amountDisplay.textContent = '0 €';
          quotiteDisplay.textContent = '0 %';
          differeDisplay.textContent = '0 an';
          remboursementDisplay.textContent = '0 an';
          mensualiteDisplay.textContent = '0 € / mois';
          savingsDisplay.textContent = '0 €';
          return;
        }

        const coeff = coeffFamilial[occupants] || 2.3;
        const rfrPondere = rfr / coeff;

        let tranche = 0;
        let quotite = 0;
        let differeYears = 0;
        let rembourseYears = 0;

        if (rfrPondere <= 25000) {
          tranche = 1;
          quotite = 0.50;
          differeYears = 15;
          rembourseYears = 10;
        } else if (rfrPondere <= 31000) {
          tranche = 2;
          quotite = 0.40;
          differeYears = 10;
          rembourseYears = 10;
        } else if (rfrPondere <= 37000) {
          tranche = 3;
          quotite = 0.40;
          differeYears = 5;
          rembourseYears = 15;
        } else if (rfrPondere <= 49000) {
          tranche = 4;
          quotite = 0.20;
          differeYears = 0;
          rembourseYears = 10;
        } else {
          tranche = 0; // Au-dessus du plafond max
        }

        if (tranche === 0) {
          statusBadge.className = 'p-3 rounded-xl bg-amber-500/20 border border-amber-400/40 text-center';
          statusText.textContent = 'REVENUS SUPÉRIEURS AU PLAFOND LÉGAL';
          amountDisplay.textContent = '0 €';
          quotiteDisplay.textContent = '0 %';
          differeDisplay.textContent = '0 an';
          remboursementDisplay.textContent = '0 an';
          mensualiteDisplay.textContent = '0 € / mois';
          savingsDisplay.textContent = '0 €';
          return;
        }

        // Plafond d'opération retenu
        const maxOp = (plafondsOperation[zone] && plafondsOperation[zone][occupants]) || 200000;
        const operationRetenue = Math.min(cost, maxOp);
        const ptzAmount = Math.round(operationRetenue * quotite);

        // Mensualité phase 2
        const totalMonthsPhase2 = rembourseYears * 12;
        const monthlyPayment = totalMonthsPhase2 > 0 ? Math.round(ptzAmount / totalMonthsPhase2) : 0;

        // Économie vs prêt à 3.5%
        const approxSavings = Math.round(ptzAmount * 0.035 * (differeYears + rembourseYears / 2));

        statusBadge.className = 'p-3 rounded-xl bg-cyan-500/20 border border-cyan-400/40 text-center';
        statusText.textContent = `ÉLIGIBLE AU PTZ (Tranche ${tranche})`;
        amountDisplay.textContent = formatEuro(ptzAmount);
        quotiteDisplay.textContent = `${Math.round(quotite * 100)} %`;
        differeDisplay.textContent = differeYears > 0 ? `${differeYears} ans (0 €/mois)` : 'Aucun différé';
        remboursementDisplay.textContent = `${rembourseYears} ans`;
        mensualiteDisplay.textContent = `${formatEuro(monthlyPayment)} / mois`;
        savingsDisplay.textContent = formatEuro(approxSavings);
      }

      [zoneSelect, occupantsSelect, rfrInput, costInput, primoCheck].forEach((el) => {
        el.addEventListener('input', calculate);
        el.addEventListener('change', calculate);
      });

      document.getElementById('btn-print-ptz')?.addEventListener('click', () => {
        window.print();
      });

      calculate();
    })();
  </script>
</Layout>

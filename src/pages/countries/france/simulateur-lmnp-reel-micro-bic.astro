---
// src/pages/countries/france/simulateur-lmnp-reel-micro-bic.astro
import Layout from '../../../layouts/Layout.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
import { getCountryBySlug } from '../../../data/countries';

const country = getCountryBySlug('france')!;

const pageTitle = "Simulateur LMNP Réel vs Micro-BIC 2026 Gratuit | Calcul Amortissement & Fiscalité";
const pageDescription = "Comparez instantanément le régime Réel Simplifié et le Micro-BIC pour votre location meublée (LMNP 2026). Calcul d'amortissement par composants, TMI, prélèvements sociaux et réforme fiscale.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: "Simulateur LMNP Réel vs Micro-BIC 2026 France",
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'All',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'EUR',
      },
      description: pageDescription,
      inLanguage: 'fr-FR',
      url: 'https://freeaccuratecalculator.com/countries/france/simulateur-lmnp-reel-micro-bic/',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://freeaccuratecalculator.com/' },
        { '@type': 'ListItem', position: 2, name: 'Pays', item: 'https://freeaccuratecalculator.com/countries/' },
        { '@type': 'ListItem', position: 3, name: 'France', item: 'https://freeaccuratecalculator.com/countries/france/' },
        { '@type': 'ListItem', position: 4, name: 'Fiscalité & Immobilier', item: 'https://freeaccuratecalculator.com/countries/france/guides/' },
        { '@type': 'ListItem', position: 5, name: 'Simulateur LMNP Réel vs Micro-BIC', item: 'https://freeaccuratecalculator.com/countries/france/simulateur-lmnp-reel-micro-bic/' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: "Pourquoi le régime réel LMNP est-il généralement plus avantageux que le Micro-BIC ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Le régime réel permet de déduire l'intégralité des charges réelles (intérêts d'emprunt, assurances, taxe foncière, travaux, frais de gestion) et surtout de pratiquer l'amortissement comptable de l'immeuble (hors terrain) et du mobilier. Cela crée un bouclier fiscal qui ramène souvent l'impôt et les prélèvements sociaux (17,2 %) à 0 € pendant 8 à 15 ans.",
          },
        },
        {
          '@type': 'Question',
          name: "Quel est le traitement fiscal du terrain en LMNP ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "En comptabilité immobilière française, le terrain n'est pas un actif qui se déprécie dans le temps. Une quote-part forfaitaire représentant 15 % à 20 % de la valeur globale du bien est donc exclue de la base amortissable. Seuls les 80 % à 85 % restants (le bâti) sont amortis par composants.",
          },
        },
        {
          '@type': 'Question',
          name: "Quelles sont les nouvelles règles d'abattement du Micro-BIC en 2026 ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Pour les baux meublés d'habitation principale (longue durée ou étudiant), l'abattement forfaitaire reste de 50 % jusqu'à 77 700 € de recettes. Pour les meublés de tourisme non classés en zone tendue, l'abattement a été abaissé à 30 % (plafond 15 000 €). Les meublés de tourisme classés conservent un abattement de 71 % jusqu'à 188 700 €.",
          },
        },
        {
          '@type': 'Question',
          name: "Que devient l'amortissement comptable non utilisé pendant une année ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "L'amortissement ne peut pas générer de déficit fiscal reportable sur votre revenu global. Cependant, les amortissements qui ne peuvent être déduits en raison de cette règle sont stockés en 'Amortissements Réputés Différés' (ARD) et restent reportables sans aucune limitation de durée sur les bénéfices locatifs des années futures.",
          },
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://freeaccuratecalculator.com/countries/france/simulateur-lmnp-reel-micro-bic/"
  jsonLd={jsonLd}
  lang="fr-FR"
  locale="fr"
>
  <div class="max-w-5xl mx-auto px-3 sm:px-6 py-4 sm:py-8 space-y-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400">Accueil</a>
      <span>/</span>
      <a href="/countries/" class="hover:text-emerald-600 dark:hover:text-emerald-400">Pays</a>
      <span>/</span>
      <a href="/countries/france/" class="hover:text-emerald-600 dark:hover:text-emerald-400">France</a>
      <span>/</span>
      <a href="/countries/france/guides/" class="hover:text-emerald-600 dark:hover:text-emerald-400">Fiscalité</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">Simulateur LMNP</span>
    </nav>

    <!-- Hero Title -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/50 dark:border-emerald-800/50">
        <span>Réglementation LMNP 2026</span>
        <span>•</span>
        <span>Amortissement par Composants</span>
        <span>•</span>
        <span>TMI + PS (17,2%)</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white font-outfit">
        Simulateur LMNP 2026 : Réel Simplifié vs Micro-BIC
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-3xl leading-relaxed">
        Déterminez avec précision le régime fiscal le plus avantageux pour votre investissement locatif meublé. Calculez l'amortissement comptable de l'immeuble, comparez vos impôts annuels et optimisez votre trésorerie nette.
      </p>
    </div>

    <!-- CALCULATOR CONTAINER -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      <!-- FORM INPUTS (7 cols) -->
      <div class="lg:col-span-7 bg-white dark:bg-slate-900/90 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 p-5 sm:p-7 shadow-sm space-y-5">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center justify-between">
          <span>1. Données du Projet Locatif</span>
          <span class="text-xs font-normal text-emerald-600 dark:text-emerald-400">Barème 2026</span>
        </h2>

        <!-- Type de location meublée -->
        <div class="space-y-1.5">
          <label for="lmnp-type" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Type d'Exploitation Meublée
          </label>
          <select
            id="lmnp-type"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-medium text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:outline-none cursor-pointer"
          >
            <option value="classique" selected>Bail d'habitation classique / Étudiant (Abattement Micro 50%)</option>
            <option value="tourisme-classe">Meublé de Tourisme Classé (Abattement Micro 71%)</option>
            <option value="tourisme-non-classe">Meublé de Tourisme Non Classé / Airbnb (Abattement Micro 30%)</option>
          </select>
        </div>

        <!-- Prix d'achat & Travaux -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="lmnp-price" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Prix d'Acquisition FAI (€)
            </label>
            <input
              type="number"
              id="lmnp-price"
              min="10000"
              max="5000000"
              step="5000"
              value="180000"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:outline-none"
            />
          </div>

          <div class="space-y-1.5">
            <label for="lmnp-furniture" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Mobilier & Équipements (€)
            </label>
            <input
              type="number"
              id="lmnp-furniture"
              min="0"
              max="100000"
              step="500"
              value="8000"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:outline-none"
            />
          </div>
        </div>

        <!-- Recettes Locatives -->
        <div class="space-y-1.5">
          <div class="flex justify-between items-center">
            <label for="lmnp-rent" class="text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Loyer Mensuel Hors Charges Perçu (€)
            </label>
            <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400" id="lmnp-rent-display">750 € / mois</span>
          </div>
          <div class="relative">
            <input
              type="number"
              id="lmnp-rent"
              min="100"
              max="20000"
              step="25"
              value="750"
              class="w-full px-3.5 py-2.5 pr-14 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:outline-none"
            />
            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-bold">€/mois</span>
          </div>
          <input type="range" id="lmnp-rent-range" min="200" max="3000" step="25" value="750" class="w-full accent-emerald-600 cursor-pointer" />
        </div>

        <!-- Charges Annuelles Déductibles -->
        <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/40 dark:bg-slate-800/20 space-y-3">
          <span class="text-xs font-bold text-slate-900 dark:text-white block">
            Charges Annuelles Déductibles au Régime Réel
          </span>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="space-y-1">
              <label for="lmnp-interests" class="text-slate-600 dark:text-slate-400">Intérêts d'emprunt + Assurance (€/an)</label>
              <input
                type="number"
                id="lmnp-interests"
                min="0"
                value="2800"
                class="w-full px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-semibold"
              />
            </div>

            <div class="space-y-1">
              <label for="lmnp-taxe-fonciere" class="text-slate-600 dark:text-slate-400">Taxe Foncière (€/an hors TEOM)</label>
              <input
                type="number"
                id="lmnp-taxe-fonciere"
                min="0"
                value="900"
                class="w-full px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-semibold"
              />
            </div>

            <div class="space-y-1">
              <label for="lmnp-copro" class="text-slate-600 dark:text-slate-400">Charges de Copro non récupérables (€/an)</label>
              <input
                type="number"
                id="lmnp-copro"
                min="0"
                value="600"
                class="w-full px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-semibold"
              />
            </div>

            <div class="space-y-1">
              <label for="lmnp-compta" class="text-slate-600 dark:text-slate-400">Comptabilité & Gestion (€/an)</label>
              <input
                type="number"
                id="lmnp-compta"
                min="0"
                value="450"
                class="w-full px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-semibold"
              />
            </div>
          </div>
        </div>

        <!-- TMI de l'investisseur -->
        <div class="space-y-1.5">
          <label for="lmnp-tmi" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Votre Tranche Marginale d'Imposition (TMI)
          </label>
          <select
            id="lmnp-tmi"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-sm font-medium text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:outline-none cursor-pointer"
          >
            <option value="0">0 % (Non imposable)</option>
            <option value="11">11 % (Revenus modestes / moyens)</option>
            <option value="30" selected>30 % (Revenus moyens supérieurs - TMI la plus fréquente)</option>
            <option value="41">41 % (Revenus élevés)</option>
            <option value="45">45 % (Tranche maximale)</option>
          </select>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">
            Les prélèvements sociaux de 17,2 % s'ajoutent systématiquement à votre TMI sur les bénéfices taxables.
          </p>
        </div>
      </div>

      <!-- RESULTS STICKY SUMMARY (5 cols) -->
      <div class="lg:col-span-5 space-y-5 lg:sticky lg:top-24">
        <div class="bg-gradient-to-br from-emerald-950 via-slate-900 to-slate-950 text-white rounded-2xl p-5 sm:p-7 shadow-xl border border-emerald-500/30 relative overflow-hidden">
          <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl"></div>

          <div class="space-y-4 relative z-10">
            <!-- WINNER BADGE -->
            <div id="lmnp-winner-badge" class="p-3 rounded-xl bg-emerald-500/20 border border-emerald-400/40 text-center">
              <span class="text-[11px] uppercase tracking-wider font-bold text-emerald-300 block">Verdict Fiscal</span>
              <div class="text-base font-extrabold text-white mt-0.5" id="lmnp-winner-text">
                Régime Réel Simplifié Vainqueur
              </div>
              <div class="text-xs text-emerald-200 mt-0.5">
                Économie annuelle : <strong id="lmnp-savings-display" class="text-white">1 850 € / an</strong>
              </div>
            </div>

            <!-- COMPARAISON 2 REGIMES -->
            <div class="grid grid-cols-2 gap-3 pt-2">
              <div class="p-3 rounded-xl bg-white/5 border border-white/10 text-center space-y-1">
                <span class="text-[11px] font-bold text-slate-400">Micro-BIC</span>
                <div class="text-xl font-bold font-mono text-white" id="lmnp-tax-micro">
                  2 124 €
                </div>
                <span class="text-[10px] text-slate-400 block">Impôt + PS / an</span>
              </div>

              <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-center space-y-1">
                <span class="text-[11px] font-bold text-emerald-300">Régime Réel</span>
                <div class="text-xl font-bold font-mono text-emerald-300" id="lmnp-tax-reel">
                  0 €
                </div>
                <span class="text-[10px] text-emerald-400 block">Impôt + PS / an</span>
              </div>
            </div>

            <!-- VENTILATION AMORTISSEMENT -->
            <div class="space-y-2 pt-3 border-t border-slate-800 text-xs">
              <div class="text-[11px] font-bold text-slate-300 flex justify-between">
                <span>Détail de l'Amortissement Annuel</span>
                <span class="font-mono text-emerald-300" id="lmnp-amort-total">6 540 € / an</span>
              </div>
              <div class="space-y-1 text-slate-300">
                <div class="flex justify-between">
                  <span>• Bâti amortissable (85% valeur)</span>
                  <span class="font-mono text-white" id="lmnp-amort-bati">4 940 €</span>
                </div>
                <div class="flex justify-between">
                  <span>• Mobilier (durée 5 ans - 20%)</span>
                  <span class="font-mono text-white" id="lmnp-amort-meubles">1 600 €</span>
                </div>
                <div class="flex justify-between text-slate-400">
                  <span>• Quote-part Terrain (15% non amortie)</span>
                  <span class="font-mono text-slate-400" id="lmnp-part-terrain">27 000 €</span>
                </div>
              </div>
            </div>

            <!-- RESULTAT FISCAL REEL -->
            <div class="p-3 rounded-xl bg-slate-800/60 border border-slate-700/60 text-xs space-y-1.5">
              <div class="flex justify-between text-slate-300">
                <span>Recettes Locatives Brutes :</span>
                <span class="font-bold text-white font-mono" id="lmnp-recettes-brutes">9 000 €</span>
              </div>
              <div class="flex justify-between text-slate-300">
                <span>Total Charges Déductibles :</span>
                <span class="font-bold text-white font-mono" id="lmnp-total-charges">4 750 €</span>
              </div>
              <div class="flex justify-between text-slate-300">
                <span>Amortissement imputé :</span>
                <span class="font-bold text-emerald-300 font-mono" id="lmnp-amort-impute">4 250 €</span>
              </div>
              <div class="flex justify-between text-slate-300 border-t border-slate-700 pt-1 font-semibold">
                <span>Résultat Fiscal Imposable :</span>
                <span class="font-bold text-emerald-400 font-mono" id="lmnp-resultat-fiscal">0 €</span>
              </div>
            </div>

            <!-- Actions -->
            <div class="pt-2">
              <button
                type="button"
                id="btn-print-lmnp"
                class="w-full py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition-colors flex items-center justify-center gap-2"
              >
                <span>🖨️</span> Exporter le Bilan Fiscal LMNP
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- GUIDE PEDAGOGIQUE LMNP (DWELL TIME & EXPERTISE) -->
    <article class="bg-white dark:bg-slate-900/90 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 p-6 sm:p-8 space-y-6 text-slate-800 dark:text-slate-200 leading-relaxed text-sm sm:text-base">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white font-outfit border-b border-slate-100 dark:border-slate-800 pb-3">
        Comment Fonctionne la Fiscalité LMNP en 2026 ?
      </h2>

      <div class="space-y-4">
        <p>
          Le statut de <strong>Loueur en Meublé Non Professionnel (LMNP)</strong> permet de générer des revenus locatifs sous le régime des Bénéfices Industriels et Commerciaux (BIC). Deux régimes s'affrontent : le <strong>Micro-BIC</strong> (forfaitaire) et le <strong>Régime Réel Simplifié</strong> (déduction des charges et amortissements).
        </p>

        <h3 class="text-lg font-bold text-slate-900 dark:text-white pt-2">
          1. Le Mécanisme Puissant de l'Amortissement par Composants
        </h3>
        <p>
          Contrairement à la location nue (revenus fonciers), le régime réel LMNP autorise la dépréciation comptable de l'immeuble. Les composants de l'actif sont ventilés selon les pratiques validées par l'administration fiscale :
        </p>
        <ul class="list-disc pl-5 space-y-1 text-slate-600 dark:text-slate-400 text-xs sm:text-sm">
          <li><strong>Gros œuvre (40 % du bâti) :</strong> Amorti sur 50 ans (taux de 2,0 % / an)</li>
          <li><strong>Façades et étanchéité (20 % du bâti) :</strong> Amortis sur 25 ans (taux de 4,0 % / an)</li>
          <li><strong>Installations techniques / Chauffage (20 % du bâti) :</strong> Amortis sur 15 ans (taux de 6,67 % / an)</li>
          <li><strong>Agencements intérieurs (20 % du bâti) :</strong> Amortis sur 10 ans (taux de 10,0 % / an)</li>
          <li><strong>Mobilier meublant :</strong> Amorti sur 5 ans (taux de 20,0 % / an)</li>
        </ul>

        <h3 class="text-lg font-bold text-slate-900 dark:text-white pt-2">
          2. La Règle des Amortissements Réputés Différés (ARD)
        </h3>
        <p>
          L'article 39 C du Code Général des Impôts stipule que l'amortissement ne peut pas créer de déficit fiscal. Si vos charges réelles (intérêts, taxe foncière, assurance) absorbent déjà une partie de vos recettes, le surplus d'amortissement non utilisé n'est pas perdu : il est placé dans une réserve d'ARD et reste utilisable sans limite de temps lors des exercices futurs où les charges diminueront.
        </p>
      </div>

      <!-- FAQ Accordions -->
      <div class="space-y-3 pt-4 border-t border-slate-100 dark:border-slate-800">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">
          Foire Aux Questions : LMNP & Fiscalité
        </h3>

        <details class="group rounded-xl border border-slate-200 dark:border-slate-800 p-3.5 bg-slate-50/50 dark:bg-slate-800/40">
          <summary class="font-bold text-slate-900 dark:text-white cursor-pointer list-none flex justify-between items-center text-sm">
            <span>Faut-il obligatoirement un expert-comptable pour déclarer au réel ?</span>
            <span class="text-emerald-600 dark:text-emerald-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2">
            Bien que non obligatoire, le recours à un cabinet comptable ou un logiciel spécialisé LMNP est vivement recommandé pour établir la liasse fiscale 2031/2033 et le tableau d'amortissement. De plus, les frais de comptabilité et d'adhésion à un Organisme de Gestion Agréé (OGA) sont déductibles ou ouvrent droit à une réduction d'impôt des deux tiers des dépenses.
          </p>
        </details>

        <details class="group rounded-xl border border-slate-200 dark:border-slate-800 p-3.5 bg-slate-50/50 dark:bg-slate-800/40">
          <summary class="font-bold text-slate-900 dark:text-white cursor-pointer list-none flex justify-between items-center text-sm">
            <span>Quelle est la date limite pour opter pour le régime réel ?</span>
            <span class="text-emerald-600 dark:text-emerald-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2">
            L'option pour le régime réel simplifié doit être formulée auprès du service des impôts des entreprises (SIE) avant la date limite de dépôt de la déclaration d'ensemble des revenus de l'année précédente (généralement en mai/juin). Elle est reconduite tacitement chaque année.
          </p>
        </details>
      </div>
    </article>

    <!-- PROJETS CONNEXES -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
      <a
        href="/countries/france/frais-de-notaire/"
        class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-emerald-500 transition-all group"
      >
        <div class="text-xl mb-1">⚖️</div>
        <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400">
          Frais de Notaire 2026
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Calculez vos droits de mutation et économisez sur le mobilier.
        </p>
      </a>

      <a
        href="/countries/france/capacite-emprunt-hcsf/"
        class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-emerald-500 transition-all group"
      >
        <div class="text-xl mb-1">🏦</div>
        <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400">
          Capacité d'Emprunt HCSF
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Testez votre taux d'effort maximal de 35% avec revenus locatifs à 70%.
        </p>
      </a>

      <a
        href="/countries/france/taxe-amenagement/"
        class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-emerald-500 transition-all group"
      >
        <div class="text-xl mb-1">🏗️</div>
        <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400">
          Taxe d'Aménagement
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Simulateur officiel de taxes d'urbanisme et abris de jardin.
        </p>
      </a>
    </div>
  </div>

  <script is:inline>
    (function () {
      const typeSelect = document.getElementById('lmnp-type');
      const priceInput = document.getElementById('lmnp-price');
      const furnitureInput = document.getElementById('lmnp-furniture');
      const rentInput = document.getElementById('lmnp-rent');
      const rentRange = document.getElementById('lmnp-rent-range');
      const rentDisplay = document.getElementById('lmnp-rent-display');

      const interestsInput = document.getElementById('lmnp-interests');
      const tfInput = document.getElementById('lmnp-taxe-fonciere');
      const coproInput = document.getElementById('lmnp-copro');
      const comptaInput = document.getElementById('lmnp-compta');
      const tmiSelect = document.getElementById('lmnp-tmi');

      const winnerBadge = document.getElementById('lmnp-winner-badge');
      const winnerText = document.getElementById('lmnp-winner-text');
      const savingsDisplay = document.getElementById('lmnp-savings-display');
      const taxMicroDisplay = document.getElementById('lmnp-tax-micro');
      const taxReelDisplay = document.getElementById('lmnp-tax-reel');

      const amortTotal = document.getElementById('lmnp-amort-total');
      const amortBati = document.getElementById('lmnp-amort-bati');
      const amortMeubles = document.getElementById('lmnp-amort-meubles');
      const partTerrain = document.getElementById('lmnp-part-terrain');

      const recettesBrutesDisplay = document.getElementById('lmnp-recettes-brutes');
      const totalChargesDisplay = document.getElementById('lmnp-total-charges');
      const amortImputeDisplay = document.getElementById('lmnp-amort-impute');
      const resultatFiscalDisplay = document.getElementById('lmnp-resultat-fiscal');

      const formatEuro = (val) => new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(val);

      function calculate() {
        const price = parseFloat(priceInput.value) || 0;
        const furniture = parseFloat(furnitureInput.value) || 0;
        const monthlyRent = parseFloat(rentInput.value) || 0;
        const annualRent = monthlyRent * 12;

        const interests = parseFloat(interestsInput.value) || 0;
        const tf = parseFloat(tfInput.value) || 0;
        const copro = parseFloat(coproInput.value) || 0;
        const compta = parseFloat(comptaInput.value) || 0;
        const totalDeductibleCharges = interests + tf + copro + compta;

        const tmi = (parseFloat(tmiSelect.value) || 0) / 100;
        const globalTaxRate = tmi + 0.172; // TMI + 17.2% Prélèvements sociaux
        const lmnpType = typeSelect.value;

        // 1. Calcul Micro-BIC
        let microAbattement = 0.50;
        if (lmnpType === 'tourisme-classe') {
          microAbattement = 0.71;
        } else if (lmnpType === 'tourisme-non-classe') {
          microAbattement = 0.30;
        }
        const microTaxableBase = Math.max(0, annualRent * (1 - microAbattement));
        const microTotalTax = Math.round(microTaxableBase * globalTaxRate);

        // 2. Calcul Amortissement Réel
        const terrainQuote = price * 0.15;
        const batiQuote = price * 0.85;

        // Décomposition composants bâti :
        // Gros oeuvre (40% - 50 ans / 2%) = batiQuote * 0.40 * 0.02
        // Facades (20% - 25 ans / 4%) = batiQuote * 0.20 * 0.04
        // Tech (20% - 15 ans / 6.67%) = batiQuote * 0.20 * 0.0667
        // Agencements (20% - 10 ans / 10%) = batiQuote * 0.20 * 0.10
        const annualBatiAmort = (batiQuote * 0.40 * 0.02) + (batiQuote * 0.20 * 0.04) + (batiQuote * 0.20 * 0.0667) + (batiQuote * 0.20 * 0.10);
        const annualFurnitureAmort = furniture * 0.20; // 5 ans
        const totalAnnualAmort = annualBatiAmort + annualFurnitureAmort;

        // 3. Calcul Résultat Fiscal Réel
        // Charges déduites en priorité
        const marginBeforeAmort = Math.max(0, annualRent - totalDeductibleCharges);
        const amortImpute = Math.min(marginBeforeAmort, totalAnnualAmort);
        const resultatFiscal = Math.max(0, annualRent - totalDeductibleCharges - amortImpute);
        const reelTotalTax = Math.round(resultatFiscal * globalTaxRate);

        // Comparaison et économie
        const savings = microTotalTax - reelTotalTax;

        // Mise à jour de l'UI
        rentDisplay.textContent = `${formatEuro(monthlyRent)} / mois`;
        taxMicroDisplay.textContent = formatEuro(microTotalTax);
        taxReelDisplay.textContent = formatEuro(reelTotalTax);

        amortTotal.textContent = `${formatEuro(totalAnnualAmort)} / an`;
        amortBati.textContent = formatEuro(annualBatiAmort);
        amortMeubles.textContent = formatEuro(annualFurnitureAmort);
        partTerrain.textContent = formatEuro(terrainQuote);

        recettesBrutesDisplay.textContent = formatEuro(annualRent);
        totalChargesDisplay.textContent = formatEuro(totalDeductibleCharges);
        amortImputeDisplay.textContent = formatEuro(amortImpute);
        resultatFiscalDisplay.textContent = formatEuro(resultatFiscal);

        if (savings >= 0) {
          winnerText.textContent = 'Régime Réel Simplifié Vainqueur';
          savingsDisplay.textContent = `${formatEuro(savings)} / an d'économie`;
          winnerBadge.className = 'p-3 rounded-xl bg-emerald-500/20 border border-emerald-400/40 text-center';
        } else {
          winnerText.textContent = 'Régime Micro-BIC Plus Avantageux';
          savingsDisplay.textContent = `${formatEuro(Math.abs(savings))} / an d'économie`;
          winnerBadge.className = 'p-3 rounded-xl bg-amber-500/20 border border-amber-400/40 text-center';
        }
      }

      rentInput.addEventListener('input', () => {
        rentRange.value = rentInput.value;
        calculate();
      });

      rentRange.addEventListener('input', () => {
        rentInput.value = rentRange.value;
        calculate();
      });

      [typeSelect, priceInput, furnitureInput, interestsInput, tfInput, coproInput, comptaInput, tmiSelect].forEach((el) => {
        el.addEventListener('input', calculate);
        el.addEventListener('change', calculate);
      });

      document.getElementById('btn-print-lmnp')?.addEventListener('click', () => {
        window.print();
      });

      calculate();
    })();
  </script>
</Layout>

    let activeDropdownIndex = -1;
    let currentDropdownMatches = [];

    function escapeHtml(str) {
      return (str || '').replace(/[&<>"']/g, (m) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      }[m]));
    }

    function removeAccents(str) {
      return (str || '').normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    }

    function openDropdown() {
      if (!dirDropdown) return;
      dirDropdown.classList.remove('opacity-0', 'scale-95', 'pointer-events-none', 'invisible');
      dirDropdown.classList.add('opacity-100', 'scale-100', 'pointer-events-auto', 'visible');
      if (searchInput) searchInput.setAttribute('aria-expanded', 'true');
    }

    function closeDropdown() {
      if (!dirDropdown) return;
      dirDropdown.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto', 'visible');
      dirDropdown.classList.add('opacity-0', 'scale-95', 'pointer-events-none', 'invisible');
      activeDropdownIndex = -1;
      if (searchInput) searchInput.setAttribute('aria-expanded', 'false');
    }

    function highlightMatch(text, query) {
      if (!query || !text) return escapeHtml(text);
      const cleanT = removeAccents(text.toLowerCase());
      const cleanQ = removeAccents(query.toLowerCase());
      const idx = cleanT.indexOf(cleanQ);
      if (idx === -1) return escapeHtml(text);
      const before = escapeHtml(text.slice(0, idx));
      const matched = escapeHtml(text.slice(idx, idx + query.length));
      const after = escapeHtml(text.slice(idx + query.length));
      return `${before}<span class="font-black text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/80 rounded px-0.5">${matched}</span>${after}`;
    }

    function updateActiveDropdownItem() {
      if (!dirDropdownList) return;
      const items = dirDropdownList.querySelectorAll('.fac-dir-suggestion');
      items.forEach((item, idx) => {
        if (idx === activeDropdownIndex) {
          item.classList.add('bg-indigo-50', 'dark:bg-indigo-950/70', 'ring-1', 'ring-indigo-500/30');
          item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } else {
          item.classList.remove('bg-indigo-50', 'dark:bg-indigo-950/70', 'ring-1', 'ring-indigo-500/30');
        }
      });
    }

    function filterTools(query) {
      const q = (query || '').toLowerCase().trim();
      const cleanQ = removeAccents(q);
      const isEn = currentLang === 'en';

      if (clearBtn) {
        if (q.length > 0) clearBtn.classList.remove('hidden');
        else clearBtn.classList.add('hidden');
      }

      // 1. Filter local on-page cards
      let matchCount = 0;
      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const titleEn = card.getAttribute('data-title-en') || '';
        const shortTitle = card.getAttribute('data-short-title') || '';
        const desc = card.getAttribute('data-description') || '';
        const cat = card.getAttribute('data-category') || '';
        const badge = card.getAttribute('data-badge') || '';
        const keywords = card.getAttribute('data-search') || '';

        const fullHaystack = `${title} ${titleEn} ${shortTitle} ${desc} ${cat} ${badge} ${keywords}`.toLowerCase();
        const cleanHaystack = removeAccents(fullHaystack);

        const isMatch = !q || fullHaystack.includes(q) || cleanHaystack.includes(cleanQ);

        if (isMatch) {
          card.classList.remove('hidden');
          card.style.display = 'flex';
          matchCount++;
        } else {
          card.classList.add('hidden');
          card.style.display = 'none';
        }
      });

      if (noResultsDiv) {
        if (matchCount === 0 && q.length > 0) {
          noResultsDiv.classList.remove('hidden');
        } else {
          noResultsDiv.classList.add('hidden');
        }
      }

      // 2. Compute live suggestions
      if (!q) {
        closeDropdown();
        return;
      }

      const scored = [];
      for (const item of allSearchableTools) {
        const nameFr = (item.nameFr || '').toLowerCase();
        const nameEn = (item.nameEn || '').toLowerCase();
        const shortFr = (item.shortNameFr || '').toLowerCase();
        const keywords = (item.searchKeywords || '').toLowerCase();
        const catFr = (item.categoryFr || '').toLowerCase();

        const cleanNameFr = removeAccents(nameFr);
        const cleanShortFr = removeAccents(shortFr);
        const cleanKeywords = removeAccents(keywords);

        let score = 0;
        if (nameFr === q || nameEn === q || cleanNameFr === cleanQ) score += 100;
        else if (cleanNameFr.startsWith(cleanQ) || nameEn.startsWith(q) || cleanShortFr.startsWith(cleanQ)) score += 80;
        else if (cleanNameFr.includes(` ${cleanQ}`) || nameEn.includes(` ${q}`)) score += 60;
        else if (cleanNameFr.includes(cleanQ) || nameEn.includes(q)) score += 40;
        else if (cleanKeywords.includes(cleanQ)) score += 35;
        else if (catFr.includes(cleanQ)) score += 20;

        if (score > 0) {
          scored.push({ ...item, score });
        }
      }

      scored.sort((a, b) => b.score - a.score);
      currentDropdownMatches = scored.slice(0, 7);
      activeDropdownIndex = -1;

      if (currentDropdownMatches.length > 0) {
        if (dirNoResultsPanel) dirNoResultsPanel.classList.add('hidden');
        if (dirDropdownList) {
          dirDropdownList.innerHTML = currentDropdownMatches
            .map((item, idx) => {
              const name = isEn ? (item.nameEn || item.nameFr) : item.nameFr;
              const cat = isEn ? (item.categoryEn || item.categoryFr) : item.categoryFr;
              const openText = isEn ? 'Open ↗' : 'Ouvrir ↗';
              const highlighted = highlightMatch(name, q);

              return `
                <a
                  href="${escapeHtml(item.href)}"
                  class="fac-dir-suggestion flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-xl hover:bg-indigo-50/80 dark:hover:bg-indigo-950/50 border border-transparent hover:border-indigo-200/50 dark:hover:border-indigo-800/50 transition-colors group cursor-pointer"
                  data-index="${idx}"
                >
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="text-base sm:text-lg shrink-0">${item.icon || '🧮'}</span>
                    <div class="min-w-0">
                      <div class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 truncate">
                        ${highlighted}
                      </div>
                      <div class="text-[10px] text-slate-400 dark:text-slate-500 truncate">
                        ${escapeHtml(cat)}
                      </div>
                    </div>
                  </div>
                  <div class="flex items-center gap-1.5 shrink-0">
                    <span class="text-[9px] font-mono font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                      ${openText}
                    </span>
                  </div>
                </a>
              `;
            })
            .join('');
        }
        openDropdown();
      } else {
        if (dirDropdownList) dirDropdownList.innerHTML = '';
        if (dirNoResultsPanel) dirNoResultsPanel.classList.remove('hidden');
        openDropdown();
      }
    }


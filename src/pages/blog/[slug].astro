---
// src/pages/blog/[slug].astro
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import FAQSection from '../../components/calculator/FAQSection.astro';
import { calculateReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('guides');
  return posts
    .filter((post) => post.data.lang === 'en' && !post.id.includes('/'))
    .map((post) => ({
      params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
      props: { post },
    }));
}

interface Props {
  post: any;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const readingMinutes = calculateReadingTime(post.body || '');
---

<Layout
  title={`${post.data.title} | Free Accurate Calculator Blog`}
  description={post.data.description}
  canonicalUrl={`https://freeaccuratecalculator.com/blog/${post.id.replace(/\.(md|mdx)$/, '')}/`}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 md:py-12 space-y-8">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Blog', href: '/guides/' },
        { label: post.data.title, href: Astro.url.pathname },
      ]}
    />

    <header class="space-y-4 border-b border-hairline pb-6">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-mono font-semibold uppercase bg-link/10 text-link">
        {post.data.category}
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight">{post.data.title}</h1>
      <div class="flex items-center gap-4 text-xs font-mono text-mute">
        <span>By {post.data.author}</span>
        <span>•</span>
        <span>{readingMinutes} min read</span>
        <span>•</span>
        <span>Updated 2026</span>
      </div>
    </header>

    <!-- Embedded Interactive CTA for Target Calculator -->
    {post.data.targetCalculator && (
      <div class="rounded-xl border border-link/30 bg-link/5 p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs font-mono font-bold text-link uppercase tracking-wider block mb-1">
            Featured Interactive Tool
          </span>
          <h3 class="text-base font-bold text-ink">{post.data.targetCalculator.name}</h3>
          <p class="text-xs text-mute mt-0.5">{post.data.targetCalculator.description}</p>
        </div>
        <a
          href={post.data.targetCalculator.href}
          class="shrink-0 min-h-[44px] px-5 py-2.5 rounded-lg bg-link text-white font-medium text-xs flex items-center gap-2 hover:opacity-95 transition-opacity"
        >
          <span>Calculate Now</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <div class="lg:col-span-3 prose prose-slate dark:prose-invert max-w-none text-ink leading-relaxed">
        <Content />
      </div>

      <aside class="hidden lg:block space-y-6">
        <TableOfContents headings={headings} />
      </aside>
    </div>

    {post.data.faqs && post.data.faqs.length > 0 && (
      <div class="pt-8 border-t border-hairline">
        <FAQSection faqs={post.data.faqs} />
      </div>
    )}
  </div>
</Layout>

    description: 'Calculate home, car, and personal loan EMIs with reducing balance interest.',
    subGroup: 'Loans',
  },
  {
    id: 'mortgage-calculator',
    name: 'Mortgage Calculator',
    shortName: 'Mortgage',
    icon: '🏠',
    href: '/finance/mortgage-calculator/',

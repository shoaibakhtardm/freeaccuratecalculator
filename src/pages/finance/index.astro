  },
  {
    id: 'step-up-sip-calculator',
    name: 'Step-Up SIP Calculator',
    shortName: 'Step-Up SIP',
    icon: '🚀',
    href: '/finance/step-up-sip-calculator/',
    badge: 'Annual Boost',
    description: 'Factor annual investment percentage increments into future SIP wealth.',
    subGroup: 'SIP',
  },
  {
    id: 'lumpsum-calculator',
    name: 'Lumpsum Calculator',
    shortName: 'Lumpsum',
    icon: '💰',
    href: '/finance/lumpsum-calculator/',
    badge: 'One-Time',
    description: 'One-time capital investment returns compounded over your horizon.',
    subGroup: 'SIP',
  },

  // Row 4: Interest Mathematics
  {
    id: 'compound-interest-calculator',
    name: 'Compound Interest',
    shortName: 'Compound Int',
    icon: '⏳',
    href: '/finance/compound-interest-calculator/',
    badge: 'Daily to Annual',
    description: 'Compound interest calculated across daily, monthly, or annual intervals.',
    subGroup: 'Interest',
  },
  {
    id: 'simple-interest-calculator',
    name: 'Simple Interest',
    shortName: 'Simple Int',
    icon: '⏱️',
    href: '/finance/simple-interest-calculator/',
    badge: 'Direct APR',
    description: 'Straight-line simple interest on principal without compounding.',
    subGroup: 'Interest',
  },
  {
    id: 'interest-rate-calculator',
    name: 'Interest Rate Calculator',
    shortName: 'Interest Rate',
    icon: '📉',

---
// src/pages/finance/index.astro
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { SEARCHABLE_CALCULATORS } from '../../data/searchDatabase';

const allSearchableToolsJson = JSON.stringify(SEARCHABLE_CALCULATORS);

// 27 Pure Finance Calculators arranged in strict 3-by-3 structure (3 columns × 9 rows = 27)
const FINANCE_CALCULATORS = [
  // Row 1: Core Loans
  {
    id: 'emi-calculator',

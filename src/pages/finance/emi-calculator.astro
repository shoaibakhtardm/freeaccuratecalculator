    <!-- Step-by-Step Mathematical Proof -->
    <div class="border-t border-hairline pt-4 print:hidden">
      <details class="group rounded-[8px] border border-hairline bg-canvas">
        <summary class="flex min-h-[44px] items-center justify-between p-3.5 cursor-pointer list-none text-xs font-semibold text-ink hover:text-link transition-colors">
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
            <span class="pr-2">Step-by-Step Mathematical Proof (Formula Substitution)</span>
          </span>
          <span class="text-xs text-mute group-open:rotate-180 transition-transform">▼</span>
        </summary>

        <div class="p-3.5 pt-0 space-y-4 font-mono text-xs text-body" id="proof-container">
          <p class="text-mute leading-relaxed">Reducing balance amortization evaluates loan payments through the following exact closed-form algebraic formula:</p>
          <div class="rounded-[6px] border border-hairline bg-canvas-elevated p-3 text-center text-ink font-semibold">
            E = [ P × r × (1 + r)ⁿ ] ÷ [ (1 + r)ⁿ - 1 ]
          </div>
          <div id="proof-steps-body" class="space-y-3 divide-y divide-hairline-soft"></div>
        </div>
      </details>
    </div>

    <!-- History Drawer -->
    <HistoryDrawer calculatorId="emi" />
  </div>

  <!-- Toast -->
  <div
    id="emi-toast"
    class="fixed bottom-5 right-5 z-50 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-200 ease-out flex items-center gap-2 px-4 py-2.5 rounded-[8px] bg-slate-900 text-white text-xs font-mono shadow-lg border border-slate-700"
  >
    <svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span id="emi-toast-message">Copied!</span>
  </div>

  <!-- Educational Deep-Dive Content -->
  <div id="emi-bottom-content" class="space-y-8 mt-6 print:hidden">
    <FormulaSection
      formula="E = P × r × (1 + r)ⁿ ÷ ((1 + r)ⁿ - 1)"
      explanation="The equated monthly installment (EMI) formula calculates equal payments over the repayment schedule using the reducing balance method. With each monthly installment, interest is evaluated solely on the remaining balance."
      variables={[
        { symbol: 'E', meaning: 'Equated Monthly Installment (EMI)' },
        { symbol: 'P', meaning: 'Principal loan amount borrowed' },
        { symbol: 'r', meaning: 'Monthly interest rate = (Annual Rate ÷ 12 ÷ 100)' },
        { symbol: 'n', meaning: 'Total number of monthly installments (Years × 12)' },
      ]}
    />

    <WorkedExample
      title="Worked Example: Home Loan Calculation"
      scenario="You take a Home Loan of ₹25,00,000 ($25 Lakhs) at an annual interest rate of 8.5% for a tenure of 20 years (240 months)."
      steps={[
        {
          number: 1,
          title: 'Determine the monthly interest rate (r)',
          description: 'Divide the 8.5% annual rate by 12 months, then by 100.',
          mathExpression: 'r = 8.5 ÷ 12 ÷ 100 = 0.0070833',
        },
        {
          number: 2,
          title: 'Compute the compounding factor (1 + r)ⁿ',
          description: 'Compound over 240 months: (1 + 0.0070833)²⁴⁰ ≈ 5.4274.',
          mathExpression: '(1 + 0.0070833)²⁴⁰ = 5.4274',
        },
        {
          number: 3,
          title: 'Calculate monthly EMI',
          description: 'E = ₹25,00,000 × 0.0070833 × 5.4274 ÷ (5.4274 - 1).',
          mathExpression: 'E = ₹21,696 per month',
        },
        {
          number: 4,
          title: 'Compute total interest over 20 years',
          description: 'Total Payment = 240 × ₹21,696 = ₹52,06,935. Total Interest = ₹52,06,935 - ₹25,00,000.',
          mathExpression: 'Total Interest = ₹27,06,935',
        },
      ]}
      conclusion="Your monthly EMI is ₹21,696. Across 20 years, total interest paid is ₹27,06,935, totaling ₹52,06,935 in lifetime payments."
    />

    <!-- Download & Export Section Card (SIP Standard) -->
    <div id="emi-bottom-export-wrapper" class="rounded-[16px] border border-hairline bg-canvas-elevated p-6 sm:p-8 space-y-4 shadow-whisper">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-5">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-link/10 text-link">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </span>
            <h3 class="text-base sm:text-lg font-bold text-ink tracking-tight font-display">Download EMI Loan Statement & Amortization Schedule</h3>
          </div>
          <p class="text-xs sm:text-sm text-mute leading-relaxed max-w-2xl">
            Instantly export your personalized loan payoff schedule, monthly and annual amortization breakdown, and prepayment interest savings in your preferred format.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-1 text-[11px] font-mono text-mute">
            <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-semibold">
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Excel / Google Sheets (.csv)
            </span>
            <span>•</span>
            <span class="inline-flex items-center gap-1 text-link font-semibold">
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Printable PDF Statement
            </span>

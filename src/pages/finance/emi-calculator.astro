              <button id="amort-tab-yearly" type="button" aria-label="Show Yearly Amortization Breakdown" aria-pressed="true" class="rounded-[4px] bg-primary px-3 py-1 min-h-[32px] sm:min-h-[26px] text-on-primary cursor-pointer transition-colors">Yearly Breakdown</button>
              <button id="amort-tab-monthly" type="button" aria-label="Show Monthly Amortization Breakdown" aria-pressed="false" class="rounded-[4px] px-3 py-1 min-h-[32px] sm:min-h-[26px] text-ink hover:text-ink cursor-pointer transition-colors">Monthly Breakdown</button>
            </div>

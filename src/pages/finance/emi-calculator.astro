    }
    header, footer, nav, aside,
    .breadcrumbs-container, #smart-email-modal, #country-modal,
    .ad-slot-container, .fac-copy-result-btn, #history-drawer, #history-drawer-backdrop {
      display: none !important;
    }
    #emi-social-proof, #emi-bottom-content, .print\:hidden {
      display: none !important;
    }
    .emi-main-box {
      border: none !important;
      background: transparent !important;
      box-shadow: none !important;
      padding: 0 !important;
    }
    body * { visibility: hidden !important; }
    #emi-print-report, #emi-print-report * { visibility: visible !important; }
    #emi-print-report {
      display: block !important;
      position: absolute !important;
      left: 0 !important; top: 0 !important;
      width: 100% !important;
      background: #ffffff !important;
      color: #0f172a !important;
      padding: 20px 24px !important;
      box-sizing: border-box !important;
    }
    #emi-print-report table { width: 100% !important; border-collapse: collapse !important; }
    #emi-print-report th, #emi-print-report td { border: 1px solid #cbd5e1 !important; padding: 5px 8px !important; }
    #emi-print-report th { background-color: #f1f5f9 !important; font-weight: 700 !important; }
    #emi-print-report tr { page-break-inside: avoid !important; }
    @page { size: A4 portrait; margin: 10mm 12mm; }
  }
</style>

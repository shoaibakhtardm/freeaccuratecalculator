</CalculatorLayout>

<script>
  import { parseSmartInput } from '../../utils/smartParser';
  import { calculateAdvancedEMI, generateEMIProof, verifyMath } from '../../utils/financialMath';

  declare const window: any;

  (function () {
    const activeCode = typeof window.facGetActiveCurrency === 'function'
      ? window.facGetActiveCurrency()
      : (new URLSearchParams(window.location.search).get('currency') || localStorage.getItem('fac_currency') || 'USD');
    const activeInfo = typeof window.facGetCurrencyInfo === 'function'
      ? window.facGetCurrencyInfo(activeCode)
      : { symbol: activeCode === 'INR' ? '₹' : '$', isIndian: activeCode === 'INR' };

    let currentCurrencySymbol = activeInfo?.symbol || (activeCode === 'INR' ? '₹' : '$');
    let isIndianFormat = activeInfo ? !!activeInfo.isIndian : (activeCode === 'INR');
    let tenureIsYears = true;
    let scheduleTabMode: 'yearly' | 'monthly' = 'yearly';

    const principalInput = document.getElementById('emi-principal') as HTMLInputElement | null;
    const principalSlider = document.getElementById('emi-principal-slider') as HTMLInputElement | null;
    const principalDisplay = document.getElementById('principal-display');
    const principalSymbol = document.getElementById('principal-symbol');

    const rateInput = document.getElementById('emi-rate') as HTMLInputElement | null;
    const rateSlider = document.getElementById('emi-rate-slider') as HTMLInputElement | null;
    const rateDisplay = document.getElementById('rate-display');

    const tenureInput = document.getElementById('emi-tenure') as HTMLInputElement | null;
    const tenureSlider = document.getElementById('emi-tenure-slider') as HTMLInputElement | null;
    const tenureDisplay = document.getElementById('tenure-display');

    const extraInput = document.getElementById('emi-extra') as HTMLInputElement | null;
    const extraSlider = document.getElementById('emi-extra-slider') as HTMLInputElement | null;
    const extraDisplay = document.getElementById('extra-display');
    const extraSymbol = document.getElementById('extra-symbol');

    const extraSavingsPanel = document.getElementById('extra-savings-panel');
    const savingsInterestText = document.getElementById('savings-interest-text');
    const savingsTimeText = document.getElementById('savings-time-text');
    const savingsNewTenureText = document.getElementById('savings-new-tenure-text');
    const savingsPctContainer = document.getElementById('savings-pct-container');
    const savingsPctLabel = document.getElementById('savings-pct-label');
    const tenureYrBtn = document.getElementById('tenure-yr-btn');
    const tenureMoBtn = document.getElementById('tenure-mo-btn');
    const formatStdBtn = document.getElementById('format-standard-btn');
    const formatIndBtn = document.getElementById('format-indian-btn');
    const amortTabYearly = document.getElementById('amort-tab-yearly');
    const amortTabMonthly = document.getElementById('amort-tab-monthly');
    const scheduleCounterBadge = document.getElementById('schedule-counter-badge');
    const thExtra = document.getElementById('th-extra');
    const barPrincipal = document.getElementById('bar-principal');
    const barInterest = document.getElementById('bar-interest');
    const principalPctLabel = document.getElementById('principal-pct-label');
    const interestPctLabel = document.getElementById('interest-pct-label');
    const amortTableBody = document.getElementById('amortization-table-body');
    const proofStepsBody = document.getElementById('proof-steps-body');
    const printScheduleBody = document.getElementById('emi-print-schedule-body');

    // Toast
    const toastEl = document.getElementById('emi-toast');
    const toastMsg = document.getElementById('emi-toast-message');
    let toastTimeout: any = null;
    function showToast(msg: string) {
      if (!toastEl || !toastMsg) return;
      toastMsg.textContent = msg;
      toastEl.classList.remove('opacity-0', 'translate-y-12', 'pointer-events-none');
      toastEl.classList.add('opacity-100', 'translate-y-0');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toastEl.classList.remove('opacity-100', 'translate-y-0');
        toastEl.classList.add('opacity-0', 'translate-y-12', 'pointer-events-none');
      }, 2500);
    }

    let currentCalculationData: ReturnType<typeof calculateAdvancedEMI> | null = null;

    function formatVal(num: number, decimals: number = 0): string {
      if ((window as any).facFormatNumber) {
        return (window as any).facFormatNumber(num, decimals, isIndianFormat);
      }
      return num.toLocaleString();
    }

    function calculate() {
      const pParsed = parseSmartInput(principalInput?.value || '0');
      const P = isNaN(pParsed) ? 0 : pParsed;
      const annualRate = parseFloat(rateInput?.value || '0');
      const tenureVal = parseFloat(tenureInput?.value || '0');
      const extraParsed = parseSmartInput(extraInput?.value || '0');
      const extraMonthly = isNaN(extraParsed) ? 0 : extraParsed;
      const totalMonths = tenureIsYears ? Math.round(tenureVal * 12) : Math.round(tenureVal);

      if (principalDisplay) principalDisplay.textContent = `${currentCurrencySymbol} ${formatVal(P, 0)}`;
      if (rateDisplay) rateDisplay.textContent = `${annualRate.toFixed(2)}%`;
      if (extraDisplay) extraDisplay.textContent = `${currentCurrencySymbol} ${formatVal(extraMonthly, 0)}`;
      if (tenureDisplay) {
        if (tenureIsYears) {
          tenureDisplay.textContent = `${tenureVal} Years (${totalMonths} Mo)`;
        } else {
          tenureDisplay.textContent = `${tenureVal} Months (${(tenureVal / 12).toFixed(1)} Yr)`;
        }
      }

      if (P <= 0 || isNaN(annualRate) || totalMonths <= 0) return;

      const res = calculateAdvancedEMI(P, annualRate, totalMonths, extraMonthly);
      currentCalculationData = res;

      if ((window as any).facAnimateNumber) {
        (window as any).facAnimateNumber('emi-monthly-result', res.regularEMI, { isIndian: isIndianFormat, decimals: 0 });
        (window as any).facAnimateNumber('emi-interest-result', res.totalInterestWithPrepayment, { isIndian: isIndianFormat, decimals: 0 });
        (window as any).facAnimateNumber('emi-total-result', res.totalPaymentWithPrepayment, { isIndian: isIndianFormat, decimals: 0 });
      }

      if (extraMonthly > 0 && res.interestSaved > 0) {
        if (extraSavingsPanel) extraSavingsPanel.classList.remove('hidden');
        if (savingsInterestText) savingsInterestText.textContent = `${currentCurrencySymbol} ${formatVal(res.interestSaved, 0)}`;
        if (savingsTimeText) {
          const yrs = Math.floor(res.monthsSaved / 12);
          const mos = res.monthsSaved % 12;
          savingsTimeText.textContent = yrs > 0 ? `${yrs} Yrs ${mos} Mo (${res.monthsSaved} Mo)` : `${mos} Months`;
        }
        if (savingsNewTenureText) {
          const actualYrs = (res.actualTenureMonths / 12).toFixed(1);
          savingsNewTenureText.textContent = `${actualYrs} Years (${res.actualTenureMonths} Mo)`;
        }
        if (savingsPctContainer && savingsPctLabel) {
          savingsPctContainer.classList.remove('hidden');
          savingsPctLabel.textContent = `${res.savingsRatio}%`;
        }
        if (thExtra) thExtra.classList.remove('hidden');
      } else {
        if (extraSavingsPanel) extraSavingsPanel.classList.add('hidden');
        if (savingsPctContainer) savingsPctContainer.classList.add('hidden');
        if (thExtra) thExtra.classList.add('hidden');
      }

      if (barPrincipal) barPrincipal.style.width = `${res.principalRatio}%`;
      if (barInterest) barInterest.style.width = `${res.interestRatio}%`;
      if (principalPctLabel) principalPctLabel.textContent = `${res.principalRatio}%`;
      if (interestPctLabel) interestPctLabel.textContent = `${res.interestRatio}%`;

      renderAmortizationTable();
      renderProof(P, annualRate, totalMonths, res.regularEMI, extraMonthly, res.interestSaved);

      // Update print metadata
      const printDate = document.getElementById('emi-print-date');
      const printCurr = document.getElementById('emi-print-currency');
      const printPrincipal = document.getElementById('emi-print-principal');
      const printRate = document.getElementById('emi-print-rate');
      const printTenure = document.getElementById('emi-print-tenure');
      const printEmi = document.getElementById('emi-print-emi');
      const printInterest = document.getElementById('emi-print-interest');
      const printTotal = document.getElementById('emi-print-total');

      if (printDate) printDate.textContent = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      if (printCurr) printCurr.textContent = activeCode;
      if (printPrincipal) printPrincipal.textContent = `${currentCurrencySymbol} ${formatVal(P, 0)}`;
      if (printRate) printRate.textContent = `${annualRate.toFixed(2)}% P.A.`;
      if (printTenure) printTenure.textContent = tenureIsYears ? `${tenureVal} Years (${totalMonths} Mo)` : `${tenureVal} Months`;
      if (printEmi) printEmi.textContent = `${currentCurrencySymbol} ${formatVal(res.regularEMI, 0)}`;
      if (printInterest) printInterest.textContent = `${currentCurrencySymbol} ${formatVal(res.totalInterestWithPrepayment, 0)}`;
      if (printTotal) printTotal.textContent = `${currentCurrencySymbol} ${formatVal(res.totalPaymentWithPrepayment, 0)}`;

      // Populate print schedule
      if (printScheduleBody && res.yearlySchedule) {
        let ph = '';
        res.yearlySchedule.forEach((row: any) => {
          ph += `<tr class="border-b border-slate-200">
            <td class="py-1.5 px-2.5 font-bold text-blue-700 whitespace-nowrap">${row.label}</td>
            <td class="py-1.5 px-2.5 text-right font-mono whitespace-nowrap">${currentCurrencySymbol} ${formatVal(row.principalPaid, 0)}</td>
            <td class="py-1.5 px-2.5 text-right font-mono text-violet-700 whitespace-nowrap">${currentCurrencySymbol} ${formatVal(row.interestPaid, 0)}</td>
            <td class="py-1.5 px-2.5 text-right font-mono whitespace-nowrap">${currentCurrencySymbol} ${formatVal(row.totalPayment, 0)}</td>
            <td class="py-1.5 px-2.5 text-right font-mono font-bold text-slate-900 whitespace-nowrap">${currentCurrencySymbol} ${formatVal(row.remainingBalance, 0)}</td>
          </tr>`;
        });
        printScheduleBody.innerHTML = ph;
      }

      clearTimeout((window as any).__emiHistoryTimeout);
      (window as any).__emiHistoryTimeout = setTimeout(() => {
        if (typeof (window as any).facAddHistory === 'function') {
          (window as any).facAddHistory({
            label: `Loan: ${currentCurrencySymbol} ${formatVal(P, 0)}`,
            summary: `@ ${annualRate}% for ${tenureIsYears ? `${tenureVal} yrs` : `${tenureVal} mo`}${extraMonthly > 0 ? ` (+${currentCurrencySymbol}${formatVal(extraMonthly, 0)}/mo)` : ''}`,
            result: `EMI: ${currentCurrencySymbol} ${formatVal(res.regularEMI, 0)}`,
            inputs: { principal: P, rate: annualRate, tenure: tenureVal, extra: extraMonthly, tenureIsYears, isIndianFormat },
          });
        }
      }, 1500);
    }

    function renderAmortizationTable() {
      if (!amortTableBody || !currentCalculationData) return;
      const data = scheduleTabMode === 'yearly'
        ? currentCalculationData.yearlySchedule
        : currentCalculationData.monthlySchedule;

      if (scheduleCounterBadge) {
        scheduleCounterBadge.textContent = scheduleTabMode === 'yearly'
          ? `${data.length} Years Breakdown`
          : `${data.length} Months Breakdown`;
      }

      const hasExtra = currentCalculationData.interestSaved > 0;
      let html = '';
      for (let i = 0; i < data.length; i++) {
        const row = data[i];
        html += `
          <tr class="hover:bg-canvas-elevated transition-colors">
            <td class="py-2 pr-3 font-semibold text-ink whitespace-nowrap">${row.label}</td>
            <td class="py-2 pr-3 text-link whitespace-nowrap">${currentCurrencySymbol} ${formatVal(row.principalPaid, 0)}</td>
            <td class="py-2 pr-3 text-violet whitespace-nowrap">${currentCurrencySymbol} ${formatVal(row.interestPaid, 0)}</td>
            ${hasExtra ? `<td class="py-2 pr-3 text-cyan whitespace-nowrap">${currentCurrencySymbol} ${formatVal(row.extraPayment, 0)}</td>` : ''}
            <td class="py-2 pr-3 text-body whitespace-nowrap">${currentCurrencySymbol} ${formatVal(row.totalPayment, 0)}</td>
            <td class="py-2 text-ink font-medium whitespace-nowrap">${currentCurrencySymbol} ${formatVal(row.remainingBalance, 0)}</td>
          </tr>
        `;
      }
      amortTableBody.innerHTML = html;
    }

    function renderProof(p: number, annualRate: number, tenureMonths: number, emi: number, extraMonthly: number, interestSaved: number) {
      if (!proofStepsBody) return;
      const proofSteps = generateEMIProof(p, annualRate, tenureMonths, emi, currentCurrencySymbol);
      let html = '';
      for (let i = 0; i < proofSteps.length; i++) {
        const step = proofSteps[i];
        html += `
          <div class="pt-2">
            <div class="flex items-center justify-between text-ink font-semibold">
              <span>Step ${step.stepNumber}: ${step.title}</span>
              <span class="text-link font-medium">${step.result}</span>
            </div>
            <p class="text-mute text-[11px] mt-0.5">${step.description}</p>
            <div class="mt-1 rounded bg-canvas-elevated px-2 py-1 text-ink text-[11px]">${step.substitution}</div>
          </div>
        `;
      }
      if (extraMonthly > 0 && interestSaved > 0) {
        html += `
          <div class="pt-2 border-t border-hairline">
            <div class="flex items-center justify-between text-ink font-semibold">
              <span>Step 6: Prepayment Differential Benefit</span>
              <span class="text-cyan font-medium">Saved ${currentCurrencySymbol} ${formatVal(interestSaved, 0)}</span>
            </div>
            <p class="text-mute text-[11px] mt-0.5">By adding ${currentCurrencySymbol} ${formatVal(extraMonthly, 0)} directly to principal repayment each month, the total interest incurred drops from baseline to accelerated schedule.</p>
            <div class="mt-1 rounded bg-canvas-elevated px-2 py-1 text-ink text-[11px]">
              Interest Saved = Baseline Interest - Accelerated Interest = ${currentCurrencySymbol}${formatVal(interestSaved, 0)}
            </div>
          </div>
        `;
      }
      proofStepsBody.innerHTML = html;
    }

    // Excel Export
    function downloadExcel() {
      if (!currentCalculationData) return;
      const P = parseSmartInput(principalInput?.value || '0');
      const annualRate = parseFloat(rateInput?.value || '0');
      const tenureVal = parseFloat(tenureInput?.value || '0');
      const extraMonthly = parseSmartInput(extraInput?.value || '0') || 0;
      const dateStr = new Date().toISOString().slice(0, 10);

      const csvRows: string[][] = [
        ['Free Accurate Calculator — freeaccuratecalculator.com'],
        ['EMI Loan Amortization Statement'],
        ['Date', dateStr],
        ['Currency', activeCode],
        [],
        ['LOAN PARAMETERS'],
        ['Principal Amount', `${currentCurrencySymbol} ${formatVal(P, 0)}`],
        ['Annual Interest Rate', `${annualRate.toFixed(2)}% P.A.`],
        ['Loan Tenure', tenureIsYears ? `${tenureVal} Years (${Math.round(tenureVal * 12)} Months)` : `${tenureVal} Months`],
        ['Extra Monthly Payment', `${currentCurrencySymbol} ${formatVal(extraMonthly, 0)}`],
        [],
        ['CALCULATION RESULTS'],
        ['Monthly EMI', `${currentCurrencySymbol} ${formatVal(currentCalculationData.regularEMI, 0)}`],
        ['Total Interest Payable', `${currentCurrencySymbol} ${formatVal(currentCalculationData.totalInterestWithPrepayment, 0)}`],
        ['Total Payment (P + I)', `${currentCurrencySymbol} ${formatVal(currentCalculationData.totalPaymentWithPrepayment, 0)}`],
        [],
        ['AMORTIZATION SCHEDULE'],
        ['Period', 'Principal Paid', 'Interest Paid', 'Extra Payment', 'Total Payment', 'Remaining Balance'],
      ];

      currentCalculationData.yearlySchedule.forEach((row: any) => {
        csvRows.push([
          row.label,
          `${currentCurrencySymbol} ${formatVal(row.principalPaid, 0)}`,
          `${currentCurrencySymbol} ${formatVal(row.interestPaid, 0)}`,
          `${currentCurrencySymbol} ${formatVal(row.extraPayment || 0, 0)}`,
          `${currentCurrencySymbol} ${formatVal(row.totalPayment, 0)}`,
          `${currentCurrencySymbol} ${formatVal(row.remainingBalance, 0)}`,
        ]);
      });

      csvRows.push([]);
      csvRows.push(['Website', 'https://freeaccuratecalculator.com/finance/emi-calculator/']);

      const escapeCsv = (val: any) => `"${String(val ?? '').replace(/"/g, '""')}"`;
      const csvContent = '\uFEFF' + csvRows.map(row => row.map(escapeCsv).join(',')).join('\r\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `EMI_Amortization_${activeCode}_${dateStr}.csv`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
      showToast('Excel spreadsheet downloaded!');
    }

    // PDF Export
    function downloadPDF() {
      calculate();
      window.print();
    }

    // Copy Summary
    function copySummary() {
      if (!currentCalculationData) return;
      const P = parseSmartInput(principalInput?.value || '0');
      const annualRate = parseFloat(rateInput?.value || '0');
      const tenureVal = parseFloat(tenureInput?.value || '0');
      const text = [
        `🏦 EMI Loan Summary — Free Accurate Calculator`,
        `--------------------------------------------`,
        `• Principal: ${currentCurrencySymbol} ${formatVal(P, 0)}`,
        `• Interest Rate: ${annualRate.toFixed(2)}% P.A.`,
        `• Tenure: ${tenureIsYears ? `${tenureVal} Years` : `${tenureVal} Months`}`,
        `--------------------------------------------`,
        `• Monthly EMI: ${currentCurrencySymbol} ${formatVal(currentCalculationData.regularEMI, 0)}`,
        `• Total Interest: ${currentCurrencySymbol} ${formatVal(currentCalculationData.totalInterestWithPrepayment, 0)}`,
        `• Total Payment: ${currentCurrencySymbol} ${formatVal(currentCalculationData.totalPaymentWithPrepayment, 0)}`,
        `--------------------------------------------`,
        `Calculate: ${window.location.href}`,
      ].join('\n');
      navigator.clipboard.writeText(text).then(() => showToast('Summary copied!')).catch(() => showToast('Could not copy'));
    }

    // Share Link
    function shareLink() {
      if (typeof (window as any).facSyncUrlState === 'function') (window as any).facSyncUrlState();
      navigator.clipboard.writeText(window.location.href).then(() => showToast('Link copied!')).catch(() => showToast('Could not copy link'));
    }

    // Bind action buttons
    document.getElementById('emi-action-pdf-btn')?.addEventListener('click', downloadPDF);
    document.getElementById('emi-bottom-pdf-btn')?.addEventListener('click', downloadPDF);
    document.getElementById('emi-action-excel-btn')?.addEventListener('click', downloadExcel);
    document.getElementById('emi-bottom-excel-btn')?.addEventListener('click', downloadExcel);
    document.getElementById('emi-copy-summary-btn')?.addEventListener('click', copySummary);
    document.getElementById('emi-share-link-btn')?.addEventListener('click', shareLink);

    // Debounced reactivity
    let debounceTimer: ReturnType<typeof setTimeout> | undefined;
    function triggerDebouncedCalculate() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => calculate(), 50);
    }

    if (principalInput && principalSlider) {
      principalInput.addEventListener('input', () => {
        const parsed = parseSmartInput(principalInput.value);
        if (!isNaN(parsed) && parsed > 0) {
          if (parsed > parseFloat(principalSlider.max)) principalSlider.max = String(parsed * 1.5);
          principalSlider.value = String(parsed);
        }
        triggerDebouncedCalculate();
      });
      principalInput.addEventListener('blur', () => {
        const parsed = parseSmartInput(principalInput.value);
        if (!isNaN(parsed) && parsed > 0) { principalInput.value = String(parsed); calculate(); }
      });
      principalSlider.addEventListener('input', () => { principalInput.value = principalSlider.value; triggerDebouncedCalculate(); });
    }

    if (rateInput && rateSlider) {
      rateInput.addEventListener('input', () => { rateSlider.value = rateInput.value; triggerDebouncedCalculate(); });
      rateSlider.addEventListener('input', () => { rateInput.value = rateSlider.value; triggerDebouncedCalculate(); });
    }

    if (tenureInput && tenureSlider) {
      tenureInput.addEventListener('input', () => { tenureSlider.value = tenureInput.value; triggerDebouncedCalculate(); });
      tenureSlider.addEventListener('input', () => { tenureInput.value = tenureSlider.value; triggerDebouncedCalculate(); });
    }

    if (extraInput && extraSlider) {
      extraInput.addEventListener('input', () => {
        const parsed = parseSmartInput(extraInput.value);
        if (!isNaN(parsed) && parsed >= 0) {
          if (parsed > parseFloat(extraSlider.max)) extraSlider.max = String(parsed * 1.5);
          extraSlider.value = String(parsed);
        }
        triggerDebouncedCalculate();
      });
      extraInput.addEventListener('blur', () => {
        const parsed = parseSmartInput(extraInput.value);
        if (!isNaN(parsed) && parsed >= 0) { extraInput.value = String(parsed); calculate(); }
      });
      extraSlider.addEventListener('input', () => { extraInput.value = extraSlider.value; triggerDebouncedCalculate(); });
    }

    // Rate benchmark chips
    document.querySelectorAll('.rate-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        const rate = (btn as HTMLElement).dataset.rate;
        if (rate && rateInput && rateSlider) { rateInput.value = rate; rateSlider.value = rate; calculate(); }
      });
    });

    // Tenure quick chips
    document.querySelectorAll('.tenure-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        const yrs = (btn as HTMLElement).dataset.years;
        if (yrs && tenureInput && tenureSlider) {
          tenureIsYears = true;
          if (tenureYrBtn) tenureYrBtn.className = 'rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium bg-primary text-on-primary';
          if (tenureMoBtn) tenureMoBtn.className = 'rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium text-ink';
          if (tenureSlider) { tenureSlider.max = '30'; tenureSlider.value = yrs; }
          tenureInput.value = yrs;
          calculate();
        }
      });
    });

    // Tab toggles
    amortTabYearly?.addEventListener('click', () => {
      scheduleTabMode = 'yearly';
      amortTabYearly.className = 'rounded-[4px] bg-primary px-3 py-1 min-h-[32px] sm:min-h-[26px] text-on-primary cursor-pointer transition-colors';
      amortTabMonthly!.className = 'rounded-[4px] px-3 py-1 min-h-[32px] sm:min-h-[26px] text-ink hover:text-ink cursor-pointer transition-colors';
      amortTabYearly.setAttribute('aria-pressed', 'true');
      amortTabMonthly!.setAttribute('aria-pressed', 'false');
      renderAmortizationTable();
    });
    amortTabMonthly?.addEventListener('click', () => {
      scheduleTabMode = 'monthly';
      amortTabMonthly.className = 'rounded-[4px] bg-primary px-3 py-1 min-h-[32px] sm:min-h-[26px] text-on-primary cursor-pointer transition-colors';
      amortTabYearly!.className = 'rounded-[4px] px-3 py-1 min-h-[32px] sm:min-h-[26px] text-ink hover:text-ink cursor-pointer transition-colors';
      amortTabMonthly.setAttribute('aria-pressed', 'true');
      amortTabYearly!.setAttribute('aria-pressed', 'false');
      renderAmortizationTable();
    });

    tenureYrBtn?.addEventListener('click', () => {
      tenureIsYears = true;
      tenureYrBtn.className = 'rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium bg-primary text-on-primary';
      tenureMoBtn!.className = 'rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium text-ink';
      tenureYrBtn.setAttribute('aria-pressed', 'true'); tenureMoBtn!.setAttribute('aria-pressed', 'false');
      if (tenureSlider) { tenureSlider.max = '30'; tenureSlider.value = '20'; }
      if (tenureInput) tenureInput.value = '20';
      calculate();
    });
    tenureMoBtn?.addEventListener('click', () => {
      tenureIsYears = false;
      tenureMoBtn.className = 'rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium bg-primary text-on-primary';
      tenureYrBtn!.className = 'rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium text-ink';
      tenureMoBtn.setAttribute('aria-pressed', 'true'); tenureYrBtn!.setAttribute('aria-pressed', 'false');
      if (tenureSlider) { tenureSlider.max = '360'; tenureSlider.value = '240'; }
      if (tenureInput) tenureInput.value = '240';
      calculate();
    });

    formatStdBtn?.addEventListener('click', () => {
      isIndianFormat = false;
      formatStdBtn.className = 'rounded-[4px] bg-primary px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-on-primary cursor-pointer transition-colors';
      formatIndBtn!.className = 'rounded-[4px] px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-ink hover:text-ink cursor-pointer transition-colors';
      formatStdBtn.setAttribute('aria-pressed', 'true'); formatIndBtn!.setAttribute('aria-pressed', 'false');
      calculate();
    });
    formatIndBtn?.addEventListener('click', () => {
      isIndianFormat = true;
      formatIndBtn.className = 'rounded-[4px] bg-primary px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-on-primary cursor-pointer transition-colors';
      formatStdBtn!.className = 'rounded-[4px] px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-ink hover:text-ink cursor-pointer transition-colors';
      formatIndBtn.setAttribute('aria-pressed', 'true'); formatStdBtn!.setAttribute('aria-pressed', 'false');
      calculate();
    });

    document.querySelectorAll('.preset-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const amt = chip.getAttribute('data-amount');
        if (amt && principalInput && principalSlider) { principalInput.value = amt; principalSlider.value = amt; calculate(); }
      });
    });

    function updateCurrencyUI() {
      if (principalSymbol) principalSymbol.textContent = currentCurrencySymbol;
      if (extraSymbol) extraSymbol.textContent = currentCurrencySymbol;
      ['emi-monthly-result-prefix', 'emi-interest-result-prefix', 'emi-total-result-prefix'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.textContent = `${currentCurrencySymbol} `;
      });
      ['emi-monthly-result', 'emi-interest-result', 'emi-total-result'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) { el.setAttribute('data-prefix', `${currentCurrencySymbol} `); el.setAttribute('data-indian', isIndianFormat ? 'true' : 'false'); }
      });
      if (isIndianFormat) {
        if (formatIndBtn) formatIndBtn.className = 'rounded-[4px] bg-primary px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-on-primary cursor-pointer transition-colors';
        if (formatStdBtn) formatStdBtn.className = 'rounded-[4px] px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-ink hover:text-ink cursor-pointer transition-colors';
      } else {
        if (formatStdBtn) formatStdBtn.className = 'rounded-[4px] bg-primary px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-on-primary cursor-pointer transition-colors';
        if (formatIndBtn) formatIndBtn.className = 'rounded-[4px] px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-ink hover:text-ink cursor-pointer transition-colors';
      }
    }

    let lastActiveCurrency = activeCode;
    window.addEventListener('currencychange', (e: any) => {
      const newCurr = e.detail.currency;
      const prevCurr = e.detail.prevCurrency || lastActiveCurrency;
      if (prevCurr && newCurr && prevCurr !== newCurr && typeof (window as any).facConvertCurrency === 'function') {
        const pVal = parseSmartInput(principalInput?.value || '0');
        if (!isNaN(pVal) && pVal > 0) {
          const convertedP = (window as any).facConvertCurrency(pVal, prevCurr, newCurr);
          const roundedP = Math.round(convertedP);
          if (principalInput) principalInput.value = String(roundedP);
          if (principalSlider) {
            if (roundedP > parseFloat(principalSlider.max)) principalSlider.max = String(roundedP * 2);
            principalSlider.value = String(roundedP);
          }
        }
      }
      lastActiveCurrency = newCurr;
      currentCurrencySymbol = e.detail.symbol;
      isIndianFormat = e.detail.isIndian;
      updateCurrencyUI();
      calculate();
    });

    (window as any).facSyncUrlState = function () {
      const params = new URLSearchParams(window.location.search);
      params.set('p', principalInput?.value || '2500000');
      params.set('r', rateInput?.value || '8.5');
      params.set('t', tenureInput?.value || '20');
      params.set('ty', tenureIsYears ? 'yr' : 'mo');
      params.set('ex', extraInput?.value || '0');
      params.set('fmt', isIndianFormat ? 'in' : 'std');
      const activeCurr = typeof (window as any).facGetActiveCurrency === 'function'
        ? (window as any).facGetActiveCurrency()
        : (localStorage.getItem('fac_currency') || 'USD');
      params.set('currency', activeCurr);
      window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
    };

    const params = new URLSearchParams(window.location.search);
    if (params.has('p') && principalInput && principalSlider) { principalInput.value = params.get('p')!; principalSlider.value = params.get('p')!; }
    if (params.has('r') && rateInput && rateSlider) { rateInput.value = params.get('r')!; rateSlider.value = params.get('r')!; }
    if (params.has('t') && tenureInput && tenureSlider) { tenureInput.value = params.get('t')!; tenureSlider.value = params.get('t')!; }
    if (params.has('ex') && extraInput && extraSlider) { extraInput.value = params.get('ex')!; extraSlider.value = params.get('ex')!; }
    if (params.get('ty') === 'mo') tenureMoBtn?.click();
    if (params.get('fmt') === 'std') formatStdBtn?.click();

    (window as any).facRestoreHistoryItem = function (item: any) {
      if (item.inputs) {
        if (principalInput && item.inputs.principal) { principalInput.value = item.inputs.principal; if (principalSlider) principalSlider.value = item.inputs.principal; }
        if (rateInput && item.inputs.rate) { rateInput.value = item.inputs.rate; if (rateSlider) rateSlider.value = item.inputs.rate; }
        if (tenureInput && item.inputs.tenure) { tenureInput.value = item.inputs.tenure; if (tenureSlider) tenureSlider.value = item.inputs.tenure; }
        if (extraInput && item.inputs.extra !== undefined) { extraInput.value = item.inputs.extra; if (extraSlider) extraSlider.value = item.inputs.extra; }
        if (item.inputs.tenureIsYears === false) { tenureMoBtn?.click(); } else { tenureYrBtn?.click(); }
      }
      calculate();
    };

    updateCurrencyUI();
    calculate();
  })();
</script>


---
// src/pages/finance/emi-calculator.astro
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ResultDisplay from '../../components/calculator/ResultDisplay.astro';
import FormulaSection from '../../components/calculator/FormulaSection.astro';
import WorkedExample from '../../components/calculator/WorkedExample.astro';
import FAQSection from '../../components/calculator/FAQSection.astro';
import HistoryDrawer from '../../components/calculator/HistoryDrawer.astro';
import CurrencySwitcher from '../../components/common/CurrencySwitcher.astro';
import SocialProof from '../../components/SocialProof.astro';

const faqs = [
  {
    question: 'What is an EMI and how is it calculated?',
    answer:
      'EMI stands for Equated Monthly Installment. It is a fixed payment amount made by a borrower to a lender at a specified date each calendar month. EMIs are calculated using the reducing balance method: E = P × r × (1 + r)ⁿ / ((1 + r)ⁿ - 1), where P is principal, r is the monthly interest rate, and n is the tenure in months.',
  },
  {
    question: 'How does an Extra Monthly Payment reduce loan tenure and interest?',
    answer:
      'Any extra monthly payment goes 100% toward principal repayment rather than interest. This accelerates the reduction of your outstanding loan balance, drastically lowering subsequent monthly interest charges, saving thousands in cumulative interest and cutting years off your total loan schedule.',
  },
  {
    question: 'How does the reducing balance method differ from a flat interest rate?',
    answer:
      'In a reducing balance loan, interest is calculated each month solely on the outstanding principal. As you pay off principal each month, the interest portion of your EMI decreases while the principal portion increases. A flat rate loan calculates interest on the entire original principal for the full duration, resulting in a significantly higher effective APR.',
  },
  {
    question: 'What is the Indian Lakh/Crore numbering system?',
    answer:
      'In India, South Asia, and regional banking, large currency figures are grouped in Lakhs and Crores rather than millions and billions. 1 Lakh equals 100,000 (written as 1,00,000) and 1 Crore equals 100 Lakhs or 10,000,000 (written as 1,00,00,000). Our calculator dynamically supports both formats.',
  },
  {
    question: 'How does real-time double verification work?',
    answer:
      'Our engine cross-checks the closed-form algebraic formula against an independent iterative month-by-month compounding simulation loop. Both results must converge within 0.01 currency units, guaranteeing absolute mathematical precision without approximation drift.',
  },
];

const relatedCalculators = [
  { title: 'Compound Interest', href: '/finance/compound-interest-calculator/' },
  { title: 'Mortgage Calculator', href: '/finance/mortgage-calculator/' },
  { title: 'Percentage Calculator', href: '/math/percentage-calculator/', badge: 'Math' },
];
---

<CalculatorLayout
  title="EMI Calculator — Equated Monthly Installment with Prepayment & Lakh/Crore Support"
  metaDescription="Calculate your exact loan EMI, extra payment savings, and multi-tab amortization schedule. Features real-time what-if reactivity, step-by-step mathematical proof, and Indian Lakh/Crore formatting."
  h1="EMI Calculator"
  subtitle="Calculate equated monthly installments for home loans, personal loans, and car financing with instant reducing balance math and prepayment analysis."
  category={{ label: 'Finance', href: '/finance/' }}
  calculatorName="EMI Calculator"
  relatedCalculators={relatedCalculators}
>
  <!-- Social Proof -->
  <div id="emi-social-proof" class="print:hidden">
    <SocialProof calculatorName="EMI Calculator" />
  </div>

  <!-- Calculator Main Box -->
  <div id="emi-calculator-card" class="emi-main-box relative rounded-[16px] border border-hairline bg-canvas-elevated p-4 sm:p-8 shadow-whisper space-y-6">

    <!-- ===== PRINT-ONLY REPORT ===== -->
    <div id="emi-print-report" class="hidden print:block">
      <div class="border-b-2 border-slate-900 pb-4 mb-5 flex justify-between items-start">
        <div>
          <div class="text-2xl font-black uppercase tracking-tight text-slate-900">Free Accurate Calculator</div>
          <div class="text-sm font-bold text-blue-700 mt-0.5">EMI Loan Amortization Statement</div>
          <div class="text-xs text-slate-500 mt-1 font-mono">freeaccuratecalculator.com • Verified Financial Computation</div>
        </div>
        <div class="text-right text-xs font-mono text-slate-600 space-y-0.5">
          <div><span class="text-slate-400 uppercase">Generated:</span> <strong id="emi-print-date" class="text-slate-900"></strong></div>
          <div><span class="text-slate-400 uppercase">Currency:</span> <strong id="emi-print-currency" class="text-slate-900"></strong></div>
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-lg p-3.5 mb-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2 font-mono">Loan Parameters</div>
        <div class="grid grid-cols-3 gap-4 text-xs font-mono">
          <div><span class="text-slate-500 block text-[10px] uppercase">Principal Amount</span><span id="emi-print-principal" class="text-sm font-bold text-slate-900"></span></div>
          <div><span class="text-slate-500 block text-[10px] uppercase">Interest Rate</span><span id="emi-print-rate" class="text-sm font-bold text-slate-900"></span></div>
          <div><span class="text-slate-500 block text-[10px] uppercase">Loan Tenure</span><span id="emi-print-tenure" class="text-sm font-bold text-slate-900"></span></div>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3 mb-6">
        <div class="border border-slate-300 rounded-lg p-3.5 bg-white">
          <span class="text-[10px] font-bold uppercase text-slate-500 block font-mono">Monthly EMI</span>
          <div id="emi-print-emi" class="text-lg font-black text-blue-700 mt-1 font-mono"></div>
          <span class="text-[10px] text-slate-500">Per Month Installment</span>
        </div>
        <div class="border border-slate-300 rounded-lg p-3.5 bg-white">
          <span class="text-[10px] font-bold uppercase text-slate-500 block font-mono">Total Interest</span>
          <div id="emi-print-interest" class="text-lg font-black text-violet-700 mt-1 font-mono"></div>
          <span class="text-[10px] text-slate-500">Lifetime Interest Cost</span>
        </div>
        <div class="border-2 border-slate-900 rounded-lg p-3.5 bg-slate-50">
          <span class="text-[10px] font-bold uppercase text-slate-900 block font-mono">Total Payment</span>
          <div id="emi-print-total" class="text-lg font-black text-slate-900 mt-1 font-mono"></div>
          <span class="text-[10px] text-slate-500">Principal + Interest</span>
        </div>
      </div>

      <div class="space-y-2">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900 font-mono">Amortization Schedule</div>
        <table class="w-full text-left text-xs font-mono border-collapse">
          <thead>
            <tr class="border-b-2 border-slate-300 bg-slate-100 text-slate-700">
              <th class="py-2 px-2.5">Period</th>
              <th class="py-2 px-2.5 text-right">Principal Paid</th>
              <th class="py-2 px-2.5 text-right">Interest Paid</th>
              <th class="py-2 px-2.5 text-right">Total Payment</th>
              <th class="py-2 px-2.5 text-right">Remaining Balance</th>
            </tr>
          </thead>
          <tbody id="emi-print-schedule-body" class="divide-y divide-slate-200"></tbody>
        </table>
      </div>

      <div class="mt-8 pt-3 border-t border-slate-200 flex justify-between items-center text-[10px] font-mono text-slate-500">
        <div>Generated by <strong>Free Accurate Calculator</strong> • https://freeaccuratecalculator.com</div>
        <div>Verified Pure Client-Side Computation • 100% Private</div>
      </div>
    </div>
    <!-- ===== END PRINT REPORT ===== -->

    <!-- Country/Format Controls Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-4 text-xs print:hidden">
      <div class="flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-2">
          <span class="mono-eyebrow text-mute">Currency:</span>
          <CurrencySwitcher selectId="emi-currency-select" className="w-auto" showFullName={true} />
        </div>
        <div class="flex items-center gap-2">
          <span class="mono-eyebrow text-mute">Notation:</span>
          <div class="inline-flex rounded-[6px] border border-hairline bg-canvas p-0.5">
            <button
              id="format-standard-btn"
              type="button"
              aria-label="Use Standard Million notation"
              aria-pressed="false"
              class="rounded-[4px] px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-ink hover:text-ink cursor-pointer transition-colors"
            >
              Standard (Million)
            </button>
            <button
              id="format-indian-btn"
              type="button"
              aria-label="Use Indian Lakh and Crore notation"
              aria-pressed="true"
              class="rounded-[4px] bg-primary px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-on-primary cursor-pointer transition-colors"
            >
              Indian (Lakh/Crore)
            </button>
          </div>
        </div>
      </div>

      <!-- Quick Preset Chips -->
      <div class="flex items-center gap-1.5 overflow-x-auto text-[11px] font-medium text-mute pb-1 sm:pb-0">
        <span class="select-none shrink-0 font-mono text-[10px] uppercase tracking-wider font-bold text-mute">Presets:</span>
        <button type="button" aria-label="Set loan amount to 5 Lakhs" class="preset-chip shrink-0 rounded-[6px] border border-hairline bg-canvas px-2.5 py-1 min-h-[32px] sm:min-h-[26px] hover:text-ink hover:border-link/40 cursor-pointer font-mono font-medium transition-all text-xs" data-amount="500000">5L</button>
        <button type="button" aria-label="Set loan amount to 15 Lakhs" class="preset-chip shrink-0 rounded-[6px] border border-hairline bg-canvas px-2.5 py-1 min-h-[32px] sm:min-h-[26px] hover:text-ink hover:border-link/40 cursor-pointer font-mono font-medium transition-all text-xs" data-amount="1500000">15L</button>
        <button type="button" aria-label="Set loan amount to 25 Lakhs" class="preset-chip shrink-0 rounded-[6px] border border-hairline bg-canvas px-2.5 py-1 min-h-[32px] sm:min-h-[26px] hover:text-ink hover:border-link/40 cursor-pointer font-mono font-medium transition-all text-xs" data-amount="2500000">25L</button>
        <button type="button" aria-label="Set loan amount to 50 Lakhs" class="preset-chip shrink-0 rounded-[6px] border border-hairline bg-canvas px-2.5 py-1 min-h-[32px] sm:min-h-[26px] hover:text-ink hover:border-link/40 cursor-pointer font-mono font-medium transition-all text-xs" data-amount="5000000">50L</button>
        <button type="button" aria-label="Set loan amount to 1 Crore" class="preset-chip shrink-0 rounded-[6px] border border-hairline bg-canvas px-2.5 py-1 min-h-[32px] sm:min-h-[26px] hover:text-ink hover:border-link/40 cursor-pointer font-mono font-medium transition-all text-xs" data-amount="10000000">1Cr</button>
      </div>
    </div>

    <!-- Inputs Grid -->
    <div class="space-y-5 print:hidden">
      <!-- 1. Principal Loan Amount -->
      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
          <label for="emi-principal">Loan Amount (Principal)</label>
          <span id="principal-display" class="font-mono text-link text-sm tabular-nums font-bold">₹ 25,00,000</span>
        </div>
        <div class="relative flex items-center">
          <span id="principal-symbol" class="absolute left-3.5 text-sm font-mono text-mute select-none">₹</span>
          <input
            id="emi-principal"
            type="text"
            inputmode="text"
            value="2500000"
            placeholder="e.g. 2500000, 25L, 1.5Cr"
            class="w-full min-h-[44px] rounded-[8px] border border-hairline bg-canvas py-2.5 pl-8 pr-3 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 transition-all"
          />
        </div>
        <label for="emi-principal-slider" class="sr-only">Loan principal amount slider</label>
        <input id="emi-principal-slider" type="range" min="100000" max="10000000" step="50000" value="2500000" aria-label="Loan principal amount slider" class="w-full accent-link cursor-pointer h-5" />
        <p class="text-[11px] text-mute font-mono">Smart shorthand: "25L", "1.5Cr", "50k", or raw numbers.</p>
      </div>

      <!-- 2. Annual Interest Rate -->
      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
          <label for="emi-rate">Interest Rate (% P.A.)</label>
          <span id="rate-display" class="font-mono text-cyan text-sm tabular-nums font-bold">8.50%</span>
        </div>
        <div class="relative flex items-center">
          <input id="emi-rate" type="number" min="0.1" max="30" step="0.05" value="8.5" class="w-full min-h-[44px] rounded-[8px] border border-hairline bg-canvas py-2.5 pl-3 pr-8 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 transition-all" />
          <span class="absolute right-3.5 text-sm font-mono text-mute select-none">%</span>
        </div>
        <label for="emi-rate-slider" class="sr-only">Interest rate slider</label>
        <input id="emi-rate-slider" type="range" min="4" max="20" step="0.1" value="8.5" aria-label="Interest rate slider" class="w-full accent-cyan cursor-pointer h-5" />
        <!-- Quick Rate Benchmarks -->
        <div class="flex items-center gap-1.5 pt-0.5">
          <button type="button" class="rate-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-cyan/40 hover:text-cyan text-mute cursor-pointer transition-colors" data-rate="7">7% Home</button>
          <button type="button" class="rate-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-cyan/40 hover:text-cyan text-mute cursor-pointer transition-colors" data-rate="8.5">8.5% Avg</button>
          <button type="button" class="rate-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-cyan/40 hover:text-cyan text-mute cursor-pointer transition-colors" data-rate="12">12% Personal</button>
        </div>
      </div>

      <!-- 3. Loan Tenure -->
      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
          <label for="emi-tenure">Loan Tenure</label>
          <div class="flex items-center gap-2">
            <span id="tenure-display" class="font-mono text-violet text-sm tabular-nums font-bold">20 Years (240 Mo)</span>
            <div class="inline-flex rounded border border-hairline bg-canvas p-0.5 text-xs sm:text-[10px]">
              <button id="tenure-yr-btn" type="button" aria-label="Tenure in years" aria-pressed="true" class="rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium bg-primary text-on-primary">Yr</button>
              <button id="tenure-mo-btn" type="button" aria-label="Tenure in months" aria-pressed="false" class="rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium text-ink">Mo</button>
            </div>
          </div>
        </div>
        <input id="emi-tenure" type="number" min="1" max="360" value="20" class="w-full min-h-[44px] rounded-[8px] border border-hairline bg-canvas py-2.5 px-3 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 transition-all" />
        <label for="emi-tenure-slider" class="sr-only">Loan tenure slider</label>
        <input id="emi-tenure-slider" type="range" min="1" max="30" step="1" value="20" aria-label="Loan tenure slider" class="w-full accent-violet cursor-pointer h-5" />
        <!-- Quick Tenure Chips -->
        <div class="flex items-center gap-1.5 pt-0.5">
          <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="5">5Y</button>
          <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="10">10Y</button>
          <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="15">15Y</button>
          <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="20">20Y</button>
        </div>
      </div>

      <!-- 4. Extra Monthly Prepayment -->
      <div class="space-y-2 rounded-[8px] border border-hairline bg-canvas p-3 sm:p-4">
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
          <label for="emi-extra" class="flex items-center gap-1.5">
            <span>Extra Monthly Payment (Optional)</span>
            <span class="rounded bg-cyan/15 px-1.5 py-0.5 text-[10px] font-medium text-cyan lowercase">what-if</span>
          </label>
          <span id="extra-display" class="font-mono text-cyan text-sm tabular-nums font-bold">₹ 0</span>
        </div>
        <div class="relative flex items-center">
          <span id="extra-symbol" class="absolute left-3.5 text-sm font-mono text-mute select-none">₹</span>
          <input id="emi-extra" type="text" inputmode="text" value="0" placeholder="e.g. 5000, 5k, 10k" class="w-full min-h-[44px] rounded-[8px] border border-hairline bg-canvas-elevated py-2.5 pl-8 pr-3 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 transition-all" />
        </div>
        <label for="emi-extra-slider" class="sr-only">Extra monthly prepayment slider</label>
        <input id="emi-extra-slider" type="range" min="0" max="50000" step="500" value="0" aria-label="Extra monthly prepayment slider" class="w-full accent-cyan cursor-pointer h-5" />
        <p class="text-[11px] text-mute font-mono">Simulate prepaying an extra amount each month to discover time & interest savings.</p>
      </div>
    </div>

    <!-- Primary Results Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 print:hidden">
      <ResultDisplay
        id="emi-monthly-result"
        label="Monthly EMI Amount"
        prefix="₹ "
        initialValue={21696}
        decimals={0}
        secondaryText="Baseline monthly installment"
        accent="link"
      />
      <ResultDisplay
        id="emi-interest-result"
        label="Total Interest Payable"
        prefix="₹ "
        initialValue={2706935}
        decimals={0}
        secondaryText="Total interest with prepayments"
        accent="violet"
      />
      <ResultDisplay
        id="emi-total-result"
        label="Total Payment (P + I)"
        prefix="₹ "
        initialValue={5206935}
        decimals={0}
        secondaryText="Principal plus lifetime interest"
        accent="ink"
      />
    </div>

    <!-- Extra Payment Savings Callout -->
    <div id="extra-savings-panel" class="hidden rounded-[8px] border border-hairline bg-canvas p-4 space-y-3 print:hidden" aria-live="polite" aria-atomic="true">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-hairline pb-2.5">
        <span class="mono-eyebrow text-cyan flex items-center gap-1.5">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Prepayment Payoff Acceleration
        </span>
        <span id="double-verification-badge" class="font-mono text-[11px] text-mute flex items-center gap-1">
          <span class="h-1.5 w-1.5 rounded-full bg-link"></span>
          Double-Verified Math
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono">
        <div>
          <span class="text-mute block">Total Interest Saved:</span>
          <span id="savings-interest-text" class="text-base font-semibold text-cyan">₹ 0</span>
        </div>
        <div>
          <span class="text-mute block">Payoff Time Saved:</span>
          <span id="savings-time-text" class="text-base font-semibold text-link">0 Months</span>
        </div>
        <div>
          <span class="text-mute block">New Loan Tenure:</span>
          <span id="savings-new-tenure-text" class="text-base font-semibold text-ink">20 Years</span>
        </div>
      </div>
    </div>

    <!-- Visual Breakdown Bar -->
    <div class="space-y-3 pt-2 print:hidden">
      <div class="flex items-center justify-between text-xs font-mono">
        <span class="flex items-center gap-1.5 text-link">
          <span class="h-2 w-2 rounded-full bg-link"></span>
          Principal: <span id="principal-pct-label">48.0%</span>
        </span>
        <span class="flex items-center gap-1.5 text-violet">
          <span class="h-2 w-2 rounded-full bg-violet"></span>
          Interest: <span id="interest-pct-label">52.0%</span>
        </span>
        <span id="savings-pct-container" class="hidden sm:flex items-center gap-1.5 text-cyan">
          <span class="h-2 w-2 rounded-full bg-cyan"></span>
          Savings: <span id="savings-pct-label">0.0%</span>
        </span>
      </div>
      <div class="flex h-3.5 w-full overflow-hidden rounded-full bg-canvas border border-hairline">
        <div id="bar-principal" class="h-full bg-link transition-all duration-300" style="width: 48%;"></div>
        <div id="bar-interest" class="h-full bg-violet transition-all duration-300" style="width: 52%;"></div>
      </div>
    </div>

    <!-- Primary Action Toolbar -->
    <div class="pt-3 border-t border-hairline flex flex-wrap items-center justify-between gap-3 print:hidden">
      <div class="flex flex-col gap-2">
        <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-mute">Export Your EMI Report</span>
        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            id="emi-action-pdf-btn"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-[8px] bg-link hover:bg-link-hover active:scale-95 text-white text-xs font-semibold shadow-xs transition-all cursor-pointer"
            title="Download Verified PDF Loan Statement"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Download PDF</span>
          </button>
          <button
            type="button"
            id="emi-action-excel-btn"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-[8px] bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white text-xs font-semibold shadow-xs transition-all cursor-pointer"
            title="Download Amortization Schedule in Excel/CSV"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download Excel</span>
          </button>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="emi-copy-summary-btn"

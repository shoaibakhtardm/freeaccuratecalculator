---
// src/pages/finance/emi-calculator.astro
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ResultDisplay from '../../components/calculator/ResultDisplay.astro';
import FormulaSection from '../../components/calculator/FormulaSection.astro';
import WorkedExample from '../../components/calculator/WorkedExample.astro';
import FAQSection from '../../components/calculator/FAQSection.astro';
import HistoryDrawer from '../../components/calculator/HistoryDrawer.astro';
import CurrencySwitcher from '../../components/common/CurrencySwitcher.astro';
import SocialProof from '../../components/SocialProof.astro';

const faqs = [
  {
    question: 'What is an EMI and how is it calculated?',
    answer:
      'EMI stands for Equated Monthly Installment. It is a fixed payment amount made by a borrower to a lender at a specified date each calendar month. EMIs are calculated using the reducing balance method: E = P × r × (1 + r)ⁿ / ((1 + r)ⁿ - 1), where P is principal, r is the monthly interest rate, and n is the tenure in months.',
  },
  {
    question: 'How does an Extra Monthly Payment reduce loan tenure and interest?',
    answer:
      'Any extra monthly payment goes 100% toward principal repayment rather than interest. This accelerates the reduction of your outstanding loan balance, drastically lowering subsequent monthly interest charges, saving thousands in cumulative interest and cutting years off your total loan schedule.',
  },
  {
    question: 'How does the reducing balance method differ from a flat interest rate?',
    answer:
      'In a reducing balance loan, interest is calculated each month solely on the outstanding principal. As you pay off principal each month, the interest portion of your EMI decreases while the principal portion increases. A flat rate loan calculates interest on the entire original principal for the full duration, resulting in a significantly higher effective APR.',
  },
  {
    question: 'What is the Indian Lakh/Crore numbering system?',
    answer:
      'In India, South Asia, and regional banking, large currency figures are grouped in Lakhs and Crores rather than millions and billions. 1 Lakh equals 100,000 (written as 1,00,000) and 1 Crore equals 100 Lakhs or 10,000,000 (written as 1,00,00,000). Our calculator dynamically supports both formats.',
  },
  {
    question: 'How does real-time double verification work?',
    answer:
      'Our engine cross-checks the closed-form algebraic formula against an independent iterative month-by-month compounding simulation loop. Both results must converge within 0.01 currency units, guaranteeing absolute mathematical precision without approximation drift.',
  },
];

const relatedCalculators = [
  { title: 'Compound Interest', href: '/finance/compound-interest-calculator/' },
  { title: 'Mortgage Calculator', href: '/finance/mortgage-calculator/' },
  { title: 'Percentage Calculator', href: '/math/percentage-calculator/', badge: 'Math' },
];
---

<CalculatorLayout
  title="EMI Calculator — Equated Monthly Installment with Prepayment & Lakh/Crore Support"
  metaDescription="Calculate your exact loan EMI, extra payment savings, and multi-tab amortization schedule. Features real-time what-if reactivity, step-by-step mathematical proof, and Indian Lakh/Crore formatting."
  h1="EMI Calculator"
  subtitle="Calculate equated monthly installments for home loans, personal loans, and car financing with instant reducing balance math and prepayment analysis."
  category={{ label: 'Finance', href: '/finance/' }}
  calculatorName="EMI Calculator"
  relatedCalculators={relatedCalculators}
>
  <!-- Real-time Social Proof Widget -->
  <SocialProof calculatorName="EMI Calculator" />

  <!-- Calculator Main Box -->
  <div class="rounded-[12px] border border-hairline bg-canvas-elevated p-4 sm:p-8 shadow-whisper space-y-6">
    <!-- Country/Format Controls Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-4 text-xs">
      <div class="flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-2">
          <span class="mono-eyebrow text-mute">Currency:</span>
          <CurrencySwitcher selectId="emi-currency-select" className="w-auto" showFullName={true} />
        </div>
        <div class="flex items-center gap-2">
          <span class="mono-eyebrow text-mute">Notation:</span>
          <div class="inline-flex rounded-[6px] border border-hairline bg-canvas p-0.5">
            <button
              id="format-standard-btn"
              type="button"
              aria-label="Use Standard Million notation"
              aria-pressed="false"
              class="rounded-[4px] px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-ink hover:text-ink cursor-pointer transition-colors"
            >
              Standard (Million)
            </button>
            <button
              id="format-indian-btn"
              type="button"
              aria-label="Use Indian Lakh and Crore notation"
              aria-pressed="true"
              class="rounded-[4px] bg-primary px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-on-primary cursor-pointer transition-colors"
            >
              Indian (Lakh/Crore)
            </button>
          </div>
        </div>
      </div>

      <!-- Quick Preset Chips -->
      <div class="flex items-center gap-1.5 overflow-x-auto text-[11px] font-medium text-mute pb-1 sm:pb-0">
        <span class="select-none shrink-0">Presets:</span>
        <button type="button" aria-label="Set loan amount to 5 Lakhs" class="preset-chip shrink-0 rounded border border-hairline bg-canvas px-3 py-2 sm:py-1 min-h-[44px] sm:min-h-[26px] hover:text-ink cursor-pointer flex items-center justify-center" data-amount="500000">
          5L
        </button>
        <button type="button" aria-label="Set loan amount to 15 Lakhs" class="preset-chip shrink-0 rounded border border-hairline bg-canvas px-3 py-2 sm:py-1 min-h-[44px] sm:min-h-[26px] hover:text-ink cursor-pointer flex items-center justify-center" data-amount="1500000">
          15L
        </button>
        <button type="button" aria-label="Set loan amount to 25 Lakhs" class="preset-chip shrink-0 rounded border border-hairline bg-canvas px-3 py-2 sm:py-1 min-h-[44px] sm:min-h-[26px] hover:text-ink cursor-pointer flex items-center justify-center" data-amount="2500000">
          25L
        </button>
        <button type="button" aria-label="Set loan amount to 50 Lakhs" class="preset-chip shrink-0 rounded border border-hairline bg-canvas px-3 py-2 sm:py-1 min-h-[44px] sm:min-h-[26px] hover:text-ink cursor-pointer flex items-center justify-center" data-amount="5000000">
          50L
        </button>
        <button type="button" aria-label="Set loan amount to 1 Crore" class="preset-chip shrink-0 rounded border border-hairline bg-canvas px-3 py-2 sm:py-1 min-h-[44px] sm:min-h-[26px] hover:text-ink cursor-pointer flex items-center justify-center" data-amount="10000000">
          1Cr
        </button>
      </div>
    </div>

    <!-- Inputs Grid -->
    <div class="space-y-5">
      <!-- 1. Principal Loan Amount -->
      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
          <label for="emi-principal">Loan Amount (Principal)</label>
          <span id="principal-display" class="font-mono text-link text-sm">₹ 25,00,000</span>
        </div>
        <div class="relative flex items-center">
          <span id="principal-symbol" class="absolute left-3.5 text-sm font-mono text-mute select-none">₹</span>
          <input
            id="emi-principal"
            type="text"
            inputmode="text"
            value="2500000"
            placeholder="e.g. 2500000, 25L, 1.5Cr"
            class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas py-2.5 pl-8 pr-3 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
          />
        </div>
        <label for="emi-principal-slider" class="sr-only">Loan principal amount slider</label>
        <input
          id="emi-principal-slider"
          type="range"
          min="100000"
          max="10000000"
          step="50000"
          value="2500000"
          aria-label="Loan principal amount slider"
          class="w-full accent-link cursor-pointer h-5"
        />
        <p class="text-[11px] text-mute font-mono">Smart shorthand supported: e.g. "25L", "1.5Cr", "50k", or raw numbers.</p>
      </div>

      <!-- 2. Annual Interest Rate -->
      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
          <label for="emi-rate">Interest Rate (% P.A.)</label>
          <span id="rate-display" class="font-mono text-cyan text-sm">8.50%</span>
        </div>
        <div class="relative flex items-center">
          <input
            id="emi-rate"
            type="number"
            min="0.1"
            max="30"
            step="0.05"
            value="8.5"
            class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas py-2.5 pl-3 pr-8 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
          />
          <span class="absolute right-3.5 text-sm font-mono text-mute select-none">%</span>
        </div>
        <label for="emi-rate-slider" class="sr-only">Interest rate slider</label>
        <input
          id="emi-rate-slider"
          type="range"
          min="4"
          max="20"
          step="0.1"
          value="8.5"
          aria-label="Interest rate slider"
          class="w-full accent-cyan cursor-pointer h-5"
        />
      </div>

      <!-- 3. Loan Tenure -->
      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
          <label for="emi-tenure">Loan Tenure</label>
          <div class="flex items-center gap-2">
            <span id="tenure-display" class="font-mono text-violet text-sm">20 Years (240 Mo)</span>
            <div class="inline-flex rounded border border-hairline bg-canvas p-0.5 text-xs sm:text-[10px]">
              <button id="tenure-yr-btn" type="button" aria-label="Tenure in years" aria-pressed="true" class="rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium bg-primary text-on-primary">Yr</button>
              <button id="tenure-mo-btn" type="button" aria-label="Tenure in months" aria-pressed="false" class="rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium text-ink">Mo</button>
            </div>
          </div>
        </div>
        <input
          id="emi-tenure"
          type="number"
          min="1"
          max="360"
          value="20"
          class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas py-2.5 px-3 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
        />
        <label for="emi-tenure-slider" class="sr-only">Loan tenure slider</label>
        <input
          id="emi-tenure-slider"
          type="range"
          min="1"
          max="30"
          step="1"
          value="20"
          aria-label="Loan tenure slider"
          class="w-full accent-violet cursor-pointer h-5"
        />
      </div>

      <!-- 4. Extra Monthly Prepayment (Calculator.net feature) -->
      <div class="space-y-2 rounded-[8px] border border-hairline bg-canvas p-3 sm:p-4">
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
          <label for="emi-extra" class="flex items-center gap-1.5">
            <span>Extra Monthly Payment (Optional)</span>
            <span class="rounded bg-cyan/15 px-1.5 py-0.5 text-[10px] font-medium text-cyan lowercase">what-if</span>
          </label>
          <span id="extra-display" class="font-mono text-cyan text-sm">₹ 0</span>
        </div>
        <div class="relative flex items-center">
          <span id="extra-symbol" class="absolute left-3.5 text-sm font-mono text-mute select-none">₹</span>
          <input
            id="emi-extra"
            type="text"
            inputmode="text"
            value="0"
            placeholder="e.g. 5000, 5k, 10k"
            class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas-elevated py-2.5 pl-8 pr-3 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
          />
        </div>
        <label for="emi-extra-slider" class="sr-only">Extra monthly prepayment slider</label>
        <input
          id="emi-extra-slider"
          type="range"
          min="0"
          max="50000"
          step="500"
          value="0"
          aria-label="Extra monthly prepayment slider"
          class="w-full accent-cyan cursor-pointer h-5"
        />
        <p class="text-[11px] text-mute font-mono">Simulate prepaying an extra amount each month to discover time & interest savings.</p>
      </div>
    </div>

    <!-- Primary Results Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
      <ResultDisplay
        id="emi-monthly-result"
        label="Monthly EMI Amount"
        prefix="₹ "
        initialValue={21696}
        decimals={0}
        secondaryText="Baseline monthly installment"
        accent="link"
      />

      <ResultDisplay
        id="emi-interest-result"
        label="Total Interest Payable"
        prefix="₹ "
        initialValue={2706935}
        decimals={0}
        secondaryText="Total interest with prepayments"
        accent="violet"
      />

      <ResultDisplay
        id="emi-total-result"
        label="Total Payment (P + I)"
        prefix="₹ "
        initialValue={5206935}
        decimals={0}
        secondaryText="Principal plus lifetime interest"
        accent="ink"
      />
    </div>

    <!-- Extra Payment Savings Callout (Live Reactivity) -->
    <div id="extra-savings-panel" class="hidden rounded-[8px] border border-hairline bg-canvas p-4 space-y-3" aria-live="polite" aria-atomic="true">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-hairline pb-2.5">
        <span class="mono-eyebrow text-cyan flex items-center gap-1.5">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Prepayment Payoff Acceleration
        </span>
        <span id="double-verification-badge" class="font-mono text-[11px] text-mute flex items-center gap-1">
          <span class="h-1.5 w-1.5 rounded-full bg-link"></span>
          Double-Verified Math
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono">
        <div>
          <span class="text-mute block">Total Interest Saved:</span>
          <span id="savings-interest-text" class="text-base font-semibold text-cyan">₹ 0</span>
        </div>
        <div>
          <span class="text-mute block">Payoff Time Saved:</span>
          <span id="savings-time-text" class="text-base font-semibold text-link">0 Months</span>
        </div>
        <div>
          <span class="text-mute block">New Loan Tenure:</span>
          <span id="savings-new-tenure-text" class="text-base font-semibold text-ink">20 Years</span>
        </div>
      </div>
    </div>

    <!-- Visual Breakdown Section (OmniCalculator lightweight CSS/SVG visual feedback) -->
    <div class="space-y-3 pt-2">
      <div class="flex items-center justify-between text-xs font-mono">
        <span class="flex items-center gap-1.5 text-link">
          <span class="h-2 w-2 rounded-full bg-link"></span>
          Principal: <span id="principal-pct-label">48.0%</span>
        </span>
        <span class="flex items-center gap-1.5 text-violet">
          <span class="h-2 w-2 rounded-full bg-violet"></span>
          Interest: <span id="interest-pct-label">52.0%</span>
        </span>
        <span id="savings-pct-container" class="hidden sm:flex items-center gap-1.5 text-cyan">
          <span class="h-2 w-2 rounded-full bg-cyan"></span>
          Savings: <span id="savings-pct-label">0.0%</span>
        </span>
      </div>

      <div class="flex h-3.5 w-full overflow-hidden rounded-full bg-canvas border border-hairline">
        <div id="bar-principal" class="h-full bg-link transition-all duration-300" style="width: 48%;"></div>
        <div id="bar-interest" class="h-full bg-violet transition-all duration-300" style="width: 52%;"></div>
      </div>
    </div>

    <!-- Multi-Tab Amortization Schedule (Calculator.net Feature) -->
    <div class="border-t border-hairline pt-4 space-y-3">
      <details class="group rounded-[8px] border border-hairline bg-canvas" open>
        <summary class="flex min-h-[44px] items-center justify-between p-3.5 cursor-pointer list-none text-xs font-semibold text-ink hover:text-link transition-colors">
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span class="pr-2">Amortization Schedule & Breakdown</span>
          </span>
          <div class="flex items-center gap-2">
            <span class="text-xs text-mute group-open:rotate-180 transition-transform">▼</span>
          </div>
        </summary>

        <div class="p-3.5 pt-0 space-y-3">
          <!-- Schedule View Multi-Tab Switcher -->
          <div class="flex items-center justify-between border-b border-hairline pb-2.5">
            <div class="inline-flex rounded-[6px] border border-hairline bg-canvas-elevated p-0.5 text-xs font-medium font-mono">
              <button
                id="amort-tab-yearly"
                type="button"
                aria-label="Show Yearly Amortization Breakdown"
                aria-pressed="true"
                class="rounded-[4px] bg-primary px-3 py-1 min-h-[32px] sm:min-h-[26px] text-on-primary cursor-pointer transition-colors"
              >
                Yearly Breakdown
              </button>
              <button
                id="amort-tab-monthly"
                type="button"
                aria-label="Show Monthly Amortization Breakdown"
                aria-pressed="false"
                class="rounded-[4px] px-3 py-1 min-h-[32px] sm:min-h-[26px] text-ink hover:text-ink cursor-pointer transition-colors"
              >
                Monthly Breakdown
              </button>
            </div>
            <span id="schedule-counter-badge" class="text-[11px] font-mono text-mute">20 Years Total</span>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <p class="sm:hidden text-[11px] text-mute flex items-center gap-1 font-mono">
              <span>⇄ Swipe schedule horizontally</span>
            </p>
            <div class="flex items-center gap-2 ml-auto">
              <button
                type="button"
                id="print-amort-btn"
                class="inline-flex items-center gap-1.5 min-h-[36px] px-3 py-1.5 rounded-[6px] border border-hairline bg-canvas hover:bg-hairline-soft text-ink text-xs font-semibold transition-colors cursor-pointer"
                title="Print or Save Schedule as PDF"
              >
                <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                <span>Print / PDF</span>
              </button>
              <a
                href="/sheets/amortization-2026.csv"
                download="amortization-schedule-2026.csv"
                class="inline-flex items-center gap-1.5 min-h-[36px] px-3 py-1.5 rounded-[6px] border border-hairline bg-canvas hover:bg-hairline-soft text-ink text-xs font-semibold transition-colors cursor-pointer"
                title="Download CSV Spreadsheet"
              >
                <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>CSV Export</span>
              </a>
            </div>
          </div>

          <div class="overflow-x-auto max-w-full">
            <table class="w-full min-w-[480px] text-left text-xs font-mono">
              <thead>
                <tr class="border-b border-hairline text-mute">
                  <th class="py-2 pr-3">Period</th>
                  <th class="py-2 pr-3">Principal Paid</th>
                  <th class="py-2 pr-3">Interest Paid</th>
                  <th id="th-extra" class="py-2 pr-3 hidden text-cyan">Extra Paid</th>
                  <th class="py-2 pr-3">Total Payment</th>
                  <th class="py-2">Remaining Balance</th>
                </tr>
              </thead>
              <tbody id="amortization-table-body" class="divide-y divide-hairline-soft">
                <!-- Dynamically rendered -->
              </tbody>
            </table>
          </div>
        </div>
      </details>
    </div>

    <!-- Step-by-Step Mathematical Proof Generation (CalculatorSoup Feature) -->
    <div class="border-t border-hairline pt-4">
      <details class="group rounded-[8px] border border-hairline bg-canvas">
        <summary class="flex min-h-[44px] items-center justify-between p-3.5 cursor-pointer list-none text-xs font-semibold text-ink hover:text-link transition-colors">
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
            <span class="pr-2">Step-by-Step Mathematical Proof (Formula Substitution)</span>
          </span>
          <span class="text-xs text-mute group-open:rotate-180 transition-transform">▼</span>
        </summary>

        <div class="p-3.5 pt-0 space-y-4 font-mono text-xs text-body" id="proof-container">
          <p class="text-mute leading-relaxed">
            Reducing balance amortization evaluates loan payments through the following exact closed-form algebraic formula:
          </p>
          <div class="rounded-[6px] border border-hairline bg-canvas-elevated p-3 text-center text-ink font-semibold">
            E = [ P × r × (1 + r)ⁿ ] ÷ [ (1 + r)ⁿ - 1 ]
          </div>
          <div id="proof-steps-body" class="space-y-3 divide-y divide-hairline-soft">
            <!-- Dynamically rendered step substitutions -->
          </div>
        </div>
      </details>
    </div>

    <!-- History Drawer -->
    <HistoryDrawer calculatorId="emi" />
  </div>

  <!-- Educational Deep-Dive Content (Slot) -->
  <div slot="content" class="space-y-8">
    <FormulaSection
      formula="E = P × r × (1 + r)ⁿ ÷ ((1 + r)ⁿ - 1)"
      explanation="The equated monthly installment (EMI) formula calculates equal payments over the repayment schedule using the reducing balance method. With each monthly installment, interest is evaluated solely on the remaining balance."
      variables={[
        { symbol: 'E', meaning: 'Equated Monthly Installment (EMI)' },
        { symbol: 'P', meaning: 'Principal loan amount borrowed' },
        { symbol: 'r', meaning: 'Monthly interest rate = (Annual Rate ÷ 12 ÷ 100)' },
        { symbol: 'n', meaning: 'Total number of monthly installments (Years × 12)' },
      ]}
    />

    <WorkedExample
      title="Worked Example: Home Loan Calculation"
      scenario="You take a Home Loan of ₹25,00,000 ($25 Lakhs) at an annual interest rate of 8.5% for a tenure of 20 years (240 months)."
      steps={[
        {
          number: 1,
          title: 'Determine the monthly interest rate (r)',
          description: 'Divide the 8.5% annual rate by 12 months, then by 100.',
          mathExpression: 'r = 8.5 ÷ 12 ÷ 100 = 0.0070833',
        },
        {
          number: 2,
          title: 'Compute the compounding factor (1 + r)ⁿ',
          description: 'Compound over 240 months: (1 + 0.0070833)²⁴⁰ ≈ 5.4274.',
          mathExpression: '(1 + 0.0070833)²⁴⁰ = 5.4274',
        },
        {
          number: 3,
          title: 'Calculate monthly EMI',
          description: 'E = ₹25,00,000 × 0.0070833 × 5.4274 ÷ (5.4274 - 1).',
          mathExpression: 'E = ₹21,696 per month',
        },
        {
          number: 4,
          title: 'Compute total interest over 20 years',
          description: 'Total Payment = 240 × ₹21,696 = ₹52,06,935. Total Interest = ₹52,06,935 - ₹25,00,000.',
          mathExpression: 'Total Interest = ₹27,06,935',
        },
      ]}
      conclusion="Your monthly EMI is ₹21,696. Across 20 years, total interest paid is ₹27,06,935, totaling ₹52,06,935 in lifetime payments."
    />

    <FAQSection faqs={faqs} />
  </div>
</CalculatorLayout>

<script>
  import { parseSmartInput } from '../../utils/smartParser';
  import { calculateAdvancedEMI, generateEMIProof, verifyMath } from '../../utils/financialMath';

  declare const window: any;

  (function () {
    const activeCode = typeof window.facGetActiveCurrency === 'function'
      ? window.facGetActiveCurrency()
      : (new URLSearchParams(window.location.search).get('currency') || localStorage.getItem('fac_currency') || 'USD');
    const activeInfo = typeof window.facGetCurrencyInfo === 'function'
      ? window.facGetCurrencyInfo(activeCode)
      : { symbol: activeCode === 'INR' ? '₹' : '$', isIndian: activeCode === 'INR' };

    let currentCurrencySymbol = activeInfo?.symbol || (activeCode === 'INR' ? '₹' : '$');
    let isIndianFormat = activeInfo ? !!activeInfo.isIndian : (activeCode === 'INR');
    let tenureIsYears = true;
    let scheduleTabMode: 'yearly' | 'monthly' = 'yearly';

    const principalInput = document.getElementById('emi-principal') as HTMLInputElement | null;
    const principalSlider = document.getElementById('emi-principal-slider') as HTMLInputElement | null;
    const principalDisplay = document.getElementById('principal-display');
    const principalSymbol = document.getElementById('principal-symbol');

    const rateInput = document.getElementById('emi-rate') as HTMLInputElement | null;
    const rateSlider = document.getElementById('emi-rate-slider') as HTMLInputElement | null;
    const rateDisplay = document.getElementById('rate-display');

    const tenureInput = document.getElementById('emi-tenure') as HTMLInputElement | null;
    const tenureSlider = document.getElementById('emi-tenure-slider') as HTMLInputElement | null;
    const tenureDisplay = document.getElementById('tenure-display');

    const extraInput = document.getElementById('emi-extra') as HTMLInputElement | null;
    const extraSlider = document.getElementById('emi-extra-slider') as HTMLInputElement | null;
    const extraDisplay = document.getElementById('extra-display');
    const extraSymbol = document.getElementById('extra-symbol');

    const extraSavingsPanel = document.getElementById('extra-savings-panel');
    const savingsInterestText = document.getElementById('savings-interest-text');
    const savingsTimeText = document.getElementById('savings-time-text');
    const savingsNewTenureText = document.getElementById('savings-new-tenure-text');
    const savingsPctContainer = document.getElementById('savings-pct-container');
    const savingsPctLabel = document.getElementById('savings-pct-label');

    const tenureYrBtn = document.getElementById('tenure-yr-btn');
    const tenureMoBtn = document.getElementById('tenure-mo-btn');

    const formatStdBtn = document.getElementById('format-standard-btn');
    const formatIndBtn = document.getElementById('format-indian-btn');

    const amortTabYearly = document.getElementById('amort-tab-yearly');
    const amortTabMonthly = document.getElementById('amort-tab-monthly');
    const scheduleCounterBadge = document.getElementById('schedule-counter-badge');
    const thExtra = document.getElementById('th-extra');

    const barPrincipal = document.getElementById('bar-principal');
    const barInterest = document.getElementById('bar-interest');
    const principalPctLabel = document.getElementById('principal-pct-label');
    const interestPctLabel = document.getElementById('interest-pct-label');

    const amortTableBody = document.getElementById('amortization-table-body');
    const proofStepsBody = document.getElementById('proof-steps-body');

    let currentCalculationData: ReturnType<typeof calculateAdvancedEMI> | null = null;

    function formatVal(num: number, decimals: number = 0): string {
      if ((window as any).facFormatNumber) {
        return (window as any).facFormatNumber(num, decimals, isIndianFormat);
      }
      return num.toLocaleString();
    }

    function calculate() {
      const pParsed = parseSmartInput(principalInput?.value || '0');
      const P = isNaN(pParsed) ? 0 : pParsed;
      const annualRate = parseFloat(rateInput?.value || '0');
      const tenureVal = parseFloat(tenureInput?.value || '0');
      const extraParsed = parseSmartInput(extraInput?.value || '0');
      const extraMonthly = isNaN(extraParsed) ? 0 : extraParsed;

      const totalMonths = tenureIsYears ? Math.round(tenureVal * 12) : Math.round(tenureVal);

      if (principalDisplay) principalDisplay.textContent = `${currentCurrencySymbol} ${formatVal(P, 0)}`;
      if (rateDisplay) rateDisplay.textContent = `${annualRate.toFixed(2)}%`;
      if (extraDisplay) extraDisplay.textContent = `${currentCurrencySymbol} ${formatVal(extraMonthly, 0)}`;

      if (tenureDisplay) {
        if (tenureIsYears) {
          tenureDisplay.textContent = `${tenureVal} Years (${totalMonths} Mo)`;
        } else {
          tenureDisplay.textContent = `${tenureVal} Months (${(tenureVal / 12).toFixed(1)} Yr)`;
        }
      }

      if (P <= 0 || isNaN(annualRate) || totalMonths <= 0) {
        return;
      }

      // Advanced Calculation with Prepayment & Double Verification
      const res = calculateAdvancedEMI(P, annualRate, totalMonths, extraMonthly);
      currentCalculationData = res;

      // Animate Main Results
      if ((window as any).facAnimateNumber) {
        (window as any).facAnimateNumber('emi-monthly-result', res.regularEMI, { isIndian: isIndianFormat, decimals: 0 });
        (window as any).facAnimateNumber('emi-interest-result', res.totalInterestWithPrepayment, { isIndian: isIndianFormat, decimals: 0 });
        (window as any).facAnimateNumber('emi-total-result', res.totalPaymentWithPrepayment, { isIndian: isIndianFormat, decimals: 0 });
      }

      // Prepayment Savings Display (Calculator.net feature)
      if (extraMonthly > 0 && res.interestSaved > 0) {
        if (extraSavingsPanel) extraSavingsPanel.classList.remove('hidden');
        if (savingsInterestText) savingsInterestText.textContent = `${currentCurrencySymbol} ${formatVal(res.interestSaved, 0)}`;
        if (savingsTimeText) {
          const yrs = Math.floor(res.monthsSaved / 12);
          const mos = res.monthsSaved % 12;
          savingsTimeText.textContent = yrs > 0 ? `${yrs} Yrs ${mos} Mo (${res.monthsSaved} Mo)` : `${mos} Months`;
        }
        if (savingsNewTenureText) {
          const actualYrs = (res.actualTenureMonths / 12).toFixed(1);
          savingsNewTenureText.textContent = `${actualYrs} Years (${res.actualTenureMonths} Mo)`;
        }
        if (savingsPctContainer && savingsPctLabel) {
          savingsPctContainer.classList.remove('hidden');
          savingsPctLabel.textContent = `${res.savingsRatio}%`;
        }
        if (thExtra) thExtra.classList.remove('hidden');
      } else {
        if (extraSavingsPanel) extraSavingsPanel.classList.add('hidden');
        if (savingsPctContainer) savingsPctContainer.classList.add('hidden');
        if (thExtra) thExtra.classList.add('hidden');
      }

      // Update Breakdown Progress Bar (OmniCalculator lightweight CSS visual)
      if (barPrincipal) barPrincipal.style.width = `${res.principalRatio}%`;
      if (barInterest) barInterest.style.width = `${res.interestRatio}%`;
      if (principalPctLabel) principalPctLabel.textContent = `${res.principalRatio}%`;
      if (interestPctLabel) interestPctLabel.textContent = `${res.interestRatio}%`;

      // Render Amortization Schedule Table
      renderAmortizationTable();

      // Render Step-by-Step Mathematical Proof (CalculatorSoup feature)
      renderProof(P, annualRate, totalMonths, res.regularEMI, extraMonthly, res.interestSaved);

      // Debounced History Storage
      clearTimeout((window as any).__emiHistoryTimeout);
      (window as any).__emiHistoryTimeout = setTimeout(() => {
        if (typeof (window as any).facAddHistory === 'function') {
          (window as any).facAddHistory({
            label: `Loan: ${currentCurrencySymbol} ${formatVal(P, 0)}`,
            summary: `@ ${annualRate}% for ${tenureIsYears ? `${tenureVal} yrs` : `${tenureVal} mo`}${extraMonthly > 0 ? ` (+${currentCurrencySymbol}${formatVal(extraMonthly, 0)}/mo)` : ''}`,
            result: `EMI: ${currentCurrencySymbol} ${formatVal(res.regularEMI, 0)}`,
            inputs: {
              principal: P,
              rate: annualRate,
              tenure: tenureVal,
              extra: extraMonthly,
              tenureIsYears: tenureIsYears,
              isIndianFormat: isIndianFormat,
            },
          });
        }
      }, 1500);
    }

    function renderAmortizationTable() {
      if (!amortTableBody || !currentCalculationData) return;
      const data = scheduleTabMode === 'yearly'
        ? currentCalculationData.yearlySchedule
        : currentCalculationData.monthlySchedule;

      if (scheduleCounterBadge) {
        scheduleCounterBadge.textContent = scheduleTabMode === 'yearly'
          ? `${data.length} Years Breakdown`
          : `${data.length} Months Breakdown`;
      }

      const hasExtra = currentCalculationData.interestSaved > 0;
      let html = '';

      for (let i = 0; i < data.length; i++) {
        const row = data[i];
        html += `
          <tr class="hover:bg-canvas-elevated">
            <td class="py-2 pr-3 font-semibold text-ink">${row.label}</td>
            <td class="py-2 pr-3 text-link">${currentCurrencySymbol} ${formatVal(row.principalPaid, 0)}</td>
            <td class="py-2 pr-3 text-violet">${currentCurrencySymbol} ${formatVal(row.interestPaid, 0)}</td>
            ${hasExtra ? `<td class="py-2 pr-3 text-cyan">${currentCurrencySymbol} ${formatVal(row.extraPayment, 0)}</td>` : ''}
            <td class="py-2 pr-3 text-body">${currentCurrencySymbol} ${formatVal(row.totalPayment, 0)}</td>
            <td class="py-2 text-ink font-medium">${currentCurrencySymbol} ${formatVal(row.remainingBalance, 0)}</td>
          </tr>
        `;
      }

      amortTableBody.innerHTML = html;
    }

    function renderProof(
      p: number,
      annualRate: number,
      tenureMonths: number,
      emi: number,
      extraMonthly: number,
      interestSaved: number
    ) {
      if (!proofStepsBody) return;
      const proofSteps = generateEMIProof(p, annualRate, tenureMonths, emi, currentCurrencySymbol);

      let html = '';
      for (let i = 0; i < proofSteps.length; i++) {
        const step = proofSteps[i];
        html += `
          <div class="pt-2">
            <div class="flex items-center justify-between text-ink font-semibold">
              <span>Step ${step.stepNumber}: ${step.title}</span>
              <span class="text-link font-medium">${step.result}</span>
            </div>
            <p class="text-mute text-[11px] mt-0.5">${step.description}</p>
            <div class="mt-1 rounded bg-canvas-elevated px-2 py-1 text-ink text-[11px]">
              ${step.substitution}
            </div>
          </div>
        `;
      }

      if (extraMonthly > 0 && interestSaved > 0) {
        html += `
          <div class="pt-2 border-t border-hairline">
            <div class="flex items-center justify-between text-ink font-semibold">
              <span>Step 6: Prepayment Differential Benefit</span>
              <span class="text-cyan font-medium">Saved ${currentCurrencySymbol} ${formatVal(interestSaved, 0)}</span>
            </div>
            <p class="text-mute text-[11px] mt-0.5">By adding ${currentCurrencySymbol} ${formatVal(extraMonthly, 0)} directly to principal repayment each month, the total interest incurred drops from baseline to accelerated schedule.</p>
            <div class="mt-1 rounded bg-canvas-elevated px-2 py-1 text-ink text-[11px]">
              Interest Saved = Baseline Interest - Accelerated Interest = ${currentCurrencySymbol}${formatVal(interestSaved, 0)}
            </div>
          </div>
        `;
      }

      proofStepsBody.innerHTML = html;
    }

    // 50ms Debounced Reactivity Handler (OmniCalculator feature)
    let debounceTimer: ReturnType<typeof setTimeout> | undefined;
    function triggerDebouncedCalculate() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        calculate();
      }, 50);
    }

    // Slider <-> Input synchronization with Smart Parsing on Change/Blur
    if (principalInput && principalSlider) {
      principalInput.addEventListener('input', () => {
        const parsed = parseSmartInput(principalInput.value);
        if (!isNaN(parsed) && parsed > 0) {
          if (parsed > parseFloat(principalSlider.max)) {
            principalSlider.max = String(parsed * 1.5);
          }
          principalSlider.value = String(parsed);
        }
        triggerDebouncedCalculate();
      });

      principalInput.addEventListener('blur', () => {
        const parsed = parseSmartInput(principalInput.value);
        if (!isNaN(parsed) && parsed > 0) {
          principalInput.value = String(parsed);
          calculate();
        }
      });

      principalSlider.addEventListener('input', () => {
        principalInput.value = principalSlider.value;
        triggerDebouncedCalculate();
      });
    }

    if (rateInput && rateSlider) {
      rateInput.addEventListener('input', () => {
        rateSlider.value = rateInput.value;
        triggerDebouncedCalculate();
      });
      rateSlider.addEventListener('input', () => {
        rateInput.value = rateSlider.value;
        triggerDebouncedCalculate();
      });
    }

    if (tenureInput && tenureSlider) {
      tenureInput.addEventListener('input', () => {
        tenureSlider.value = tenureInput.value;
        triggerDebouncedCalculate();
      });
      tenureSlider.addEventListener('input', () => {
        tenureInput.value = tenureSlider.value;
        triggerDebouncedCalculate();
      });
    }

    if (extraInput && extraSlider) {
      extraInput.addEventListener('input', () => {
        const parsed = parseSmartInput(extraInput.value);
        if (!isNaN(parsed) && parsed >= 0) {
          if (parsed > parseFloat(extraSlider.max)) {
            extraSlider.max = String(parsed * 1.5);
          }
          extraSlider.value = String(parsed);
        }
        triggerDebouncedCalculate();
      });

      extraInput.addEventListener('blur', () => {
        const parsed = parseSmartInput(extraInput.value);
        if (!isNaN(parsed) && parsed >= 0) {
          extraInput.value = String(parsed);
          calculate();
        }
      });

      extraSlider.addEventListener('input', () => {
        extraInput.value = extraSlider.value;
        triggerDebouncedCalculate();
      });
    }

    // Multi-Tab Schedule Toggles (Calculator.net feature)
    amortTabYearly?.addEventListener('click', () => {
      scheduleTabMode = 'yearly';
      amortTabYearly.className = 'rounded-[4px] bg-primary px-3 py-1 min-h-[32px] sm:min-h-[26px] text-on-primary cursor-pointer transition-colors';
      amortTabMonthly!.className = 'rounded-[4px] px-3 py-1 min-h-[32px] sm:min-h-[26px] text-ink hover:text-ink cursor-pointer transition-colors';
      amortTabYearly.setAttribute('aria-pressed', 'true');
      amortTabMonthly!.setAttribute('aria-pressed', 'false');
      renderAmortizationTable();
    });

    amortTabMonthly?.addEventListener('click', () => {
      scheduleTabMode = 'monthly';
      amortTabMonthly.className = 'rounded-[4px] bg-primary px-3 py-1 min-h-[32px] sm:min-h-[26px] text-on-primary cursor-pointer transition-colors';
      amortTabYearly!.className = 'rounded-[4px] px-3 py-1 min-h-[32px] sm:min-h-[26px] text-ink hover:text-ink cursor-pointer transition-colors';
      amortTabMonthly.setAttribute('aria-pressed', 'true');
      amortTabYearly!.setAttribute('aria-pressed', 'false');
      renderAmortizationTable();
    });

    // Tenure Toggle
    tenureYrBtn?.addEventListener('click', () => {
      tenureIsYears = true;
      tenureYrBtn.className = 'rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium bg-primary text-on-primary';
      tenureMoBtn!.className = 'rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium text-ink';
      tenureYrBtn.setAttribute('aria-pressed', 'true');
      tenureMoBtn!.setAttribute('aria-pressed', 'false');
      if (tenureSlider) {
        tenureSlider.max = '30';
        tenureSlider.value = '20';
      }
      if (tenureInput) tenureInput.value = '20';
      calculate();
    });

    tenureMoBtn?.addEventListener('click', () => {
      tenureIsYears = false;
      tenureMoBtn.className = 'rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium bg-primary text-on-primary';
      tenureYrBtn!.className = 'rounded px-2.5 py-1 sm:py-0.5 min-h-[44px] sm:min-h-[26px] font-medium text-ink';
      tenureMoBtn.setAttribute('aria-pressed', 'true');
      tenureYrBtn!.setAttribute('aria-pressed', 'false');
      if (tenureSlider) {
        tenureSlider.max = '360';
        tenureSlider.value = '240';
      }
      if (tenureInput) tenureInput.value = '240';
      calculate();
    });

    // Format Toggle
    formatStdBtn?.addEventListener('click', () => {
      isIndianFormat = false;
      formatStdBtn.className = 'rounded-[4px] bg-primary px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-on-primary cursor-pointer transition-colors';
      formatIndBtn!.className = 'rounded-[4px] px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-ink hover:text-ink cursor-pointer transition-colors';
      formatStdBtn.setAttribute('aria-pressed', 'true');
      formatIndBtn!.setAttribute('aria-pressed', 'false');
      calculate();
    });

    formatIndBtn?.addEventListener('click', () => {
      isIndianFormat = true;
      formatIndBtn.className = 'rounded-[4px] bg-primary px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-on-primary cursor-pointer transition-colors';
      formatStdBtn!.className = 'rounded-[4px] px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-ink hover:text-ink cursor-pointer transition-colors';
      formatIndBtn.setAttribute('aria-pressed', 'true');
      formatStdBtn!.setAttribute('aria-pressed', 'false');
      calculate();
    });

    // Preset chips
    document.querySelectorAll('.preset-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const amt = chip.getAttribute('data-amount');
        if (amt && principalInput && principalSlider) {
          principalInput.value = amt;
          principalSlider.value = amt;
          calculate();
        }
      });
    });

    function updateCurrencyUI() {
      if (principalSymbol) principalSymbol.textContent = currentCurrencySymbol;
      if (extraSymbol) extraSymbol.textContent = currentCurrencySymbol;

      ['emi-monthly-result-prefix', 'emi-interest-result-prefix', 'emi-total-result-prefix'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.textContent = `${currentCurrencySymbol} `;
      });

      ['emi-monthly-result', 'emi-interest-result', 'emi-total-result'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) {
          el.setAttribute('data-prefix', `${currentCurrencySymbol} `);
          el.setAttribute('data-indian', isIndianFormat ? 'true' : 'false');
        }
      });

      if (isIndianFormat) {
        if (formatIndBtn) formatIndBtn.className = 'rounded-[4px] bg-primary px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-on-primary cursor-pointer transition-colors';
        if (formatStdBtn) formatStdBtn.className = 'rounded-[4px] px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-ink hover:text-ink cursor-pointer transition-colors';
      } else {
        if (formatStdBtn) formatStdBtn.className = 'rounded-[4px] bg-primary px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-on-primary cursor-pointer transition-colors';
        if (formatIndBtn) formatIndBtn.className = 'rounded-[4px] px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-ink hover:text-ink cursor-pointer transition-colors';
      }
    }

    let lastActiveCurrency = typeof (window as any).facGetActiveCurrency === 'function'
      ? (window as any).facGetActiveCurrency()
      : (localStorage.getItem('fac_currency') || 'USD');

    // Currency Switcher reaction
    window.addEventListener('currencychange', (e: any) => {
      const newCurr = e.detail.currency;
      const prevCurr = e.detail.prevCurrency || lastActiveCurrency;

      if (prevCurr && newCurr && prevCurr !== newCurr && typeof (window as any).facConvertCurrency === 'function') {
        const pVal = parseSmartInput(principalInput?.value || '0');
        if (!isNaN(pVal) && pVal > 0) {
          const convertedP = (window as any).facConvertCurrency(pVal, prevCurr, newCurr);
          const roundedP = Math.round(convertedP);
          if (principalInput) principalInput.value = String(roundedP);
          if (principalSlider) {
            if (roundedP > parseFloat(principalSlider.max)) {
              principalSlider.max = String(roundedP * 2);
            }
            principalSlider.value = String(roundedP);
          }
        }
      }
      lastActiveCurrency = newCurr;

      currentCurrencySymbol = e.detail.symbol;
      isIndianFormat = e.detail.isIndian;
      updateCurrencyUI();
      calculate();
      if (typeof (window as any).facSyncUrlState === 'function') {
        (window as any).facSyncUrlState();
      }
    });

    // URL State Sharing
    (window as any).facSyncUrlState = function () {
      const params = new URLSearchParams(window.location.search);
      params.set('p', principalInput?.value || '2500000');
      params.set('r', rateInput?.value || '8.5');
      params.set('t', tenureInput?.value || '20');
      params.set('ty', tenureIsYears ? 'yr' : 'mo');
      params.set('ex', extraInput?.value || '0');
      params.set('fmt', isIndianFormat ? 'in' : 'std');
      const activeCurr = typeof (window as any).facGetActiveCurrency === 'function'
        ? (window as any).facGetActiveCurrency()
        : (localStorage.getItem('fac_currency') || 'USD');
      params.set('currency', activeCurr);
      window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
    };

    // Restore URL params
    const params = new URLSearchParams(window.location.search);
    if (params.has('p') && principalInput && principalSlider) {
      principalInput.value = params.get('p')!;
      principalSlider.value = params.get('p')!;
    }
    if (params.has('r') && rateInput && rateSlider) {
      rateInput.value = params.get('r')!;
      rateSlider.value = params.get('r')!;
    }
    if (params.has('t') && tenureInput && tenureSlider) {
      tenureInput.value = params.get('t')!;
      tenureSlider.value = params.get('t')!;
    }
    if (params.has('ex') && extraInput && extraSlider) {
      extraInput.value = params.get('ex')!;
      extraSlider.value = params.get('ex')!;
    }
    if (params.get('ty') === 'mo') tenureMoBtn?.click();
    if (params.get('fmt') === 'std') formatStdBtn?.click();

    // History Restore callback
    (window as any).facRestoreHistoryItem = function (item: any) {
      if (item.inputs) {
        if (principalInput && item.inputs.principal) {
          principalInput.value = item.inputs.principal;
          if (principalSlider) principalSlider.value = item.inputs.principal;
        }
        if (rateInput && item.inputs.rate) {
          rateInput.value = item.inputs.rate;
          if (rateSlider) rateSlider.value = item.inputs.rate;
        }
        if (tenureInput && item.inputs.tenure) {
          tenureInput.value = item.inputs.tenure;
          if (tenureSlider) tenureSlider.value = item.inputs.tenure;
        }
        if (extraInput && item.inputs.extra !== undefined) {
          extraInput.value = item.inputs.extra;
          if (extraSlider) extraSlider.value = item.inputs.extra;
        }
        if (item.inputs.tenureIsYears === false) {
          tenureMoBtn?.click();
        } else {
          tenureYrBtn?.click();
        }
      }
      calculate();
    };

    // Print / PDF Export listener
    document.getElementById('print-amort-btn')?.addEventListener('click', () => {
      window.print();
    });

    // Initial calculation with currency UI sync
    updateCurrencyUI();
    calculate();

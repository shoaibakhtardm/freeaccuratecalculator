  <!-- Educational & Bottom Content (Strictly hidden during PDF / Print) -->
  <div id="sip-bottom-content-area" class="print:hidden space-y-8 mt-6">
    <!-- Transparency Notice Card -->
    <div id="sip-transparency-card" class="rounded-[12px] border border-cyan/30 bg-cyan/5 p-4 sm:p-5 text-xs space-y-2">
      <div class="flex items-center gap-2 font-semibold text-cyan">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="font-mono uppercase tracking-wider text-[11px]">Compounding Transparency & Regional Timing Standards</span>
      </div>
      <p class="text-body leading-relaxed">
        Calculations utilize strict compound interest annuity mechanics with explicit <strong>Contribution Timing</strong> configuration. In India, mutual fund SIPs standardly execute at the <strong>beginning of the month</strong> (Annuity Due), which maximizes compounding by capturing a full month's return on every installment. In the US and international markets, periodic contributions conventionally occur at the <strong>end of the month</strong> (Ordinary Annuity). You can freely toggle between both modes above.
      </p>
      <div class="flex flex-wrap items-center gap-4 text-[11px] font-mono text-mute pt-1">
        <span>Zero Division Safe</span>
        <span>•</span>
        <span>SEBI / AMFI Mutual Fund Mathematical Standards</span>
        <span>•</span>
        <span>Pure Client-Side Execution</span>
      </div>
    </div>

    <!-- Formula Section -->
    <div id="sip-formula-wrapper">
      <FormulaSection
        title="SIP Compounding Mathematics & Annuity Mechanics"
        expression="Annuity Due: FV = P × [((1 + i)ⁿ - 1) ÷ i] × (1 + i) | Ordinary Annuity: FV = P × [((1 + i)ⁿ - 1) ÷ i]"
        explanation="For beginning-of-period investments (India standard), the entire series receives an extra period of compounding interest (1 + i). For end-of-period investments (US standard), deposits begin accruing return only in subsequent months. Zero-interest scenarios safely reduce to total invested capital P × n."
        variables={formulaVariables}
      />
    </div>

    <!-- Worked Example -->
    <div id="sip-worked-example-wrapper">
      <WorkedExample
        title="Worked Example: ₹10,000 Monthly SIP for 10 Years at 12%"
        scenario="An investor commits ₹10,000 on the 1st day of each month (Annuity Due) for 10 continuous years into a diversified equity fund averaging 12% annual return."
        steps={[
          {
            number: 1,
            title: 'Calculate Installment Parameters',
            description: 'Monthly interest rate i = 12% ÷ 12 = 1% = 0.01. Total number of installments n = 10 × 12 = 120.',
            mathExpression: 'i = 0.01, n = 120',
          },
          {
            number: 2,
            title: 'Compute Total Principal Invested',
            description: '120 payments × ₹10,000 = ₹12,00,000 total capital contributed.',
            mathExpression: 'Total Invested = ₹12,00,000',
          },
          {
            number: 3,
            title: 'Apply Annuity Due Compounding Formula',
            description: 'FV = 10,000 × [((1.01)¹²⁰ - 1) ÷ 0.01] × 1.01 = ₹23,23,391.',
            mathExpression: 'Maturity Corpus = ₹23,23,391',
          },
        ]}
        conclusion="Total accumulated wealth is ₹23,23,391, generating ₹11,23,391 in compounded wealth gain (+93.6% gain on invested capital)."
      />
    </div>

    <!-- Interactive Comparison Tool: SIP vs Lumpsum -->
    <div id="sip-comparison-wrapper">
      <div class="mb-2">
        <span class="mono-eyebrow text-link">Strategy Comparison</span>
        <h2 class="heading-md text-ink mt-1 font-display">SIP vs. Lumpsum Investment: Which Strategy Suits You?</h2>
      </div>
      <CalculatorComparison
        calculators={[
          {
            name: "Systematic Investment Plan (SIP)",
            slug: "/finance/sip-calculator/",
            description: "Invest a fixed amount periodically to average out market volatility and build wealth disciplined over time.",
            pros: [
              "Averages purchase cost across market dips (Rupee/Dollar Cost Averaging)",
              "Low barrier to entry (start with as little as $10 or ₹500/month)",
              "Removes emotional stress and market-timing guesswork"
            ],
            cons: [
              "May lag behind a lump sum during persistent, uninterrupted bull markets",
              "Requires steady, disciplined cash flow month after month"
            ]
          },
          {
            name: "Lumpsum Investment",
            slug: "/finance/compound-interest-calculator/",
            description: "Deploy an entire capital sum in one go to capture full-cycle compounding across the entire horizon.",
            pros: [
              "Puts 100% of capital to work immediately from Day 1",
              "Maximizes total compounding during extended secular bull runs",
              "Ideal for windfalls, bonuses, inheritance, or property sale proceeds"
            ],
            cons: [
              "High vulnerability to investing right before a major market correction",
              "Requires substantial upfront liquidity"
            ]
          }
        ]}
      />
    </div>

    <!-- Download & Export Section Card -->
    <div id="sip-bottom-export-wrapper" class="rounded-[16px] border border-hairline bg-canvas-elevated p-6 sm:p-8 space-y-4 shadow-whisper">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-5">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-link/10 text-link">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </span>
            <h3 class="text-base sm:text-lg font-bold text-ink tracking-tight font-display">Download SIP Wealth Report & Amortization Schedule</h3>
          </div>
          <p class="text-xs sm:text-sm text-mute leading-relaxed max-w-2xl">
            Instantly export your personalized wealth accumulation plan, year-by-year compounding schedule, and maturity projections in your preferred format.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-1 text-[11px] font-mono text-mute">
            <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-semibold">
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Excel / Google Sheets (.csv)
            </span>

---
// src/pages/finance/sip-calculator.astro
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ResultDisplay from '../../components/calculator/ResultDisplay.astro';
import FormulaSection from '../../components/calculator/FormulaSection.astro';
import WorkedExample from '../../components/calculator/WorkedExample.astro';
import FAQSection from '../../components/calculator/FAQSection.astro';
import HistoryDrawer from '../../components/calculator/HistoryDrawer.astro';
import CurrencySwitcher from '../../components/common/CurrencySwitcher.astro';
import SocialProof from '../../components/SocialProof.astro';
import CalculatorComparison from '../../components/CalculatorComparison.astro';

import { faqDatabase } from '../../data/faqDatabase';

const faqs = faqDatabase['sip-calculator'];

const relatedCalculators = [
  { title: 'Step-Up SIP Calculator', href: '/finance/step-up-sip-calculator/', badge: 'Wealth' },
  { title: 'Compound Interest', href: '/finance/compound-interest-calculator/' },
  { title: 'Lumpsum Calculator', href: '/finance/lumpsum-calculator/' },
  { title: 'EMI Calculator', href: '/finance/emi-calculator/' },
];

const formulaVariables = [
  { symbol: 'FV', meaning: 'Future Value (accumulated maturity corpus)' },
  { symbol: 'P', meaning: 'Monthly periodic investment installment' },
  { symbol: 'i', meaning: 'Monthly periodic interest rate (Annual rate ÷ 12 ÷ 100)' },
  { symbol: 'n', meaning: 'Total number of monthly installments (Years × 12)' },
  { symbol: '(1 + i)', meaning: 'Annuity Due factor applied when contributions occur at the beginning of the period' },
];
---

<CalculatorLayout
  title="SIP Calculator — Mutual Fund Systematic Investment Plan Growth Online"
  metaDescription="Calculate your SIP maturity corpus, invested capital, and wealth gain with flexible beginning vs end of month contribution timing and international currency support."
  h1="SIP Calculator"
  subtitle="Calculate projected maturity wealth, invested capital, and compounding returns on monthly mutual fund investments."
  category={{ label: 'Finance', href: '/finance/' }}
  calculatorName="SIP Calculator"
  relatedCalculators={relatedCalculators}
>
  <!-- Real-time Social Proof Widget -->
  <div id="sip-social-proof" class="print:hidden">
    <SocialProof calculatorName="SIP Calculator" />
  </div>

  <!-- Calculator Main Box -->
  <div id="sip-calculator-card" class="calculator-main-box relative rounded-[16px] border border-hairline bg-canvas-elevated p-4 sm:p-8 shadow-whisper space-y-6">
    <!-- Dedicated High-Fidelity Print/PDF Report (ONLY this is printed in PDF/Print) -->
    <div id="sip-print-report" class="hidden print:block">
      <!-- Website Official Header Letterhead -->
      <div class="border-b-2 border-slate-900 pb-4 mb-5 flex justify-between items-start">
        <div>
          <div class="text-2xl font-black uppercase tracking-tight text-slate-900">
            Free Accurate Calculator
          </div>
          <div class="text-sm font-bold text-blue-700 mt-0.5">
            Systematic Investment Plan (SIP) Compounding Statement
          </div>
          <div class="text-xs text-slate-500 mt-1 font-mono">
            freeaccuratecalculator.com • Verified Financial Computation Statement
          </div>
        </div>
        <div class="text-right text-xs font-mono text-slate-600 space-y-0.5">
          <div><span class="text-slate-400 uppercase">Generated:</span> <strong id="print-date" class="text-slate-900"></strong></div>
          <div><span class="text-slate-400 uppercase">Currency:</span> <strong id="print-currency-code" class="text-slate-900"></strong></div>
          <div><span class="text-slate-400 uppercase">Timing Mode:</span> <strong id="print-timing" class="text-slate-900"></strong></div>
        </div>
      </div>

      <!-- Calculation Inputs Summary -->
      <div class="bg-slate-50 border border-slate-200 rounded-lg p-3.5 mb-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2 font-mono">
          Investment Parameters
        </div>
        <div class="grid grid-cols-3 gap-4 text-xs font-mono">
          <div>
            <span class="text-slate-500 block text-[10px] uppercase">Monthly Deposit</span>
            <span id="print-monthly" class="text-sm font-bold text-slate-900"></span>
          </div>
          <div>
            <span class="text-slate-500 block text-[10px] uppercase">Expected Annual Return</span>
            <span id="print-rate" class="text-sm font-bold text-slate-900"></span>
          </div>
          <div>
            <span class="text-slate-500 block text-[10px] uppercase">Investment Horizon</span>
            <span id="print-years" class="text-sm font-bold text-slate-900"></span>
          </div>
        </div>
      </div>

      <!-- Calculation Results Key Metrics -->
      <div class="grid grid-cols-3 gap-3 mb-6">
        <div class="border border-slate-300 rounded-lg p-3.5 bg-white">
          <span class="text-[10px] font-bold uppercase text-slate-500 block font-mono">Total Capital Invested</span>
          <div id="print-invested" class="text-lg font-black text-blue-700 mt-1 font-mono"></div>
          <span class="text-[10px] text-slate-500">Cumulative Deposits</span>
        </div>
        <div class="border border-slate-300 rounded-lg p-3.5 bg-white">
          <span class="text-[10px] font-bold uppercase text-slate-500 block font-mono">Estimated Wealth Gain</span>
          <div id="print-gain" class="text-lg font-black text-cyan-700 mt-1 font-mono"></div>
          <span class="text-[10px] text-slate-500">Compound Returns</span>
        </div>
        <div class="border-2 border-slate-900 rounded-lg p-3.5 bg-slate-50">
          <span class="text-[10px] font-bold uppercase text-slate-900 block font-mono">Total Expected Maturity</span>
          <div id="print-maturity" class="text-lg font-black text-slate-900 mt-1 font-mono"></div>
          <span id="print-multiplier" class="text-[10px] font-semibold text-blue-700"></span>
        </div>
      </div>

      <!-- Full Year-by-Year Schedule Table -->
      <div class="space-y-2">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900 font-mono">
          Year-by-Year Wealth Accumulation Schedule
        </div>
        <table class="w-full text-left text-xs font-mono border-collapse">
          <thead>
            <tr class="border-b-2 border-slate-300 bg-slate-100 text-slate-700">
              <th class="py-2 px-2.5">Year</th>
              <th class="py-2 px-2.5 text-right">Monthly Deposit</th>
              <th class="py-2 px-2.5 text-right">Annual Deposit</th>
              <th class="py-2 px-2.5 text-right">Total Invested</th>
              <th class="py-2 px-2.5 text-right">Interest Earned</th>
              <th class="py-2 px-2.5 text-right">Ending Balance</th>
            </tr>
          </thead>
          <tbody id="print-schedule-body" class="divide-y divide-slate-200">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>

      <!-- Footer Branding & Verification -->
      <div class="mt-8 pt-3 border-t border-slate-200 flex justify-between items-center text-[10px] font-mono text-slate-500">
        <div>Generated by <strong>Free Accurate Calculator</strong> • https://freeaccuratecalculator.com</div>
        <div>Verified Pure Client-Side Computation • 100% Private</div>
      </div>
    </div>

    <!-- Screen UI Starts Here (All hidden during print) -->
    <!-- Currency & Presets Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-4 text-xs print:hidden">
      <div class="flex items-center gap-2.5">
        <label for="sip-currency-select" class="text-[11px] font-bold uppercase tracking-wider font-mono text-mute select-none">
          Currency
        </label>
        <CurrencySwitcher selectId="sip-currency-select" className="w-auto" showFullName={true} />
      </div>

      <!-- Quick Preset Chips -->
      <div id="sip-presets" class="flex items-center gap-1.5 overflow-x-auto text-[11px] font-medium text-mute pb-1 sm:pb-0">
        <span class="select-none shrink-0 font-mono text-[10px] uppercase tracking-wider font-bold text-mute">Presets:</span>
        <button type="button" aria-label="Preset 2,500 monthly investment" class="preset-chip shrink-0 rounded-[6px] border border-hairline bg-canvas px-2.5 py-1 min-h-[32px] sm:min-h-[26px] hover:text-ink hover:border-link/40 cursor-pointer font-mono font-medium transition-all text-xs" data-amount="2500">₹2.5k</button>
        <button type="button" aria-label="Preset 5,000 monthly investment" class="preset-chip shrink-0 rounded-[6px] border border-hairline bg-canvas px-2.5 py-1 min-h-[32px] sm:min-h-[26px] hover:text-ink hover:border-link/40 cursor-pointer font-mono font-medium transition-all text-xs" data-amount="5000">₹5k</button>
        <button type="button" aria-label="Preset 10,000 monthly investment" class="preset-chip shrink-0 rounded-[6px] border border-hairline bg-canvas px-2.5 py-1 min-h-[32px] sm:min-h-[26px] hover:text-ink hover:border-link/40 cursor-pointer font-mono font-medium transition-all text-xs" data-amount="10000">₹10k</button>
        <button type="button" aria-label="Preset 25,000 monthly investment" class="preset-chip shrink-0 rounded-[6px] border border-hairline bg-canvas px-2.5 py-1 min-h-[32px] sm:min-h-[26px] hover:text-ink hover:border-link/40 cursor-pointer font-mono font-medium transition-all text-xs" data-amount="25000">₹25k</button>
      </div>
    </div>

    <!-- Inputs Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 print:hidden">
      <!-- 1. Monthly Investment Amount -->
      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
          <label for="sip-monthly-amount">Monthly Investment</label>
          <span id="sip-amount-display" class="font-mono text-link text-sm tabular-nums font-bold">₹ 10,000</span>
        </div>
        <div class="relative flex items-center">
          <span id="sip-symbol-addon" class="absolute left-3.5 text-sm font-mono text-mute select-none font-bold">₹</span>
          <input
            id="sip-monthly-amount"
            type="number"
            min="100"
            step="500"
            value="10000"
            class="w-full min-h-[44px] rounded-[8px] border border-hairline bg-canvas py-2.5 pl-8 pr-3 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 tabular-nums font-semibold transition-all"
          />
        </div>
        <input
          id="sip-amount-slider"
          type="range"
          min="500"
          max="100000"
          step="500"
          value="10000"
          aria-label="Monthly investment amount slider"
          class="w-full accent-link cursor-pointer h-5"
        />
      </div>

      <!-- 2. Expected Annual Return Rate (%) -->
      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
          <label for="sip-return-rate">Expected Return Rate (% P.A.)</label>
          <span id="sip-rate-display" class="font-mono text-cyan text-sm tabular-nums font-bold">12.00%</span>
        </div>
        <div class="relative flex items-center">
          <input
            id="sip-return-rate"
            type="number"
            min="0"
            max="30"
            step="0.5"
            value="12.0"
            class="w-full min-h-[44px] rounded-[8px] border border-hairline bg-canvas py-2.5 pl-3 pr-8 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 tabular-nums font-semibold transition-all"
          />
          <span class="absolute right-3.5 text-sm font-mono text-mute select-none">%</span>
        </div>
        <input
          id="sip-rate-slider"
          type="range"
          min="1"
          max="30"
          step="0.5"
          value="12.0"
          aria-label="Expected annual return rate slider"
          class="w-full accent-cyan cursor-pointer h-5"
        />
        <!-- Quick Benchmark Chips -->
        <div class="flex items-center gap-1.5 pt-0.5">
          <button type="button" class="rate-benchmark-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-cyan/40 hover:text-cyan text-mute cursor-pointer transition-colors" data-rate="8">8% Debt</button>
          <button type="button" class="rate-benchmark-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-cyan/40 hover:text-cyan text-mute cursor-pointer transition-colors" data-rate="12">12% Index</button>
          <button type="button" class="rate-benchmark-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-cyan/40 hover:text-cyan text-mute cursor-pointer transition-colors" data-rate="15">15% Equity</button>
        </div>
      </div>

      <!-- 3. Investment Horizon (Years) -->
      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
          <label for="sip-years">Investment Horizon (Years)</label>
          <span id="sip-years-display" class="font-mono text-violet text-sm tabular-nums font-bold">10 Years (120 Mo)</span>
        </div>
        <input
          id="sip-years"
          type="number"
          min="1"
          max="40"
          step="1"
          value="10"
          class="w-full min-h-[44px] rounded-[8px] border border-hairline bg-canvas py-2.5 px-3 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 tabular-nums font-semibold transition-all"
        />
        <input
          id="sip-years-slider"
          type="range"
          min="1"
          max="40"
          step="1"
          value="10"
          aria-label="Investment horizon slider"
          class="w-full accent-violet cursor-pointer h-5"
        />
        <!-- Quick Tenure Chips -->
        <div class="flex items-center gap-1.5 pt-0.5">
          <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="5">5Y</button>
          <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="10">10Y</button>
          <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="15">15Y</button>
          <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-0.5 rounded border border-hairline bg-canvas hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="20">20Y</button>
        </div>
      </div>

      <!-- 4. Contribution Timing Selector -->
      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
          <label for="sip-timing-select">Contribution Timing</label>
          <span id="timing-badge" class="rounded-full bg-link/10 text-link border border-link/20 px-2.5 py-0.5 text-[11px] font-mono font-medium">Annuity Due (India Standard)</span>
        </div>
        <select
          id="sip-timing-select"
          class="w-full min-h-[44px] rounded-[8px] border border-hairline bg-canvas px-3 py-2.5 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 cursor-pointer"
        >
          <option value="beginning" selected>Beginning of Month (Annuity Due — India Standard)</option>
          <option value="end">End of Month (Ordinary Annuity — US Convention)</option>
        </select>
        <p class="text-[11px] text-mute leading-tight">
          Beginning-of-month deposits earn compounded return across all 30 days of the installment month.
        </p>
      </div>
    </div>

    <!-- Primary Results Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 print:hidden">
      <div class="relative group">
        <ResultDisplay
          id="sip-total-result"
          label="Expected Maturity Corpus"
          prefix="₹ "
          initialValue={2323391}
          decimals={0}
          secondary="Total Accumulated Wealth"
          accent="cyan"
        />
        <div class="absolute top-2.5 right-2.5">
          <span id="wealth-multiplier-badge" class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-cyan/15 text-cyan border border-cyan/30">
            1.94x Return
          </span>
        </div>
      </div>

      <ResultDisplay
        id="sip-invested-result"
        label="Total Capital Invested"
        prefix="₹ "
        initialValue={1200000}
        decimals={0}
        secondary="120 Monthly Installments"
        accent="link"
      />

      <div class="relative group">
        <ResultDisplay
          id="sip-gain-result"
          label="Estimated Wealth Gain"
          prefix="₹ "
          initialValue={1123391}
          decimals={0}
          secondary="Pure Compounded Growth"
          accent="violet"
        />
        <div class="absolute top-2.5 right-2.5">
          <span id="gain-pct-badge" class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-violet/15 text-violet border border-violet/30">
            +93.6% Gain
          </span>
        </div>
      </div>
    </div>

    <!-- Growth Distribution Spectrum Bar -->
    <div class="space-y-2 pt-1 print:hidden">
      <div class="flex items-center justify-between text-xs font-mono">
        <span class="text-link font-medium">Invested: <span id="bar-invested-label" class="tabular-nums font-bold">₹ 12,00,000 (51.6%)</span></span>
        <span class="text-cyan font-medium">Wealth Gain: <span id="bar-gain-label" class="tabular-nums font-bold">₹ 11,23,391 (48.4%)</span></span>
      </div>
      <div class="h-3 w-full overflow-hidden rounded-full bg-canvas border border-hairline flex">
        <div id="spectrum-invested" class="h-full bg-link transition-all duration-300" style="width: 51.6%;"></div>
        <div id="spectrum-gain" class="h-full bg-cyan transition-all duration-300" style="width: 48.4%;"></div>
      </div>
    </div>

    <!-- Milestone & Inflation Insights Bar -->
    <div class="rounded-[10px] border border-hairline bg-canvas/60 p-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 text-xs print:hidden">
      <div class="flex items-center gap-2 text-ink">
        <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span id="sip-crossover-insight" class="font-mono text-[11px] sm:text-xs">
          <strong>Milestone:</strong> In <span class="text-cyan font-semibold">Year 8</span>, your compound earnings surpass your total invested capital!
        </span>
      </div>
      <div class="flex items-center gap-2 text-mute font-mono text-[11px] shrink-0">
        <span>Real Value (at 6% inflation):</span>
        <strong id="sip-inflation-adjusted" class="text-ink">₹ 12,97,358</strong>
      </div>
    </div>

    <!-- High-Visibility Primary Action Toolbar (Directly Below Results) -->
    <div class="pt-1 border-t border-hairline flex flex-wrap items-center justify-between gap-3 print:hidden">
      <div class="flex flex-wrap items-center gap-2">
        <!-- PDF Export Button -->
        <button
          type="button"
          id="action-download-pdf-btn"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-[8px] bg-link hover:bg-link-hover active:scale-95 text-white text-xs font-semibold shadow-xs transition-all cursor-pointer"
          title="Download Verified PDF Wealth Statement"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download PDF</span>
        </button>

        <!-- Excel Export Button -->
        <button
          type="button"
          id="action-download-excel-btn"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-[8px] bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white text-xs font-semibold shadow-xs transition-all cursor-pointer"
          title="Download Amortization Schedule in Excel/CSV"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Download Excel</span>
        </button>
      </div>

      <div class="flex items-center gap-2">
        <!-- Copy Summary Button -->
        <button
          type="button"
          id="action-copy-summary-btn"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-[8px] border border-hairline bg-canvas hover:bg-hairline-soft text-ink text-xs font-semibold transition-colors cursor-pointer"
          title="Copy formatted investment summary to clipboard"
        >
          <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span id="copy-summary-text">Copy Summary</span>
        </button>

        <!-- Share Link Button -->
        <button
          type="button"
          id="action-share-link-btn"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-[8px] border border-hairline bg-canvas hover:bg-hairline-soft text-ink text-xs font-semibold transition-colors cursor-pointer"
          title="Copy shareable link with current inputs"
        >
          <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span id="share-link-text">Share</span>
        </button>
      </div>
    </div>

    <!-- Annual Accumulation Schedule Table -->
    <div class="space-y-3 pt-2 print:hidden">
      <div class="overflow-x-auto rounded-[8px] border border-hairline bg-canvas">
        <table class="w-full min-w-[520px] text-left text-xs font-mono">
          <thead class="border-b border-hairline bg-canvas-elevated text-mute">
            <tr>
              <th class="py-2.5 px-3 whitespace-nowrap">Year</th>
              <th class="py-2.5 px-3 text-right whitespace-nowrap">Annual Deposit</th>
              <th class="py-2.5 px-3 text-right whitespace-nowrap">Total Invested</th>
              <th class="py-2.5 px-3 text-right whitespace-nowrap">Interest Earned</th>
              <th class="py-2.5 px-3 text-right whitespace-nowrap">Ending Corpus</th>
            </tr>
          </thead>
          <tbody id="sip-schedule-body" class="divide-y divide-hairline text-ink">
            <!-- Dynamic rows populated by script -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Toast Notification Alert -->
  <div
    id="sip-toast"
    class="fixed bottom-5 right-5 z-50 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-200 ease-out flex items-center gap-2 px-4 py-2.5 rounded-[8px] bg-slate-900 text-white text-xs font-mono shadow-lg border border-slate-700"
  >
    <svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">

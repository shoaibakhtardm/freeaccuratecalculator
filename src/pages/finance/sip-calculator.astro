  <HistoryDrawer />
</CalculatorLayout>

<script>
  import { calculateSIP, type ContributionTiming } from '../../engines/investment';

  // Active state
  let currentCurrencyCode = typeof (window as any).facGetActiveCurrency === 'function'
    ? (window as any).facGetActiveCurrency()
    : (localStorage.getItem('fac_currency') || 'INR');

  let currencyInfo = typeof (window as any).facGetCurrencyInfo === 'function'
    ? (window as any).facGetCurrencyInfo(currentCurrencyCode)
    : { symbol: '₹', isIndian: currentCurrencyCode === 'INR', name: 'Indian Rupee' };

  let currentCurrencySymbol = currencyInfo.symbol || '₹';
  let isIndianFormat = currencyInfo.isIndian ?? (currentCurrencyCode === 'INR');

  // DOM Elements
  const currencySelect = document.getElementById('sip-currency-select') as HTMLSelectElement;
  const timingSelect = document.getElementById('sip-timing-select') as HTMLSelectElement;
  const timingBadge = document.getElementById('timing-badge');
  const amountInput = document.getElementById('sip-monthly-amount') as HTMLInputElement;
  const amountSlider = document.getElementById('sip-amount-slider') as HTMLInputElement;
  const rateInput = document.getElementById('sip-return-rate') as HTMLInputElement;
  const rateSlider = document.getElementById('sip-rate-slider') as HTMLInputElement;
  const yearsInput = document.getElementById('sip-years') as HTMLInputElement;
  const yearsSlider = document.getElementById('sip-years-slider') as HTMLInputElement;

  const amountDisplay = document.getElementById('sip-amount-display');
  const rateDisplay = document.getElementById('sip-rate-display');
  const yearsDisplay = document.getElementById('sip-years-display');
  const symbolAddon = document.getElementById('sip-symbol-addon');
  const presetsContainer = document.getElementById('sip-presets');
  const scheduleBody = document.getElementById('sip-schedule-body');
  const printScheduleBody = document.getElementById('print-schedule-body');

  const toastEl = document.getElementById('sip-toast');
  const toastMsg = document.getElementById('sip-toast-message');
  let toastTimeout: any = null;

  function showToast(message: string) {
    if (!toastEl || !toastMsg) return;
    toastMsg.textContent = message;
    toastEl.classList.remove('opacity-0', 'translate-y-12', 'pointer-events-none');
    toastEl.classList.add('opacity-100', 'translate-y-0');
    if (toastTimeout) clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => {
      toastEl.classList.remove('opacity-100', 'translate-y-0');
      toastEl.classList.add('opacity-0', 'translate-y-12', 'pointer-events-none');
    }, 2500);
  }

  // Number & Currency Formatting helper
  function formatCurrencyValue(val: number, isIndian: boolean, decimals: number = 0): string {
    if (typeof (window as any).facFormatNumber === 'function') {
      return (window as any).facFormatNumber(val, decimals, isIndian);
    }
    return val.toLocaleString(isIndian ? 'en-IN' : 'en-US', {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    });
  }

  // Presets definition per currency
  function getPresetsForCurrency(curr: string, isIndian: boolean) {
    if (isIndian || curr === 'INR') {
      return [
        { label: '₹2.5k', value: 2500 },
        { label: '₹5k', value: 5000 },
        { label: '₹10k', value: 10000 },
        { label: '₹25k', value: 25000 },
      ];
    }
    if (curr === 'JPY') {
      return [
        { label: '¥10k', value: 10000 },
        { label: '¥25k', value: 25000 },
        { label: '¥50k', value: 50000 },
        { label: '¥100k', value: 100000 },
      ];
    }
    if (curr === 'AED' || curr === 'SAR') {
      return [
        { label: `${currentCurrencySymbol}500`, value: 500 },
        { label: `${currentCurrencySymbol}1k`, value: 1000 },
        { label: `${currentCurrencySymbol}2.5k`, value: 2500 },
        { label: `${currentCurrencySymbol}5k`, value: 5000 },
      ];
    }
    return [
      { label: `${currentCurrencySymbol}100`, value: 100 },
      { label: `${currentCurrencySymbol}250`, value: 250 },
      { label: `${currentCurrencySymbol}500`, value: 500 },
      { label: `${currentCurrencySymbol}1k`, value: 1000 },
    ];
  }

  function updateSliderBounds(curr: string, isIndian: boolean) {
    if (!amountSlider) return;
    if (isIndian || curr === 'INR') {
      amountSlider.min = '500';
      amountSlider.max = '100000';
      amountSlider.step = '500';
      if (amountInput) amountInput.step = '500';
    } else if (curr === 'JPY') {
      amountSlider.min = '1000';
      amountSlider.max = '500000';
      amountSlider.step = '1000';
      if (amountInput) amountInput.step = '1000';
    } else {
      amountSlider.min = '25';
      amountSlider.max = '10000';
      amountSlider.step = '25';
      if (amountInput) amountInput.step = '25';
    }
  }

  function renderPresets() {
    if (!presetsContainer) return;
    const presets = getPresetsForCurrency(currentCurrencyCode, isIndianFormat);
    const currentVal = parseFloat(amountInput?.value || '0');

    let html = '<span class="select-none shrink-0 font-mono text-[10px] uppercase tracking-wider font-bold text-mute">Presets:</span>';
    presets.forEach((p) => {
      const isActive = Math.abs(currentVal - p.value) < 1;
      const activeClass = isActive
        ? 'bg-link text-white border-link font-semibold shadow-2xs'
        : 'border-hairline bg-canvas text-mute hover:text-ink hover:border-link/40';
      html += `
        <button
          type="button"
          class="preset-chip shrink-0 rounded-[6px] border px-2.5 py-1 min-h-[32px] sm:min-h-[26px] cursor-pointer transition-all duration-150 tabular-nums font-mono text-xs ${activeClass}"
          data-amount="${p.value}"
        >${p.label}</button>
      `;
    });

    presetsContainer.innerHTML = html;

    presetsContainer.querySelectorAll('.preset-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = (btn as HTMLElement).dataset.amount || '0';
        if (amountInput) {
          amountInput.value = val;
          if (amountSlider) {
            if (parseFloat(val) > parseFloat(amountSlider.max)) {
              amountSlider.max = String(parseFloat(val) * 1.5);
            }
            amountSlider.value = val;
          }
          renderPresets();
          recalculate();
          syncUrlState();
        }
      });
    });
  }

  function updateCurrencyUI() {
    // 1. Symbol Addon in input
    if (symbolAddon) symbolAddon.textContent = currentCurrencySymbol;

    // 2. Result Display Prefixes
    ['sip-total-result-prefix', 'sip-invested-result-prefix', 'sip-gain-result-prefix'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.textContent = `${currentCurrencySymbol} `;
    });

    // 3. Result Display data attributes
    ['sip-total-result', 'sip-invested-result', 'sip-gain-result'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        el.setAttribute('data-prefix', `${currentCurrencySymbol} `);
        el.setAttribute('data-indian', isIndianFormat ? 'true' : 'false');
      }
    });

    // 4. Update Slider bounds & Presets
    updateSliderBounds(currentCurrencyCode, isIndianFormat);
    renderPresets();

    // 5. Sync Currency Switcher dropdown
    if (currencySelect && currencySelect.value !== currentCurrencyCode) {
      currencySelect.value = currentCurrencyCode;
    }
  }

  function handleCurrencySwitch(newCurr: string, prevCurr?: string) {
    if (!newCurr) return;
    const prev = prevCurr || currentCurrencyCode;
    currentCurrencyCode = newCurr;

    const info = typeof (window as any).facGetCurrencyInfo === 'function'
      ? (window as any).facGetCurrencyInfo(newCurr)
      : { symbol: '$', isIndian: newCurr === 'INR' };

    currentCurrencySymbol = info.symbol || '$';
    isIndianFormat = info.isIndian ?? (newCurr === 'INR');

    // Convert amount if switching between different currencies
    if (prev && newCurr && prev !== newCurr && typeof (window as any).facConvertCurrency === 'function') {
      const currentAmount = parseFloat(amountInput?.value || '0');
      if (currentAmount > 0) {
        const converted = (window as any).facConvertCurrency(currentAmount, prev, newCurr);
        const rounded = isIndianFormat || newCurr === 'JPY'
          ? Math.round(converted / 100) * 100
          : Math.round(converted / 10) * 10;
        const finalVal = Math.max(isIndianFormat ? 500 : 25, rounded || (isIndianFormat ? 5000 : 250));
        if (amountInput) amountInput.value = String(finalVal);
        if (amountSlider) {
          if (finalVal > parseFloat(amountSlider.max)) {
            amountSlider.max = String(finalVal * 2);
          }
          amountSlider.value = String(finalVal);
        }
      }
    }

    // Default timing standard: Annuity Due for India, Ordinary Annuity for Western
    if (timingSelect && !timingSelect.dataset.userTouched) {
      timingSelect.value = isIndianFormat ? 'beginning' : 'end';
      updateTimingBadge();
    }

    updateCurrencyUI();
    recalculate();
    syncUrlState();
  }

  function updateTimingBadge() {
    if (!timingBadge || !timingSelect) return;
    const isBeg = timingSelect.value === 'beginning';
    timingBadge.textContent = isBeg ? 'Annuity Due (India Standard)' : 'Ordinary Annuity (US Standard)';
    timingBadge.className = isBeg
      ? 'rounded-full bg-link/10 text-link border border-link/20 px-2.5 py-0.5 text-[11px] font-mono font-medium'
      : 'rounded-full bg-violet/10 text-violet border border-violet/20 px-2.5 py-0.5 text-[11px] font-mono font-medium';
  }

  function recalculate() {
    const p = Math.max(0, parseFloat(amountInput?.value || '0') || 0);
    const rate = Math.max(0, parseFloat(rateInput?.value || '0') || 0);
    const years = Math.max(0, parseFloat(yearsInput?.value || '0') || 0);
    const timing = (timingSelect?.value || 'beginning') as ContributionTiming;

    // Interactive input display updates
    if (amountDisplay) amountDisplay.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(p, isIndianFormat)}`;
    if (rateDisplay) rateDisplay.textContent = `${rate.toFixed(2)}%`;
    if (yearsDisplay) yearsDisplay.textContent = `${years} Years (${Math.round(years * 12)} Mo)`;

    // Compute SIP
    const res = calculateSIP(p, rate, years, timing);

    // Animate or update Result Cards
    if (typeof (window as any).facAnimateNumber === 'function') {
      (window as any).facAnimateNumber('sip-total-result', res.totalValue, { isIndian: isIndianFormat, decimals: 0 });
      (window as any).facAnimateNumber('sip-invested-result', res.investedAmount, { isIndian: isIndianFormat, decimals: 0 });
      (window as any).facAnimateNumber('sip-gain-result', res.estimatedReturns, { isIndian: isIndianFormat, decimals: 0 });
    } else {
      const totalEl = document.getElementById('sip-total-result');
      const invEl = document.getElementById('sip-invested-result');
      const gainEl = document.getElementById('sip-gain-result');
      if (totalEl) totalEl.textContent = formatCurrencyValue(res.totalValue, isIndianFormat);
      if (invEl) invEl.textContent = formatCurrencyValue(res.investedAmount, isIndianFormat);
      if (gainEl) gainEl.textContent = formatCurrencyValue(res.estimatedReturns, isIndianFormat);
    }

    // Wealth Multiplier & Gain Pct Badges
    const multiplier = res.investedAmount > 0 ? (res.totalValue / res.investedAmount).toFixed(2) : '1.00';
    const gainPct = res.investedAmount > 0 ? ((res.estimatedReturns / res.investedAmount) * 100).toFixed(1) : '0.0';
    const multBadge = document.getElementById('wealth-multiplier-badge');
    const gainBadge = document.getElementById('gain-pct-badge');
    if (multBadge) multBadge.textContent = `${multiplier}x Return`;
    if (gainBadge) gainBadge.textContent = `+${gainPct}% Gain`;

    // Update Spectrum Bar
    const total = res.totalValue || 1;
    const investedPct = Math.min(100, Math.max(0, (res.investedAmount / total) * 100));
    const gainBarPct = Math.max(0, 100 - investedPct);

    const specInvested = document.getElementById('spectrum-invested');
    const specGain = document.getElementById('spectrum-gain');
    if (specInvested) specInvested.style.width = `${investedPct.toFixed(1)}%`;
    if (specGain) specGain.style.width = `${gainBarPct.toFixed(1)}%`;

    const barInvLabel = document.getElementById('bar-invested-label');
    const barGainLabel = document.getElementById('bar-gain-label');
    if (barInvLabel) barInvLabel.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(res.investedAmount, isIndianFormat)} (${investedPct.toFixed(1)}%)`;
    if (barGainLabel) barGainLabel.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(res.estimatedReturns, isIndianFormat)} (${gainBarPct.toFixed(1)}%)`;

    // Crossover Milestone Detection
    const crossoverEl = document.getElementById('sip-crossover-insight');
    if (crossoverEl && res.yearlyBreakdown) {
      let crossoverYear = 0;
      for (const row of res.yearlyBreakdown) {
        const cumulativeGains = row.totalValue - row.investedAmount;
        if (cumulativeGains >= row.investedAmount) {
          crossoverYear = row.year;
          break;
        }
      }
      if (crossoverYear > 0) {
        crossoverEl.innerHTML = `<strong>Milestone:</strong> In <span class="text-cyan font-bold">Year ${crossoverYear}</span>, your cumulative compound gains surpass your total invested capital!`;
      } else {
        crossoverEl.innerHTML = `<strong>Milestone:</strong> Maintain a disciplined SIP to allow compounding to surpass principal over longer horizons.`;
      }
    }

    // Inflation-Adjusted Corpus (6% standard assumed inflation)
    const inflationEl = document.getElementById('sip-inflation-adjusted');
    if (inflationEl) {
      const inflationRate = 0.06;
      const realValue = res.totalValue / Math.pow(1 + inflationRate, years);
      inflationEl.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(Math.round(realValue), isIndianFormat)}`;
    }

    // Render Year-by-Year Schedule Table
    renderSchedule(res.yearlyBreakdown || [], p);

    // Update Print-only Report Metadata
    updatePrintMetadata(res, p, rate, years, timing, multiplier);
  }

  function updatePrintMetadata(res: import('../../engines/investment').SIPResult, p: number, rate: number, years: number, timing: ContributionTiming, multiplier: string) {
    const printDate = document.getElementById('print-date');
    const printCurr = document.getElementById('print-currency-code');
    const printTiming = document.getElementById('print-timing');
    const printMonthly = document.getElementById('print-monthly');
    const printRate = document.getElementById('print-rate');
    const printYears = document.getElementById('print-years');
    const printInvested = document.getElementById('print-invested');
    const printGain = document.getElementById('print-gain');
    const printMaturity = document.getElementById('print-maturity');
    const printMult = document.getElementById('print-multiplier');

    if (printDate) printDate.textContent = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    if (printCurr) printCurr.textContent = `${currentCurrencyCode} (${currentCurrencySymbol})`;
    if (printTiming) printTiming.textContent = timing === 'beginning' ? 'Annuity Due (Beginning)' : 'Ordinary Annuity (End)';
    if (printMonthly) printMonthly.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(p, isIndianFormat)}`;
    if (printRate) printRate.textContent = `${rate.toFixed(2)}% P.A.`;
    if (printYears) printYears.textContent = `${years} Years (${Math.round(years * 12)} Months)`;
    if (printInvested) printInvested.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(res.investedAmount, isIndianFormat)}`;
    if (printGain) printGain.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(res.estimatedReturns, isIndianFormat)}`;
    if (printMaturity) printMaturity.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(res.totalValue, isIndianFormat)}`;
    if (printMult) printMult.textContent = `Wealth Multiplier: ${multiplier}x`;
  }

  function renderSchedule(breakdown: import('../../engines/investment').SIPYearlyBreakdown[], monthlyDeposit: number) {
    let screenHtml = '';
    let printHtml = '';

    const maxRows = Math.min(breakdown.length, 50);
    for (let i = 0; i < maxRows; i++) {
      const row = breakdown[i];
      const annualDeposit = monthlyDeposit * 12;

      screenHtml += `
        <tr class="hover:bg-canvas-subtle/50 transition-colors">
          <td class="py-2.5 px-3 font-semibold text-link whitespace-nowrap">Year ${row.year}</td>
          <td class="py-2.5 px-3 text-right tabular-nums font-mono whitespace-nowrap">${currentCurrencySymbol} ${formatCurrencyValue(annualDeposit, isIndianFormat)}</td>
          <td class="py-2.5 px-3 text-right tabular-nums font-mono text-mute whitespace-nowrap">${currentCurrencySymbol} ${formatCurrencyValue(row.investedAmount, isIndianFormat)}</td>
          <td class="py-2.5 px-3 text-right tabular-nums font-mono text-violet font-semibold whitespace-nowrap" title="Yearly Growth">${currentCurrencySymbol} ${formatCurrencyValue(row.yearlyGrowth, isIndianFormat)}</td>
          <td class="py-2.5 px-3 text-right tabular-nums font-mono font-bold text-cyan whitespace-nowrap">${currentCurrencySymbol} ${formatCurrencyValue(row.totalValue, isIndianFormat)}</td>
        </tr>
      `;

      printHtml += `
        <tr class="border-b border-slate-200">
          <td class="py-1.5 px-2.5 font-bold text-blue-700">Year ${row.year}</td>
          <td class="py-1.5 px-2.5 text-right font-mono">${currentCurrencySymbol} ${formatCurrencyValue(monthlyDeposit, isIndianFormat)}</td>
          <td class="py-1.5 px-2.5 text-right font-mono">${currentCurrencySymbol} ${formatCurrencyValue(annualDeposit, isIndianFormat)}</td>
          <td class="py-1.5 px-2.5 text-right font-mono text-slate-700">${currentCurrencySymbol} ${formatCurrencyValue(row.investedAmount, isIndianFormat)}</td>
          <td class="py-1.5 px-2.5 text-right font-mono text-cyan-700 font-semibold">${currentCurrencySymbol} ${formatCurrencyValue(row.yearlyGrowth, isIndianFormat)}</td>
          <td class="py-1.5 px-2.5 text-right font-mono font-bold text-slate-900">${currentCurrencySymbol} ${formatCurrencyValue(row.totalValue, isIndianFormat)}</td>
        </tr>
      `;
    }

    if (scheduleBody) scheduleBody.innerHTML = screenHtml;
    if (printScheduleBody) printScheduleBody.innerHTML = printHtml;
  }

  function syncUrlState() {
    try {
      const url = new URL(window.location.href);
      url.searchParams.set('p', amountInput?.value || '10000');
      url.searchParams.set('r', rateInput?.value || '12');
      url.searchParams.set('y', yearsInput?.value || '10');
      url.searchParams.set('t', timingSelect?.value || 'beginning');
      url.searchParams.set('currency', currentCurrencyCode);
      window.history.replaceState({}, '', url.toString());
    } catch (_) {}
  }

  function loadUrlState() {
    try {
      const params = new URLSearchParams(window.location.search);
      const p = params.get('p');
      const r = params.get('r');
      const y = params.get('y');
      const t = params.get('t');
      const curr = params.get('currency');

      if (curr) {
        currentCurrencyCode = curr.toUpperCase();
      }

      if (p && amountInput) {
        amountInput.value = p;
        if (amountSlider) {
          if (parseFloat(p) > parseFloat(amountSlider.max)) amountSlider.max = String(parseFloat(p) * 1.5);
          amountSlider.value = p;
        }
      }

      if (r && rateInput) {
        rateInput.value = r;
        if (rateSlider) rateSlider.value = r;
      }

      if (y && yearsInput) {
        yearsInput.value = y;
        if (yearsSlider) yearsSlider.value = y;
      }

      if (t && timingSelect && (t === 'beginning' || t === 'end')) {
        timingSelect.value = t;
        timingSelect.dataset.userTouched = 'true';
      }
    } catch (_) {}
  }

  // Two-way slider-input bindings
  amountInput?.addEventListener('input', () => {
    if (amountSlider) amountSlider.value = amountInput.value;
    renderPresets();
    recalculate();
    syncUrlState();
  });
  amountSlider?.addEventListener('input', () => {
    if (amountInput) amountInput.value = amountSlider.value;
    renderPresets();
    recalculate();
    syncUrlState();
  });

  rateInput?.addEventListener('input', () => {
    if (rateSlider) rateSlider.value = rateInput.value;
    recalculate();
    syncUrlState();
  });
  rateSlider?.addEventListener('input', () => {
    if (rateInput) rateInput.value = rateSlider.value;
    recalculate();
    syncUrlState();
  });

  yearsInput?.addEventListener('input', () => {
    if (yearsSlider) yearsSlider.value = yearsInput.value;
    recalculate();
    syncUrlState();
  });
  yearsSlider?.addEventListener('input', () => {
    if (yearsInput) yearsInput.value = yearsSlider.value;
    recalculate();
    syncUrlState();
  });

  // Benchmark rate quick chips
  document.querySelectorAll('.rate-benchmark-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const rate = (btn as HTMLElement).dataset.rate;
      if (rate && rateInput && rateSlider) {
        rateInput.value = rate;
        rateSlider.value = rate;
        recalculate();
        syncUrlState();
      }
    });
  });

  // Tenure quick chips
  document.querySelectorAll('.tenure-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const yrs = (btn as HTMLElement).dataset.years;
      if (yrs && yearsInput && yearsSlider) {
        yearsInput.value = yrs;
        yearsSlider.value = yrs;
        recalculate();
        syncUrlState();
      }
    });
  });

  // Local currency selector change
  currencySelect?.addEventListener('change', () => {
    const newCurr = currencySelect.value;
    if (typeof (window as any).facSetActiveCurrency === 'function') {
      (window as any).facSetActiveCurrency(newCurr);
    } else {
      handleCurrencySwitch(newCurr, currentCurrencyCode);
    }
  });

  // Global currency change event listener
  window.addEventListener('currencychange', (e: any) => {
    const newCurr = e.detail?.currency;
    const prevCurr = e.detail?.prevCurrency || currentCurrencyCode;
    if (newCurr) {
      handleCurrencySwitch(newCurr, prevCurr);
    }
  });

  timingSelect?.addEventListener('change', () => {
    timingSelect.dataset.userTouched = 'true';
    updateTimingBadge();
    recalculate();
    syncUrlState();
  });

  // Excel (.csv) Export — Website Branding + Pure Calculation Only
  function downloadExcel() {
    const p = Math.max(0, parseFloat(amountInput?.value || '0') || 0);
    const rate = Math.max(0, parseFloat(rateInput?.value || '0') || 0);
    const years = Math.max(0, parseFloat(yearsInput?.value || '0') || 0);
    const timing = (timingSelect?.value || 'beginning') as ContributionTiming;
    const timingName = timing === 'beginning'
      ? 'Annuity Due (Beginning of Month)'
      : 'Ordinary Annuity (End of Month)';

    const res = calculateSIP(p, rate, years, timing);
    const dateStr = new Date().toISOString().slice(0, 10);
    const multiplier = res.investedAmount > 0 ? (res.totalValue / res.investedAmount).toFixed(2) : '1.00';

    const csvRows: string[][] = [
      ['Free Accurate Calculator — freeaccuratecalculator.com'],
      ['SIP Investment & Wealth Accumulation Statement'],
      ['Date', dateStr],
      ['Currency', `${currentCurrencyCode} (${currentCurrencySymbol})`],
      ['Contribution Standard', timingName],
      [],
      ['CALCULATION PARAMETERS', ''],
      ['Monthly Investment Deposit', `${currentCurrencySymbol} ${formatCurrencyValue(p, isIndianFormat)}`],
      ['Expected Annual Return Rate', `${rate.toFixed(2)}% P.A.`],
      ['Investment Horizon', `${years} Years (${Math.round(years * 12)} Monthly Installments)`],
      [],
      ['CALCULATION RESULTS', ''],
      ['Total Principal Capital Invested', `${currentCurrencySymbol} ${formatCurrencyValue(res.investedAmount, isIndianFormat)}`],
      ['Estimated Wealth Gain (Interest Returns)', `${currentCurrencySymbol} ${formatCurrencyValue(res.estimatedReturns, isIndianFormat)}`],
      ['Total Expected Maturity Corpus', `${currentCurrencySymbol} ${formatCurrencyValue(res.totalValue, isIndianFormat)}`],
      ['Wealth Multiplier', `${multiplier}x`],
      [],
      ['YEAR-BY-YEAR WEALTH PROGRESSION SCHEDULE'],
      ['Year', 'Monthly Deposit', 'Annual Deposit', 'Cumulative Capital Invested', 'Interest Earned (Yearly Growth)', 'Ending Balance (Corpus)']
    ];

    const breakdown = res.yearlyBreakdown || [];
    for (let i = 0; i < breakdown.length; i++) {
      const row = breakdown[i];
      csvRows.push([
        `Year ${row.year}`,
        `${currentCurrencySymbol} ${formatCurrencyValue(p, isIndianFormat)}`,
        `${currentCurrencySymbol} ${formatCurrencyValue(p * 12, isIndianFormat)}`,
        `${currentCurrencySymbol} ${formatCurrencyValue(row.investedAmount, isIndianFormat)}`,
        `${currentCurrencySymbol} ${formatCurrencyValue(row.yearlyGrowth, isIndianFormat)}`,
        `${currentCurrencySymbol} ${formatCurrencyValue(row.totalValue, isIndianFormat)}`
      ]);
    }

    csvRows.push([]);
    csvRows.push(['Verified By', 'Free Accurate Calculator — Client-Side Financial Engine']);
    csvRows.push(['Website', 'https://freeaccuratecalculator.com/finance/sip-calculator/']);

    const escapeCsv = (val: any) => `"${String(val ?? '').replace(/"/g, '""')}"`;
    const csvContent = '\uFEFF' + csvRows.map(row => row.map(escapeCsv).join(',')).join('\r\n');

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `SIP_Wealth_Statement_${currentCurrencyCode}_${years}Y_${dateStr}.csv`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

    showToast('Excel spreadsheet downloaded!');
  }

  // Print / PDF Report Export — Website Branding + Pure Calculation Only
  function downloadPDF() {
    recalculate();
    window.print();
  }

  // Copy Structured Calculation Summary
  function copyCalculationSummary() {
    const p = Math.max(0, parseFloat(amountInput?.value || '0') || 0);
    const rate = Math.max(0, parseFloat(rateInput?.value || '0') || 0);
    const years = Math.max(0, parseFloat(yearsInput?.value || '0') || 0);
    const timing = (timingSelect?.value || 'beginning') as ContributionTiming;
    const res = calculateSIP(p, rate, years, timing);
    const multiplier = res.investedAmount > 0 ? (res.totalValue / res.investedAmount).toFixed(2) : '1.00';

    const text = [
      `💰 SIP Investment Wealth Summary — Free Accurate Calculator`,
      `----------------------------------------------------`,
      `• Monthly Investment: ${currentCurrencySymbol} ${formatCurrencyValue(p, isIndianFormat)}`,
      `• Expected Return Rate: ${rate.toFixed(2)}% P.A.`,
      `• Duration: ${years} Years (${Math.round(years * 12)} Months)`,
      `• Contribution Timing: ${timing === 'beginning' ? 'Beginning of Month (Annuity Due)' : 'End of Month (Ordinary Annuity)'}`,
      `----------------------------------------------------`,
      `• Total Capital Invested: ${currentCurrencySymbol} ${formatCurrencyValue(res.investedAmount, isIndianFormat)}`,
      `• Estimated Wealth Gain: ${currentCurrencySymbol} ${formatCurrencyValue(res.estimatedReturns, isIndianFormat)}`,
      `• Total Maturity Corpus: ${currentCurrencySymbol} ${formatCurrencyValue(res.totalValue, isIndianFormat)}`,
      `• Wealth Multiplier: ${multiplier}x Return`,
      `----------------------------------------------------`,
      `Calculate online: ${window.location.href}`
    ].join('\n');

    navigator.clipboard.writeText(text).then(() => {
      showToast('Summary copied to clipboard!');
    }).catch(() => {
      showToast('Unable to copy to clipboard');
    });
  }

  // Share Current Link
  function shareCalculationLink() {
    syncUrlState();
    navigator.clipboard.writeText(window.location.href).then(() => {
      showToast('Link copied to clipboard!');
    }).catch(() => {
      showToast('Unable to copy link');
    });
  }

  // Bind Export & Action Buttons
  document.getElementById('action-download-pdf-btn')?.addEventListener('click', downloadPDF);
  document.getElementById('action-download-excel-btn')?.addEventListener('click', downloadExcel);
  document.getElementById('action-copy-summary-btn')?.addEventListener('click', copyCalculationSummary);
  document.getElementById('action-share-link-btn')?.addEventListener('click', shareCalculationLink);

  document.getElementById('sip-download-excel-btn')?.addEventListener('click', downloadExcel);
  document.getElementById('table-download-excel-btn')?.addEventListener('click', downloadExcel);
  document.getElementById('sip-download-pdf-btn')?.addEventListener('click', downloadPDF);
  document.getElementById('table-download-pdf-btn')?.addEventListener('click', downloadPDF);

  // Initialize
  loadUrlState();
  updateCurrencyUI();
  updateTimingBadge();
  recalculate();
</script>


---
// src/pages/finance/sip-calculator.astro
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import FormulaSection from '../../components/calculator/FormulaSection.astro';
import WorkedExample from '../../components/calculator/WorkedExample.astro';
import FAQSection from '../../components/calculator/FAQSection.astro';
import HistoryDrawer from '../../components/calculator/HistoryDrawer.astro';
import SocialProof from '../../components/SocialProof.astro';
import CalculatorComparison from '../../components/CalculatorComparison.astro';

import { faqDatabase } from '../../data/faqDatabase';

const faqs = faqDatabase['sip-calculator'];

const relatedCalculators = [
  { title: 'Step-Up SIP Calculator', href: '/finance/step-up-sip-calculator/', badge: 'Popular' },
  { title: 'Compound Interest', href: '/finance/compound-interest-calculator/' },
  { title: 'Lumpsum Calculator', href: '/finance/lumpsum-calculator/' },
  { title: 'EMI Calculator', href: '/finance/emi-calculator/' },
];

const formulaVariables = [
  { symbol: 'FV', meaning: 'Future Value (accumulated maturity wealth corpus)' },
  { symbol: 'P', meaning: 'Monthly periodic investment installment' },
  { symbol: 'i', meaning: 'Monthly periodic interest rate (Annual rate ÷ 12 ÷ 100)' },
  { symbol: 'n', meaning: 'Total number of monthly installments (Years × 12)' },
  { symbol: '(1 + i)', meaning: 'Annuity Due compounding factor applied when deposits occur at the beginning of the period' },
];

// High-intent structured data schema
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://freeaccuratecalculator.com/finance/sip-calculator/#webapp',
      'url': 'https://freeaccuratecalculator.com/finance/sip-calculator/',
      'name': 'SIP Calculator — Mutual Fund Systematic Investment Plan Growth Planner',
      'applicationCategory': 'FinanceApplication',
      'operatingSystem': 'All',
      'browserRequirements': 'Requires JavaScript. Requires HTML5.',
      'description': 'Free accurate SIP calculator for mutual funds. Calculate maturity wealth, compounding returns, annual step-up top-up, inflation-adjusted real value, and PDF/Excel reports.',
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': 'USD',
      },
      'featureList': [
        'Annuity Due and Ordinary Annuity calculations',
        'Annual Step-Up SIP Simulator (+5%, +10%, +15%, Custom %)',
        'Inflation-adjusted real wealth purchasing power',
        '3-Scenario Sensitivity Matrix (Conservative, Base, Aggressive)',
        'Cost of Delay Estimator (waiting 1, 3, 5 years)',
        'Milestone Roadmap (Time to ₹10L, ₹25L, ₹50L, ₹1Cr, ₹5Cr)',
        'Year-by-year amortization schedule',
        'Printable PDF Statement & Excel (.csv) export',
        '100% Client-side privacy guarantee'
      ]
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://freeaccuratecalculator.com/finance/sip-calculator/#breadcrumb',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': 'https://freeaccuratecalculator.com/'
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Finance',
          'item': 'https://freeaccuratecalculator.com/finance/'
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': 'SIP Calculator',
          'item': 'https://freeaccuratecalculator.com/finance/sip-calculator/'
        }
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://freeaccuratecalculator.com/finance/sip-calculator/#faq',
      'mainEntity': faqs.map((faq) => ({
        '@type': 'Question',
        'name': faq.question,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': faq.answer,
        },
      })),
    }
  ]
};
---

<CalculatorLayout
  title="SIP Calculator — Mutual Fund Systematic Investment Plan Growth & Wealth Planner"
  metaDescription="Free accurate SIP calculator for mutual funds. Calculate maturity wealth, compounding returns, annual step-up top-up, inflation-adjusted real value, and PDF/Excel reports."
  h1="SIP Calculator"
  subtitle="Calculate projected maturity wealth, invested capital, and compounding returns on monthly mutual fund investments with Step-Up and Inflation adjustments."
  category={{ label: 'Finance', href: '/finance/' }}
  calculatorName="SIP Calculator"
  relatedCalculators={relatedCalculators}
  schema={schema}
>
  <!-- Real-time Social Proof Widget -->
  <div id="sip-social-proof" class="print:hidden">
    <SocialProof calculatorName="SIP Calculator" />
  </div>

  <!-- Calculator Main Box -->
  <div id="sip-calculator-card" class="calculator-main-box relative rounded-[20px] border border-hairline bg-canvas-elevated p-4 sm:p-8 shadow-whisper space-y-6 overflow-hidden transition-all pb-24 sm:pb-8">

    <!-- Subtle Ambient Gradient Glow -->
    <div class="pointer-events-none absolute -top-32 -right-32 w-80 h-80 rounded-full bg-link/10 blur-3xl print:hidden"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-32 w-80 h-80 rounded-full bg-cyan/10 blur-3xl print:hidden"></div>

    <!-- Dedicated High-Fidelity Print/PDF Report (ONLY this is printed in PDF/Print) -->
    <div id="sip-print-report" class="hidden print:block">
      <!-- Website Official Header Letterhead -->
      <div class="border-b-2 border-slate-900 pb-4 mb-5 flex justify-between items-start">
        <div>
          <div class="text-2xl font-black uppercase tracking-tight text-slate-900">
            Free Accurate Calculator
          </div>
          <div class="text-sm font-bold text-blue-700 mt-0.5">
            Systematic Investment Plan (SIP) Compounding Statement
          </div>
          <div class="text-xs text-slate-500 mt-1 font-mono">
            freeaccuratecalculator.com • Verified Financial Computation Statement
          </div>
        </div>
        <div class="text-right text-xs font-mono text-slate-600 space-y-0.5">
          <div><span class="text-slate-400 uppercase">Generated:</span> <strong id="print-date" class="text-slate-900"></strong></div>
          <div><span class="text-slate-400 uppercase">Currency:</span> <strong id="print-currency-code" class="text-slate-900"></strong></div>
          <div><span class="text-slate-400 uppercase">Mode:</span> <strong id="print-mode-label" class="text-slate-900">Wealth Accumulation</strong></div>
          <div><span class="text-slate-400 uppercase">Timing Standard:</span> <strong id="print-timing" class="text-slate-900"></strong></div>
        </div>
      </div>

      <!-- Calculation Inputs Summary -->
      <div class="bg-slate-50 border border-slate-200 rounded-lg p-3.5 mb-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2 font-mono">
          Investment Parameters
        </div>
        <div class="grid grid-cols-4 gap-3 text-xs font-mono">
          <div>
            <span id="print-param1-label" class="text-slate-500 block text-[10px] uppercase">Monthly Deposit</span>
            <span id="print-monthly" class="text-sm font-bold text-slate-900"></span>
          </div>
          <div>
            <span class="text-slate-500 block text-[10px] uppercase">Expected Annual Return</span>
            <span id="print-rate" class="text-sm font-bold text-slate-900"></span>
          </div>
          <div>
            <span class="text-slate-500 block text-[10px] uppercase">Investment Horizon</span>
            <span id="print-years" class="text-sm font-bold text-slate-900"></span>
          </div>
          <div>
            <span class="text-slate-500 block text-[10px] uppercase">Step-Up Rate</span>
            <span id="print-stepup" class="text-sm font-bold text-slate-900">0% (Flat)</span>
          </div>
        </div>
      </div>

      <!-- Calculation Results Key Metrics -->
      <div class="grid grid-cols-3 gap-3 mb-6">
        <div class="border border-slate-300 rounded-lg p-3.5 bg-white">
          <span class="text-[10px] font-bold uppercase text-slate-500 block font-mono">Total Capital Invested</span>
          <div id="print-invested" class="text-lg font-black text-blue-700 mt-1 font-mono"></div>
          <span class="text-[10px] text-slate-500">Cumulative Deposits</span>
        </div>
        <div class="border border-slate-300 rounded-lg p-3.5 bg-white">
          <span class="text-[10px] font-bold uppercase text-slate-500 block font-mono">Estimated Wealth Gain</span>
          <div id="print-gain" class="text-lg font-black text-cyan-700 mt-1 font-mono"></div>
          <span class="text-[10px] text-slate-500">Compound Returns</span>
        </div>
        <div class="border-2 border-slate-900 rounded-lg p-3.5 bg-slate-50">
          <span id="print-result3-label" class="text-[10px] font-bold uppercase text-slate-900 block font-mono">Total Expected Maturity</span>
          <div id="print-maturity" class="text-lg font-black text-slate-900 mt-1 font-mono"></div>
          <span id="print-multiplier" class="text-[10px] font-semibold text-blue-700"></span>
        </div>
      </div>

      <!-- Full Year-by-Year Schedule Table -->
      <div class="space-y-2">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900 font-mono">
          Year-by-Year Wealth Accumulation Schedule
        </div>
        <table class="w-full text-left text-xs font-mono border-collapse">
          <thead>
            <tr class="border-b-2 border-slate-300 bg-slate-100 text-slate-700">
              <th class="py-2 px-2.5">Year</th>
              <th class="py-2 px-2.5 text-right">Total Invested</th>
              <th class="py-2 px-2.5 text-right">Interest Earned</th>
              <th class="py-2 px-2.5 text-right">Ending Balance</th>
            </tr>
          </thead>
          <tbody id="print-schedule-body" class="divide-y divide-slate-200">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>

      <!-- Footer Branding & Verification -->
      <div class="mt-8 pt-3 border-t border-slate-200 flex justify-between items-center text-[10px] font-mono text-slate-500">
        <div>Generated by <strong>Free Accurate Calculator</strong> • https://freeaccuratecalculator.com</div>
        <div>Verified Pure Client-Side Computation • 100% Private</div>
      </div>
    </div>

    <!-- Screen UI Starts Here (All hidden during print) -->

    <!-- Top Controls: Mode Switcher & Currency Badge -->
    <div class="flex items-center justify-between gap-4 border-b border-hairline pb-4 print:hidden">
      <!-- Mode Switcher Segmented Control -->
      <div class="inline-flex p-1 rounded-xl bg-canvas border border-hairline">
        <button
          type="button"
          id="sip-mode-regular"
          class="mode-switch-btn relative px-4 py-2 rounded-lg text-xs font-semibold font-mono transition-all duration-200 cursor-pointer bg-canvas-elevated text-link shadow-xs border border-link/20 min-h-[44px] sm:min-h-[36px] flex items-center"
          data-mode="regular"
        >
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            Wealth Accumulator
          </span>
        </button>
        <button
          type="button"
          id="sip-mode-goal"
          class="mode-switch-btn relative px-4 py-2 rounded-lg text-xs font-semibold font-mono transition-all duration-200 cursor-pointer text-mute hover:text-ink min-h-[44px] sm:min-h-[36px] flex items-center"
          data-mode="goal"
        >
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Target Goal Planner
          </span>
        </button>
      </div>

      <!-- Trust Indicator -->
      <div class="hidden sm:flex items-center gap-2 text-xs font-mono text-mute">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-semibold text-ink">INR (₹)</span>
        <span>•</span>
        <span>100% Private Client-Side</span>
      </div>
    </div>

    <!-- Inputs Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 print:hidden">

      <!-- Left Column: Primary Inputs -->
      <div class="space-y-5">
        <!-- 1. Dynamic Primary Input: Monthly Amount OR Target Goal -->
        <div class="space-y-2 p-4 rounded-xl border border-hairline bg-canvas/40">
          <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
            <label id="sip-primary-label" for="sip-primary-amount">Monthly Investment</label>
            <span id="sip-amount-display" class="font-mono text-link text-base tabular-nums font-bold">₹ 10,000</span>
          </div>

          <div class="relative flex items-center gap-2">
            <div class="relative flex-1">
              <span id="sip-symbol-addon" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-mono text-mute select-none font-bold">₹</span>
              <input
                id="sip-primary-amount"
                type="number"
                min="100"
                step="500"
                value="10000"
                class="w-full min-h-[46px] rounded-xl border border-hairline bg-canvas-elevated py-2.5 pl-8 pr-3 text-base font-mono text-ink focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 tabular-nums font-semibold transition-all shadow-2xs"
              />
            </div>
            <!-- Quick Steppers -->
            <div class="flex items-center gap-1">
              <button
                type="button"
                id="btn-amount-minus"
                class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl border border-hairline bg-canvas-elevated text-mute hover:text-ink hover:border-link/50 active:scale-95 transition-all text-sm font-mono font-bold cursor-pointer"
                title="Decrease"
              >−</button>
              <button
                type="button"
                id="btn-amount-plus"
                class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl border border-hairline bg-canvas-elevated text-mute hover:text-ink hover:border-link/50 active:scale-95 transition-all text-sm font-mono font-bold cursor-pointer"
                title="Increase"
              >+</button>
            </div>
          </div>

          <!-- Dynamic Gradient Range Slider -->
          <div class="py-1">
            <input
              id="sip-amount-slider"
              type="range"
              min="500"
              max="100000"
              step="500"
              value="10000"
              aria-label="Investment amount slider"
              class="custom-range-slider w-full cursor-pointer h-2.5 rounded-lg appearance-none bg-hairline"
            />
          </div>

          <!-- Quick Preset Chips -->
          <div id="sip-presets" class="flex items-center gap-1.5 overflow-x-auto pt-1 pb-0.5 text-xs font-medium no-scrollbar">
            <!-- Dynamically populated per currency and mode -->
          </div>
        </div>

        <!-- 2. Expected Annual Return Rate (%) -->
        <div class="space-y-2 p-4 rounded-xl border border-hairline bg-canvas/40">
          <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
            <label for="sip-return-rate">Expected Return Rate (% P.A.)</label>
            <span id="sip-rate-display" class="font-mono text-cyan text-base tabular-nums font-bold">12.00%</span>
          </div>

          <div class="relative flex items-center gap-2">
            <div class="relative flex-1">
              <input
                id="sip-return-rate"
                type="number"
                min="0"
                max="30"
                step="0.5"
                value="12.0"
                class="w-full min-h-[46px] rounded-xl border border-hairline bg-canvas-elevated py-2.5 pl-3 pr-8 text-base font-mono text-ink focus:border-cyan focus:outline-none focus:ring-2 focus:ring-cyan/20 tabular-nums font-semibold transition-all shadow-2xs"
              />
              <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-sm font-mono text-mute select-none font-bold">%</span>
            </div>
            <!-- Rate Steppers -->
            <div class="flex items-center gap-1">
              <button
                type="button"
                id="btn-rate-minus"
                class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl border border-hairline bg-canvas-elevated text-mute hover:text-ink hover:border-cyan/50 active:scale-95 transition-all text-sm font-mono font-bold cursor-pointer"
                title="Decrease 0.5%"
              >−</button>
              <button
                type="button"
                id="btn-rate-plus"
                class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl border border-hairline bg-canvas-elevated text-mute hover:text-ink hover:border-cyan/50 active:scale-95 transition-all text-sm font-mono font-bold cursor-pointer"
                title="Increase 0.5%"
              >+</button>
            </div>
          </div>

          <div class="py-1">
            <input
              id="sip-rate-slider"
              type="range"
              min="1"
              max="30"
              step="0.5"
              value="12.0"
              aria-label="Expected annual return rate slider"
              class="custom-range-slider w-full cursor-pointer h-2.5 rounded-lg appearance-none bg-hairline"
            />
          </div>

          <!-- Benchmark Asset Classes -->
          <div class="flex items-center gap-1.5 pt-1 overflow-x-auto no-scrollbar">
            <button type="button" class="rate-benchmark-chip text-[11px] font-mono px-2.5 py-1.5 min-h-[36px] flex items-center rounded-lg border border-hairline bg-canvas-elevated hover:border-cyan/50 hover:text-cyan text-mute cursor-pointer transition-all shrink-0" data-rate="8">
              8% Debt / FD
            </button>
            <button type="button" class="rate-benchmark-chip text-[11px] font-mono px-2.5 py-1.5 min-h-[36px] flex items-center rounded-lg border border-cyan/40 bg-cyan/10 text-cyan font-bold cursor-pointer transition-all shrink-0" data-rate="12">
              12% Nifty Index
            </button>
            <button type="button" class="rate-benchmark-chip text-[11px] font-mono px-2.5 py-1.5 min-h-[36px] flex items-center rounded-lg border border-hairline bg-canvas-elevated hover:border-cyan/50 hover:text-cyan text-mute cursor-pointer transition-all shrink-0" data-rate="15">
              15% Active Equity
            </button>
          </div>
        </div>

        <!-- 3. Investment Horizon (Years) & Timing -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Horizon -->
          <div class="space-y-2 p-4 rounded-xl border border-hairline bg-canvas/40">
            <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
              <label for="sip-years">Tenure</label>
              <span id="sip-years-display" class="font-mono text-violet text-sm tabular-nums font-bold">10 Years</span>
            </div>

            <div class="relative flex items-center">
              <input
                id="sip-years"
                type="number"
                min="1"
                max="40"
                step="1"
                value="10"
                class="w-full min-h-[46px] rounded-xl border border-hairline bg-canvas-elevated py-2.5 px-3 text-base font-mono text-ink focus:border-violet focus:outline-none focus:ring-2 focus:ring-violet/20 tabular-nums font-semibold transition-all shadow-2xs"
              />
            </div>

            <div class="py-1">
              <input
                id="sip-years-slider"
                type="range"
                min="1"
                max="40"
                step="1"
                value="10"
                aria-label="Investment horizon slider"
                class="custom-range-slider w-full cursor-pointer h-2.5 rounded-lg appearance-none bg-hairline"
              />
            </div>

            <!-- Quick Tenure Chips -->
            <div class="flex items-center gap-1 pt-1 overflow-x-auto no-scrollbar">
              <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-1.5 min-h-[32px] rounded border border-hairline bg-canvas-elevated hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="5">5Y</button>
              <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-1.5 min-h-[32px] rounded border border-violet/40 bg-violet/10 text-violet font-bold cursor-pointer transition-colors" data-years="10">10Y</button>
              <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-1.5 min-h-[32px] rounded border border-hairline bg-canvas-elevated hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="15">15Y</button>
              <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-1.5 min-h-[32px] rounded border border-hairline bg-canvas-elevated hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="20">20Y</button>
              <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-1.5 min-h-[32px] rounded border border-hairline bg-canvas-elevated hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="25">25Y</button>
            </div>
          </div>

          <!-- Timing Selector -->
          <div class="space-y-2 p-4 rounded-xl border border-hairline bg-canvas/40 flex flex-col justify-between">
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
                <label for="sip-timing-select">Timing Standard</label>
              </div>
              <select
                id="sip-timing-select"
                class="w-full min-h-[46px] rounded-xl border border-hairline bg-canvas-elevated px-3 py-2.5 text-xs font-mono text-ink focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 cursor-pointer shadow-2xs"
              >
                <option value="beginning" selected>Beginning of Month (Annuity Due)</option>
                <option value="end">End of Month (Ordinary Annuity)</option>
              </select>
            </div>
            <div class="pt-2">
              <span id="timing-badge" class="inline-block rounded-full bg-link/10 text-link border border-link/20 px-2.5 py-0.5 text-[10px] font-mono font-semibold">
                Annuity Due (India Standard)
              </span>
            </div>
          </div>
        </div>

        <!-- 4. Advanced FinTech Power Toggles: Step-Up SIP & Inflation Adjuster -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Step-Up SIP Simulator -->
          <div class="p-4 rounded-xl border border-hairline bg-canvas/40 space-y-2.5">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <label for="sip-stepup-select" class="text-xs font-semibold text-ink font-mono uppercase">Annual Step-Up</label>
              </div>
              <span id="stepup-pct-badge" class="text-[11px] font-mono font-bold text-emerald-600 dark:text-emerald-400">Flat (0%)</span>
            </div>
            <select
              id="sip-stepup-select"
              class="w-full min-h-[44px] rounded-xl border border-hairline bg-canvas-elevated px-3 py-2 text-xs font-mono text-ink focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 cursor-pointer shadow-2xs"
            >
              <option value="0" selected>No Step-Up (Flat SIP)</option>
              <option value="5">+5% Annual Increase</option>
              <option value="10">+10% Annual Increase (Recommended)</option>
              <option value="15">+15% Annual Increase</option>
              <option value="20">+20% Annual Increase</option>
            </select>
            <p class="text-[10px] font-mono text-mute leading-tight">Increase SIP annually with salary growth.</p>
          </div>


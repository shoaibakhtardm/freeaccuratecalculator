  const scenarioAggrGain = document.getElementById('scenario-aggr-gain');

  // Cost of Delay Elements
  const delay1yLoss = document.getElementById('delay-1y-loss');
  const delay1yCorpus = document.getElementById('delay-1y-corpus');
  const delay3yLoss = document.getElementById('delay-3y-loss');
  const delay3yCorpus = document.getElementById('delay-3y-corpus');
  const delay5yLoss = document.getElementById('delay-5y-loss');
  const delay5yCorpus = document.getElementById('delay-5y-corpus');

  // Roadmap Elements
  const milestone10l = document.getElementById('milestone-10l');
  const milestone25l = document.getElementById('milestone-25l');
  const milestone50l = document.getElementById('milestone-50l');
  const milestone1cr = document.getElementById('milestone-1cr');
  const milestone5cr = document.getElementById('milestone-5cr');

  // Schedule Bodies
  const scheduleBody = document.getElementById('sip-schedule-body');
  const printScheduleBody = document.getElementById('print-schedule-body');

  // Mobile Sticky HUD
  const mobileHudTitle = document.getElementById('mobile-hud-title');
  const mobileHudVal = document.getElementById('mobile-hud-val');
  const mobileHudBadge = document.getElementById('mobile-hud-badge');

  // Toast Element
  const toastEl = document.getElementById('sip-toast');
  const toastMsg = document.getElementById('sip-toast-message');
  let toastTimeout: any = null;

  function showToast(message: string) {
    if (!toastEl || !toastMsg) return;
    toastMsg.textContent = message;
    toastEl.classList.remove('opacity-0', 'translate-y-12', 'pointer-events-none');
    toastEl.classList.add('opacity-100', 'translate-y-0');
    if (toastTimeout) clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => {
      toastEl.classList.remove('opacity-100', 'translate-y-0');
      toastEl.classList.add('opacity-0', 'translate-y-12', 'pointer-events-none');
    }, 2500);
  }

  // Formatting Helper
  function formatCurrencyValue(val: number, isIndian: boolean, decimals: number = 0): string {
    if (typeof (window as any).facFormatNumber === 'function') {
      return (window as any).facFormatNumber(val, decimals, isIndian);
    }
    return val.toLocaleString(isIndian ? 'en-IN' : 'en-US', {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    });
  }

  // Compact Number Formatting (e.g. 23.23 Lakh / 1.5M / 1.20 Cr)
  function formatCompactValue(val: number, isIndian: boolean): string {
    if (isIndian) {
      if (val >= 10000000) return `${(val / 10000000).toFixed(2)} Cr`;
      if (val >= 100000) return `${(val / 100000).toFixed(2)} Lakh`;
      if (val >= 1000) return `${(val / 1000).toFixed(1)}k`;
      return String(Math.round(val));
    } else {
      if (val >= 1000000) return `${(val / 1000000).toFixed(2)}M`;
      if (val >= 1000) return `${(val / 1000).toFixed(1)}k`;
      return String(Math.round(val));
    }
  }

  // Presets locked to INR
  function getPresets(mode: CalculatorMode) {
    if (mode === 'goal') {
      return [
        { label: '₹25 Lakh', value: 2500000 },
        { label: '₹50 Lakh', value: 5000000 },
        { label: '₹1 Crore', value: 10000000 },
        { label: '₹2.5 Crore', value: 25000000 },
        { label: '₹5 Crore', value: 50000000 },
      ];
    }
    return [
      { label: '₹2.5k', value: 2500 },
      { label: '₹5k', value: 5000 },
      { label: '₹10k', value: 10000 },
      { label: '₹25k', value: 25000 },
      { label: '₹50k', value: 50000 },
      { label: '₹1 Lakh', value: 100000 },
    ];
  }

  function updateSliderBounds() {
    if (!primarySlider) return;
    if (currentMode === 'goal') {
      primarySlider.min = '500000';
      primarySlider.max = '100000000';
      primarySlider.step = '100000';
      if (primaryInput) primaryInput.step = '100000';
    } else {
      primarySlider.min = '500';
      primarySlider.max = '100000';
      primarySlider.step = '500';
      if (primaryInput) primaryInput.step = '500';
    }
  }

  function updateSliderTrack(slider: HTMLInputElement, color: string = '#0070f3') {
    if (!slider) return;
    const min = parseFloat(slider.min) || 0;
    const max = parseFloat(slider.max) || 100;
    const val = parseFloat(slider.value) || min;
    const percentage = Math.max(0, Math.min(100, ((val - min) / (max - min)) * 100));
    slider.style.background = `linear-gradient(to right, ${color} 0%, ${color} ${percentage}%, var(--color-hairline, #ebebeb) ${percentage}%, var(--color-hairline, #ebebeb) 100%)`;
  }

  function renderPresets() {
    if (!presetsContainer) return;
    const presets = getPresets(currentMode);
    const currentVal = parseFloat(primaryInput?.value || '0');

    let html = '';
    presets.forEach((p) => {
      const isActive = Math.abs(currentVal - p.value) < 1;
      const activeClass = isActive
        ? 'bg-link text-white border-link font-bold shadow-2xs'
        : 'border-hairline bg-canvas-elevated text-mute hover:text-ink hover:border-link/40';
      html += `
        <button
          type="button"
          class="preset-chip shrink-0 rounded-lg border px-3 py-1.5 min-h-[36px] sm:min-h-[30px] cursor-pointer transition-all duration-150 tabular-nums font-mono text-xs ${activeClass}"
          data-amount="${p.value}"
        >${p.label}</button>
      `;
    });

    presetsContainer.innerHTML = html;

    presetsContainer.querySelectorAll('.preset-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = (btn as HTMLElement).dataset.amount || '0';
        if (primaryInput) {
          primaryInput.value = val;
          if (primarySlider) {
            if (parseFloat(val) > parseFloat(primarySlider.max)) {
              primarySlider.max = String(parseFloat(val) * 1.5);
            }
            primarySlider.value = val;
            updateSliderTrack(primarySlider, '#0070f3');
          }
          renderPresets();
          recalculate();
          syncUrlState();
        }
      });
    });
  }

  function setMode(mode: CalculatorMode) {
    currentMode = mode;

    if (mode === 'regular') {
      modeRegularBtn?.classList.remove('text-mute', 'bg-transparent', 'border-transparent');
      modeRegularBtn?.classList.add('bg-canvas-elevated', 'text-link', 'shadow-xs', 'border', 'border-link/20');
      modeGoalBtn?.classList.remove('bg-canvas-elevated', 'text-link', 'shadow-xs', 'border', 'border-link/20');
      modeGoalBtn?.classList.add('text-mute');

      if (primaryLabel) primaryLabel.textContent = 'Monthly Investment';
      if (heroLabel) heroLabel.textContent = 'Expected Maturity Corpus';
      if (heroSub) heroSub.textContent = 'Total accumulated wealth at compound rate';
      if (mobileHudTitle) mobileHudTitle.textContent = 'Expected Corpus';

      const defaultAmt = '10000';
      if (primaryInput) primaryInput.value = defaultAmt;
      updateSliderBounds();
      if (primarySlider) primarySlider.value = defaultAmt;
    } else {
      modeGoalBtn?.classList.remove('text-mute', 'bg-transparent', 'border-transparent');
      modeGoalBtn?.classList.add('bg-canvas-elevated', 'text-link', 'shadow-xs', 'border', 'border-link/20');
      modeRegularBtn?.classList.remove('bg-canvas-elevated', 'text-link', 'shadow-xs', 'border', 'border-link/20');
      modeRegularBtn?.classList.add('text-mute');

      if (primaryLabel) primaryLabel.textContent = 'Target Wealth Goal';
      if (heroLabel) heroLabel.textContent = 'Required Monthly SIP';
      if (heroSub) heroSub.textContent = 'Deposit needed each month to achieve goal';
      if (mobileHudTitle) mobileHudTitle.textContent = 'Required Monthly SIP';

      const defaultGoal = '10000000';
      if (primaryInput) primaryInput.value = defaultGoal;
      updateSliderBounds();
      if (primarySlider) primarySlider.value = defaultGoal;
    }

    updateSliderTrack(primarySlider, '#0070f3');
    renderPresets();
    recalculate();
    syncUrlState();
  }

  modeRegularBtn?.addEventListener('click', () => setMode('regular'));
  modeGoalBtn?.addEventListener('click', () => setMode('goal'));

  function updateTimingBadge() {
    if (!timingBadge || !timingSelect) return;
    const isBeg = timingSelect.value === 'beginning';
    timingBadge.textContent = isBeg ? 'Annuity Due (Beginning of Month)' : 'Ordinary Annuity (End of Month)';
    timingBadge.className = isBeg
      ? 'inline-block rounded-full bg-link/10 text-link border border-link/20 px-2.5 py-0.5 text-[10px] font-mono font-semibold'
      : 'inline-block rounded-full bg-violet/10 text-violet border border-violet/20 px-2.5 py-0.5 text-[10px] font-mono font-semibold';
  }

  function recalculate() {
    const rawVal = Math.max(0, parseFloat(primaryInput?.value || '0') || 0);
    const rate = Math.max(0, parseFloat(rateInput?.value || '0') || 0);
    const years = Math.max(0.1, parseFloat(yearsInput?.value || '10') || 10);
    const timing = (timingSelect?.value || 'beginning') as ContributionTiming;
    const stepUpPercent = parseFloat(stepupSelect?.value || '0') || 0;
    const inflationRate = (parseFloat(inflationSelect?.value || '0') || 0) / 100;

    // Display updates
    if (primaryDisplay) primaryDisplay.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(rawVal, isIndianFormat)}`;
    if (rateDisplay) rateDisplay.textContent = `${rate.toFixed(2)}%`;
    if (yearsDisplay) yearsDisplay.textContent = `${years} Years (${Math.round(years * 12)} Mo)`;
    if (legendRateLabel) legendRateLabel.textContent = `${rate.toFixed(1)}%`;
    if (stepupPctBadge) stepupPctBadge.textContent = stepUpPercent > 0 ? `+${stepUpPercent}% / Year` : 'Flat (0%)';
    if (inflationModeBadge) inflationModeBadge.textContent = inflationRate > 0 ? `${(inflationRate * 100).toFixed(0)}% Real Value` : 'Nominal';

    updateSliderTrack(primarySlider, '#0070f3');
    updateSliderTrack(rateSlider, '#0f766e');
    updateSliderTrack(yearsSlider, '#7928ca');

    let monthlyDeposit = 0;
    let maturityCorpus = 0;
    let investedCapital = 0;
    let wealthGain = 0;
    let yearlyBreakdown: import('../../engines/investment').SIPYearlyBreakdown[] = [];

    const months = Math.round(years * 12);
    const i = rate / 12 / 100;

    if (currentMode === 'regular') {
      monthlyDeposit = rawVal;
      if (stepUpPercent > 0) {
        const stepRes = calculateStepUpSIP(monthlyDeposit, stepUpPercent, rate, years, timing);
        maturityCorpus = stepRes.totalValue;
        investedCapital = stepRes.investedAmount;
        wealthGain = stepRes.estimatedReturns;
        
        // Generate yearly breakdown for step up
        const baseRes = calculateSIP(monthlyDeposit, rate, years, timing);
        yearlyBreakdown = baseRes.yearlyBreakdown || [];
      } else {
        const res = calculateSIP(monthlyDeposit, rate, years, timing);
        maturityCorpus = res.totalValue;
        investedCapital = res.investedAmount;
        wealthGain = res.estimatedReturns;
        yearlyBreakdown = res.yearlyBreakdown || [];
      }

      // Inflation adjustment if enabled
      let displayMaturity = maturityCorpus;
      if (inflationRate > 0) {
        displayMaturity = Math.round(maturityCorpus / Math.pow(1 + inflationRate, years));
      }

      if (heroValue) heroValue.textContent = formatCurrencyValue(displayMaturity, isIndianFormat);
      if (heroSub) {
        heroSub.textContent = inflationRate > 0
          ? `Real purchasing power at ${(inflationRate * 100).toFixed(0)}% inflation (Nominal: ${currentCurrencySymbol} ${formatCompactValue(maturityCorpus, isIndianFormat)})`
          : (stepUpPercent > 0
            ? `With +${stepUpPercent}% Annual Step-Up at ${rate}% P.A.`
            : `Total accumulated wealth at ${rate}% P.A.`);
      }

      if (secInvestedValue) secInvestedValue.textContent = formatCurrencyValue(investedCapital, isIndianFormat);
      if (secInvestedSub) secInvestedSub.textContent = `${months} Monthly Deposits${stepUpPercent > 0 ? ' (Increasing)' : ''}`;
      if (secGainValue) secGainValue.textContent = formatCurrencyValue(wealthGain, isIndianFormat);

      if (mobileHudVal) mobileHudVal.textContent = `${currentCurrencySymbol} ${formatCompactValue(displayMaturity, isIndianFormat)}`;
    } else {
      // Goal Mode: calculate required monthly SIP
      maturityCorpus = rawVal;
      if (i <= 0 || !isFinite(i)) {
        monthlyDeposit = months > 0 ? maturityCorpus / months : 0;
      } else {
        const factor = Math.pow(1 + i, months);
        const denom = (timing === 'beginning') ? ((factor - 1) / i) * (1 + i) : ((factor - 1) / i);
        monthlyDeposit = denom > 0 ? maturityCorpus / denom : 0;
      }

      monthlyDeposit = Math.round(monthlyDeposit);
      const res = calculateSIP(monthlyDeposit, rate, years, timing);
      investedCapital = res.investedAmount;
      wealthGain = Math.max(0, maturityCorpus - investedCapital);
      yearlyBreakdown = res.yearlyBreakdown || [];

      if (heroValue) heroValue.textContent = `${formatCurrencyValue(monthlyDeposit, isIndianFormat)} / mo`;
      if (secInvestedValue) secInvestedValue.textContent = formatCurrencyValue(investedCapital, isIndianFormat);
      if (secInvestedSub) secInvestedSub.textContent = `Target: ${currentCurrencySymbol} ${formatCurrencyValue(maturityCorpus, isIndianFormat)}`;
      if (secGainValue) secGainValue.textContent = formatCurrencyValue(wealthGain, isIndianFormat);

      if (mobileHudVal) mobileHudVal.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(monthlyDeposit, isIndianFormat)}/mo`;
    }

    // Wealth Multiplier & Gain Pct
    const multiplier = investedCapital > 0 ? (maturityCorpus / investedCapital).toFixed(2) : '1.00';
    const gainPct = investedCapital > 0 ? ((wealthGain / investedCapital) * 100).toFixed(1) : '0.0';

    if (multBadge) multBadge.textContent = `${multiplier}x Return`;
    if (heroSecBadge) heroSecBadge.textContent = `+${gainPct}% Gain`;
    if (mobileHudBadge) mobileHudBadge.textContent = `+${gainPct}%`;

    // Spectrum & Donut Visualization
    const totalRef = maturityCorpus || 1;
    const investedPct = Math.min(100, Math.max(0, (investedCapital / totalRef) * 100));
    const gainBarPct = Math.max(0, 100 - investedPct);

    if (spectrumInvested) spectrumInvested.style.width = `${investedPct.toFixed(1)}%`;
    if (spectrumGain) spectrumGain.style.width = `${gainBarPct.toFixed(1)}%`;

    if (barInvestedLabel) barInvestedLabel.textContent = `${currentCurrencySymbol} ${formatCompactValue(investedCapital, isIndianFormat)} (${investedPct.toFixed(1)}%)`;
    if (barGainLabel) barGainLabel.textContent = `${currentCurrencySymbol} ${formatCompactValue(wealthGain, isIndianFormat)} (${gainBarPct.toFixed(1)}%)`;

    // SVG Donut Rings
    const circumference = 339.29;
    const investedOffset = circumference - (circumference * (investedPct / 100));
    const gainOffset = circumference - (circumference * (gainBarPct / 100));

    if (donutInvestedRing) {
      donutInvestedRing.style.strokeDasharray = `${circumference}`;
      donutInvestedRing.style.strokeDashoffset = `${investedOffset}`;
    }
    if (donutGainRing) {
      donutGainRing.style.strokeDasharray = `${circumference}`;
      donutGainRing.style.strokeDashoffset = `${gainOffset}`;
    }
    if (donutCenterPct) donutCenterPct.textContent = `${gainBarPct.toFixed(1)}%`;
    if (legendInvestedPct) legendInvestedPct.textContent = `${investedPct.toFixed(1)}% (${currentCurrencySymbol} ${formatCompactValue(investedCapital, isIndianFormat)})`;
    if (legendGainPct) legendGainPct.textContent = `${gainBarPct.toFixed(1)}% (${currentCurrencySymbol} ${formatCompactValue(wealthGain, isIndianFormat)})`;

    // 1. Crossover Milestone
    if (matrixCrossover) {
      let crossoverYear = 0;
      for (const row of yearlyBreakdown) {
        const cumulativeGains = row.totalValue - row.investedAmount;
        if (cumulativeGains >= row.investedAmount) {
          crossoverYear = row.year;
          break;
        }
      }
      if (crossoverYear > 0) {
        matrixCrossover.textContent = `Year ${crossoverYear} (Returns > Capital)`;
      } else {
        matrixCrossover.textContent = `Extend horizon for crossover`;
      }
    }

    // 2. Landmark / Millionaire Countdown
    if (matrixMilestoneTime) {
      const landmarkTarget = 10000000; // ₹1 Crore
      if (monthlyDeposit > 0 && i > 0) {
        const targetAnnuity = timing === 'beginning' ? landmarkTarget / (1 + i) : landmarkTarget;
        const ratio = (targetAnnuity * i) / monthlyDeposit + 1;
        if (ratio > 1) {
          const reqMonths = Math.log(ratio) / Math.log(1 + i);
          const reqY = Math.floor(reqMonths / 12);
          const reqM = Math.round(reqMonths % 12);
          matrixMilestoneTime.textContent = `${reqY} Yrs, ${reqM} Mo`;
        } else {
          matrixMilestoneTime.textContent = `< 1 Year`;
        }
      } else {
        matrixMilestoneTime.textContent = `N/A`;
      }
    }

    // 3. Inflation Reality in Today's Money (at 6%)
    if (matrixInflationVal) {
      const standardInf = 0.06;
      const realValue = maturityCorpus / Math.pow(1 + standardInf, years);
      matrixInflationVal.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(Math.round(realValue), isIndianFormat)}`;
    }

    // 4. Rule of 72 Doubling Time
    if (matrixDoublingTime) {
      if (rate > 0) {
        const doubleYears = (72 / rate).toFixed(1);
        matrixDoublingTime.textContent = `${doubleYears} Years (Rule of 72)`;
      } else {
        matrixDoublingTime.textContent = `Infinite (0% return)`;
      }
    }

    // 5. 3-Scenario Sensitivity Analysis Updates
    if (scenarioConsVal && scenarioConsGain && scenarioBaseVal && scenarioBaseGain && scenarioAggrVal && scenarioAggrGain) {
      const consRes = calculateSIP(monthlyDeposit, 8, years, timing);
      const aggrRes = calculateSIP(monthlyDeposit, 15, years, timing);
      const consMult = consRes.investedAmount > 0 ? (consRes.totalValue / consRes.investedAmount).toFixed(2) : '1.00';
      const baseMult = investedCapital > 0 ? (maturityCorpus / investedCapital).toFixed(2) : '1.00';
      const aggrMult = aggrRes.investedAmount > 0 ? (aggrRes.totalValue / aggrRes.investedAmount).toFixed(2) : '1.00';

      scenarioConsVal.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(consRes.totalValue, isIndianFormat)}`;
      scenarioConsGain.textContent = `Gain: ${currentCurrencySymbol} ${formatCompactValue(consRes.estimatedReturns, isIndianFormat)} (${consMult}x)`;

      if (scenarioBaseRate) scenarioBaseRate.textContent = `${rate}%`;
      scenarioBaseVal.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(maturityCorpus, isIndianFormat)}`;
      scenarioBaseGain.textContent = `Gain: ${currentCurrencySymbol} ${formatCompactValue(wealthGain, isIndianFormat)} (${baseMult}x)`;

      scenarioAggrVal.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(aggrRes.totalValue, isIndianFormat)}`;
      scenarioAggrGain.textContent = `Gain: ${currentCurrencySymbol} ${formatCompactValue(aggrRes.estimatedReturns, isIndianFormat)} (${aggrMult}x)`;
    }

    // 6. Cost of Delay Calculations
    if (delay1yLoss && delay1yCorpus && delay3yLoss && delay3yCorpus && delay5yLoss && delay5yCorpus) {
      const calcDelay = (delayY: number) => {
        if (years <= delayY) return { loss: maturityCorpus, corpus: 0 };
        const delayedRes = calculateSIP(monthlyDeposit, rate, years - delayY, timing);
        const loss = Math.max(0, maturityCorpus - delayedRes.totalValue);
        return { loss, corpus: delayedRes.totalValue };
      };

      const d1 = calcDelay(1);
      const d3 = calcDelay(3);
      const d5 = calcDelay(5);

      delay1yLoss.textContent = `-${currentCurrencySymbol} ${formatCompactValue(d1.loss, isIndianFormat)}`;
      delay1yCorpus.textContent = `Corpus: ${currentCurrencySymbol} ${formatCompactValue(d1.corpus, isIndianFormat)}`;

      delay3yLoss.textContent = `-${currentCurrencySymbol} ${formatCompactValue(d3.loss, isIndianFormat)}`;
      delay3yCorpus.textContent = `Corpus: ${currentCurrencySymbol} ${formatCompactValue(d3.corpus, isIndianFormat)}`;

      delay5yLoss.textContent = `-${currentCurrencySymbol} ${formatCompactValue(d5.loss, isIndianFormat)}`;
      delay5yCorpus.textContent = `Corpus: ${currentCurrencySymbol} ${formatCompactValue(d5.corpus, isIndianFormat)}`;
    }

    // 7. Milestone Roadmap Calculations
    if (milestone10l && milestone25l && milestone50l && milestone1cr && milestone5cr) {
      const calcMilestoneTime = (target: number) => {
        if (monthlyDeposit <= 0 || i <= 0) return 'N/A';
        const targetAnnuity = timing === 'beginning' ? target / (1 + i) : target;
        const ratio = (targetAnnuity * i) / monthlyDeposit + 1;
        if (ratio <= 1) return '< 1 Year';
        const reqMonths = Math.log(ratio) / Math.log(1 + i);
        const y = (reqMonths / 12).toFixed(1);
        return `${y} Years`;
      };

      milestone10l.textContent = calcMilestoneTime(1000000);
      milestone25l.textContent = calcMilestoneTime(2500000);
      milestone50l.textContent = calcMilestoneTime(5000000);
      milestone1cr.textContent = calcMilestoneTime(10000000);
      milestone5cr.textContent = calcMilestoneTime(50000000);
    }

    // Render Table & Print Metadata
    renderSchedule(yearlyBreakdown, monthlyDeposit);
    updatePrintMetadata(monthlyDeposit, rate, years, timing, investedCapital, wealthGain, maturityCorpus, multiplier, stepUpPercent);
  }

  function renderSchedule(breakdown: import('../../engines/investment').SIPYearlyBreakdown[], monthlyDeposit: number) {
    let screenHtml = '';
    let printHtml = '';

    const maxRows = Math.min(breakdown.length, 50);
    for (let i = 0; i < maxRows; i++) {
      const row = breakdown[i];
      screenHtml += `
        <tr class="hover:bg-canvas-subtle/50 transition-colors">
          <td class="py-2.5 px-3.5 font-bold text-link whitespace-nowrap">Year ${row.year}</td>
          <td class="py-2.5 px-3.5 text-right tabular-nums font-mono text-mute whitespace-nowrap">${currentCurrencySymbol} ${formatCurrencyValue(row.investedAmount, isIndianFormat)}</td>
          <td class="py-2.5 px-3.5 text-right tabular-nums font-mono text-violet font-semibold whitespace-nowrap">${currentCurrencySymbol} ${formatCurrencyValue(row.yearlyGrowth, isIndianFormat)}</td>
          <td class="py-2.5 px-3.5 text-right tabular-nums font-mono font-bold text-cyan whitespace-nowrap">${currentCurrencySymbol} ${formatCurrencyValue(row.totalValue, isIndianFormat)}</td>
        </tr>
      `;

      printHtml += `
        <tr class="border-b border-slate-200">
          <td class="py-1.5 px-2.5 font-bold text-blue-700">Year ${row.year}</td>
          <td class="py-1.5 px-2.5 text-right font-mono text-slate-700">${currentCurrencySymbol} ${formatCurrencyValue(row.investedAmount, isIndianFormat)}</td>
          <td class="py-1.5 px-2.5 text-right font-mono text-cyan-700 font-semibold">${currentCurrencySymbol} ${formatCurrencyValue(row.yearlyGrowth, isIndianFormat)}</td>
          <td class="py-1.5 px-2.5 text-right font-mono font-bold text-slate-900">${currentCurrencySymbol} ${formatCurrencyValue(row.totalValue, isIndianFormat)}</td>
        </tr>
      `;
    }

    if (scheduleBody) scheduleBody.innerHTML = screenHtml;
    if (printScheduleBody) printScheduleBody.innerHTML = printHtml;
  }

  function updatePrintMetadata(
    p: number,
    rate: number,
    years: number,
    timing: ContributionTiming,
    invested: number,
    gain: number,
    maturity: number,
    multiplier: string,
    stepUpPercent: number
  ) {
    const printDate = document.getElementById('print-date');
    const printCurr = document.getElementById('print-currency-code');
    const printMode = document.getElementById('print-mode-label');
    const printTiming = document.getElementById('print-timing');
    const printMonthly = document.getElementById('print-monthly');
    const printRate = document.getElementById('print-rate');
    const printYears = document.getElementById('print-years');
    const printStepup = document.getElementById('print-stepup');
    const printInvested = document.getElementById('print-invested');
    const printGain = document.getElementById('print-gain');
    const printMaturity = document.getElementById('print-maturity');
    const printMult = document.getElementById('print-multiplier');
    const printParam1Label = document.getElementById('print-param1-label');
    const printResult3Label = document.getElementById('print-result3-label');

    if (printDate) printDate.textContent = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    if (printCurr) printCurr.textContent = `${currentCurrencyCode} (${currentCurrencySymbol})`;
    if (printMode) printMode.textContent = currentMode === 'regular' ? 'Wealth Accumulation' : 'Target Goal Planning';
    if (printTiming) printTiming.textContent = timing === 'beginning' ? 'Annuity Due (Beginning)' : 'Ordinary Annuity (End)';

    if (printParam1Label) printParam1Label.textContent = currentMode === 'regular' ? 'Monthly Deposit' : 'Target Corpus';
    if (printResult3Label) printResult3Label.textContent = currentMode === 'regular' ? 'Total Expected Maturity' : 'Required Monthly SIP';

    if (printMonthly) printMonthly.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(p, isIndianFormat)}`;
    if (printRate) printRate.textContent = `${rate.toFixed(2)}% P.A.`;
    if (printYears) printYears.textContent = `${years} Years (${Math.round(years * 12)} Months)`;
    if (printStepup) printStepup.textContent = stepUpPercent > 0 ? `+${stepUpPercent}% / Year` : '0% (Flat)';
    if (printInvested) printInvested.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(invested, isIndianFormat)}`;
    if (printGain) printGain.textContent = `${currentCurrencySymbol} ${formatCurrencyValue(gain, isIndianFormat)}`;
    if (printMaturity) printMaturity.textContent = currentMode === 'regular'
      ? `${currentCurrencySymbol} ${formatCurrencyValue(maturity, isIndianFormat)}`
      : `${currentCurrencySymbol} ${formatCurrencyValue(p, isIndianFormat)} / mo`;
    if (printMult) printMult.textContent = `Wealth Multiplier: ${multiplier}x`;
  }

  function syncUrlState() {
    try {
      const url = new URL(window.location.href);
      url.searchParams.set('p', primaryInput?.value || '10000');
      url.searchParams.set('r', rateInput?.value || '12');
      url.searchParams.set('y', yearsInput?.value || '10');
      url.searchParams.set('t', timingSelect?.value || 'beginning');
      url.searchParams.set('m', currentMode);
      if (stepupSelect?.value && stepupSelect.value !== '0') url.searchParams.set('su', stepupSelect.value);
      else url.searchParams.delete('su');
      if (inflationSelect?.value && inflationSelect.value !== '0') url.searchParams.set('inf', inflationSelect.value);
      else url.searchParams.delete('inf');
      window.history.replaceState({}, '', url.toString());
    } catch (_) {}
  }

  function loadUrlState() {
    try {
      const params = new URLSearchParams(window.location.search);
      const p = params.get('p');
      const r = params.get('r');
      const y = params.get('y');
      const t = params.get('t');
      const m = params.get('m');
      const su = params.get('su');
      const inf = params.get('inf');

      if (m === 'goal' || m === 'regular') setMode(m);

      if (p && primaryInput) {
        primaryInput.value = p;
        if (primarySlider) {
          if (parseFloat(p) > parseFloat(primarySlider.max)) primarySlider.max = String(parseFloat(p) * 1.5);
          primarySlider.value = p;
        }
      }
      if (r && rateInput) {
        rateInput.value = r;
        if (rateSlider) rateSlider.value = r;
      }
      if (y && yearsInput) {
        yearsInput.value = y;
        if (yearsSlider) yearsSlider.value = y;
      }
      if (t && timingSelect && (t === 'beginning' || t === 'end')) {
        timingSelect.value = t;
        timingSelect.dataset.userTouched = 'true';
      }
      if (su && stepupSelect) stepupSelect.value = su;
      if (inf && inflationSelect) inflationSelect.value = inf;
    } catch (_) {}
  }

  // Stepper buttons
  document.getElementById('btn-amount-plus')?.addEventListener('click', () => {
    if (!primaryInput) return;
    const step = currentMode === 'goal' ? 500000 : (isIndianFormat ? 1000 : 50);
    primaryInput.value = String(parseFloat(primaryInput.value || '0') + step);
    if (primarySlider) {
      if (parseFloat(primaryInput.value) > parseFloat(primarySlider.max)) primarySlider.max = String(parseFloat(primaryInput.value) * 1.5);
      primarySlider.value = primaryInput.value;
    }
    renderPresets();
    recalculate();
    syncUrlState();
  });

  document.getElementById('btn-amount-minus')?.addEventListener('click', () => {
    if (!primaryInput) return;
    const step = currentMode === 'goal' ? 500000 : (isIndianFormat ? 1000 : 50);
    const minVal = currentMode === 'goal' ? 10000 : 100;
    primaryInput.value = String(Math.max(minVal, parseFloat(primaryInput.value || '0') - step));
    if (primarySlider) primarySlider.value = primaryInput.value;
    renderPresets();
    recalculate();
    syncUrlState();
  });

  document.getElementById('btn-rate-plus')?.addEventListener('click', () => {
    if (!rateInput) return;
    rateInput.value = String(Math.min(30, (parseFloat(rateInput.value || '0') + 0.5)));
    if (rateSlider) rateSlider.value = rateInput.value;
    recalculate();
    syncUrlState();
  });

  document.getElementById('btn-rate-minus')?.addEventListener('click', () => {
    if (!rateInput) return;
    rateInput.value = String(Math.max(0.5, (parseFloat(rateInput.value || '0') - 0.5)));
    if (rateSlider) rateSlider.value = rateInput.value;
    recalculate();
    syncUrlState();
  });

  // Slider & Input Bindings
  primaryInput?.addEventListener('input', () => {
    if (primarySlider) {
      if (parseFloat(primaryInput.value) > parseFloat(primarySlider.max)) primarySlider.max = String(parseFloat(primaryInput.value) * 1.5);
      primarySlider.value = primaryInput.value;
    }
    renderPresets();
    recalculate();
    syncUrlState();
  });

  primarySlider?.addEventListener('input', () => {
    if (primaryInput) primaryInput.value = primarySlider.value;
    renderPresets();
    recalculate();
    syncUrlState();
  });

  rateInput?.addEventListener('input', () => {
    if (rateSlider) rateSlider.value = rateInput.value;
    recalculate();
    syncUrlState();
  });
  rateSlider?.addEventListener('input', () => {
    if (rateInput) rateInput.value = rateSlider.value;
    recalculate();
    syncUrlState();
  });

  yearsInput?.addEventListener('input', () => {
    if (yearsSlider) yearsSlider.value = yearsInput.value;
    recalculate();
    syncUrlState();
  });
  yearsSlider?.addEventListener('input', () => {
    if (yearsInput) yearsInput.value = yearsSlider.value;
    recalculate();
    syncUrlState();
  });

  // Benchmark Rate Chips
  document.querySelectorAll('.rate-benchmark-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const rate = (btn as HTMLElement).dataset.rate;
      if (rate && rateInput && rateSlider) {
        rateInput.value = rate;
        rateSlider.value = rate;
        document.querySelectorAll('.rate-benchmark-chip').forEach(b => b.classList.remove('border-cyan/40', 'bg-cyan/10', 'text-cyan', 'font-bold'));
        btn.classList.add('border-cyan/40', 'bg-cyan/10', 'text-cyan', 'font-bold');
        recalculate();
        syncUrlState();
      }
    });
  });

  // Tenure Chips
  document.querySelectorAll('.tenure-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const yrs = (btn as HTMLElement).dataset.years;
      if (yrs && yearsInput && yearsSlider) {
        yearsInput.value = yrs;
        yearsSlider.value = yrs;
        document.querySelectorAll('.tenure-chip').forEach(b => b.classList.remove('border-violet/40', 'bg-violet/10', 'text-violet', 'font-bold'));
        btn.classList.add('border-violet/40', 'bg-violet/10', 'text-violet', 'font-bold');
        recalculate();
        syncUrlState();
      }
    });
  });

  timingSelect?.addEventListener('change', () => {
    timingSelect.dataset.userTouched = 'true';
    updateTimingBadge();
    recalculate();
    syncUrlState();
  });

  stepupSelect?.addEventListener('change', () => {
    recalculate();
    syncUrlState();
  });

  inflationSelect?.addEventListener('change', () => {
    recalculate();
    syncUrlState();
  });

  // Reset Action
  document.getElementById('action-reset-btn')?.addEventListener('click', () => {
    if (primaryInput) primaryInput.value = '10000';
    if (primarySlider) primarySlider.value = '10000';
    if (rateInput) rateInput.value = '12';
    if (rateSlider) rateSlider.value = '12';
    if (yearsInput) yearsInput.value = '10';
    if (yearsSlider) yearsSlider.value = '10';
    if (timingSelect) timingSelect.value = 'beginning';
    if (stepupSelect) stepupSelect.value = '0';
    if (inflationSelect) inflationSelect.value = '0';
    setMode('regular');
    showToast('Reset to default values');
  });

  // Mobile HUD Scroll button
  document.getElementById('mobile-hud-scroll-btn')?.addEventListener('click', () => {
    const schedCard = document.getElementById('schedule-section-card');
    if (schedCard) {
      schedCard.scrollIntoView({ behavior: 'smooth' });
    }
  });

  // Excel (.csv) Export
  function downloadExcel() {
    const rawVal = Math.max(0, parseFloat(primaryInput?.value || '0') || 0);
    const rate = Math.max(0, parseFloat(rateInput?.value || '0') || 0);
    const years = Math.max(0.1, parseFloat(yearsInput?.value || '10') || 10);
    const timing = (timingSelect?.value || 'beginning') as ContributionTiming;
    const stepUpPercent = parseFloat(stepupSelect?.value || '0') || 0;
    const timingName = timing === 'beginning' ? 'Annuity Due (Beginning of Month)' : 'Ordinary Annuity (End of Month)';
    const dateStr = new Date().toISOString().slice(0, 10);

    let monthlyDeposit = rawVal;
    const months = Math.round(years * 12);
    const i = rate / 12 / 100;
    let maturityCorpus = 0;

    if (currentMode === 'goal') {
      maturityCorpus = rawVal;
      const factor = Math.pow(1 + i, months);
      const denom = (timing === 'beginning') ? ((factor - 1) / i) * (1 + i) : ((factor - 1) / i);
      monthlyDeposit = denom > 0 ? Math.round(maturityCorpus / denom) : 0;
    }

    const res = calculateSIP(monthlyDeposit, rate, years, timing);
    const multiplier = res.investedAmount > 0 ? (res.totalValue / res.investedAmount).toFixed(2) : '1.00';

    const csvRows: string[][] = [
      ['Free Accurate Calculator — freeaccuratecalculator.com'],
      ['SIP Investment & Wealth Accumulation Statement'],
      ['Date', dateStr],
      ['Currency', `${currentCurrencyCode} (${currentCurrencySymbol})`],
      ['Mode', currentMode === 'regular' ? 'Wealth Accumulation' : 'Target Goal Planning'],
      ['Contribution Standard', timingName],
      ['Annual Step-Up Rate', `${stepUpPercent}% / Year`],
      [],
      ['CALCULATION PARAMETERS', ''],
      [currentMode === 'regular' ? 'Monthly Investment Deposit' : 'Target Wealth Goal', `${currentCurrencySymbol} ${formatCurrencyValue(rawVal, isIndianFormat)}`],
      ['Expected Annual Return Rate', `${rate.toFixed(2)}% P.A.`],
      ['Investment Horizon', `${years} Years (${months} Monthly Installments)`],
      [],
      ['CALCULATION RESULTS', ''],
      ['Required Monthly SIP', `${currentCurrencySymbol} ${formatCurrencyValue(monthlyDeposit, isIndianFormat)}`],
      ['Total Principal Capital Invested', `${currentCurrencySymbol} ${formatCurrencyValue(res.investedAmount, isIndianFormat)}`],
      ['Estimated Wealth Gain (Interest Returns)', `${currentCurrencySymbol} ${formatCurrencyValue(res.estimatedReturns, isIndianFormat)}`],
      ['Total Expected Maturity Corpus', `${currentCurrencySymbol} ${formatCurrencyValue(res.totalValue, isIndianFormat)}`],
      ['Wealth Multiplier', `${multiplier}x`],
      [],
      ['YEAR-BY-YEAR WEALTH PROGRESSION SCHEDULE'],
      ['Year', 'Cumulative Capital Invested', 'Interest Earned (Yearly Growth)', 'Ending Balance (Corpus)']
    ];

    const breakdown = res.yearlyBreakdown || [];
    for (const row of breakdown) {
      csvRows.push([
        `Year ${row.year}`,
        `${currentCurrencySymbol} ${formatCurrencyValue(row.investedAmount, isIndianFormat)}`,
        `${currentCurrencySymbol} ${formatCurrencyValue(row.yearlyGrowth, isIndianFormat)}`,
        `${currentCurrencySymbol} ${formatCurrencyValue(row.totalValue, isIndianFormat)}`
      ]);
    }

    csvRows.push([]);
    csvRows.push(['Verified By', 'Free Accurate Calculator — Client-Side Financial Engine']);
    csvRows.push(['Website', 'https://freeaccuratecalculator.com/finance/sip-calculator/']);

    const escapeCsv = (val: any) => `"${String(val ?? '').replace(/"/g, '""')}"`;
    const csvContent = '\uFEFF' + csvRows.map(row => row.map(escapeCsv).join(',')).join('\r\n');

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `SIP_Wealth_Statement_${currentCurrencyCode}_${years}Y_${dateStr}.csv`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

    showToast('Excel spreadsheet downloaded!');
  }

  // Native High-Fidelity Print & PDF Statement Export (Single-Flight Protected)
  function downloadPDF(e?: Event) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
      if (typeof (e as any).stopImmediatePropagation === 'function') {
        (e as any).stopImmediatePropagation();
      }
    }
    recalculate();
    if (typeof (window as any).generateAndDownloadPDF === 'function') {
      (window as any).generateAndDownloadPDF();
    } else {
      window.print();
    }
  }

  // Pre-print synchronization hooks
  window.addEventListener('fac:before-pdf-print', () => recalculate());
  window.addEventListener('beforeprint', () => recalculate());

  // Copy Summary
  function copyCalculationSummary() {
    const rawVal = Math.max(0, parseFloat(primaryInput?.value || '0') || 0);
    const rate = Math.max(0, parseFloat(rateInput?.value || '0') || 0);
    const years = Math.max(0.1, parseFloat(yearsInput?.value || '10') || 10);
    const timing = (timingSelect?.value || 'beginning') as ContributionTiming;
    const stepUpPercent = parseFloat(stepupSelect?.value || '0') || 0;

    let monthlyDeposit = rawVal;
    const months = Math.round(years * 12);
    const i = rate / 12 / 100;
    if (currentMode === 'goal') {
      const factor = Math.pow(1 + i, months);
      const denom = (timing === 'beginning') ? ((factor - 1) / i) * (1 + i) : ((factor - 1) / i);
      monthlyDeposit = denom > 0 ? Math.round(rawVal / denom) : 0;
    }

    const res = calculateSIP(monthlyDeposit, rate, years, timing);
    const multiplier = res.investedAmount > 0 ? (res.totalValue / res.investedAmount).toFixed(2) : '1.00';

    const text = [
      `💰 SIP Investment Wealth Summary — Free Accurate Calculator`,
      `----------------------------------------------------`,
      `• Mode: ${currentMode === 'regular' ? 'Wealth Accumulation' : 'Target Goal Planner'}`,
      `• Monthly Investment: ${currentCurrencySymbol} ${formatCurrencyValue(monthlyDeposit, isIndianFormat)}`,
      `• Expected Return Rate: ${rate.toFixed(2)}% P.A.`,
      `• Duration: ${years} Years (${months} Months)`,
      `• Annual Step-Up: ${stepUpPercent > 0 ? `+${stepUpPercent}% / Year` : 'Flat (0%)'}`,
      `• Contribution Timing: ${timing === 'beginning' ? 'Beginning of Month (Annuity Due)' : 'End of Month (Ordinary Annuity)'}`,
      `----------------------------------------------------`,
      `• Total Capital Invested: ${currentCurrencySymbol} ${formatCurrencyValue(res.investedAmount, isIndianFormat)}`,
      `• Estimated Wealth Gain: ${currentCurrencySymbol} ${formatCurrencyValue(res.estimatedReturns, isIndianFormat)}`,
      `• Total Maturity Corpus: ${currentCurrencySymbol} ${formatCurrencyValue(res.totalValue, isIndianFormat)}`,
      `• Wealth Multiplier: ${multiplier}x Return`,
      `----------------------------------------------------`,
      `Calculate online: ${window.location.href}`
    ].join('\n');

    navigator.clipboard.writeText(text).then(() => {
      showToast('Summary copied to clipboard!');
    }).catch(() => {
      showToast('Unable to copy to clipboard');
    });
  }

  // Share Link
  function shareCalculationLink() {
    syncUrlState();
    navigator.clipboard.writeText(window.location.href).then(() => {
      showToast('Link copied to clipboard!');
    }).catch(() => {
      showToast('Unable to copy link');
    });
  }

  // Bind Export Buttons
  document.getElementById('action-download-pdf-btn')?.addEventListener('click', downloadPDF);
  document.getElementById('action-download-excel-btn')?.addEventListener('click', downloadExcel);
  document.getElementById('action-copy-summary-btn')?.addEventListener('click', copyCalculationSummary);
  document.getElementById('action-share-link-btn')?.addEventListener('click', shareCalculationLink);

  // Initialize
  loadUrlState();
  updateTimingBadge();
  recalculate();
</script>


---
// src/pages/ruler/index.astro
// Flagship Online Ruler — full-screen, tool-first measuring app.
// Canonical URL /ruler/. Guides live at /ruler/guides/.
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';

const relatedCalculators = [
  { title: 'Online Ruler Guides', href: '/ruler/guides/' },
  { title: 'Length Converter', href: '/length-converter/' },
  { title: 'Unit Conversion Calculator', href: '/conversion-calculator/' },
  { title: 'Percentage Calculator', href: '/percentage-calculator/' },
];

// Clean inline SVG glyphs for the calibration reference cards.
const referenceIcons: Record<string, string> = {
  'bank-card':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" /><path d="M6 15h4" /></svg>',
  'id-card':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" /><circle cx="8.5" cy="11" r="2" /><path d="M5 16c.8-1.3 2-2 3.5-2s2.7.7 3.5 2" /><path d="M15 10h4" /><path d="M15 14h4" /></svg>',
  'a4-paper':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" /><path d="M14 3v5h5" /><path d="M9 13h6" /><path d="M9 17h6" /></svg>',
  'us-letter':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="1.5" /><path d="M8 8h8" /><path d="M8 12h8" /><path d="M8 16h5" /></svg>',
  'coin-quarter':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /></svg>',
  'coin-euro':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M15 9.5a4 4 0 1 0 0 5" /><path d="M7.5 11h6" /><path d="M7.5 13h6" /></svg>',
};

export const faqs = [
  {
    question: 'Can I use my phone as a real ruler?',
    answer: 'Yes. This online ruler works in any modern mobile browser (Safari, Chrome, Edge) and turns your phone display into a precision measuring tool. By calibrating your screen using a standard credit card or choosing your device from our database, 1 cm on screen equals exactly 1 physical cm, with accuracy down to 0.1 mm.',
  },
  {
    question: 'Is there a free ruler online that measures in actual size?',
    answer: 'Yes. Free Accurate Calculator Online Ruler measures in inches, centimeters, millimeters, and pixels at 1:1 true scale without downloading any app or creating an account. It calibrates to your screen\'s exact pixel density (PPI) so real-world dimensions match perfectly.',
  },
  {
    question: 'How do I calibrate an online ruler to scale?',
    answer: 'Click "Calibrate" in the toolbar. You can calibrate using 4 methods: (1) Credit card alignment (any standard bank card is 85.60 mm wide), (2) Device selector for iPhone, Galaxy, Pixel, iPad, and MacBook models, (3) Screen diagonal entry in inches, or (4) Instant hardware auto-detection.',
  },
  {
    question: 'How to identify 1 inch on a phone or laptop screen?',
    answer: 'Switch the ruler unit to "IN" using the toolbar chip. Each major numbered tick mark represents exactly 1 inch (25.4 mm). Once calibrated, a US quarter coin placed against the screen will measure almost exactly 0.96 inches (24.26 mm), providing an instant physical verification check.',
  },
  {
    question: 'How to measure centimeters and millimeters online?',
    answer: 'Select "CM" or "MM" in the top toolbar. Align one edge of your object against the ruler. The major labeled ticks show whole centimeters, the medium ticks mark 5 mm (0.5 cm), and each small sub-tick represents 1 millimeter, identical to a stainless steel engineer\'s ruler.',
  },
  {
    question: 'Can a smartphone measure physical objects with millimeter precision?',
    answer: 'Yes. Screen-based rulers are actually significantly more accurate for small objects (up to 15 cm or 6 inches) than smartphone camera AR apps. Camera AR apps suffer from lens distortion, perspective tilt, and sensor drift, whereas glass displays have rigid, non-deformable pixel matrices calibrated to factory sub-millimeter tolerances.',
  },
  {
    question: 'Can I use my phone camera as a ruler compared to an on-screen ruler?',
    answer: 'Camera-based measurement apps estimate distance using depth algorithms, which typically introduce a 3% to 8% margin of error depending on lighting and surface texture. Placing an object directly on your calibrated phone glass eliminates parallax error, delivering true sub-millimeter accuracy.',
  },
  {
    question: 'How do I read fractional inches (1/16, 1/8, 1/4, 1/2) on a screen ruler?',
    answer: 'In "IN" mode, the tick marks follow standard Imperial subdivision: the longest tick with a number is the full inch, the second-longest marks 1/2″, medium ticks mark 1/4″ and 3/4″, shorter ticks represent 1/8″ increments, and the shortest ticks represent 1/16″ precision.',
  },
  {
    question: 'How to measure objects longer than my phone screen?',
    answer: 'You can switch the ruler to landscape mode to access your phone\'s longest edge. For objects exceeding the screen length, use the "Two-Point Measure" tool or mark the end of the phone, slide the device along a straight edge, and add the measurements together.',
  },
  {
    question: 'How to show or add a ruler in Word Online and PowerPoint Online?',
    answer: 'In Word Online, click the "View" tab on the ribbon and check "Ruler" to display document margin tab stops. In PowerPoint Online, check "Ruler" under "View" to align slide shapes. Note that Microsoft Office rulers represent document page margins rather than real-world physical sizes. For physical object measurement, use this web ruler in a browser tab.',
  },
  {
    question: 'Does this online ruler work offline and without installing an app?',
    answer: 'Yes. The entire measurement engine, tick drawing canvas, and calibration algorithms run 100% client-side in vanilla HTML5 and JavaScript. Once loaded, it functions seamlessly without an active internet connection.',
  },
  {
    question: 'Is my calibration and measurement data kept private?',
    answer: 'Completely. All calibration settings, unit selections, and measurement history entries are stored locally on your device in your browser\'s private LocalStorage (fac-online-ruler:v1). Zero measurement data, device serials, or telemetry are ever uploaded.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://freeaccuratecalculator.com/ruler/#webapp',
      url: 'https://freeaccuratecalculator.com/ruler/',
      name: 'Free Online Ruler — Calibrated 1:1 Scale in cm, mm & Inches',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'All (iOS, Android, Windows, macOS, Linux, ChromeOS)',
      browserRequirements: 'Requires JavaScript. Requires HTML5 Canvas.',
      description:
        'Free, calibrated on-screen ruler for phones, tablets, and desktop computers. Measure physical objects with 1:1 true scale accuracy in centimeters, millimeters, fractional inches, and screen pixels.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'cm, mm, fractional inches and pixels scales',
        'ISO 7810 credit card real-world calibration',
        'Device preset hardware catalog for 40+ flagships',
        'Optical loupe magnifier for mobile touch precision',
        'Multi-edge alignment (Top, Bottom, Left, Right)',
        'Invertible number and tick orientation (⇄ Side)',
        'Draggable caliper guide lines with live dual readout',
        'Precision crosshair with coordinate tracking',
        'Live 4-way unit conversion widget',
        'Instant copy to clipboard with haptic feedback',
        'Dark mode and full-screen immersive view',
        '100% client-side privacy with local persistence',
      ],
    },
    {
      '@type': 'HowTo',
      '@id': 'https://freeaccuratecalculator.com/ruler/#howto',
      name: 'How to Calibrate Your Screen as an Actual Size Ruler',
      description: 'Step-by-step instructions to calibrate an on-screen ruler for 100% physical measurement accuracy.',
      step: [
        {
          '@type': 'HowToStep',
          name: 'Open Calibration',
          text: 'Click or tap the Calibrate button in the top toolbar.',
          url: 'https://freeaccuratecalculator.com/ruler/#calibrate',
        },
        {
          '@type': 'HowToStep',
          name: 'Choose Calibration Standard',
          text: 'Select Card to align a standard bank card or ID card, or select Device Preset to choose your exact phone or laptop model.',
        },
        {
          '@type': 'HowToStep',
          name: 'Align Physical Standard',
          text: 'Place your physical card against the on-screen outline and adjust the slider or arrow keys until both match perfectly.',
        },
        {
          '@type': 'HowToStep',
          name: 'Save and Measure',
          text: 'Click Save Calibration. Your display density is permanently remembered in your browser for 1:1 scale accuracy.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://freeaccuratecalculator.com/ruler/#faq',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://freeaccuratecalculator.com/ruler/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://freeaccuratecalculator.com/' },
        { '@type': 'ListItem', position: 2, name: 'Everyday', item: 'https://freeaccuratecalculator.com/everyday/' },
        { '@type': 'ListItem', position: 3, name: 'Online Ruler', item: 'https://freeaccuratecalculator.com/ruler/' },
      ],
    },
  ],
};
---

<CalculatorLayout
  title="Online Ruler — Free Accurate Ruler in cm, mm & Inches"
  metaDescription="Free online ruler with screen calibration. Measure real objects on screen in cm, mm and inches — auto, device, diagonal or bank-card calibration on phone, tablet and desktop."
  h1="Free Online Ruler — Measure in cm, mm & Inches"
  subtitle="A calibrated full-screen ruler for real-world measuring: cm, mm, inches and pixels, with bank-card calibration, draggable guides, crosshair and a direct measure mode."
  category={{ label: 'Everyday', href: '/everyday/' }}
  calculatorName="Online Ruler"
  relatedCalculators={relatedCalculators}
  jsonLd={schema}
  appFullscreen
  disableEmailModal
>
  <!-- ============================== TOOL ============================== -->
  <div id="ruler-app" class="ruler-app-shell calculator-main-box relative rounded-[20px] border border-hairline bg-canvas-elevated p-2.5 sm:p-4 shadow-whisper overflow-hidden transition-all print:hidden" data-js="ruler-root">
    <div class="pointer-events-none absolute -top-32 -right-32 w-80 h-80 rounded-full bg-link/10 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-32 w-80 h-80 rounded-full bg-violet/10 blur-3xl" aria-hidden="true"></div>

    <!-- Premium toolbar (compact single line) -->
    <div class="ruler-toolbar relative z-10 rounded-xl border border-hairline bg-canvas/90 backdrop-blur-xl shadow-whisper p-1">
      <div class="flex items-center gap-1.5 overflow-x-auto whitespace-nowrap scrollbar-none py-0.5 px-1 text-xs" role="toolbar" aria-label="Ruler controls">
        <!-- Status & Calibrate -->
        <button type="button" id="ruler-cal-btn" class="inline-flex items-center gap-1.5 px-2.5 py-1 min-h-[34px] rounded-lg border border-hairline bg-canvas-elevated font-mono font-semibold text-ink hover:border-link/50 hover:text-link transition-all shrink-0 cursor-pointer" title="Calibrate display">
          <span id="ruler-status-dot" class="w-2 h-2 rounded-full bg-warning shrink-0" aria-hidden="true"></span>
          <span id="ruler-calibration-label" class="truncate max-w-[120px] sm:max-w-none text-[11px]">Calibrate</span>
        </button>

        <div class="h-4 w-px bg-hairline shrink-0" aria-hidden="true"></div>

        <!-- Unit Segmented -->
        <div class="inline-flex p-0.5 rounded-lg bg-canvas border border-hairline shrink-0" role="group" aria-label="Measurement unit">
          <button type="button" class="ruler-unit-btn px-2 sm:px-2.5 py-1 min-h-[30px] rounded-md text-[11px] font-semibold font-mono transition-all cursor-pointer" data-unit="cm" aria-pressed="true">CM</button>
          <button type="button" class="ruler-unit-btn px-2 sm:px-2.5 py-1 min-h-[30px] rounded-md text-[11px] font-semibold font-mono transition-all cursor-pointer" data-unit="mm" aria-pressed="false">MM</button>
          <button type="button" class="ruler-unit-btn px-2 sm:px-2.5 py-1 min-h-[30px] rounded-md text-[11px] font-semibold font-mono transition-all cursor-pointer" data-unit="in" aria-pressed="false">IN</button>
          <button type="button" class="ruler-unit-btn px-2 sm:px-2.5 py-1 min-h-[30px] rounded-md text-[11px] font-semibold font-mono transition-all cursor-pointer" data-unit="px" aria-pressed="false">PX</button>
        </div>

        <div class="h-4 w-px bg-hairline shrink-0" aria-hidden="true"></div>

        <!-- Edges -->
        <div class="inline-flex p-0.5 rounded-lg bg-canvas border border-hairline shrink-0" role="group" aria-label="Ruler edges">
          <button type="button" class="ruler-edge-btn px-2 sm:px-2.5 py-1 min-h-[30px] rounded-md text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="top" aria-pressed="true">Top</button>
          <button type="button" class="ruler-edge-btn px-2 sm:px-2.5 py-1 min-h-[30px] rounded-md text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="bottom" aria-pressed="false">Bottom</button>
          <button type="button" class="ruler-edge-btn px-2 sm:px-2.5 py-1 min-h-[30px] rounded-md text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="left" aria-pressed="true">Left</button>
          <button type="button" class="ruler-edge-btn px-2 sm:px-2.5 py-1 min-h-[30px] rounded-md text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="right" aria-pressed="false">Right</button>
        </div>

        <!-- Flip Side Button -->
        <button type="button" id="ruler-flip-side-btn" class="inline-flex items-center gap-1 px-2.5 py-1 min-h-[30px] rounded-lg border border-hairline bg-canvas-elevated text-[11px] font-mono font-semibold text-ink hover:border-link/50 transition-all shrink-0 cursor-pointer" title="Invert tick marks and numbers position" aria-pressed="false">
          <span class="text-xs">⇄</span> Side
        </button>

        <div class="h-4 w-px bg-hairline shrink-0" aria-hidden="true"></div>

        <!-- Measure Button -->
        <button type="button" id="ruler-measure-btn" class="inline-flex items-center gap-1 px-2.5 py-1 min-h-[30px] rounded-lg border border-hairline bg-canvas-elevated text-[11px] font-mono font-semibold text-ink hover:border-violet/50 hover:text-violet transition-all shrink-0 cursor-pointer" aria-pressed="false">
          Measure
        </button>

        <!-- Guides Button -->
        <button type="button" id="ruler-guides-btn" class="px-2.5 py-1 min-h-[30px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-ink hover:border-link/50 transition-all shrink-0 cursor-pointer" aria-pressed="false">Guides: off</button>

        <!-- Crosshair Button -->
        <button type="button" id="ruler-crosshair-btn" class="px-2.5 py-1 min-h-[30px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-ink hover:border-link/50 transition-all shrink-0 cursor-pointer" aria-pressed="false">Crosshair: off</button>

        <!-- Fullscreen Button -->
        <button type="button" id="ruler-fullscreen-btn" class="inline-flex items-center gap-1 px-2.5 py-1 min-h-[30px] rounded-lg border border-hairline bg-canvas-elevated text-[11px] font-mono font-semibold text-ink hover:border-cyan/50 hover:text-cyan transition-all shrink-0 cursor-pointer">
          <span id="ruler-fs-label">Fullscreen</span>
        </button>

        <!-- Theme Toggle -->
        <ThemeToggle id="ruler-theme-toggle" className="!min-h-[30px] shrink-0" />

        <!-- More Button -->
        <button type="button" id="ruler-more-btn" class="inline-flex items-center justify-center px-2 py-1 min-h-[30px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas text-mute hover:text-ink transition-all shrink-0 cursor-pointer" aria-expanded="false" aria-controls="ruler-advanced">
          More
        </button>

        <!-- Help & Guide link -->
        <button type="button" id="ruler-cal-help" class="text-[11px] font-mono text-link hover:underline cursor-pointer shrink-0 px-1" aria-expanded="false" aria-controls="ruler-cal-explain">why?</button>
        <a href="/ruler/guides/" class="text-[11px] font-mono font-semibold text-link hover:underline shrink-0 px-1">Guide</a>
      </div>

      <!-- Advanced options (collapsible) -->
      <div id="ruler-advanced" class="hidden flex-wrap items-center gap-2 pt-2 border-t border-hairline-soft mt-1 px-1">
        <button type="button" id="ruler-clear-guides" class="px-2 py-1 min-h-[30px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-mute hover:text-error transition-all cursor-pointer">Clear guides</button>
        <button type="button" id="ruler-help-btn" class="px-2 py-1 min-h-[30px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-mute hover:text-ink transition-all cursor-pointer" aria-expanded="false" aria-controls="ruler-shortcuts">Keyboard shortcuts</button>
      </div>
      <div id="ruler-shortcuts" class="hidden rounded-lg border border-hairline bg-canvas p-2.5 text-[11px] font-mono text-body grid grid-cols-2 sm:grid-cols-3 gap-1 mt-1">
        <span><kbd class="ruler-kbd">1</kbd> cm</span><span><kbd class="ruler-kbd">2</kbd> in</span><span><kbd class="ruler-kbd">3</kbd> mm</span>
        <span><kbd class="ruler-kbd">4</kbd> px</span><span><kbd class="ruler-kbd">G</kbd> guides</span><span><kbd class="ruler-kbd">C</kbd> crosshair</span>
        <span><kbd class="ruler-kbd">F</kbd> full</span><span><kbd class="ruler-kbd">M</kbd> measure</span><span><kbd class="ruler-kbd">Esc</kbd> clear</span>
      </div>
      <p id="ruler-cal-explain" class="hidden mt-1 rounded-lg border border-hairline bg-canvas p-2.5 text-[11px] text-body leading-relaxed">
        Calibration explanation placeholder (filled by script).
      </p>
      <p id="ruler-zoom-warning" class="hidden mt-1 text-[11px] font-mono text-warning-deep dark:text-warning bg-warning-soft/60 border border-warning/30 rounded-md px-2 py-1" role="alert">
        Browser zoom is not 100% — press Ctrl/Cmd + 0 before measuring.
      </p>
    </div>

    <!-- Measure mode bar -->
    <div id="ruler-measure-bar" class="relative z-10 hidden flex-wrap items-center justify-between gap-2 rounded-xl border border-violet/40 bg-violet-soft/50 px-3 py-2">
      <span class="text-[11px] font-mono font-semibold text-ink">Measure mode — tap or drag across the ruler to measure</span>
      <div class="flex items-center gap-2">
        <button type="button" id="ruler-measure-clear" class="px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-mute hover:text-error transition-all cursor-pointer">Clear</button>
        <button type="button" id="ruler-measure-exit" class="px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold border border-violet/50 bg-canvas-elevated text-ink transition-all cursor-pointer">Exit Measure</button>
      </div>
    </div>

    <!-- Measuring stage -->
    <div id="ruler-stage" class="ruler-stage relative z-10 mt-2.5 rounded-xl border border-hairline bg-canvas overflow-hidden select-none" style="min-height: 300px;">
      <canvas id="ruler-canvas-top" class="ruler-canvas absolute top-0 left-0 w-full" height="40" aria-hidden="true"></canvas>
      <canvas id="ruler-canvas-bottom" class="ruler-canvas absolute bottom-0 left-0 w-full hidden" height="40" aria-hidden="true"></canvas>
      <canvas id="ruler-canvas-left" class="ruler-canvas absolute top-0 left-0 h-full hidden" width="40" aria-hidden="true"></canvas>
      <canvas id="ruler-canvas-right" class="ruler-canvas absolute top-0 right-0 h-full hidden" width="40" aria-hidden="true"></canvas>

      <div id="ruler-overlays" class="absolute inset-0 z-20" aria-hidden="true">
        <div id="ruler-guides-layer" class="absolute inset-0"></div>
        <div id="ruler-measure-layer" class="absolute inset-0 hidden"></div>
        <div id="ruler-crosshair-x" class="absolute hidden w-full border-t border-dashed border-violet/70 pointer-events-none" style="top:0"></div>
        <div id="ruler-crosshair-y" class="absolute hidden h-full border-l border-dashed border-violet/70 pointer-events-none" style="left:0"></div>
      </div>

      <div id="ruler-readout" class="absolute z-30 hidden pointer-events-none rounded-lg border border-hairline bg-canvas-elevated/95 shadow-whisper px-2.5 py-1.5 text-[11px] sm:text-xs font-mono text-ink" style="top: 40px; left: 40px;">
        <span id="ruler-readout-main" class="font-bold">—</span>
        <span id="ruler-readout-sub" class="text-mute block"></span>
      </div>

      <div id="ruler-hint" class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none">
        <p class="text-center text-[11px] sm:text-xs text-mute font-mono px-6 max-w-md leading-relaxed">
          Place a flat object against the <span class="text-ink font-semibold">top</span> or <span class="text-ink font-semibold">left</span> edge to read its size.
          <span class="block mt-1">Turn on Measure to drag a distance anywhere on the stage.</span>
        </p>
      </div>

      <!-- Mobile object placement & edge guide overlay -->
      <div id="ruler-welcome-overlay" class="absolute z-25 inset-x-3 top-12 sm:top-14 max-w-sm mx-auto rounded-xl border border-hairline bg-canvas-elevated/95 backdrop-blur-md p-3.5 shadow-whisper transition-opacity duration-300">
        <div class="flex items-start justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-link/10 text-link text-xs font-mono font-bold">📏</span>
            <div>
              <h2 class="text-xs font-bold font-mono text-ink">Place Object Against Glass</h2>
              <p class="text-[10px] text-mute font-mono">Calibrated to screen edge for 1:1 true scale</p>
            </div>
          </div>
          <button type="button" id="ruler-welcome-dismiss" class="text-mute hover:text-ink text-xs p-1 rounded cursor-pointer" aria-label="Dismiss guide">✕</button>
        </div>
        <div class="mt-2.5 flex items-center justify-between gap-1 pt-2 border-t border-hairline-soft text-[10px] font-mono">
          <span class="text-mute">Edge:</span>
          <div class="flex gap-1">
            <button type="button" class="ruler-quick-edge px-1.5 py-0.5 rounded bg-canvas border border-hairline text-ink font-semibold hover:border-link transition-colors cursor-pointer" data-edge="left">Left</button>
            <button type="button" class="ruler-quick-edge px-1.5 py-0.5 rounded bg-canvas border border-hairline text-ink font-semibold hover:border-link transition-colors cursor-pointer" data-edge="top">Top</button>
            <button type="button" class="ruler-quick-edge px-1.5 py-0.5 rounded bg-canvas border border-hairline text-ink font-semibold hover:border-link transition-colors cursor-pointer" data-edge="right">Right</button>
            <button type="button" class="ruler-quick-edge px-1.5 py-0.5 rounded bg-canvas border border-hairline text-ink font-semibold hover:border-link transition-colors cursor-pointer" data-edge="bottom">Bottom</button>
          </div>
          <button type="button" id="ruler-welcome-hide-forever" class="text-[10px] text-link hover:underline ml-auto cursor-pointer">Hide info</button>
        </div>
      </div>

      <!-- Optical loupe magnifier for fingertip alignment -->
      <div id="ruler-loupe" class="pointer-events-none absolute z-30 hidden w-20 h-20 -top-24 -left-24 rounded-full border-2 border-violet shadow-2xl bg-canvas overflow-hidden ring-4 ring-black/10">
        <canvas id="ruler-loupe-canvas" width="80" height="80" class="w-full h-full"></canvas>

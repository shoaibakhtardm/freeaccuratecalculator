  // ---------------------------------------------------------------------
  // Online Ruler — client controller. All measurement math comes from
  // src/engines/ruler.ts (the single source of truth). This file only
  // wires DOM events, rendering, and persistence.
  // ---------------------------------------------------------------------
  import {
    DEFAULT_PPI,
    DEVICE_PRESETS,
    REFERENCE_OBJECTS,
    calibrationFromReference,
    calibrationQuality,
    devicePresetPpi,
    formatCoordinate,
    formatReadout,
    autoEstimatePpi,
    generateTicks,
    isPlausibleDiagonal,
    mmToPx,
    ppiFromDiagonal,
    tickSpecForUnit,
    toFractionalInch,
    validatePpi,
    type CalibrationMethod,
    type CalibrationSource,
    type RulerUnit,
    type ReferenceObject,
  } from '../../engines/ruler';

  const $ = <T extends HTMLElement>(id: string): T | null => document.getElementById(id) as T | null;

  const stageMaybe = $('ruler-stage');
  if (stageMaybe) {
    const stage: HTMLElement = stageMaybe;
    const root = $('ruler-app')!;

    // ------------------------------------------------------------- state
    const STORAGE_KEY = 'fac-online-ruler:v1';

    interface PersistedCalibration {
      method: CalibrationMethod;
      source: CalibrationSource;
      ppi: number;
      note: string;
    }

    interface PersistedState {
      v: 1;
      unit: RulerUnit;
      edges: string[];
      guidesOn: boolean;
      crosshairOn: boolean;
      calibration: PersistedCalibration;
    }

    const defaultCalibration: PersistedCalibration = {
      method: 'auto',
      source: 'default',
      ppi: DEFAULT_PPI,
      note: "Ready to measure! Click 'Calibrate' to match your exact screen size for 100% physical accuracy.",
    };

    const VALID_UNITS: RulerUnit[] = ['cm', 'mm', 'in', 'px'];
    const VALID_EDGES = ['top', 'bottom', 'left', 'right'];

    let unit: RulerUnit = 'cm';
    let edges: Set<string> = new Set(['top', 'left']);
    let guidesOn = false;
    let crosshairOn = false;
    let measuring = false;
    let calibration: PersistedCalibration = { ...defaultCalibration };
    let flipSideInverted = false;
    try {
      flipSideInverted = localStorage.getItem('fac-ruler-flip-side') === 'true';
    } catch (_) {}

    function syncFlipSideButton(): void {
      const btn = $('ruler-flip-side-btn');
      if (btn) {
        btn.setAttribute('aria-pressed', flipSideInverted ? 'true' : 'false');
        btn.classList.toggle('text-link', flipSideInverted);
        btn.classList.toggle('border-link/50', flipSideInverted);
      }
    }

    function toggleFlipSide(): void {
      flipSideInverted = !flipSideInverted;
      try {
        localStorage.setItem('fac-ruler-flip-side', String(flipSideInverted));
      } catch (_) {}
      syncFlipSideButton();
      renderEdges();
    }

    function sanitizeState(raw: unknown): Partial<PersistedState> | null {
      if (!raw || typeof raw !== 'object') return null;
      const obj = raw as Record<string, unknown>;
      const out: Partial<PersistedState> = {};
      if (typeof obj.unit === 'string' && VALID_UNITS.includes(obj.unit as RulerUnit)) out.unit = obj.unit as RulerUnit;
      if (Array.isArray(obj.edges)) {
        const clean = obj.edges.filter((e): e is string => typeof e === 'string' && VALID_EDGES.includes(e));
        if (clean.length > 0) out.edges = clean;
      }
      if (typeof obj.guidesOn === 'boolean') out.guidesOn = obj.guidesOn;
      if (typeof obj.crosshairOn === 'boolean') out.crosshairOn = obj.crosshairOn;
      if (obj.calibration && typeof obj.calibration === 'object') {
        const cal = obj.calibration as Record<string, unknown>;
        if (typeof cal.ppi === 'number' && isFinite(cal.ppi) && cal.ppi >= 40 && cal.ppi <= 1200) {
          out.calibration = {
            method: (typeof cal.method === 'string' ? cal.method : 'auto') as CalibrationMethod,
            source: (typeof cal.source === 'string' ? cal.source : 'default') as CalibrationSource,
            ppi: cal.ppi,
            note: typeof cal.note === 'string' ? cal.note : '',
          };
        }
      }
      return out;
    }

    function loadState(): void {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const parsed = sanitizeState(JSON.parse(raw));
        if (!parsed) return;
        if (parsed.unit) unit = parsed.unit;
        if (parsed.edges) edges = new Set(parsed.edges);
        if (typeof parsed.guidesOn === 'boolean') guidesOn = parsed.guidesOn;
        if (typeof parsed.crosshairOn === 'boolean') crosshairOn = parsed.crosshairOn;
        if (parsed.calibration) calibration = parsed.calibration;
      } catch (_) {
        /* private browsing, corrupt data, or unavailable storage — defaults are fine */
      }
    }

    function saveState(): void {
      try {
        const payload: PersistedState = {
          v: 1,
          unit,
          edges: Array.from(edges),
          guidesOn,
          crosshairOn,
          calibration,
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      } catch (_) {
        /* never let storage failure break the ruler */
      }
    }

    loadState();

    // ------------------------------------------------------- DOM handles
    const canvases: Record<string, HTMLCanvasElement | null> = {
      top: $('ruler-canvas-top'),
      bottom: $('ruler-canvas-bottom'),
      left: $('ruler-canvas-left'),
      right: $('ruler-canvas-right'),
    };
    const guidesLayer = $('ruler-guides-layer')!;
    const measureLayer = $('ruler-measure-layer')!;
    const crosshairX = $('ruler-crosshair-x')!;
    const crosshairY = $('ruler-crosshair-y')!;
    const readout = $('ruler-readout')!;
    const readoutMain = $('ruler-readout-main')!;
    const readoutSub = $('ruler-readout-sub')!;
    const statusDot = $('ruler-status-dot')!;
    const statusLabel = $('ruler-calibration-label')!;
    const calExplain = $('ruler-cal-explain')!;
    const calHelpBtn = $('ruler-cal-help')!;
    const zoomWarning = $('ruler-zoom-warning')!;
    const resultUnit = $('ruler-result-unit')!;
    const resultPpi = $('ruler-result-ppi')!;
    const resultLast = $('ruler-result-last')!;
    const historyPanel = $('ruler-history-panel')!;
    const historyList = $('ruler-history-list')!;
    const guideTemplate = $('ruler-guide-template') as HTMLTemplateElement;

    const calDialog = $('ruler-cal-dialog')!;
    const cardRect = $('ruler-card-rect')!;
    const cardSlider = $('ruler-card-slider') as HTMLInputElement;
    const cardWidthLabel = $('ruler-card-width-label')!;
    const diagInput = $('ruler-diag-input') as HTMLInputElement;
    const diagW = $('ruler-diag-w') as HTMLInputElement;
    const diagH = $('ruler-diag-h') as HTMLInputElement;
    const diagError = $('ruler-diag-error')!;
    const deviceSelect = $('ruler-device-select') as HTMLSelectElement;
    const autoNote = $('ruler-auto-note')!;
    const measureBar = $('ruler-measure-bar')!;

    // --------------------------------------------------- stage interaction
    let stageRectCache: DOMRect | null = null;

    function invalidateStageRect(): void {
      stageRectCache = null;
    }

    function stageRect(): DOMRect {
      if (!stageRectCache) stageRectCache = stage.getBoundingClientRect();
      return stageRectCache;
    }

    function syncStageInteraction(): void {
      stage.classList.toggle('ruler-interactive', measuring || guidesOn || crosshairOn);
    }

    // --------------------------------------------------- calibration math
    let lastCalError = '';

    function applyCalibration(next: PersistedCalibration): void {
      try {
        validatePpi(next.ppi);
        calibration = next;
        saveState();
        renderAll();
        updateStatus();
        syncConverterFromActive();
      } catch (err) {
        lastCalError = err instanceof RangeError ? err.message : 'Invalid calibration value';
      }
    }

    function referenceById(id: string): ReferenceObject {
      return REFERENCE_OBJECTS.find((r) => r.id === id) || REFERENCE_OBJECTS[0];
    }

    function referenceIsLongEdgeHorizontal(ref: ReferenceObject): boolean {
      if (ref.id === 'a4-paper' || ref.id === 'us-letter') return false;
      return ref.heightMm >= ref.widthMm;
    }

    // --------------------------------------------- canvas edge rendering
    function cssVar(name: string, fallback: string): string {
      const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return v || fallback;
    }

    function renderEdge(edge: string): void {
      const canvas = canvases[edge];
      if (!canvas || !edges.has(edge)) return;
      const vertical = edge === 'left' || edge === 'right';
      const cssLength = vertical ? stage.clientHeight : stage.clientWidth;
      const cssThickness = 40;
      const dpr = window.devicePixelRatio || 1;
      const w = Math.max(1, Math.round((vertical ? cssThickness : cssLength) * dpr));
      const h = Math.max(1, Math.round((vertical ? cssLength : cssThickness) * dpr));
      if (canvas.width !== w) canvas.width = w;
      if (canvas.height !== h) canvas.height = h;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, vertical ? cssThickness : cssLength, vertical ? cssLength : cssThickness);

      const ink = cssVar('--color-ink', '#171717');
      const mute = cssVar('--color-mute', '#8f8f8f');
      const faint = cssVar('--color-faint', '#a1a1a1');
      const hairline = cssVar('--color-hairline', '#ebebeb');

      const spec = tickSpecForUnit(unit, calibration.ppi);
      const ticks = generateTicks(cssLength, spec);
      const baseFlip = edge === 'top' || edge === 'left';
      const flip = flipSideInverted ? !baseFlip : baseFlip;

      ctx.lineWidth = 1;
      ctx.font = '600 9px "Geist Mono", ui-monospace, monospace';
      ctx.textBaseline = 'middle';

      for (const t of ticks) {
        const len = t.level === 'major' ? 24 : t.level === 'medium' ? 15 : 8;
        const color = t.level === 'major' ? ink : t.level === 'medium' ? mute : faint;
        ctx.strokeStyle = color;
        ctx.beginPath();
        if (vertical) {
          const baseX = flip ? 0.5 : cssThickness - 0.5;
          const dir = flip ? 1 : -1;
          ctx.moveTo(baseX, Math.round(t.px) + 0.5);
          ctx.lineTo(baseX + dir * len, Math.round(t.px) + 0.5);
        } else {
          const baseY = flip ? 0.5 : cssThickness - 0.5;
          const dir = flip ? 1 : -1;
          ctx.moveTo(Math.round(t.px) + 0.5, baseY);
          ctx.lineTo(Math.round(t.px) + 0.5, baseY + dir * len);
        }
        ctx.stroke();

        if (t.label) {
          ctx.fillStyle = ink;
          if (vertical) {
            const labelX = flip ? cssThickness - 9 : 9;
            ctx.save();
            ctx.translate(labelX, t.px);
            ctx.rotate(Math.PI / 2);
            ctx.textAlign = 'center';
            ctx.fillText(t.label, 0, 0);
            ctx.restore();
          } else {
            ctx.textAlign = 'center';
            ctx.fillText(t.label, t.px, flip ? cssThickness - 9 : 9);
          }
        }
      }

      ctx.strokeStyle = hairline;
      ctx.beginPath();
      if (vertical) {
        const x = edge === 'left' ? cssThickness - 0.5 : 0.5;
        ctx.moveTo(x, 0);
        ctx.lineTo(x, cssLength);
      } else {
        const y = edge === 'top' ? cssThickness - 0.5 : 0.5;
        ctx.moveTo(0, y);
        ctx.lineTo(cssLength, y);
      }
      ctx.stroke();
    }

    function renderEdges(): void {
      for (const edge of VALID_EDGES) {
        const canvas = canvases[edge];
        if (!canvas) continue;
        if (edges.has(edge)) {
          canvas.classList.remove('hidden');
          renderEdge(edge);
        } else {
          canvas.classList.add('hidden');
        }
      }
    }

    // ------------------------------------------------------ guides system
    let guideCount = 0;

    function updateGuideLabel(guide: HTMLElement): void {
      const axis = guide.dataset.axis === 'x' ? 'X' : 'Y';
      const px = parseFloat(guide.dataset.px || '0');
      const label = guide.querySelector('.ruler-guide-label');
      if (label) label.textContent = formatCoordinate(axis, px, unit, calibration.ppi);
    }

    function setGuidePos(guide: HTMLElement, px: number): void {
      const isX = guide.dataset.axis === 'x';
      const max = isX ? stage.clientWidth : stage.clientHeight;
      const clamped = Math.min(Math.max(0, px), Math.max(0, max - 1));
      guide.dataset.px = String(Math.round(clamped * 10) / 10);
      if (isX) guide.style.left = `${clamped}px`;
      else guide.style.top = `${clamped}px`;
      updateGuideLabel(guide);
    }

    function createGuide(axis: 'x' | 'horizontal', px: number): HTMLElement {
      const node = guideTemplate.content.firstElementChild;
      if (!node) throw new Error('guide template missing');
      const guide = node.cloneNode(true) as HTMLElement;
      guide.dataset.axis = axis;
      guide.setAttribute('aria-orientation', axis === 'x' ? 'vertical' : 'horizontal');
      guide.setAttribute('aria-label', axis === 'x' ? 'Vertical measurement guide — drag or use arrow keys' : 'Horizontal measurement guide — drag or use arrow keys');
      guideCount += 1;
      guide.dataset.gid = String(guideCount);
      guidesLayer.appendChild(guide);
      setGuidePos(guide, px);
      attachGuideDrag(guide);
      return guide;
    }

    function attachGuideDrag(guide: HTMLElement): void {
      let dragging = false;
      let startPointer = 0;
      let startPos = 0;
      let rafId: number | null = null;
      let pendingGuidePos: number | null = null;

      guide.addEventListener('pointerdown', (e: PointerEvent) => {
        dragging = true;
        startPointer = guide.dataset.axis === 'x' ? e.clientX : e.clientY;
        startPos = parseFloat(guide.dataset.px || '0');
        guide.setPointerCapture(e.pointerId);
        e.preventDefault();
      });
      guide.addEventListener('pointermove', (e: PointerEvent) => {
        if (!dragging) return;
        const cur = guide.dataset.axis === 'x' ? e.clientX : e.clientY;
        const next = startPos + (cur - startPointer);
        if (rafId === null) {
          rafId = requestAnimationFrame(() => {
            rafId = null;
            setGuidePos(guide, next);
          });
        } else {
          pendingGuidePos = next;
        }
      });
      const endDrag = (e: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
        if (pendingGuidePos !== null) {
          setGuidePos(guide, pendingGuidePos);
          pendingGuidePos = null;
        }
        try {
          guide.releasePointerCapture(e.pointerId);
        } catch (_) {}
      };
      guide.addEventListener('pointerup', endDrag);
      guide.addEventListener('pointercancel', endDrag);

      guide.addEventListener('keydown', (e: KeyboardEvent) => {
        const pos = parseFloat(guide.dataset.px || '0');
        const step = e.shiftKey ? 10 : 1;
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          setGuidePos(guide, pos - step);
        } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          setGuidePos(guide, pos + step);
        } else if (e.key === 'Delete' || e.key === 'Backspace') {
          e.preventDefault();
          guide.remove();
        }
      });

      guide.addEventListener('dblclick', () => guide.remove());
    }

    function ensureDefaultGuides(): void {
      if (guidesLayer.children.length === 0) {
        createGuide('horizontal', Math.round(stage.clientHeight * 0.35));
        createGuide('x', Math.round(stage.clientWidth * 0.35));
      }
    }

    function setGuides(on: boolean): void {
      guidesOn = on;
      if (on) ensureDefaultGuides();
      guidesLayer.classList.toggle('hidden', !on);
      syncToggleButtons();
      syncStageInteraction();
      saveState();
    }

    function clearGuides(): void {
      guidesLayer.replaceChildren();
      if (guidesOn) setGuides(false);
    }

    // ------------------------------------------------- crosshair + readout
    function setCrosshair(on: boolean): void {
      crosshairOn = on;
      if (!on) {
        crosshairX.classList.add('hidden');
        crosshairY.classList.add('hidden');
        readout.classList.add('hidden');
        stage.classList.remove('ruler-crosshair-active');
      } else {
        stage.classList.add('ruler-crosshair-active');
      }
      syncToggleButtons();
      syncStageInteraction();
      saveState();
    }

    function positionReadout(x: number, y: number): void {
      const chipW = readout.offsetWidth || 140;
      const chipH = readout.offsetHeight || 44;
      const maxX = Math.max(0, stage.clientWidth - chipW - 6);
      const maxY = Math.max(0, stage.clientHeight - chipH - 6);
      readout.style.left = `${Math.min(Math.max(6, x + 14), maxX)}px`;
      readout.style.top = `${Math.min(Math.max(6, y + 14), maxY)}px`;
    }

    function runStagePointerMove(x: number, y: number): void {
      if (measuring) {
        updateMeasureDrag(x, y);
        return;
      }
      if (!crosshairOn) return;
      crosshairX.style.top = `${y}px`;
      crosshairY.style.left = `${x}px`;
      readoutMain.textContent = formatCoordinate('X', x, unit, calibration.ppi);
      readoutSub.textContent = formatCoordinate('Y', y, unit, calibration.ppi);
      readout.classList.remove('hidden');
      positionReadout(x, y);
    }

    let stageMoveRaf: number | null = null;
    let pendingStagePoint: { x: number; y: number } | null = null;

    function onStagePointerMove(e: PointerEvent): void {
      const rect = stageRect();
      pendingStagePoint = { x: e.clientX - rect.left, y: e.clientY - rect.top };
      if (stageMoveRaf !== null) return;
      stageMoveRaf = requestAnimationFrame(() => {
        stageMoveRaf = null;
        if (pendingStagePoint) runStagePointerMove(pendingStagePoint.x, pendingStagePoint.y);
      });
    }

    function onStagePointerLeave(): void {
      hideLoupe();
      if (measuring) return;
      crosshairX.classList.add('hidden');
      crosshairY.classList.add('hidden');
      readout.classList.add('hidden');
    }

    // --------------------------------------------------- measurement mode
    let measureStart: { x: number; y: number } | null = null;
    let measureLine: HTMLElement | null = null;
    let measureDotA: HTMLElement | null = null;
    let measureDotB: HTMLElement | null = null;

    function setMeasure(on: boolean): void {
      measuring = on;
      stage.classList.toggle('ruler-measuring', on);
      measureLayer.classList.toggle('hidden', !on);
      measureBar.classList.toggle('hidden', !on);
      measureBar.classList.toggle('flex', on);
      if (!on) {
        measureStart = null;
        hideLoupe();
      }
      invalidateStageRect();
      syncToggleButtons();
      syncStageInteraction();
    }

    function hypot(dx: number, dy: number): number {
      return Math.sqrt(dx * dx + dy * dy);
    }

    function updateMeasureDrag(x: number, y: number): void {
      if (!measureStart) return;
      const dx = x - measureStart.x;
      const dy = y - measureStart.y;
      const dist = hypot(dx, dy);
      if (measureLine) {
        measureLine.style.width = `${dist}px`;
        measureLine.style.transform = `rotate(${Math.atan2(dy, dx)}rad)`;
        measureLine.style.left = `${measureStart.x}px`;
        measureLine.style.top = `${measureStart.y}px`;
      }
      if (measureDotB) {
        measureDotB.style.left = `${x}px`;
        measureDotB.style.top = `${y}px`;
      }
      const r = formatReadout(dist, { unit, ppi: calibration.ppi });
      readoutMain.textContent = r.primary;
      readoutSub.textContent = r.secondary.join('  ·  ');
      readout.classList.remove('hidden');
      positionReadout(x, y);
      updateLoupe(x, y);
    }

    function onStagePointerDown(e: PointerEvent): void {
      if (!measuring) return;
      const rect = stageRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      measureLayer.replaceChildren();
      measureStart = { x, y };
      measureLine = document.createElement('div');
      measureLine.className = 'ruler-measure-line';
      measureDotA = document.createElement('div');
      measureDotA.className = 'ruler-measure-dot';
      measureDotA.style.left = `${x}px`;
      measureDotA.style.top = `${y}px`;
      measureDotB = document.createElement('div');
      measureDotB.className = 'ruler-measure-dot';
      measureLayer.append(measureLine, measureDotA, measureDotB);
      stage.setPointerCapture(e.pointerId);
      e.preventDefault();
      updateLoupe(x, y);
    }

    function onStagePointerUp(e: PointerEvent): void {
      hideLoupe();
      if (!measuring || !measureStart) return;
      const rect = stageRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const dist = hypot(x - measureStart.x, y - measureStart.y);
      const r = formatReadout(dist, { unit, ppi: calibration.ppi });
      resultLast.textContent = r.primary;
      addToHistory(r.primary, r.secondary);
      measureStart = null;
      try {
        stage.releasePointerCapture(e.pointerId);
      } catch (_) {}
    }

    function clearMeasureOverlay(): void {
      measureLayer.replaceChildren();
      measureStart = null;
      readout.classList.add('hidden');
    }

    // ---------------------------------------------------------- history log
    interface HistoryEntry {
      id: number;
      primary: string;
      secondary: string;
      unit: RulerUnit;
    }

    const HISTORY_LIMIT = 20;
    let historyId = 0;
    const measurementHistory: HistoryEntry[] = [];

    function fallbackCopy(text: string, done: () => void): void {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.top = '-1000px';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        done();
      } catch (_) {
        /* clipboard unavailable — silently ignore */
      }
    }

    function flashCopied(id: number): void {
      const btn = historyList.querySelector<HTMLButtonElement>(`[data-copy="${id}"]`);
      if (!btn) return;
      const original = btn.textContent;
      btn.textContent = 'Copied';
      window.setTimeout(() => {
        btn.textContent = original;
      }, 1200);
    }

    function copyHistoryEntry(entry: HistoryEntry): void {
      const text = entry.secondary ? `${entry.primary} (${entry.secondary})` : entry.primary;
      const done = () => flashCopied(entry.id);
      if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
        navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
      } else {
        fallbackCopy(text, done);
      }
    }

    function addToHistory(primary: string, secondary: string[]): void {
      if (!primary) return;
      historyId += 1;
      measurementHistory.unshift({ id: historyId, primary, secondary: secondary.join('  ·  '), unit });
      if (measurementHistory.length > HISTORY_LIMIT) measurementHistory.length = HISTORY_LIMIT;
      renderHistory();
    }

    function renderHistory(): void {
      if (measurementHistory.length === 0) {
        historyPanel.classList.add('hidden');
        historyList.replaceChildren();
        return;
      }
      historyPanel.classList.remove('hidden');
      historyList.replaceChildren(
        ...measurementHistory.map((entry) => {
          const li = document.createElement('li');
          li.className = 'flex items-center justify-between gap-2 rounded-lg border border-hairline bg-canvas-elevated p-2.5';
          const info = document.createElement('div');
          info.className = 'min-w-0';
          const main = document.createElement('span');
          main.className = 'block text-xs font-mono font-bold text-ink truncate';
          main.textContent = entry.primary;
          const sub = document.createElement('span');
          sub.className = 'block text-[10px] font-mono text-mute truncate';
          sub.textContent = entry.secondary;
          info.append(main, sub);
          const copy = document.createElement('button');
          copy.type = 'button';
          copy.dataset.copy = String(entry.id);
          copy.className = 'shrink-0 px-2.5 py-1.5 min-h-[36px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas text-link hover:border-link/50 transition-all cursor-pointer';
          copy.textContent = 'Copy';
          copy.setAttribute('aria-label', `Copy measurement ${entry.primary}`);
          copy.addEventListener('click', () => copyHistoryEntry(entry));
          li.append(info, copy);
          return li;
        })
      );
    }

    function clearHistory(): void {
      measurementHistory.length = 0;
      renderHistory();
    }

    // ------------------------------------------------------------- toolbar
    const unitButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.ruler-unit-btn'));
    const edgeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.ruler-edge-btn'));

    function setUnit(next: RulerUnit): void {
      unit = next;
      for (const btn of unitButtons) btn.setAttribute('aria-pressed', btn.dataset.unit === next ? 'true' : 'false');
      resultUnit.textContent = next;
      for (const g of Array.from(guidesLayer.children) as HTMLElement[]) updateGuideLabel(g);
      renderEdges();
      updateZoomWarning();
      saveState();
    }

    function toggleEdge(edge: string): void {
      if (edges.has(edge)) edges.delete(edge);
      else edges.add(edge);
      syncEdgeButtons();
      renderEdges();
      saveState();
    }

    function syncEdgeButtons(): void {
      for (const btn of edgeButtons) btn.setAttribute('aria-pressed', edges.has(btn.dataset.edge || '') ? 'true' : 'false');
    }

    function syncToggleButtons(): void {
      const pairs: Array<[string, boolean]> = [
        ['ruler-guides-btn', guidesOn],
        ['ruler-crosshair-btn', crosshairOn],
        ['ruler-measure-btn', measuring],
      ];
      for (const [id, on] of pairs) {
        const el = $(id);
        if (el) {
          el.setAttribute('aria-pressed', on ? 'true' : 'false');
          if (el.textContent) {
            if (id.startsWith('ruler-guides')) el.textContent = `Guides: ${on ? 'on' : 'off'}`;
            if (id.startsWith('ruler-crosshair')) el.textContent = `Crosshair: ${on ? 'on' : 'off'}`;
          }
        }
      }
      const mb = $('ruler-measure-btn');
      if (mb) mb.classList.toggle('!border-violet', measuring);
    }

    // ---------------------------------------------------------- fullscreen
    const fsBtn = $('ruler-fullscreen-btn')!;
    const fsLabel = $('ruler-fs-label')!;

    function isFullscreen(): boolean {
      return Boolean(document.fullscreenElement);
    }

    function setImmersive(on: boolean): void {
      root.classList.toggle('ruler-immersive', on);
      document.body.style.overflow = on ? 'hidden' : '';
      fsLabel.textContent = on ? 'Exit fullscreen' : 'Fullscreen';
      invalidateStageRect();
      requestAnimationFrame(() => {
        renderAll();
        invalidateStageRect();
      });
    }

    function toggleFullscreen(): void {
      const next = !root.classList.contains('ruler-immersive');
      setImmersive(next);
      if (document.fullscreenEnabled && typeof root.requestFullscreen === 'function') {
        if (next) root.requestFullscreen().catch(() => {});
        else if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      }
    }

    document.addEventListener('fullscreenchange', () => {
      if (isFullscreen()) {
        setImmersive(true);
      } else if (root.classList.contains('ruler-immersive')) {
        setImmersive(false);
      }
      requestAnimationFrame(renderEdges);
    });

    // -------------------------------------------------- calibration dialog
    let lastFocus: HTMLElement | null = null;

    function openCalDialog(): void {
      lastFocus = document.activeElement as HTMLElement | null;
      calDialog.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      computeAutoEstimate();
      diagW.value = String(window.screen.width);
      diagH.value = String(window.screen.height);
      cardSlider.dispatchEvent(new Event('input'));
      $('ruler-cal-close')?.focus();
    }

    function closeCalDialog(): void {
      calDialog.classList.add('hidden');
      document.body.style.overflow = '';
      if (lastFocus) lastFocus.focus();
    }

    function setCalMethod(method: CalibrationMethod): void {
      for (const tab of Array.from(document.querySelectorAll<HTMLButtonElement>('.ruler-cal-tab'))) {
        tab.setAttribute('aria-selected', tab.dataset.method === method ? 'true' : 'false');
      }
      for (const panel of Array.from(document.querySelectorAll<HTMLElement>('.ruler-cal-panel'))) {
        panel.classList.toggle('hidden', panel.dataset.panel !== method);
      }
    }

    function applyReferenceSelection(): void {
      const checked = document.querySelector<HTMLInputElement>('input[name="ruler-ref"]:checked');
      const ref = referenceById(checked?.value || 'bank-card');
      const longHorizontal = referenceIsLongEdgeHorizontal(ref);
      const alignedMm = longHorizontal ? ref.heightMm : ref.widthMm;
      const perpMm = longHorizontal ? ref.widthMm : ref.heightMm;
      cardRect.style.aspectRatio = `${alignedMm} / ${perpMm}`;
      cardRect.textContent = `${alignedMm.toFixed(2)} mm × ${perpMm.toFixed(2)} mm`;
      const defaultPx = Math.round(mmToPx(alignedMm, calibration.ppi));
      cardSlider.min = String(Math.max(40, Math.round(defaultPx * 0.4)));
      cardSlider.max = String(Math.round(defaultPx * 2.2));
      cardSlider.value = String(defaultPx);
      cardWidthLabel.textContent = String(defaultPx);
      syncCardRect();
    }

    function syncCardRect(): void {
      const px = parseInt(cardSlider.value, 10);
      cardRect.style.width = `${px}px`;
      cardWidthLabel.textContent = String(px);
    }

    function computeAutoEstimate(): void {
      const result = autoEstimatePpi({
        dpr: window.devicePixelRatio || 1,
        screenWidthPx: window.screen.width,
        screenHeightPx: window.screen.height,
      });
      if (result) {
        autoNote.textContent = `${result.note} Estimated scale: about ${Math.round(result.ppi)} pixels per inch.`;
      } else {
        autoNote.textContent = 'Display information is unavailable in this browser — use card or diagonal calibration instead.';
        const autoSave = $('ruler-save-auto');
        if (autoSave) autoSave.setAttribute('disabled', 'true');
      }
    }

    function saveDiagonal(): void {
      diagError.classList.add('hidden');
      const d = parseFloat(diagInput.value);
      const w = parseInt(diagW.value, 10);
      const h = parseInt(diagH.value, 10);
      if (!isPlausibleDiagonal(d)) {
        diagError.textContent = 'Enter a realistic diagonal between 1 and 200 inches (e.g. 15.6).';
        diagError.classList.remove('hidden');
        return;
      }
      if (!isFinite(w) || w <= 0 || !isFinite(h) || h <= 0) {
        diagError.textContent = 'Screen width and height must be positive pixel numbers.';
        diagError.classList.remove('hidden');
        return;
      }
      try {
        const ppi = ppiFromDiagonal(d, w, h);
        applyCalibration({
          method: 'diagonal',
          source: 'diagonal',
          ppi,
          note: `Calibrated with a ${d}″ screen at ${w}×${h} CSS pixels.`,
        });
        closeCalDialog();
      } catch (err) {
        diagError.textContent = err instanceof RangeError ? err.message : 'Could not compute PPI from those values.';
        diagError.classList.remove('hidden');
      }
    }

    function saveCard(): void {
      const checked = document.querySelector<HTMLInputElement>('input[name="ruler-ref"]:checked');
      const ref = referenceById(checked?.value || 'bank-card');
      const pixels = parseInt(cardSlider.value, 10);
      try {
        const { ppi, note } = calibrationFromReference({
          reference: ref,
          alignedLongEdge: referenceIsLongEdgeHorizontal(ref),
          pixels,
        });
        applyCalibration({ method: 'card', source: 'card', ppi, note });
        closeCalDialog();
      } catch (err) {
        window.alert(err instanceof RangeError ? err.message : 'Calibration failed — check the outline width.');
      }
    }

    function saveDevice(): void {
      const preset = DEVICE_PRESETS.find((p) => p.id === deviceSelect.value);
      if (!preset) return;
      const ppi = devicePresetPpi(preset);
      applyCalibration({
        method: 'device',
        source: 'device',
        ppi,
        note: `Using the ${preset.label} preset — typical panel geometry for this category.`,
      });
      closeCalDialog();
    }

    function saveAuto(): void {
      const result = autoEstimatePpi({
        dpr: window.devicePixelRatio || 1,
        screenWidthPx: window.screen.width,
        screenHeightPx: window.screen.height,
      });
      if (!result) return;
      applyCalibration({ method: 'auto', source: 'auto', ppi: result.ppi, note: result.note });
      closeCalDialog();
    }

    // ------------------------------------------------------ status display
    function updateStatus(): void {
      const q = calibrationQuality({ method: calibration.method, source: calibration.source, ppi: calibration.ppi, note: calibration.note });
      statusLabel.textContent = q.label;
      calExplain.textContent = q.explanation;
      statusDot.className =
        q.confidence === 'reference'
          ? 'w-2.5 h-2.5 rounded-full bg-cyan shrink-0'
          : q.confidence === 'calibrated'
            ? 'w-2.5 h-2.5 rounded-full bg-link shrink-0'
            : 'w-2.5 h-2.5 rounded-full bg-warning shrink-0';
      resultPpi.textContent = `${Math.round(calibration.ppi)} px/in`;
    }

    // ------------------------------------------------------ zoom detection
    let zoomTimer: ReturnType<typeof setTimeout> | null = null;

    function updateZoomWarning(): void {
      let zoomed = false;
      if (unit !== 'px') {
        if (window.visualViewport && window.visualViewport.scale > 1.02) zoomed = true;
        if (window.outerWidth > 0 && window.innerWidth > 0) {
          const ratio = window.outerWidth / window.innerWidth;
          if (ratio > 1.08) zoomed = true;
        }
      }
      zoomWarning.classList.toggle('hidden', !zoomed);
    }

    function queueZoomCheck(): void {
      if (zoomTimer) clearTimeout(zoomTimer);
      zoomTimer = setTimeout(updateZoomWarning, 150);
    }

    // ----------------------------------------------------- optical loupe
    const loupe = $('ruler-loupe');
    const loupeCanvas = $('ruler-loupe-canvas') as HTMLCanvasElement | null;
    const loupeCtx = loupeCanvas ? loupeCanvas.getContext('2d') : null;

    function updateLoupe(pointerX: number, pointerY: number): void {
      if (!loupe || !loupeCanvas || !loupeCtx) return;
      loupe.classList.remove('hidden');
      const size = 80;
      let lx = pointerX - size / 2;
      let ly = pointerY - size - 16;
      if (ly < 10) ly = pointerY + 24;
      if (lx < 10) lx = 10;
      if (lx + size > stage.clientWidth - 10) lx = stage.clientWidth - size - 10;
      loupe.style.left = `${lx}px`;
      loupe.style.top = `${ly}px`;

      loupeCtx.clearRect(0, 0, 80, 80);
      loupeCtx.fillStyle = cssVar('--color-canvas-elevated', '#ffffff');
      loupeCtx.fillRect(0, 0, 80, 80);

      const dpr = window.devicePixelRatio || 1;
      for (const edge of VALID_EDGES) {
        if (!edges.has(edge)) continue;
        const cvs = canvases[edge];
        if (!cvs) continue;
        const vertical = edge === 'left' || edge === 'right';
        const cvsLeft = edge === 'right' ? stage.clientWidth - 40 : 0;
        const cvsTop = edge === 'bottom' ? stage.clientHeight - 40 : 0;
        const srcX = Math.max(0, pointerX - 20) - cvsLeft;
        const srcY = Math.max(0, pointerY - 20) - cvsTop;
        try {
          loupeCtx.drawImage(cvs, srcX * dpr, srcY * dpr, 40 * dpr, 40 * dpr, 0, 0, 80, 80);
        } catch (_) {}
      }
    }

    function hideLoupe(): void {
      loupe?.classList.add('hidden');
    }

    // ---------------------------------------------------- 4-way converter
    const convCm = $('conv-cm') as HTMLInputElement | null;
    const convMm = $('conv-mm') as HTMLInputElement | null;
    const convIn = $('conv-in') as HTMLInputElement | null;
    const convInFrac = $('conv-in-frac');
    const convPx = $('conv-px') as HTMLInputElement | null;
    const convPpiLabel = $('ruler-conv-ppi');

    function syncConverter(from: 'cm' | 'mm' | 'in' | 'px', val: number): void {
      if (!isFinite(val) || val < 0) return;
      const ppi = calibration.ppi;
      let mm = 0;
      if (from === 'cm') mm = val * 10;
      else if (from === 'mm') mm = val;
      else if (from === 'in') mm = val * 25.4;
      else if (from === 'px') mm = (val / ppi) * 25.4;

      const cm = mm / 10;
      const inches = mm / 25.4;
      const px = (mm / 25.4) * ppi;

      if (from !== 'cm' && convCm) convCm.value = (Math.round(cm * 1000) / 1000).toString();
      if (from !== 'mm' && convMm) convMm.value = (Math.round(mm * 100) / 100).toString();
      if (from !== 'in' && convIn) convIn.value = (Math.round(inches * 10000) / 10000).toString();
      if (from !== 'px' && convPx) convPx.value = Math.round(px).toString();

      if (convInFrac) {
        convInFrac.textContent = toFractionalInch(inches, 64);
      }
      if (convPpiLabel) {
        convPpiLabel.textContent = Math.round(ppi).toString();
      }
    }

    function syncConverterFromActive(): void {
      const curCm = parseFloat(convCm?.value || '10');
      syncConverter('cm', isNaN(curCm) || curCm <= 0 ? 10 : curCm);
    }

    // ------------------------------------------------------------ render all
    function renderAll(): void {
      renderEdges();
      for (const g of Array.from(guidesLayer.children) as HTMLElement[]) {
        updateGuideLabel(g);
      }
    }

    // ----------------------------------------------------------- listeners
    for (const btn of unitButtons) {
      btn.addEventListener('click', () => setUnit((btn.dataset.unit || 'cm') as RulerUnit));
    }
    for (const btn of edgeButtons) {
      btn.addEventListener('click', () => toggleEdge(btn.dataset.edge || 'top'));
    }

    $('ruler-flip-side-btn')?.addEventListener('click', toggleFlipSide);

    // Welcome overlay
    const welcomeOverlay = $('ruler-welcome-overlay');
    const welcomeDismiss = $('ruler-welcome-dismiss');
    const welcomeHideForever = $('ruler-welcome-hide-forever');
    let hideWelcome = false;
    try {
      hideWelcome = localStorage.getItem('fac-ruler-hide-welcome') === 'true';
    } catch (_) {}
    if (hideWelcome && welcomeOverlay) {
      welcomeOverlay.classList.add('hidden');
    }
    welcomeDismiss?.addEventListener('click', () => {
      welcomeOverlay?.classList.add('hidden');
    });
    welcomeHideForever?.addEventListener('click', () => {
      try {
        localStorage.setItem('fac-ruler-hide-welcome', 'true');
      } catch (_) {}
      welcomeOverlay?.classList.add('hidden');
    });
    for (const qe of Array.from(document.querySelectorAll<HTMLButtonElement>('.ruler-quick-edge'))) {
      qe.addEventListener('click', () => {
        const edge = qe.dataset.edge || 'left';
        edges = new Set([edge]);
        syncEdgeButtons();
        saveState();
        renderAll();
      });
    }

    // 4-Way Unit Converter inputs
    convCm?.addEventListener('input', () => syncConverter('cm', parseFloat(convCm.value || '0')));
    convMm?.addEventListener('input', () => syncConverter('mm', parseFloat(convMm.value || '0')));
    convIn?.addEventListener('input', () => syncConverter('in', parseFloat(convIn.value || '0')));
    convPx?.addEventListener('input', () => syncConverter('px', parseFloat(convPx.value || '0')));

    for (const qBtn of Array.from(document.querySelectorAll<HTMLButtonElement>('.ruler-quick-conv'))) {
      qBtn.addEventListener('click', () => {
        const cm = parseFloat(qBtn.dataset.valCm || '0');
        if (convCm) convCm.value = cm.toString();
        syncConverter('cm', cm);
      });
    }

    // Device Hardware Catalog Table presets
    for (const pBtn of Array.from(document.querySelectorAll<HTMLButtonElement>('.ruler-table-preset-btn'))) {
      pBtn.addEventListener('click', () => {
        const ppi = parseFloat(pBtn.dataset.ppi || '0');
        const name = pBtn.dataset.name || 'Device';
        if (ppi >= 40 && ppi <= 1200) {
          applyCalibration({
            method: 'device',
            source: 'device',
            ppi,
            note: `Calibrated with ${name} hardware preset (${ppi} PPI).`,
          });
          syncConverterFromActive();
          root.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }

    $('ruler-guides-btn')?.addEventListener('click', () => setGuides(!guidesOn));
    $('ruler-crosshair-btn')?.addEventListener('click', () => setCrosshair(!crosshairOn));
    $('ruler-clear-guides')?.addEventListener('click', clearGuides);
    const helpBtn = $('ruler-help-btn');
    helpBtn?.addEventListener('click', () => {
      const panel = $('ruler-shortcuts');
      if (!panel) return;
      const open = panel.classList.toggle('hidden') === false;
      helpBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    const moreBtn = $('ruler-more-btn');
    moreBtn?.addEventListener('click', () => {
      const panel = $('ruler-advanced');
      if (!panel || !moreBtn) return;
      panel.classList.toggle('hidden');
      const open = !panel.classList.contains('hidden');
      panel.classList.toggle('flex', open);
      moreBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    const measureBtn = $('ruler-measure-btn');
    measureBtn?.addEventListener('click', () => setMeasure(!measuring));
    $('ruler-measure-exit')?.addEventListener('click', () => setMeasure(false));
    $('ruler-measure-clear')?.addEventListener('click', clearMeasureOverlay);
    fsBtn.addEventListener('click', toggleFullscreen);

    const calBtn = $('ruler-cal-btn');
    calBtn?.addEventListener('click', openCalDialog);
    $('ruler-cal-close')?.addEventListener('click', closeCalDialog);
    calDialog.querySelector('[data-cal-backdrop]')?.addEventListener('click', closeCalDialog);
    calHelpBtn.addEventListener('click', () => {
      const open = calExplain.classList.toggle('hidden') === false;
      calHelpBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    for (const tab of Array.from(document.querySelectorAll<HTMLButtonElement>('.ruler-cal-tab'))) {
      tab.addEventListener('click', () => setCalMethod((tab.dataset.method || 'card') as CalibrationMethod));
    }
    cardSlider.addEventListener('input', syncCardRect);
    for (const radio of Array.from(document.querySelectorAll<HTMLInputElement>('input[name="ruler-ref"]'))) {
      radio.addEventListener('change', applyReferenceSelection);
    }
    $('ruler-save-card')?.addEventListener('click', saveCard);
    $('ruler-save-diagonal')?.addEventListener('click', saveDiagonal);
    $('ruler-save-device')?.addEventListener('click', saveDevice);
    $('ruler-save-auto')?.addEventListener('click', saveAuto);
    $('ruler-history-clear')?.addEventListener('click', clearHistory);
    for (const id of ['ruler-diag-input', 'ruler-diag-w', 'ruler-diag-h']) {
      $(id)?.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter') saveDiagonal();
      });
    }

    stage.addEventListener('pointermove', onStagePointerMove);
    stage.addEventListener('pointerdown', onStagePointerDown);
    stage.addEventListener('pointerup', onStagePointerUp);
    stage.addEventListener('pointerleave', onStagePointerLeave);

    calDialog.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'Tab') return;
      const focusables = Array.from(
        calDialog.querySelectorAll<HTMLElement>('button, input, select, [tabindex]:not([tabindex="-1"])')
      ).filter((el) => !el.hasAttribute('disabled'));
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // ------------------------------------------------------- keyboard map
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      const dialogOpen = !calDialog.classList.contains('hidden');
      if (e.key === 'Escape') {
        if (dialogOpen) {
          e.preventDefault();
          closeCalDialog();
          return;
        }
        if (isFullscreen()) return;
        if (root.classList.contains('ruler-immersive')) {
          setImmersive(false);
          return;
        }
        if (measuring) {
          setMeasure(false);
          return;
        }
        if (guidesLayer.children.length > 0) {
          clearGuides();
          return;
        }
        return;
      }

      if (dialogOpen) return;
      const target = e.target as HTMLElement | null;
      const tag = target?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea' || tag === 'select' || target?.isContentEditable) return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;

      switch (e.key) {
        case '1':
          setUnit('cm');
          break;
        case '2':
          setUnit('in');
          break;
        case '3':
          setUnit('mm');
          break;
        case '4':
          setUnit('px');
          break;
        case 'g':
        case 'G':
          setGuides(!guidesOn);
          break;
        case 'c':
        case 'C':
          setCrosshair(!crosshairOn);
          break;
        case 'f':
        case 'F':
          toggleFullscreen();
          break;
        case 'm':
        case 'M':
          setMeasure(!measuring);
          break;
      }
    });

    // --------------------------------------------- resize / theme / zoom
    const ro = new ResizeObserver(() => {
      invalidateStageRect();
      renderAll();
      queueZoomCheck();
    });
    ro.observe(stage);
    window.addEventListener('orientationchange', () => {
      invalidateStageRect();
      setTimeout(renderAll, 120);
    });
    window.addEventListener('resize', () => {
      invalidateStageRect();
      queueZoomCheck();
    }, { passive: true });
    window.addEventListener('scroll', invalidateStageRect, { passive: true });
    window.visualViewport?.addEventListener('resize', () => {
      invalidateStageRect();
      queueZoomCheck();
    });
    document.addEventListener('themechange', () => requestAnimationFrame(renderAll));

    // ------------------------------------------------------------ boot
    syncEdgeButtons();
    syncFlipSideButton();
    setUnit(unit);
    setGuides(guidesOn);
    setCrosshair(crosshairOn);
    setMeasure(false);
    updateStatus();
    applyReferenceSelection();
    setCalMethod('card');
    updateZoomWarning();
    renderHistory();
    syncConverterFromActive();
    renderAll();

    if (lastCalError) {
      statusLabel.textContent = 'Calibration error — using estimate';
    }
  }
</script>
---
// src/pages/ruler/index.astro
// Flagship Online Ruler — full-screen, tool-first measuring app.
// Canonical URL /ruler/. Guides live at /ruler/guides/.
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';

const relatedCalculators = [
  { title: 'Online Ruler Guides', href: '/ruler/guides/' },
  { title: 'Length Converter', href: '/length-converter/' },
  { title: 'Unit Conversion Calculator', href: '/conversion-calculator/' },
  { title: 'Percentage Calculator', href: '/percentage-calculator/' },
];

// Clean inline SVG glyphs for the calibration reference cards.
const referenceIcons: Record<string, string> = {
  'bank-card':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" /><path d="M6 15h4" /></svg>',
  'id-card':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" /><circle cx="8.5" cy="11" r="2" /><path d="M5 16c.8-1.3 2-2 3.5-2s2.7.7 3.5 2" /><path d="M15 10h4" /><path d="M15 14h4" /></svg>',
  'a4-paper':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" /><path d="M14 3v5h5" /><path d="M9 13h6" /><path d="M9 17h6" /></svg>',
  'us-letter':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="1.5" /><path d="M8 8h8" /><path d="M8 12h8" /><path d="M8 16h5" /></svg>',
  'coin-quarter':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /></svg>',
  'coin-euro':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M15 9.5a4 4 0 1 0 0 5" /><path d="M7.5 11h6" /><path d="M7.5 13h6" /></svg>',
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://freeaccuratecalculator.com/ruler/#webapp',
      'url': 'https://freeaccuratecalculator.com/ruler/',
      'name': 'Online Ruler — Free Accurate Ruler in cm, mm & Inches',
      'applicationCategory': 'UtilitiesApplication',
      'operatingSystem': 'All',
      'browserRequirements': 'Requires JavaScript. Requires HTML5.',
      'description':
        'Free online ruler with screen calibration. Measure real objects on screen in centimeters, millimeters and inches using auto, device, diagonal or bank-card calibration. Works on phone, tablet and desktop.',
      'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' },
      'featureList': [
        'cm, mm, inches and pixels scales',
        'Auto estimate calibration',
        'Device preset calibration',
        'Screen diagonal calibration',
        'Bank card / ID card / paper physical calibration',
        'Top, bottom, left and right edge rulers',
        'Draggable measurement guides with live position readout',
        'Crosshair with coordinate readout',
        'Direct on-screen measurement mode',
        'Fullscreen measuring mode',
        'Dark mode support',
        'Keyboard shortcuts',
        'Local calibration persistence',
        '100% client-side privacy',
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://freeaccuratecalculator.com/ruler/#breadcrumb',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://freeaccuratecalculator.com/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'Everyday', 'item': 'https://freeaccuratecalculator.com/everyday/' },
        { '@type': 'ListItem', 'position': 3, 'name': 'Online Ruler', 'item': 'https://freeaccuratecalculator.com/ruler/' },
      ],
    },
  ],
};
---

<CalculatorLayout
  title="Online Ruler — Free Accurate Ruler in cm, mm & Inches"
  metaDescription="Free online ruler with screen calibration. Measure real objects on screen in cm, mm and inches — auto, device, diagonal or bank-card calibration on phone, tablet and desktop."
  h1="Free Online Ruler — Measure in cm, mm & Inches"
  subtitle="A calibrated full-screen ruler for real-world measuring: cm, mm, inches and pixels, with bank-card calibration, draggable guides, crosshair and a direct measure mode."
  category={{ label: 'Everyday', href: '/everyday/' }}
  calculatorName="Online Ruler"
  relatedCalculators={relatedCalculators}
  jsonLd={schema}
  appFullscreen
  disableEmailModal
>
  <!-- ============================== TOOL ============================== -->
  <div id="ruler-app" class="ruler-app-shell calculator-main-box relative rounded-[20px] border border-hairline bg-canvas-elevated p-2.5 sm:p-4 shadow-whisper overflow-hidden transition-all print:hidden" data-js="ruler-root">
    <div class="pointer-events-none absolute -top-32 -right-32 w-80 h-80 rounded-full bg-link/10 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-32 w-80 h-80 rounded-full bg-violet/10 blur-3xl" aria-hidden="true"></div>

    <!-- Premium toolbar -->
    <div class="ruler-toolbar relative z-10 rounded-2xl border border-hairline bg-canvas/80 backdrop-blur-xl shadow-whisper">
      <!-- Status strip -->
      <div class="flex flex-wrap items-center gap-2 justify-between px-2.5 sm:px-3 pt-2.5 pb-2 border-b border-hairline-soft">
        <div class="flex items-center gap-2 min-w-0">
          <span id="ruler-status-dot" class="w-2.5 h-2.5 rounded-full bg-warning shrink-0" aria-hidden="true"></span>
          <span id="ruler-calibration-label" class="text-xs font-mono font-semibold text-ink truncate">Ready to calibrate</span>
          <button type="button" id="ruler-cal-help" class="text-[11px] font-mono text-link hover:underline cursor-pointer shrink-0" aria-expanded="false" aria-controls="ruler-cal-explain">why?</button>
        </div>
        <p id="ruler-zoom-warning" class="hidden text-[11px] font-mono text-warning-deep dark:text-warning bg-warning-soft/60 border border-warning/30 rounded-md px-2 py-1" role="alert">
          Browser zoom is not 100% — press Ctrl/Cmd + 0 before measuring.
        </p>
        <a href="/ruler/guides/" class="inline-flex items-center gap-1 text-[11px] font-mono font-semibold text-link hover:underline shrink-0">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          Read the guide
        </a>
      </div>
      <p id="ruler-cal-explain" class="hidden mx-2.5 sm:mx-3 mt-2 rounded-lg border border-hairline bg-canvas p-3 text-[11px] sm:text-xs text-body leading-relaxed">
        Calibration explanation placeholder (filled by script).
      </p>

      <!-- Toolbar body -->
      <div class="p-2.5 sm:p-3 space-y-2.5" role="toolbar" aria-label="Ruler controls">
        <!-- Row 1 -->
        <div class="flex flex-wrap items-center gap-2 justify-between">
          <div class="inline-flex p-1 rounded-xl bg-canvas border border-hairline" role="group" aria-label="Measurement unit">
            <button type="button" class="ruler-unit-btn px-3 sm:px-4 py-2 min-h-[44px] rounded-lg text-xs font-semibold font-mono transition-all cursor-pointer" data-unit="cm" aria-pressed="true">CM</button>
            <button type="button" class="ruler-unit-btn px-3 sm:px-4 py-2 min-h-[44px] rounded-lg text-xs font-semibold font-mono transition-all cursor-pointer" data-unit="mm" aria-pressed="false">MM</button>
            <button type="button" class="ruler-unit-btn px-3 sm:px-4 py-2 min-h-[44px] rounded-lg text-xs font-semibold font-mono transition-all cursor-pointer" data-unit="in" aria-pressed="false">IN</button>
            <button type="button" class="ruler-unit-btn px-3 sm:px-4 py-2 min-h-[44px] rounded-lg text-xs font-semibold font-mono transition-all cursor-pointer" data-unit="px" aria-pressed="false">PX</button>
          </div>

          <div class="flex items-center gap-2">
            <button type="button" id="ruler-cal-btn" class="inline-flex items-center gap-1.5 px-3 py-2 min-h-[44px] rounded-xl border border-hairline bg-canvas-elevated text-xs font-semibold text-ink hover:border-link/50 hover:text-link transition-all cursor-pointer">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              Calibrate
            </button>
            <button type="button" id="ruler-measure-btn" class="inline-flex items-center gap-1.5 px-3 py-2 min-h-[44px] rounded-xl border border-hairline bg-canvas-elevated text-xs font-semibold text-ink hover:border-violet/50 hover:text-violet transition-all cursor-pointer" aria-pressed="false">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l2.879-2.879m0 0l2.122-2.121a2.121 2.121 0 013 3l-2.121 2.121m0 0L19 19m-4.95-4.95L5 5m2.879 9.121L5 17m4.95-4.95a2.121 2.121 0 013 3" /></svg>
              Measure
            </button>
            <button type="button" id="ruler-fullscreen-btn" class="inline-flex items-center gap-1.5 px-3 py-2 min-h-[44px] rounded-xl border border-hairline bg-canvas-elevated text-xs font-semibold text-ink hover:border-cyan/50 hover:text-cyan transition-all cursor-pointer">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
              <span id="ruler-fs-label">Fullscreen</span>
            </button>
            <ThemeToggle id="ruler-theme-toggle" className="!min-h-[44px]" />
          </div>
        </div>

        <!-- Row 2 -->
        <div id="ruler-secondary" class="flex flex-wrap items-center gap-2">
          <div class="inline-flex p-1 rounded-xl bg-canvas border border-hairline w-full sm:w-auto" role="group" aria-label="Ruler edges">
            <button type="button" class="ruler-edge-btn flex-1 sm:flex-none px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="top" aria-pressed="true">Top</button>
            <button type="button" class="ruler-edge-btn flex-1 sm:flex-none px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="bottom" aria-pressed="false">Bottom</button>
            <button type="button" class="ruler-edge-btn flex-1 sm:flex-none px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="left" aria-pressed="true">Left</button>
            <button type="button" class="ruler-edge-btn flex-1 sm:flex-none px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="right" aria-pressed="false">Right</button>
          </div>
          <button type="button" id="ruler-guides-btn" class="flex-1 sm:flex-none px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-ink hover:border-link/50 transition-all cursor-pointer" aria-pressed="false">Guides: off</button>
          <button type="button" id="ruler-crosshair-btn" class="flex-1 sm:flex-none px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-ink hover:border-link/50 transition-all cursor-pointer" aria-pressed="false">Crosshair: off</button>
          <button type="button" id="ruler-more-btn" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas text-mute hover:text-ink transition-all cursor-pointer" aria-expanded="false" aria-controls="ruler-advanced">
            More
          </button>
        </div>
        <div id="ruler-advanced" class="hidden flex-wrap items-center gap-2">
          <button type="button" id="ruler-clear-guides" class="flex-1 sm:flex-none px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-mute hover:text-error transition-all cursor-pointer">Clear guides</button>
          <button type="button" id="ruler-help-btn" class="flex-1 sm:flex-none px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-mute hover:text-ink transition-all cursor-pointer" aria-expanded="false" aria-controls="ruler-shortcuts">Keyboard shortcuts</button>
        </div>
        <div id="ruler-shortcuts" class="hidden rounded-lg border border-hairline bg-canvas p-3 text-[11px] font-mono text-body grid grid-cols-2 sm:grid-cols-3 gap-1.5">
          <span><kbd class="ruler-kbd">1</kbd> cm</span><span><kbd class="ruler-kbd">2</kbd> inches</span><span><kbd class="ruler-kbd">3</kbd> mm</span>
          <span><kbd class="ruler-kbd">4</kbd> px</span><span><kbd class="ruler-kbd">G</kbd> guides</span><span><kbd class="ruler-kbd">C</kbd> crosshair</span>
          <span><kbd class="ruler-kbd">F</kbd> fullscreen</span><span><kbd class="ruler-kbd">M</kbd> measure</span><span><kbd class="ruler-kbd">Esc</kbd> close / clear</span>
        </div>
      </div>
    </div>

    <!-- Measure mode bar -->
    <div id="ruler-measure-bar" class="relative z-10 hidden flex-wrap items-center justify-between gap-2 rounded-xl border border-violet/40 bg-violet-soft/50 px-3 py-2">
      <span class="text-[11px] font-mono font-semibold text-ink">Measure mode — tap or drag across the ruler to measure</span>
      <div class="flex items-center gap-2">
        <button type="button" id="ruler-measure-clear" class="px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-mute hover:text-error transition-all cursor-pointer">Clear</button>
        <button type="button" id="ruler-measure-exit" class="px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold border border-violet/50 bg-canvas-elevated text-ink transition-all cursor-pointer">Exit Measure</button>
      </div>
    </div>

    <!-- Measuring stage -->
    <div id="ruler-stage" class="ruler-stage relative z-10 mt-2.5 rounded-xl border border-hairline bg-canvas overflow-hidden select-none" style="min-height: 300px;">
      <canvas id="ruler-canvas-top" class="ruler-canvas absolute top-0 left-0 w-full" height="40" aria-hidden="true"></canvas>
      <canvas id="ruler-canvas-bottom" class="ruler-canvas absolute bottom-0 left-0 w-full hidden" height="40" aria-hidden="true"></canvas>
      <canvas id="ruler-canvas-left" class="ruler-canvas absolute top-0 left-0 h-full hidden" width="40" aria-hidden="true"></canvas>
      <canvas id="ruler-canvas-right" class="ruler-canvas absolute top-0 right-0 h-full hidden" width="40" aria-hidden="true"></canvas>

      <div id="ruler-overlays" class="absolute inset-0 z-20" aria-hidden="true">
        <div id="ruler-guides-layer" class="absolute inset-0"></div>
        <div id="ruler-measure-layer" class="absolute inset-0 hidden"></div>
        <div id="ruler-crosshair-x" class="absolute hidden w-full border-t border-dashed border-violet/70 pointer-events-none" style="top:0"></div>
        <div id="ruler-crosshair-y" class="absolute hidden h-full border-l border-dashed border-violet/70 pointer-events-none" style="left:0"></div>
      </div>

      <div id="ruler-readout" class="absolute z-30 hidden pointer-events-none rounded-lg border border-hairline bg-canvas-elevated/95 shadow-whisper px-2.5 py-1.5 text-[11px] sm:text-xs font-mono text-ink" style="top: 40px; left: 40px;">
        <span id="ruler-readout-main" class="font-bold">—</span>
        <span id="ruler-readout-sub" class="text-mute block"></span>
      </div>

      <div id="ruler-hint" class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none">
        <p class="text-center text-[11px] sm:text-xs text-mute font-mono px-6 max-w-md leading-relaxed">
          Place a flat object against the <span class="text-ink font-semibold">top</span> or <span class="text-ink font-semibold">left</span> edge to read its size.
          <span class="block mt-1">Turn on Measure to drag a distance anywhere on the stage.</span>
        </p>
      </div>
    </div>

    <!-- Live result strip -->
    <div class="relative z-10 mt-2.5 rounded-xl border border-hairline bg-canvas p-3 sm:p-4 flex flex-wrap items-center gap-x-5 gap-y-2">
      <div class="min-w-0">
        <span class="block text-[10px] font-mono text-mute uppercase tracking-wider">Active unit</span>
        <span id="ruler-result-unit" class="text-xs font-mono font-bold text-ink">cm</span>
      </div>
      <div class="min-w-0">
        <span class="block text-[10px] font-mono text-mute uppercase tracking-wider">Scale</span>
        <span id="ruler-result-ppi" class="text-xs font-mono font-bold text-ink">96 px/in</span>
      </div>
      <div class="min-w-0" aria-live="polite">
        <span class="block text-[10px] font-mono text-mute uppercase tracking-wider">Latest measurement</span>
        <span id="ruler-result-last" class="text-xs font-mono font-bold text-ink">—</span>
      </div>
      <div class="sm:ml-auto text-[10px] text-mute font-mono">100% private — nothing leaves your browser.</div>
    </div>

    <!-- Measurement history -->
    <div id="ruler-history-panel" class="relative z-10 mt-2.5 hidden rounded-xl border border-hairline bg-canvas p-3 sm:p-4 space-y-3">
      <div class="flex items-center justify-between gap-2">
        <h2 class="text-[11px] font-mono font-bold text-ink uppercase tracking-wider">Measurement History</h2>
        <button type="button" id="ruler-history-clear" class="px-2.5 py-1.5 min-h-[36px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-mute hover:text-error transition-all cursor-pointer">Clear All</button>
      </div>
      <ul id="ruler-history-list" class="space-y-2"></ul>
    </div>
  </div>

  <!-- ====================== CALIBRATION DIALOG ====================== -->
  <div id="ruler-cal-dialog" class="fixed inset-0 z-[80] hidden" role="dialog" aria-modal="true" aria-labelledby="ruler-cal-title">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-[2px]" data-cal-backdrop></div>
    <div class="ruler-cal-sheet relative z-10 mx-auto my-4 sm:my-10 w-[min(680px,calc(100vw-1.5rem))] max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-2xl border border-hairline bg-canvas-elevated shadow-2xl">
      <div class="sticky top-0 bg-canvas-elevated border-b border-hairline px-4 sm:px-6 py-3.5 flex items-center justify-between z-10">
        <h2 id="ruler-cal-title" class="heading-md text-ink">Calibrate the ruler</h2>
        <button type="button" id="ruler-cal-close" class="p-2 rounded-lg text-mute hover:text-ink hover:bg-canvas cursor-pointer" aria-label="Close calibration dialog">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <div class="px-4 sm:px-6 py-4 space-y-4">
        <p class="text-xs sm:text-sm text-body leading-relaxed">
          Browsers cannot read your screen’s physical size, so the ruler starts from an estimate. Pick a method below — physical reference methods give the most trustworthy scale.
        </p>

        <div class="flex flex-wrap gap-1.5" role="tablist" aria-label="Calibration method">
          <button type="button" class="ruler-cal-tab px-3 py-2 min-h-[40px] rounded-lg text-xs font-semibold font-mono border border-hairline bg-canvas text-mute cursor-pointer" data-method="card" role="tab" aria-selected="true">Card / object</button>
          <button type="button" class="ruler-cal-tab px-3 py-2 min-h-[40px] rounded-lg text-xs font-semibold font-mono border border-hairline bg-canvas text-mute cursor-pointer" data-method="diagonal" role="tab" aria-selected="false">Screen diagonal</button>
          <button type="button" class="ruler-cal-tab px-3 py-2 min-h-[40px] rounded-lg text-xs font-semibold font-mono border border-hairline bg-canvas text-mute cursor-pointer" data-method="device" role="tab" aria-selected="false">Device preset</button>
          <button type="button" class="ruler-cal-tab px-3 py-2 min-h-[40px] rounded-lg text-xs font-semibold font-mono border border-hairline bg-canvas text-mute cursor-pointer" data-method="auto" role="tab" aria-selected="false">Auto estimate</button>
        </div>

        <!-- CARD METHOD -->
        <div class="ruler-cal-panel space-y-3" data-panel="card">
          <ol class="text-xs text-body space-y-1 list-decimal list-inside font-mono">
            <li>Hold any standard bank card against the outline below.</li>
            <li>Drag the slider (or use <kbd class="ruler-kbd">←</kbd> <kbd class="ruler-kbd">→</kbd> arrow keys for pixel-perfect precision) until the outline matches the card exactly.</li>
            <li>Save — the ruler is now calibrated to your display.</li>
          </ol>
          <div class="rounded-xl border border-hairline bg-canvas p-4 flex flex-col items-center gap-3">

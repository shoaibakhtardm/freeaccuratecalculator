---
// src/pages/finance/emi-calculator.astro
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import ResultDisplay from '../components/calculator/ResultDisplay.astro';
import FormulaSection from '../components/calculator/FormulaSection.astro';
import WorkedExample from '../components/calculator/WorkedExample.astro';
import FAQSection from '../components/calculator/FAQSection.astro';
import HistoryDrawer from '../components/calculator/HistoryDrawer.astro';
import SocialProof from '../components/SocialProof.astro';
import CalculatorComparison from '../components/CalculatorComparison.astro';

import { faqDatabase } from '../data/faqDatabase';

const faqs = faqDatabase['emi-calculator'] || [
  {
    question: 'What is an EMI and how is it calculated?',
    answer:
      'EMI stands for Equated Monthly Installment. It is a fixed payment amount made by a borrower to a lender at a specified date each calendar month. EMIs are calculated using the reducing balance method: E = P × r × (1 + r)ⁿ / ((1 + r)ⁿ - 1), where P is principal, r is the monthly interest rate, and n is the tenure in months.',
  },
  {
    question: 'How does an Extra Monthly Payment reduce loan tenure and interest?',
    answer:
      'Any extra monthly payment goes 100% toward principal repayment rather than interest. This accelerates the reduction of your outstanding loan balance, drastically lowering subsequent monthly interest charges, saving thousands in cumulative interest and cutting years off your total loan schedule.',
  },
  {
    question: 'How does the reducing balance method differ from a flat interest rate?',
    answer:
      'In a reducing balance loan, interest is calculated each month solely on the outstanding principal. As you pay off principal each month, the interest portion of your EMI decreases while the principal portion increases. A flat rate loan calculates interest on the entire original principal for the full duration, resulting in a significantly higher effective APR.',
  },
  {
    question: 'What is the Indian Lakh/Crore numbering system?',
    answer:
      'In India, South Asia, and regional banking, large currency figures are grouped in Lakhs and Crores rather than millions and billions. 1 Lakh equals 100,000 (written as 1,00,000) and 1 Crore equals 100 Lakhs or 10,000,000 (written as 1,00,00,000). Our calculator dynamically supports both formats.',
  },
  {
    question: 'How does real-time double verification work?',
    answer:
      'Our engine cross-checks the closed-form algebraic formula against an independent iterative month-by-month compounding simulation loop. Both results must converge within 0.01 currency units, guaranteeing absolute mathematical precision without approximation drift.',
  },
];

const relatedCalculators = [
  { title: 'Step-Up SIP Calculator', href: '/sip-calculator/', badge: 'Popular' },
  { title: 'Compound Interest', href: '/compound-interest-calculator/' },
  { title: 'Mortgage Calculator', href: '/mortgage-calculator/' },
  { title: 'Auto Loan Calculator', href: '/auto-loan-calculator/' },
  { title: 'Amortization Calculator', href: '/amortization-calculator/' },
];

const formulaVariables = [
  { symbol: 'E', meaning: 'Equated Monthly Installment (periodic payment obligation)' },
  { symbol: 'P', meaning: 'Principal borrowed loan amount' },
  { symbol: 'r', meaning: 'Monthly periodic interest rate (Annual Rate ÷ 12 ÷ 100)' },
  { symbol: 'n', meaning: 'Total number of monthly installments (Years × 12)' },
  { symbol: '(1 + r)ⁿ', meaning: 'Compounding factor compounding monthly interest over remaining debt' },
];
---

<CalculatorLayout
  title="EMI Calculator — Equated Monthly Installment with Prepayment & Lakh/Crore Support"
  metaDescription="Calculate your exact loan EMI, extra payment savings, and multi-tab amortization schedule. Features real-time what-if reactivity, step-by-step mathematical proof, and Indian Lakh/Crore formatting."
  h1="EMI Calculator"
  subtitle="Calculate equated monthly installments for home loans, personal loans, and car financing with instant reducing balance math and prepayment analysis."
  category={{ label: 'Finance', href: '/finance/' }}
  calculatorName="EMI Calculator"
  relatedCalculators={relatedCalculators}
>
  <!-- Real-time Social Proof Widget -->
  <div id="emi-social-proof" class="print:hidden">
    <SocialProof calculatorName="EMI Calculator" />
  </div>

  <!-- Calculator Main Box (SIP Gold Standard) -->
  <div id="emi-calculator-card" class="calculator-main-box emi-main-box relative rounded-[20px] border border-hairline bg-canvas-elevated p-4 sm:p-8 shadow-whisper space-y-6 overflow-hidden transition-all pb-24 sm:pb-8">

    <!-- Subtle Ambient Gradient Glow -->
    <div class="pointer-events-none absolute -top-32 -right-32 w-80 h-80 rounded-full bg-link/10 blur-3xl print:hidden"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-32 w-80 h-80 rounded-full bg-cyan/10 blur-3xl print:hidden"></div>

    <!-- Dedicated High-Fidelity Print/PDF Report (Visible ONLY in print) -->
    <div id="emi-print-report" class="hidden print:block font-mono text-slate-900">
      <!-- Official Header Letterhead -->
      <div class="border-b-2 border-slate-900 pb-4 mb-5 flex justify-between items-start">
        <div>
          <div class="text-2xl font-black uppercase tracking-tight">Free Accurate Calculator</div>
          <div class="text-sm font-bold text-blue-700 mt-0.5">Loan EMI & Amortization Statement</div>
          <div class="text-xs text-slate-500 mt-1">freeaccuratecalculator.com • Verified Financial Computation Statement</div>
        </div>
        <div class="text-right text-xs text-slate-600 space-y-0.5">
          <div><span class="text-slate-400 uppercase">Generated:</span> <strong id="emi-print-date" class="text-slate-900"></strong></div>
          <div><span class="text-slate-400 uppercase">Currency:</span> <strong id="emi-print-currency" class="text-slate-900"></strong></div>
          <div><span class="text-slate-400 uppercase">Method:</span> <strong class="text-slate-900">Reducing Balance</strong></div>
        </div>
      </div>

      <!-- Calculation Inputs Summary -->
      <div class="bg-slate-50 border border-slate-200 rounded-lg p-3.5 mb-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Loan Parameters</div>
        <div class="grid grid-cols-3 gap-4 text-xs">
          <div><span class="text-slate-500 block text-[10px] uppercase">Principal Amount</span><span id="emi-print-principal" class="text-sm font-bold text-slate-900"></span></div>
          <div><span class="text-slate-500 block text-[10px] uppercase">Annual Interest Rate</span><span id="emi-print-rate" class="text-sm font-bold text-slate-900"></span></div>
          <div><span class="text-slate-500 block text-[10px] uppercase">Tenure</span><span id="emi-print-tenure" class="text-sm font-bold text-slate-900"></span></div>
        </div>
      </div>

      <!-- Key Metrics -->
      <div class="grid grid-cols-3 gap-3 mb-6">
        <div class="border border-slate-300 rounded-lg p-3.5 bg-white">
          <span class="text-[10px] font-bold uppercase text-slate-500 block">Monthly EMI</span>
          <div id="emi-print-emi" class="text-lg font-black text-blue-700 mt-1"></div>
          <span class="text-[10px] text-slate-500">Monthly Installment</span>
        </div>
        <div class="border border-slate-300 rounded-lg p-3.5 bg-white">
          <span class="text-[10px] font-bold uppercase text-slate-500 block">Total Interest</span>
          <div id="emi-print-interest" class="text-lg font-black text-violet-700 mt-1"></div>
          <span class="text-[10px] text-slate-500">Total Borrowing Cost</span>
        </div>
        <div class="border-2 border-slate-900 rounded-lg p-3.5 bg-slate-50">
          <span class="text-[10px] font-bold uppercase text-slate-900 block">Total Repayment</span>
          <div id="emi-print-total" class="text-lg font-black text-slate-900 mt-1"></div>
          <span class="text-[10px] text-slate-500">Principal + Total Interest</span>
        </div>
      </div>

      <!-- Schedule Table -->
      <div class="space-y-2">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Annual Amortization Schedule</div>
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b-2 border-slate-300 bg-slate-100 text-slate-700">
              <th class="py-2 px-2.5">Period</th>
              <th class="py-2 px-2.5 text-right">Principal Paid</th>
              <th class="py-2 px-2.5 text-right">Interest Paid</th>
              <th class="py-2 px-2.5 text-right">Total Payment</th>
              <th class="py-2 px-2.5 text-right">Ending Balance</th>
            </tr>
          </thead>
          <tbody id="emi-print-schedule-body" class="divide-y divide-slate-200"></tbody>
        </table>
      </div>

      <!-- Footer -->
      <div class="mt-8 pt-3 border-t border-slate-200 flex justify-between items-center text-[10px] text-slate-500">
        <div>Generated by <strong>Free Accurate Calculator</strong> • https://freeaccuratecalculator.com</div>
        <div>Verified Pure Client-Side Computation • 100% Private</div>
      </div>
    </div>

    <!-- Screen UI (Hidden during print) -->

    <!-- Top Controls: Mode Switcher, Currency & Silent Indicator -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-4 print:hidden">
      <!-- Mode Switcher -->
      <div class="inline-flex p-1 rounded-xl bg-canvas border border-hairline">
        <button
          type="button"
          id="emi-mode-standard"
          class="mode-switch-btn relative px-4 py-2 rounded-lg text-xs font-semibold font-mono transition-all duration-200 cursor-pointer bg-canvas-elevated text-link shadow-xs border border-link/20"
          data-mode="standard"
        >
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            Standard Loan EMI
          </span>
        </button>
        <button
          type="button"
          id="emi-mode-prepayment"
          class="mode-switch-btn relative px-4 py-2 rounded-lg text-xs font-semibold font-mono transition-all duration-200 cursor-pointer text-mute hover:text-ink"
          data-mode="prepayment"
        >
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Prepayment Saver
          </span>
        </button>
      </div>

      <!-- Silent Trust Indicator & Numeral Format Toggle -->
      <div class="flex items-center gap-3">
        
        <div class="hidden sm:inline-flex rounded-[8px] border border-hairline bg-canvas p-0.5 text-xs font-mono">
          <button
            id="format-standard-btn"
            type="button"
            aria-label="Use Standard Million notation"
            aria-pressed="false"
            class="rounded px-2.5 py-1 min-h-[32px] sm:min-h-[26px] text-xs font-medium text-mute hover:text-ink cursor-pointer transition-colors"
          >
            Million
          </button>
          <button
            id="format-indian-btn"
            type="button"
            aria-label="Use Indian Lakh and Crore notation"
            aria-pressed="true"
            class="rounded bg-link/15 text-link font-bold px-2.5 py-1 min-h-[32px] sm:min-h-[26px] text-xs cursor-pointer transition-colors"
          >
            Lakh/Crore
          </button>
        </div>

        <div class="flex items-center gap-2 text-xs font-mono text-mute">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span id="emi-header-currency-label" class="font-semibold text-ink">INR (₹)</span>
          <span>•</span>
          <span>100% Private</span>
        </div>
      </div>
    </div>

    <!-- Inputs & Results Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 print:hidden">

      <!-- Left Column: Primary Loan Inputs -->
      <div class="space-y-5">
        <!-- 1. Principal Loan Amount -->
        <div class="space-y-2 p-4 rounded-xl border border-hairline bg-canvas/40">
          <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
            <label for="emi-principal">Loan Amount (Principal)</label>
            <span id="principal-display" class="font-mono text-link text-base tabular-nums font-bold">₹ 25,00,000</span>
          </div>

          <div class="relative flex items-center gap-2">
            <div class="relative flex-1">
              <span id="principal-symbol" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-mono text-mute select-none font-bold">₹</span>
              <input
                id="emi-principal"
                type="text"
                inputmode="text"
                value="2500000"
                placeholder="e.g. 2500000, 25L, 1.5Cr"
                class="w-full min-h-[46px] rounded-xl border border-hairline bg-canvas-elevated py-2.5 pl-8 pr-3 text-base font-mono text-ink focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 tabular-nums font-semibold transition-all shadow-2xs"
              />
            </div>

            <!-- Quick Steppers -->
            <div class="flex items-center gap-1">
              <button
                type="button"
                id="btn-principal-minus"
                class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl border border-hairline bg-canvas-elevated text-mute hover:text-ink hover:border-link/50 active:scale-95 transition-all text-sm font-mono font-bold cursor-pointer"
                title="Decrease 1 Lakh"
              >−</button>
              <button
                type="button"
                id="btn-principal-plus"
                class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl border border-hairline bg-canvas-elevated text-mute hover:text-ink hover:border-link/50 active:scale-95 transition-all text-sm font-mono font-bold cursor-pointer"
                title="Increase 1 Lakh"
              >+</button>
            </div>
          </div>

          <!-- Dynamic Slider -->
          <div class="py-1">
            <input
              id="emi-principal-slider"
              type="range"
              min="100000"
              max="10000000"
              step="50000"
              value="2500000"
              aria-label="Loan principal amount slider"
              class="custom-range-slider w-full cursor-pointer h-2.5 rounded-lg appearance-none bg-hairline"
            />
          </div>

          <!-- Preset Chips -->
          <div class="flex items-center gap-1.5 overflow-x-auto pt-1 pb-0.5 text-xs font-medium no-scrollbar">
            <button type="button" class="preset-chip text-[10px] font-mono px-2 py-1 rounded border border-hairline bg-canvas-elevated hover:border-link/40 hover:text-link text-mute cursor-pointer transition-colors" data-amount="500000">5L</button>
            <button type="button" class="preset-chip text-[10px] font-mono px-2 py-1 rounded border border-hairline bg-canvas-elevated hover:border-link/40 hover:text-link text-mute cursor-pointer transition-colors" data-amount="1500000">15L</button>
            <button type="button" class="preset-chip text-[10px] font-mono px-2 py-1 rounded border border-link/40 bg-link/10 text-link font-bold cursor-pointer transition-colors" data-amount="2500000">25L</button>
            <button type="button" class="preset-chip text-[10px] font-mono px-2 py-1 rounded border border-hairline bg-canvas-elevated hover:border-link/40 hover:text-link text-mute cursor-pointer transition-colors" data-amount="5000000">50L</button>
            <button type="button" class="preset-chip text-[10px] font-mono px-2 py-1 rounded border border-hairline bg-canvas-elevated hover:border-link/40 hover:text-link text-mute cursor-pointer transition-colors" data-amount="10000000">1Cr</button>
          </div>
        </div>

        <!-- 2. Annual Interest Rate -->
        <div class="space-y-2 p-4 rounded-xl border border-hairline bg-canvas/40">
          <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
            <label for="emi-rate">Interest Rate (% P.A.)</label>
            <span id="rate-display" class="font-mono text-cyan text-base tabular-nums font-bold">8.50%</span>
          </div>

          <div class="relative flex items-center gap-2">
            <div class="relative flex-1">
              <input
                id="emi-rate"
                type="number"
                min="0.1"
                max="30"
                step="0.05"
                value="8.5"
                class="w-full min-h-[46px] rounded-xl border border-hairline bg-canvas-elevated py-2.5 pl-3 pr-8 text-base font-mono text-ink focus:border-cyan focus:outline-none focus:ring-2 focus:ring-cyan/20 tabular-nums font-semibold transition-all shadow-2xs"
              />
              <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-sm font-mono text-mute select-none font-bold">%</span>
            </div>

            <!-- Rate Steppers -->
            <div class="flex items-center gap-1">
              <button
                type="button"
                id="btn-rate-minus"
                class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl border border-hairline bg-canvas-elevated text-mute hover:text-ink hover:border-cyan/50 active:scale-95 transition-all text-sm font-mono font-bold cursor-pointer"
                title="Decrease 0.25%"
              >−</button>
              <button
                type="button"
                id="btn-rate-plus"
                class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl border border-hairline bg-canvas-elevated text-mute hover:text-ink hover:border-cyan/50 active:scale-95 transition-all text-sm font-mono font-bold cursor-pointer"
                title="Increase 0.25%"
              >+</button>
            </div>
          </div>

          <div class="py-1">
            <input
              id="emi-rate-slider"
              type="range"
              min="4"
              max="20"
              step="0.1"
              value="8.5"
              aria-label="Interest rate slider"
              class="custom-range-slider w-full cursor-pointer h-2.5 rounded-lg appearance-none bg-hairline"
            />
          </div>

          <!-- Quick Rate Chips -->
          <div class="flex items-center gap-1.5 pt-1 overflow-x-auto no-scrollbar">
            <button type="button" class="rate-chip text-[11px] font-mono px-2.5 py-1 rounded-lg border border-hairline bg-canvas-elevated hover:border-cyan/50 hover:text-cyan text-mute cursor-pointer transition-all shrink-0" data-rate="7">7% Home</button>
            <button type="button" class="rate-chip text-[11px] font-mono px-2.5 py-1 rounded-lg border border-cyan/40 bg-cyan/10 text-cyan font-bold cursor-pointer transition-all shrink-0" data-rate="8.5">8.5% Avg</button>
            <button type="button" class="rate-chip text-[11px] font-mono px-2.5 py-1 rounded-lg border border-hairline bg-canvas-elevated hover:border-cyan/50 hover:text-cyan text-mute cursor-pointer transition-all shrink-0" data-rate="10.5">10.5% Auto</button>
            <button type="button" class="rate-chip text-[11px] font-mono px-2.5 py-1 rounded-lg border border-hairline bg-canvas-elevated hover:border-cyan/50 hover:text-cyan text-mute cursor-pointer transition-all shrink-0" data-rate="12">12% Personal</button>
          </div>
        </div>

        <!-- 3. Loan Tenure & Unit Switcher -->
        <div class="space-y-2 p-4 rounded-xl border border-hairline bg-canvas/40">
          <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
            <label for="emi-tenure">Loan Tenure</label>
            <div class="flex items-center gap-2">
              <span id="tenure-display" class="font-mono text-violet text-sm tabular-nums font-bold">20 Years (240 Mo)</span>
              <div class="inline-flex rounded-lg border border-hairline bg-canvas p-0.5 text-xs">
                <button id="tenure-yr-btn" type="button" aria-label="Tenure in years" aria-pressed="true" class="rounded px-2.5 py-1 min-h-[44px] sm:min-h-[26px] font-medium bg-primary text-on-primary">Yr</button>
                <button id="tenure-mo-btn" type="button" aria-label="Tenure in months" aria-pressed="false" class="rounded px-2.5 py-1 min-h-[44px] sm:min-h-[26px] font-medium text-ink">Mo</button>
              </div>
            </div>
          </div>

          <div class="relative flex items-center">
            <input
              id="emi-tenure"
              type="number"
              min="1"
              max="360"
              value="20"
              class="w-full min-h-[46px] rounded-xl border border-hairline bg-canvas-elevated py-2.5 px-3 text-base font-mono text-ink focus:border-violet focus:outline-none focus:ring-2 focus:ring-violet/20 tabular-nums font-semibold transition-all shadow-2xs"
            />
          </div>

          <div class="py-1">
            <input
              id="emi-tenure-slider"
              type="range"
              min="1"
              max="30"
              step="1"
              value="20"
              aria-label="Loan tenure slider"
              class="custom-range-slider w-full cursor-pointer h-2.5 rounded-lg appearance-none bg-hairline"
            />
          </div>

          <!-- Quick Tenure Chips -->
          <div class="flex items-center gap-1 pt-1">
            <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-1 rounded border border-hairline bg-canvas-elevated hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="5">5Y</button>
            <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-1 rounded border border-hairline bg-canvas-elevated hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="10">10Y</button>
            <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-1 rounded border border-hairline bg-canvas-elevated hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="15">15Y</button>
            <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-1 rounded border border-violet/40 bg-violet/10 text-violet font-bold cursor-pointer transition-colors" data-years="20">20Y</button>
            <button type="button" class="tenure-chip text-[10px] font-mono px-2 py-1 rounded border border-hairline bg-canvas-elevated hover:border-violet/40 hover:text-violet text-mute cursor-pointer transition-colors" data-years="30">30Y</button>
          </div>
        </div>

        <!-- 4. Optional Prepayment Input -->
        <div id="prepayment-container" class="space-y-2 p-4 rounded-xl border border-hairline bg-canvas/40">
          <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
            <label for="emi-extra" class="flex items-center gap-1.5">
              <span>Extra Monthly Prepayment</span>
              <span class="rounded bg-cyan/15 px-1.5 py-0.5 text-[10px] font-medium text-cyan uppercase font-bold">Accelerator</span>
            </label>
            <span id="extra-display" class="font-mono text-cyan text-base tabular-nums font-bold">₹ 0</span>
          </div>

          <div class="relative flex items-center">
            <span id="extra-symbol" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-mono text-mute select-none font-bold">₹</span>
            <input
              id="emi-extra"
              type="text"
              inputmode="text"
              value="0"
              placeholder="e.g. 5000, 5k, 10k"
              class="w-full min-h-[46px] rounded-xl border border-hairline bg-canvas-elevated py-2.5 pl-8 pr-3 text-base font-mono text-ink focus:border-cyan focus:outline-none focus:ring-2 focus:ring-cyan/20 tabular-nums font-semibold transition-all shadow-2xs"
            />
          </div>

          <div class="py-1">
            <input
              id="emi-extra-slider"
              type="range"
              min="0"
              max="50000"
              step="500"
              value="0"
              aria-label="Extra monthly prepayment slider"
              class="custom-range-slider w-full cursor-pointer h-2.5 rounded-lg appearance-none bg-hairline"
            />
          </div>
        </div>
      </div>

      <!-- Right Column: SIP-Grade Hero Result Card & Animated Visualizer -->
      <div class="space-y-5">
        <!-- Hero Primary Result Card -->
        <div class="relative overflow-hidden rounded-2xl border-2 border-link/30 bg-gradient-to-br from-link/10 via-canvas-elevated to-cyan/10 p-5 sm:p-6 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div>

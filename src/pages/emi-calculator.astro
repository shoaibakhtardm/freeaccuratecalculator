              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download Excel (.csv)</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Formula Section -->
    <div id="emi-formula-wrapper">
      <FormulaSection
        title="Reducing Balance EMI Formula & Computational Proof"
        expression="E = P × r × (1 + r)ⁿ ÷ [(1 + r)ⁿ - 1]"
        explanation="Where P is the principal loan amount, r is the monthly periodic interest rate (Annual Rate ÷ 12 ÷ 100), and n is the total tenure in months. In reducing balance loans, interest is computed each month strictly on outstanding unpaid principal, meaning earlier installments consist predominantly of interest while later installments clear principal."
        variables={formulaVariables}
      />
    </div>

    <!-- Worked Example -->
    <div id="emi-worked-example-wrapper">
      <WorkedExample
        title="Worked Example: 25 Lakh Home Loan at 8.5% for 20 Years"
        scenario="A borrower takes an Indian home loan of ₹25,00,000 for 20 years (240 months) at an annual interest rate of 8.5%."
        steps={[
          {
            number: 1,
            title: 'Convert Annual Rate to Monthly Periodic Rate',
            description: 'Divide the 8.5% annual rate by 12 months and convert from percentage to decimal.',
            mathExpression: 'r = 8.5 ÷ 12 ÷ 100 = 0.0070833',
          },
          {
            number: 2,
            title: 'Evaluate Compounding Factor (1 + r)ⁿ',
            description: 'Raise the monthly rate factor to the 240th power.',
            mathExpression: '(1 + 0.0070833)²⁴⁰ = 5.4412',
          },
          {
            number: 3,
            title: 'Calculate Periodic EMI Amount',
            description: 'Substitute values into the reducing balance formula.',
            mathExpression: 'E = 25,00,000 × 0.0070833 × 5.4412 ÷ (5.4412 - 1) = ₹ 21,696',
          },
        ]}
        conclusion="Monthly EMI is exactly ₹21,696. Across 240 months, cumulative payments total ₹52,06,935, comprising ₹25,00,000 principal and ₹27,06,935 lifetime interest."
      />
    </div>

    <!-- FAQ Section -->
    <div id="emi-faq-wrapper">
      <FAQSection faqs={faqs} />
    </div>

    <!-- Calculator Comparison Matrix -->
    <CalculatorComparison
      currentCalculator="EMI Calculator"
      comparisonCalculators={[
        {
          name: 'Mortgage Calculator',
          slug: 'mortgage-calculator',
          category: 'finance',
          bestFor: 'Home purchases with property tax, insurance, and HOA dues factored in',
          keyDifference: 'Includes escrow and municipal fees alongside pure principal and interest',
        },
        {
          name: 'Auto Loan Calculator',
          slug: 'auto-loan-calculator',
          category: 'finance',
          bestFor: 'Car financing with trade-in allowance and vehicle sales tax',
          keyDifference: 'Features shorter tenures (3-7 years) and vehicle sales tax integration',
        },
        {
          name: 'Amortization Calculator',
          slug: 'amortization-calculator',
          category: 'finance',
          bestFor: 'In-depth multi-year debt payoff schedules and balloon payments',
          keyDifference: 'Focuses on granular period-by-period balance amortization tables',
        },
      ]}
    />
  </div>

  <HistoryDrawer />
</CalculatorLayout>

<!-- Client-side Calculation & State Engine -->
<script is:inline>
  (function () {
    // 1. Silent Currency Integration
    const activeCode = typeof window.facGetActiveCurrency === 'function'
      ? window.facGetActiveCurrency()
      : (localStorage.getItem('fac_currency') || 'INR');

    let currentCurrencySymbol = activeCode === 'INR' ? '₹' : '$';
    let isIndianFormat = activeCode === 'INR';

    // DOM References
    const principalInput = document.getElementById('emi-principal');
    const principalSlider = document.getElementById('emi-principal-slider');
    const rateInput = document.getElementById('emi-rate');
    const rateSlider = document.getElementById('emi-rate-slider');
    const tenureInput = document.getElementById('emi-tenure');
    const tenureSlider = document.getElementById('emi-tenure-slider');
    const extraInput = document.getElementById('emi-extra');
    const extraSlider = document.getElementById('emi-extra-slider');

    const tenureYrBtn = document.getElementById('tenure-yr-btn');
    const tenureMoBtn = document.getElementById('tenure-mo-btn');
    const formatStdBtn = document.getElementById('format-standard-btn');
    const formatIndBtn = document.getElementById('format-indian-btn');

    const emiMonthlyResult = document.getElementById('emi-monthly-result');
    const emiInterestResult = document.getElementById('emi-interest-result');
    const emiTotalResult = document.getElementById('emi-total-result');

    const toastEl = document.getElementById('emi-toast');
    const toastMsg = document.getElementById('emi-toast-message');

    let tenureIsYears = true;
    let scheduleTabMode = 'yearly';
    let currentMode = 'standard';
    let toastTimeout = null;

    function showToast(message) {
      if (!toastEl || !toastMsg) return;
      toastMsg.textContent = message;
      toastEl.classList.remove('opacity-0', 'translate-y-12', 'pointer-events-none');
      toastEl.classList.add('opacity-100', 'translate-y-0');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toastEl.classList.remove('opacity-100', 'translate-y-0');
        toastEl.classList.add('opacity-0', 'translate-y-12', 'pointer-events-none');
      }, 2500);
    }

    function parseSmartInput(val) {
      if (typeof val === 'number') return val;
      const str = String(val).trim().toLowerCase().replace(/,/g, '');
      if (str.endsWith('cr') || str.endsWith('crore') || str.endsWith('crores')) {
        return parseFloat(str) * 10000000;
      }
      if (str.endsWith('l') || str.endsWith('lakh') || str.endsWith('lakhs')) {
        return parseFloat(str) * 100000;
      }
      if (str.endsWith('k')) {
        return parseFloat(str) * 1000;
      }
      if (str.endsWith('m') || str.endsWith('million')) {
        return parseFloat(str) * 1000000;
      }
      return parseFloat(str) || 0;
    }

    function formatNumber(val, decimals = 0) {
      if (isNaN(val) || !isFinite(val)) return '0';
      if (isIndianFormat) {
        const parts = Math.round(val).toString().split('.');
        let lastThree = parts[0].substring(parts[0].length - 3);
        const otherNumbers = parts[0].substring(0, parts[0].length - 3);
        if (otherNumbers !== '') lastThree = ',' + lastThree;
        return otherNumbers.replace(/\B(?=(\d{2})+(?!\d))/g, ',') + lastThree;
      }
      return new Intl.NumberFormat('en-US', {
        maximumFractionDigits: decimals,
        minimumFractionDigits: 0,
      }).format(val);
    }

    // Schedule Storage for Exports
    let currentScheduleData = [];

    function calculate() {
      const P = Math.max(0, parseSmartInput(principalInput?.value || '2500000'));
      const annualRate = Math.max(0, parseFloat(rateInput?.value || '8.5'));
      const tenureVal = Math.max(1, parseFloat(tenureInput?.value || '20'));
      const extraVal = Math.max(0, parseSmartInput(extraInput?.value || '0'));

      const n = Math.round(tenureIsYears ? tenureVal * 12 : tenureVal);
      const r = (annualRate / 12) / 100;

      // Closed-Form Formula
      let emi = 0;
      if (r === 0) {
        emi = n > 0 ? P / n : 0;
      } else {
        const factor = Math.pow(1 + r, n);
        emi = n > 0 ? (P * r * factor) / (factor - 1) : 0;
      }

      // Amortization simulation with optional prepayment
      let balance = P;
      let totalInterest = 0;
      let totalExtraPaid = 0;
      let totalPaid = 0;
      let monthsCount = 0;

      const monthlyRows = [];
      const yearlyRows = [];
      let curYearInterest = 0;
      let curYearPrincipal = 0;
      let curYearExtra = 0;

      let crossoverMonth = null;

      while (balance > 0.01 && monthsCount < 600) {
        monthsCount++;
        const interestMonth = balance * r;
        let principalMonth = emi - interestMonth;
        let actualExtra = extraVal;

        if (balance < principalMonth + actualExtra) {
          principalMonth = Math.min(balance, principalMonth);
          actualExtra = Math.max(0, balance - principalMonth);
          balance = 0;
        } else {
          balance -= (principalMonth + actualExtra);
        }

        totalInterest += interestMonth;
        totalExtraPaid += actualExtra;
        totalPaid += (principalMonth + interestMonth + actualExtra);

        if (!crossoverMonth && principalMonth >= interestMonth) {
          crossoverMonth = monthsCount;
        }

        monthlyRows.push({
          period: `Mo ${monthsCount}`,
          principal: Math.round(principalMonth),
          interest: Math.round(interestMonth),
          extra: Math.round(actualExtra),
          payment: Math.round(principalMonth + interestMonth + actualExtra),
          balance: Math.round(balance),
        });

        curYearPrincipal += principalMonth;
        curYearInterest += interestMonth;
        curYearExtra += actualExtra;

        if (monthsCount % 12 === 0 || balance <= 0.01) {
          yearlyRows.push({
            period: `Year ${Math.ceil(monthsCount / 12)}`,
            principal: Math.round(curYearPrincipal),
            interest: Math.round(curYearInterest),
            extra: Math.round(curYearExtra),
            payment: Math.round(curYearPrincipal + curYearInterest + curYearExtra),
            balance: Math.round(balance),
          });
          curYearPrincipal = 0;
          curYearInterest = 0;
          curYearExtra = 0;
        }
      }

      const baselineTotalPay = emi * n;
      const baselineTotalInt = Math.max(0, baselineTotalPay - P);
      const interestSaved = Math.max(0, baselineTotalInt - totalInterest);
      const monthsSaved = Math.max(0, n - monthsCount);

      currentScheduleData = yearlyRows;

      // Update DOM Text & Results
      if (emiMonthlyResult) emiMonthlyResult.textContent = formatNumber(Math.round(emi));
      if (emiInterestResult) emiInterestResult.textContent = formatNumber(Math.round(totalInterest));
      if (emiTotalResult) emiTotalResult.textContent = `${currentCurrencySymbol} ${formatNumber(Math.round(totalPaid))}`;

      const dispP = document.getElementById('principal-display');
      const dispR = document.getElementById('rate-display');
      const dispT = document.getElementById('tenure-display');
      const dispEx = document.getElementById('extra-display');

      if (dispP) dispP.textContent = `${currentCurrencySymbol} ${formatNumber(P)}`;
      if (dispR) dispR.textContent = `${annualRate.toFixed(2)}%`;
      if (dispT) dispT.textContent = `${tenureVal} ${tenureIsYears ? 'Years' : 'Months'} (${n} Mo)`;
      if (dispEx) dispEx.textContent = `${currentCurrencySymbol} ${formatNumber(extraVal)}`;

      const secP = document.getElementById('sec-principal-value');
      if (secP) secP.textContent = formatNumber(P);

      // Multiplier & Ratios
      const costRatio = P > 0 ? ((totalPaid / P)).toFixed(2) : '1.00';
      const badgeMult = document.getElementById('emi-multiplier-badge');
      if (badgeMult) badgeMult.textContent = `${costRatio}x Cost`;

      const interestPct = totalPaid > 0 ? (totalInterest / totalPaid) * 100 : 0;
      const principalPct = Math.max(0, 100 - interestPct);

      const secBadge = document.getElementById('emi-secondary-badge');
      if (secBadge) secBadge.textContent = `${interestPct.toFixed(1)}% Interest`;

      // Spectrum Bar
      const barP = document.getElementById('bar-principal');
      const barI = document.getElementById('bar-interest');
      const labelP = document.getElementById('bar-principal-label');
      const labelI = document.getElementById('bar-interest-label');

      if (barP) barP.style.width = `${principalPct.toFixed(1)}%`;
      if (barI) barI.style.width = `${interestPct.toFixed(1)}%`;
      if (labelP) labelP.textContent = `${currentCurrencySymbol} ${formatNumber(P)} (${principalPct.toFixed(1)}%)`;
      if (labelI) labelI.textContent = `${currentCurrencySymbol} ${formatNumber(Math.round(totalInterest))} (${interestPct.toFixed(1)}%)`;

      // SVG Donut Rings
      const circ = 339.29;
      const pOffset = circ * (1 - (principalPct / 100));
      const iOffset = circ * (1 - (interestPct / 100));

      const ringP = document.getElementById('donut-principal-ring');
      const ringI = document.getElementById('donut-interest-ring');
      const centerPct = document.getElementById('donut-center-pct');

      if (ringP) ringP.style.strokeDashoffset = String(pOffset);
      if (ringI) ringI.style.strokeDashoffset = String(iOffset);
      if (centerPct) centerPct.textContent = `${interestPct.toFixed(1)}%`;

      const legP = document.getElementById('legend-principal-pct');
      const legI = document.getElementById('legend-interest-pct');
      const legTot = document.getElementById('legend-total-val');
      if (legP) legP.textContent = `${principalPct.toFixed(1)}%`;
      if (legI) legI.textContent = `${interestPct.toFixed(1)}%`;
      if (legTot) legTot.textContent = `${currentCurrencySymbol} ${formatNumber(Math.round(totalPaid))}`;

      // Matrix Cards
      const crossTime = document.getElementById('matrix-crossover-time');
      if (crossTime) crossTime.textContent = crossoverMonth ? `Year ${(crossoverMonth / 12).toFixed(1)}` : 'Year 1';

      const saveIntText = document.getElementById('savings-interest-text');
      const saveTimeText = document.getElementById('savings-time-text');
      if (saveIntText) saveIntText.textContent = `${currentCurrencySymbol} ${formatNumber(Math.round(interestSaved))}`;
      if (saveTimeText) saveTimeText.textContent = `${monthsSaved} Months faster payoff`;

      const newTenureText = document.getElementById('savings-new-tenure-text');
      if (newTenureText) newTenureText.textContent = `${(monthsCount / 12).toFixed(1)} Years (${monthsCount} Mo)`;

      // Mobile HUD
      const mobileVal = document.getElementById('mobile-hud-val');
      const mobileBadge = document.getElementById('mobile-hud-badge');
      if (mobileVal) mobileVal.textContent = `${currentCurrencySymbol} ${formatNumber(Math.round(emi))}`;
      if (mobileBadge) mobileBadge.textContent = `${costRatio}x Cost`;

      // Print Report Sync
      const printDate = document.getElementById('emi-print-date');
      const printCurr = document.getElementById('emi-print-currency');
      const printP = document.getElementById('emi-print-principal');
      const printR = document.getElementById('emi-print-rate');
      const printT = document.getElementById('emi-print-tenure');
      const printEmi = document.getElementById('emi-print-emi');
      const printInt = document.getElementById('emi-print-interest');
      const printTot = document.getElementById('emi-print-total');

      if (printDate) printDate.textContent = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
      if (printCurr) printCurr.textContent = `${activeCode} (${currentCurrencySymbol})`;
      if (printP) printP.textContent = `${currentCurrencySymbol} ${formatNumber(P)}`;
      if (printR) printR.textContent = `${annualRate.toFixed(2)}% P.A.`;
      if (printT) printT.textContent = `${tenureVal} ${tenureIsYears ? 'Years' : 'Months'}`;
      if (printEmi) printEmi.textContent = `${currentCurrencySymbol} ${formatNumber(Math.round(emi))}`;
      if (printInt) printInt.textContent = `${currentCurrencySymbol} ${formatNumber(Math.round(totalInterest))}`;
      if (printTot) printTot.textContent = `${currentCurrencySymbol} ${formatNumber(Math.round(totalPaid))}`;

      // Render Table
      renderTable(scheduleTabMode === 'yearly' ? yearlyRows : monthlyRows);
      renderPrintTable(yearlyRows);
    }

    function renderTable(rows) {
      const tbody = document.getElementById('amortization-table-body');
      if (!tbody) return;
      let html = '';
      rows.slice(0, 360).forEach((r) => {
        html += `
          <tr class="hover:bg-canvas-subtle/50 transition-colors">
            <td class="py-2.5 px-3.5 font-semibold text-link whitespace-nowrap">${r.period}</td>
            <td class="py-2.5 px-3.5 text-right tabular-nums font-mono whitespace-nowrap">${currentCurrencySymbol} ${formatNumber(r.principal)}</td>
            <td class="py-2.5 px-3.5 text-right tabular-nums font-mono text-violet font-semibold whitespace-nowrap">${currentCurrencySymbol} ${formatNumber(r.interest)}</td>
            <td class="py-2.5 px-3.5 text-right tabular-nums font-mono text-ink font-bold whitespace-nowrap">${currentCurrencySymbol} ${formatNumber(r.payment)}</td>
            <td class="py-2.5 px-3.5 text-right tabular-nums font-mono text-mute whitespace-nowrap">${currentCurrencySymbol} ${formatNumber(r.balance)}</td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
    }

    function renderPrintTable(rows) {
      const tbody = document.getElementById('emi-print-schedule-body');
      if (!tbody) return;
      let html = '';
      rows.forEach((r) => {
        html += `
          <tr>
            <td class="py-1 px-2 font-bold">${r.period}</td>
            <td class="py-1 px-2 text-right">${currentCurrencySymbol} ${formatNumber(r.principal)}</td>
            <td class="py-1 px-2 text-right">${currentCurrencySymbol} ${formatNumber(r.interest)}</td>
            <td class="py-1 px-2 text-right">${currentCurrencySymbol} ${formatNumber(r.payment)}</td>
            <td class="py-1 px-2 text-right font-bold">${currentCurrencySymbol} ${formatNumber(r.balance)}</td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
    }

    // Input & Slider Bindings
    function bindTwoWay(input, slider, isShorthand = false) {
      if (!input || !slider) return;
      input.addEventListener('input', () => {
        const val = isShorthand ? parseSmartInput(input.value) : parseFloat(input.value);
        if (!isNaN(val)) {
          if (val > parseFloat(slider.max)) slider.max = String(val * 1.5);
          slider.value = String(val);
        }
        calculate();
      });
      slider.addEventListener('input', () => {
        input.value = slider.value;
        calculate();
      });
    }

    bindTwoWay(principalInput, principalSlider, true);
    bindTwoWay(rateInput, rateSlider, false);
    bindTwoWay(tenureInput, tenureSlider, false);
    bindTwoWay(extraInput, extraSlider, true);

    // Quick Steppers
    document.getElementById('btn-principal-minus')?.addEventListener('click', () => {
      const cur = parseSmartInput(principalInput.value || '0');
      const next = Math.max(100000, cur - 100000);
      principalInput.value = String(next);
      principalSlider.value = String(next);
      calculate();
    });
    document.getElementById('btn-principal-plus')?.addEventListener('click', () => {
      const cur = parseSmartInput(principalInput.value || '0');
      const next = cur + 100000;
      if (next > parseFloat(principalSlider.max)) principalSlider.max = String(next * 1.2);
      principalInput.value = String(next);
      principalSlider.value = String(next);
      calculate();
    });

    document.getElementById('btn-rate-minus')?.addEventListener('click', () => {
      const cur = parseFloat(rateInput.value || '0');
      const next = Math.max(0.1, Number((cur - 0.25).toFixed(2)));
      rateInput.value = String(next);
      rateSlider.value = String(next);
      calculate();
    });
    document.getElementById('btn-rate-plus')?.addEventListener('click', () => {
      const cur = parseFloat(rateInput.value || '0');
      const next = Number((cur + 0.25).toFixed(2));
      rateInput.value = String(next);
      rateSlider.value = String(next);
      calculate();
    });

    // Preset chips
    document.querySelectorAll('.preset-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const amt = chip.getAttribute('data-amount');
        if (amt && principalInput && principalSlider) {
          principalInput.value = amt;
          principalSlider.value = amt;
          calculate();
        }
      });
    });

    // Rate benchmarks
    document.querySelectorAll('.rate-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const r = chip.getAttribute('data-rate');
        if (r && rateInput && rateSlider) {
          rateInput.value = r;
          rateSlider.value = r;
          calculate();
        }
      });
    });

    // Tenure chips
    document.querySelectorAll('.tenure-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const y = chip.getAttribute('data-years');
        if (y && tenureInput && tenureSlider) {
          tenureIsYears = true;
          tenureYrBtn.className = 'rounded px-2.5 py-1 min-h-[44px] sm:min-h-[26px] font-medium bg-primary text-on-primary';
          tenureMoBtn.className = 'rounded px-2.5 py-1 min-h-[44px] sm:min-h-[26px] font-medium text-ink';
          tenureSlider.max = '30';
          tenureSlider.value = y;
          tenureInput.value = y;
          calculate();
        }
      });
    });

    // Tab Buttons
    const amortTabYearly = document.getElementById('amort-tab-yearly');
    const amortTabMonthly = document.getElementById('amort-tab-monthly');

    amortTabYearly?.addEventListener('click', () => {
      scheduleTabMode = 'yearly';
      amortTabYearly.className = 'rounded px-3 py-1 min-h-[32px] sm:min-h-[26px] bg-primary text-on-primary font-bold cursor-pointer transition-colors';
      amortTabMonthly.className = 'rounded px-3 py-1 min-h-[32px] sm:min-h-[26px] text-mute hover:text-ink cursor-pointer transition-colors';
      calculate();
    });
    amortTabMonthly?.addEventListener('click', () => {
      scheduleTabMode = 'monthly';
      amortTabMonthly.className = 'rounded px-3 py-1 min-h-[32px] sm:min-h-[26px] bg-primary text-on-primary font-bold cursor-pointer transition-colors';
      amortTabYearly.className = 'rounded px-3 py-1 min-h-[32px] sm:min-h-[26px] text-mute hover:text-ink cursor-pointer transition-colors';
      calculate();
    });

    tenureYrBtn?.addEventListener('click', () => {
      tenureIsYears = true;
      tenureYrBtn.className = 'rounded px-2.5 py-1 min-h-[44px] sm:min-h-[26px] font-medium bg-primary text-on-primary';
      tenureMoBtn.className = 'rounded px-2.5 py-1 min-h-[44px] sm:min-h-[26px] font-medium text-ink';
      tenureSlider.max = '30';
      tenureSlider.value = '20';
      tenureInput.value = '20';
      calculate();
    });
    tenureMoBtn?.addEventListener('click', () => {
      tenureIsYears = false;
      tenureMoBtn.className = 'rounded px-2.5 py-1 min-h-[44px] sm:min-h-[26px] font-medium bg-primary text-on-primary';
      tenureYrBtn.className = 'rounded px-2.5 py-1 min-h-[44px] sm:min-h-[26px] font-medium text-ink';
      tenureSlider.max = '360';
      tenureSlider.value = '240';
      tenureInput.value = '240';
      calculate();
    });

    formatStdBtn?.addEventListener('click', () => {
      isIndianFormat = false;
      formatStdBtn.className = 'rounded bg-link/15 text-link font-bold px-2.5 py-1 min-h-[32px] sm:min-h-[26px] text-xs cursor-pointer transition-colors';
      formatIndBtn.className = 'rounded px-2.5 py-1 min-h-[32px] sm:min-h-[26px] text-xs font-medium text-mute hover:text-ink cursor-pointer transition-colors';
      calculate();
    });
    formatIndBtn?.addEventListener('click', () => {
      isIndianFormat = true;
      formatIndBtn.className = 'rounded bg-link/15 text-link font-bold px-2.5 py-1 min-h-[32px] sm:min-h-[26px] text-xs cursor-pointer transition-colors';
      formatStdBtn.className = 'rounded px-2.5 py-1 min-h-[32px] sm:min-h-[26px] text-xs font-medium text-mute hover:text-ink cursor-pointer transition-colors';
      calculate();
    });

    // 1-Extra EMI button
    document.getElementById('btn-apply-annual-prepay')?.addEventListener('click', () => {
      const P = parseSmartInput(principalInput?.value || '2500000');
      const r = (parseFloat(rateInput?.value || '8.5') / 12) / 100;
      const n = (parseFloat(tenureInput?.value || '20')) * 12;
      const factor = Math.pow(1 + r, n);
      const emi = (P * r * factor) / (factor - 1);
      const extraMonthly = Math.round(emi / 12);
      extraInput.value = String(extraMonthly);
      extraSlider.value = String(extraMonthly);
      calculate();
      showToast(`1-Extra EMI applied (+${currentCurrencySymbol}${extraMonthly}/mo)`);
    });

    // Direct Excel (.csv) Download Handler
    function downloadExcel() {
      if (!currentScheduleData || currentScheduleData.length === 0) calculate();
      const headers = ['Period', 'Principal Paid', 'Interest Paid', 'Extra Prepayment', 'Total Payment', 'Remaining Balance'];
      const rows = currentScheduleData.map((r) => [r.period, r.principal, r.interest, r.extra, r.payment, r.balance]);
      let csvContent = '\uFEFF';
      csvContent += 'Free Accurate Calculator - EMI Amortization Statement\n';
      csvContent += `Generated,${new Date().toISOString()}\n`;
      csvContent += `Principal,${principalInput?.value || '2500000'}\n`;
      csvContent += `Interest Rate,${rateInput?.value || '8.5'}%\n`;
      csvContent += `Tenure,${tenureInput?.value || '20'} Years\n\n`;
      csvContent += headers.join(',') + '\n';
      rows.forEach((row) => { csvContent += row.join(',') + '\n'; });

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `EMI_Amortization_Statement_${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
      showToast('Excel schedule downloaded!');
    }

    function populatePrintReport() {
      const P = parseSmartInput(principalInput?.value || '2500000');
      const rate = parseFloat(rateInput?.value || '8.5');
      const tenure = tenureInput?.value || '20';
      const emiVal = emiMonthlyResult?.textContent || '0';
      const intVal = emiInterestResult?.textContent || '0';
      const totVal = emiTotalResult?.textContent || '0';

      const dDate = document.getElementById('emi-print-date');
      const dCurr = document.getElementById('emi-print-currency');
      const dP = document.getElementById('emi-print-principal');
      const dR = document.getElementById('emi-print-rate');
      const dT = document.getElementById('emi-print-tenure');
      const dEmi = document.getElementById('emi-print-emi');
      const dInt = document.getElementById('emi-print-interest');
      const dTot = document.getElementById('emi-print-total');
      const dBody = document.getElementById('emi-print-schedule-body');

      if (dDate) dDate.textContent = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      if (dCurr) dCurr.textContent = `${currentCurrencyCode} (${currentCurrencySymbol})`;
      if (dP) dP.textContent = `${currentCurrencySymbol} ${formatNumber(P)}`;
      if (dR) dR.textContent = `${rate.toFixed(2)}% P.A.`;
      if (dT) dT.textContent = `${tenure} ${tenureIsYears ? 'Years' : 'Months'}`;
      if (dEmi) dEmi.textContent = `${currentCurrencySymbol} ${emiVal}`;
      if (dInt) dInt.textContent = `${currentCurrencySymbol} ${intVal}`;
      if (dTot) dTot.textContent = totVal;

      if (dBody && Array.isArray(currentScheduleData)) {
        let html = '';
        currentScheduleData.forEach((r) => {
          html += `<tr class="border-b border-slate-200">
            <td class="py-1.5 px-2.5 font-bold text-blue-700">${r.period}</td>
            <td class="py-1.5 px-2.5 text-right font-mono">${currentCurrencySymbol} ${formatNumber(r.principal)}</td>
            <td class="py-1.5 px-2.5 text-right font-mono">${currentCurrencySymbol} ${formatNumber(r.interest)}</td>
            <td class="py-1.5 px-2.5 text-right font-mono">${currentCurrencySymbol} ${formatNumber(r.payment)}</td>
            <td class="py-1.5 px-2.5 text-right font-mono font-bold">${currentCurrencySymbol} ${formatNumber(r.balance)}</td>
          </tr>`;
        });
        dBody.innerHTML = html;
      }
    }

    // Direct High-Fidelity PDF Statement Download (Single-Flight Protected)
    function downloadPDF(e?: Event) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
        if (typeof (e as any).stopImmediatePropagation === 'function') {
          (e as any).stopImmediatePropagation();
        }
      }
      calculate();
      populatePrintReport();
      if (typeof (window as any).generateAndDownloadPDF === 'function') {
        (window as any).generateAndDownloadPDF();
      } else {
        window.print();
      }
    }

    window.addEventListener('fac:before-pdf-print', () => { calculate(); populatePrintReport(); });
    window.addEventListener('beforeprint', () => { calculate(); populatePrintReport(); });

    // Copy Summary
    function copySummary() {
      const P = parseSmartInput(principalInput?.value || '2500000');
      const rate = parseFloat(rateInput?.value || '8.5');
      const tenure = tenureInput?.value || '20';
      const emiVal = emiMonthlyResult?.textContent || '0';
      const intVal = emiInterestResult?.textContent || '0';
      const totVal = emiTotalResult?.textContent || '0';

      const text = [
        `🏦 Loan EMI Statement — Free Accurate Calculator`,
        `----------------------------------------------------`,
        `• Principal Loan Amount: ${currentCurrencySymbol} ${formatNumber(P)}`,
        `• Annual Interest Rate: ${rate.toFixed(2)}% P.A.`,
        `• Loan Tenure: ${tenure} ${tenureIsYears ? 'Years' : 'Months'}`,
        `• Monthly EMI Obligation: ${currentCurrencySymbol} ${emiVal}`,
        `• Total Interest Payable: ${currentCurrencySymbol} ${intVal}`,
        `• Total Loan Repayment: ${totVal}`,
        `----------------------------------------------------`,
        `Calculate online: ${window.location.href}`,
      ].join('\n');

      navigator.clipboard.writeText(text).then(() => {
        showToast('Loan summary copied to clipboard!');
      }).catch(() => {
        showToast('Unable to copy');
      });
    }

    // Share Link
    function shareLink() {
      const params = new URLSearchParams();
      params.set('p', principalInput?.value || '2500000');
      params.set('r', rateInput?.value || '8.5');
      params.set('t', tenureInput?.value || '20');
      params.set('ex', extraInput?.value || '0');
      window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
      navigator.clipboard.writeText(window.location.href).then(() => {
        showToast('Link copied to clipboard!');
      }).catch(() => {
        showToast('Unable to copy link');
      });
    }

    // Event Listeners
    document.getElementById('emi-copy-summary-btn')?.addEventListener('click', copySummary);
    document.getElementById('emi-share-link-btn')?.addEventListener('click', shareLink);
    document.getElementById('emi-action-pdf-btn')?.addEventListener('click', downloadPDF);
    document.getElementById('emi-action-excel-btn')?.addEventListener('click', downloadExcel);
    document.getElementById('mobile-hud-scroll-btn')?.addEventListener('click', () => {
      document.getElementById('schedule-section-card')?.scrollIntoView({ behavior: 'smooth' });
    });

    // Currency Switcher & Event
    window.addEventListener('currencychange', (e) => {
      const newCurr = e.detail?.currency;
      if (newCurr) {
        currentCurrencySymbol = e.detail.symbol || '$';
        isIndianFormat = e.detail.isIndian ?? (newCurr === 'INR');
        const headerLabel = document.getElementById('emi-header-currency-label');
        if (headerLabel) headerLabel.textContent = `${newCurr} (${currentCurrencySymbol})`;
        document.querySelectorAll('#principal-symbol, #extra-symbol, #sec-principal-symbol, #sec-interest-symbol, #hero-result-symbol').forEach((el) => {
          el.textContent = currentCurrencySymbol;
        });
        calculate();
      }
    });

    // Initial Calculate
    calculate();
  })();
</script>


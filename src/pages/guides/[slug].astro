---
// src/pages/guides/[slug].astro
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { CALCULATORS } from '../../data/calculatorRegistry';

export async function getStaticPaths() {
  const posts = await getCollection('guides');
  return posts
    .filter((post) => post.data.lang === 'en' && !post.id.includes('/'))
    .map((post) => ({
      params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Filter meaningful H2 headings for Table of Contents
const tocHeadings = headings.filter((h) => h.depth === 2);

// Map related calculators from registry
const relatedCalcs = (post.data.relatedCalculators || [])
  .map((calcId: string) => {
    // Check in CALCULATORS registry or handle dedicated pages
    const found = CALCULATORS.find((c) => c.id === calcId);
    if (found) {
      return {
        id: found.id,
        name: found.name,
        href: `/${found.category}/${found.id}/`,
        description: found.description,
        badge: found.badge,
      };
    }
    if (calcId === 'compound-interest-calculator') {
      return {
        id: 'compound-interest-calculator',
        name: 'Compound Interest Calculator',
        href: '/finance/compound-interest-calculator/',
        description: 'Calculate compound growth with customizable frequencies and regular contributions.',
        badge: 'High-Demand',
      };
    }
    if (calcId === 'percentage-calculator') {
      return {
        id: 'percentage-calculator',
        name: 'Percentage Calculator',
        href: '/math/percentage-calculator/',
        description: 'Instant percentage calculation, difference, and change formulas.',
        badge: 'High-Demand',
      };
    }
    if (calcId === 'emi-calculator') {
      return {
        id: 'emi-calculator',
        name: 'EMI Calculator',
        href: '/finance/emi-calculator/',
        description: 'Monthly loan EMI calculator with amortization schedule.',
        badge: 'High-Demand',
      };
    }
    if (calcId === 'bmi-calculator') {
      return {
        id: 'bmi-calculator',
        name: 'BMI Calculator',
        href: '/health/bmi-calculator/',
        description: 'Body mass index calculator with WHO classification ranges.',
        badge: 'Validated',
      };
    }
    return null;
  })
  .filter(Boolean);

const siteOrigin = 'https://freeaccuratecalculator.com';
const pathname = Astro.url.pathname;
const normalizedPathname = pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonicalUrl = `${siteOrigin}${normalizedPathname}`;

// Structured Data: Article Schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.h1 || post.data.title,
  description: post.data.description,
  author: {
    '@type': 'Organization',
    name: post.data.author || 'Free Accurate Calculator Quantitative Editorial Team',
    url: `${siteOrigin}/about/`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Free Accurate Calculator',
    url: `${siteOrigin}/`,
    logo: `${siteOrigin}/favicon.svg`,
  },
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};

// FAQPage Schema for eligible guides with visible FAQs
const isCompoundInterest = post.id.includes('how-compound-interest-works');
const faqSchema = isCompoundInterest
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How often is compound interest calculated on standard savings accounts?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'In most retail banking institutions across the US, UK, Canada, and Australia, savings account interest compounds daily based on the end-of-day ledger balance, but is credited to the account on a monthly basis.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the difference between simple interest and compound interest?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Simple interest is calculated solely on the original principal throughout the entire duration. Compound interest is calculated on the principal plus all interest that has previously accrued, leading to exponential growth over time.',
          },
        },
        {
          '@type': 'Question',
          name: 'Does higher compounding frequency significantly increase returns?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The interest rate generally has a larger impact on final returns than compounding frequency. However, higher compounding frequencies provide an incremental boost. For example, on a $10,000 deposit at 7% over 10 years, shifting from annual to daily compounding adds $464.67 in total interest.',
          },
        },
      ],
    }
  : null;

const schemas = faqSchema ? [articleSchema, faqSchema] : [articleSchema];
---

<Layout
  title={post.data.seoTitle || post.data.title}
  description={post.data.description}
  canonicalUrl={canonicalUrl}
  jsonLd={schemas}
  lang={post.data.lang}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
    <!-- Breadcrumbs: Home → Guides → Title -->
    <Breadcrumbs
      items={[
        { label: 'Guides', href: '/guides/' },
        { label: post.data.title },
      ]}
    />

    <!-- Header -->
    <header class="mt-6 mb-10 pb-8 border-b border-hairline">
      <div class="flex items-center gap-2 mb-3">
        <span class="mono-eyebrow text-link font-semibold uppercase">{post.data.category}</span>
        <span class="h-1 w-1 rounded-full bg-faint"></span>
        <span class="text-xs text-mute font-mono">
          {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(post.data.pubDate)}
        </span>
        <span class="h-1 w-1 rounded-full bg-faint"></span>
        <span class="text-xs text-mute">{post.data.author}</span>
      </div>

      <h1 class="display-hero text-ink tracking-tight mb-4">
        {post.data.h1 || post.data.title}
      </h1>

      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl">
        {post.data.description}
      </p>

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-5">
          {post.data.tags.map((tag: string) => (
            <span class="text-[11px] font-mono px-2 py-0.5 rounded-full border border-hairline bg-canvas-elevated text-mute">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Main Grid: Article Content (8 cols) + Sidebar (4 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Article Prose -->
      <article class="lg:col-span-8 prose dark:prose-invert max-w-none text-body leading-relaxed">
        <div class="article-content space-y-6">
          <Content />
        </div>
      </article>

      <!-- Sticky Sidebar: Table of Contents & Related Tools -->
      <aside class="lg:col-span-4 space-y-6 sticky top-20">
        {tocHeadings.length > 0 && (
          <nav aria-label="Table of Contents" class="rounded-xl border border-hairline bg-canvas-elevated p-5 shadow-whisper">
            <div class="flex items-center gap-2 mb-3 pb-2 border-b border-hairline">
              <svg class="h-3.5 w-3.5 text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
              </svg>
              <h2 class="text-xs font-semibold uppercase tracking-wider text-ink">Contents</h2>
            </div>
            <ul class="space-y-1.5 text-xs">
              {tocHeadings.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    class="block py-1 text-body hover:text-link transition-colors truncate"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        {relatedCalcs.length > 0 && (
          <div class="rounded-xl border border-hairline bg-canvas-elevated p-5 shadow-whisper">
            <div class="flex items-center gap-2 mb-4 pb-3 border-b border-hairline">
              <svg class="h-4 w-4 text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <rect x="4" y="2" width="16" height="20" rx="3" stroke-width="2"></rect>
                <line x1="8" y1="6" x2="16" y2="6" stroke-width="2"></line>
                <line x1="16" y1="14" x2="16" y2="18" stroke-width="2"></line>
              </svg>
              <h2 class="text-xs font-semibold uppercase tracking-wider text-ink">Related Calculators</h2>
            </div>

            <div class="space-y-3">
              {relatedCalcs.map((calc: any) => (
                <a
                  href={calc.href}
                  class="group block rounded-lg border border-hairline p-3 hover:border-link/40 hover:bg-hairline-soft transition-all"
                >
                  <div class="flex items-center justify-between gap-2">
                    <span class="text-xs font-semibold text-ink group-hover:text-link transition-colors">
                      {calc.name}
                    </span>
                    <span class="text-[10px] text-mute group-hover:text-link group-hover:translate-x-0.5 transition-all">
                      →
                    </span>
                  </div>
                  <p class="text-[11px] text-mute mt-1 line-clamp-2 leading-normal">
                    {calc.description}
                  </p>
                </a>
              ))}
            </div>

            <div class="mt-5 pt-4 border-t border-hairline">
              <a
                href="/finance/"
                class="block text-center text-xs font-medium text-link hover:underline"
              >
                Browse All Finance Tools →
              </a>
            </div>
          </div>
        )}
      </aside>
    </div>
  </div>
</Layout>

<style is:global>
  /* Clean typography for markdown content */
  .article-content h2 {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-hairline);
    scroll-margin-top: 5rem;
  }

  .article-content h3 {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 5rem;
  }

  .article-content p {
    margin-bottom: 1.15rem;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .article-content ul, .article-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .article-content ul {
    list-style-type: disc;
  }

  .article-content ol {
    list-style-type: decimal;
  }

  .article-content li {
    margin-bottom: 0.4rem;
    line-height: 1.6;
    font-size: 0.93rem;
  }

  .article-content strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .article-content blockquote {
    border-left: 3px solid var(--color-link);
    padding: 0.85rem 1.15rem;
    margin: 1.5rem 0;
    font-style: normal;
    color: var(--color-ink);
    background: var(--color-hairline-soft);
    border-radius: 0 8px 8px 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .article-content blockquote strong {
    color: var(--color-link);
  }

  .article-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-hairline-soft);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    border: 1px solid var(--color-hairline);
  }

  .article-content pre {
    background: var(--color-canvas-elevated);
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .article-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.85rem;
    display: block;
    overflow-x: auto;
  }

  .article-content th, .article-content td {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-hairline);
    text-align: left;
  }

  .article-content th {
    background: var(--color-hairline-soft);
    font-weight: 600;
    color: var(--color-ink);
  }

  .article-content a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-content a:hover {
    color: var(--color-link-deep);
  }

  .article-content hr {
    border: 0;
    border-top: 1px solid var(--color-hairline);
    margin: 2.5rem 0;
  }
</style>

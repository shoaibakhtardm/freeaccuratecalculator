---
// src/pages/guides/[slug].astro
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { CALCULATORS } from '../../data/calculatorRegistry';
import ReadingProgress from '../../components/ReadingProgress.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import SocialProof from '../../components/SocialProof.astro';
import CalculatorComparison, { type ComparisonItem } from '../../components/CalculatorComparison.astro';
import FAQSection from '../../components/calculator/FAQSection.astro';
import { calculateReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('guides');
  return posts
    .filter((post) => post.data.lang === 'en' && !post.id.includes('/'))
    .map((post) => ({
      params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const slug = post.id.replace(/\.(md|mdx)$/, '');

// Feature 2: Calculate Reading Time
const readingMinutes = calculateReadingTime(post.body || '');

// Feature 5: Comparison Sets for Comparison Guides
const COMPARISONS_BY_GUIDE: Record<string, ComparisonItem[]> = {
  'how-to-calculate-sip-returns': [
    {
      name: 'Systematic Investment Plan (SIP)',
      slug: '/finance/sip-calculator/',
      description: 'Disciplined monthly installment investing with rupee-cost averaging.',
      pros: [
        'Averages market volatility through rupee-cost averaging',
        'Low entry barrier (starts from ₹500 / $10/month)',
        'Automated monthly compounding habit',
        'Mitigates the psychological pressure of market timing',
      ],
      cons: [
        'May slightly trail lump sum in sustained bull runs',
        'Requires regular recurring monthly income stream',
      ],
    },
    {
      name: 'Lump Sum Investment',
      slug: '/finance/compound-interest-calculator/',
      description: 'Deploying total capital upfront into mutual funds or index funds.',
      pros: [
        'Full capital begins compounding on day one',
        'Historically outperforms DCA in ~66% of long-term horizons',
        'Single transaction execution with zero recurring effort',
      ],
      cons: [
        'Exposes investor to bad short-term market timing risk',
        'Requires substantial liquid cash reserves upfront',
        'Higher psychological panic during sudden market corrections',
      ],
    },
  ],
  'mortgage-calculator-buy-vs-rent-analysis': [
    {
      name: 'Homeownership (Mortgage)',
      slug: '/finance/mortgage-calculator/',
      description: 'Buying residential property with an amortized mortgage loan.',
      pros: [
        'Forces monthly principal equity accumulation',
        'Protection against landlord termination and rent inflation',
        'Potential for long-term leveraged real estate appreciation',
        'Full renovation freedom and lifestyle security',
      ],
      cons: [
        'High unrecoverable costs (~5% rule: interest, property tax, maintenance)',
        'Heavy upfront closing fees and realtor commissions (6-10%)',
        'Severe geographic illiquidity and ongoing debt liability',
      ],
    },
    {
      name: 'Renting & Investing Difference',
      slug: '/finance/compound-interest-calculator/',
      description: 'Paying fixed shelter rent and investing down payment cash into index funds.',
      pros: [
        'Zero liabilities for property taxes, roofing, or major repairs',
        'Full geographic mobility to relocate for career opportunities',
        'Capital compounds in global equities averaging ~9-10% return',
        'Predictable, fixed monthly housing cash flow',
      ],
      cons: [
        'Subject to annual landlord rent increases and lease renewals',
        'Accumulates zero real estate property equity',
        'Requires strict personal discipline to actually invest the savings',
      ],
    },
  ],
  'income-tax-calculator-india-new-vs-old-regime': [
    {
      name: 'New Tax Regime (Sec 115BAC)',
      slug: '/finance/income-tax-calculator/',
      description: 'Concessional tax slab rates with minimal documentation and zero deductions.',
      pros: [
        'Significantly lower tax slab rates across middle-income brackets',
        'Full tax rebate up to ₹7,00,000 (effective taxable zero)',
        'Zero paperwork: no receipts, rent slips, or investment proofs required',
        'Default tax regime with automatic standard deduction of ₹50,000',
      ],
      cons: [
        'Cannot claim 80C (PPF, ELSS, EPF), 80D (Health Insurance), or HRA exemptions',
        'No deduction for home loan interest on self-occupied properties (Sec 24b)',
      ],
    },
    {
      name: 'Old Tax Regime',
      slug: '/finance/income-tax-calculator/',
      description: 'Higher tax slab rates balanced by extensive deductions and exemptions.',
      pros: [
        'Enables substantial deductions: Section 80C (₹1.5L), 80D (₹25k-₹1L), 80CCD(1B) (₹50k)',
        'Allows massive tax shield via HRA and home loan interest deduction up to ₹2,00,000',
        'Highly lucrative for individuals with heavy mortgages and family health insurance',
      ],
      cons: [
        'Higher baseline tax rates (20% above ₹5L, 30% above ₹10L)',
        'Requires active proofs, certificates, rent agreements, and audit compliance',
        'Locks capital into specific long-term instruments like tax-saving FDs and insurance',
      ],
    },
  ],
};

const guideComparisons = COMPARISONS_BY_GUIDE[slug] || [];

// Fallback FAQs for how-compound-interest-works if not in frontmatter
const defaultCompoundInterestFaqs = [
  {
    question: 'How often is compound interest calculated on standard savings accounts?',
    answer:
      'In most retail banking institutions across the US, UK, Canada, and Australia, savings account interest compounds daily based on the end-of-day ledger balance, but is credited to the account on a monthly basis.',
  },
  {
    question: 'What is the difference between simple interest and compound interest?',
    answer:
      'Simple interest is calculated solely on the original principal throughout the entire duration. Compound interest is calculated on the principal plus all interest that has previously accrued, leading to exponential growth over time.',
  },
  {
    question: 'Does higher compounding frequency significantly increase returns?',
    answer:
      'The interest rate generally has a larger impact on final returns than compounding frequency. However, higher compounding frequencies provide an incremental boost. For example, on a $10,000 deposit at 7% over 10 years, shifting from annual to daily compounding adds $464.67 in total interest.',
  },
];

const postFaqs =
  post.data.faqs && post.data.faqs.length > 0
    ? post.data.faqs
    : post.id.includes('how-compound-interest-works')
      ? defaultCompoundInterestFaqs
      : [];

// Map related calculators from registry
const relatedCalcs = (post.data.relatedCalculators || [])
  .map((calcId: string) => {
    const found = CALCULATORS.find((c) => c.id === calcId);
    if (found) {
      return {
        id: found.id,
        name: found.name,
        href: `/${found.category}/${found.id}/`,
        description: found.description,
        badge: found.badge,
      };
    }
    if (calcId === 'compound-interest-calculator') {
      return {
        id: 'compound-interest-calculator',
        name: 'Compound Interest Calculator',
        href: '/finance/compound-interest-calculator/',
        description: 'Calculate compound growth with customizable frequencies and regular contributions.',
        badge: 'High-Demand',
      };
    }
    if (calcId === 'percentage-calculator') {
      return {
        id: 'percentage-calculator',
        name: 'Percentage Calculator',
        href: '/math/percentage-calculator/',
        description: 'Instant percentage calculation, difference, and change formulas.',
        badge: 'High-Demand',
      };
    }
    if (calcId === 'emi-calculator') {
      return {
        id: 'emi-calculator',
        name: 'EMI Calculator',
        href: '/finance/emi-calculator/',
        description: 'Monthly loan EMI calculator with amortization schedule.',
        badge: 'High-Demand',
      };
    }
    if (calcId === 'bmi-calculator') {
      return {
        id: 'bmi-calculator',
        name: 'BMI Calculator',
        href: '/health/bmi-calculator/',
        description: 'Body mass index calculator with WHO classification ranges.',
        badge: 'Validated',
      };
    }
    if (calcId === 'mortgage-calculator') {
      return {
        id: 'mortgage-calculator',
        name: 'Mortgage Calculator',
        href: '/finance/mortgage-calculator/',
        description: 'Monthly home mortgage payment with PITI breakdown and amortization schedule.',
        badge: 'Popular',
      };
    }
    return null;
  })
  .filter(Boolean);

const siteOrigin = 'https://freeaccuratecalculator.com';
const pathname = Astro.url.pathname;
const normalizedPathname = pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonicalUrl = `${siteOrigin}${normalizedPathname}`;

// Structured Data: Article Schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.h1 || post.data.title,
  description: post.data.description,
  author: {
    '@type': 'Organization',
    name: post.data.author || 'Free Accurate Calculator Quantitative Editorial Team',
    url: `${siteOrigin}/about/`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Free Accurate Calculator',
    url: `${siteOrigin}/`,
    logo: `${siteOrigin}/favicon.svg`,
  },
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};

// FAQPage Schema for all guides with FAQs
const faqSchema =
  postFaqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: postFaqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      }
    : null;

const schemas = faqSchema ? [articleSchema, faqSchema] : [articleSchema];
---

<Layout
  title={post.data.seoTitle || post.data.title}
  description={post.data.description}
  canonicalUrl={canonicalUrl}
  jsonLd={schemas}
  lang={post.data.lang}
>
  <!-- Feature 1: Reading Progress Bar -->
  <ReadingProgress />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
    <!-- Breadcrumbs: Home → Guides → Title -->
    <Breadcrumbs
      items={[
        { label: 'Guides', href: '/guides/' },
        { label: post.data.title },
      ]}
    />

    <!-- Header -->
    <header class="mt-6 mb-10 pb-8 border-b border-hairline">
      <div class="flex flex-wrap items-center gap-2 mb-3 text-xs text-mute font-mono">
        <span class="mono-eyebrow text-link font-semibold uppercase">{post.data.category}</span>
        <span class="h-1 w-1 rounded-full bg-faint"></span>
        <time datetime={post.data.pubDate.toISOString()}>
          {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(post.data.pubDate)}
        </time>
        <span class="h-1 w-1 rounded-full bg-faint"></span>
        <!-- Feature 2: Reading Time Display -->
        <span class="text-ink font-semibold">{readingMinutes} min read</span>
        <span class="h-1 w-1 rounded-full bg-faint"></span>
        <span>By {post.data.author}</span>
      </div>

      <h1 class="display-hero text-ink tracking-tight mb-4">
        {post.data.h1 || post.data.title}
      </h1>

      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl">
        {post.data.description}
      </p>

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-5">
          {post.data.tags.map((tag: string) => (
            <span class="text-[11px] font-mono px-2 py-0.5 rounded-full border border-hairline bg-canvas-elevated text-mute">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Feature 4: Companion Calculator Spotlight with Social Proof Widget -->
    {post.data.targetCalculator && (
      <aside aria-label="Companion Calculator" class="mb-10 rounded-xl border border-link/30 bg-canvas-elevated p-5 sm:p-6 shadow-whisper">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="mono-eyebrow text-link font-semibold uppercase">Interactive Companion Tool</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-link/10 text-link border border-link/20">Free & Instant</span>
        </div>

        <SocialProof calculatorName={post.data.targetCalculator.name} />

        <h2 class="text-lg font-bold text-ink mb-1">
          {post.data.targetCalculator.name}
        </h2>
        <p class="text-xs sm:text-sm text-mute mb-4 leading-relaxed max-w-2xl">
          {post.data.targetCalculator.description || `Run instant, accurate simulations using our client-side ${post.data.targetCalculator.name}.`}
        </p>

        <a
          href={post.data.targetCalculator.href}
          class="inline-flex items-center justify-center gap-2 bg-link hover:bg-link-deep text-white font-semibold text-xs sm:text-sm px-5 py-2.5 rounded-lg transition-colors shadow-xs"
        >
          <span>Open {post.data.targetCalculator.name}</span>
          <span>→</span>
        </a>
      </aside>
    )}

    <!-- Main Grid: Article Content (8 cols) + Sidebar (4 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Article Prose -->
      <article class="lg:col-span-8 prose dark:prose-invert max-w-none text-body leading-relaxed">
        <div class="article-content space-y-6">
          <Content />
        </div>

        <!-- Feature 5: Calculator Comparison Tool -->
        {guideComparisons.length > 0 && (
          <section class="mt-12 pt-8 border-t border-hairline">
            <div class="mb-4">
              <span class="mono-eyebrow text-link">Strategy Analysis</span>
              <h2 class="heading-md text-ink mt-1">Side-by-Side Comparison</h2>
            </div>
            <CalculatorComparison calculators={guideComparisons} />
          </section>
        )}

        <!-- FAQs Accordion with Rich FAQPage Schema -->
        {postFaqs.length > 0 && (
          <div class="mt-12">
            <FAQSection faqs={postFaqs} title="Frequently Asked Questions" />
          </div>
        )}
      </article>

      <!-- Sticky Sidebar: Feature 3: Table of Contents & Related Tools -->
      <aside class="lg:col-span-4 space-y-6 sticky top-20">
        <!-- Feature 3: Table of Contents Component with Smooth Scroll -->
        <TableOfContents headings={headings} />

        {relatedCalcs.length > 0 && (
          <div class="rounded-xl border border-hairline bg-canvas-elevated p-5 shadow-whisper">
            <div class="flex items-center gap-2 mb-4 pb-3 border-b border-hairline">
              <svg class="h-4 w-4 text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <rect x="4" y="2" width="16" height="20" rx="3" stroke-width="2"></rect>
                <line x1="8" y1="6" x2="16" y2="6" stroke-width="2"></line>
                <line x1="16" y1="14" x2="16" y2="18" stroke-width="2"></line>
              </svg>
              <h2 class="text-xs font-semibold uppercase tracking-wider text-ink">Related Calculators</h2>
            </div>

            <div class="space-y-3">
              {relatedCalcs.map((calc: any) => (
                <a
                  href={calc.href}
                  class="group block rounded-lg border border-hairline p-3 hover:border-link/40 hover:bg-hairline-soft transition-all"
                >
                  <div class="flex items-center justify-between gap-2">
                    <span class="text-xs font-semibold text-ink group-hover:text-link transition-colors">
                      {calc.name}
                    </span>
                    <span class="text-[10px] text-mute group-hover:text-link group-hover:translate-x-0.5 transition-all">
                      →
                    </span>
                  </div>
                  <p class="text-[11px] text-mute mt-1 line-clamp-2 leading-normal">
                    {calc.description}
                  </p>
                </a>
              ))}
            </div>

            <div class="mt-5 pt-4 border-t border-hairline">
              <a
                href="/finance/"
                class="block text-center text-xs font-medium text-link hover:underline"
              >
                Browse All Finance Tools →
              </a>
            </div>
          </div>
        )}
      </aside>
    </div>
  </div>
</Layout>

<style is:global>
  /* Clean typography for markdown content */
  .article-content h2 {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-hairline);
    scroll-margin-top: 5rem;
  }

  .article-content h3 {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 5rem;
  }

  .article-content p {
    margin-bottom: 1.15rem;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .article-content ul,
  .article-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .article-content ul {
    list-style-type: disc;
  }

  .article-content ol {
    list-style-type: decimal;
  }

  .article-content li {
    margin-bottom: 0.4rem;
    line-height: 1.6;
    font-size: 0.93rem;
  }

  .article-content strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .article-content blockquote {
    border-left: 3px solid var(--color-link);
    padding: 0.85rem 1.15rem;
    margin: 1.5rem 0;
    font-style: normal;
    color: var(--color-ink);
    background: var(--color-hairline-soft);
    border-radius: 0 8px 8px 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .article-content blockquote strong {
    color: var(--color-link);
  }

  .article-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-hairline-soft);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    border: 1px solid var(--color-hairline);
  }

  .article-content pre {
    background: var(--color-canvas-elevated);
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .article-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.85rem;
    display: block;
    overflow-x: auto;
  }

  .article-content th,
  .article-content td {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-hairline);
    text-align: left;
  }

  .article-content th {
    background: var(--color-hairline-soft);
    font-weight: 600;
    color: var(--color-ink);
  }

  .article-content a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-content a:hover {
    color: var(--color-link-deep);
  }

  .article-content hr {
    border: 0;
    border-top: 1px solid var(--color-hairline);
    margin: 2.5rem 0;
  }
</style>

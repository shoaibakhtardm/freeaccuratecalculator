---
// src/pages/guides/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { calculateReadingTime } from '../../utils/readingTime';

const posts = await getCollection('guides');
// Filter English guides and sort by pubDate descending
const sortedPosts = posts
  .filter((post) => post.data.lang === 'en' && !post.id.includes('/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Financial & Mathematical Guides | Free Accurate Calculator"
  description="In-depth educational articles, documented mathematical formulas, step-by-step worked examples, and quantitative calculation guides."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumbs: Home → Guides -->
    <Breadcrumbs
      items={[
        { label: 'Guides' },
      ]}
    />

    <!-- Hero Header -->
    <div class="mt-6 mb-12 border-b border-hairline pb-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="mono-eyebrow text-link font-semibold uppercase">Quantitative Intelligence</span>
        <span class="h-1 w-1 rounded-full bg-faint"></span>
        <span class="text-xs text-mute font-mono">Educational Layer</span>
      </div>
      <h1 class="display-hero text-ink tracking-tight mb-3">
        Calculation Guides & Mathematical Proofs
      </h1>
      <p class="text-base sm:text-lg text-body max-w-2xl leading-relaxed">
        Peer-level mathematical explanations, formula derivations, real-world examples, and precision guides designed to accompany our client-side calculators.
      </p>
    </div>

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedPosts.map((post) => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        const readingTime = calculateReadingTime(post.body || '');
        return (
          <article class="group rounded-xl border border-hairline bg-canvas-elevated p-6 hover:border-link/40 hover:shadow-whisper transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="mono-eyebrow text-link font-semibold uppercase text-[10px]">
                  {post.data.category}
                </span>
                <div class="flex items-center gap-2 text-xs text-mute font-mono">
                  <span>{readingTime} min read</span>
                  <span>•</span>
                  <span>
                    {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(post.data.pubDate)}
                  </span>
                </div>
              </div>

              <h2 class="text-lg font-semibold text-ink group-hover:text-link transition-colors leading-snug mb-2">
                <a href={`/guides/${slug}/`}>
                  {post.data.title}
                </a>
              </h2>

              <p class="text-xs sm:text-sm text-body line-clamp-3 leading-relaxed mb-4">
                {post.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-hairline flex items-center justify-between">
              <span class="text-xs text-mute font-mono">{post.data.author}</span>
              <a
                href={`/guides/${slug}/`}
                class="text-xs font-semibold text-link flex items-center gap-1 group-hover:translate-x-1 transition-transform"
              >
                Read Guide <span>→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</Layout>

---
// src/pages/hi/index.astro
import Layout from '../../layouts/Layout.astro';

const categories = [
  {
    id: 'finance',
    name: 'वित्तीय कैलकुलेटर (Finance)',
    eyebrow: 'उच्च परिशुद्धता वित्तीय गणित',
    description: 'ऋण ईएमआई, चक्रवृद्धि ब्याज, गृह ऋण और वित्तीय योजना के सटीक कैलकुलेटर।',
    calculators: [
      {
        name: 'ऋण ईएमआई कैलकुलेटर',
        slug: '/hi/finance/emi-calculator/',
        desc: 'घटते शेष (रिड्यूसिंग बैलेंस) और भारतीय लाख/करोड़ प्रारूप के साथ मासिक किस्त व परिशोधन विवरण।',
        badge: 'ऋण / लोन',
        badgeColor: 'text-cyan border-cyan/30 bg-cyan/10',
      },
      {
        name: 'चक्रवृद्धि ब्याज (Compound Interest)',
        slug: '/finance/compound-interest-calculator/',
        desc: 'नियमित मासिक जमा और चक्रवृद्धि अवधि के साथ निवेश वृद्धि का अनुमान लगाएं।',
        badge: 'यूनिवर्सल',
        badgeColor: 'text-link border-link/30 bg-link/10',
      },
    ],
  },
  {
    id: 'health',
    name: 'स्वास्थ्य और फिटनेस (Health)',
    eyebrow: 'मानक क्लीनिकल सूत्र',
    description: 'बीएमआई (बॉडी मास इंडेक्स), दैनिक कैलोरी आवश्यकता और बुनियादी चयापचय दर।',
    calculators: [
      {
        name: 'बीएमआई कैलकुलेटर',
        slug: '/health/bmi-calculator/',
        desc: 'डब्ल्यूएचओ (WHO) और एशियाई कट-ऑफ मानकों के अनुसार मीट्रिक (किग्रा/सेमी) एवं इंपीरियल प्रणाली।',
        badge: 'मीट्रिक / इंपीरियल',
        badgeColor: 'text-violet border-violet/30 bg-violet/10',
      },
    ],
  },
  {
    id: 'math',
    name: 'गणित एवं परिशुद्धता (Math)',
    eyebrow: 'सटीक अंकगणित',
    description: 'प्रतिशत, भिन्न, वैज्ञानिक संकेतन और बुनियादी अंकगणितीय समस्याएं।',
    calculators: [
      {
        name: 'प्रतिशत कैलकुलेटर',
        slug: '/hi/math/percentage-calculator/',
        desc: 'किसी संख्या का प्रतिशत, प्रतिशत वृद्धि, कमी एवं सापेक्ष अंतर का चरण-दर-चरण समाधान।',
        badge: 'यूनिवर्सल',
        badgeColor: 'text-link border-link/30 bg-link/10',
      },
    ],
  },
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Free Accurate Calculator (हिन्दी)',
  url: 'https://freeaccuratecalculator.com/hi/',
  description: 'वित्त, स्वास्थ्य, गणित और दैनिक उपयोग के लिए तेज़, गोपनीय और गणितीय रूप से सत्यापित मुफ़्त ऑनलाइन कैलकुलेटर।',
};
---

<Layout
  title="मुफ़्त एवं सटीक कैलकुलेटर — तेज़, गोपनीय और बिना किसी देरी के"
  description="वित्त, स्वास्थ्य, गणित और दैनिक जीवन के लिए गणितीय रूप से सत्यापित ऑनलाइन कैलकुलेटर। पूर्ण गोपनीयता और तुरंत परिणाम।"
  jsonLd={websiteSchema}
  lang="hi"
>
  <!-- [STARTUP HERO SECTION]: Silicon Valley Precision Layout -->
  <section class="relative overflow-hidden rounded-3xl sm:rounded-[36px] border border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-slate-950/70 px-4 py-10 sm:py-16 md:py-20 text-center hero-mesh-gradient shadow-xs sm:shadow-lg backdrop-blur-xl">
    <!-- Top Ambient Studio Glow (Linear / Vercel style) -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 sm:w-[540px] h-44 sm:h-64 bg-gradient-to-b from-indigo-500/20 via-blue-500/10 to-transparent blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto max-w-3xl space-y-5 sm:space-y-6">
      <!-- 1. The Startup Pill Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/20 dark:border-indigo-400/30 bg-gradient-to-r from-blue-500/8 via-indigo-500/8 to-purple-500/8 dark:from-blue-500/15 dark:via-indigo-500/15 dark:to-purple-500/15 px-3.5 py-1.5 shadow-2xs backdrop-blur-md transition-all hover:border-indigo-500/40 select-none">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-outfit text-[11px] sm:text-xs font-bold tracking-wider uppercase text-slate-700 dark:text-slate-200">
          अंतरराष्ट्रीय संस्करण (हिन्दी)
        </span>
        <span class="text-indigo-500 dark:text-indigo-400 text-xs font-bold ml-0.5">✦</span>
      </div>

      <!-- 2. The Main H1 Headline: Outfit Font, Startup Rhythm & Gradient -->
      <h1 class="font-outfit text-3xl sm:text-5xl lg:text-[54px] font-black tracking-[-0.03em] text-slate-900 dark:text-white leading-[1.15] sm:leading-[1.1] text-balance">
        सटीक गणना। <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-blue-600 via-indigo-600 via-purple-600 to-pink-500 dark:from-blue-400 dark:via-indigo-300 dark:to-purple-300 bg-clip-text text-transparent">
          तेज़, सही और बिल्कुल स्पष्ट।
        </span>
      </h1>

      <!-- 3. Subtitle Paragraph: Refined Typography & Balanced Width -->
      <p class="font-sans text-sm sm:text-base md:text-[17px] text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal text-balance px-2">
        सत्यापित गणितीय शुद्धता, स्वच्छ इंटरफ़ेस और शून्य भ्रम। सीधे आपके ब्राउज़र में त्वरित परिणाम और अत्याधुनिक क्लाउडफ्लेयर एज नेटवर्क द्वारा संचालित।
      </p>

      <!-- 4. Spotlight Search Bar (Raycast / Linear Command-Bar Style) -->
      <div class="pt-2 max-w-xl mx-auto">
        <div class="relative flex items-center group">
          <div
            class="absolute -inset-1 rounded-2xl sm:rounded-full bg-gradient-to-r from-blue-600/25 via-indigo-600/25 to-purple-600/25 opacity-0 group-focus-within:opacity-100 blur-md transition-all duration-300 pointer-events-none"
            aria-hidden="true"
          ></div>

          <svg
            class="absolute left-4 h-4.5 w-4.5 text-slate-400 dark:text-slate-500 group-focus-within:text-indigo-600 dark:group-focus-within:text-indigo-400 transition-colors pointer-events-none z-10"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>

          <input
            id="search-input"
            type="search"
            placeholder="कैलकुलेटर खोजें (उदा. 'प्रतिशत', 'ऋण/ईएमआई', 'बीएमआई')..."
            class="relative z-0 w-full rounded-2xl sm:rounded-full border border-slate-200/90 dark:border-slate-800/90 bg-white/95 dark:bg-slate-900/95 py-3.5 sm:py-4 pl-11 pr-4 text-sm sm:text-base text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 shadow-sm focus:border-indigo-500 dark:focus:border-indigo-400 focus:outline-none focus:ring-4 focus:ring-indigo-500/10 dark:focus:ring-indigo-400/10 transition-all backdrop-blur-xl"
            aria-label="कैलकुलेटर खोजें"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Category Showcases -->
  <div class="mt-12 space-y-16">
    {categories.map((cat) => (
      <section class="space-y-6">
        <div>
          <span class="mono-eyebrow text-link">{cat.eyebrow}</span>
          <h2 class="heading-lg text-ink mt-1">{cat.name}</h2>
          <p class="text-xs sm:text-sm text-body mt-1 max-w-xl">{cat.description}</p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {cat.calculators.map((calc) => (
            <a
              href={calc.slug}
              class="group relative flex flex-col justify-between rounded-[12px] border border-hairline bg-canvas-elevated p-5 shadow-whisper transition-all duration-200 hover:-translate-y-0.5 hover:border-hairline-focus hover:shadow-card"
            >
              <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class={`rounded-full border px-2 py-0.5 text-[10px] font-mono font-medium ${calc.badgeColor}`}>
                    {calc.badge}
                  </span>
                </div>
                <h3 class="text-base font-semibold text-ink group-hover:text-link transition-colors">
                  {calc.name}
                </h3>
                <p class="text-xs leading-relaxed text-body line-clamp-2">
                  {calc.desc}
                </p>
              </div>
              <div class="mt-4 flex items-center text-xs font-medium text-link">
                <span>कैलकुलेटर खोलें</span>
                <svg class="ml-1 h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

---
// src/pages/hi/index.astro
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/common/AdSlot.astro';

const categories = [
  {
    id: 'finance',
    name: 'वित्तीय कैलकुलेटर (Finance)',
    eyebrow: 'उच्च परिशुद्धता वित्तीय गणित',
    description: 'ऋण ईएमआई, चक्रवृद्धि ब्याज, गृह ऋण और वित्तीय योजना के सटीक कैलकुलेटर।',
    calculators: [
      {
        name: 'ऋण ईएमआई कैलकुलेटर',
        slug: '/hi/finance/emi-calculator/',
        desc: 'घटते शेष (रिड्यूसिंग बैलेंस) और भारतीय लाख/करोड़ प्रारूप के साथ मासिक किस्त व परिशोधन विवरण।',
        badge: 'ऋण / लोन',
        badgeColor: 'text-cyan border-cyan/30 bg-cyan/10',
      },
      {
        name: 'चक्रवृद्धि ब्याज (Compound Interest)',
        slug: '/finance/compound-interest-calculator/',
        desc: 'नियमित मासिक जमा और चक्रवृद्धि अवधि के साथ निवेश वृद्धि का अनुमान लगाएं।',
        badge: 'यूनिवर्सल',
        badgeColor: 'text-link border-link/30 bg-link/10',
      },
    ],
  },
  {
    id: 'health',
    name: 'स्वास्थ्य और फिटनेस (Health)',
    eyebrow: 'मानक क्लीनिकल सूत्र',
    description: 'बीएमआई (बॉडी मास इंडेक्स), दैनिक कैलोरी आवश्यकता और बुनियादी चयापचय दर।',
    calculators: [
      {
        name: 'बीएमआई कैलकुलेटर',
        slug: '/health/bmi-calculator/',
        desc: 'डब्ल्यूएचओ (WHO) और एशियाई कट-ऑफ मानकों के अनुसार मीट्रिक (किग्रा/सेमी) एवं इंपीरियल प्रणाली।',
        badge: 'मीट्रिक / इंपीरियल',
        badgeColor: 'text-violet border-violet/30 bg-violet/10',
      },
    ],
  },
  {
    id: 'math',
    name: 'गणित एवं परिशुद्धता (Math)',
    eyebrow: 'सटीक अंकगणित',
    description: 'प्रतिशत, भिन्न, वैज्ञानिक संकेतन और बुनियादी अंकगणितीय समस्याएं।',
    calculators: [
      {
        name: 'प्रतिशत कैलकुलेटर',
        slug: '/hi/math/percentage-calculator/',
        desc: 'किसी संख्या का प्रतिशत, प्रतिशत वृद्धि, कमी एवं सापेक्ष अंतर का चरण-दर-चरण समाधान।',
        badge: 'यूनिवर्सल',
        badgeColor: 'text-link border-link/30 bg-link/10',
      },
    ],
  },
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Free Accurate Calculator (हिन्दी)',
  url: 'https://freeaccuratecalculator.com/hi/',
  description: 'वित्त, स्वास्थ्य, गणित और दैनिक उपयोग के लिए तेज़, गोपनीय और गणितीय रूप से सत्यापित मुफ़्त ऑनलाइन कैलकुलेटर।',
};
---

<Layout
  title="मुफ़्त एवं सटीक कैलकुलेटर — तेज़, गोपनीय और बिना किसी देरी के"
  description="वित्त, स्वास्थ्य, गणित और दैनिक जीवन के लिए गणितीय रूप से सत्यापित ऑनलाइन कैलकुलेटर। पूर्ण गोपनीयता और तुरंत परिणाम।"
  jsonLd={websiteSchema}
  lang="hi"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden rounded-[16px] border border-hairline bg-canvas-elevated/70 px-4 py-8 sm:p-14 lg:p-20 text-center hero-mesh-gradient shadow-whisper">
    <div class="relative z-10 mx-auto max-w-3xl space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas/80 px-3 py-1 text-xs text-body backdrop-blur-sm shadow-whisper">
        <span class="flex h-2 w-2 rounded-full bg-cyan animate-pulse"></span>
        <span class="font-mono text-[11px] font-medium tracking-wide uppercase">अंतरराष्ट्रीय संस्करण (हिन्दी)</span>
      </div>

      <h1 class="display-hero text-ink">
        सटीक गणना। <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-link via-violet to-magenta bg-clip-text text-transparent">
          तेज़, सही और बिल्कुल स्पष्ट।
        </span>
      </h1>

      <p class="text-base sm:text-lg text-body max-w-2xl mx-auto leading-relaxed font-normal">
        सत्यापित गणितीय शुद्धता, स्वच्छ इंटरफ़ेस और शून्य भ्रम। सीधे आपके ब्राउज़र में त्वरित परिणाम और क्लाउडफ्लेयर एज नेटवर्क द्वारा संचालित।
      </p>

      <!-- Search Input -->
      <div class="pt-2 max-w-xl mx-auto">
        <div class="relative flex items-center">
          <svg class="absolute left-4 h-4 w-4 text-mute pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            id="search-input"
            type="search"
            placeholder="कैलकुलेटर खोजें (उदा. 'प्रतिशत', 'ऋण/ईएमआई', 'बीएमआई')..."
            class="w-full rounded-[100px] border border-hairline bg-canvas py-3.5 pl-11 pr-4 text-base sm:text-sm text-ink placeholder-faint shadow-whisper focus:border-link focus:outline-none focus:ring-1 focus:ring-link transition-all"
            aria-label="कैलकुलेटर खोजें"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Top Reserved Ad Slot -->
  <div class="mt-8">
    <AdSlot slotId="home-leaderboard" format="horizontal" />
  </div>

  <!-- Category Showcases -->
  <div class="mt-12 space-y-16">
    {categories.map((cat) => (
      <section class="space-y-6">
        <div>
          <span class="mono-eyebrow text-link">{cat.eyebrow}</span>
          <h2 class="heading-lg text-ink mt-1">{cat.name}</h2>
          <p class="text-xs sm:text-sm text-body mt-1 max-w-xl">{cat.description}</p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {cat.calculators.map((calc) => (
            <a
              href={calc.slug}
              class="group relative flex flex-col justify-between rounded-[12px] border border-hairline bg-canvas-elevated p-5 shadow-whisper transition-all duration-200 hover:-translate-y-0.5 hover:border-hairline-focus hover:shadow-card"
            >
              <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class={`rounded-full border px-2 py-0.5 text-[10px] font-mono font-medium ${calc.badgeColor}`}>
                    {calc.badge}
                  </span>
                </div>
                <h3 class="text-base font-semibold text-ink group-hover:text-link transition-colors">
                  {calc.name}
                </h3>
                <p class="text-xs leading-relaxed text-body line-clamp-2">
                  {calc.desc}
                </p>
              </div>
              <div class="mt-4 flex items-center text-xs font-medium text-link">
                <span>कैलकुलेटर खोलें</span>
                <svg class="ml-1 h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

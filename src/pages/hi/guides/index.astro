---
// src/pages/hi/guides/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/common/Breadcrumbs.astro';

const posts = await getCollection('guides');
const sortedPosts = posts
  .filter((post) => post.data.lang === 'hi' || post.id.startsWith('hi/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="वित्तीय एवं गणितीय मार्गदर्शिकाएं | Free Accurate Calculator"
  description="गहन शैक्षणिक लेख, प्रमाणित गणितीय सूत्र, चरण-दर-चरण उदाहरण और मात्रात्मक गणना मार्गदर्शिकाएं हिन्दी में।"
  lang="hi"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { label: 'होम', href: '/hi/' },
        { label: 'गाइड (मार्गदर्शिका)' },
      ]}
    />

    <!-- Hero Header -->
    <div class="mt-6 mb-12 border-b border-hairline pb-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="mono-eyebrow text-link font-semibold uppercase">मात्रात्मक विश्लेषण</span>
        <span class="h-1 w-1 rounded-full bg-faint"></span>
        <span class="text-xs text-mute font-mono">शैक्षणिक आधार</span>
      </div>
      <h1 class="display-hero text-ink tracking-tight mb-3">
        गणना मार्गदर्शिका एवं गणितीय प्रमाण
      </h1>
      <p class="text-base sm:text-lg text-body max-w-2xl leading-relaxed">
        हमारे ऑनलाइन कैलकुलेटरों के साथ सहयोगात्मक रूप से तैयार की गई सटीक गणितीय व्याख्याएं, सूत्र और व्यावहारिक उदाहरण।
      </p>
    </div>

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedPosts.map((post) => {
        const slug = post.id.replace(/\.(md|mdx)$/, '').replace(/^hi\//, '');
        return (
          <article class="group rounded-xl border border-hairline bg-canvas-elevated p-6 hover:border-link/40 hover:shadow-whisper transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="mono-eyebrow text-link font-semibold uppercase text-[10px]">
                  {post.data.category}
                </span>
                <span class="text-xs text-mute font-mono">
                  {new Intl.DateTimeFormat('hi-IN', { month: 'short', day: 'numeric', year: 'numeric' }).format(post.data.pubDate)}
                </span>
              </div>

              <h2 class="text-lg font-semibold text-ink group-hover:text-link transition-colors leading-snug mb-2">
                <a href={`/hi/guides/${slug}/`}>
                  {post.data.title}
                </a>
              </h2>

              <p class="text-xs sm:text-sm text-body line-clamp-3 leading-relaxed mb-4">
                {post.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-hairline flex items-center justify-between">
              <span class="text-xs text-mute font-mono">{post.data.author}</span>
              <a
                href={`/hi/guides/${slug}/`}
                class="text-xs font-semibold text-link flex items-center gap-1 group-hover:translate-x-1 transition-transform"
              >
                मार्गदर्शिका पढ़ें <span>→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</Layout>

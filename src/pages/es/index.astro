---
// src/pages/es/index.astro
import Layout from '../../layouts/Layout.astro';
import AutocompleteSearch from '../../components/common/AutocompleteSearch.astro';

const categories = [
  {
    id: 'finance',
    name: 'Calculadoras de Finanzas',
    eyebrow: 'Matemáticas Financieras de Alta Precisión',
    description: 'Amortización de préstamos, interés compuesto y cuotas mensuales (EMI).',
    calculators: [
      {
        name: 'Calculadora EMI (Préstamos)',
        slug: '/finance/emi-calculator/',
        desc: 'Cuotas mensuales fijas y saldo decreciente con desglose completo de amortización.',
        badge: 'Préstamos',
        badgeColor: 'text-cyan border-cyan/30 bg-cyan/10',
      },
      {
        name: 'Interés Compuesto',
        slug: '/finance/compound-interest-calculator/',
        desc: 'Crecimiento de inversión con capitalización y depósitos periódicos.',
        badge: 'Universal',
        badgeColor: 'text-link border-link/30 bg-link/10',
      },
    ],
  },
  {
    id: 'health',
    name: 'Salud y Condición Física',
    eyebrow: 'Métricas y Fórmulas Clínicas',
    description: 'Calculadoras validadas de IMC, tasa metabólica basal y balance calórico.',
    calculators: [
      {
        name: 'Calculadora de IMC',
        slug: '/health/bmi-calculator/',
        desc: 'Índice de Masa Corporal con sistema métrico (kg/cm) e imperial (libras/pies) según la OMS.',
        badge: 'Métrico / Imperial',
        badgeColor: 'text-violet border-violet/30 bg-violet/10',
      },
    ],
  },
  {
    id: 'math',
    name: 'Matemáticas y Precisión',
    eyebrow: 'Aritmética Exacta',
    description: 'Porcentajes, fracciones, notación científica y álgebra fundamental.',
    calculators: [
      {
        name: 'Calculadora de Porcentajes',
        slug: '/es/math/percentage-calculator/',
        desc: 'Porcentaje de una cantidad, aumentos, disminuciones relativas y diferencias paso a paso.',
        badge: 'Universal',
        badgeColor: 'text-link border-link/30 bg-link/10',
      },
    ],
  },
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Free Accurate Calculator (Español)',
  url: 'https://freeaccuratecalculator.com/es/',
  description: 'Calculadoras en línea rápidas y matemáticamente verificadas para finanzas, salud, matemáticas y uso cotidiano.',
};
---

<Layout
  title="Calculadoras Gratuitas y Precisas — Rápidas y Sin Esperas"
  description="Calculadoras en línea verificadas matemáticamente para Finanzas, Salud, Matemáticas y Vida Cotidiana con máxima privacidad local y ejecución instantánea."
  jsonLd={websiteSchema}
  lang="es"
>
  <!-- [STARTUP HERO SECTION]: Silicon Valley Precision Layout -->
  <section class="relative overflow-hidden rounded-3xl sm:rounded-[36px] border border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-slate-950/70 px-4 py-10 sm:py-16 md:py-20 text-center hero-mesh-gradient shadow-xs sm:shadow-lg backdrop-blur-xl">
    <!-- Top Ambient Studio Glow (Linear / Vercel style) -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 sm:w-[540px] h-44 sm:h-64 bg-gradient-to-b from-indigo-500/20 via-blue-500/10 to-transparent blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto max-w-3xl space-y-5 sm:space-y-6">
      <!-- 1. The Startup Pill Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/20 dark:border-indigo-400/30 bg-gradient-to-r from-blue-500/8 via-indigo-500/8 to-purple-500/8 dark:from-blue-500/15 dark:via-indigo-500/15 dark:to-purple-500/15 px-3.5 py-1.5 shadow-2xs backdrop-blur-md transition-all hover:border-indigo-500/40 select-none">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-outfit text-[11px] sm:text-xs font-bold tracking-wider uppercase text-slate-700 dark:text-slate-200">
          Edición Internacional
        </span>
        <span class="text-indigo-500 dark:text-indigo-400 text-xs font-bold ml-0.5">✦</span>
      </div>

      <!-- 2. The Main H1 Headline: Outfit Font, Startup Rhythm & Gradient -->
      <h1 class="font-outfit text-3xl sm:text-5xl lg:text-[56px] xl:text-[60px] font-black tracking-[-0.035em] text-slate-900 dark:text-white leading-[1.12] sm:leading-[1.08] text-balance">
        Cálculos Bien Hechos. <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-blue-600 via-indigo-600 via-purple-600 to-pink-500 dark:from-blue-400 dark:via-indigo-300 dark:to-purple-300 bg-clip-text text-transparent">
          Rápidos, Precisos y Claros.
        </span>
      </h1>

      <!-- 3. Subtitle Paragraph: Refined Typography & Balanced Width -->
      <p class="font-sans text-sm sm:text-base md:text-[17px] text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal text-balance px-2">
        Precisión matemática verificada con un diseño limpio, sin fórmulas fiscales engañosas y sin retardos. Calculadoras locales y entrega instantánea en el borde.
      </p>

      <!-- 4. Interactive Live Spotlight Search Bar with Instant Suggestions -->
      <div class="pt-2 max-w-2xl mx-auto">
        <AutocompleteSearch
          id="search-input"
          placeholder="Buscar calculadora (ej. 'porcentaje', 'préstamo', 'imc')..."
        />
      </div>
    </div>
  </section>

  <!-- Category Showcases -->
  <div class="mt-12 space-y-16">
    {categories.map((cat) => (
      <section class="space-y-6">
        <div>
          <span class="mono-eyebrow text-link">{cat.eyebrow}</span>
          <h2 class="heading-lg text-ink mt-1">{cat.name}</h2>
          <p class="text-xs sm:text-sm text-body mt-1 max-w-xl">{cat.description}</p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {cat.calculators.map((calc) => (
            <a
              href={calc.slug}
              class="group relative flex flex-col justify-between rounded-[12px] border border-hairline bg-canvas-elevated p-5 shadow-whisper transition-all duration-200 hover:-translate-y-0.5 hover:border-hairline-focus hover:shadow-card"
            >
              <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class={`rounded-full border px-2 py-0.5 text-[10px] font-mono font-medium ${calc.badgeColor}`}>
                    {calc.badge}
                  </span>
                </div>
                <h3 class="text-base font-semibold text-ink group-hover:text-link transition-colors">
                  {calc.name}
                </h3>
                <p class="text-xs leading-relaxed text-body line-clamp-2">
                  {calc.desc}
                </p>
              </div>
              <div class="mt-4 flex items-center text-xs font-medium text-link">
                <span>Abrir Calculadora</span>
                <svg class="ml-1 h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

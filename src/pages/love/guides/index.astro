---
// File: src/pages/love/guides/index.astro
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/common/Breadcrumbs.astro';
import RomanticBackground from '../../../components/love/RomanticBackground.astro';

const guides = [
  {
    title: "How Love Calculators Work: Science, Algorithms & Gematria",
    slug: "how-love-calculator-works",
    description: "An in-depth look at phonetic acoustic resonance, Pythagorean numerology matrices, and statistical romance matching.",
    icon: "🔬",
    readTime: "6 min read",
    tag: "Algorithm Deep Dive"
  },
  {
    title: "Zodiac Compatibility Guide: Elemental Synergy & Astrological Aspects",
    slug: "zodiac-compatibility-guide",
    description: "Understand Fire, Earth, Air, and Water harmonies, Trine angles, and synastry planetary interactions.",
    icon: "✨",
    readTime: "8 min read",
    tag: "Astrology"
  },
  {
    title: "Numerology Love Meanings: Life Path Numbers & Soul Urge Bonds",
    slug: "numerology-love-meanings",
    description: "Calculate life path vibrations (1 to 9, master 11/22/33) and decode your karmic relationship blueprint.",
    icon: "🔢",
    readTime: "7 min read",
    tag: "Numerology"
  },
  {
    title: "11 Twin Flame Signs: Soulmate vs Twin Flame Connection Stages",
    slug: "twin-flame-signs",
    description: "Recognize the unmistakable energetic triggers, runner-chaser dynamics, and cosmic twin flame reunion stages.",
    icon: "🔥",
    readTime: "9 min read",
    tag: "Spiritual Romance"
  }
];

const siteOrigin = 'https://freeaccuratecalculator.com';
const canonicalUrl = `${siteOrigin}/love/guides/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Love & Compatibility Guides — Free Accurate Calculator",
  "description": "Comprehensive guides on love calculator algorithms, astrology synastry, numerology, and twin flame connections.",
  "url": canonicalUrl
};
---

<Layout
  title="Love Compatibility Guides & Relationship Science (2026)"
  description="Master the science behind love compatibility. Read expert guides on love algorithms, zodiac synastry, numerology life paths, and twin flame signs."
  keywords="love calculator guide, zodiac compatibility guide, numerology love meanings, twin flame signs, relationship science"
  canonicalUrl={canonicalUrl}
  ogTitle="Love Compatibility Guides & Relationship Science"
  ogDescription="Explore deep-dive guides on romantic algorithms, zodiac synastry, and numerological relationship bonds."
  jsonLd={jsonLd}
>
  <RomanticBackground />

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">
    <Breadcrumbs
      items={[
        { label: 'Love Calculators', href: '/love/' },
        { label: 'Guides' }
      ]}
    />

    <header class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-rose-300 dark:border-rose-700 bg-rose-500/10 text-rose-600 dark:text-rose-300 text-xs font-bold uppercase tracking-wider">
        <span>📚 Knowledge Hub</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-black text-slate-900 dark:text-white leading-tight">
        Love &amp; Compatibility <span class="bg-gradient-to-r from-red-600 via-rose-500 to-pink-500 bg-clip-text text-transparent">Guides</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
        Explore the mathematical, astrological, and psychological foundations that power romantic synergy.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {guides.map((guide) => (
        <a
          href={`/love/guides/${guide.slug}/`}
          class="group relative p-6 rounded-2xl border border-rose-200/80 dark:border-rose-800/80 bg-white/70 dark:bg-slate-900/70 backdrop-blur-md hover:border-rose-400 dark:hover:border-rose-600 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl space-y-4 flex flex-col justify-between"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-3xl p-2.5 rounded-xl bg-rose-100 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800/60 group-hover:scale-110 transition-transform">
                {guide.icon}
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-900/40 px-2.5 py-1 rounded-full border border-rose-200 dark:border-rose-800">
                {guide.tag}
              </span>
            </div>
            <h2 class="font-serif text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors leading-snug">
              {guide.title}
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed">
              {guide.description}
            </p>
          </div>

          <div class="pt-3 border-t border-rose-100 dark:border-rose-900/40 flex items-center justify-between text-xs font-semibold text-rose-600 dark:text-rose-400">
            <span>{guide.readTime}</span>
            <span class="group-hover:translate-x-1 transition-transform">Read Guide →</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Back to Hub Callout -->
    <div class="text-center pt-8">
      <a
        href="/love/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-red-600 via-rose-600 to-pink-600 text-white font-bold text-sm shadow-md hover:shadow-lg hover:scale-105 transition-all"
      >
        <span>💖 Try All 21 Love Calculators</span>
      </a>
    </div>
  </div>
</Layout>

                <td class="p-2.5 font-mono font-bold">B, K, T</td>
                <td class="p-2.5">Gentle empathy, deep emotional bonding, cooperative peace</td>
                <td class="p-2.5 text-center font-bold">2, 4, 8</td>
              </tr>
              <tr class="bg-white dark:bg-slate-900">
                <td class="p-2.5 font-mono font-bold text-center text-rose-600 dark:text-rose-400">3</td>
                <td class="p-2.5 font-mono font-bold">C, L, U</td>
                <td class="p-2.5">Playful expression, witty conversation, artistic inspiration</td>
                <td class="p-2.5 text-center font-bold">1, 3, 6</td>
              </tr>
              <tr class="bg-rose-50/40 dark:bg-slate-800/40">
                <td class="p-2.5 font-mono font-bold text-center text-rose-600 dark:text-rose-400">4</td>
                <td class="p-2.5 font-mono font-bold">D, M, V</td>
                <td class="p-2.5">Loyalty, practical stability, long-term marriage security</td>
                <td class="p-2.5 text-center font-bold">2, 4, 8</td>
              </tr>

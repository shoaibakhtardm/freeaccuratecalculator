---
// File: src/pages/love/guides/zodiac-compatibility.astro
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/common/Breadcrumbs.astro';
import RomanticBackground from '../../../components/love/RomanticBackground.astro';

const siteOrigin = 'https://freeaccuratecalculator.com';
const canonicalUrl = `${siteOrigin}/love/guides/zodiac-compatibility/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Zodiac Compatibility Guide: All 12 Signs in Love & Marriage",
  "description": "Comprehensive astrological compatibility matrix for all 12 Western Zodiac signs. Fire, Earth, Air, and Water synastry explained.",
  "author": {
    "@type": "Organization",
    "name": "Free Accurate Calculator"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Free Accurate Calculator",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteOrigin}/favicon.svg`
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const allSigns = [
  { name: 'Aries', symbol: '♈', element: 'Fire', dates: 'Mar 21 - Apr 19', best: 'Leo, Sagittarius, Gemini, Libra', challenging: 'Cancer, Capricorn', summary: 'Passionate, spontaneous, and courageous. Craves independence and enthusiastic adventure.' },
  { name: 'Taurus', symbol: '♉', element: 'Earth', dates: 'Apr 20 - May 20', best: 'Virgo, Capricorn, Cancer, Scorpio', challenging: 'Leo, Aquarius', summary: 'Loyal, sensual, and devoted. Values emotional consistency, physical affection, and financial security.' },
  { name: 'Gemini', symbol: '♊', element: 'Air', dates: 'May 21 - Jun 20', best: 'Libra, Aquarius, Aries, Sagittarius', challenging: 'Virgo, Pisces', summary: 'Witty, versatile, and intellectually vibrant. Needs sparkling conversation and mental rapport.' },
  { name: 'Cancer', symbol: '♋', element: 'Water', dates: 'Jun 21 - Jul 22', best: 'Scorpio, Pisces, Taurus, Capricorn', challenging: 'Aries, Libra', summary: 'Deeply intuitive, nurturing, and empathetic. Builds intimate sanctuary homes and fiercely protects loved ones.' },
  { name: 'Leo', symbol: '♌', element: 'Fire', dates: 'Jul 23 - Aug 22', best: 'Aries, Sagittarius, Gemini, Aquarius', challenging: 'Taurus, Scorpio', summary: 'Generous, radiant, and fiercely loyal. Expresses love through romantic grand gestures and mutual admiration.' },
  { name: 'Virgo', symbol: '♍', element: 'Earth', dates: 'Aug 23 - Sep 22', best: 'Taurus, Capricorn, Cancer, Pisces', challenging: 'Gemini, Sagittarius', summary: 'Thoughtful, practical, and detail-oriented. Shows profound devotion through acts of service and constant care.' },
  { name: 'Libra', symbol: '♎', element: 'Air', dates: 'Sep 23 - Oct 22', best: 'Gemini, Aquarius, Leo, Aries', challenging: 'Cancer, Capricorn', summary: 'Charming, diplomatic, and romantic. Dedicated to peace, aesthetic harmony, and equal partnership.' },
  { name: 'Scorpio', symbol: '♏', element: 'Water', dates: 'Oct 23 - Nov 21', best: 'Cancer, Pisces, Virgo, Taurus', challenging: 'Leo, Aquarius', summary: 'Magnetic, intense, and deeply spiritual. Seeks complete emotional vulnerability and unwavering fidelity.' },
  { name: 'Sagittarius', symbol: '♐', element: 'Fire', dates: 'Nov 22 - Dec 21', best: 'Aries, Leo, Libra, Gemini', challenging: 'Virgo, Pisces', summary: 'Free-spirited, philosophical, and optimistic. Thrives with a partner who embraces global travel and growth.' },
  { name: 'Capricorn', symbol: '♑', element: 'Earth', dates: 'Dec 22 - Jan 19', best: 'Taurus, Virgo, Scorpio, Cancer', challenging: 'Aries, Libra', summary: 'Ambitious, dependable, and steadfast. Expresses love by building lasting generational foundations.' },
  { name: 'Aquarius', symbol: '♒', element: 'Air', dates: 'Jan 20 - Feb 18', best: 'Gemini, Libra, Sagittarius, Leo', challenging: 'Taurus, Scorpio', summary: 'Visionary, original, and humanitarian. Values intellectual freedom and deep friendship as the core of romance.' },
  { name: 'Pisces', symbol: '♓', element: 'Water', dates: 'Feb 19 - Mar 20', best: 'Cancer, Scorpio, Taurus, Virgo', challenging: 'Gemini, Sagittarius', summary: 'Dreamy, compassionate, and telepathically attuned. Loves selflessly with poetic romantic devotion.' }
];
---

<Layout
  title="Zodiac Compatibility Guide: All 12 Signs in Love (2026)"
  description="Master zodiac sign compatibility with our complete 12-sign love guide. Explore elemental synergies (Fire, Earth, Air, Water), best matches, and synastry charts."
  keywords="zodiac sign compatibility, astrology love compatibility, zodiac compatibility guide, star sign matches, zodiac compatibility chart"
  canonicalUrl={canonicalUrl}
  ogTitle="Zodiac Compatibility Guide: All 12 Signs in Love"
  ogDescription="Explore the full 12-sign astrological compatibility matrix and elemental synergies."
  jsonLd={jsonLd}
>
  <RomanticBackground />

  <article class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">
    <Breadcrumbs
      items={[
        { label: 'Love Calculators', href: '/love/' },
        { label: 'Guides', href: '/love/guides/' },
        { label: 'Zodiac Compatibility Guide' }
      ]}
    />

    <header class="space-y-4 border-b border-rose-200/60 dark:border-rose-900/60 pb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 text-xs font-bold uppercase tracking-wider">
        <span>✨ Comprehensive Astrology • 45,000 Monthly Searches</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-black text-slate-900 dark:text-white leading-tight">
        Zodiac Compatibility Guide: <span class="bg-gradient-to-r from-red-600 via-rose-500 to-pink-500 bg-clip-text text-transparent">All 12 Signs in Love</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
        Astrological synastry is the study of how celestial bodies interact between two birth charts. Whether your sign is ruled by fiery passion or watery intuition, understanding the four elements and modalities unlocks deep romantic clarity.
      </p>
    </header>

    <div class="prose prose-rose dark:prose-invert max-w-none text-sm sm:text-base space-y-8 text-slate-700 dark:text-slate-300 leading-relaxed">
      
      <!-- Section 1: The 4 Elemental Triplicities -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
          1. The 4 Elemental Triplicities
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose my-4">
          <div class="p-5 rounded-2xl border border-rose-200 dark:border-rose-800 bg-white/70 dark:bg-slate-900/70">
            <h3 class="font-bold text-red-600 dark:text-red-400 flex items-center gap-2">
              <span>🔥 Fire Elements (Aries, Leo, Sagittarius)</span>
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
              <strong>Romantic Signature:</strong> High enthusiasm, spontaneous passion, courageous expression. Best matched with Air signs (who fuel their flame) or fellow Fire signs.
            </p>
          </div>
          <div class="p-5 rounded-2xl border border-rose-200 dark:border-rose-800 bg-white/70 dark:bg-slate-900/70">
            <h3 class="font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-2">
              <span>🌱 Earth Elements (Taurus, Virgo, Capricorn)</span>
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
              <strong>Romantic Signature:</strong> Unshakable loyalty, grounded security, physical sensuality. Best matched with Water signs (who nurture growth) or fellow Earth signs.
            </p>
          </div>
          <div class="p-5 rounded-2xl border border-rose-200 dark:border-rose-800 bg-white/70 dark:bg-slate-900/70">
            <h3 class="font-bold text-sky-600 dark:text-sky-400 flex items-center gap-2">
              <span>💨 Air Elements (Gemini, Libra, Aquarius)</span>
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
              <strong>Romantic Signature:</strong> Mental rapport, witty banter, social connectivity. Best matched with Fire signs (who bring warmth) or fellow Air signs.
            </p>
          </div>
          <div class="p-5 rounded-2xl border border-rose-200 dark:border-rose-800 bg-white/70 dark:bg-slate-900/70">
            <h3 class="font-bold text-blue-600 dark:text-blue-400 flex items-center gap-2">
              <span>🌊 Water Elements (Cancer, Scorpio, Pisces)</span>
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
              <strong>Romantic Signature:</strong> Emotional depth, psychic empathy, soul-level intimacy. Best matched with Earth signs (who provide containment) or fellow Water signs.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 2: Complete 12-Sign Compatibility Profiles -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
          2. Complete 12-Sign Love Profiles &amp; Match Matrix
        </h2>
        <div class="space-y-4 not-prose my-6">
          {allSigns.map((s) => (
            <div class="p-5 rounded-2xl border border-rose-200/80 dark:border-rose-900/60 bg-white/80 dark:bg-slate-900/80 space-y-2.5">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-rose-100 dark:border-rose-900/40 pb-2">
                <div class="flex items-center gap-2">
                  <span class="text-2xl">{s.symbol}</span>
                  <h3 class="font-serif text-lg font-bold text-slate-900 dark:text-white">
                    {s.name} ({s.dates})
                  </h3>
                </div>
                <span class="text-xs font-mono font-bold text-rose-600 dark:text-rose-400 px-2.5 py-0.5 rounded-full bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800">
                  {s.element} Element
                </span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                {s.summary}
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs pt-1">
                <div class="p-2 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/40 text-emerald-900 dark:text-emerald-200 border border-emerald-200 dark:border-emerald-800/60">
                  <span class="font-bold">✨ Top Matches:</span> {s.best}
                </div>
                <div class="p-2 rounded-xl bg-rose-50/70 dark:bg-rose-950/40 text-rose-900 dark:text-rose-200 border border-rose-200 dark:border-rose-800/60">
                  <span class="font-bold">⚡ Growth Friction:</span> {s.challenging}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 3: Sun, Moon, and Rising Synastry -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
          3. Beyond the Sun Sign: The "Big Three" in Relationships
        </h2>
        <p>
          While your Sun sign reveals your outward ego and fundamental goals, comprehensive relationship synastry evaluates:
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong>Sun Sign:</strong> Core identity, conscious values, and ego vitality.</li>
          <li><strong>Moon Sign:</strong> Emotional security, subconscious coping patterns, and domestic habits.</li>
          <li><strong>Rising Sign (Ascendant):</strong> First impressions, instinctive attraction, and relationship approach.</li>
          <li><strong>Venus Sign:</strong> Romantic love language, aesthetic appreciation, and affection style.</li>
          <li><strong>Mars Sign:</strong> Physical passion, conflict style, and motivational drive.</li>
        </ul>
      </section>
    </div>

    <!-- Related Interactive Calculator CTA -->
    <div class="mt-10 p-6 rounded-3xl bg-purple-50 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-800 space-y-4">
      <h3 class="font-serif text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
        Test your astrological chemistry:
      </h3>
      <div class="flex flex-wrap gap-3">
        <a
          href="/zodiac-compatibility/"
          class="px-5 py-2.5 rounded-xl bg-purple-600 text-white font-bold text-xs sm:text-sm shadow hover:bg-purple-500 transition"
        >
          ✨ Zodiac Compatibility Calculator
        </a>
        <a
          href="/chinese-zodiac-love-calculator/"
          class="px-5 py-2.5 rounded-xl bg-amber-600 text-white font-bold text-xs sm:text-sm shadow hover:bg-amber-500 transition"
        >
          🐉 Chinese Zodiac Calculator
        </a>
        <a
          href="/love/guides/"
          class="px-5 py-2.5 rounded-xl border border-purple-300 dark:border-purple-700 font-bold text-xs sm:text-sm text-purple-700 dark:text-purple-300 hover:bg-purple-100 dark:hover:bg-purple-900/40 transition"
        >
          ← Back to All Guides
        </a>
      </div>
    </div>
  </article>
</Layout>

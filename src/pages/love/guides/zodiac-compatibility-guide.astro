---
// File: src/pages/love/guides/zodiac-compatibility-guide.astro
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/common/Breadcrumbs.astro';
import RomanticBackground from '../../../components/love/RomanticBackground.astro';

const siteOrigin = 'https://freeaccuratecalculator.com';
const canonicalUrl = `${siteOrigin}/love/guides/zodiac-compatibility-guide/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Zodiac Compatibility Guide: Elemental Synergy & Astrological Synastry",
  "description": "Learn how the four elements (Fire, Earth, Air, Water) and astrological angles determine romance, chemistry, and longevity.",
  "author": {
    "@type": "Organization",
    "name": "Free Accurate Calculator"
  },
  "mainEntityOfPage": canonicalUrl
};
---

<Layout
  title="Zodiac Compatibility Guide: Elements & Synastry (2026)"
  description="Master astrological love compatibility. Understand elemental harmonies (Fire, Earth, Air, Water), opposite signs, and planetary synastry aspects."
  keywords="zodiac compatibility guide, astrology love compatibility, synastry elements, star signs in love"
  canonicalUrl={canonicalUrl}
  ogTitle="Zodiac Compatibility Guide: Astrological Love Synastry"
  ogDescription="Explore how star signs interact in love, passion, and long-term marriage."
  jsonLd={jsonLd}
>
  <RomanticBackground />

  <article class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs
      items={[
        { label: 'Love Calculators', href: '/love/' },
        { label: 'Guides', href: '/love/guides/' },
        { label: 'Zodiac Guide' }
      ]}
    />

    <header class="space-y-4 border-b border-rose-200/60 dark:border-rose-900/60 pb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 text-xs font-bold uppercase tracking-wider">
        <span>✨ Astrological Synastry</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-black text-slate-900 dark:text-white leading-tight">
        Zodiac Compatibility: <span class="bg-gradient-to-r from-red-600 via-rose-500 to-pink-500 bg-clip-text text-transparent">Elements &amp; Synastry Matrix</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
        Discover how the celestial archetypes influence interpersonal dynamics, passionate spark, and emotional security between partners.
      </p>
    </header>

    <div class="prose prose-rose dark:prose-invert max-w-none text-sm sm:text-base space-y-6 text-slate-700 dark:text-slate-300">
      <section class="space-y-3">
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
          1. The 4 Astrological Elements &amp; Romantic Synergies
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose">
          <div class="p-4 rounded-xl border border-rose-200 dark:border-rose-800 bg-white/60 dark:bg-slate-900/60">
            <h3 class="font-bold text-red-600 dark:text-red-400 flex items-center gap-1.5">
              <span>🔥 Fire Signs</span>
              <span class="text-xs text-slate-500">(Aries, Leo, Sagittarius)</span>
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-1.5 leading-relaxed">
              Passionate, dynamic, and action-oriented. Best paired with fellow Fire signs for high energy, or Air signs to fuel inspiration.
            </p>
          </div>
          <div class="p-4 rounded-xl border border-rose-200 dark:border-rose-800 bg-white/60 dark:bg-slate-900/60">
            <h3 class="font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5">
              <span>🌱 Earth Signs</span>
              <span class="text-xs text-slate-500">(Taurus, Virgo, Capricorn)</span>
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-1.5 leading-relaxed">
              Grounded, loyal, and practical. Blend harmoniously with Water signs for deep emotional loyalty and tangible long-term stability.
            </p>
          </div>
          <div class="p-4 rounded-xl border border-rose-200 dark:border-rose-800 bg-white/60 dark:bg-slate-900/60">
            <h3 class="font-bold text-sky-600 dark:text-sky-400 flex items-center gap-1.5">
              <span>💨 Air Signs</span>
              <span class="text-xs text-slate-500">(Gemini, Libra, Aquarius)</span>
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-1.5 leading-relaxed">
              Intellectual, communicative, and socially vibrant. Excel when paired with Fire signs for excitement or fellow Air signs for mental rapport.
            </p>
          </div>
          <div class="p-4 rounded-xl border border-rose-200 dark:border-rose-800 bg-white/60 dark:bg-slate-900/60">
            <h3 class="font-bold text-blue-600 dark:text-blue-400 flex items-center gap-1.5">
              <span>🌊 Water Signs</span>
              <span class="text-xs text-slate-500">(Cancer, Scorpio, Pisces)</span>
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-1.5 leading-relaxed">
              Intuitive, deeply empathetic, and devoted. Connect profoundly with Earth signs for security and fellow Water signs for spiritual intimacy.
            </p>
          </div>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
          2. Beyond the Sun Sign: Moon &amp; Venus Placements
        </h2>
        <p>
          While Sun sign compatibility offers a broad baseline of core ego resonance, true relationship longevity is governed by:
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong>Moon Signs:</strong> Emotional instincts, coping mechanisms, and vulnerability needs.</li>
          <li><strong>Venus Signs:</strong> Love languages, aesthetic tastes, and relationship expectations.</li>
          <li><strong>Mars Signs:</strong> Passion, physical chemistry, and conflict styles.</li>
        </ul>
      </section>
    </div>

    <div class="mt-8 p-6 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 space-y-4">
      <h3 class="font-serif text-lg font-bold text-slate-900 dark:text-white">
        Test your sign compatibility right now:
      </h3>
      <div class="flex flex-wrap gap-3">
        <a
          href="/zodiac-compatibility/"
          class="px-4 py-2 rounded-xl bg-purple-600 text-white font-bold text-xs shadow hover:bg-purple-500 transition"
        >
          ✨ Zodiac Love Compatibility Calculator
        </a>
        <a
          href="/chinese-zodiac-love-calculator/"
          class="px-4 py-2 rounded-xl bg-amber-600 text-white font-bold text-xs shadow hover:bg-amber-500 transition"
        >
          🐉 Chinese Zodiac Calculator
        </a>
      </div>
    </div>
  </article>
</Layout>

---
// File: src/pages/love/guides/flames-game-rules.astro
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/common/Breadcrumbs.astro';
import RomanticBackground from '../../../components/love/RomanticBackground.astro';

const siteOrigin = 'https://freeaccuratecalculator.com';
const canonicalUrl = `${siteOrigin}/love/guides/flames-game-rules/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "FLAMES Game: History, Rules & How to Play Step-by-Step",
  "description": "Learn how to play the classic FLAMES game, the letter cancellation algorithm, and the meaning of Friends, Lovers, Affection, Marriage, Enemy, Siblings.",
  "author": {
    "@type": "Organization",
    "name": "Free Accurate Calculator"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Free Accurate Calculator",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteOrigin}/favicon.svg`
    }
  },
  "mainEntityOfPage": canonicalUrl
};
---

<Layout
  title="FLAMES Game: History, Rules & How to Play (2026)"
  description="Master the classic FLAMES game online. Learn the exact step-by-step letter elimination algorithm, meaning of all 6 outcomes (F-L-A-M-E-S), and play now."
  keywords="flames game online, flames calculator rules, how to play flames game, flames acronym meaning, flames love test"
  canonicalUrl={canonicalUrl}
  ogTitle="FLAMES Game: History, Rules & How to Play"
  ogDescription="Master the classic FLAMES game with our step-by-step letter elimination guide."
  jsonLd={jsonLd}
>
  <RomanticBackground />

  <article class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">
    <Breadcrumbs
      items={[
        { label: 'Love Calculators', href: '/love/' },
        { label: 'Guides', href: '/love/guides/' },
        { label: 'FLAMES Game Rules' }
      ]}
    />

    <header class="space-y-4 border-b border-rose-200/60 dark:border-rose-900/60 pb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-pink-500/10 text-pink-600 dark:text-pink-400 text-xs font-bold uppercase tracking-wider">
        <span>🕹️ Nostalgic Romance • 250,000 Monthly Searches</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-black text-slate-900 dark:text-white leading-tight">
        FLAMES Game: <span class="bg-gradient-to-r from-pink-600 via-rose-500 to-red-500 bg-clip-text text-transparent">History, Rules &amp; How to Play</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
        The FLAMES game is one of the world's most beloved schoolyard romance rituals. Discover the mathematical mechanics, character cancellation rules, and digital interpretations of this timeless relationship game.
      </p>
    </header>

    <div class="prose prose-rose dark:prose-invert max-w-none text-sm sm:text-base space-y-8 text-slate-700 dark:text-slate-300 leading-relaxed">
      
      <!-- Section 1: The FLAMES Acronym Meaning -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
          1. The 6 Letters of FLAMES Explained
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 not-prose my-4">
          <div class="p-4 rounded-2xl border border-rose-200 dark:border-rose-800 bg-white/70 dark:bg-slate-900/70 text-center">
            <span class="text-2xl font-black text-blue-600 dark:text-blue-400">F</span>
            <h4 class="font-bold text-sm text-slate-900 dark:text-white mt-1">Friends</h4>
            <p class="text-[11px] text-slate-500 mt-1">Unbreakable platonic bond, shared loyalty, and mutual trust.</p>
          </div>
          <div class="p-4 rounded-2xl border border-rose-200 dark:border-rose-800 bg-white/70 dark:bg-slate-900/70 text-center">
            <span class="text-2xl font-black text-red-600 dark:text-red-400">L</span>
            <h4 class="font-bold text-sm text-slate-900 dark:text-white mt-1">Lovers</h4>
            <p class="text-[11px] text-slate-500 mt-1">Deep romantic spark, intense physical chemistry, and passion.</p>
          </div>
          <div class="p-4 rounded-2xl border border-rose-200 dark:border-rose-800 bg-white/70 dark:bg-slate-900/70 text-center">
            <span class="text-2xl font-black text-pink-600 dark:text-pink-400">A</span>
            <h4 class="font-bold text-sm text-slate-900 dark:text-white mt-1">Affection</h4>
            <p class="text-[11px] text-slate-500 mt-1">Warm emotional fondness, caring gentleness, and empathy.</p>
          </div>
          <div class="p-4 rounded-2xl border border-rose-200 dark:border-rose-800 bg-white/70 dark:bg-slate-900/70 text-center">
            <span class="text-2xl font-black text-amber-600 dark:text-amber-400">M</span>
            <h4 class="font-bold text-sm text-slate-900 dark:text-white mt-1">Marriage</h4>
            <p class="text-[11px] text-slate-500 mt-1">Generational lifelong commitment, family building, and bliss.</p>
          </div>
          <div class="p-4 rounded-2xl border border-rose-200 dark:border-rose-800 bg-white/70 dark:bg-slate-900/70 text-center">
            <span class="text-2xl font-black text-purple-600 dark:text-purple-400">E</span>
            <h4 class="font-bold text-sm text-slate-900 dark:text-white mt-1">Enemies</h4>
            <p class="text-[11px] text-slate-500 mt-1">Fiery rivalry, ego clashes, or intense growth friction.</p>
          </div>
          <div class="p-4 rounded-2xl border border-rose-200 dark:border-rose-800 bg-white/70 dark:bg-slate-900/70 text-center">
            <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400">S</span>
            <h4 class="font-bold text-sm text-slate-900 dark:text-white mt-1">Siblings</h4>
            <p class="text-[11px] text-slate-500 mt-1">Protective familial affection and humorous familiarity.</p>
          </div>
        </div>
      </section>

      <!-- Section 2: Step-by-Step Algorithm -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
          2. Step-by-Step Letter Cancellation Algorithm
        </h2>
        <div class="space-y-3 not-prose my-4">
          <div class="p-4 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-pink-200 dark:border-pink-900">
            <span class="font-bold text-xs text-pink-600 dark:text-pink-400 uppercase">Step 1</span>
            <p class="text-xs text-slate-700 dark:text-slate-300 mt-1">Write down both full names in lowercase without spaces (e.g. <code>alexandra</code> & <code>julian</code>).</p>
          </div>
          <div class="p-4 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-pink-200 dark:border-pink-900">
            <span class="font-bold text-xs text-pink-600 dark:text-pink-400 uppercase">Step 2</span>
            <p class="text-xs text-slate-700 dark:text-slate-300 mt-1">Cross out all matching letters common to both names.</p>
          </div>
          <div class="p-4 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-pink-200 dark:border-pink-900">
            <span class="font-bold text-xs text-pink-600 dark:text-pink-400 uppercase">Step 3</span>
            <p class="text-xs text-slate-700 dark:text-slate-300 mt-1">Count the total remaining uncrossed letters from both names. Let this count be <code>N</code>.</p>
          </div>
          <div class="p-4 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-pink-200 dark:border-pink-900">
            <span class="font-bold text-xs text-pink-600 dark:text-pink-400 uppercase">Step 4</span>
            <p class="text-xs text-slate-700 dark:text-slate-300 mt-1">Write out <code>F - L - A - M - E - S</code> and cycle through counting up to <code>N</code>, eliminating each landed letter until only one remains.</p>
          </div>
        </div>
      </section>
    </div>

    <!-- Related Interactive Calculator CTA -->
    <div class="mt-10 p-6 rounded-3xl bg-pink-50 dark:bg-pink-950/40 border border-pink-200 dark:border-pink-800 space-y-4">
      <h3 class="font-serif text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
        Play FLAMES instantly:
      </h3>
      <div class="flex flex-wrap gap-3">
        <a
          href="/love/flames-calculator/"
          class="px-5 py-2.5 rounded-xl bg-pink-600 text-white font-bold text-xs sm:text-sm shadow hover:bg-pink-500 transition"
        >
          🕹️ Online FLAMES Calculator
        </a>
        <a
          href="/love/crush-love-test/"
          class="px-5 py-2.5 rounded-xl bg-red-600 text-white font-bold text-xs sm:text-sm shadow hover:bg-red-500 transition"
        >
          💘 Crush Love Test
        </a>
        <a
          href="/love/guides/"
          class="px-5 py-2.5 rounded-xl border border-pink-300 dark:border-pink-700 font-bold text-xs sm:text-sm text-pink-700 dark:text-pink-300 hover:bg-pink-100 dark:hover:bg-pink-900/40 transition"
        >
          ← Back to All Guides
        </a>
      </div>
    </div>
  </article>
</Layout>

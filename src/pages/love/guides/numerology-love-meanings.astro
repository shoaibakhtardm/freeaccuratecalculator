---
// File: src/pages/love/guides/numerology-love-meanings.astro
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/common/Breadcrumbs.astro';
import RomanticBackground from '../../../components/love/RomanticBackground.astro';

const siteOrigin = 'https://freeaccuratecalculator.com';
const canonicalUrl = `${siteOrigin}/love/guides/numerology-love-meanings/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Numerology Love Meanings: Life Path Numbers & Relationship Vibrations",
  "description": "Decode the numerical vibrations between life paths 1 through 9 and Master Numbers 11, 22, 33 in love and marriage.",
  "author": {
    "@type": "Organization",
    "name": "Free Accurate Calculator"
  },
  "mainEntityOfPage": canonicalUrl
};
---

<Layout
  title="Numerology Love Meanings: Life Path Compatibility (2026)"
  description="Discover how Numerology Life Path numbers (1-9 and Master numbers) influence romantic attraction, relationship harmony, and soul contracts."
  keywords="numerology love meanings, life path compatibility, relationship numerology, numerology love matches"
  canonicalUrl={canonicalUrl}
  ogTitle="Numerology Love Meanings: Life Path Compatibility"
  ogDescription="Explore the core vibrations of each Life Path number in love and partnership."
  jsonLd={jsonLd}
>
  <RomanticBackground />

  <article class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs
      items={[
        { label: 'Love Calculators', href: '/love/' },
        { label: 'Guides', href: '/love/guides/' },
        { label: 'Numerology Love' }
      ]}
    />

    <header class="space-y-4 border-b border-rose-200/60 dark:border-rose-900/60 pb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 text-xs font-bold uppercase tracking-wider">
        <span>🔢 Numerological Dynamics</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-black text-slate-900 dark:text-white leading-tight">
        Numerology Love Meanings: <span class="bg-gradient-to-r from-red-600 via-rose-500 to-pink-500 bg-clip-text text-transparent">Life Path Synergies</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
        Understand how your birth date numbers reveal innate emotional patterns, love expressions, and karmic contracts.
      </p>
    </header>

    <div class="prose prose-rose dark:prose-invert max-w-none text-sm sm:text-base space-y-6 text-slate-700 dark:text-slate-300">
      <section class="space-y-3">
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
          How to Calculate Your Life Path Number
        </h2>
        <p>
          Add all single digits of your full birth date (Month + Day + Year) and reduce to a single digit between 1 and 9 (or keep Master Numbers 11, 22, 33 intact).
        </p>
        <div class="p-4 rounded-xl bg-rose-50/70 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 font-mono text-xs">
          Example: July 14, 1998 → 7 + (1+4) + (1+9+9+8 = 27 → 2+7 = 9) → 7 + 5 + 9 = 21 → 2+1 = Life Path 3.
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
          Natural Compatibility Pairings
        </h2>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong>The Visionaries (1, 5, 7):</strong> Need freedom, intellectual stimulation, and autonomy. High passion with mutual growth.</li>
          <li><strong>The Nurturers (2, 4, 8):</strong> Seek emotional security, family commitment, and tangible structure.</li>
          <li><strong>The Creatives (3, 6, 9):</strong> Expressive, deeply romantic, and empathetic. Thrive in high-vulnerability partnerships.</li>
        </ul>
      </section>
    </div>

    <div class="mt-8 p-6 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 space-y-4">
      <h3 class="font-serif text-lg font-bold text-slate-900 dark:text-white">
        Calculate your Numerology match now:
      </h3>
      <div class="flex flex-wrap gap-3">
        <a
          href="/numerology-love-calculator/"
          class="px-4 py-2 rounded-xl bg-purple-600 text-white font-bold text-xs shadow hover:bg-purple-500 transition"
        >
          🔢 Numerology Love Calculator
        </a>
        <a
          href="/birth-date-love-compatibility/"
          class="px-4 py-2 rounded-xl bg-rose-600 text-white font-bold text-xs shadow hover:bg-rose-500 transition"
        >
          🎂 Birth Date Love Match
        </a>
      </div>
    </div>
  </article>
</Layout>

        <a
          href="/love/blog/love-compatibility-tips/"
          class="group p-4 rounded-2xl border border-rose-200/70 dark:border-rose-800/70 bg-white/70 dark:bg-slate-900/70 backdrop-blur-md hover:border-rose-400 transition-all duration-200 hover:-translate-y-0.5 shadow-xs space-y-2 flex flex-col justify-between transform-gpu"
        >
          <div class="space-y-1.5">
            <span class="text-2xl">💡</span>
            <h4 class="font-serif text-xs sm:text-sm font-bold text-slate-900 dark:text-white group-hover:text-rose-600 transition-colors">
              10 Compatibility Tips
            </h4>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2">
              Gottman-backed connection habits and emotional attunement.
            </p>
          </div>
          <span class="text-[11px] font-semibold text-rose-600 dark:text-rose-400">Read Tips →</span>
        </a>
      </div>
    </section>

    <!-- FAQS ACCORDION SECTION (Ultra-Smooth CSS Grid Expansion) -->
    <section class="rounded-3xl border border-rose-200/80 dark:border-rose-900/60 bg-white/75 dark:bg-slate-900/75 p-6 sm:p-9 space-y-6 shadow-sm dark:shadow-xl backdrop-blur-xl">
      <div class="flex items-center gap-3 border-b border-rose-200/80 dark:border-rose-800/80 pb-4">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 text-lg font-bold">
          💬
        </span>
        <div>
          <h2 class="font-outfit text-base sm:text-lg font-bold text-slate-900 dark:text-white">
            Frequently Asked Questions About Love &amp; Compatibility
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Clear mathematical, astrological, and psychological answers to help you understand your results
          </p>
        </div>
      </div>

      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-rose-200/80 dark:border-rose-800/80 bg-rose-50/40 dark:bg-slate-800/40 p-4 transition-colors duration-200 open:bg-white dark:open:bg-slate-850">
            <summary class="flex cursor-pointer items-center justify-between font-outfit text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100 list-none select-none">
              <span>{faq.question}</span>
              <span class="text-xs text-rose-600 dark:text-rose-400 transition-transform duration-200 group-open:rotate-180 transform-gpu">▼</span>
            </summary>
            <div class="grid grid-rows-[0fr] transition-all duration-200 ease-out group-open:grid-rows-[1fr]">
              <div class="overflow-hidden">
                <p class="pt-3 text-[11px] sm:text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                  {faq.answer}
                </p>
              </div>
            </div>
          </details>
        ))}
      </div>
    </section>

  </div>

  <!-- Confetti Canvas for Cosmic Celebration -->
  <canvas id="love-confetti-canvas" class="pointer-events-none fixed inset-0 z-50 w-full h-full hidden transform-gpu"></canvas>

  <!-- ADVANCED GPU-ACCELERATED CSS ANIMATIONS -->
  <style is:inline>
    /* 1. Hero Section Entrance */
    .hero-section {
      animation: heroFadeInUp 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes heroFadeInUp {
      from { opacity: 0; transform: translate3d(0, 16px, 0); }
      to { opacity: 1; transform: translate3d(0, 0, 0); }
    }

    /* 2. Calculator Cards Capped Staggered Entrance */
    .calculator-card {
      opacity: 0;
      animation: cardEntrance 0.32s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
      transform: translate3d(0, 0, 0);
    }
    .card-index-1 { animation-delay: 0.015s; }
    .card-index-2 { animation-delay: 0.030s; }
    .card-index-3 { animation-delay: 0.045s; }
    .card-index-4 { animation-delay: 0.060s; }
    .card-index-5 { animation-delay: 0.075s; }
    .card-index-6 { animation-delay: 0.090s; }
    .card-index-7 { animation-delay: 0.105s; }
    .card-index-8 { animation-delay: 0.120s; }
    .card-index-9 { animation-delay: 0.135s; }
    .card-index-10 { animation-delay: 0.150s; }
    .card-index-11 { animation-delay: 0.165s; }
    .card-index-12 { animation-delay: 0.180s; }
    .card-index-13 { animation-delay: 0.195s; }
    .card-index-14 { animation-delay: 0.210s; }
    .card-index-15 { animation-delay: 0.225s; }
    .card-index-16 { animation-delay: 0.240s; }
    .card-index-17 { animation-delay: 0.250s; }
    .card-index-18 { animation-delay: 0.250s; }
    .card-index-19 { animation-delay: 0.250s; }
    .card-index-20 { animation-delay: 0.250s; }
    .card-index-21 { animation-delay: 0.250s; }

    @keyframes cardEntrance {
      from {
        opacity: 0;
        transform: translate3d(0, 14px, 0) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translate3d(0, 0, 0) scale(1);
      }
    }

    /* 3. Subtle Card Hover Lift */
    .calculator-card:hover {
      transform: translate3d(0, -4px, 0) scale(1.015);
      box-shadow: 0 10px 24px rgba(244, 63, 94, 0.18);
    }

    /* 4. Heartbeat pulse */
    @keyframes heartBeatPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.2); }
    }
    .heart-beat-icon {
      display: inline-block;
      animation: heartBeatPulse 1s ease-in-out infinite;
    }

    /* 5. Reduced Motion Rules */
    @media (prefers-reduced-motion: reduce) {
      .hero-section,
      .calculator-card,
      .heart-beat-icon,
      .animate-bounce,
      .animate-pulse,
      .animate-fade-in {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
      .calculator-card {
        transition: none !important;
      }
      .calculator-card:hover {
        transform: none !important;
        box-shadow: none !important;
      }
    }
  </style>

  <!-- CLIENT-SIDE SCRIPT (Optimized 60/120 FPS Interactions) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Real-Time Directory Search Filter
      const searchInput = document.getElementById('love-directory-search');
      const cards = document.querySelectorAll('.love-item-card');
      const countBadge = document.getElementById('love-search-counter');
      const noResults = document.getElementById('love-no-results');

      searchInput?.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let visibleCount = 0;

        cards.forEach((card) => {
          const text = card.getAttribute('data-search') || '';
          if (!query || text.includes(query)) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (countBadge) {
          countBadge.textContent = `${visibleCount} Calculators`;
        }
        if (noResults) {
          noResults.classList.toggle('hidden', visibleCount > 0);
        }
      });

      // 2. High-Performance Confetti Particle Explosion
      function triggerLoveConfetti() {
        if (prefersReducedMotion) return;
        const canvas = document.getElementById('love-confetti-canvas');
        if (!canvas) return;
        canvas.classList.remove('hidden');
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        const isMobile = window.innerWidth < 768;
        const particleCount = isMobile ? 35 : 55;
        const particles = [];
        const colors = ['#f43f5e', '#ec4899', '#ef4444', '#fb7185', '#fda4af', '#fbbf24'];

        for (let i = 0; i < particleCount; i++) {
          particles.push({
            x: canvas.width / 2 + (Math.random() - 0.5) * 80,
            y: canvas.height / 2 + (Math.random() - 0.5) * 40,
            r: Math.random() * 4 + 2.5,
            color: colors[Math.floor(Math.random() * colors.length)],
            vx: (Math.random() - 0.5) * 12,
            vy: (Math.random() - 0.85) * 14,
            gravity: 0.32,
            opacity: 1,
            rotation: Math.random() * 360,
            vRot: (Math.random() - 0.5) * 8
          });
        }

        let animFrame;
        function renderConfetti() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          let active = false;

          for (let i = 0; i < particles.length; i++) {
            const p = particles[i];
            p.x += p.vx;
            p.y += p.vy;
            p.vy += p.gravity;
            p.opacity -= 0.015;
            p.rotation += p.vRot;

            if (p.opacity > 0) {
              active = true;
              ctx.save();
              ctx.translate(p.x, p.y);
              ctx.rotate((p.rotation * Math.PI) / 180);
              ctx.globalAlpha = p.opacity;
              ctx.fillStyle = p.color;
              ctx.beginPath();
              ctx.arc(0, 0, p.r, 0, Math.PI * 2);
              ctx.fill();
              ctx.restore();
            }
          }

          if (active) {
            animFrame = requestAnimationFrame(renderConfetti);
          } else {
            cancelAnimationFrame(animFrame);
            canvas.classList.add('hidden');
          }
        }
        renderConfetti();
      }

      // 3. Hero Quick Calculator Form with Hardware-Accelerated Progress Animation
      const quickForm = document.getElementById('hero-quick-calc-form');
      const quickP1 = document.getElementById('hero-quick-p1');
      const quickP2 = document.getElementById('hero-quick-p2');
      const quickBtn = document.getElementById('hero-calculate-btn');
      const quickResult = document.getElementById('hero-quick-result');
      const quickNames = document.getElementById('hero-quick-names');
      const quickScore = document.getElementById('hero-quick-score');
      const quickBar = document.getElementById('hero-quick-bar');

      quickForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const p1 = quickP1.value.trim();
        const p2 = quickP2.value.trim();
        if (!p1 || !p2) return;

        // Button Loading State
        const originalBtnText = quickBtn.innerHTML;
        quickBtn.disabled = true;
        quickBtn.innerHTML = `
          <span class="heart-beat-icon">💓</span>
          <span>Analyzing Cosmic Alignment...</span>
        `;

        setTimeout(() => {
          const combined = (p1 + p2).toLowerCase().replace(/[^a-z0-9]/g, '');
          let hash = 0;
          for (let i = 0; i < combined.length; i++) {
            hash = (hash << 5) - hash + combined.charCodeAt(i);
            hash |= 0;
          }
          const score = Math.abs(hash) % 32 + 68; // 68% - 99%

          quickBtn.disabled = false;
          quickBtn.innerHTML = originalBtnText;

          quickNames.textContent = `${p1} & ${p2}`;
          quickScore.textContent = `${score}%`;
          quickResult.classList.remove('hidden');
          if (quickBar) {
            quickBar.style.transform = 'scaleX(0)';
            requestAnimationFrame(() => {
              quickBar.style.transform = `scaleX(${score / 100})`;
            });
          }

          triggerLoveConfetti();
        }, 750);
      });

      // 4. Share with Partner CTA
      const shareBtn = document.getElementById('hero-share-partner-btn');
      shareBtn?.addEventListener('click', () => {
        const shareUrl = window.location.href;
        const shareText = `Check our love compatibility score on Free Accurate Calculator! 💖 ${shareUrl}`;
        if (navigator.share) {
          navigator.share({ title: 'Love Calculator Match', text: shareText, url: shareUrl }).catch(() => {});
        } else {
          navigator.clipboard.writeText(shareText);
          shareBtn.innerHTML = '<span>✅ Link Copied to Clipboard!</span>';
          setTimeout(() => {
            shareBtn.innerHTML = '<span>💌 Share Results with Partner</span>';
          }, 2500);
        }
      });
    });
  </script>
</Layout>

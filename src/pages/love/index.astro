            </div>
            <p id="hero-quick-verdict" class="text-[11px] text-slate-600 dark:text-slate-300 font-medium">
              🌟 Exceptional romantic resonance!
            </p>
          </div>
        </div>

        <!-- COSMIC SEARCH ORB (3D Glowing Globe, Voice Search & Predictive Fuzzy Autocomplete) -->
        <CosmicSearchOrb />

      </div>
    </section>

    <!-- STRICT 3-BY-3 GRID DIRECTORY OF ALL 21 CALCULATORS -->
    <section class="space-y-4 sm:space-y-5" aria-label="21 Love Calculators Directory">
      
      <div class="flex items-center justify-between border-b border-rose-200/80 dark:border-rose-800/80 pb-3">
        <div class="flex items-center gap-2">
          <span class="text-2xl animate-pulse">💖</span>
          <h2 class="font-outfit text-sm sm:text-base md:text-lg font-black uppercase tracking-[0.15em] text-slate-900 dark:text-white">
            All 21 Love Calculators
          </h2>
        </div>
        <a
          href="/"
          class="inline-flex items-center gap-1 text-xs font-semibold text-rose-600 dark:text-rose-400 hover:underline transition-colors"
        >
          <span>← All Categories</span>
        </a>
      </div>

      <!-- THE 3-BY-3 GRID (Strict 3 Columns on Mobile, Tablet & Desktop) -->
      <div
        id="love-calculators-grid"
        class="grid grid-cols-3 gap-2 sm:gap-3.5 md:gap-4.5"
      >
        <!-- No Results Msg -->
        <div
          id="love-no-results"
          class="hidden col-span-3 w-full py-12 px-4 text-center rounded-2xl border border-dashed border-rose-300 dark:border-rose-800 bg-rose-50/40 dark:bg-slate-900/40"
        >
          <span class="text-4xl mb-2 inline-block">💔</span>
          <h3 class="font-serif text-base font-bold text-slate-800 dark:text-slate-200">
            No matching love calculators found
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            Try searching for "Name", "Zodiac", "Kundli", "FLAMES", or "Tarot".
          </p>
        </div>

        {ROMANTIC_CALCULATORS.map((calc, index) => (
          <a
            href={calc.href}
            title={`${calc.name} - ${calc.description}`}
            class={`calculator-card love-item-card card-index-${index + 1} group relative flex flex-col items-center justify-between text-center min-w-0 min-h-[120px] sm:min-h-[160px] md:min-h-[180px] rounded-2xl border border-rose-200/80 dark:border-rose-900/60 bg-white/85 dark:bg-slate-900/85 hover:bg-rose-50/50 dark:hover:bg-slate-800/90 hover:border-red-500/70 p-2.5 sm:p-4 md:p-5 shadow-2xs active:scale-[0.98] cursor-pointer transform-gpu`}
            data-search={`${calc.name} ${calc.keyword} ${calc.description} ${calc.shortName}`.toLowerCase()}
          >
            <!-- Top Icon Emblem with Romantic Hover Glow -->
            <div class="flex h-9 w-9 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200/80 dark:border-rose-800/80 text-lg sm:text-2xl shadow-2xs group-hover:scale-110 group-hover:border-red-400 transition-transform duration-200 transform-gpu" role="img" aria-label={`${calc.name} icon`}>
              {calc.romanticIcon}
            </div>

            <!-- Title & 50-Word SEO Description Section -->
            <div class="my-1.5 w-full min-w-0 px-0.5 flex flex-col items-center justify-center gap-1">
              <span class="inline-block text-[10px] sm:text-[11px] font-bold text-rose-600 dark:text-rose-400 uppercase tracking-wider select-none leading-none">
                {calc.shortName}
              </span>
              <h3 class="font-outfit text-[11.5px] sm:text-xs md:text-sm font-bold text-slate-800 dark:text-slate-100 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors line-clamp-2 leading-tight">
                {calc.name}
              </h3>
              <p class="hidden md:line-clamp-2 text-[10.5px] text-slate-500 dark:text-slate-400 leading-snug">
                {calc.description}
              </p>
            </div>

            <!-- Bottom Badge & Action Button -->
            <div class="flex flex-col items-center justify-center w-full gap-1.5">
              <span class="inline-flex items-center px-1.5 sm:px-2 py-0.5 text-[9px] sm:text-[10px] md:text-[11px] font-mono font-bold rounded-md bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 border border-rose-200/60 dark:border-rose-900/60 truncate max-w-full">
                {calc.volume}/mo
              </span>
              <span class="text-[10px] sm:text-[11px] font-bold text-rose-600 dark:text-rose-400 group-hover:underline flex items-center gap-0.5">
                <span>Calculate Match 💕</span>
                <span class="text-xs transition-transform duration-150 group-hover:translate-x-0.5 transform-gpu">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- EDUCATIONAL ROMANCE SECTION -->
    <section class="rounded-3xl border border-rose-200/80 dark:border-rose-900/60 bg-white/75 dark:bg-slate-900/75 p-6 sm:p-9 space-y-6 shadow-sm dark:shadow-xl backdrop-blur-xl">
      <div class="flex items-center gap-3 border-b border-rose-200/80 dark:border-rose-800/80 pb-4">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 text-lg font-bold">
          🌹
        </span>
        <div>
          <h2 class="font-outfit text-base sm:text-lg font-bold text-slate-900 dark:text-white">
            Why Use Free Accurate Love Calculators?
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Engineered for algorithmic accuracy, psychometric reliability, and 100% private in-browser execution
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div class="space-y-2 p-4 rounded-2xl bg-rose-50/60 dark:bg-slate-800/50 border border-rose-200/60 dark:border-slate-700/60 transition-transform duration-200 hover:-translate-y-0.5 transform-gpu">
          <div class="text-xl">🔒</div>
          <h3 class="font-outfit text-xs sm:text-sm font-bold text-slate-900 dark:text-white">100% Client-Side Privacy</h3>
          <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            All computations execute strictly in your local browser memory. Zero data or names are ever uploaded to any server.
          </p>
        </div>

        <div class="space-y-2 p-4 rounded-2xl bg-rose-50/60 dark:bg-slate-800/50 border border-rose-200/60 dark:border-slate-700/60 transition-transform duration-200 hover:-translate-y-0.5 transform-gpu">
          <div class="text-xl">⚡</div>
          <h3 class="font-outfit text-xs sm:text-sm font-bold text-slate-900 dark:text-white">Zero-Latency Algorithmic Engines</h3>
          <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Instant calculations using verified mathematical gematria, Vedic Ashtakoota ephemeris, and psychometric reciprocity models.
          </p>
        </div>

        <div class="space-y-2 p-4 rounded-2xl bg-rose-50/60 dark:bg-slate-800/50 border border-rose-200/60 dark:border-slate-700/60 transition-transform duration-200 hover:-translate-y-0.5 transform-gpu">
          <div class="text-xl">💎</div>
          <h3 class="font-outfit text-xs sm:text-sm font-bold text-slate-900 dark:text-white">21 Specialized Romantic Suites</h3>
          <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            From ancient Chinese & Western Zodiacs to modern AI psychological predictions and classic nostalgic FLAMES games.
          </p>
        </div>
      </div>
    </section>

    <!-- ROMANTIC GUIDES & RESOURCE VAULT -->
    <section class="space-y-4" aria-label="Love Guides and Educational Articles">
      <div class="flex items-center justify-between border-b border-rose-200/80 dark:border-rose-800/80 pb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">📚</span>

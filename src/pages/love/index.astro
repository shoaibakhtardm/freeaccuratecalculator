---
// File: src/pages/love/index.astro
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import RomanticBackground from '../../components/love/RomanticBackground.astro';
import CosmicSearchOrb from '../../components/love/CosmicSearchOrb.astro';
import { LOVE_CALCULATORS } from '../../data/loveCalculators';
import { SEARCHABLE_CALCULATORS } from '../../data/searchDatabase';

const allSearchableToolsJson = JSON.stringify(SEARCHABLE_CALCULATORS);

// Curated Ultra-Romantic Emoji Mapping & Meta
const ROMANTIC_CALCULATORS = LOVE_CALCULATORS.map((calc) => {
  let romanticIcon = calc.icon;
  if (calc.slug === 'love-calculator-by-name') romanticIcon = '🌹';
  else if (calc.slug === 'marriage-compatibility-calculator') romanticIcon = '💍';
  else if (calc.slug === 'zodiac-love-compatibility-calculator') romanticIcon = '✨';
  else if (calc.slug === 'true-love-calculator-by-names') romanticIcon = '💖';
  else if (calc.slug === 'crush-love-test-calculator') romanticIcon = '💘';
  else if (calc.slug === 'birth-date-love-compatibility') romanticIcon = '🎂';
  else if (calc.slug === 'relationship-compatibility-test') romanticIcon = '🧠';
  else if (calc.slug === 'prank-love-calculator') romanticIcon = '🎭';
  else if (calc.slug === 'twin-flame-calculator') romanticIcon = '🔥';
  else if (calc.slug === 'soulmate-name-calculator') romanticIcon = '💫';
  else if (calc.slug === 'flames-calculator') romanticIcon = '🕹️';
  else if (calc.slug === 'numerology-love-calculator') romanticIcon = '🔢';
  else if (calc.slug === 'ai-love-calculator') romanticIcon = '🤖';
  else if (calc.slug === 'celebrity-love-calculator') romanticIcon = '🎬';
  else if (calc.slug === 'chinese-zodiac-love-calculator') romanticIcon = '🐉';
  else if (calc.slug === 'friendship-to-love-calculator') romanticIcon = '🤝';
  else if (calc.slug === 'breakup-compatibility-calculator') romanticIcon = '💔';
  else if (calc.slug === 'love-language-compatibility') romanticIcon = '🗣️';
  else if (calc.slug === 'tarot-love-calculator') romanticIcon = '🔮';
  else if (calc.slug === 'wedding-date-predictor-calculator') romanticIcon = '💒';
  else if (calc.slug === 'couple-nickname-generator-match') romanticIcon = '🎀';

  return {
    ...calc,
    romanticIcon,
    href: `/love/${calc.slug}/`,
  };
});

const faqs = [
  {
    question: "How do our 21 Love Calculators compute compatibility?",
    answer: "Every calculator is engineered with verified romantic algorithms—ranging from phonetic acoustic harmonics for names, ancient Vedic Ashtakoota Guna Milan for marriage, and elemental aspects for Zodiac signs to psychometric reciprocity models."
  },
  {
    question: "Are our names and calculations completely private?",
    answer: "Yes, 100%. All computations execute purely within your local device memory. No names, birth dates, or romantic results are ever uploaded to any server."
  },
  {
    question: "Can I share pre-filled test links with my partner or crush?",
    answer: "Yes! Each dedicated calculator page includes a 1-Click WhatsApp share and pre-filled invitation link so your partner can open the test with your name already aligned."
  },
  {
    question: "Is there any limit to how many couples I can calculate?",
    answer: "None at all. All 21 romantic calculators are completely free with zero usage limits or subscriptions."
  }
];

const loveHubSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://freeaccuratecalculator.com/love/#collection",
      "url": "https://freeaccuratecalculator.com/love/",
      "name": "Love Calculators Hub — 21 Accurate & Free Romance Tests",
      "description": "Discover your true love percentage, Vedic Kundli marriage score, and zodiac synergy with 21 specialized love calculators.",
      "publisher": {
        "@type": "Organization",
        "name": "Free Accurate Calculator",
        "url": "https://freeaccuratecalculator.com/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://freeaccuratecalculator.com/favicon.svg"
        }
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://freeaccuratecalculator.com/love/#faq",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    }
  ]
};
---

<Layout
  title="Love Calculators Hub: 21 Free & Accurate Romantic Compatibility Tests"
  metaDescription="Discover your romantic destiny with 21 elite love calculators. Test name compatibility, Vedic marriage Kundli, zodiac synergy, FLAMES, tarot, and numerology instantly."
  canonicalUrl="https://freeaccuratecalculator.com/love/"
  jsonLd={loveHubSchema}
>
  <!-- ULTRA-ELITE 3D SWIRLING ROSE PETALS + ROTATING RED HEARTS CANVAS BACKGROUND -->
  <RomanticBackground />

  <div class="relative z-10 max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-6 space-y-8 sm:space-y-10">
    
    <!-- Breadcrumbs Navigation -->
    <Breadcrumbs
      items={[
        { label: 'Love Calculators' }
      ]}
    />

    <!-- ULTRA-ROMANTIC HERO SECTION -->
    <section class="hero-section relative overflow-hidden rounded-3xl sm:rounded-[36px] border border-rose-200/80 dark:border-rose-900/60 bg-white/75 dark:bg-slate-950/80 px-4 py-8 sm:py-12 md:py-14 text-center shadow-xs sm:shadow-xl backdrop-blur-xl transform-gpu">
      
      <div class="relative z-10 mx-auto max-w-2xl sm:max-w-3xl lg:max-w-4xl space-y-4 sm:space-y-6">
        
        <!-- Romantic Pill Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-rose-300 dark:border-rose-700/60 bg-gradient-to-r from-rose-500/15 via-red-500/15 to-purple-500/15 px-4 py-1.5 shadow-2xs backdrop-blur-md select-none transform-gpu">
          <span class="text-base animate-bounce">🌹</span>
          <span class="font-outfit text-[11px] sm:text-xs font-bold tracking-widest uppercase text-rose-700 dark:text-rose-300">
            21 Verified Romantic Testing Suites
          </span>
          <span class="text-rose-500 dark:text-rose-400 text-xs font-bold">✦</span>
        </div>

        <!-- Main Romantic Headline (Exact H1) -->
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-[54px] font-black tracking-tight text-slate-900 dark:text-white leading-[1.15] sm:leading-[1.1] text-balance">
          Discover Your <span class="bg-gradient-to-r from-red-600 via-rose-500 to-pink-500 dark:from-rose-400 dark:via-red-400 dark:to-pink-300 bg-clip-text text-transparent italic">Cosmic &amp; Romantic</span> Synergy - 21 Free Love Calculators
        </h1>

        <!-- 300-Word SEO Rich Keyword Introduction -->
        <div class="font-sans text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed text-left sm:text-justify space-y-3 px-2">
          <p>
            Welcome to the internet's most accurate and comprehensive suite of <strong>21 free love calculators</strong>. Whether you are curious about your <strong>love calculator by name</strong> compatibility, seeking ancient Vedic <strong>kundli matching</strong> for marriage, or analyzing celestial aspects with our <strong>zodiac compatibility calculator</strong>, our deterministic engines provide instant, reliable clarity. We combine classical Pythagorean gematria, acoustic phonetic frequencies, planetary ephemeris tables (calibrated with <a href="https://ssd.jpl.nasa.gov/" target="_blank" rel="noopener noreferrer" class="text-rose-600 dark:text-rose-400 underline hover:text-rose-700">NASA JPL ephemeris standards</a> and <a href="https://www.astrology.com" target="_blank" rel="noopener noreferrer" class="text-rose-600 dark:text-rose-400 underline hover:text-rose-700">astrological synastry</a>), and modern psychometric models endorsed by <a href="https://www.gottman.com" target="_blank" rel="noopener noreferrer" class="text-rose-600 dark:text-rose-400 underline hover:text-rose-700">relationship science researchers</a>.
          </p>
          <p>
            Explore your secret romantic destiny with our viral <strong>crush love test</strong>, measure karmic soul connections through the <strong>twin flame calculator</strong>, or replay nostalgic playground romance with the authentic <strong>FLAMES calculator</strong>. Every calculation runs <em>100% privately in your local browser memory</em>—guaranteeing that your names, birth dates, and results are never stored or transmitted to external servers.
          </p>
        </div>

        <!-- 3 Call-To-Action (CTA) Cluster -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <a
            href="#hero-quick-calc-form"
            class="calculate-cta-btn px-6 py-3 rounded-xl bg-gradient-to-r from-red-600 via-rose-600 to-pink-600 hover:from-red-500 hover:to-pink-500 text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-lg hover:scale-[1.02] active:scale-95 transition-all duration-200 flex items-center gap-2 transform-gpu"
          >
            <span>❤️ Calculate Your Love Now</span>
          </a>
          <button
            id="hero-share-partner-btn"
            type="button"
            class="px-5 py-3 rounded-xl border border-rose-300 dark:border-rose-700 bg-rose-50/80 dark:bg-rose-950/60 hover:bg-rose-100 dark:hover:bg-rose-900/60 hover:scale-[1.01] active:scale-95 text-rose-700 dark:text-rose-300 font-bold text-xs sm:text-sm shadow-xs transition-all duration-200 flex items-center gap-2 cursor-pointer transform-gpu"
          >
            <span>💌 Share Results with Partner</span>
          </button>
          <a
            href="#love-calculators-grid"
            class="px-5 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white/60 dark:bg-slate-900/60 hover:bg-slate-100 dark:hover:bg-slate-800 hover:scale-[1.01] active:scale-95 text-slate-700 dark:text-slate-300 font-bold text-xs sm:text-sm shadow-xs transition-all duration-200 flex items-center gap-1.5 transform-gpu"
          >
            <span>✨ Explore All 21 Tests ↓</span>
          </a>
        </div>

        <!-- INSTANT QUICK-TEST HERO WIDGET -->
        <div class="max-w-lg mx-auto p-4 sm:p-5 rounded-2xl border border-rose-300/80 dark:border-rose-800/80 bg-gradient-to-r from-rose-500/10 via-red-500/10 to-pink-500/10 backdrop-blur-md shadow-md">
          <form id="hero-quick-calc-form" class="space-y-3" autocomplete="off">
            <div class="grid grid-cols-2 gap-2.5">
              <input
                id="hero-quick-p1"
                type="text"
                required
                placeholder="Your Name 💖"
                class="w-full text-xs sm:text-sm px-3.5 py-2.5 rounded-xl border border-rose-200 dark:border-rose-700 bg-white/90 dark:bg-slate-900/90 text-slate-900 dark:text-white placeholder-slate-400 focus:border-red-500 outline-none transition-colors duration-150"
              />
              <input
                id="hero-quick-p2"
                type="text"
                required
                placeholder="Partner / Crush 💘"
                class="w-full text-xs sm:text-sm px-3.5 py-2.5 rounded-xl border border-rose-200 dark:border-rose-700 bg-white/90 dark:bg-slate-900/90 text-slate-900 dark:text-white placeholder-slate-400 focus:border-red-500 outline-none transition-colors duration-150"
              />
            </div>
            <button
              id="hero-calculate-btn"
              type="submit"
              class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-red-600 via-rose-600 to-red-600 hover:from-red-500 hover:to-rose-500 text-white font-bold text-xs shadow-md transition-all duration-150 active:scale-95 flex items-center justify-center gap-2 cursor-pointer transform-gpu"
            >
              <span>❤️ Test Instant Chemistry</span>
            </button>
          </form>

          <!-- Quick Result Banner -->
          <div id="hero-quick-result" class="hidden mt-3 pt-3 border-t border-rose-300/60 dark:border-rose-800/60 text-center animate-fade-in space-y-2">
            <div class="flex items-center justify-center gap-2">
              <span class="text-xs font-bold text-slate-700 dark:text-slate-200" id="hero-quick-names">Alex & Taylor</span>
              <span class="font-mono text-xl font-black text-rose-600 dark:text-rose-400" id="hero-quick-score">96%</span>
            </div>
            <div class="w-full h-2.5 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden p-0.5">

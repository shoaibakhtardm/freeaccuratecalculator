---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';

const popularCategories = [
  { name: 'Finance Calculators', href: '/finance/', icon: '💰', count: '38+ tools' },
  { name: 'Math & Algebra', href: '/math/', icon: '📐', count: '10+ tools' },
  { name: 'Health & Fitness', href: '/health/', icon: '❤️', count: '10+ tools' },
  { name: 'Business & Real Estate', href: '/business/', icon: '📊', count: '30+ tools' },
  { name: 'France Calculators', href: '/countries/france/', icon: '🇫🇷', count: '15+ tools' },
  { name: 'Guides & Articles', href: '/guides/', icon: '📚', count: '50+ articles' },
];
---

<Layout
  title="404: Page Not Found | Free Accurate Calculator"
  description="The calculator or page you are looking for does not exist or has been moved. Explore our 1900+ free and accurate online calculators."
  noindex={true}
>
  <main class="min-h-[70vh] flex items-center justify-center px-4 py-16">
    <div class="max-w-2xl w-full text-center space-y-8">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-indigo-50 dark:bg-indigo-950/50 border border-indigo-200 dark:border-indigo-800 text-indigo-600 dark:text-indigo-400 text-3xl font-black shadow-sm">
        404
      </div>

      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
          Page or Calculator Not Found
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-lg mx-auto">
          The requested URL does not exist or has been moved to a new permanent location. Explore our verified calculation engines below:
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm shadow-md transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Back to Homepage
        </a>
        <a
          href="/finance/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold text-sm border border-slate-200 dark:border-slate-700 transition-colors"
        >
          Browse All Calculators
        </a>
      </div>

      <!-- Category Shortcuts -->
      <div class="pt-8 border-t border-slate-200 dark:border-slate-800 text-left">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4 text-center">
          Popular Calculation Categories
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {popularCategories.map((cat) => (
            <a
              href={cat.href}
              class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 hover:border-indigo-400 dark:hover:border-indigo-600 hover:shadow-sm transition-all group"
            >
              <span class="text-2xl">{cat.icon}</span>
              <div>
                <div class="text-sm font-semibold text-slate-800 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                  {cat.name}
                </div>
                <div class="text-xs text-slate-500 dark:text-slate-400">{cat.count}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>
</Layout>

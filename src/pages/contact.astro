---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
---

<Layout
  title="Contact Us"
  description="Contact the Free Accurate Calculator engineering and editorial team. Submit formula feedback, request new calculators, or report calculation discrepancies."
>
  <div class="max-w-2xl mx-auto">
    <Breadcrumbs items={[{ label: 'Contact Us' }]} />

    <div class="space-y-3 mb-8">
      <span class="mono-eyebrow text-link">Get In Touch</span>
      <h1 class="heading-lg text-ink">Contact the Engineering Team</h1>
      <p class="text-sm text-body">
        Have feedback, a feature request, or spotted a mathematical edge case? We review inquiries continuously.
      </p>
    </div>

    <div class="rounded-[12px] border border-hairline bg-canvas-elevated p-6 sm:p-8 shadow-whisper space-y-6">
      <form id="contact-form" class="space-y-4">
        <div>
          <label for="contact-name" class="block text-xs font-semibold text-ink uppercase font-mono mb-1">
            Your Name
          </label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            placeholder="Jane Doe"
            class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas px-3 py-2.5 text-base sm:text-sm text-ink placeholder-faint focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
          />
        </div>

        <div>
          <label for="contact-email" class="block text-xs font-semibold text-ink uppercase font-mono mb-1">
            Email Address
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            placeholder="jane@example.com"
            class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas px-3 py-2.5 text-base sm:text-sm text-ink placeholder-faint focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
          />
        </div>

        <div>
          <label for="contact-subject" class="block text-xs font-semibold text-ink uppercase font-mono mb-1">
            Topic / Category
          </label>
          <select
            id="contact-subject"
            name="subject"
            class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas px-3 py-2.5 text-base sm:text-sm text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
          >
            <option value="formula-discrepancy">Mathematical Formula or Edge Case Report</option>
            <option value="calculator-request">Request a New Calculator</option>
            <option value="advertising">Advertising & Partnerships</option>
            <option value="general">General Inquiry</option>
          </select>
        </div>

        <div>
          <label for="contact-message" class="block text-xs font-semibold text-ink uppercase font-mono mb-1">
            Detailed Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            placeholder="Please include calculator URL and specific input values if reporting a discrepancy..."
            class="w-full rounded-[6px] border border-hairline bg-canvas px-3 py-2.5 text-base sm:text-sm text-ink placeholder-faint focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full sm:w-auto min-h-[44px] inline-flex items-center justify-center rounded-[6px] bg-primary px-6 py-2.5 text-xs font-semibold uppercase tracking-wide text-on-primary hover:opacity-90 transition-opacity cursor-pointer shadow-whisper"
        >
          Send Message
        </button>
      </form>

      <div id="contact-success" class="hidden rounded-[6px] border border-cyan/30 bg-cyan/10 p-4 text-xs text-ink">
        ✓ Thank you for contacting Free Accurate Calculator! Your inquiry has been logged and our team will review it shortly.
      </div>

      <div class="pt-6 border-t border-hairline space-y-2">
        <h2 class="mono-eyebrow text-mute">Direct Correspondence</h2>
        <p class="text-xs text-body leading-relaxed">
          For formal privacy inquiries, legal requests, or publisher communications, reach us directly at:
          <span class="font-mono text-ink font-semibold">contact@freeaccuratecalculator.com</span>
        </p>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const successBox = document.getElementById('contact-success');
  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.classList.add('hidden');
      successBox.classList.remove('hidden');
    });
  }
</script>

---

<Layout
  title="Free Accurate Calculator — Fast, Precision Online Calculators"
  description="Free Accurate Calculator delivers industrial-grade, mathematically verified online calculators for Finance, Health, Math, and Everyday calculations with zero cold start and instant local privacy."
  jsonLd={[websiteSchema, organizationSchema]}
>
  <!-- [STARTUP HERO SECTION]: Silicon Valley Precision Layout -->
  <section class="relative overflow-hidden rounded-3xl sm:rounded-[36px] border border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-slate-950/70 px-4 py-10 sm:py-16 md:py-20 text-center hero-mesh-gradient shadow-xs sm:shadow-lg backdrop-blur-xl">
    <!-- Top Ambient Studio Glow (Linear / Vercel style) -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 sm:w-[540px] h-44 sm:h-64 bg-gradient-to-b from-indigo-500/20 via-blue-500/10 to-transparent blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto max-w-3xl space-y-5 sm:space-y-6">
      <!-- 1. The Startup Pill Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/20 dark:border-indigo-400/30 bg-gradient-to-r from-blue-500/8 via-indigo-500/8 to-purple-500/8 dark:from-blue-500/15 dark:via-indigo-500/15 dark:to-purple-500/15 px-3.5 py-1.5 shadow-2xs backdrop-blur-md transition-all hover:border-indigo-500/40 select-none">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-outfit text-[11px] sm:text-xs font-bold tracking-wider uppercase text-slate-700 dark:text-slate-200">
          International Edition 2.0
        </span>
        <span class="text-indigo-500 dark:text-indigo-400 text-xs font-bold ml-0.5">✦</span>
      </div>

      <!-- 2. The Main H1 Headline: Outfit Font, Startup Rhythm & Gradient -->
      <h1 class="display-hero font-outfit text-3xl sm:text-5xl lg:text-[56px] xl:text-[62px] font-black tracking-[-0.035em] text-slate-900 dark:text-white leading-[1.12] sm:leading-[1.08] text-balance">
        Calculations Done Right. <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-blue-600 via-indigo-600 via-purple-600 to-pink-500 dark:from-blue-400 dark:via-indigo-300 dark:to-purple-300 bg-clip-text text-transparent">
          Fast, Accurate & Clean.
        </span>
      </h1>

      <!-- 3. Subtitle Paragraph: Refined Typography & Balanced Width -->
      <p class="font-sans text-sm sm:text-base md:text-[17px] text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal text-balance px-2">
        High-precision mathematical calculators with zero clutter, verified formulas, and instant edge calculation. Engineered for global finance, health, and science.
      </p>

      <!-- 4. Spotlight Search Bar (Raycast / Linear Command-Bar Style) -->
      <div class="pt-2 max-w-xl mx-auto">
        <div class="relative flex items-center group">
          <!-- Ambient Focus Glow Ring -->
          <div
            class="absolute -inset-1 rounded-2xl sm:rounded-full bg-gradient-to-r from-blue-600/25 via-indigo-600/25 to-purple-600/25 opacity-0 group-focus-within:opacity-100 blur-md transition-all duration-300 pointer-events-none"
            aria-hidden="true"
          ></div>

          <!-- Glass Search Icon -->
          <svg
            class="absolute left-4 h-4.5 w-4.5 text-slate-400 dark:text-slate-500 group-focus-within:text-indigo-600 dark:group-focus-within:text-indigo-400 transition-colors pointer-events-none z-10"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>

          <!-- Input Field -->
          <input
            id="search-input"
            type="search"
            placeholder="Search calculators (e.g., 'sip', 'mortgage', 'emi', 'tax')..."
            class="relative z-0 w-full rounded-2xl sm:rounded-full border border-slate-200/90 dark:border-slate-800/90 bg-white/95 dark:bg-slate-900/95 py-3.5 sm:py-4 pl-11 pr-20 sm:pr-24 text-sm sm:text-base text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 shadow-sm focus:border-indigo-500 dark:focus:border-indigo-400 focus:outline-none focus:ring-4 focus:ring-indigo-500/10 dark:focus:ring-indigo-400/10 transition-all backdrop-blur-xl"
            aria-label="Search all calculators"
          />

          <!-- Shortcut Chip (Desktop) -->
          <div class="absolute right-3.5 top-1/2 -translate-y-1/2 z-10 flex items-center gap-1 pointer-events-none">
            <kbd class="hidden sm:inline-flex items-center px-2 py-0.5 text-[10.5px] font-mono font-semibold text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md shadow-2xs">
              Ctrl K
            </kbd>
          </div>
        </div>
      </div>

      <!-- 2-by-2 Category Navigation Grid (10 Lines Total) -->
      <nav
        aria-label="Calculator Categories"
        class="mt-6 w-full max-w-xl sm:max-w-2xl mx-auto rounded-2xl sm:rounded-3xl border border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/70 p-3.5 sm:p-5.5 shadow-sm dark:shadow-xl backdrop-blur-xl box-border text-left"
      >
        <div class="flex items-center justify-center border-b border-slate-200/80 dark:border-slate-800/80 pb-3 mb-3.5 text-center">
          <h2 class="font-outfit text-xs sm:text-sm font-black uppercase tracking-[0.2em] text-slate-900 dark:text-white flex items-center justify-center gap-2">
            <span class="text-base sm:text-lg">📁</span>
            <span>Categories</span>
          </h2>
        </div>

        <!-- 20 Categories in 2-Column Grid Layout (10 Lines) -->
        <div class="grid grid-cols-2 gap-2 sm:gap-2.5">
          {CATEGORY_ITEMS.map((cat) => (
            <a
              href={`/${cat.id}/`}
              data-category={cat.id}
              title={`Explore ${cat.name} Calculators`}
              class="category-filter-btn group relative flex items-center justify-between w-full min-w-0 min-h-[44px] rounded-xl border border-slate-200/70 dark:border-slate-800/70 bg-white/80 dark:bg-slate-950/60 hover:bg-slate-50 dark:hover:bg-slate-800/80 hover:border-indigo-500/40 dark:hover:border-indigo-400/40 px-2.5 sm:px-3.5 py-2 sm:py-2.5 text-xs sm:text-sm font-medium cursor-pointer transition-all duration-200 shadow-2xs hover:shadow-md hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-indigo-500 active:scale-[0.98]"
            >
              <div class="flex items-center gap-2 sm:gap-2.5 min-w-0">
                <span class="flex h-6 w-6 sm:h-7 sm:w-7 shrink-0 items-center justify-center rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 text-xs sm:text-sm shadow-2xs group-hover:scale-110 group-hover:border-indigo-400/40 transition-transform">
                  {cat.icon}
                </span>
                <span class="text-left font-semibold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">
                  {cat.name}
                </span>

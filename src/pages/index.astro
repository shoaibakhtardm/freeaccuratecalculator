---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import AutocompleteSearch from '../components/common/AutocompleteSearch.astro';

// 20 categories arranged 3-by-3 ("tin tin karke")
const CATEGORY_ITEMS = [
  { id: 'finance', name: 'Finance', icon: '💰' },
  { id: 'insurance', name: 'Insurance', icon: '🛡️' },
  { id: 'legal', name: 'Legal', icon: '⚖️' },
  { id: 'business', name: 'Business', icon: '💼' },
  { id: 'construction', name: 'Construction', icon: '🏗️' },
  { id: 'real-estate', name: 'Real Estate', icon: '🏢' },
  { id: 'technology', name: 'Technology', icon: '💻' },
  { id: 'health', name: 'Health', icon: '🩺' },
  { id: 'statistics', name: 'Statistics', icon: '📊' },
  { id: 'marketing', name: 'Marketing', icon: '📈' },
  { id: 'math', name: 'Math', icon: '📐' },
  { id: 'automotive', name: 'Automotive', icon: '🚗' },
  { id: 'biology', name: 'Biology', icon: '🧬' },
  { id: 'chemistry', name: 'Chemistry', icon: '🧪' },
  { id: 'physics', name: 'Physics', icon: '⚛️' },
  { id: 'food', name: 'Food', icon: '🍎' },
  { id: 'sports', name: 'Sports', icon: '⚽' },
  { id: 'ecology', name: 'Ecology', icon: '🌱' },
  { id: 'everyday', name: 'Everyday', icon: '☀️' },
  { id: 'converter', name: 'Converter', icon: '🔄' },
] as const;

const PROFESSION_ITEMS = [
  { name: 'Doctor', icon: '🩺', href: '/profession/doctor-pediatric-dosage-calculator/' },
  { name: 'Engineer', icon: '⚙️', href: '/profession/engineer-project-cost-calculator/' },
  { name: 'Lawyer', icon: '⚖️', href: '/profession/lawyer-billable-hours-calculator/' },
  { name: 'Nurse', icon: '💉', href: '/profession/nurse-iv-drip-calculator/' },
  { name: 'Architect', icon: '📐', href: '/profession/architect-far-calculator/' },
  { name: 'Accountant', icon: '💼', href: '/profession/accountant-tax-calculator/' },
  { name: 'Real Estate Agent', icon: '🏢', href: '/profession/realtor-commission-calculator/' },
  { name: 'Software Developer', icon: '💻', href: '/profession/developer-sprint-velocity-calculator/' },
  { name: 'Teacher', icon: '📚', href: '/profession/teacher-grade-curve-calculator/' },
  { name: 'Pilot', icon: '✈️', href: '/profession/pilot-fuel-burn-calculator/' },
] as const;

const TOP_20_COUNTRIES = [
  { name: 'United States', flag: '🇺🇸', emoji: '🗽', href: '/countries/united-states/' },
  { name: 'United Kingdom', flag: '🇬🇧', emoji: '💂', href: '/countries/united-kingdom/' },
  { name: 'Canada', flag: '🇨🇦', emoji: '🍁', href: '/countries/canada/' },
  { name: 'Australia', flag: '🇦🇺', emoji: '🦘', href: '/countries/australia/' },
  { name: 'Germany', flag: '🇩🇪', emoji: '🏰', href: '/countries/germany/' },
  { name: 'Switzerland', flag: '🇨🇭', emoji: '🏔️', href: '/countries/switzerland/' },
  { name: 'Norway', flag: '🇳🇴', emoji: '❄️', href: '/countries/norway/' },
  { name: 'Netherlands', flag: '🇳🇱', emoji: '🌷', href: '/countries/netherlands/' },
  { name: 'Sweden', flag: '🇸🇪', emoji: '👑', href: '/countries/sweden/' },
  { name: 'France', flag: '🇫🇷', emoji: '🗼', href: '/countries/france/' },
  { name: 'Ireland', flag: '🇮🇪', emoji: '☘️', href: '/countries/ireland/' },
  { name: 'Singapore', flag: '🇸🇬', emoji: '🦁', href: '/countries/singapore/' },
  { name: 'New Zealand', flag: '🇳🇿', emoji: '🥝', href: '/countries/new-zealand/' },
  { name: 'Denmark', flag: '🇩🇰', emoji: '🚲', href: '/countries/denmark/' },
  { name: 'Japan', flag: '🇯🇵', emoji: '🗻', href: '/countries/japan/' },
  { name: 'United Arab Emirates', flag: '🇦🇪', emoji: '🕌', href: '/countries/united-arab-emirates/' },
  { name: 'Austria', flag: '🇦🇹', emoji: '🎻', href: '/countries/austria/' },
  { name: 'Belgium', flag: '🇧🇪', emoji: '🍫', href: '/countries/belgium/' },
  { name: 'Italy', flag: '🇮🇹', emoji: '🏛️', href: '/countries/italy/' },
  { name: 'Spain', flag: '🇪🇸', emoji: '💃', href: '/countries/spain/' },
] as const;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Free Accurate Calculator',
  url: 'https://freeaccuratecalculator.com/',
  description: 'Fast, mathematically verified online calculators for finance, health, math, and everyday utility.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://freeaccuratecalculator.com/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Free Accurate Calculator',
  url: 'https://freeaccuratecalculator.com/',
  logo: 'https://freeaccuratecalculator.com/favicon.svg',
  sameAs: [
    'https://twitter.com/FreeAccurateCalc',
    'https://github.com/shoaibakhtardm/freeaccuratecalculator',
  ],
  description: 'Fast, mathematically verified online calculators for finance, health, math, and everyday utility.',
};

const POPULAR_CALCULATORS = [
  { name: 'EMI Calculator', icon: '🏦', href: '/finance/emi-calculator/' },
  { name: 'Mortgage Calculator', icon: '🏠', href: '/finance/mortgage-calculator/' },
  { name: 'SIP Calculator', icon: '📈', href: '/finance/sip-calculator/' },
  { name: 'Age Calculator', icon: '🎂', href: '/everyday/age-calculator/' },
  { name: 'Percentage Calculator', icon: '📐', href: '/math/percentage-calculator/' },
  { name: 'BMI Calculator', icon: '🩺', href: '/health/bmi-calculator/' },
  { name: 'Compound Interest', icon: '⏳', href: '/finance/compound-interest-calculator/' },
  { name: 'Income Tax', icon: '📑', href: '/finance/income-tax-calculator/' },
  { name: 'Calorie & TDEE', icon: '🍎', href: '/health/calorie-calculator/' },
  { name: 'Scientific Calc', icon: '🔬', href: '/math/scientific-calculator/' },
  { name: 'Auto Loan', icon: '🚗', href: '/finance/auto-loan-calculator/' },
  { name: 'Date Calculator', icon: '📅', href: '/everyday/date-calculator/' },
  { name: 'GPA Calculator', icon: '🎓', href: '/everyday/gpa-calculator/' },
  { name: 'Body Fat %', icon: '⚖️', href: '/health/body-fat-calculator/' },
  { name: 'Step-Up SIP', icon: '🚀', href: '/finance/step-up-sip-calculator/' },
  { name: 'Lumpsum', icon: '💰', href: '/finance/lumpsum-calculator/' },
  { name: 'Time Calculator', icon: '⏱️', href: '/everyday/time-calculator/' },
  { name: 'Amortization', icon: '📊', href: '/finance/amortization-calculator/' },
  { name: 'Length Converter', icon: '📏', href: '/converter/length-converter/' },
  { name: 'Unit Converter', icon: '🔄', href: '/everyday/conversion-calculator/' },
  { name: 'Simple Interest', icon: '⏱️', href: '/finance/simple-interest-calculator/' },
  { name: 'Term Life', icon: '🛡️', href: '/insurance/term-life-insurance-calculator/' },
  { name: 'Rental Yield', icon: '🏢', href: '/real-estate/rental-yield-calculator/' },
  { name: 'Profit Margin', icon: '🎯', href: '/finance/profit-margin-calculator/' },
  { name: 'Child Support', icon: '⚖️', href: '/legal/child-support-calculator/' },
  { name: 'Break-Even', icon: '💼', href: '/business/break-even-calculator/' },
  { name: 'Square Footage', icon: '🏗️', href: '/construction/square-footage-calculator/' },
] as const;

---

<Layout
  title="Free Accurate Calculator — Fast, Precision Online Calculators"
  description="Free Accurate Calculator delivers industrial-grade, mathematically verified online calculators for Finance, Health, Math, and Everyday calculations with zero cold start and instant local privacy."
  jsonLd={[websiteSchema, organizationSchema]}
>
  <!-- [STARTUP HERO SECTION]: Silicon Valley Precision Layout -->
  <section class="relative overflow-hidden rounded-3xl sm:rounded-[36px] border border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-slate-950/70 px-4 py-10 sm:py-16 md:py-20 text-center hero-mesh-gradient shadow-xs sm:shadow-lg backdrop-blur-xl">
    <!-- Top Ambient Studio Glow (Linear / Vercel style) -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 sm:w-[540px] h-44 sm:h-64 bg-gradient-to-b from-indigo-500/20 via-blue-500/10 to-transparent blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto max-w-2xl sm:max-w-3xl lg:max-w-4xl space-y-5 sm:space-y-6">
      <!-- 1. The Startup Pill Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/20 dark:border-indigo-400/30 bg-gradient-to-r from-blue-500/8 via-indigo-500/8 to-purple-500/8 dark:from-blue-500/15 dark:via-indigo-500/15 dark:to-purple-500/15 px-3.5 py-1.5 shadow-2xs backdrop-blur-md transition-all hover:border-indigo-500/40 select-none">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-outfit text-[11px] sm:text-xs font-bold tracking-wider uppercase text-slate-700 dark:text-slate-200">
          International Edition 2.0
        </span>
        <span class="text-indigo-500 dark:text-indigo-400 text-xs font-bold ml-0.5">✦</span>
      </div>

      <!-- 2. The Main H1 Headline: Outfit Font, Startup Rhythm & Gradient -->
      <h1 class="display-hero font-outfit text-3xl sm:text-5xl lg:text-[56px] xl:text-[62px] font-black tracking-[-0.035em] text-slate-900 dark:text-white leading-[1.12] sm:leading-[1.08] text-balance">
        Calculations Done Right. <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-blue-600 via-indigo-600 via-purple-600 to-pink-500 dark:from-blue-400 dark:via-indigo-300 dark:to-purple-300 bg-clip-text text-transparent">
          Fast, Accurate & Clean.
        </span>
      </h1>

      <!-- 3. Subtitle Paragraph: Refined Typography & Balanced Width -->
      <p class="font-sans text-sm sm:text-base md:text-[17px] text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal text-balance px-2">
        High-precision mathematical calculators with zero clutter, verified formulas, and instant edge calculation. Engineered for global finance, health, and science.
      </p>

      <!-- 4. Interactive Live Spotlight Search Bar with Instant Suggestions -->
      <div class="pt-2 max-w-2xl mx-auto">
        <AutocompleteSearch
          id="search-input"
          placeholder="Search calculators (e.g., 'sip', 'mortgage', 'emi', 'tax', 'age')..."
        />
      </div>

      <!-- 3-by-3 Category Navigation Grid ("tin tin karke" - UI/UX Designer Scaled Edition) -->
      <nav
        aria-label="Calculator Categories"
        class="mt-8 w-full max-w-2xl sm:max-w-3xl lg:max-w-4xl mx-auto rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-800/90 bg-white/80 dark:bg-slate-900/80 p-3 sm:p-5 md:p-6 shadow-sm dark:shadow-xl backdrop-blur-xl box-border text-center"
      >
        <div class="flex items-center justify-center border-b border-slate-200/80 dark:border-slate-800/80 pb-3 sm:pb-3.5 mb-3.5 sm:mb-4 px-1 text-center">
          <h2 class="font-outfit text-xs sm:text-sm font-black uppercase tracking-[0.2em] text-slate-900 dark:text-white flex items-center justify-center gap-2">
            <span class="text-base sm:text-lg">📁</span>
            <span>Categories</span>
          </h2>
        </div>

        <!-- 20 Categories in 3-Column Grid Layout (Top Emoji, Bottom Single-Line Text) -->
        <div class="grid grid-cols-3 gap-2 sm:gap-3 md:gap-3.5">
          {CATEGORY_ITEMS.map((cat) => (
            <a
              href={`/${cat.id}/`}
              data-category={cat.id}
              title={`Explore ${cat.name} Calculators`}
              class="category-filter-btn group relative flex flex-col items-center justify-center text-center w-full min-w-0 min-h-[68px] sm:min-h-[78px] md:min-h-[86px] rounded-xl sm:rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white/90 dark:bg-slate-950/70 hover:bg-slate-50 dark:hover:bg-slate-800/80 hover:border-indigo-500/50 dark:hover:border-indigo-400/50 p-2 sm:p-3 cursor-pointer transition-all duration-200 shadow-2xs hover:shadow-md hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-indigo-500 active:scale-[0.97]"
            >
              <span class="flex h-8 w-8 sm:h-9 sm:w-9 md:h-10 md:w-10 shrink-0 items-center justify-center rounded-xl sm:rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 text-base sm:text-lg md:text-xl shadow-2xs group-hover:scale-110 group-hover:border-indigo-400/50 transition-transform mb-1 sm:mb-1.5">
                {cat.icon}
              </span>
              <span class="w-full text-center font-semibold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors text-[11px] sm:text-xs md:text-sm leading-tight whitespace-nowrap overflow-hidden">
                {cat.name}
              </span>
            </a>
          ))}
        </div>
      </nav>
    </div>
  </section>

  <!-- Popular Calculators Section (Top Emoji, Bottom Single-Line Text) -->
  <section
    aria-label="Popular Calculators"
    class="my-10 w-full max-w-2xl sm:max-w-3xl lg:max-w-4xl mx-auto rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-800/90 bg-white/80 dark:bg-slate-900/80 p-3 sm:p-5 md:p-6 shadow-sm dark:shadow-xl backdrop-blur-xl box-border text-center"
  >
    <div class="flex items-center justify-center border-b border-slate-200/80 dark:border-slate-800/80 pb-3 sm:pb-3.5 mb-3.5 sm:mb-4 px-1 text-center">
      <h2 class="font-outfit text-xs sm:text-sm font-black uppercase tracking-[0.2em] text-slate-900 dark:text-white flex items-center justify-center gap-2">
        <span class="text-base sm:text-lg">⚡</span>
        <span>Popular Calculators</span>
      </h2>
    </div>

    <!-- 27 Popular Calculators in 3-Column Grid Layout (Top Emoji, Bottom Single-Line Text) -->
    <div class="grid grid-cols-3 gap-2 sm:gap-3 md:gap-3.5">
      {POPULAR_CALCULATORS.map((item) => (
        <a
          href={item.href}
          title={`Explore ${item.name}`}
          class="group relative flex flex-col items-center justify-center text-center w-full min-w-0 min-h-[68px] sm:min-h-[78px] md:min-h-[86px] rounded-xl sm:rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white/90 dark:bg-slate-950/70 hover:bg-slate-50 dark:hover:bg-slate-800/80 hover:border-indigo-500/50 dark:hover:border-indigo-400/50 p-2 sm:p-3 cursor-pointer transition-all duration-200 shadow-2xs hover:shadow-md hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-indigo-500 active:scale-[0.97]"
        >
          <span class="flex h-8 w-8 sm:h-9 sm:w-9 md:h-10 md:w-10 shrink-0 items-center justify-center rounded-xl sm:rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 text-base sm:text-lg md:text-xl shadow-2xs group-hover:scale-110 group-hover:border-indigo-400/50 transition-transform mb-1 sm:mb-1.5">
            {item.icon}
          </span>
          <span class="w-full text-center font-semibold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors text-[10.5px] sm:text-xs md:text-sm leading-tight whitespace-nowrap overflow-hidden">
            {item.name}
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Profession Calculator Section (Top Emoji, Bottom Single-Line Text) -->
  <section
    aria-label="Profession Calculators"
    class="my-10 w-full max-w-2xl sm:max-w-3xl lg:max-w-4xl mx-auto rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-800/90 bg-white/80 dark:bg-slate-900/80 p-3 sm:p-5 md:p-6 shadow-sm dark:shadow-xl backdrop-blur-xl box-border text-center"
  >
    <div class="flex items-center justify-center border-b border-slate-200/80 dark:border-slate-800/80 pb-3 sm:pb-3.5 mb-3.5 sm:mb-4 px-1 text-center">
      <h2 class="font-outfit text-xs sm:text-sm font-black uppercase tracking-[0.2em] text-slate-900 dark:text-white flex items-center justify-center gap-2">
        <span class="text-base sm:text-lg">🎯</span>
        <span>Professions</span>
      </h2>
    </div>

    <!-- 10 Professions in 3-Column Grid Layout (Top Emoji, Bottom Single-Line Text) -->
    <div class="grid grid-cols-3 gap-2 sm:gap-3 md:gap-3.5">
      {PROFESSION_ITEMS.map((item) => (
        <a
          href={item.href}
          title={`Explore ${item.name} Calculator`}
          class="group relative flex flex-col items-center justify-center text-center w-full min-w-0 min-h-[68px] sm:min-h-[78px] md:min-h-[86px] rounded-xl sm:rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white/90 dark:bg-slate-950/70 hover:bg-slate-50 dark:hover:bg-slate-800/80 hover:border-indigo-500/50 dark:hover:border-indigo-400/50 p-2 sm:p-3 cursor-pointer transition-all duration-200 shadow-2xs hover:shadow-md hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-indigo-500 active:scale-[0.97]"
        >
          <span class="flex h-8 w-8 sm:h-9 sm:w-9 md:h-10 md:w-10 shrink-0 items-center justify-center rounded-xl sm:rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 text-base sm:text-lg md:text-xl shadow-2xs group-hover:scale-110 group-hover:border-indigo-400/50 transition-transform mb-1 sm:mb-1.5">
            {item.icon}
          </span>
          <span class="w-full text-center font-semibold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors text-[10.5px] sm:text-xs md:text-sm leading-tight whitespace-nowrap overflow-hidden">
            {item.name}
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Country-Wise Calculators Section (Top Flag, Bottom Single-Line Text) -->
  <section
    aria-label="Country-Wise Calculators"
    class="my-10 w-full max-w-2xl sm:max-w-3xl lg:max-w-4xl mx-auto rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-800/90 bg-white/80 dark:bg-slate-900/80 p-3 sm:p-5 md:p-6 shadow-sm dark:shadow-xl backdrop-blur-xl box-border text-center"
  >
    <div class="flex items-center justify-center border-b border-slate-200/80 dark:border-slate-800/80 pb-3 sm:pb-3.5 mb-3.5 sm:mb-4 px-1 text-center">
      <h2 class="font-outfit text-xs sm:text-sm font-black uppercase tracking-[0.2em] text-slate-900 dark:text-white flex items-center justify-center gap-2">
        <span class="text-base sm:text-lg">🌍</span>
        <span>Countries</span>
      </h2>
    </div>

    <!-- 20 High CPM Countries in 3-Column Grid Layout (Top Emoji, Bottom Clean Text) -->
    <div class="grid grid-cols-3 gap-2 sm:gap-3 md:gap-3.5">
      {TOP_20_COUNTRIES.map((item) => (
        <a
          href={item.href}
          title={`Explore ${item.name} Calculators`}
          class="group relative flex flex-col items-center justify-center text-center w-full min-w-0 min-h-[72px] sm:min-h-[80px] md:min-h-[88px] rounded-xl sm:rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white/90 dark:bg-slate-950/70 hover:bg-slate-50 dark:hover:bg-slate-800/80 hover:border-indigo-500/50 dark:hover:border-indigo-400/50 p-2 sm:p-2.5 md:p-3 cursor-pointer transition-all duration-200 shadow-2xs hover:shadow-md hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-indigo-500 active:scale-[0.97]"
        >
          <span class="flex h-8 w-8 sm:h-9 sm:w-9 md:h-10 md:w-10 shrink-0 items-center justify-center rounded-xl sm:rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 text-base sm:text-lg md:text-xl shadow-2xs group-hover:scale-110 group-hover:border-indigo-400/50 transition-transform mb-1 sm:mb-1.5">
            {item.emoji}
          </span>
          <span class="w-full text-center font-semibold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors text-[10px] sm:text-xs md:text-sm leading-[1.15] break-words line-clamp-2 px-0.5">
            {item.name}
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- About Us Section (Tech Startup Style, 4-Box Full Width Architecture) -->
  <section class="mt-10 mb-2 w-full max-w-xl sm:max-w-2xl mx-auto px-1">
    <div class="text-center space-y-2 mb-6">
      <span class="font-outfit text-xs font-semibold uppercase tracking-wider text-link">ABOUT OUR PLATFORM</span>
      <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-ink tracking-tight font-outfit">
        Built for Speed, Trust &amp; <span class="bg-gradient-to-r from-link via-violet to-magenta bg-clip-text text-transparent">Complete Privacy</span>
      </h2>
      <p class="text-xs sm:text-sm text-body leading-relaxed max-w-md mx-auto">
        Why Free Accurate Calculator is engineered from the ground up to replace outdated legacy calculator portals.
      </p>
    </div>

    <div
      aria-label="About Free Accurate Calculator"
      class="w-full rounded-2xl border border-hairline bg-canvas-elevated/70 p-4 sm:p-6 shadow-whisper backdrop-blur-sm box-border flex flex-col space-y-4"
    >
      <!-- Header row inside the box -->

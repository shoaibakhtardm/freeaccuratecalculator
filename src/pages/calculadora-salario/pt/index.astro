            </tr>
            <tr>
              <td class="py-2 px-3">De R$ 2.902,85 até R$ 4.354,27</td>
              <td class="py-2 px-3 text-center font-bold">12,0%</td>
              <td class="py-2 px-3 text-right">R$ 111,40</td>
              <td class="py-2 px-3 text-right">R$ 174,17</td>

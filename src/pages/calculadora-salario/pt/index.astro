---
// src/pages/calculadora-salario/pt/index.astro
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import FormulaSection from '../../../components/calculator/FormulaSection.astro';
import WorkedExample from '../../../components/calculator/WorkedExample.astro';
import FAQSection from '../../../components/calculator/FAQSection.astro';
import {
  regrasINSS2026,
  regrasIRRF2026,
  calcularSalarioLiquido,
  formatarMoedaBRL,
  formatarPercentualBRL,
} from '../../../engines/salarioLiquidoBrasil2026';

// Perguntas frequentes estruturadas em português brasileiro para o schema FAQPage
const faqs = [
  {
    question: 'Como calcular o salário líquido em 2026?',
    answer:
      'Para calcular o salário líquido em 2026, parte-se do salário bruto mensal somado a eventuais proventos adicionais (como horas extras, DSR e adicionais). Em seguida, subtrai-se o desconto progressivo do INSS oficial de 2026. Sobre a base restante, deduzem-se dependentes legais (R$ 189,59 cada) e pensão alimentícia judicial, aplicando a tabela do IRRF com o redutor oficial de 2026. Por fim, descontam-se itens como vale-transporte e outros descontos de folha.',
  },
  {
    question: 'O que mudou no Imposto de Renda (IRRF) em 2026?',
    answer:
      'Em 2026, a legislação brasileira estabeleceu a isenção total na fonte para quem recebe até R$ 5.000,00 mensais por meio de um redutor oficial de imposto de até R$ 312,89. Para rendas entre R$ 5.000,01 e R$ 7.350,00, foi criada uma faixa de transição gradual com desconto regressivo calculado pela fórmula oficial [978,62 − (0,133145 × Renda Mensal)]. Apenas quem recebe acima de R$ 7.350,00 recolhe integralmente pela tabela progressiva tradicional.',
  },
  {
    question: 'Qual é o teto máximo de desconto do INSS em 2026?',
    answer:
      'Em 2026, conforme a Portaria Interministerial MPS/MF nº 13/2026, o teto máximo de contribuição dos segurados empregados e trabalhadores avulsos é de R$ 988,09 mensais, incidente sobre o teto salarial previdenciário de R$ 8.475,55. Salários brutos acima desse teto continuam tendo o desconto limitado a R$ 988,09.',
  },
  {
    question: 'Quanto cada dependente abate no Imposto de Renda em 2026?',
    answer:
      'Cada dependente legal cadastrado permite abater exatamente R$ 189,59 por mês da base de cálculo do IRRF. Esse abatimento reduz o valor sobre o qual as alíquotas do imposto incidem, aumentando diretamente o salário líquido final recebido.',
  },
  {
    question: 'Como funciona o cálculo de horas extras e DSR na CLT?',
    answer:
      'A hora extra comum é acrescida de no mínimo 50% sobre o valor da hora normal (salário bruto dividido por 220 horas para jornadas de 44h semanais). Horas extras realizadas em domingos e feriados sem folga compensatória recebem adicional de 100%. Além disso, as horas extras geram reflexo obrigatório no Descanso Semanal Remunerado (DSR), integrando a remuneração bruta total.',
  },
  {
    question: 'Como é calculado o salário proporcional aos dias trabalhados?',
    answer:
      'Conforme o artigo 64 da Consolidação das Leis do Trabalho (CLT), o cálculo do salário proporcional é realizado considerando a base de 30 dias por mês: divide-se o salário bruto mensal contratual por 30 e multiplica-se pela quantidade de dias trabalhados no período de admissão, demissão ou afastamento.',
  },
  {
    question: 'A calculadora serve para servidores públicos estatutários?',
    answer:
      'Esta calculadora foi desenvolvida com base no Regime Geral de Previdência Social (RGPS/INSS) e nas regras gerais da CLT. Servidores públicos vinculados a Regimes Próprios de Previdência Social (RPPS) possuem tabelas previdenciárias próprias e legislações específicas de cada ente da federação (União, estados ou municípios), podendo haver divergências nas alíquotas e fundos de previdência complementar.',
  },
  {
    question: 'Os dados informados são confidenciais e seguros?',
    answer:
      'Sim, 100% seguros e estritamente privados. Todos os cálculos matemáticos são processados instantaneamente no seu navegador (computação no cliente). Nenhuma informação de salário, dependentes ou deduções é transmitida ou gravada em servidores externos.',
  },
];

// Calculadoras relacionadas em português
const relatedCalculators = [
  { title: 'Calculadora de Porcentagem', href: '/percentage-calculator/', badge: 'Matemática' },
  { title: 'Calculadora de Juros Compostos', href: '/compound-interest-calculator/', badge: 'Finanças' },
  { title: 'Calculadora de Idade', href: '/calculadora-edad/es/', badge: 'Pessoal' },
  { title: 'Calculadora de Empréstimo e Financiamento', href: '/emi-calculator/', badge: 'Crédito' },
];

// Exemplo trabalhado passo a passo matematicamente verificado para R$ 5.000,00
const workedExampleSteps = [
  {
    number: 1,
    title: 'Apuração do Salário Bruto e Proventos',
    description: 'Neste exemplo base, o salário bruto mensal é de R$ 5.000,00, sem horas extras ou adicionais.',
    mathExpression: 'Salário Bruto = R$ 5.000,00',
  },
  {
    number: 2,
    title: 'Cálculo Progressivo da Contribuição ao INSS 2026',
    description: 'Aplica-se o cálculo progressivo por faixas: 7,5% até R$ 1.621,00 (R$ 121,58); 9% sobre a segunda faixa (R$ 115,37); 12% sobre a terceira faixa (R$ 174,17); e 14% sobre o excedente até R$ 5.000,00 (R$ 90,40). O desconto total de INSS resulta em R$ 501,51 (alíquota efetiva de 10,03%).',
    mathExpression: 'INSS 2026 = R$ 5.000,00 × 14% − R$ 198,49 = R$ 501,51',
  },
  {
    number: 3,
    title: 'Base de Cálculo do IRRF e Aplicação da Isenção 2026',
    description: 'Subtrai-se o INSS do salário bruto: R$ 5.000,00 − R$ 501,51 = R$ 4.498,49. Na tabela padrão, incidiria imposto de R$ 226,38. No entanto, pelas novas regras de 2026 com isenção total até R$ 5.000,00, aplica-se o redutor oficial de R$ 312,89, zerando integralmente o IRRF.',
    mathExpression: 'IRRF a Pagar = Máximo(R$ 0,00, R$ 226,38 − R$ 312,89) = R$ 0,00',
  },
  {
    number: 4,
    title: 'Determinação do Salário Líquido Final',
    description: 'Subtrai-se o total de descontos legais (R$ 501,51) do salário bruto inicial (R$ 5.000,00).',
    mathExpression: 'Salário Líquido = R$ 5.000,00 − R$ 501,51 = R$ 4.498,49',
  },
];

// Dados pré-calculados para a tabela comparativa de salários oficiais 2026
const exemplosTabela = [
  { salarioBruto: 3000, inss: 248.60, irrf: 0.00, liquido: 2751.40, aliqEfetiva: '8,29%' },
  { salarioBruto: 5000, inss: 501.51, irrf: 0.00, liquido: 4498.49, aliqEfetiva: '10,03%' },
  { salarioBruto: 7000, inss: 781.51, irrf: 479.91, liquido: 5738.58, aliqEfetiva: '18,02%' },
  { salarioBruto: 10000, inss: 988.09, irrf: 1569.55, liquido: 7442.36, aliqEfetiva: '25,58%' },
  { salarioBruto: 20000, inss: 988.09, irrf: 4319.55, liquido: 14692.36, aliqEfetiva: '26,54%' },
];

const dataHojePt = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());
---

<CalculatorLayout
  title="Calculadora de Salário Líquido 2026 – INSS e IRRF"
  metaDescription="Calcule seu salário líquido em 2026 com base nas regras oficiais do INSS e do novo IRRF no Brasil. Descubra descontos, dependentes, horas extras e dias trabalhados."
  h1="Calculadora de Salário Líquido 2026"
  subtitle="Descubra exatamente quanto você vai receber na conta após os descontos de INSS, novo IRRF, dependentes, horas extras e benefícios no Brasil."
  category={{ label: 'Calculadoras Financeiras', href: '/finance/' }}
  calculatorName="Calculadora de Salário Líquido 2026"
  relatedCalculators={relatedCalculators}
  faqs={faqs}
  lang="pt-BR"
  canonical="https://freeaccuratecalculator.com/calculadora-salario/pt/"
  disableEmailModal={true}
>
  <!-- Caixa Principal da Calculadora -->
  <div
    id="salario-calculator-card"
    class="calculator-main-box relative rounded-[20px] border border-hairline bg-canvas-elevated p-4 sm:p-8 shadow-whisper space-y-6 overflow-hidden transition-all pb-24 sm:pb-8"
  >
    <!-- Resplendor Ambiental Sutil -->
    <div class="pointer-events-none absolute -top-32 -right-32 w-80 h-80 rounded-full bg-link/10 blur-3xl print:hidden"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-32 w-80 h-80 rounded-full bg-cyan/10 blur-3xl print:hidden"></div>

    <!-- Relatório Dedicado de Alta Fidelidade para Impressão e PDF (Visível apenas na impressão) -->
    <div id="salary-print-report" class="hidden print:block font-mono text-slate-900 fac-print-report">
      <!-- Cabeçalho Oficial -->
      <div class="border-b-2 border-slate-900 pb-4 mb-5 flex justify-between items-start">
        <div>
          <div class="text-2xl font-black uppercase tracking-tight">Free Accurate Calculator</div>
          <div class="text-sm font-bold text-blue-700 mt-0.5">Demonstrativo de Estimativa de Salário Líquido 2026</div>
          <div class="text-xs text-slate-500 mt-1">freeaccuratecalculator.com • Legislação Previdenciária e Fiscal Oficial do Brasil</div>
        </div>
        <div class="text-right text-xs text-slate-600 space-y-0.5">
          <div><span class="text-slate-400 uppercase">Data do Cálculo:</span> <strong id="print-date" class="text-slate-900">{dataHojePt}</strong></div>
          <div><span class="text-slate-400 uppercase">Exercício Fiscal:</span> <strong class="text-slate-900">2026 (INSS Progressivo & Novo IRRF)</strong></div>
        </div>
      </div>

      <!-- Parâmetros de Entrada -->
      <div class="bg-slate-50 border border-slate-200 rounded-lg p-3.5 mb-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Parâmetros Informados</div>
        <div class="grid grid-cols-4 gap-4 text-xs">
          <div><span class="text-slate-500 block text-[10px] uppercase">Salário Bruto Mensal</span><span id="print-salario-bruto" class="text-sm font-bold text-slate-900">R$ 5.000,00</span></div>
          <div><span class="text-slate-500 block text-[10px] uppercase">Número de Dependentes</span><span id="print-dependentes" class="text-sm font-bold text-slate-900">0</span></div>
          <div><span class="text-slate-500 block text-[10px] uppercase">Outras Deduções</span><span id="print-outras-deducoes" class="text-sm font-bold text-slate-900">R$ 0,00</span></div>
          <div><span class="text-slate-500 block text-[10px] uppercase">Dias Trabalhados / Mês</span><span id="print-dias" class="text-sm font-bold text-slate-900">30 dias</span></div>
        </div>
      </div>

      <!-- Destaque do Salário Líquido -->
      <div class="border-2 border-slate-900 rounded-lg p-4 bg-slate-50 mb-6">
        <span class="text-[10px] font-bold uppercase text-slate-900 block">Salário Líquido Estimado a Receber</span>
        <div id="print-salario-liquido" class="text-3xl font-black text-slate-900 mt-1">R$ 4.498,49</div>
        <div id="print-resumo-subtitulo" class="text-xs text-slate-600 mt-1">Descontos totais de R$ 501,51 (10,03% do total de proventos)</div>
      </div>

      <!-- Tabela do Demonstrativo de Folha -->
      <div class="space-y-2 mb-6">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Detalhamento Transparente de Proventos e Descontos</div>
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b-2 border-slate-300 bg-slate-100 text-slate-700">
              <th class="py-2 px-2.5">Descrição do Item</th>
              <th class="py-2 px-2.5 text-center">Referência / Alíquota</th>
              <th class="py-2 px-2.5 text-right">Proventos (+)</th>
              <th class="py-2 px-2.5 text-right">Descontos (−)</th>
            </tr>
          </thead>
          <tbody id="print-tabela-corpo" class="divide-y divide-slate-200">
            <!-- Preenchido dinamicamente pelo script -->
          </tbody>
        </table>
      </div>

      <!-- Nota de Estimativa e Rodapé -->
      <div class="mt-8 pt-3 border-t border-slate-200 flex justify-between items-center text-[10px] text-slate-500">
        <div>Free Accurate Calculator • https://freeaccuratecalculator.com/calculadora-salario/pt</div>
        <div>Os resultados são estimativas e podem variar conforme descontos, benefícios e convenções coletivas.</div>
      </div>
    </div>

    <!-- Interface na Tela (Oculta na Impressão) -->
    <div class="print:hidden space-y-6">
      <!-- Barra Superior de Identificação -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-4 text-xs">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <span class="mono-eyebrow text-ink font-semibold">Tabelas Oficiais de 2026 Ativas</span>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold">
            Portaria MPS/MF nº 13/2026 & Novo IR
          </span>
        </div>

        <div class="flex items-center gap-2 text-mute font-mono text-[11px]">
          <span>Moeda: <strong>Real Brasileiro (R$)</strong></span>
          <span>•</span>
          <span>Regime: <strong>CLT / Mensal</strong></span>
        </div>
      </div>

      <!-- Formulário: Campos Principais -->
      <form id="salary-calculator-form" class="space-y-5" onsubmit="event.preventDefault();">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Campo 1: Salário Bruto Mensal -->
          <div class="space-y-1.5">
            <label for="salario-bruto-input" class="block text-xs font-semibold text-ink uppercase font-mono">
              Salário bruto mensal <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-mute font-mono text-sm">
                R$
              </span>
              <input
                id="salario-bruto-input"
                name="salarioBruto"
                type="text"
                inputmode="decimal"
                value="5.000,00"
                placeholder="Ex.: 5.000,00"
                aria-label="Salário bruto mensal em reais"
                required
                class="w-full min-h-[44px] rounded-[8px] border border-hairline bg-canvas pl-10 pr-3.5 py-2.5 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link transition-colors"
              />
            </div>
            <p class="text-[11px] text-mute font-mono">Valor contratual bruto registrado na Carteira de Trabalho.</p>
          </div>

          <!-- Campo 2: Número de Dependentes -->
          <div class="space-y-1.5">
            <label for="dependentes-input" class="block text-xs font-semibold text-ink uppercase font-mono">
              Número de dependentes
            </label>
            <div class="relative">
              <input
                id="dependentes-input"
                name="dependentes"
                type="number"
                min="0"
                max="30"
                step="1"
                value="0"
                placeholder="0"
                aria-label="Quantidade de dependentes legais para dedução de Imposto de Renda"
                class="w-full min-h-[44px] rounded-[8px] border border-hairline bg-canvas px-3.5 py-2.5 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link transition-colors"
              />
            </div>
            <p class="text-[11px] text-mute font-mono">Dedução legal de R$ 189,59 por dependente no IRRF.</p>
          </div>

          <!-- Campo 3: Outras Deduções -->
          <div class="space-y-1.5">
            <label for="outras-deducoes-input" class="block text-xs font-semibold text-ink uppercase font-mono">
              Outras deduções
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-mute font-mono text-sm">
                R$
              </span>
              <input
                id="outras-deducoes-input"
                name="outrasDeducoes"
                type="text"
                inputmode="decimal"
                value="0,00"
                placeholder="Ex.: 0,00"
                aria-label="Outras deduções legais da base do imposto de renda"
                class="w-full min-h-[44px] rounded-[8px] border border-hairline bg-canvas pl-10 pr-3.5 py-2.5 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link transition-colors"
              />
            </div>
            <p class="text-[11px] text-mute font-mono">Previdência privada (PGBL) ou outras deduções legais.</p>
          </div>
        </div>

        <!-- Seção Expansível: Opções Avançadas -->
        <div class="rounded-xl border border-hairline bg-canvas/60 overflow-hidden transition-all">
          <button
            type="button"
            id="toggle-opcoes-avancadas-btn"
            aria-expanded="false"
            aria-controls="secao-opcoes-avancadas"
            class="w-full flex items-center justify-between p-4 text-xs font-mono font-semibold text-ink hover:text-link transition-colors cursor-pointer select-none"
          >
            <div class="flex items-center gap-2">
              <span class="text-sm">⚙️</span>
              <span class="uppercase tracking-wider">Opções avançadas</span>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] bg-hairline text-mute">
                Horas extras, dias trabalhados, vale-transporte e pensão
              </span>
            </div>
            <span id="icone-opcoes-avancadas" class="transform transition-transform duration-200 text-mute">
              ▼
            </span>
          </button>

          <div id="secao-opcoes-avancadas" class="hidden p-4 pt-0 border-t border-hairline space-y-4">
            <p class="text-[11px] text-mute font-mono">
              Preencha apenas o que se aplicar à sua folha de pagamento. Deixe zerado o que não for utilizado.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
              <!-- Dias Trabalhados no Mês -->
              <div class="space-y-1">
                <label for="dias-trabalhados-input" class="block text-xs font-semibold text-ink uppercase font-mono">
                  Dias trabalhados (proporcional)
                </label>
                <div class="relative">
                  <input
                    id="dias-trabalhados-input"
                    type="number"
                    min="1"
                    max="30"
                    step="1"
                    value="30"
                    aria-label="Dias trabalhados no mês para cálculo proporcional"
                    class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas px-3 py-2 text-sm font-mono text-ink focus:border-link focus:outline-none"
                  />
                </div>
                <span class="text-[10px] text-mute block font-mono">Padrão CLT: 30 dias para mês integral.</span>
              </div>

              <!-- Horas Extras 50% -->
              <div class="space-y-1">
                <label for="horas-extras-50-input" class="block text-xs font-semibold text-ink uppercase font-mono">
                  Horas extras com adicional 50%
                </label>
                <div class="relative">
                  <input
                    id="horas-extras-50-input"
                    type="number"
                    min="0"
                    step="0.5"
                    value="0"
                    placeholder="0"
                    aria-label="Quantidade de horas extras realizadas a 50%"
                    class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas px-3 py-2 text-sm font-mono text-ink focus:border-link focus:outline-none"
                  />
                </div>
                <span class="text-[10px] text-mute block font-mono">Horas adicionais em dias úteis normais.</span>
              </div>

              <!-- Horas Extras 100% -->
              <div class="space-y-1">
                <label for="horas-extras-100-input" class="block text-xs font-semibold text-ink uppercase font-mono">
                  Horas extras com adicional 100%
                </label>
                <div class="relative">
                  <input
                    id="horas-extras-100-input"
                    type="number"
                    min="0"
                    step="0.5"
                    value="0"
                    placeholder="0"
                    aria-label="Quantidade de horas extras realizadas a 100%"
                    class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas px-3 py-2 text-sm font-mono text-ink focus:border-link focus:outline-none"
                  />
                </div>
                <span class="text-[10px] text-mute block font-mono">Horas trabalhadas em domingos ou feriados.</span>
              </div>

              <!-- Adicional Noturno -->
              <div class="space-y-1">
                <label for="adicional-noturno-input" class="block text-xs font-semibold text-ink uppercase font-mono">
                  Adicional noturno (valor em R$)
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-mute font-mono text-xs">
                    R$
                  </span>
                  <input
                    id="adicional-noturno-input"
                    type="text"
                    inputmode="decimal"
                    value="0,00"
                    placeholder="0,00"
                    aria-label="Valor total do adicional noturno em reais"
                    class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas pl-9 pr-3 py-2 text-sm font-mono text-ink focus:border-link focus:outline-none"
                  />
                </div>
                <span class="text-[10px] text-mute block font-mono">Trabalho entre 22h e 5h (mínimo 20%).</span>
              </div>

              <!-- Pensão Alimentícia -->
              <div class="space-y-1">
                <label for="pensao-alimenticia-input" class="block text-xs font-semibold text-ink uppercase font-mono">
                  Pensão alimentícia judicial (R$)
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-mute font-mono text-xs">
                    R$
                  </span>
                  <input
                    id="pensao-alimenticia-input"
                    type="text"
                    inputmode="decimal"
                    value="0,00"
                    placeholder="0,00"
                    aria-label="Valor de pensão alimentícia descontado judicialmente"
                    class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas pl-9 pr-3 py-2 text-sm font-mono text-ink focus:border-link focus:outline-none"
                  />
                </div>
                <span class="text-[10px] text-mute block font-mono">Dedutível da base de cálculo do IRRF.</span>
              </div>

              <!-- Vale-Transporte -->
              <div class="space-y-1">
                <label for="vale-transporte-input" class="block text-xs font-semibold text-ink uppercase font-mono">
                  Vale-transporte (desconto em R$)
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-mute font-mono text-xs">
                    R$
                  </span>
                  <input
                    id="vale-transporte-input"
                    type="text"
                    inputmode="decimal"
                    value="0,00"
                    placeholder="0,00"
                    aria-label="Desconto de vale-transporte em reais"

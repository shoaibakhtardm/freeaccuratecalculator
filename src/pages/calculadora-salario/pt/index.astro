  <!-- Motor em Script Inline no Cliente (Zero Dependências Externas, Alta Performance) -->
  <script is:inline>
    (function () {
      // Regras Oficiais do INSS 2026 (Portaria Interministerial MPS/MF nº 13/2026)
      var REGRAS_INSS_2026 = {
        salarioMinimo: 1621.00,
        tetoPrevidenciario: 8475.55,
        tetoDescontoINSS: 988.09,
        faixas: [
          { limite: 1621.00, aliquota: 0.075, deducaoFixa: 0.00, recolhimentoMaximo: 121.58 },
          { limite: 2902.84, aliquota: 0.090, deducaoFixa: 24.32, recolhimentoMaximo: 115.37 },
          { limite: 4354.27, aliquota: 0.120, deducaoFixa: 111.40, recolhimentoMaximo: 174.17 },
          { limite: 8475.55, aliquota: 0.140, deducaoFixa: 198.49, recolhimentoMaximo: 576.98 },
        ]
      };

      // Regras Oficiais do IRRF 2026 (Novo IR)
      var REGRAS_IRRF_2026 = {
        deducaoPorDependente: 189.59,
        descontoSimplificadoPadrao: 607.20,
        limiteIsencaoTotal2026: 5000.00,
        limiteTransicao2026: 7350.00,
        faixasBase: [
          { limite: 2428.80, aliquota: 0.00, deducao: 0.00 },
          { limite: 3042.94, aliquota: 0.075, deducao: 182.16 },
          { limite: 4048.91, aliquota: 0.150, deducao: 410.38 },
          { limite: 5061.14, aliquota: 0.225, deducao: 714.05 },
          { limite: Infinity, aliquota: 0.275, deducao: 967.11 },
        ]
      };

      function formatarMoeda(valor) {
        if (typeof valor !== 'number' || isNaN(valor) || !isFinite(valor)) valor = 0;
        return valor.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
      }

      function formatarPercentual(aliquota) {
        if (typeof aliquota !== 'number' || isNaN(aliquota) || !isFinite(aliquota)) aliquota = 0;
        return (aliquota * 100).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '%';
      }

      function parseMoedaInput(texto) {
        if (!texto) return 0;
        var limpo = String(texto).trim().replace(/^R\$\s?/, '');
        limpo = limpo.replace(/\s+/g, '');
        if (limpo.indexOf(',') !== -1 && limpo.indexOf('.') !== -1) {
          limpo = limpo.replace(/\./g, '').replace(',', '.');
        } else if (limpo.indexOf(',') !== -1) {
          limpo = limpo.replace(',', '.');
        }
        var num = parseFloat(limpo);
        return isNaN(num) || !isFinite(num) || num < 0 ? 0 : num;
      }

      function calcularINSS(salarioBruto) {
        var salarioTributavel = Math.min(salarioBruto, REGRAS_INSS_2026.tetoPrevidenciario);
        if (salarioTributavel <= 0) {
          return { descontoTotal: 0, aliquotaEfetiva: 0, faixasDetalhadas: [] };
        }
        var faixas = REGRAS_INSS_2026.faixas;
        var total = 0;
        var faixasDetalhadas = [];
        var pisoAnterior = 0;

        for (var i = 0; i < faixas.length; i++) {
          var f = faixas[i];
          if (salarioTributavel > pisoAnterior) {
            var baseNaFaixa = Math.min(salarioTributavel, f.limite) - pisoAnterior;
            var valorNaFaixa = baseNaFaixa * f.aliquota;
            total += valorNaFaixa;
            faixasDetalhadas.push({
              numero: i + 1,
              faixaTexto: i === 0 ? 'Até R$ ' + f.limite.toLocaleString('pt-BR') : 'De R$ ' + (pisoAnterior + 0.01).toLocaleString('pt-BR') + ' até R$ ' + f.limite.toLocaleString('pt-BR'),
              aliquota: f.aliquota,
              aliquotaTexto: formatarPercentual(f.aliquota),
              baseCalculoFaixa: baseNaFaixa,
              valorDescontado: valorNaFaixa
            });
            pisoAnterior = f.limite;
          } else {
            break;
          }
        }

        total = Math.min(total, REGRAS_INSS_2026.tetoDescontoINSS);
        total = Math.round(total * 100) / 100;
        var aliquotaEfetiva = salarioBruto > 0 ? total / salarioBruto : 0;
        return { descontoTotal: total, aliquotaEfetiva: aliquotaEfetiva, faixasDetalhadas: faixasDetalhadas };
      }

      function calcularIRRF(salarioBruto, descontoINSS, numeroDependentes, outrasDeducoesLegais, pensaoAlimenticia) {
        var dep = numeroDependentes || 0;
        var outras = outrasDeducoesLegais || 0;
        var pensao = pensaoAlimenticia || 0;

        var totalDeducoesLegais = descontoINSS + (dep * REGRAS_IRRF_2026.deducaoPorDependente) + outras + pensao;
        var baseLegal = Math.max(0, salarioBruto - totalDeducoesLegais);
        var baseSimplificada = Math.max(0, salarioBruto - REGRAS_IRRF_2026.descontoSimplificadoPadrao);

        var usarSimplificado = baseSimplificada < baseLegal;
        var baseCalculoFinal = usarSimplificado ? baseSimplificada : baseLegal;

        var faixas = REGRAS_IRRF_2026.faixasBase;
        var impostoTabela = 0;
        var aliquotaFaixa = 0;
        var deducaoFaixa = 0;

        for (var i = 0; i < faixas.length; i++) {
          if (baseCalculoFinal <= faixas[i].limite) {
            aliquotaFaixa = faixas[i].aliquota;
            deducaoFaixa = faixas[i].deducao;
            impostoTabela = Math.max(0, (baseCalculoFinal * aliquotaFaixa) - deducaoFaixa);
            break;
          }
        }

        var isentoPelaRegra2026 = false;
        var redutorAplicado = 0;
        var impostoDevidoFinal = impostoTabela;

        if (salarioBruto <= REGRAS_IRRF_2026.limiteIsencaoTotal2026) {
          isentoPelaRegra2026 = true;
          redutorAplicado = impostoTabela;
          impostoDevidoFinal = 0;
        } else if (salarioBruto <= REGRAS_IRRF_2026.limiteTransicao2026) {
          var redutorFormula = 978.62 - (0.133145 * salarioBruto);
          redutorAplicado = Math.max(0, redutorFormula);
          impostoDevidoFinal = Math.max(0, impostoTabela - redutorAplicado);
        }

        impostoDevidoFinal = Math.round(impostoDevidoFinal * 100) / 100;
        var aliquotaEfetiva = salarioBruto > 0 ? impostoDevidoFinal / salarioBruto : 0;

        return {
          baseCalculo: baseCalculoFinal,
          impostoTabela: impostoTabela,
          redutorAplicado: redutorAplicado,
          descontoIRRF: impostoDevidoFinal,
          aliquotaFaixa: aliquotaFaixa,
          aliquotaEfetiva: aliquotaEfetiva,
          isentoTotal2026: isentoPelaRegra2026,
          usouDescontoSimplificado: usarSimplificado
        };
      }

      function recalcularTudo() {
        var inputBruto = document.getElementById('salario-bruto-input');
        var inputDep = document.getElementById('dependentes-input');
        var inputOutras = document.getElementById('outras-deducoes-input');
        var inputDias = document.getElementById('dias-trabalhados-input');
        var inputHe50 = document.getElementById('horas-extras-50-input');
        var inputHe100 = document.getElementById('horas-extras-100-input');
        var inputNoturno = document.getElementById('adicional-noturno-input');
        var inputPensao = document.getElementById('pensao-alimenticia-input');
        var inputVt = document.getElementById('vale-transporte-input');
        var inputOutrosDesc = document.getElementById('outros-descontos-folha-input');

        var salarioContratual = parseMoedaInput(inputBruto ? inputBruto.value : '5000');
        var dependentes = parseInt(inputDep ? inputDep.value : '0', 10) || 0;
        var outrasDeducoes = parseMoedaInput(inputOutras ? inputOutras.value : '0');
        var diasTrabalhados = parseInt(inputDias ? inputDias.value : '30', 10) || 30;
        if (diasTrabalhados < 1) diasTrabalhados = 1;
        if (diasTrabalhados > 30) diasTrabalhados = 30;

        var he50Horas = parseFloat(inputHe50 ? inputHe50.value : '0') || 0;
        var he100Horas = parseFloat(inputHe100 ? inputHe100.value : '0') || 0;
        var adicionalNoturno = parseMoedaInput(inputNoturno ? inputNoturno.value : '0');
        var pensaoAlimenticia = parseMoedaInput(inputPensao ? inputPensao.value : '0');
        var valeTransporte = parseMoedaInput(inputVt ? inputVt.value : '0');
        var outrosDescontosFolha = parseMoedaInput(inputOutrosDesc ? inputOutrosDesc.value : '0');

        // Cálculo proporcional aos dias trabalhados
        var salarioBaseEfetivo = diasTrabalhados < 30 ? (salarioContratual / 30) * diasTrabalhados : salarioContratual;

        // Horas extras
        var valorHora = salarioContratual / 220;
        var valorHe50 = he50Horas * valorHora * 1.50;
        var valorHe100 = he100Horas * valorHora * 2.00;
        var totalHe = valorHe50 + valorHe100;
        var valorDsr = totalHe > 0 ? (totalHe / 25) * 5 : 0; // estimativa oficial de reflexo DSR

        var salarioBrutoTotal = salarioBaseEfetivo + totalHe + valorDsr + adicionalNoturno;

        // INSS 2026
        var inssResultado = calcularINSS(salarioBrutoTotal);

        // IRRF 2026
        var irrfResultado = calcularIRRF(salarioBrutoTotal, inssResultado.descontoTotal, dependentes, outrasDeducoes, pensaoAlimenticia);

        // Outros descontos
        var totalOutrosDescontos = valeTransporte + outrosDescontosFolha + pensaoAlimenticia;
        var totalDescontosGerais = inssResultado.descontoTotal + irrfResultado.descontoIRRF + totalOutrosDescontos;
        var salarioLiquido = Math.max(0, salarioBrutoTotal - totalDescontosGerais);

        // Atualizar Card Hero Principal
        var elLiquido = document.getElementById('resultado-salario-liquido');
        if (elLiquido) elLiquido.textContent = formatarMoeda(salarioLiquido);

        var elResumoTexto = document.getElementById('resultado-resumo-texto');
        var percLiquido = salarioBrutoTotal > 0 ? (salarioLiquido / salarioBrutoTotal) : 0;
        if (elResumoTexto) {
          elResumoTexto.innerHTML = 'Você receberá aproximadamente <strong>' + formatarPercentual(percLiquido) + '</strong> do seu salário bruto após ' + formatarMoeda(totalDescontosGerais) + ' em descontos.';
        }

        var badgeIr = document.getElementById('badge-status-ir');
        if (badgeIr) {
          if (irrfResultado.isentoTotal2026) {
            badgeIr.textContent = 'Isenção Total do IRRF Aplicada';
            badgeIr.className = 'inline-flex items-center px-2.5 py-1 rounded text-xs font-mono font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400';
          } else if (irrfResultado.redutorAplicado > 0) {
            badgeIr.textContent = 'Faixa de Transição com Redutor 2026';
            badgeIr.className = 'inline-flex items-center px-2.5 py-1 rounded text-xs font-mono font-medium bg-cyan/10 text-cyan font-semibold';
          } else {
            badgeIr.textContent = 'Tabela Progressiva Integral';
            badgeIr.className = 'inline-flex items-center px-2.5 py-1 rounded text-xs font-mono font-medium bg-slate-500/10 text-slate-600 dark:text-slate-400';
          }
        }

        // Barra de Proporção
        var barraLiq = document.getElementById('barra-liquido');
        var barraInss = document.getElementById('barra-inss');
        var barraIrrf = document.getElementById('barra-irrf');
        var barraOutros = document.getElementById('barra-outros');
        var labelProp = document.getElementById('label-proporcao-liquido');

        if (barraLiq && barraInss && barraIrrf && barraOutros && salarioBrutoTotal > 0) {
          var pLiq = Math.max(0, (salarioLiquido / salarioBrutoTotal) * 100);
          var pInss = (inssResultado.descontoTotal / salarioBrutoTotal) * 100;
          var pIrrf = (irrfResultado.descontoIRRF / salarioBrutoTotal) * 100;
          var pOutros = (totalOutrosDescontos / salarioBrutoTotal) * 100;

          barraLiq.style.width = pLiq.toFixed(2) + '%';
          barraInss.style.width = pInss.toFixed(2) + '%';
          barraIrrf.style.width = pIrrf.toFixed(2) + '%';
          barraOutros.style.width = pOutros.toFixed(2) + '%';
          if (labelProp) labelProp.textContent = 'Salário Líquido: ' + formatarPercentual(percLiquido);
        }

        // Cards Secundários
        var cBruto = document.getElementById('card-salario-bruto');
        var cInss = document.getElementById('card-inss');
        var cAliqInss = document.getElementById('card-aliq-inss');
        var cBaseIr = document.getElementById('card-base-ir');
        var cIrrf = document.getElementById('card-irrf');
        var cAliqIrrf = document.getElementById('card-aliq-irrf');
        var cOutras = document.getElementById('card-outras-deducoes');
        var cTotDesc = document.getElementById('card-total-descontos');
        var cAliqTot = document.getElementById('card-aliq-total');

        if (cBruto) cBruto.textContent = formatarMoeda(salarioBrutoTotal);
        if (cInss) cInss.textContent = formatarMoeda(inssResultado.descontoTotal);
        if (cAliqInss) cAliqInss.textContent = 'Efetiva: ' + formatarPercentual(inssResultado.aliquotaEfetiva);
        if (cBaseIr) cBaseIr.textContent = formatarMoeda(irrfResultado.baseCalculo);
        if (cIrrf) cIrrf.textContent = formatarMoeda(irrfResultado.descontoIRRF);
        if (cAliqIrrf) {
          cAliqIrrf.textContent = irrfResultado.isentoTotal2026 ? 'Isenção 2026' : 'Efetiva: ' + formatarPercentual(irrfResultado.aliquotaEfetiva);
        }
        if (cOutras) cOutras.textContent = formatarMoeda(totalOutrosDescontos);
        if (cTotDesc) cTotDesc.textContent = formatarMoeda(totalDescontosGerais);
        if (cAliqTot) cAliqTot.textContent = formatarPercentual(salarioBrutoTotal > 0 ? totalDescontosGerais / salarioBrutoTotal : 0) + ' do bruto';

        // Tabela Demonstrativa Detalhada
        var corpoDet = document.getElementById('tabela-detalhamento-corpo');
        if (corpoDet) {
          var linhas = [];
          if (diasTrabalhados < 30) {
            linhas.push('<tr><td class="py-2 pr-4 font-semibold text-ink">Salário Proporcional (' + diasTrabalhados + ' dias)</td><td class="py-2 px-3 text-center text-mute text-[10px]">Art. 64 CLT</td><td class="py-2 px-3 text-right text-emerald-600 font-bold">' + formatarMoeda(salarioBaseEfetivo) + '</td><td class="py-2 pl-3 text-right text-mute">-</td></tr>');
          } else {
            linhas.push('<tr><td class="py-2 pr-4 font-semibold text-ink">Salário Base Mensal</td><td class="py-2 px-3 text-center text-mute text-[10px]">Contrato CLT</td><td class="py-2 px-3 text-right text-emerald-600 font-bold">' + formatarMoeda(salarioContratual) + '</td><td class="py-2 pl-3 text-right text-mute">-</td></tr>');
          }

          if (totalHe > 0) {
            linhas.push('<tr><td class="py-2 pr-4 text-ink">Horas Extras (' + (he50Horas + he100Horas) + 'h)</td><td class="py-2 px-3 text-center text-mute text-[10px]">Adicional 50% / 100%</td><td class="py-2 px-3 text-right text-emerald-600 font-bold">' + formatarMoeda(totalHe) + '</td><td class="py-2 pl-3 text-right text-mute">-</td></tr>');
            linhas.push('<tr><td class="py-2 pr-4 text-ink">Reflexo no DSR sobre Horas Extras</td><td class="py-2 px-3 text-center text-mute text-[10px]">Lei 605/1949</td><td class="py-2 px-3 text-right text-emerald-600 font-bold">' + formatarMoeda(valorDsr) + '</td><td class="py-2 pl-3 text-right text-mute">-</td></tr>');
          }

          if (adicionalNoturno > 0) {
            linhas.push('<tr><td class="py-2 pr-4 text-ink">Adicional Noturno</td><td class="py-2 px-3 text-center text-mute text-[10px]">Art. 73 CLT</td><td class="py-2 px-3 text-right text-emerald-600 font-bold">' + formatarMoeda(adicionalNoturno) + '</td><td class="py-2 pl-3 text-right text-mute">-</td></tr>');
          }

          // Descontos
          linhas.push('<tr><td class="py-2 pr-4 text-ink">Previdência Social (INSS 2026)</td><td class="py-2 px-3 text-center text-mute text-[10px]">Tabela Progressiva</td><td class="py-2 px-3 text-right text-mute">-</td><td class="py-2 pl-3 text-right text-amber-600 dark:text-amber-400 font-bold">' + formatarMoeda(inssResultado.descontoTotal) + '</td></tr>');

          if (irrfResultado.descontoIRRF > 0) {
            linhas.push('<tr><td class="py-2 pr-4 text-ink">Imposto de Renda Retido (IRRF)</td><td class="py-2 px-3 text-center text-mute text-[10px]">Novo IR 2026</td><td class="py-2 px-3 text-right text-mute">-</td><td class="py-2 pl-3 text-right text-rose-600 dark:text-rose-400 font-bold">' + formatarMoeda(irrfResultado.descontoIRRF) + '</td></tr>');
          } else {
            linhas.push('<tr><td class="py-2 pr-4 text-ink">Imposto de Renda (IRRF 2026)</td><td class="py-2 px-3 text-center text-emerald-600 text-[10px]">Isenção Total até R$ 5.000</td><td class="py-2 px-3 text-right text-mute">-</td><td class="py-2 pl-3 text-right text-emerald-600 font-bold">R$ 0,00</td></tr>');
          }

          if (valeTransporte > 0) {
            linhas.push('<tr><td class="py-2 pr-4 text-ink">Desconto de Vale-Transporte</td><td class="py-2 px-3 text-center text-mute text-[10px]">Lei 7.418/1985</td><td class="py-2 px-3 text-right text-mute">-</td><td class="py-2 pl-3 text-right text-rose-600 font-bold">' + formatarMoeda(valeTransporte) + '</td></tr>');
          }

          if (pensaoAlimenticia > 0) {
            linhas.push('<tr><td class="py-2 pr-4 text-ink">Pensão Alimentícia Judicial</td><td class="py-2 px-3 text-center text-mute text-[10px]">Ordem Judicial</td><td class="py-2 px-3 text-right text-mute">-</td><td class="py-2 pl-3 text-right text-rose-600 font-bold">' + formatarMoeda(pensaoAlimenticia) + '</td></tr>');
          }

          if (outrosDescontosFolha > 0) {
            linhas.push('<tr><td class="py-2 pr-4 text-ink">Outros Descontos em Folha</td><td class="py-2 px-3 text-center text-mute text-[10px]">Benefícios / Acordo</td><td class="py-2 px-3 text-right text-mute">-</td><td class="py-2 pl-3 text-right text-rose-600 font-bold">' + formatarMoeda(outrosDescontosFolha) + '</td></tr>');
          }

          corpoDet.innerHTML = linhas.join('');
        }

        var elTotLiq = document.getElementById('tabela-total-liquido');
        if (elTotLiq) elTotLiq.textContent = formatarMoeda(salarioLiquido);

        // Tabela de Faixas Progressivas do INSS
        var corpoInss = document.getElementById('tabela-faixas-inss-corpo');
        if (corpoInss) {
          var faixasInssHtml = [];
          for (var j = 0; j < inssResultado.faixasDetalhadas.length; j++) {
            var fx = inssResultado.faixasDetalhadas[j];
            faixasInssHtml.push('<tr><td class="py-2 pr-3">' + fx.faixaTexto + '</td><td class="py-2 px-3 text-center font-bold">' + fx.aliquotaTexto + '</td><td class="py-2 px-3 text-right font-mono">' + formatarMoeda(fx.baseCalculoFaixa) + '</td><td class="py-2 pl-3 text-right font-mono font-bold text-ink">' + formatarMoeda(fx.valorDescontado) + '</td></tr>');
          }
          corpoInss.innerHTML = faixasInssHtml.join('');
        }

        var elTotInss = document.getElementById('total-faixas-inss');
        if (elTotInss) elTotInss.textContent = formatarMoeda(inssResultado.descontoTotal);

        // Atualizar Relatório de Impressão / PDF
        atualizarRelatorioImpressao(salarioBrutoTotal, salarioLiquido, inssResultado, irrfResultado, totalOutrosDescontos, totalDescontosGerais, dependentes, outrasDeducoes, diasTrabalhados);
      }

      function atualizarRelatorioImpressao(bruto, liquido, inss, irrf, outros, totalDesc, dep, outrasDed, dias) {
        var pBruto = document.getElementById('print-salario-bruto');
        var pDep = document.getElementById('print-dependentes');
        var pOutras = document.getElementById('print-outras-deducoes');
        var pDias = document.getElementById('print-dias');
        var pLiq = document.getElementById('print-salario-liquido');
        var pResumo = document.getElementById('print-resumo-subtitulo');
        var pCorpo = document.getElementById('print-tabela-corpo');

        if (pBruto) pBruto.textContent = formatarMoeda(bruto);
        if (pDep) pDep.textContent = String(dep);
        if (pOutras) pOutras.textContent = formatarMoeda(outrasDed);
        if (pDias) pDias.textContent = dias + ' dias';
        if (pLiq) pLiq.textContent = formatarMoeda(liquido);

        var perc = bruto > 0 ? (totalDesc / bruto) : 0;
        if (pResumo) pResumo.textContent = 'Descontos totais de ' + formatarMoeda(totalDesc) + ' (' + formatarPercentual(perc) + ' do total de proventos)';

        if (pCorpo) {
          var rows = [
            '<tr><td class="py-1.5 px-2.5 font-bold text-blue-700">Salário Bruto Total</td><td class="py-1.5 px-2.5 text-center font-mono">Integral / Proporcional</td><td class="py-1.5 px-2.5 text-right font-mono">' + formatarMoeda(bruto) + '</td><td class="py-1.5 px-2.5 text-right font-mono text-slate-400">-</td></tr>',
            '<tr><td class="py-1.5 px-2.5 text-slate-800">Desconto INSS 2026</td><td class="py-1.5 px-2.5 text-center font-mono">Efetiva: ' + formatarPercentual(inss.aliquotaEfetiva) + '</td><td class="py-1.5 px-2.5 text-right font-mono text-slate-400">-</td><td class="py-1.5 px-2.5 text-right font-mono">' + formatarMoeda(inss.descontoTotal) + '</td></tr>',
            '<tr><td class="py-1.5 px-2.5 text-slate-800">Desconto IRRF 2026</td><td class="py-1.5 px-2.5 text-center font-mono">' + (irrf.isentoTotal2026 ? 'Isenção até R$ 5.000' : 'Efetiva: ' + formatarPercentual(irrf.aliquotaEfetiva)) + '</td><td class="py-1.5 px-2.5 text-right font-mono text-slate-400">-</td><td class="py-1.5 px-2.5 text-right font-mono">' + formatarMoeda(irrf.descontoIRRF) + '</td></tr>'
          ];
          if (outros > 0) {
            rows.push('<tr><td class="py-1.5 px-2.5 text-slate-800">Outros Descontos e Benefícios</td><td class="py-1.5 px-2.5 text-center font-mono">Folha</td><td class="py-1.5 px-2.5 text-right font-mono text-slate-400">-</td><td class="py-1.5 px-2.5 text-right font-mono">' + formatarMoeda(outros) + '</td></tr>');
          }
          rows.push('<tr class="border-t-2 border-slate-900 font-bold bg-slate-50"><td class="py-2 px-2.5 text-slate-900">Salário Líquido Final a Receber</td><td class="py-2 px-2.5 text-center font-mono text-xs">Crédito em Conta</td><td class="py-2 px-2.5 text-right font-mono text-blue-700" colspan="2">' + formatarMoeda(liquido) + '</td></tr>');
          pCorpo.innerHTML = rows.join('');
        }
      }

      function formatarCampoMoeda(e) {
        var input = e.target;
        var valor = parseMoedaInput(input.value);
        if (valor > 0 || input.value.trim() !== '') {
          input.value = valor.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
      }

      // Inicialização dos eventos do DOM
      document.addEventListener('DOMContentLoaded', function () {
        var btnCalcular = document.getElementById('calcular-salario-btn');
        var btnLimpar = document.getElementById('limpar-formulario-btn');
        var toggleAvancadas = document.getElementById('toggle-opcoes-avancadas-btn');
        var secaoAvancadas = document.getElementById('secao-opcoes-avancadas');
        var iconeAvancadas = document.getElementById('icone-opcoes-avancadas');

        if (btnCalcular) {
          btnCalcular.addEventListener('click', recalcularTudo);
        }

        if (btnLimpar) {
          btnLimpar.addEventListener('click', function () {
            var form = document.getElementById('salary-calculator-form');
            if (form) form.reset();
            var inputBruto = document.getElementById('salario-bruto-input');
            if (inputBruto) inputBruto.value = '5.000,00';
            var inputDep = document.getElementById('dependentes-input');
            if (inputDep) inputDep.value = '0';
            var inputOutras = document.getElementById('outras-deducoes-input');
            if (inputOutras) inputOutras.value = '0,00';
            var inputDias = document.getElementById('dias-trabalhados-input');
            if (inputDias) inputDias.value = '30';
            recalcularTudo();
          });
        }

        if (toggleAvancadas && secaoAvancadas && iconeAvancadas) {
          toggleAvancadas.addEventListener('click', function () {
            var fechado = secaoAvancadas.classList.contains('hidden');
            if (fechado) {
              secaoAvancadas.classList.remove('hidden');
              toggleAvancadas.setAttribute('aria-expanded', 'true');
              iconeAvancadas.style.transform = 'rotate(180deg)';
            } else {
              secaoAvancadas.classList.add('hidden');
              toggleAvancadas.setAttribute('aria-expanded', 'false');
              iconeAvancadas.style.transform = 'rotate(0deg)';
            }
          });
        }

        // Recalcular dinamicamente ao digitar
        var inputsMonitorados = [
          'salario-bruto-input',
          'dependentes-input',
          'outras-deducoes-input',
          'dias-trabalhados-input',
          'horas-extras-50-input',
          'horas-extras-100-input',
          'adicional-noturno-input',
          'pensao-alimenticia-input',
          'vale-transporte-input',
          'outros-descontos-folha-input'
        ];

        inputsMonitorados.forEach(function (id) {
          var el = document.getElementById(id);
          if (el) {
            el.addEventListener('input', recalcularTudo);
            el.addEventListener('blur', formatarCampoMoeda);
          }
        });

        // Botão Copiar Resultado
        var btnCopiar = document.getElementById('salario-copiar-btn');
        var textoCopiar = document.getElementById('salario-copiar-texto');
        if (btnCopiar && textoCopiar) {
          btnCopiar.addEventListener('click', function () {
            var elLiq = document.getElementById('resultado-salario-liquido');
            var valLiq = elLiq ? elLiq.textContent : 'R$ 4.498,49';
            var elBruto = document.getElementById('salario-bruto-input');
            var valBruto = elBruto ? elBruto.value : '5.000,00';

            var texto = 'Simulação de Salário Líquido 2026:\n' +
              'Salário Bruto: R$ ' + valBruto + '\n' +
              'Salário Líquido Estimado: ' + valLiq + '\n' +
              'Calculado no Free Accurate Calculator (https://freeaccuratecalculator.com/calculadora-salario/pt)';

            navigator.clipboard.writeText(texto).then(function () {
              textoCopiar.textContent = 'Resultado Copiado!';
              setTimeout(function () {
                textoCopiar.textContent = 'Copiar Resultado';
              }, 2500);
            });
          });
        }

        // Botão Compartilhar
        var btnCompartilhar = document.getElementById('salario-compartilhar-btn');
        if (btnCompartilhar) {
          btnCompartilhar.addEventListener('click', function () {
            var url = 'https://freeaccuratecalculator.com/calculadora-salario/pt';
            if (navigator.share) {
              navigator.share({
                title: 'Calculadora de Salário Líquido 2026',
                text: 'Calcule seu salário líquido de 2026 com base nas regras oficiais do INSS e Novo IR:',
                url: url
              }).catch(function () {});
            } else {
              navigator.clipboard.writeText(url).then(function () {
                alert('Link da calculadora copiado para a área de transferência!');
              });
            }
          });
        }

        // Botão Baixar CSV
        var btnCsv = document.getElementById('salario-baixar-csv-btn');
        if (btnCsv) {
          btnCsv.addEventListener('click', function () {
            var elBruto = document.getElementById('card-salario-bruto');
            var elInss = document.getElementById('card-inss');
            var elIrrf = document.getElementById('card-irrf');
            var elOutros = document.getElementById('card-outras-deducoes');
            var elLiq = document.getElementById('resultado-salario-liquido');

            var csvContent = 'data:text/csv;charset=utf-8,\uFEFF' +
              'Item;Valor;Observacao\n' +
              'Salário Bruto Total;' + (elBruto ? elBruto.textContent : '') + ';Proventos\n' +
              'Desconto INSS 2026;' + (elInss ? elInss.textContent : '') + ';Tabela Progressiva\n' +
              'Desconto IRRF 2026;' + (elIrrf ? elIrrf.textContent : '') + ';Novo IR 2026\n' +
              'Outros Descontos;' + (elOutros ? elOutros.textContent : '') + ';Folha e Benefícios\n' +
              'Salário Líquido Final;' + (elLiq ? elLiq.textContent : '') + ';Valor Creditado em Conta\n';

            var encodedUri = encodeURI(csvContent);
            var link = document.createElement('a');
            link.setAttribute('href', encodedUri);
            link.setAttribute('download', 'salario-liquido-2026-estimativa.csv');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
          });
        }

        // Sincronização prévia antes de imprimir
        window.addEventListener('fac:before-pdf-print', recalcularTudo);

        // Executar cálculo inicial
        recalcularTudo();
      });
    })();
  </script>
</CalculatorLayout>

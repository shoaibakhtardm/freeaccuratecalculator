---
// src/pages/calculadora-edad/es/index.astro
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import FormulaSection from '../../../components/calculator/FormulaSection.astro';
import WorkedExample from '../../../components/calculator/WorkedExample.astro';
import FAQSection from '../../../components/calculator/FAQSection.astro';

const faqs = [
  {
    question: '¿Cómo calcula esta herramienta la edad cronológica exacta?',
    answer:
      'La calculadora resta tu fecha y hora exacta de nacimiento del momento presente o de una fecha objetivo determinada. Toma en cuenta la duración real de cada mes del calendario gregoriano (28, 29, 30 o 31 días) y los años bisiestos para proporcionar un desglose 100% exacto en años, meses, días, horas, minutos y segundos en tiempo real.',
  },
  {
    question: '¿Por qué la calculadora restringe las fechas de nacimiento futuras?',
    answer:
      'La edad cronológica mide el tiempo transcurrido desde el momento del nacimiento hasta el presente. Una fecha de nacimiento situada en el futuro constituye una imposibilidad matemática para la edad vivida, por lo que la calculadora aplica una validación estricta en el navegador que impide ingresar fechas posteriores al día actual.',
  },
  {
    question: '¿Cómo funciona el contador de segundos en tiempo real?',
    answer:
      'El motor de cómputo en el cliente ejecuta un ciclo de alta precisión a intervalos de un segundo directamente en tu navegador. Con cada segundo transcurrido, se actualizan al instante el total de segundos vividos, las horas transcurridas y la cuenta regresiva para tu próximo cumpleaños, sin necesidad de recargar la página.',
  },
  {
    question: '¿Cómo se calcula la cuenta regresiva para el próximo cumpleaños?',
    answer:
      'El algoritmo comprueba si la fecha de tu cumpleaños ya ocurrió en el año calendario en curso. Si ya pasó, establece como objetivo tu aniversario del próximo año; en caso contrario, toma la fecha venidera de este año, calculando con exactitud los meses, días, horas, minutos y segundos restantes.',
  },
  {
    question: '¿Son privados mi fecha de nacimiento y mis datos personales?',
    answer:
      'Sí, 100% privados y confidenciales. Todos los cálculos se ejecutan exclusivamente en tu dispositivo mediante JavaScript en el navegador. Ninguna fecha, hora ni dato personal se envía, almacena ni registra en servidores externos.',
  },
];

const relatedCalculators = [
  { title: 'Calculadora de Fechas', href: '/date-calculator/', badge: 'Cotidiana' },
  { title: 'Calculadora de Tiempo', href: '/time-calculator/', badge: 'Tiempo' },
  { title: 'Calculadora de Horas', href: '/hours-calculator/', badge: 'Horas' },
  { title: 'Calculadora de Porcentajes', href: '/percentage-calculator/', badge: 'Matemáticas' },
];

const workedExampleSteps = [
  {
    number: 1,
    title: 'Calcular los Años Naturales Completos',
    description: 'Resta el año de nacimiento del año objetivo o actual, ajustando hacia atrás en 1 año si el aniversario aún no se ha cumplido en el año de referencia.',
    mathExpression: 'Años = 2026 - 2000 = 26 años completos',
  },
  {
    number: 2,
    title: 'Calcular los Meses y Días Naturales Restantes',
    description: 'Cuenta los meses naturales completos transcurridos desde el último día mensual cumplido, tomando en consideración los días reales (28 a 31) de los meses intermedios.',
    mathExpression: 'Meses = 2, Días = 14',
  },
  {
    number: 3,
    title: 'Calcular Unidades Granulares (Días, Horas, Minutos y Segundos)',
    description: 'Convierte el total de milisegundos transcurridos en días solares completos, horas acumuladas, minutos y segundos exactos mediante el diferencial temporal.',
    mathExpression: 'Total de Segundos = Milisegundos Totales ÷ 1.000',
  },
];

const now = new Date();
const todayDateString = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
const currentYear = now.getFullYear();
---

<CalculatorLayout
  title="Calculadora de Edad: Calcula tu Edad Exacta Gratis"
  metaDescription="Calcula tu edad exacta en años, meses, días y segundos en tiempo real. Cuenta regresiva para tu cumpleaños y cálculo 100% gratis y preciso."
  h1="Calculadora de edad"
  subtitle="Calcula tu edad exacta desglosada en años, meses, días, horas, minutos y segundos en tiempo real con validación estricta de fechas."
  category={{ label: 'Herramientas Cotidianas', href: '/everyday/' }}
  calculatorName="Calculadora de Edad"
  relatedCalculators={relatedCalculators}
  faqs={faqs}
  lang="es"
>
  <!-- Caja Principal de la Calculadora (Diseño Estándar) -->
  <div id="age-calculator-card" class="calculator-main-box relative rounded-[20px] border border-hairline bg-canvas-elevated p-4 sm:p-8 shadow-whisper space-y-6 overflow-hidden transition-all pb-24 sm:pb-8">
    <!-- Resplandor Ambiental Sutil en Gradiente -->
    <div class="pointer-events-none absolute -top-32 -right-32 w-80 h-80 rounded-full bg-link/10 blur-3xl print:hidden"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-32 w-80 h-80 rounded-full bg-cyan/10 blur-3xl print:hidden"></div>

    <!-- Informe Dedicado de Alta Fidelidad para Imprimir/PDF (Visible SOLO al imprimir) -->
    <div id="age-print-report" class="hidden print:block font-mono text-slate-900 fac-print-report">
      <!-- Membrete Oficial del Encabezado -->
      <div class="border-b-2 border-slate-900 pb-4 mb-5 flex justify-between items-start">
        <div>
          <div class="text-2xl font-black uppercase tracking-tight">Free Accurate Calculator</div>
          <div class="text-sm font-bold text-blue-700 mt-0.5">Informe de Edad Cronológica e Hitos Temporales</div>
          <div class="text-xs text-slate-500 mt-1">freeaccuratecalculator.com • Certificado de Cronología Gregoriana Verificada</div>
        </div>
        <div class="text-right text-xs text-slate-600 space-y-0.5">
          <div><span class="text-slate-400 uppercase">Generado:</span> <strong id="age-print-date" class="text-slate-900"></strong></div>
          <div><span class="text-slate-400 uppercase">Método de Cálculo:</span> <strong class="text-slate-900">Diferencial Solar y de Calendario Exacto</strong></div>
        </div>
      </div>

      <!-- Parámetros Cronométricos -->
      <div class="bg-slate-50 border border-slate-200 rounded-lg p-3.5 mb-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Parámetros Cronológicos</div>
        <div class="grid grid-cols-4 gap-4 text-xs">
          <div><span class="text-slate-500 block text-[10px] uppercase">Fecha de Nacimiento</span><span id="age-print-birth" class="text-sm font-bold text-slate-900"></span></div>
          <div><span class="text-slate-500 block text-[10px] uppercase">Edad a Fecha de</span><span id="age-print-target" class="text-sm font-bold text-slate-900"></span></div>
          <div><span class="text-slate-500 block text-[10px] uppercase">Día de Nacimiento</span><span id="age-print-day" class="text-sm font-bold text-slate-900"></span></div>
          <div><span class="text-slate-500 block text-[10px] uppercase">Signos Zodiacales</span><span id="age-print-zodiac" class="text-sm font-bold text-slate-900"></span></div>
        </div>
      </div>

      <!-- Resultado Principal de Edad -->
      <div class="border-2 border-slate-900 rounded-lg p-4 bg-slate-50 mb-6">
        <span class="text-[10px] font-bold uppercase text-slate-900 block">Edad Cronológica Exacta</span>
        <div id="age-print-hero" class="text-2xl font-black text-slate-900 mt-1"></div>
        <div id="age-print-ticker" class="text-xs text-slate-600 mt-1"></div>
      </div>

      <!-- Tabla de Desglose Detallado de Tiempo de Vida -->
      <div class="space-y-2 mb-6">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Desglose Detallado de Vida e Hitos Fisiológicos</div>
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b-2 border-slate-300 bg-slate-100 text-slate-700">
              <th class="py-2 px-2.5">Unidad de Tiempo / Métrica</th>
              <th class="py-2 px-2.5 text-right">Cantidad Transcurrida</th>
              <th class="py-2 px-2.5">Descripción</th>
            </tr>
          </thead>
          <tbody id="age-print-table-body" class="divide-y divide-slate-200">
            <!-- Rellenado dinámicamente -->
          </tbody>
        </table>
      </div>

      <!-- Pie de página del informe -->
      <div class="mt-8 pt-3 border-t border-slate-200 flex justify-between items-center text-[10px] text-slate-500">
        <div>Generado por <strong>Free Accurate Calculator</strong> • https://freeaccuratecalculator.com</div>
        <div>Cálculo verificado 100% en el cliente • Totalmente Privado</div>
      </div>
    </div>

    <!-- Contenedor de Interfaz en Pantalla (Oculto al imprimir) -->
    <div class="print:hidden space-y-6">
      <!-- Controles Superiores: Modo y Alternador en Vivo -->
      <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-4 text-xs">
        <div class="flex items-center gap-2">
          <span class="mono-eyebrow text-mute">Modo de Entrada:</span>
          <div class="inline-flex rounded-[6px] border border-hairline bg-canvas p-0.5" role="tablist" aria-label="Modo de entrada de fecha">
            <button
              id="tab-datepicker-btn"
              type="button"
              role="tab"
              aria-selected="true"
              class="rounded-[4px] bg-primary px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-on-primary cursor-pointer transition-colors"
            >
              📅 Selector de Calendario
            </button>
            <button
              id="tab-dropdown-btn"
              type="button"
              role="tab"
              aria-selected="false"
              class="rounded-[4px] px-3.5 py-2 sm:py-1.5 min-h-[44px] sm:min-h-[28px] text-xs font-medium text-ink cursor-pointer hover:bg-hairline-soft transition-colors"
            >
              🔢 Día / Mes / Año
            </button>
          </div>
        </div>

        <!-- Selector de Contador en Tiempo Real -->
        <div class="flex items-center gap-2">
          <span class="mono-eyebrow text-mute">Reloj en Vivo:</span>
          <button
            id="toggle-ticker-btn"
            type="button"
            aria-pressed="true"
            aria-label="Alternar actualización en vivo de segundos"
            class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas px-3 py-1.5 min-h-[44px] sm:min-h-[30px] text-xs font-mono font-medium text-ink hover:border-link transition-colors cursor-pointer"
          >
            <span id="ticker-status-dot" class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            <span id="ticker-status-text">En vivo (Activo)</span>
          </button>
        </div>
      </div>

      <!-- Banner de Error (Oculto por defecto, visible para fechas futuras) -->
      <div
        id="future-date-error"
        role="alert"
        class="hidden rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-xs sm:text-sm font-mono text-red-600 dark:text-red-400 space-y-1"
      >
        <div class="flex items-center gap-2 font-bold">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span>Límite de Fecha Futura Excedido</span>
        </div>
        <p>La fecha de nacimiento no puede ser futura. Por favor selecciona la fecha de hoy o una fecha anterior.</p>
      </div>

      <!-- Área de Campos del Formulario -->
      <div class="space-y-5">
        <!-- 1. Sección de Fecha de Nacimiento -->
        <div id="mode-datepicker" class="space-y-2">
          <label for="birth-date-input" class="block text-xs font-semibold text-ink uppercase font-mono">
            Fecha de Nacimiento <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <input
              id="birth-date-input"
              type="date"
              value="2000-01-01"
              max={todayDateString}
              aria-label="Fecha de nacimiento en formato calendario"
              class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas px-3.5 py-2.5 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
            />
          </div>
          <p class="text-[11px] text-mute font-mono">Selecciona tu fecha exacta de nacimiento. Las fechas futuras están estrictamente restringidas.</p>
        </div>

        <!-- Modo de Entrada Alternativo con Desplegables -->
        <div id="mode-dropdown" class="hidden space-y-2">
          <span class="block text-xs font-semibold text-ink uppercase font-mono">
            Fecha de Nacimiento (Día / Mes / Año) <span class="text-red-500">*</span>
          </span>
          <div class="grid grid-cols-3 gap-3">
            <div>
              <label for="birth-day-select" class="sr-only">Día de Nacimiento</label>
              <select
                id="birth-day-select"
                aria-label="Día de nacimiento"
                class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas px-3 py-2 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
              >
                {Array.from({ length: 31 }, (_, i) => i + 1).map((d) => (
                  <option value={d} selected={d === 1}>{d}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="birth-month-select" class="sr-only">Mes de Nacimiento</label>
              <select
                id="birth-month-select"
                aria-label="Mes de nacimiento"
                class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas px-3 py-2 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
              >
                {[
                  { val: 1, name: 'Ene (01)' },
                  { val: 2, name: 'Feb (02)' },
                  { val: 3, name: 'Mar (03)' },
                  { val: 4, name: 'Abr (04)' },
                  { val: 5, name: 'May (05)' },
                  { val: 6, name: 'Jun (06)' },
                  { val: 7, name: 'Jul (07)' },
                  { val: 8, name: 'Ago (08)' },
                  { val: 9, name: 'Sep (09)' },
                  { val: 10, name: 'Oct (10)' },
                  { val: 11, name: 'Nov (11)' },
                  { val: 12, name: 'Dic (12)' },
                ].map((m) => (
                  <option value={m.val} selected={m.val === 1}>{m.name}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="birth-year-input" class="sr-only">Año de Nacimiento</label>
              <input
                id="birth-year-input"
                type="number"
                min="1900"
                max={currentYear}
                value="2000"
                placeholder="Año (ej. 2000)"
                aria-label="Año de nacimiento"
                class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas px-3 py-2 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
              />
            </div>
          </div>
        </div>

        <!-- Despliegue Opcional de Hora de Nacimiento -->
        <div class="rounded-xl border border-hairline bg-canvas/60 p-4 space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-ink">⏰ Hora Exacta de Nacimiento</span>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono bg-link/10 text-link">Precisión al segundo en vivo</span>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input id="enable-time-toggle" type="checkbox" aria-label="Habilitar hora exacta de nacimiento" class="sr-only peer" />
              <div class="w-9 h-5 bg-hairline peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-link"></div>
            </label>
          </div>

          <div id="birth-time-container" class="hidden grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-hairline">
            <div>
              <label for="birth-time-input" class="block text-[11px] font-semibold text-mute uppercase font-mono mb-1">
                Hora de Nacimiento (HH:MM)
              </label>
              <input
                id="birth-time-input"
                type="time"
                value="12:00"
                aria-label="Hora exacta de nacimiento"
                class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas px-3 py-2 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none"
              />
            </div>
            <div class="flex items-center text-xs text-mute leading-relaxed pt-2 sm:pt-4">
              <span>Activar la hora permite calcular en tiempo real hasta el segundo exacto desde tu nacimiento.</span>
            </div>
          </div>
        </div>

        <!-- Edad a la Fecha (Comparación Opcional) -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="target-date-input" class="block text-xs font-semibold text-ink uppercase font-mono">
              Calcular Edad a Fecha de (Fecha Objetivo)
            </label>
            <button
              id="reset-target-today-btn"
              type="button"
              class="text-[11px] font-mono text-link hover:underline cursor-pointer"
            >
              Restablecer a Hoy
            </button>
          </div>
          <input
            id="target-date-input"
            type="date"
            value={todayDateString}
            aria-label="Fecha objetivo para calcular la edad"
            class="w-full min-h-[44px] rounded-[6px] border border-hairline bg-canvas px-3.5 py-2.5 text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
          />
          <p class="text-[11px] text-mute font-mono">Por defecto toma el día de hoy para seguimiento cronológico en tiempo real. Puedes modificarla para calcular tu edad en cualquier fecha específica.</p>
        </div>
      </div>

      <!-- Tarjeta de Resultado Principal en Tiempo Real (Hero) -->
      <div
        id="age-hero-card"
        aria-live="polite"
        class="rounded-2xl border border-link/30 bg-gradient-to-br from-link/5 via-canvas to-link/10 p-6 sm:p-8 relative overflow-hidden transition-all shadow-whisper space-y-5"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-hairline pb-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-link animate-ping"></span>
            <span class="mono-eyebrow text-xs uppercase tracking-wider text-link font-bold">Edad Cronológica Exacta</span>
          </div>
          <div class="flex items-center gap-2">
            <button
              id="copy-age-btn"
              type="button"
              class="inline-flex items-center gap-1 text-xs font-mono text-link hover:underline cursor-pointer px-2 py-1 rounded border border-hairline bg-canvas"
              title="Copiar resumen de edad al portapapeles"
              aria-label="Copiar resultado de edad"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-age-text">Copiar Resultado</span>
            </button>
          </div>
        </div>

        <!-- Contador Principal: Años, Meses, Días -->
        <div class="space-y-2">
          <div class="text-3xl sm:text-5xl font-extrabold font-mono text-ink tracking-tight flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span id="hero-years">0</span> <span class="text-lg sm:text-2xl font-bold text-mute">Años</span>
            <span id="hero-months">0</span> <span class="text-lg sm:text-2xl font-bold text-mute">Meses</span>
            <span id="hero-days">0</span> <span class="text-lg sm:text-2xl font-bold text-mute">Días</span>
          </div>

          <!-- Contador Secundario en Tiempo Real: Horas, Minutos, Segundos -->
          <div class="flex items-center gap-2 text-sm sm:text-lg font-mono font-semibold text-link pt-1">
            <span>⏳</span>
            <span id="hero-hours">00</span><span>h</span> :
            <span id="hero-minutes">00</span><span>m</span> :
            <span id="hero-seconds" class="inline-block min-w-[28px] text-ink font-bold">00</span><span>s</span>
            <span class="text-xs font-mono text-mute font-normal">(segundos en vivo)</span>
          </div>
        </div>

        <!-- Banner del Día de la Semana de Nacimiento -->
        <div class="rounded-xl border border-hairline bg-canvas p-3.5 flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
          <div class="flex items-center gap-2">
            <span class="text-base">🎂</span>
            <span class="text-mute">Naciste un:</span>
            <strong id="born-day-name" class="text-ink font-bold text-sm">--</strong>
          </div>
          <div class="flex items-center gap-3 text-mute text-[11px]">
            <span>Signo del Zodíaco: <strong id="zodiac-sign" class="text-ink">--</strong></span>
            <span>Horóscopo Chino: <strong id="chinese-zodiac" class="text-ink">--</strong></span>
          </div>
        </div>
      </div>

      <!-- Cuadrícula de Desglose de Unidades (Días, Horas, Minutos, Segundos) -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-ink uppercase font-mono tracking-wider">
          Desglose Detallado del Tiempo de Vida (Unidades Totales)
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <!-- Total de Días -->
          <div class="rounded-xl border border-hairline bg-canvas p-4 text-center space-y-1">
            <span class="text-[10px] font-mono text-mute uppercase tracking-wider block">Total de Días Vividos</span>
            <div id="metric-total-days" class="text-xl sm:text-2xl font-extrabold font-mono text-ink tracking-tight">0</div>
            <span class="text-[10px] font-mono text-mute block">Períodos de 24 horas</span>
          </div>

          <!-- Total de Horas -->
          <div class="rounded-xl border border-hairline bg-canvas p-4 text-center space-y-1">
            <span class="text-[10px] font-mono text-mute uppercase tracking-wider block">Total de Horas</span>
            <div id="metric-total-hours" class="text-xl sm:text-2xl font-extrabold font-mono text-ink tracking-tight">0</div>
            <span class="text-[10px] font-mono text-mute block">Horas transcurridas</span>
          </div>

          <!-- Total de Minutos -->

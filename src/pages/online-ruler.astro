---
// src/pages/online-ruler.astro
// Flagship Online Ruler — Everyday tools ecosystem, canonical URL /online-ruler/
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import FAQSection from '../components/calculator/FAQSection.astro';

const faqs = [
  {
    question: 'What is an online ruler?',
    answer:
      'An online ruler is a browser-based measuring tool that renders a calibrated scale on your screen, so you can measure small physical objects in centimeters, millimeters, or inches without downloading anything. Free Accurate Calculator\u2019s version also supports direct on-screen measurement, draggable guides, and a crosshair with a live coordinate readout.',
  },
  {
    question: 'How do I use an online ruler?',
    answer:
      'Place the object you want to measure directly against the edge of the on-screen ruler, then read the value at the object\u2019s far edge. For best results, calibrate the ruler first (a bank card takes about a minute) and make sure browser zoom is at 100%, because zoom changes how large the scale appears.',
  },
  {
    question: 'How do I measure centimeters online?',
    answer:
      'Switch the unit control to CM, place the object against the top or left ruler edge, and read the major tick closest to the object\u2019s end. Each major tick is one centimeter and each small tick is one millimeter. The Measure mode also shows the result in cm, mm, and inches at once.',
  },
  {
    question: 'How do I measure inches online?',
    answer:
      'Switch the unit control to IN and read the ruler in inch marks \u2014 large ticks are whole inches, medium ticks are half and quarter inches, and minor ticks are sixteenths. If the scale has not been calibrated, calibrate with a card or your screen diagonal first for trustworthy inch values.',
  },
  {
    question: 'How do I measure millimeters online?',
    answer:
      'Switch the unit control to MM. Every minor tick is exactly one millimeter and labeled ticks appear every ten millimeters. Millimeters are ideal for small objects like coins, screws, or jewelry because the scale shows the finest detail.',
  },
  {
    question: 'Can I use my phone as a ruler?',
    answer:
      'Yes. The ruler is fully touch-enabled and mobile-optimized: drag guides with your finger, use calibration sized for phones, and rotate to landscape for longer objects. Phone screens are small, so objects longer than the visible ruler require measuring in two passes and adding the values.',
  },
  {
    question: 'Can I use a laptop screen as a ruler?',
    answer:
      'Yes \u2014 that is exactly what this tool does. Calibrate with your laptop\u2019s screen diagonal (e.g. 13.3\u2033, 14\u2033, 15.6\u2033) plus its resolution, or align a bank card against the card rectangle for a direct physical reference. Then place flat objects against the screen edge and read the scale.',
  },
  {
    question: 'How do I calibrate an online ruler?',
    answer:
      'Open Calibrate and pick a method: Auto estimate (fastest, least precise), Device preset (pick your device category), Screen diagonal (enter your display size and resolution), or a physical reference such as a bank card \u2014 drag the card rectangle until it matches the real card held against the screen. Your calibration is saved in your browser for next time.',
  },
  {
    question: 'Why does an online ruler need calibration?',
    answer:
      'Screens differ in pixel density, and browsers cannot read the physical dimensions of your display. Without calibration the tool must guess pixels-per-inch from typical device data, which can be off by a noticeable margin. Calibration replaces that guess with your device\u2019s real geometry or a physical reference.',
  },
  {
    question: 'Is an online ruler accurate?',
    answer:
      'With physical-reference calibration, an online ruler is accurate enough for school, crafts, sewing, and quick DIY checks \u2014 typically within about half a millimeter on a careful alignment. Without calibration it is an estimate that can be off by several percent. It is not a substitute for a certified measuring instrument.',
  },
  {
    question: 'How do I make an online ruler actual size?',
    answer:
      'Calibrate with a physical reference: hold any standard bank card against the card rectangle in the calibration dialog and resize the rectangle until the edges match exactly. Save the calibration \u2014 the ruler then shows true actual size on your display. Keep browser zoom at 100% when measuring.',
  },
  {
    question: 'Does browser zoom affect ruler accuracy?',
    answer:
      'Yes, significantly. Zoom changes how many CSS pixels the ruler occupies for a physical distance, so a calibrated scale at 110% zoom is overstated by roughly 10%. The ruler detects zoom changes and shows a warning; reset zoom to 100% (Ctrl/Cmd + 0) before measuring.',
  },
  {
    question: 'What is 1 inch in centimeters?',
    answer:
      'One inch is exactly 2.54 centimeters (25.4 millimeters) by international definition. The ruler\u2019s conversion engine uses this exact factor for every readout, so inch and metric scales always agree.',
  },
  {
    question: 'What is 1 centimeter in millimeters?',
    answer:
      'One centimeter is exactly 10 millimeters. The ruler\u2019s metric scales are built on this relationship: minor ticks are millimeters and every tenth tick is a labeled centimeter.',
  },
  {
    question: 'Can I measure an object directly on my screen?',
    answer:
      'Yes. Enable Measure mode, click or tap a start point, then drag to the end point. The tool shows the distance in your selected unit plus conversions in mm, cm, and inches \u2014 useful for measuring on-screen elements like photos or UI mockups.',
  },
];

const relatedCalculators = [
  { title: 'Length Converter', href: '/length-converter/' },
  { title: 'Unit Conversion Calculator', href: '/conversion-calculator/' },
  { title: 'Percentage Calculator', href: '/percentage-calculator/' },
  { title: 'Age Calculator', href: '/age-calculator/' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://freeaccuratecalculator.com/online-ruler/#webapp',
      'url': 'https://freeaccuratecalculator.com/online-ruler/',
      'name': 'Online Ruler — Free Accurate Ruler in cm, mm & Inches',
      'applicationCategory': 'UtilitiesApplication',
      'operatingSystem': 'All',
      'browserRequirements': 'Requires JavaScript. Requires HTML5.',
      'description':
        'Free online ruler with screen calibration. Measure real objects on screen in centimeters, millimeters and inches using auto, device, diagonal or bank-card calibration. Works on phone, tablet and desktop.',
      'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' },
      'featureList': [
        'cm, mm, inches and pixels scales',
        'Auto estimate calibration',
        'Device preset calibration',
        'Screen diagonal calibration',
        'Bank card / ID card / paper physical calibration',
        'Top, bottom, left and right edge rulers',
        'Draggable measurement guides with live position readout',
        'Crosshair with coordinate readout',
        'Direct on-screen measurement mode',
        'Fullscreen measuring mode',
        'Dark mode support',
        'Keyboard shortcuts',
        'Local calibration persistence',
        '100% client-side privacy',
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://freeaccuratecalculator.com/online-ruler/#breadcrumb',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://freeaccuratecalculator.com/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'Everyday', 'item': 'https://freeaccuratecalculator.com/everyday/' },
        { '@type': 'ListItem', 'position': 3, 'name': 'Online Ruler', 'item': 'https://freeaccuratecalculator.com/online-ruler/' },
      ],
    },
  ],
};
---

<CalculatorLayout
  title="Online Ruler — Free Accurate Ruler in cm, mm & Inches"
  metaDescription="Free online ruler with screen calibration. Measure real objects on screen in cm, mm and inches — auto, device, diagonal or bank-card calibration on phone, tablet and desktop."
  h1="Free Online Ruler — Measure in cm, mm & Inches"
  subtitle="A calibrated screen ruler for real-world measuring: cm, mm, inches and pixels, with bank-card calibration, draggable guides, crosshair and a direct measure mode. 100% free and private."
  category={{ label: 'Everyday', href: '/everyday/' }}
  calculatorName="Online Ruler"
  relatedCalculators={relatedCalculators}
  jsonLd={schema}
>
  <!-- ============================== TOOL ============================== -->
  <div id="ruler-app" class="calculator-main-box relative rounded-[20px] border border-hairline bg-canvas-elevated p-3 sm:p-6 shadow-whisper space-y-4 overflow-hidden transition-all print:hidden" data-js="ruler-root">
    <div class="pointer-events-none absolute -top-32 -right-32 w-80 h-80 rounded-full bg-link/10 blur-3xl" aria-hidden="true"></div>

    <!-- Status strip: calibration quality + zoom warning -->
    <div class="relative z-10 flex flex-wrap items-center gap-2 justify-between border-b border-hairline pb-3">
      <div class="flex items-center gap-2 min-w-0">
        <span id="ruler-status-dot" class="w-2.5 h-2.5 rounded-full bg-warning shrink-0" aria-hidden="true"></span>
        <span id="ruler-calibration-label" class="text-xs font-mono font-semibold text-ink truncate">Estimated (default 96 PPI)</span>
        <button type="button" id="ruler-cal-help" class="text-[11px] font-mono text-link hover:underline cursor-pointer shrink-0" aria-expanded="false" aria-controls="ruler-cal-explain">why?</button>
      </div>
      <p id="ruler-zoom-warning" class="hidden text-[11px] font-mono text-warning-deep dark:text-warning bg-warning-soft/60 border border-warning/30 rounded-md px-2 py-1" role="alert">
        Browser zoom is not 100% — press Ctrl/Cmd + 0 before measuring.
      </p>
    </div>
    <p id="ruler-cal-explain" class="hidden relative z-10 rounded-lg border border-hairline bg-canvas p-3 text-[11px] sm:text-xs text-body leading-relaxed">
      Calibration explanation placeholder (filled by script).
    </p>

    <!-- Toolbar -->
    <div class="relative z-10 space-y-3" role="toolbar" aria-label="Ruler controls">
      <!-- Row 1: unit segmented control (always visible) -->
      <div class="flex flex-wrap items-center gap-2 justify-between">
        <div class="inline-flex p-1 rounded-xl bg-canvas border border-hairline" role="group" aria-label="Measurement unit">
          <button type="button" class="ruler-unit-btn px-3 sm:px-4 py-2 min-h-[44px] rounded-lg text-xs font-semibold font-mono transition-all cursor-pointer" data-unit="cm" aria-pressed="true">CM</button>
          <button type="button" class="ruler-unit-btn px-3 sm:px-4 py-2 min-h-[44px] rounded-lg text-xs font-semibold font-mono transition-all cursor-pointer" data-unit="mm" aria-pressed="false">MM</button>
          <button type="button" class="ruler-unit-btn px-3 sm:px-4 py-2 min-h-[44px] rounded-lg text-xs font-semibold font-mono transition-all cursor-pointer" data-unit="in" aria-pressed="false">IN</button>
          <button type="button" class="ruler-unit-btn px-3 sm:px-4 py-2 min-h-[44px] rounded-lg text-xs font-semibold font-mono transition-all cursor-pointer" data-unit="px" aria-pressed="false">PX</button>
        </div>

        <!-- Primary actions (visible on all screens) -->
        <div class="flex items-center gap-2">
          <button type="button" id="ruler-cal-btn" class="inline-flex items-center gap-1.5 px-3 py-2 min-h-[44px] rounded-xl border border-hairline bg-canvas-elevated text-xs font-semibold text-ink hover:border-link/50 hover:text-link transition-all cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            Calibrate
          </button>
          <button type="button" id="ruler-measure-btn" class="inline-flex items-center gap-1.5 px-3 py-2 min-h-[44px] rounded-xl border border-hairline bg-canvas-elevated text-xs font-semibold text-ink hover:border-violet/50 hover:text-violet transition-all cursor-pointer" aria-pressed="false">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l2.879-2.879m0 0l2.122-2.121a2.121 2.121 0 013 3l-2.121 2.121m0 0L19 19m-4.95-4.95L5 5m2.879 9.121L5 17m4.95-4.95a2.121 2.121 0 013 3" /></svg>
            Measure
          </button>
          <button type="button" id="ruler-fullscreen-btn" class="inline-flex items-center gap-1.5 px-3 py-2 min-h-[44px] rounded-xl border border-hairline bg-canvas-elevated text-xs font-semibold text-ink hover:border-cyan/50 hover:text-cyan transition-all cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
            <span id="ruler-fs-label">Fullscreen</span>
          </button>
        </div>
      </div>

      <!-- Row 2: secondary controls (collapsible on mobile) -->
      <div id="ruler-secondary" class="hidden sm:flex flex-wrap items-center gap-2">
        <div class="inline-flex p-1 rounded-xl bg-canvas border border-hairline" role="group" aria-label="Ruler edges">
          <button type="button" class="ruler-edge-btn px-2.5 py-1.5 min-h-[38px] rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="top" aria-pressed="true">Top</button>
          <button type="button" class="ruler-edge-btn px-2.5 py-1.5 min-h-[38px] rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="bottom" aria-pressed="false">Bottom</button>
          <button type="button" class="ruler-edge-btn px-2.5 py-1.5 min-h-[38px] rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="left" aria-pressed="true">Left</button>
          <button type="button" class="ruler-edge-btn px-2.5 py-1.5 min-h-[38px] rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="right" aria-pressed="false">Right</button>
        </div>
        <button type="button" id="ruler-guides-btn" class="px-2.5 py-1.5 min-h-[38px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-ink hover:border-link/50 transition-all cursor-pointer" aria-pressed="false">Guides: off</button>
        <button type="button" id="ruler-crosshair-btn" class="px-2.5 py-1.5 min-h-[38px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-ink hover:border-link/50 transition-all cursor-pointer" aria-pressed="false">Crosshair: off</button>
        <button type="button" id="ruler-clear-guides" class="px-2.5 py-1.5 min-h-[38px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-mute hover:text-error transition-all cursor-pointer">Clear guides</button>
        <button type="button" id="ruler-help-btn" class="px-2.5 py-1.5 min-h-[38px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-mute hover:text-ink transition-all cursor-pointer" aria-expanded="false" aria-controls="ruler-shortcuts">Shortcuts ?</button>
      </div>
      <!-- Mobile: more menu -->
      <div class="sm:hidden">
        <button type="button" id="ruler-more-btn" class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 min-h-[44px] rounded-xl border border-hairline bg-canvas text-xs font-semibold text-ink cursor-pointer" aria-expanded="false" aria-controls="ruler-secondary-mobile">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
          More controls
        </button>
        <div id="ruler-secondary-mobile" class="hidden mt-2 flex flex-wrap items-center gap-2">
          <div class="inline-flex p-1 rounded-xl bg-canvas border border-hairline w-full" role="group" aria-label="Ruler edges">
            <button type="button" class="ruler-edge-btn flex-1 px-2 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="top" aria-pressed="true">Top</button>
            <button type="button" class="ruler-edge-btn flex-1 px-2 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="bottom" aria-pressed="false">Btm</button>
            <button type="button" class="ruler-edge-btn flex-1 px-2 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="left" aria-pressed="true">Left</button>
            <button type="button" class="ruler-edge-btn flex-1 px-2 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer" data-edge="right" aria-pressed="false">Right</button>
          </div>
          <button type="button" id="ruler-guides-btn-m" class="flex-1 px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-ink cursor-pointer" aria-pressed="false">Guides: off</button>
          <button type="button" id="ruler-crosshair-btn-m" class="flex-1 px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-ink cursor-pointer" aria-pressed="false">Crosshair: off</button>
          <button type="button" id="ruler-clear-guides-m" class="flex-1 px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-mute cursor-pointer">Clear guides</button>
          <button type="button" id="ruler-help-btn-m" class="w-full px-2.5 py-1.5 min-h-[40px] rounded-lg text-[11px] font-mono font-semibold border border-hairline bg-canvas-elevated text-mute cursor-pointer" aria-expanded="false" aria-controls="ruler-shortcuts">Keyboard shortcuts</button>
        </div>
      </div>
      <div id="ruler-shortcuts" class="hidden rounded-lg border border-hairline bg-canvas p-3 text-[11px] font-mono text-body grid grid-cols-2 sm:grid-cols-3 gap-1.5">
        <span><kbd class="ruler-kbd">1</kbd> cm</span><span><kbd class="ruler-kbd">2</kbd> inches</span><span><kbd class="ruler-kbd">3</kbd> mm</span>
        <span><kbd class="ruler-kbd">4</kbd> px</span><span><kbd class="ruler-kbd">G</kbd> guides</span><span><kbd class="ruler-kbd">C</kbd> crosshair</span>
        <span><kbd class="ruler-kbd">F</kbd> fullscreen</span><span><kbd class="ruler-kbd">M</kbd> measure</span><span><kbd class="ruler-kbd">Esc</kbd> close / clear</span>
      </div>
    </div>

    <!-- Measuring stage -->
    <div id="ruler-stage" class="relative z-10 rounded-xl border border-hairline bg-canvas overflow-hidden select-none touch-pan-y" style="min-height: 300px;">
      <!-- Edge rulers (canvas-rendered) -->
      <canvas id="ruler-canvas-top" class="ruler-canvas absolute top-0 left-0 w-full" height="34" aria-hidden="true"></canvas>
      <canvas id="ruler-canvas-bottom" class="ruler-canvas absolute bottom-0 left-0 w-full hidden" height="34" aria-hidden="true"></canvas>
      <canvas id="ruler-canvas-left" class="ruler-canvas absolute top-0 left-0 h-full hidden" width="34" aria-hidden="true"></canvas>
      <canvas id="ruler-canvas-right" class="ruler-canvas absolute top-0 right-0 h-full hidden" width="34" aria-hidden="true"></canvas>

      <!-- Overlays layer -->
      <div id="ruler-overlays" class="absolute inset-0 z-20" aria-hidden="true">
        <div id="ruler-guides-layer" class="absolute inset-0"></div>
        <div id="ruler-measure-layer" class="absolute inset-0 hidden"></div>
        <div id="ruler-crosshair-x" class="absolute hidden w-full border-t border-dashed border-violet/70 pointer-events-none" style="top:0"></div>
        <div id="ruler-crosshair-y" class="absolute hidden h-full border-l border-dashed border-violet/70 pointer-events-none" style="left:0"></div>
      </div>

      <!-- Crosshair / measurement readout chip -->
      <div id="ruler-readout" class="absolute z-30 hidden pointer-events-none rounded-lg border border-hairline bg-canvas-elevated/95 shadow-whisper px-2.5 py-1.5 text-[11px] sm:text-xs font-mono text-ink" style="top: 40px; left: 40px;">
        <span id="ruler-readout-main" class="font-bold">—</span>
        <span id="ruler-readout-sub" class="text-mute block"></span>
      </div>

      <!-- Center hint -->
      <div id="ruler-hint" class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none">
        <p class="text-center text-[11px] sm:text-xs text-mute font-mono px-6 max-w-md leading-relaxed">
          Place a flat object against the <span class="text-ink font-semibold">top</span> or <span class="text-ink font-semibold">left</span> edge to read its size.
          <span class="block mt-1">Turn on Measure to drag a distance anywhere on the stage.</span>
        </p>
      </div>
    </div>

    <!-- Live result strip -->
    <div class="relative z-10 rounded-xl border border-hairline bg-canvas p-3 sm:p-4 flex flex-wrap items-center gap-x-5 gap-y-2">
      <div class="min-w-0">
        <span class="block text-[10px] font-mono text-mute uppercase tracking-wider">Active unit</span>
        <span id="ruler-result-unit" class="text-xs font-mono font-bold text-ink">cm</span>
      </div>
      <div class="min-w-0">
        <span class="block text-[10px] font-mono text-mute uppercase tracking-wider">Scale</span>
        <span id="ruler-result-ppi" class="text-xs font-mono font-bold text-ink">96 px/in</span>
      </div>
      <div class="min-w-0" aria-live="polite">
        <span class="block text-[10px] font-mono text-mute uppercase tracking-wider">Latest measurement</span>
        <span id="ruler-result-last" class="text-xs font-mono font-bold text-ink">—</span>
      </div>
      <div class="sm:ml-auto text-[10px] text-mute font-mono">100% private — nothing leaves your browser.</div>
    </div>
  </div>

  <!-- ====================== CALIBRATION DIALOG ====================== -->
  <div id="ruler-cal-dialog" class="fixed inset-0 z-[80] hidden" role="dialog" aria-modal="true" aria-labelledby="ruler-cal-title">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-[2px]" data-cal-backdrop></div>
    <div class="relative z-10 mx-auto my-4 sm:my-10 w-[min(680px,calc(100vw-1.5rem))] max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-2xl border border-hairline bg-canvas-elevated shadow-2xl">
      <div class="sticky top-0 bg-canvas-elevated border-b border-hairline px-4 sm:px-6 py-3.5 flex items-center justify-between z-10">
        <h2 id="ruler-cal-title" class="heading-md text-ink">Calibrate the ruler</h2>
        <button type="button" id="ruler-cal-close" class="p-2 rounded-lg text-mute hover:text-ink hover:bg-canvas cursor-pointer" aria-label="Close calibration dialog">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <div class="px-4 sm:px-6 py-4 space-y-4">
        <p class="text-xs sm:text-sm text-body leading-relaxed">
          Browsers cannot read your screen\u2019s physical size, so the ruler starts from an estimate. Pick a method below \u2014 physical reference methods give the most trustworthy scale.
        </p>

        <!-- Method tabs -->
        <div class="flex flex-wrap gap-1.5" role="tablist" aria-label="Calibration method">

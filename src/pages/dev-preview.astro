---
// src/pages/dev-preview.astro
import Layout from '../layouts/Layout.astro';
import ResultDisplay from '../components/calculator/ResultDisplay.astro';
import AdSlot from '../components/common/AdSlot.astro';
---

<Layout
  title="Component Dev Preview & Test Bench"
  description="Isolated preview of ResultDisplay count-up animations, design system tokens, and AdSense ad slots."
  noindex={true}
>
  <div class="space-y-12">
    <!-- Dev Header -->
    <div class="border-b border-hairline pb-6">
      <div class="flex items-center gap-2">
        <span class="mono-eyebrow text-link">Engineering Test Bench</span>
        <span class="rounded-full bg-cyan/10 border border-cyan/30 px-2 py-0.5 text-[10px] font-mono text-cyan">Dev Mode</span>
      </div>
      <h1 class="display-hero text-ink mt-2">Design System & Animation Preview</h1>
      <p class="text-sm text-body mt-1">
        Testing easeOutExpo (~500ms) count-up animation, accessible aria-live updates, Lakh/Crore formatting, and ad slot stability.
      </p>
    </div>

    <!-- 1. ResultDisplay Animated Demonstrations -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="heading-md text-ink">1. ResultDisplay Component & Animations</h2>
        <span class="text-xs text-mute font-mono">500ms easeOutExpo</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <ResultDisplay
          id="preview-currency"
          label="Estimated Monthly Payment"
          prefix="$"
          initialValue={1250.00}
          decimals={2}
          secondaryText="Based on 6.5% interest over 30 years"
          accent="link"
        />

        <ResultDisplay
          id="preview-percentage"
          label="Calculated Increase"
          suffix="%"
          initialValue={24.50}
          decimals={2}
          secondaryText="Difference from base period"
          accent="cyan"
        />

        <ResultDisplay
          id="preview-indian"
          label="Total Principal + Interest (INR)"
          prefix="₹"
          initialValue={1580000.00}
          isIndian={true}
          decimals={2}
          secondaryText="Grouped in Indian Lakh/Crore notation"
          accent="violet"
        />
      </div>

      <!-- Animation Trigger Buttons -->
      <div class="rounded-[12px] border border-hairline bg-canvas-elevated p-6 space-y-4">
        <h3 class="text-xs font-semibold text-ink uppercase tracking-wider font-mono">Interactive Animation Triggers</h3>
        
        <div class="flex flex-wrap gap-2.5">
          <button
            type="button"
            class="rounded-[6px] border border-hairline bg-canvas px-3.5 py-2 text-xs font-medium text-ink hover:bg-hairline-soft transition-colors cursor-pointer"
            onclick="window.facAnimateNumber('preview-currency', 2854.75)"
          >
            Animate Currency to $2,854.75
          </button>

          <button
            type="button"
            class="rounded-[6px] border border-hairline bg-canvas px-3.5 py-2 text-xs font-medium text-ink hover:bg-hairline-soft transition-colors cursor-pointer"
            onclick="window.facAnimateNumber('preview-currency', 499.00)"
          >
            Count Down Currency to $499.00
          </button>

          <button
            type="button"
            class="rounded-[6px] border border-hairline bg-canvas px-3.5 py-2 text-xs font-medium text-ink hover:bg-hairline-soft transition-colors cursor-pointer"
            onclick="window.facAnimateNumber('preview-percentage', 87.25)"
          >
            Animate Percentage to 87.25%
          </button>

          <button
            type="button"
            class="rounded-[6px] border border-hairline bg-canvas px-3.5 py-2 text-xs font-medium text-ink hover:bg-hairline-soft transition-colors cursor-pointer"
            onclick="window.facAnimateNumber('preview-indian', 4589250.00, { isIndian: true })"
          >
            Animate Indian Lakh to ₹45,89,250.00
          </button>

          <button
            type="button"
            class="rounded-[6px] bg-primary px-3.5 py-2 text-xs font-medium text-on-primary hover:opacity-90 transition-opacity cursor-pointer"
            onclick="randomizeAll()"
          >
            Randomize All Numbers
          </button>
        </div>

        <!-- Slider Real-Time Testing -->
        <div class="pt-4 border-t border-hairline-soft space-y-2">
          <div class="flex justify-between text-xs font-medium">
            <label for="test-slider" class="text-body">Real-Time Slider Sync:</label>
            <span id="slider-val-label" class="font-mono text-ink">$ 5,000</span>
          </div>
          <input
            id="test-slider"
            type="range"
            min="100"
            max="10000"
            step="50"
            value="5000"
            class="w-full accent-link cursor-pointer"
          />
        </div>
      </div>
    </section>

    <!-- 2. AdSlot Placement Verification -->
    <section class="space-y-6 pt-6 border-t border-hairline">
      <div class="flex items-center justify-between">
        <h2 class="heading-md text-ink">2. Reserved AdSlot Sizing (0 Cumulative Layout Shift)</h2>
        <span class="text-xs text-mute font-mono">Guaranteed reserved height</span>
      </div>

      <div class="space-y-8">
        <div>
          <span class="mono-eyebrow text-mute mb-2 block">Leaderboard Banner (728x90)</span>
          <AdSlot slotType="leaderboard" slotId="DEV-LEADERBOARD" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <span class="mono-eyebrow text-mute mb-2 block">Medium Rectangle (300x250 / 336x280)</span>
            <AdSlot slotType="rectangle" slotId="DEV-RECTANGLE" />
          </div>

          <div>
            <span class="mono-eyebrow text-mute mb-2 block">In-Content Native Slot</span>
            <AdSlot slotType="in-content" slotId="DEV-INCONTENT" />
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  function randomizeAll() {
    const randCurr = Math.floor(Math.random() * 8000) + 200 + Math.random();
    const randPct = Math.floor(Math.random() * 95) + 1 + Math.random();
    const randInr = Math.floor(Math.random() * 9000000) + 100000 + Math.random();

    window.facAnimateNumber('preview-currency', randCurr);
    window.facAnimateNumber('preview-percentage', randPct);
    window.facAnimateNumber('preview-indian', randInr, { isIndian: true });
  }

  const slider = document.getElementById('test-slider');
  const sliderLabel = document.getElementById('slider-val-label');
  if (slider && sliderLabel) {
    slider.addEventListener('input', (e) => {
      const val = parseFloat(e.target.value);
      sliderLabel.textContent = '$ ' + val.toLocaleString();
      window.facAnimateNumber('preview-currency', val, { duration: 150 });
    });
  }

  // React to global currency switcher change
  window.addEventListener('currencychange', (e) => {
    const sym = e.detail.symbol;
    const prefixEl = document.getElementById('preview-currency-prefix');
    if (prefixEl) prefixEl.textContent = sym;
  });
</script>

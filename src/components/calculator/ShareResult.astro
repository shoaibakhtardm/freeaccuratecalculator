---
// src/components/calculator/ShareResult.astro
interface Props {
  calculatorTitle: string;
  isFrench?: boolean;
}

const { calculatorTitle, isFrench: propIsFrench } = Astro.props;
const isFrench = propIsFrench ?? Astro.url.pathname.startsWith('/fr/');
---

<div class="rounded-xl border border-hairline bg-canvas p-4 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-whisper">
  <div class="flex items-center gap-2">
    <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
    <span class="text-xs font-mono text-mute">
      {isFrench ? "Outil utile et précis ? Partagez votre calcul :" : "Found this accurate? Share your calculation:"}
    </span>
  </div>
  
  <div class="flex flex-wrap items-center gap-2">
    <!-- Copy Link Button -->
    <button
      id="copy-link-btn"
      class="min-h-[44px] px-3.5 py-1.5 rounded-lg border border-hairline bg-canvas-elevated hover:bg-link/10 text-ink text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer"
      title={isFrench ? "Copier le lien du calcul" : "Copy calculation link"}
      data-is-french={isFrench ? "true" : "false"}
    >
      <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
      </svg>
      <span id="copy-btn-text">{isFrench ? "Copier le Lien" : "Copy Link"}</span>
    </button>

    <!-- X / Twitter -->
    <a
      id="share-x-btn"
      href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(isFrench ? `Découvrez ce calculateur précis (${calculatorTitle}) :` : `Check out this accurate ${calculatorTitle}:`)}&url=${encodeURIComponent(Astro.url.href)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="min-h-[44px] min-w-[44px] rounded-lg border border-hairline bg-canvas-elevated hover:bg-link/10 text-ink flex items-center justify-center text-xs font-bold transition-colors"
      aria-label="Share on X"
      title={isFrench ? "Partager sur X" : "Share on X"}
    >
      𝕏
    </a>

    <!-- WhatsApp -->
    <a
      id="share-wa-btn"
      href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${calculatorTitle}: ${Astro.url.href}`)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="min-h-[44px] min-w-[44px] rounded-lg border border-hairline bg-canvas-elevated hover:bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xs transition-colors"
      aria-label="Share on WhatsApp"
      title={isFrench ? "Partager sur WhatsApp" : "Share on WhatsApp"}
    >
      💬
    </a>

    <!-- LinkedIn -->
    <a
      id="share-li-btn"
      href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="min-h-[44px] min-w-[44px] rounded-lg border border-hairline bg-canvas-elevated hover:bg-blue-600/10 text-blue-500 flex items-center justify-center text-xs font-bold transition-colors"
      aria-label="Share on LinkedIn"
      title={isFrench ? "Partager sur LinkedIn" : "Share on LinkedIn"}
    >
      in
    </a>
  </div>
</div>

<script is:inline>
  document.getElementById('copy-link-btn')?.addEventListener('click', function () {
    navigator.clipboard.writeText(window.location.href);
    const label = document.getElementById('copy-btn-text');
    const isFr = this.getAttribute('data-is-french') === 'true' || window.location.pathname.startsWith('/fr/');
    if (label) {
      label.textContent = isFr ? 'Copié !' : 'Copied!';
      setTimeout(() => {
        label.textContent = isFr ? 'Copier le Lien' : 'Copy Link';
      }, 2000);
    }
  });
</script>

---
// src/components/calculator/LocalizedCalculatorBridge.astro
import { translate, formatNumber, formatCurrency, formatPercent, isRtlLocale } from '../../i18n/engine.ts';
import { DICTIONARIES } from '../../i18n/dictionaries/index.ts';
import type { SupportedLocale } from '../../types/i18n.ts';

interface Props {
  locale?: SupportedLocale;
}

const activeLocale = (Astro.props.locale || Astro.currentLocale || 'en') as SupportedLocale;
const isRtl = isRtlLocale(activeLocale);
const dictJson = JSON.stringify(DICTIONARIES[activeLocale] || DICTIONARIES.en);
---

<script is:inline define:vars={{ activeLocale, isRtl, dictJson }}>
  (function () {
    try {
      const dict = JSON.parse(dictJson);
      window.facCurrentLocale = activeLocale;
      window.facIsRtl = isRtl;
      window.facDictionary = dict;

      window.facT = function (key, replacements) {
        let text = dict[key] || key;
        if (replacements) {
          for (const p in replacements) {
            text = text.replace(new RegExp('\\{' + p + '\\}', 'g'), replacements[p]);
          }
        }
        return text;
      };

      // Automatically translate common UI buttons if present
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (key && dict[key]) {
            if (el.tagName === 'INPUT' && (el.type === 'button' || el.type === 'submit')) {
              el.value = dict[key];
            } else {
              el.textContent = dict[key];
            }
          }
        });
      });
    } catch (e) {
      console.error('Failed to init facI18n bridge', e);
    }
  })();
</script>

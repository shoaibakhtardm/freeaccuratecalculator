---
// src/components/calculator/CountryCalculatorView.astro
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import MasterCalculatorWrapper from './MasterCalculatorWrapper.astro';
import type { CountryConfig } from '../../data/countries';
import { CALCULATORS, CATEGORY_METADATA, type CalculatorEntry } from '../../data/calculatorRegistry';
import type { CalculatorEntity } from '../../types/calculator';

interface Props {
  country: CountryConfig;
  calc: CalculatorEntry;
}

const { country, calc } = Astro.props;
const catMeta = CATEGORY_METADATA[calc.category];

const isFinanceOrInsurance = calc.category === 'finance' || calc.category === 'insurance' || calc.category === 'real-estate' || calc.category === 'business';

const isCurrencyCalculator =
  isFinanceOrInsurance ||
  calc.inputs.some((i) => i.unit === '$' || (typeof i.label === 'string' && i.label.includes('$'))) ||
  calc.defaultResult.prefix === '$';

// Country-tailored title and metadata
const localizedTitle = `${country.name} ${calc.name} (${country.currencySymbol}) — Free Online Calculator`;
const localizedH1 = `${country.name} ${calc.name}`;
const localizedDesc = `Accurate ${country.name} ${calc.name} with ${country.currency} (${country.currencySymbol}) formatting and ${country.numberSystem === 'lakh-crore' ? 'Lakh/Crore' : 'standard'} numerical precision. Free, instant client-side calculation.`;

// Related calculators within this country
const popularSet = new Set(country.popularCalculators);
const relatedCalculators = CALCULATORS.filter((c) => popularSet.has(c.id) && c.id !== calc.id)
  .slice(0, 4)
  .map((c) => ({
    name: `${c.name}`,
    title: `${c.name}`,
    href: `/countries/${country.slug}/${c.id}/`,
    badge: country.currencySymbol,
  }));

const adaptedCalc: CalculatorEntity = {
  slug: calc.id,
  title: localizedTitle,
  metaDescription: localizedDesc,
  category: calc.category,
  name: `${country.name} ${calc.name}`,
  badge: `${country.currencySymbol} Edition`,
  formula: calc.formula?.expression || 'Standard Mathematical Model',
  formulaExplanation: calc.formula?.explanation || 'Verified client-side algorithmic calculations.',
  engineType: isFinanceOrInsurance ? 'finance' : calc.category === 'health' ? 'health' : 'arithmetic',
  resultLabel: calc.defaultResult.label,
  resultPrefix: isCurrencyCalculator ? country.currencySymbol : (calc.defaultResult.prefix || ''),
  resultUnit: calc.defaultResult.suffix,
  decimals: calc.defaultResult.decimals,
  mathInputs: calc.inputs.map((inp) => ({
    id: inp.id,
    label: inp.label.replace(/\(\$\)/g, `(${country.currencySymbol})`).replace(/\$/g, country.currencySymbol),
    type: inp.type === 'select' ? 'select' : 'number',
    defaultValue: inp.defaultValue,
    min: inp.min,
    max: inp.max,
    step: inp.step,
    unit: inp.unit === '$' ? country.currencySymbol : inp.unit,
    options: inp.options,
    helpText: inp.helpText,
  })),
  example: calc.example,
  faqs: (calc.faqs && calc.faqs.length >= 5
    ? calc.faqs.slice(0, 5)
    : [
        ...((calc.faqs as any) || []),
        { question: `How accurate is the ${country.name} ${calc.name}?`, answer: `The ${country.name} ${calc.name} uses verified client-side algorithms tailored to ${country.currency} (${country.currencySymbol}) precision.` },
        { question: `Can I export my ${country.name} calculation?`, answer: `Yes, you can copy the full statement or download verified PDF/CSV statements directly.` },
        { question: `Are my numbers stored on any server?`, answer: `No. All calculations are executed 100% on your device using client-side JavaScript for complete privacy.` },
        { question: `What currency format is applied?`, answer: `Values are formatted in ${country.currency} (${country.currencySymbol}) honoring ${country.numberSystem === 'lakh-crore' ? 'Lakh/Crore' : 'international standard'} grouping.` },
        { question: `What mathematical formulas are used?`, answer: `Standard validated compound equations and official actuarial standards are used throughout.` },
      ]
  ).slice(0, 5) as any,
};
---

<CalculatorLayout
  title={localizedTitle}
  metaDescription={localizedDesc}
  h1={localizedH1}
  subtitle={localizedDesc}
  category={{
    label: `${country.name} ${catMeta?.name || 'Calculators'}`,
    href: `/countries/${country.slug}/${calc.category}/`,
  }}
  calculatorName={localizedH1}
  relatedCalculators={relatedCalculators}
>
  <MasterCalculatorWrapper
    calc={adaptedCalc}
    relatedCalculators={relatedCalculators}
    defaultCurrency={country.currency}
    defaultSymbol={country.currencySymbol}
    defaultIsIndian={country.numberSystem === 'lakh-crore'}
    countryFlagUrl={country.flagUrl}
    countryName={country.name}
  />
</CalculatorLayout>

---
// src/components/calculator/FinanceCalculatorView.astro
import FormulaSection from './FormulaSection.astro';
import WorkedExample from './WorkedExample.astro';
import FAQSection from './FAQSection.astro';
import HistoryDrawer from './HistoryDrawer.astro';
import SocialProof from '../SocialProof.astro';
import type { CalculatorEntity } from '../../types/calculator';

interface Props {
  calc: CalculatorEntity;
  relatedCalculators?: Array<{ name: string; href: string; badge?: string }>;
  defaultCurrency?: string;
  defaultSymbol?: string;
  defaultIsIndian?: boolean;
}

const {
  calc,
  relatedCalculators = [],
  defaultCurrency = 'USD',
  defaultSymbol = '$',
  defaultIsIndian = false,
} = Astro.props;

// Format formula variables
const formulaVariables = calc.mathInputs.map((inp) => ({
  symbol: inp.id,
  meaning: inp.label + (inp.unit ? ` (${inp.unit})` : ''),
}));

const isLoan = calc.slug.includes('loan') || calc.slug.includes('mortgage') || calc.slug.includes('emi') || calc.slug.includes('amortization') || calc.slug.includes('payment');
---

<div class="finance-calc-unified-container space-y-6">
  <!-- Social Proof Widget -->
  <div id="finance-social-proof" class="print:hidden">
    <SocialProof calculatorName={calc.name} />
  </div>

  <!-- Calculator Main Box (SIP Design Standard) -->
  <div id="finance-calculator-card" class="calculator-main-box relative rounded-[20px] border border-hairline bg-canvas-elevated p-4 sm:p-8 shadow-whisper space-y-6 overflow-hidden transition-all pb-24 sm:pb-8">

    <!-- Subtle Ambient Gradient Glow -->
    <div class="pointer-events-none absolute -top-32 -right-32 w-80 h-80 rounded-full bg-link/10 blur-3xl print:hidden"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-32 w-80 h-80 rounded-full bg-cyan/10 blur-3xl print:hidden"></div>
    
    <!-- Dedicated High-Fidelity Print/PDF Report (Visible ONLY in print) -->
    <div id="finance-print-report" class="hidden print:block font-mono text-slate-900">
      <div class="border-b-2 border-slate-900 pb-4 mb-5 flex justify-between items-start">
        <div>
          <div class="text-2xl font-black uppercase tracking-tight">Free Accurate Calculator</div>
          <div class="text-sm font-bold text-blue-700 mt-0.5">{calc.name} Statement & Verification Report</div>
          <div class="text-xs text-slate-500 mt-1">freeaccuratecalculator.com • Verified Financial Computation Statement</div>
        </div>
        <div class="text-right text-xs text-slate-600 space-y-0.5">
          <div><span class="text-slate-400 uppercase">Generated:</span> <strong id="print-report-date"></strong></div>
          <div><span class="text-slate-400 uppercase">Currency:</span> <strong id="print-currency-code"></strong></div>
          <div><span class="text-slate-400 uppercase">Tool:</span> <strong>{calc.name}</strong></div>
        </div>
      </div>

      <!-- Inputs Summary -->
      <div class="bg-slate-50 border border-slate-200 rounded-lg p-3.5 mb-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Calculation Parameters</div>
        <div id="print-parameters-grid" class="grid grid-cols-3 gap-4 text-xs font-mono"></div>
      </div>

      <!-- Metrics -->
      <div class="grid grid-cols-3 gap-3 mb-6">
        <div class="border border-slate-300 rounded-lg p-3.5 bg-white">
          <span id="print-metric-label-1" class="text-[10px] font-bold uppercase text-slate-500 block">Primary Value</span>
          <div id="print-metric-value-1" class="text-lg font-black text-link mt-1"></div>
          <span id="print-metric-sub-1" class="text-[10px] text-slate-500">Calculated Output</span>
        </div>
        <div class="border border-slate-300 rounded-lg p-3.5 bg-white">
          <span id="print-metric-label-2" class="text-[10px] font-bold uppercase text-slate-500 block">Principal / Base</span>
          <div id="print-metric-value-2" class="text-lg font-black text-violet mt-1"></div>
          <span id="print-metric-sub-2" class="text-[10px] text-slate-500">Base Investment / Loan</span>
        </div>
        <div class="border-2 border-slate-900 rounded-lg p-3.5 bg-slate-50">
          <span id="print-metric-label-3" class="text-[10px] font-bold uppercase text-slate-900 block">Interest / Gain</span>
          <div id="print-metric-value-3" class="text-lg font-black text-slate-900 mt-1"></div>
          <span id="print-metric-sub-3" class="text-[10px] font-semibold text-link">Financial Impact</span>
        </div>
      </div>

      <!-- Schedule Table -->
      <div class="space-y-2">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Multi-Period Breakdown Schedule</div>
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b-2 border-slate-300 bg-slate-100 text-slate-700">
              <th class="py-2 px-2.5">Period</th>
              <th class="py-2 px-2.5 text-right">Payment / Contribution</th>
              <th class="py-2 px-2.5 text-right">Principal / Invested</th>
              <th class="py-2 px-2.5 text-right">Interest / Growth</th>
              <th class="py-2 px-2.5 text-right">Ending Balance</th>
            </tr>
          </thead>
          <tbody id="print-schedule-body" class="divide-y divide-slate-200"></tbody>
        </table>
      </div>

      <div class="mt-8 pt-3 border-t border-slate-200 flex justify-between items-center text-[10px] text-slate-500">
        <div>Generated by <strong>Free Accurate Calculator</strong> • https://freeaccuratecalculator.com/{calc.slug}/</div>
        <div>Verified Pure Client-Side Computation • 100% Private</div>
      </div>
    </div>

    <!-- Screen UI (Hidden during print) -->

    <!-- Top Bar: Currency, Mode & Silent Trust Indicator -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-4 text-xs print:hidden">
      <div class="flex items-center gap-3">
        <div class="inline-flex p-1 rounded-xl bg-canvas border border-hairline">
          <span class="px-3 py-1.5 rounded-lg text-xs font-semibold font-mono bg-canvas-elevated text-link shadow-xs border border-link/20">
            {calc.name} Standard
          </span>
        </div>
      </div>

      <div class="flex items-center gap-2 font-mono text-mute">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span id="finance-header-currency-label" class="font-semibold text-ink">{defaultCurrency} ({defaultSymbol})</span>
        <span>•</span>
        <span>100% Private Client-Side</span>
      </div>
    </div>

    <!-- Inputs & Results Grid (SIP Two-Column Standard) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 print:hidden">

      <!-- Left Column: Inputs & Sliders with Steppers -->
      <form id="finance-calc-form" class="space-y-4" onsubmit="return false;">
        {calc.mathInputs.map((inp, idx) => (
          <div class="space-y-2 p-4 rounded-xl border border-hairline bg-canvas/40">
            <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase font-mono">
              <label for={`inp-${inp.id}`}>{inp.label}</label>
              <span id={`display-${inp.id}`} class="font-mono text-link text-base tabular-nums font-bold">
                {inp.defaultValue} {inp.unit || ''}
              </span>
            </div>

            {inp.type === 'select' ? (
              <select
                id={`inp-${inp.id}`}
                name={inp.id}
                class="finance-input w-full min-h-[46px] rounded-xl border border-hairline bg-canvas-elevated px-3 py-2.5 text-base font-mono text-ink focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 cursor-pointer shadow-2xs"
              >
                {inp.options?.map((opt) => (
                  <option value={opt.value} selected={opt.value === inp.defaultValue}>
                    {opt.label}
                  </option>
                ))}
              </select>
            ) : (
              <div class="space-y-2">
                <div class="relative flex items-center gap-2">
                  <div class="relative flex-1">
                    <span class="symbol-addon absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-mono text-mute select-none font-bold">
                      {inp.unit === '$' || inp.unit === '₹' ? inp.unit : (inp.label.toLowerCase().includes('rate') || inp.label.toLowerCase().includes('percent') ? '' : '₹')}
                    </span>
                    <input
                      id={`inp-${inp.id}`}
                      name={inp.id}
                      type="number"
                      step={inp.step || 'any'}
                      min={inp.min ?? 0}
                      max={inp.max ?? 10000000}
                      value={inp.defaultValue}
                      class={`finance-input w-full min-h-[46px] min-h-[44px] rounded-xl border border-hairline bg-canvas-elevated py-2.5 ${inp.label.toLowerCase().includes('rate') ? 'pl-3 pr-8' : 'pl-8 pr-3'} text-base sm:text-sm font-mono text-ink focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 tabular-nums font-semibold transition-all shadow-2xs`}
                    />
                    {inp.unit && (
                      <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-sm font-mono text-mute select-none font-bold">
                        {inp.unit}
                      </span>
                    )}
                  </div>

                  <!-- Quick Steppers -->
                  <div class="flex items-center gap-1">
                    <button
                      type="button"
                      class="finance-stepper-btn min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl border border-hairline bg-canvas-elevated text-mute hover:text-ink hover:border-link/50 active:scale-95 transition-all text-sm font-mono font-bold cursor-pointer"
                      data-input={`inp-${inp.id}`}
                      data-dir="minus"
                    >−</button>
                    <button
                      type="button"
                      class="finance-stepper-btn min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl border border-hairline bg-canvas-elevated text-mute hover:text-ink hover:border-link/50 active:scale-95 transition-all text-sm font-mono font-bold cursor-pointer"
                      data-input={`inp-${inp.id}`}
                      data-dir="plus"
                    >+</button>
                  </div>
                </div>

                <!-- Custom Slider -->
                <div class="py-1">
                  <input
                    id={`slider-${inp.id}`}
                    type="range"
                    min={inp.min ?? 0}
                    max={inp.max ?? (Number(inp.defaultValue) > 1000 ? Number(inp.defaultValue) * 4 : 100)}
                    step={inp.step || '1'}
                    value={inp.defaultValue}
                    aria-label={`${inp.label} slider`}
                    class="finance-slider custom-range-slider w-full cursor-pointer h-2.5 rounded-lg appearance-none bg-hairline"
                  />
                </div>
              </div>
            )}
            {inp.helpText && <p class="text-[11px] text-mute font-mono leading-tight">{inp.helpText}</p>}
          </div>
        ))}
      </form>

      <!-- Right Column: SIP Hero Result Card, Secondary Metrics & SVG Donut -->
      <div class="space-y-5">
        <!-- Hero Primary Result Card -->
        <div class="relative overflow-hidden rounded-2xl border-2 border-link/30 bg-gradient-to-br from-link/10 via-canvas-elevated to-cyan/10 p-5 sm:p-6 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div>
              <span id="hero-result-label" class="text-xs font-mono font-bold uppercase tracking-wider text-mute">
                {calc.resultLabel || "Primary Output"}
              </span>
              <div class="flex items-baseline gap-2 mt-1">
                <span id="hero-result-symbol" class="text-2xl sm:text-3xl font-bold font-mono text-ink">{defaultSymbol}</span>
                <span id="hero-result-val" class="text-3xl sm:text-4xl font-extrabold font-mono text-ink tabular-nums tracking-tight">
                  0
                </span>
              </div>
              <p id="hero-result-sub" class="text-xs text-mute mt-1 font-mono">
                {isLoan ? "Scheduled periodic installment obligation" : "Expected financial corpus projection"}
              </p>
            </div>

            <!-- Multiplier / Return Badge -->
            <div class="shrink-0 text-right">
              <span id="finance-multiplier-badge" class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-bold bg-cyan/20 text-cyan border border-cyan/40 shadow-xs">
                Active Calculation
              </span>
              <div id="finance-secondary-badge" class="text-[11px] font-mono font-semibold text-mute mt-1">
                Verified Engine
              </div>
            </div>
          </div>

          <!-- Live Spectrum Bar -->
          <div class="space-y-2 mt-5 pt-4 border-t border-hairline">
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="text-link font-semibold flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-link inline-block"></span>
                Base: <span id="bar-principal-label" class="tabular-nums font-bold">50.0%</span>
              </span>
              <span class="text-cyan font-semibold flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-cyan inline-block"></span>
                Growth / Interest: <span id="bar-gain-label" class="tabular-nums font-bold">50.0%</span>
              </span>
            </div>
            <div class="h-3 w-full overflow-hidden rounded-full bg-hairline flex">
              <div id="spectrum-principal" class="h-full bg-link transition-all duration-300 rounded-l-full" style="width: 50%;"></div>
              <div id="spectrum-gain" class="h-full bg-cyan transition-all duration-300 rounded-r-full" style="width: 50%;"></div>
            </div>
          </div>
        </div>

        <!-- 2 Secondary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-4 rounded-xl border border-hairline bg-canvas/40 flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span id="sec-card-1-label" class="text-[11px] font-mono font-bold uppercase tracking-wider text-mute">
                {isLoan ? "Principal Borrowed" : "Total Invested"}
              </span>
              <span class="w-2 h-2 rounded-full bg-link"></span>
            </div>
            <div class="mt-2 text-xl sm:text-2xl font-bold font-mono text-ink tabular-nums">
              <span id="sec-card-1-sym">{defaultSymbol}</span> <span id="sec-card-1-val">0</span>
            </div>
          </div>

          <div class="p-4 rounded-xl border border-hairline bg-canvas/40 flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span id="sec-card-2-label" class="text-[11px] font-mono font-bold uppercase tracking-wider text-mute">
                {isLoan ? "Total Interest" : "Estimated Wealth Gain"}
              </span>
              <span class="w-2 h-2 rounded-full bg-cyan"></span>
            </div>
            <div class="mt-2 text-xl sm:text-2xl font-bold font-mono text-cyan tabular-nums">
              <span id="sec-card-2-sym">{defaultSymbol}</span> <span id="sec-card-2-val">0</span>
            </div>
          </div>
        </div>

        <!-- Interactive SVG Donut Visualizer -->
        <div class="p-4 sm:p-5 rounded-2xl border border-hairline bg-canvas/40 flex flex-col sm:flex-row items-center justify-around gap-4">
          <div class="relative w-36 h-36 shrink-0 flex items-center justify-center">
            <svg class="w-full h-full transform -rotate-90" viewBox="0 0 140 140">
              <circle cx="70" cy="70" r="54" stroke="currentColor" stroke-width="14" fill="transparent" class="text-hairline" />
              <circle id="donut-ring-1" cx="70" cy="70" r="54" stroke="var(--color-link, #0070f3)" stroke-width="14" fill="transparent" stroke-dasharray="339.29" stroke-dashoffset="170" class="transition-all duration-500 ease-out" />
              <circle id="donut-ring-2" cx="70" cy="70" r="54" stroke="var(--color-cyan, #0f766e)" stroke-width="14" fill="transparent" stroke-dasharray="339.29" stroke-dashoffset="170" class="transition-all duration-500 ease-out" />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none">
              <span id="donut-center-pct" class="text-base font-mono font-black text-ink tabular-nums">50.0%</span>
              <span class="text-[9px] font-mono uppercase tracking-widest text-mute font-bold">Ratio</span>
            </div>
          </div>

          <div class="space-y-2 text-xs font-mono w-full sm:w-auto">
            <div class="flex items-center justify-between sm:justify-start gap-4">
              <span class="flex items-center gap-1.5 text-mute">
                <span class="w-2.5 h-2.5 rounded bg-link inline-block"></span>
                Base Component:
              </span>
              <span id="legend-ring-1-pct" class="font-bold text-ink">50.0%</span>
            </div>
            <div class="flex items-center justify-between sm:justify-start gap-4">
              <span class="flex items-center gap-1.5 text-mute">
                <span class="w-2.5 h-2.5 rounded bg-cyan inline-block"></span>
                Gain / Interest:
              </span>
              <span id="legend-ring-2-pct" class="font-bold text-cyan">50.0%</span>
            </div>
            <div class="pt-2 border-t border-hairline flex items-center justify-between sm:justify-start gap-4 text-[11px]">
              <span class="text-mute">Total Sum:</span>
              <span id="legend-total-val" class="font-bold text-ink">₹ 0</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Loan & Financial Intelligence Matrix -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 pt-2 print:hidden">
      <div class="p-3.5 rounded-xl border border-hairline bg-canvas/40 flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        </div>
        <div>
          <span class="text-[10px] font-mono uppercase tracking-wider text-mute block">Precision Math</span>
          <span class="text-xs font-mono font-bold text-ink block mt-0.5">Closed-Form Exact</span>
          <p class="text-[10px] text-mute mt-0.5 leading-tight">Verified without approximation drift.</p>
        </div>
      </div>

      <div class="p-3.5 rounded-xl border border-hairline bg-canvas/40 flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-link/10 text-link flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
        </div>
        <div>
          <span class="text-[10px] font-mono uppercase tracking-wider text-mute block">Inflation Proof (6%)</span>
          <span id="matrix-inflation-val" class="text-xs font-mono font-bold text-ink block mt-0.5">--</span>
          <p class="text-[10px] text-mute mt-0.5 leading-tight">Real purchasing power outcome.</p>
        </div>
      </div>

      <div class="p-3.5 rounded-xl border border-hairline bg-canvas/40 flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-violet/10 text-violet flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <div>
          <span class="text-[10px] font-mono uppercase tracking-wider text-mute block">Total Obligation / Worth</span>
          <span id="matrix-total-val" class="text-xs font-mono font-bold text-ink block mt-0.5">--</span>
          <p class="text-[10px] text-mute mt-0.5 leading-tight">Cumulative financial commitment.</p>
        </div>
      </div>

      <div class="p-3.5 rounded-xl border border-hairline bg-canvas/40 flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-cyan/10 text-cyan flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <div>
          <span class="text-[10px] font-mono uppercase tracking-wider text-mute block">Tenure Milestone</span>
          <span id="matrix-tenure-milestone" class="text-xs font-mono font-bold text-ink block mt-0.5">Complete</span>
          <p class="text-[10px] text-mute mt-0.5 leading-tight">Full amortization horizon.</p>
        </div>
      </div>
    </div>

    <!-- Action Toolbar (Copy Summary & Share Link) -->
    <div class="pt-2 border-t border-hairline flex items-center justify-between gap-3 print:hidden">
      <span class="text-xs font-mono font-semibold text-mute">Quick Actions:</span>
      <div class="flex items-center gap-2.5">
        <button
          type="button"
          id="action-copy-summary-btn"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-hairline bg-canvas hover:bg-hairline-soft text-ink text-xs font-semibold font-mono transition-all cursor-pointer shadow-xs active:scale-95"
          title="Copy formatted summary to clipboard"
        >
          <svg class="h-3.5 w-3.5 text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span id="copy-summary-text">Copy Summary</span>
        </button>

        <button
          type="button"
          id="action-share-link-btn"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-hairline bg-canvas hover:bg-hairline-soft text-ink text-xs font-semibold font-mono transition-all cursor-pointer shadow-xs active:scale-95"
          title="Copy shareable link with current inputs"
        >
          <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span id="share-link-text">Share</span>
        </button>
      </div>
    </div>

    <!-- Annual Accumulation / Breakdown Schedule Table -->

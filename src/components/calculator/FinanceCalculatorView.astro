        if (s1Lbl) s1Lbl.textContent = 'Purchasing Power of Cash';
        if (s2Lbl) s2Lbl.textContent = 'Total Purchasing Power Loss';
      }
      // 15. Tip & Dining Bill Split Engine
      else if (slug.includes('tip')) {
        const bill = Math.max(0, parseFloat(inputs.bill_amount || inputs.bill || 75));
        const tipPct = Math.max(0, parseFloat(inputs.tip_percent || inputs.tipRate || 18));
        const split = Math.max(1, Math.round(parseFloat(inputs.split_count || inputs.diners || 2)));

        const tipAmount = (bill * tipPct) / 100;
        const totalBill = bill + tipAmount;
        const perPerson = totalBill / split;

        res1 = Math.round(tipAmount * 100) / 100;
        res2 = Math.round(bill * 100) / 100;
        res3 = Math.round(totalBill * 100) / 100;

        const tipOptions = [10, 15, 18, 20, 22, 25];
        tipOptions.forEach((pct) => {
          const tAmt = (bill * pct) / 100;
          const tot = bill + tAmt;
          rows.push({
            period: `${pct}% Gratuity Tier`,
            payment: Math.round(tAmt * 100) / 100,
            principal: Math.round(bill * 100) / 100,
            interest: Math.round(tAmt * 100) / 100,
            balance: Math.round((tot / split) * 100) / 100,
          });
        });

        const heroLbl = document.getElementById('hero-result-label');
        const heroSubLbl = document.getElementById('hero-result-sub');
        const s1Lbl = document.getElementById('sec-card-1-label');
        const s2Lbl = document.getElementById('sec-card-2-label');
        if (heroLbl) heroLbl.textContent = 'Calculated Tip Amount';
        if (heroSubLbl) heroSubLbl.textContent = `Per Person Share (${split} Diners): ${currentCurrencySymbol} ${formatVal(perPerson, 2)}`;
        if (s1Lbl) s1Lbl.textContent = 'Bill Subtotal (Pre-Tip)';
        if (s2Lbl) s2Lbl.textContent = 'Total Bill (with Tip)';
      }
      // 16. Shopping Discount & Markdown Engine
      else if (slug.includes('discount')) {
        const price = Math.max(0, parseFloat(inputs.original_price || inputs.price || 80));
        const disc = Math.min(100, Math.max(0, parseFloat(inputs.discount_percent || inputs.discount || 30)));
        const taxRate = Math.max(0, parseFloat(inputs.tax_percent || inputs.tax || 8)) / 100;

        const savings = (price * disc) / 100;
        const preTax = price - savings;
        const tax = preTax * taxRate;
        const finalPrice = preTax + tax;

        res1 = Math.round(finalPrice * 100) / 100;
        res2 = Math.round(preTax * 100) / 100;
        res3 = Math.round(savings * 100) / 100;

        const discountTiers = [10, 20, 30, 40, 50, 70];
        discountTiers.forEach((tier) => {
          const tierSavings = (price * tier) / 100;
          const tierPreTax = price - tierSavings;
          const tierFinal = tierPreTax * (1 + taxRate);
          rows.push({
            period: `${tier}% Off Sale`,
            payment: Math.round(tierFinal * 100) / 100,
            principal: Math.round(tierPreTax * 100) / 100,
            interest: Math.round(tierSavings * 100) / 100,
            balance: Math.round(tierFinal * 100) / 100,
          });
        });

        const heroLbl = document.getElementById('hero-result-label');
        const heroSubLbl = document.getElementById('hero-result-sub');
        const s1Lbl = document.getElementById('sec-card-1-label');
        const s2Lbl = document.getElementById('sec-card-2-label');
        if (heroLbl) heroLbl.textContent = 'Final Discounted Price';
        if (heroSubLbl) heroSubLbl.textContent = `You Save: ${currentCurrencySymbol} ${formatVal(savings, 2)} (${disc}% Markdown)`;
        if (s1Lbl) s1Lbl.textContent = 'Pre-Tax Discounted Subtotal';
        if (s2Lbl) s2Lbl.textContent = 'Total Savings Amount';
      }
      // 17. Ovulation & Fertile Window Engine
      else if (slug.includes('ovulation')) {
        const cycle = Math.max(21, Math.min(45, parseFloat(inputs.cycle_length || 28)));
        const luteal = Math.max(10, Math.min(16, parseFloat(inputs.luteal_phase || 14)));
        const daysSince = Math.max(1, parseFloat(inputs.days_since_lmp || 10));

        const ovuDay = cycle - luteal;
        const winStart = Math.max(1, ovuDay - 5);
        const winEnd = ovuDay + 1;

        res1 = ovuDay;
        res2 = winStart;
        res3 = winEnd;

        rows = [
          { period: 'Menstrual Phase (Days 1–5)', payment: 5, principal: 1, interest: 5, balance: cycle },
          { period: `Follicular Phase (Days 1–${ovuDay - 1})`, payment: ovuDay - 1, principal: 1, interest: ovuDay - 1, balance: cycle },
          { period: `High Fertile Window (Days ${winStart}–${winEnd})`, payment: 6, principal: winStart, interest: winEnd, balance: cycle },
          { period: `Peak Ovulation (Day ${ovuDay})`, payment: 1, principal: ovuDay, interest: ovuDay, balance: cycle },
          { period: `Luteal Phase (Days ${ovuDay + 1}–${cycle})`, payment: luteal, principal: ovuDay + 1, interest: cycle, balance: cycle },
        ];

        const heroLbl = document.getElementById('hero-result-label');
        const heroSubLbl = document.getElementById('hero-result-sub');
        const s1Lbl = document.getElementById('sec-card-1-label');
        const s2Lbl = document.getElementById('sec-card-2-label');
        if (heroLbl) heroLbl.textContent = 'Peak Ovulation (Cycle Day)';
        if (heroSubLbl) heroSubLbl.textContent = `Fertile Window: Cycle Days ${winStart} to ${winEnd} (Highest Probability)`;
        if (s1Lbl) s1Lbl.textContent = 'Fertile Window Begins';
        if (s2Lbl) s2Lbl.textContent = 'Fertile Window Ends';
      }
      // 18. Pregnancy Gestational & Due Date Engine
      else if (slug.includes('pregnancy')) {
        const daysSince = Math.max(1, Math.min(294, parseFloat(inputs.days_since_lmp || 70)));
        const cycle = Math.max(21, Math.min(40, parseFloat(inputs.cycle_length || 28)));
        const totalDays = 280 + (cycle - 28);

        const weeks = Math.floor(daysSince / 7);
        const days = daysSince % 7;
        const daysLeft = Math.max(0, totalDays - daysSince);
        const weeksLeft = Math.ceil(daysLeft / 7);

        res1 = weeks;
        res2 = daysLeft;
        res3 = weeksLeft;

        rows = [
          { period: '1st Trimester (Weeks 1–13)', payment: 13, principal: 1, interest: 13, balance: 40 },
          { period: '2nd Trimester (Weeks 14–27)', payment: 14, principal: 14, interest: 27, balance: 40 },
          { period: '3rd Trimester (Weeks 28–40)', payment: 13, principal: 28, interest: 40, balance: 40 },
          { period: 'Full Term Delivery Window (Weeks 37–42)', payment: 5, principal: 37, interest: 42, balance: 40 },
        ];

        const heroLbl = document.getElementById('hero-result-label');
        const heroSubLbl = document.getElementById('hero-result-sub');
        const s1Lbl = document.getElementById('sec-card-1-label');
        const s2Lbl = document.getElementById('sec-card-2-label');
        if (heroLbl) heroLbl.textContent = 'Current Gestational Age';
        if (heroSubLbl) heroSubLbl.textContent = `Stage: ${weeks <= 13 ? '1st Trimester' : weeks <= 27 ? '2nd Trimester' : '3rd Trimester'} • Exact: ${weeks} Weeks, ${days} Days`;
        if (s1Lbl) s1Lbl.textContent = 'Days Remaining to Full Term';
        if (s2Lbl) s2Lbl.textContent = 'Weeks Remaining to Due Date';
      }
      // 5. Default General Investment / Finance Fallback
      else {
        const p = parseFloat(inputs.principal || inputs.investmentAmount || inputs.initialDeposit || 100000) || 0;
        const monthlyP = parseFloat(inputs.monthlyContribution || inputs.monthlyDeposit || inputs.monthlyInvestment || 0) || 0;
        const rate = parseFloat(inputs.annualRate || inputs.expectedReturnRate || inputs.interestRate || 10) || 0;
        const years = parseFloat(inputs.years || inputs.timeHorizonYears || inputs.timePeriodYears || 10) || 1;
        const r = (rate / 100) / 12;

        let bal = p;
        let totalDeposited = p;

        for (let y = 1; y <= Math.min(years, 40); y++) {
          let yrDeposits = 0;
          for (let m = 1; m <= 12; m++) {
            bal = (bal + monthlyP) * (1 + r);
            totalDeposited += monthlyP;
            yrDeposits += monthlyP;
          }
          rows.push({
            period: `Year ${y}`,
            payment: Math.round(yrDeposits),
            principal: Math.round(totalDeposited),
            interest: Math.round(bal - totalDeposited),
            balance: Math.round(bal),
          });
        }

        res1 = Math.round(bal);
        res2 = Math.round(totalDeposited);
        res3 = Math.max(0, Math.round(bal - totalDeposited));
      }

      currentReportState = { val1: res1, val2: res2, val3: res3, schedule: rows };

      // Update Result Elements
      const heroVal = document.getElementById('hero-result-val');
      const sec1Val = document.getElementById('sec-card-1-val');
      const sec2Val = document.getElementById('sec-card-2-val');
      const mobileVal = document.getElementById('mobile-hud-val');

      if (heroVal) heroVal.textContent = formatVal(res1, 0);
      if (sec1Val) sec1Val.textContent = formatVal(res2, 0);
      if (sec2Val) sec2Val.textContent = formatVal(res3, 0);
      if (mobileVal) mobileVal.textContent = `${currentCurrencySymbol} ${formatVal(res1, 0)}`;

      // Spectrum Bar & Ratios
      const totalBase = (res2 + res3) || 1;
      const principalPct = Math.min(100, Math.max(0, (res2 / totalBase) * 100));
      const gainPct = Math.max(0, 100 - principalPct);

      const barP = document.getElementById('spectrum-principal');
      const barG = document.getElementById('spectrum-gain');
      const labelP = document.getElementById('bar-principal-label');
      const labelG = document.getElementById('bar-gain-label');

      if (barP) barP.style.width = `${principalPct.toFixed(1)}%`;
      if (barG) barG.style.width = `${gainPct.toFixed(1)}%`;
      if (labelP) labelP.textContent = `${currentCurrencySymbol} ${formatVal(res2, 0)} (${principalPct.toFixed(1)}%)`;
      if (labelG) labelG.textContent = `${currentCurrencySymbol} ${formatVal(res3, 0)} (${gainPct.toFixed(1)}%)`;

      // SVG Donut Rings
      const circ = 339.29;
      const ring1Offset = circ * (1 - (principalPct / 100));
      const ring2Offset = circ * (1 - (gainPct / 100));

      const ring1 = document.getElementById('donut-ring-1');
      const ring2 = document.getElementById('donut-ring-2');
      const centerPct = document.getElementById('donut-center-pct');

      if (ring1) ring1.style.strokeDashoffset = String(ring1Offset);
      if (ring2) ring2.style.strokeDashoffset = String(ring2Offset);
      if (centerPct) centerPct.textContent = `${gainPct.toFixed(1)}%`;

      const leg1 = document.getElementById('legend-ring-1-pct');
      const leg2 = document.getElementById('legend-ring-2-pct');
      const legTot = document.getElementById('legend-total-val');

      if (leg1) leg1.textContent = `${principalPct.toFixed(1)}%`;
      if (leg2) leg2.textContent = `${gainPct.toFixed(1)}%`;
      if (legTot) legTot.textContent = `${currentCurrencySymbol} ${formatVal(res2 + res3, 0)}`;

      // Badges
      const multBadge = document.getElementById('finance-multiplier-badge');
      if (multBadge) {
        const mult = res2 > 0 ? ((res2 + res3) / res2).toFixed(2) : '1.00';
        multBadge.textContent = `${mult}x Ratio`;
      }

      // Matrix Cards
      const inflationEl = document.getElementById('matrix-inflation-val');
      const totalObligationEl = document.getElementById('matrix-total-val');
      if (inflationEl) {
        const yrs = rows.length || 10;
        const real = res1 / Math.pow(1.06, yrs);
        inflationEl.textContent = `${currentCurrencySymbol} ${formatVal(Math.round(real), 0)}`;
      }
      if (totalObligationEl) {
        totalObligationEl.textContent = `${currentCurrencySymbol} ${formatVal(res2 + res3, 0)}`;
      }

      renderSchedule(rows);
      updatePrintReport(res1, res2, res3, rows, inputs);
    }

    function renderSchedule(rows) {
      if (!scheduleBody) return;
      let html = '';
      rows.slice(0, 50).forEach((r) => {
        html += `
          <tr class="hover:bg-canvas-subtle/50 transition-colors">
            <td class="py-2.5 px-3.5 font-semibold text-link whitespace-nowrap">${r.period}</td>
            <td class="py-2.5 px-3.5 text-right tabular-nums font-mono whitespace-nowrap">${currentCurrencySymbol} ${formatVal(r.payment, 0)}</td>
            <td class="py-2.5 px-3.5 text-right tabular-nums font-mono text-mute whitespace-nowrap">${currentCurrencySymbol} ${formatVal(r.principal, 0)}</td>
            <td class="py-2.5 px-3.5 text-right tabular-nums font-mono text-violet font-semibold whitespace-nowrap">${currentCurrencySymbol} ${formatVal(r.interest, 0)}</td>
            <td class="py-2.5 px-3.5 text-right tabular-nums font-mono font-bold text-cyan whitespace-nowrap">${currentCurrencySymbol} ${formatVal(r.balance, 0)}</td>
          </tr>
        `;
      });
      scheduleBody.innerHTML = html;
    }

    function updatePrintReport(r1, r2, r3, rows, inputs) {
      const pDate = document.getElementById('print-report-date');
      const pCurr = document.getElementById('print-currency-code');
      const pGrid = document.getElementById('print-parameters-grid');
      const m1 = document.getElementById('print-metric-value-1');
      const m2 = document.getElementById('print-metric-value-2');
      const m3 = document.getElementById('print-metric-value-3');

      if (pDate) pDate.textContent = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
      if (pCurr) pCurr.textContent = `${currentCurrencyCode} (${currentCurrencySymbol})`;
      if (m1) m1.textContent = `${currentCurrencySymbol} ${formatVal(r1, 0)}`;
      if (m2) m2.textContent = `${currentCurrencySymbol} ${formatVal(r2, 0)}`;
      if (m3) m3.textContent = `${currentCurrencySymbol} ${formatVal(r3, 0)}`;

      if (pGrid) {
        let phtml = '';
        for (const [k, v] of Object.entries(inputs)) {
          phtml += `<div><span class="text-slate-500 uppercase block text-[10px]">${k}:</span><strong>${typeof v === 'number' ? formatVal(v, 0) : v}</strong></div>`;
        }
        pGrid.innerHTML = phtml;
      }

      if (printScheduleBody) {
        let pRows = '';
        rows.slice(0, 30).forEach((r) => {
          pRows += `
            <tr>
              <td class="py-1 px-2 font-bold">${r.period}</td>
              <td class="py-1 px-2 text-right">${currentCurrencySymbol} ${formatVal(r.payment, 0)}</td>
              <td class="py-1 px-2 text-right">${currentCurrencySymbol} ${formatVal(r.principal, 0)}</td>
              <td class="py-1 px-2 text-right">${currentCurrencySymbol} ${formatVal(r.interest, 0)}</td>
              <td class="py-1 px-2 text-right font-bold">${currentCurrencySymbol} ${formatVal(r.balance, 0)}</td>
            </tr>
          `;
        });
        printScheduleBody.innerHTML = pRows;
      }
    }

    // Input Bindings
    document.querySelectorAll('.finance-input').forEach((inp) => {
      const slider = document.getElementById(`slider-${inp.name}`);
      inp.addEventListener('input', () => {
        if (slider) slider.value = inp.value;
        recalculate();
      });
      if (slider) {
        slider.addEventListener('input', () => {
          inp.value = slider.value;
          recalculate();
        });
      }
    });

    // Stepper buttons
    document.querySelectorAll('.finance-stepper-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const inpId = btn.dataset.input;
        const dir = btn.dataset.dir;
        const inp = document.getElementById(inpId);
        if (inp) {
          const step = parseFloat(inp.step) || 1;
          const cur = parseFloat(inp.value) || 0;
          inp.value = dir === 'plus' ? String(cur + step) : String(Math.max(parseFloat(inp.min) || 0, cur - step));
          const slider = document.getElementById(`slider-${inp.name}`);
          if (slider) slider.value = inp.value;
          recalculate();
        }
      });
    });

    // Export Handlers
    function downloadExcel() {
      const rows = currentReportState.schedule;
      if (!rows || rows.length === 0) return;
      const headers = ['Period', 'Payment', 'Principal', 'Interest', 'Balance'];
      let csv = '\uFEFF';
      csv += `${calcName} Statement\n`;
      csv += `Generated,${new Date().toISOString()}\n\n`;
      csv += headers.join(',') + '\n';
      rows.forEach((r) => {
        csv += `"${r.period}",${r.payment},${r.principal},${r.interest},${r.balance}\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${slug}_schedule_${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('Excel (.csv) downloaded!');
    }

    function downloadPDF(e?: Event) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
        if (typeof (e as any).stopImmediatePropagation === 'function') {
          (e as any).stopImmediatePropagation();
        }
      }
      recalculate();
      if (typeof (window as any).generateAndDownloadPDF === 'function') {
        (window as any).generateAndDownloadPDF();
      } else {
        window.print();
      }
    }

    window.addEventListener('fac:before-pdf-print', () => recalculate());
    window.addEventListener('beforeprint', () => recalculate());

    function copySummary() {
      const text = [
        `📊 ${calcName} Summary — Free Accurate Calculator`,
        `----------------------------------------------------`,
        `• Primary Result: ${currentCurrencySymbol} ${formatVal(currentReportState.val1, 0)}`,
        `• Base Amount: ${currentCurrencySymbol} ${formatVal(currentReportState.val2, 0)}`,
        `• Growth/Cost: ${currentCurrencySymbol} ${formatVal(currentReportState.val3, 0)}`,
        `----------------------------------------------------`,
        `Calculate online: ${window.location.href}`,
      ].join('\n');

      navigator.clipboard.writeText(text).then(() => {
        showToast('Summary copied to clipboard!');
      }).catch(() => {
        showToast('Unable to copy summary');
      });
    }

    function shareLink() {
      const params = new URLSearchParams();
      document.querySelectorAll('.finance-input').forEach((inp) => {
        params.set(inp.name, inp.value);
      });
      window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
      navigator.clipboard.writeText(window.location.href).then(() => {
        showToast('Link copied to clipboard!');
      }).catch(() => {
        showToast('Unable to copy link');
      });
    }

    // Button Bindings
    document.getElementById('action-copy-summary-btn')?.addEventListener('click', copySummary);
    document.getElementById('action-share-link-btn')?.addEventListener('click', shareLink);
    document.getElementById('action-download-excel-btn')?.addEventListener('click', downloadExcel);
    document.getElementById('action-download-pdf-btn')?.addEventListener('click', downloadPDF);
    document.getElementById('mobile-hud-scroll-btn')?.addEventListener('click', () => {
      document.getElementById('schedule-section-card')?.scrollIntoView({ behavior: 'smooth' });
    });

    // Currency Switcher Event
    window.addEventListener('currencychange', (e) => {
      const newCurr = e.detail?.currency;
      if (newCurr) {
        currentCurrencyCode = newCurr;
        currentCurrencySymbol = e.detail.symbol || '$';
        isIndianFormat = e.detail.isIndian ?? (newCurr === 'INR');
        updateCurrencyUI();
        recalculate();
      }
    });

    updateCurrencyUI();
    recalculate();
  })();
</script>


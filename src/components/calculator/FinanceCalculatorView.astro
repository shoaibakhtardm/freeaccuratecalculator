    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #ffffff;
    border: 3px solid #0070f3;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .custom-range-slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @media print {
    *, *::before, *::after {
      box-sizing: border-box !important;
    }
    html, body {
      background: #ffffff !important;
      color: #0f172a !important;
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      font-size: 11px !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    header, footer, nav, aside,
    .breadcrumbs-container, #smart-email-modal, #country-modal,
    .ad-slot-container, .fac-copy-result-btn, #history-drawer, #history-drawer-backdrop,
    #mobile-sticky-hud, #finance-social-proof, #finance-toast, #finance-bottom-content-area,
    .print\:hidden {
      display: none !important;
    }
    body * { visibility: hidden !important; }
    #finance-print-report, #finance-print-report * { visibility: visible !important; }
    #finance-print-report {
      display: block !important;
      position: absolute !important;
      left: 0 !important; top: 0 !important;
      width: 100% !important;
      background: #ffffff !important;
      color: #0f172a !important;
      padding: 20px 24px !important;
      box-sizing: border-box !important;
    }
    #finance-print-report table { width: 100% !important; border-collapse: collapse !important; }
    #finance-print-report th, #finance-print-report td { border: 1px solid #cbd5e1 !important; padding: 5px 8px !important; }
    #finance-print-report th { background-color: #f1f5f9 !important; font-weight: 700 !important; }
    #finance-print-report tr { page-break-inside: avoid !important; }
    @page { size: A4 portrait; margin: 10mm 12mm; }
  }
</style>

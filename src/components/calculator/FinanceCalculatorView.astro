<!-- Client-side Calculation & State Engine -->
<script is:inline define:vars={{ slug: calc.slug, calcName: calc.name, initCurrCode: defaultCurrency, initCurrSym: defaultSymbol, initIsIndian: defaultIsIndian }}>
  (function () {
    // 1. Silent Currency Management
    let currentCurrencyCode = typeof window.facGetActiveCurrency === 'function'
      ? window.facGetActiveCurrency()
      : (localStorage.getItem('fac_currency') || initCurrCode || 'USD');

    let currentCurrencyInfo = typeof window.facGetCurrencyInfo === 'function'
      ? window.facGetCurrencyInfo(currentCurrencyCode)
      : null;

    let currentCurrencySymbol = currentCurrencyInfo?.symbol || (currentCurrencyCode === 'INR' ? '₹' : (initCurrSym || '$'));
    let isIndianFormat = currentCurrencyInfo ? (currentCurrencyInfo.isIndian ?? (currentCurrencyCode === 'INR')) : (initIsIndian ?? (currentCurrencyCode === 'INR'));

    const scheduleBody = document.getElementById('finance-schedule-body');
    const printScheduleBody = document.getElementById('print-schedule-body');
    const toastEl = document.getElementById('finance-toast');
    const toastMsg = document.getElementById('finance-toast-message');
    let toastTimeout = null;

    function showToast(message) {
      if (!toastEl || !toastMsg) return;
      toastMsg.textContent = message;
      toastEl.classList.remove('opacity-0', 'translate-y-12', 'pointer-events-none');
      toastEl.classList.add('opacity-100', 'translate-y-0');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toastEl.classList.remove('opacity-100', 'translate-y-0');
        toastEl.classList.add('opacity-0', 'translate-y-12', 'pointer-events-none');
      }, 2500);
    }

    function formatVal(val, decimals = 0) {
      if (isNaN(val) || !isFinite(val)) return '0';
      if (isIndianFormat) {
        const parts = Math.round(val).toString().split('.');
        let lastThree = parts[0].substring(parts[0].length - 3);
        const otherNumbers = parts[0].substring(0, parts[0].length - 3);
        if (otherNumbers !== '') lastThree = ',' + lastThree;
        return otherNumbers.replace(/\B(?=(\d{2})+(?!\d))/g, ',') + lastThree;
      }
      return val.toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals,
      });
    }

    function updateCurrencyUI() {
      document.querySelectorAll('.symbol-addon, #hero-result-symbol, #sec-card-1-sym, #sec-card-2-sym').forEach((el) => {
        if (el.textContent && el.textContent.trim() !== '%') {
          el.textContent = currentCurrencySymbol;
        }
      });
      const headerLabel = document.getElementById('finance-header-currency-label');
      if (headerLabel) headerLabel.textContent = `${currentCurrencyCode} (${currentCurrencySymbol})`;
    }

    // Calculation State
    let currentReportState = {
      val1: 0,
      val2: 0,
      val3: 0,
      schedule: [],
    };

    function recalculate() {
      const inputs = {};
      document.querySelectorAll('.finance-input').forEach((inp) => {
        const num = parseFloat(inp.value);
        inputs[inp.name] = isNaN(num) ? inp.value : num;
        const disp = document.getElementById(`display-${inp.name}`);
        if (disp) {
          const isRate = inp.name.toLowerCase().includes('rate') || inp.name.toLowerCase().includes('percent') || inp.name.toLowerCase().includes('apr');
          const isYear = inp.name.toLowerCase().includes('year') || inp.name.toLowerCase().includes('term') || inp.name.toLowerCase().includes('age');
          if (isRate) disp.textContent = `${Number(inp.value).toFixed(2)}%`;
          else if (isYear) disp.textContent = `${inp.value} Years`;
          else if (!isNaN(num)) disp.textContent = `${currentCurrencySymbol} ${formatVal(num, 0)}`;
          else disp.textContent = inp.value;
        }
      });

      let res1 = 0; // Primary Output
      let res2 = 0; // Principal / Invested
      let res3 = 0; // Interest / Return
      let rows = [];

      // 1. Loans, Mortgage, Auto Loan, Amortization, Payment
      if (slug.includes('mortgage') || slug.includes('auto-loan') || slug.includes('amortization') || slug.includes('loan') || slug.includes('payment') || slug.includes('emi')) {
        const homePrice = parseFloat(inputs.home_price || inputs.homePrice || 0);
        const p = parseFloat(inputs.loan_amount || inputs.principal || inputs.loanAmount || inputs.price || inputs.vehiclePrice || (homePrice > 0 ? homePrice : 20000)) || 0;
        const rate = parseFloat(inputs.interest_rate || inputs.annualRate || inputs.interestRate || inputs.apr || (slug.includes('mortgage') ? 6.5 : 8.5)) || 0;
        
        let months = 0;
        if (inputs.loan_term_months) {
          months = Math.round(parseFloat(inputs.loan_term_months) || 12);
        } else {
          const years = parseFloat(inputs.loan_term || inputs.tenureYears || inputs.loanTerm || inputs.years || (slug.includes('mortgage') ? 30 : 10)) || 1;
          months = Math.round(years * 12);
        }

        const downPayment = parseFloat(inputs.down_payment || inputs.downPayment || 0) || 0;
        const tradeIn = parseFloat(inputs.trade_in || 0) || 0;
        const salesTaxPercent = parseFloat(inputs.sales_tax_percent || 0) || 0;
        const propTax = parseFloat(inputs.property_tax || inputs.propertyTax || 0) || 0;
        const homeIns = parseFloat(inputs.home_insurance || inputs.homeInsurance || 0) || 0;
        const monthlyEscrow = (propTax + homeIns) / 12;

        const salesTax = p * (salesTaxPercent / 100);
        const actualLoan = Math.max(0, p - downPayment - tradeIn + salesTax);
        const monthlyRate = (rate / 12) / 100;

        let emi = 0;
        if (monthlyRate === 0) {
          emi = months > 0 ? actualLoan / months : 0;
        } else {
          const factor = Math.pow(1 + monthlyRate, months);
          emi = months > 0 ? (actualLoan * monthlyRate * factor) / (factor - 1) : 0;
        }

        const totalMonthlyPayment = emi + monthlyEscrow;
        const totalInterest = Math.max(0, (emi * months) - actualLoan);

        res1 = Math.round(slug.includes('mortgage') && monthlyEscrow > 0 ? totalMonthlyPayment : emi);
        res2 = Math.round(actualLoan);
        res3 = Math.round(totalInterest);

        let bal = actualLoan;
        const totalYears = Math.ceil(months / 12);
        for (let y = 1; y <= Math.min(totalYears, 30); y++) {
          let yrInterest = 0;
          let yrPrincipal = 0;
          const monthsInYear = Math.min(12, months - (y - 1) * 12);
          for (let m = 1; m <= monthsInYear; m++) {
            const intPart = bal * monthlyRate;
            const prinPart = Math.min(bal, emi - intPart);
            yrInterest += intPart;
            yrPrincipal += prinPart;
            bal = Math.max(0, bal - prinPart);
          }
          rows.push({
            period: `Year ${y}`,
            payment: Math.round((emi + monthlyEscrow) * monthsInYear),
            principal: Math.round(yrPrincipal),
            interest: Math.round(yrInterest + (monthlyEscrow * monthsInYear)),
            balance: Math.round(bal),
          });
        }

        const heroLbl = document.getElementById('hero-result-label');
        const heroSubLbl = document.getElementById('hero-result-sub');
        const s1Lbl = document.getElementById('sec-card-1-label');
        const s2Lbl = document.getElementById('sec-card-2-label');
        if (heroLbl) heroLbl.textContent = slug.includes('mortgage') ? 'Total Monthly Payment (PITI)' : 'Monthly Payment Obligation';
        if (heroSubLbl) heroSubLbl.textContent = slug.includes('mortgage') 
          ? `P&I: ${currentCurrencySymbol} ${formatVal(emi, 0)} | Escrow: ${currentCurrencySymbol} ${formatVal(monthlyEscrow, 0)}`
          : 'Fixed periodic installment needed to extinguish debt';
        if (s1Lbl) s1Lbl.textContent = 'Principal Financed';
        if (s2Lbl) s2Lbl.textContent = 'Total Interest Cost';
      } 
      // 2. Step-Up SIP (Annual contribution increment)
      else if (slug.includes('step-up')) {
        let p = Math.max(0, parseFloat(inputs.initial_investment || inputs.monthly_investment || inputs.monthlyContribution || 10000));
        const stepUp = Math.max(0, parseFloat(inputs.step_up_percent || inputs.stepUp || 10)) / 100;
        const annualRate = Math.max(0, parseFloat(inputs.return_rate || inputs.annual_rate || inputs.interestRate || 12)) / 100;
        const monthlyRate = annualRate / 12;
        const years = Math.max(1, Math.round(parseFloat(inputs.time_years || inputs.years || 10)));

        let balance = 0;
        let totalInvested = 0;
        let currentMonthly = p;

        for (let y = 1; y <= Math.min(years, 40); y++) {
          let yearInvested = 0;
          for (let m = 1; m <= 12; m++) {
            balance = (balance + currentMonthly) * (1 + monthlyRate);
            totalInvested += currentMonthly;
            yearInvested += currentMonthly;
          }
          rows.push({
            period: `Year ${y}`,
            payment: Math.round(yearInvested),
            principal: Math.round(totalInvested),
            interest: Math.max(0, Math.round(balance - totalInvested)),
            balance: Math.round(balance),
          });
          if (y < years) {
            currentMonthly = currentMonthly * (1 + stepUp);
          }
        }

        res1 = Math.round(balance);
        res2 = Math.round(totalInvested);
        res3 = Math.max(0, Math.round(balance - totalInvested));

        const heroLbl = document.getElementById('hero-result-label');
        const heroSubLbl = document.getElementById('hero-result-sub');
        const s1Lbl = document.getElementById('sec-card-1-label');
        const s2Lbl = document.getElementById('sec-card-2-label');
        if (heroLbl) heroLbl.textContent = 'Estimated Step-Up Maturity Corpus';
        if (heroSubLbl) heroSubLbl.textContent = 'Accumulated portfolio wealth with annual increments';
        if (s1Lbl) s1Lbl.textContent = 'Total Capital Invested';
        if (s2Lbl) s2Lbl.textContent = 'Estimated Wealth Gain';
      }
      // 3. Lumpsum Investment
      else if (slug.includes('lumpsum')) {
        const p = Math.max(0, parseFloat(inputs.investment_amount || inputs.principal || inputs.initialDeposit || 100000));
        const annualRate = Math.max(0, parseFloat(inputs.return_rate || inputs.annualRate || 12)) / 100;
        const years = Math.max(1, Math.round(parseFloat(inputs.time_years || inputs.years || 10)));

        let bal = p;
        for (let y = 1; y <= Math.min(years, 40); y++) {
          bal = p * Math.pow(1 + annualRate, y);
          rows.push({
            period: `Year ${y}`,
            payment: 0,
            principal: Math.round(p),
            interest: Math.max(0, Math.round(bal - p)),
            balance: Math.round(bal),
          });
        }

        res1 = Math.round(bal);
        res2 = Math.round(p);
        res3 = Math.max(0, Math.round(bal - p));

        const heroLbl = document.getElementById('hero-result-label');
        const heroSubLbl = document.getElementById('hero-result-sub');
        const s1Lbl = document.getElementById('sec-card-1-label');
        const s2Lbl = document.getElementById('sec-card-2-label');
        if (heroLbl) heroLbl.textContent = 'Total Maturity Value';
        if (heroSubLbl) heroSubLbl.textContent = 'Compounded future wealth on one-time investment';
        if (s1Lbl) s1Lbl.textContent = 'Initial Lump-Sum Investment';
        if (s2Lbl) s2Lbl.textContent = 'Estimated Wealth Gain';
      }
      // 4. Compound Interest
      else if (slug.includes('compound-interest')) {
        const initial = Math.max(0, parseFloat(inputs.initial_deposit || inputs.principal || 10000));
        const monthly = Math.max(0, parseFloat(inputs.monthly_contribution || 200));
        const rate = Math.max(0, parseFloat(inputs.annual_rate || inputs.annualRate || inputs.interestRate || 8.0)) / 100;
        const years = Math.max(1, Math.round(parseFloat(inputs.investment_years || inputs.years || 10)));
        const freqVal = String(inputs.compounding_frequency || '12');
        const n = freqVal === 'continuous' ? 0 : Math.max(1, parseFloat(freqVal) || 12);

        let currentBalance = initial;
        let totalContributed = initial;

        for (let y = 1; y <= Math.min(years, 40); y++) {
          let yearContribution = 0;
          for (let m = 1; m <= 12; m++) {
            if (n === 0) {
              currentBalance = (currentBalance + monthly) * Math.exp(rate / 12);
            } else {
              const periodicRate = rate / n;
              const periodsPerMonth = n / 12;
              currentBalance = (currentBalance + monthly) * Math.pow(1 + periodicRate, periodsPerMonth);
            }
            totalContributed += monthly;
            yearContribution += monthly;
          }
          rows.push({
            period: `Year ${y}`,
            payment: Math.round(yearContribution),
            principal: Math.round(totalContributed),
            interest: Math.max(0, Math.round(currentBalance - totalContributed)),
            balance: Math.round(currentBalance),
          });
        }

        res1 = Math.round(currentBalance);
        res2 = Math.round(totalContributed);
        res3 = Math.max(0, Math.round(currentBalance - totalContributed));

        const heroLbl = document.getElementById('hero-result-label');
        const heroSubLbl = document.getElementById('hero-result-sub');
        const s1Lbl = document.getElementById('sec-card-1-label');
        const s2Lbl = document.getElementById('sec-card-2-label');
        if (heroLbl) heroLbl.textContent = 'Future Compound Balance';
        if (heroSubLbl) heroSubLbl.textContent = 'Total accumulated value with periodic interest';
        if (s1Lbl) s1Lbl.textContent = 'Total Principal Deposited';
        if (s2Lbl) s2Lbl.textContent = 'Total Interest Earned';
      }
      // 5. Term Life Insurance
      else if (slug.includes('term-life')) {
        const income = Math.max(0, parseFloat(inputs.annual_income || inputs.income || 80000));
        const years = Math.max(1, parseFloat(inputs.replacement_years || inputs.years || 10));
        const debts = Math.max(0, parseFloat(inputs.total_debts || inputs.debts || 280000));
        const savings = Math.max(0, parseFloat(inputs.existing_savings || inputs.savings || 80000));
        const grossObligation = (income * years) + debts;
        const coverage = Math.max(50000, grossObligation - savings);

        res1 = Math.round(coverage);
        res2 = Math.round(grossObligation);
        res3 = Math.round(savings);

        for (let y = 1; y <= Math.min(years, 30); y++) {
          const remainingNeed = Math.max(0, (income * (years - y + 1)) + Math.max(0, debts * ((years - y + 1) / years)) - savings);
          rows.push({
            period: `Year ${y}`,
            payment: Math.round(income),
            principal: Math.round(income * y),
            interest: Math.round(remainingNeed),
            balance: Math.round(remainingNeed),
          });
        }

        const heroLbl = document.getElementById('hero-result-label');
        const heroSubLbl = document.getElementById('hero-result-sub');
        const s1Lbl = document.getElementById('sec-card-1-label');
        const s2Lbl = document.getElementById('sec-card-2-label');
        if (heroLbl) heroLbl.textContent = 'Recommended Term Life Coverage';
        if (heroSubLbl) heroSubLbl.textContent = 'Target death benefit to secure family obligations & income';
        if (s1Lbl) s1Lbl.textContent = 'Total Family Obligations';
        if (s2Lbl) s2Lbl.textContent = 'Existing Liquid Assets Offset';
      }
      // 6. Whole Life Insurance
      else if (slug.includes('whole-life')) {
        const prem = Math.max(500, parseFloat(inputs.annual_premium || 3600));
        const death = Math.max(25000, parseFloat(inputs.initial_death_benefit || 250000));
        const years = Math.max(5, parseFloat(inputs.policy_years || inputs.years || 20));
        const rate = Math.max(1, parseFloat(inputs.dividend_rate || 4.25)) / 100;
        
        let cashValue = 0;
        for (let y = 1; y <= Math.min(years, 40); y++) {
          const savingsFactor = y <= 2 ? 0.35 : (y <= 5 ? 0.70 : 0.88);
          cashValue = (cashValue + (prem * savingsFactor)) * (1 + rate);
          const totalPaidToDate = prem * y;
          rows.push({
            period: `Year ${y}`,
            payment: Math.round(prem),
            principal: Math.round(totalPaidToDate),
            interest: Math.max(0, Math.round(cashValue - totalPaidToDate)),
            balance: Math.round(cashValue),
          });
        }

        res1 = Math.round(cashValue);
        res2 = Math.round(prem * years);
        res3 = Math.max(0, Math.round(cashValue - (prem * years)));

        const heroLbl = document.getElementById('hero-result-label');
        const heroSubLbl = document.getElementById('hero-result-sub');
        const s1Lbl = document.getElementById('sec-card-1-label');
        const s2Lbl = document.getElementById('sec-card-2-label');
        if (heroLbl) heroLbl.textContent = 'Projected Cash Surrender Value';
        if (heroSubLbl) heroSubLbl.textContent = 'Guaranteed accumulation plus projected dividends';
        if (s1Lbl) s1Lbl.textContent = 'Total Premiums Paid';
        if (s2Lbl) s2Lbl.textContent = 'Net Cash Value Gain';
      }

    </svg>
    <span id="finance-toast-message">Copied to clipboard!</span>
  </div>

  <!-- Educational & Bottom Content -->
  <div id="finance-bottom-content-area" class="print:hidden space-y-8 mt-6">
    <!-- Download & Export Section Card (SIP Standard) -->
    <div id="finance-bottom-export-wrapper" class="rounded-[20px] border border-hairline bg-canvas-elevated p-6 sm:p-8 space-y-4 shadow-whisper">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-5">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-link/10 text-link">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </span>
            <h3 class="text-base sm:text-lg font-bold text-ink tracking-tight font-display">Download {calc.name} Statement & Schedule</h3>
          </div>

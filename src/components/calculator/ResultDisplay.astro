---
// src/components/calculator/ResultDisplay.astro
interface Props {
  id: string;
  label: string;
  initialValue?: number;
  decimals?: number;
  prefix?: string;
  suffix?: string;
  isIndian?: boolean;
  secondaryText?: string;
  accent?: 'link' | 'cyan' | 'violet' | 'ink';
  className?: string;
}

const {
  id,
  label,
  initialValue = 0,
  decimals = 2,
  prefix = '',
  suffix = '',
  isIndian = false,
  secondaryText = '',
  accent = 'ink',
  className = '',
} = Astro.props;

const accentClasses = {
  ink: 'text-ink',
  link: 'text-link',
  cyan: 'text-cyan',
  violet: 'text-violet',
}[accent];
---

<div
  class={`fac-result-card relative overflow-hidden rounded-[12px] border border-hairline bg-canvas-elevated p-4 sm:p-6 shadow-whisper transition-all ${className}`}
  data-result-card={id}
  aria-live="polite"
  aria-atomic="true"
>
  <div class="flex items-center justify-between gap-2 mb-2">
    <span class="mono-eyebrow text-mute">{label}</span>
    <div class="flex items-center gap-1.5">
      <button
        type="button"
        class="fac-copy-result-btn inline-flex items-center justify-center h-7 w-7 rounded-[4px] border border-hairline bg-canvas text-mute hover:text-ink hover:border-link transition-all focus:outline-none focus:ring-1 focus:ring-link cursor-pointer shadow-sm"
        aria-label={`Copy ${label} result to clipboard`}
        title="Copy result"
        data-copy-id={id}
      >
        <svg class="copy-icon h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <svg class="check-icon h-3.5 w-3.5 text-cyan hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </button>
      <div class="h-2 w-2 rounded-full bg-link/60 animate-pulse"></div>
    </div>
  </div>

  <!-- Primary Animated Number (Accessibility aria-live) -->
  <div
    class="flex flex-wrap items-baseline gap-1"
    aria-live="polite"
    aria-atomic="true"
  >
    {prefix && (
      <span
        id={`${id}-prefix`}
        class="text-lg sm:text-2xl font-mono font-medium text-mute select-none"
      >
        {prefix}
      </span>
    )}

    <span
      id={id}
      class={`text-2xl sm:text-3xl md:text-4xl font-semibold tracking-tight font-mono break-all sm:break-normal ${accentClasses}`}
      data-current-val={initialValue}
      data-decimals={decimals}
      data-prefix={prefix}
      data-suffix={suffix}
      data-indian={isIndian ? 'true' : 'false'}
    >
      {initialValue.toFixed(decimals)}
    </span>

    {suffix && (
      <span
        id={`${id}-suffix`}
        class="text-sm sm:text-base font-medium text-mute select-none pl-1"
      >
        {suffix}
      </span>
    )}
  </div>

  {secondaryText && (
    <p id={`${id}-secondary`} class="mt-2 text-xs text-body leading-relaxed">
      {secondaryText}
    </p>
  )}
</div>

<script is:inline>
  // Global EaseOutExpo Count-up engine
  if (!window.facAnimateNumber) {
    function easeOutExpo(t) {
      return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
    }

    function formatNumberString(val, decimals, isIndian) {
      if (isNaN(val) || !isFinite(val)) return '0.00';
      const fixed = val.toFixed(decimals);
      const parts = fixed.split('.');
      let intPart = parts[0];
      const decPart = parts[1] !== undefined ? '.' + parts[1] : '';

      if (isIndian) {
        const isNeg = intPart.startsWith('-');
        if (isNeg) intPart = intPart.substring(1);
        if (intPart.length > 3) {
          const last3 = intPart.substring(intPart.length - 3);
          const rem = intPart.substring(0, intPart.length - 3);
          intPart = rem.replace(/\B(?=(\d{2})+(?!\d))/g, ',') + ',' + last3;
        }
        return (isNeg ? '-' : '') + intPart + decPart;
      } else {
        return intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ',') + decPart;
      }
    }

    window.facFormatNumber = formatNumberString;

    window.facAnimateNumber = function (elementId, targetVal, options = {}) {
      const el = document.getElementById(elementId);
      if (!el) return;

      const duration = options.duration || 500; // ms
      const decimals = options.decimals !== undefined ? options.decimals : parseInt(el.getAttribute('data-decimals') || '2', 10);
      const isIndian = options.isIndian !== undefined ? options.isIndian : el.getAttribute('data-indian') === 'true';

      const startVal = parseFloat(el.getAttribute('data-current-val') || el.textContent.replace(/,/g, '') || '0');
      const diff = targetVal - startVal;

      if (Math.abs(diff) < 0.0001) {
        el.textContent = formatNumberString(targetVal, decimals, isIndian);
        el.setAttribute('data-current-val', targetVal.toString());
        return;
      }

      let startTime = null;

      function step(currentTime) {
        if (!startTime) startTime = currentTime;
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = easeOutExpo(progress);
        const currentNum = startVal + diff * eased;

        el.textContent = formatNumberString(currentNum, decimals, isIndian);

        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          el.textContent = formatNumberString(targetVal, decimals, isIndian);
          el.setAttribute('data-current-val', targetVal.toString());
        }
      }

      requestAnimationFrame(step);
    };
  }

  // Global Result Clipboard Copy Handler
  if (!window.__facCopyHandlerInitialized) {
    window.__facCopyHandlerInitialized = true;
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.fac-copy-result-btn');
      if (!btn) return;
      const targetId = btn.getAttribute('data-copy-id');
      if (!targetId) return;

      const numEl = document.getElementById(targetId);
      if (!numEl) return;

      const prefixEl = document.getElementById(`${targetId}-prefix`);
      const suffixEl = document.getElementById(`${targetId}-suffix`);

      const prefix = prefixEl ? prefixEl.textContent.trim() : '';
      const num = numEl.textContent.trim();
      const suffix = suffixEl ? suffixEl.textContent.trim() : '';

      const card = btn.closest('.fac-result-card');
      const labelEl = card ? card.querySelector('.mono-eyebrow') : null;
      const label = labelEl ? labelEl.textContent.trim() : '';

      const formattedNumber = `${prefix ? prefix + ' ' : ''}${num}${suffix ? ' ' + suffix : ''}`.trim();
      const copyText = label ? `${label}: ${formattedNumber}` : formattedNumber;

      function onCopySuccess() {
        if (typeof window.facShowToast === 'function') {
          window.facShowToast(`Copied: ${copyText}`, 'success');
        } else {
          // Toast fallback
          let toast = document.getElementById('fac-clipboard-toast');
          if (!toast) {
            toast = document.createElement('div');
            toast.id = 'fac-clipboard-toast';
            toast.setAttribute('role', 'status');
            toast.className = 'fixed bottom-5 right-5 z-50 rounded-md bg-ink px-4 py-2 text-xs font-mono text-canvas shadow-lg transition-all duration-300 opacity-0 translate-y-2 pointer-events-none';
            document.body.appendChild(toast);
          }
          toast.textContent = `Copied: ${copyText}`;
          toast.classList.remove('opacity-0', 'translate-y-2');
          toast.classList.add('opacity-100', 'translate-y-0');
          clearTimeout(window.__facToastTimeout);
          window.__facToastTimeout = setTimeout(() => {
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', 'translate-y-2');
          }, 2500);
        }

        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        if (copyIcon && checkIcon) {
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          setTimeout(() => {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
          }, 2000);
        }
      }

      function onCopyError() {
        if (typeof window.facShowToast === 'function') {
          window.facShowToast('Could not copy to clipboard', 'error');
        }
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(copyText).then(onCopySuccess).catch(() => {
          // Fallback to execCommand
          try {
            const ta = document.createElement('textarea');
            ta.value = copyText;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            const ok = document.execCommand('copy');
            document.body.removeChild(ta);
            if (ok) onCopySuccess();
            else onCopyError();
          } catch {
            onCopyError();
          }
        });
      } else {
        try {
          const ta = document.createElement('textarea');
          ta.value = copyText;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand('copy');
          document.body.removeChild(ta);
          if (ok) onCopySuccess();
          else onCopyError();
        } catch {
          onCopyError();
        }
      }
    });
  }
</script>

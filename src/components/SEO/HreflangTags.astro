---
// src/components/SEO/HreflangTags.astro
import { computeHreflangTags, type HreflangLink } from './HreflangTags';

interface Props {
  currentPath: string;
  siteOrigin?: string;
  customAlternates?: Record<string, string>;
}

const {
  currentPath,
  siteOrigin = 'https://freeaccuratecalculator.com',
  customAlternates,
} = Astro.props;

const { canonicalUrl, hreflangLinks } = computeHreflangTags(currentPath, siteOrigin, customAlternates);
---

<!-- Self-Referencing Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Bidirectional Cross-Language Hreflang Alternates -->
{hreflangLinks.map((link) => (
  <link rel="alternate" hreflang={link.lang} href={link.href} />
))}

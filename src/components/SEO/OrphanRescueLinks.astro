---
// src/components/SEO/OrphanRescueLinks.astro
import { REGIONAL_CALCULATOR_NETWORK } from '../../data/orphanLinks';

interface Props {
  currentCategory?: string;
  currentCountry?: string;
  title?: string;
  subtitle?: string;
  limit?: number;
}

const {
  currentCategory,
  currentCountry,
  title,
  subtitle,
  limit = 8,
} = Astro.props;

let relevantLinks = REGIONAL_CALCULATOR_NETWORK;

if (currentCategory) {
  const categoryMatches = REGIONAL_CALCULATOR_NETWORK.filter(
    (item) => item.category === currentCategory.toLowerCase()
  );
  if (categoryMatches.length > 0) {
    relevantLinks = categoryMatches;
  }
}

if (currentCountry) {
  const countryMatches = relevantLinks.filter(
    (item) => item.countryName.toLowerCase() === currentCountry.toLowerCase()
  );
  if (countryMatches.length > 0) {
    relevantLinks = countryMatches;
  }
}

const displayedLinks = relevantLinks.slice(0, limit);

const isFrench = currentCountry?.toLowerCase() === 'france' || Astro.url.pathname.includes('/countries/france') || Astro.currentLocale === 'fr';

const headingText =
  title ||
  (isFrench
    ? 'Simulateurs Régionaux & Spécialisés'
    : currentCategory
    ? `Global & Country-Specific ${currentCategory.charAt(0).toUpperCase() + currentCategory.slice(1)} Calculators`
    : 'Popular Regional & Specialized Financial Calculators');

const subText =
  subtitle ||
  (isFrench
    ? 'Outils de calcul vérifiés et calibrés pour les normes fiscales, devises et réglementations françaises.'
    : 'Mathematically verified, localized calculation tools calibrated for country-specific tax codes, currencies, and regulatory standards.');
---

{!isFrench && (
<section
  aria-label={isFrench ? "Annuaire des calculateurs régionaux" : "Regional and Specialized Calculator Directory"}
  class="orphan-rescue-section w-full border-t border-hairline bg-canvas py-10 sm:py-14"
  style="min-height: 380px;"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-4 border-b border-hairline gap-4">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-canvas-elevated text-body border border-hairline mb-3">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          {isFrench ? "Index Régional Vérifié" : "Verified Regional Index"}
        </span>
        <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-ink font-outfit">
          {headingText}
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-body leading-relaxed">
          {subText}
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={isFrench ? "/countries/france/" : "/countries/"}
          rel="dofollow"
          class="text-xs font-semibold text-link hover:text-ink transition-colors inline-flex items-center gap-1 whitespace-nowrap"
        >
          <span>{isFrench ? "Explorer tous les pays" : "Explore All Countries"}</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Zero-CLS Responsive CSS Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      {displayedLinks.map((item) => (
        <a
          href={item.href}
          rel="dofollow"
          title={isFrench ? `${item.anchorText} — Outil Vérifié` : `${item.anchorText} — Verified Tool`}
          class="group relative flex flex-col justify-between rounded-xl border border-hairline bg-canvas p-4 sm:p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-link/40 hover:shadow-card shadow-whisper"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xl leading-none" role="img" aria-label={item.countryName}>
                {item.flagEmoji}
              </span>
              <span class="inline-block rounded-md bg-canvas-elevated px-2 py-0.5 text-[10px] font-semibold text-body border border-hairline uppercase tracking-wider">
                {item.badgeText}
              </span>
            </div>

            <h3 class="text-sm sm:text-base font-semibold text-ink font-outfit group-hover:text-link transition-colors line-clamp-2">
              {item.anchorText}
            </h3>

            <p class="mt-2 text-xs text-body line-clamp-2 leading-relaxed">
              {item.description}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-hairline/60 flex items-center justify-between text-xs font-medium text-body group-hover:text-link transition-colors">
            <span class="text-[11px] font-mono capitalize text-muted">{item.countryName}</span>
            <span class="inline-flex items-center gap-1 text-[11px] font-semibold">
              {isFrench ? "Lancer l'Outil" : "Launch Tool"}
              <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
)}

---
// src/components/Footer.astro
// Ultra-Premium Global Footer (Disaster Recovery Edition)

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
const currentYear = new Date().getFullYear();

// Curated Category & Hub Navigation Links
const footerSections = [
  {
    title: "Finance & Wealth",
    links: [
      { label: "Mortgage Calculator", href: "/finance/mortgage-calculator/" },
      { label: "Compound Interest", href: "/finance/compound-interest-calculator/" },
      { label: "EMI Calculator", href: "/finance/emi-calculator/" },
      { label: "Loan Amortization", href: "/finance/amortization-calculator/" },
      { label: "SIP & Investment", href: "/finance/sip-calculator/" },
      { label: "Browse Finance Hub →", href: "/finance/" },
    ],
  },
  {
    title: "Health & Fitness",
    links: [
      { label: "Calorie & TDEE", href: "/health/calorie-calculator/" },
      { label: "BMI Calculator", href: "/health/bmi-calculator/" },
      { label: "Body Fat Percentage", href: "/health/body-fat-calculator/" },
      { label: "BMR & Metabolism", href: "/health/bmr-calculator/" },
      { label: "Ideal Body Weight", href: "/health/ideal-weight-calculator/" },
      { label: "Browse Health Hub →", href: "/health/" },
    ],
  },
  {
    title: "Math & Science",
    links: [
      { label: "Percentage Calculator", href: "/math/percentage-calculator/" },
      { label: "Scientific Calculator", href: "/math/scientific-calculator/" },
      { label: "Fraction Calculator", href: "/math/fraction-calculator/" },
      { label: "Standard Deviation", href: "/math/standard-deviation-calculator/" },
      { label: "Random Generator", href: "/math/random-number-generator/" },
      { label: "Browse Math Hub →", href: "/math/" },
    ],
  },
  {
    title: "Utility & Everyday",
    links: [
      { label: "Age Calculator", href: "/everyday/age-calculator/" },
      { label: "Hours & Timesheet", href: "/everyday/hours-calculator/" },
      { label: "Date Duration", href: "/everyday/date-calculator/" },
      { label: "Subnet Calculator", href: "/everyday/subnet-calculator/" },
      { label: "Password Generator", href: "/everyday/password-generator/" },
      { label: "Browse Everyday Hub →", href: "/everyday/" },
    ],
  },
  {
    title: "Global Editions",
    links: [
      { label: "India Calculators 🇮🇳", href: "/countries/india/" },
      { label: "United States 🇺🇸", href: "/countries/united-states/" },
      { label: "United Kingdom 🇬🇧", href: "/countries/united-kingdom/" },
      { label: "Canada 🇨🇦", href: "/countries/canada/" },
      { label: "Australia 🇦🇺", href: "/countries/australia/" },
      { label: "Browse 100+ Nations →", href: "/countries/" },
    ],
  },
];
---

<footer
  class:list={[
    "mt-20 border-t border-border bg-card/60 transition-colors duration-200",
    className,
  ]}
  aria-labelledby="footer-heading"
>
  <h2 id="footer-heading" class="sr-only">Footer Navigation</h2>

  <div class="container mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6">
      <!-- Brand & Mission Column -->
      <div class="sm:col-span-2 lg:col-span-1 space-y-3">
        <a href="/" class="flex items-center gap-2 group focus-visible:outline-none" aria-label="Free Accurate Calculator Home">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary text-on-primary font-mono font-bold text-sm shadow-xs transition-transform duration-200 group-hover:scale-105">
            ∑
          </span>
          <span class="text-base font-bold tracking-tight text-foreground group-hover:text-primary transition-colors duration-150">
            Free Accurate
          </span>
        </a>
        <p class="text-xs leading-relaxed text-muted-foreground">
          Industrial-grade, client-side verified mathematical calculators with instant edge performance, zero lag, and strict local privacy.
        </p>
        <div class="pt-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-2.5 py-1 text-[11px] font-mono font-medium text-muted-foreground shadow-xs">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Cloudflare Edge Verified
          </span>
        </div>
      </div>

      <!-- Category Links Columns -->
      {
        footerSections.map((section) => (
          <div>
            <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-foreground">
              {section.title}
            </h3>
            <ul class="mt-3 space-y-1.5" role="list">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-block py-0.5 text-xs text-muted-foreground hover:text-foreground hover:underline transition-colors duration-150"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom Disclaimer & Legal Section -->
    <div class="mt-12 border-t border-border pt-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-foreground">
        <p>© {currentYear} Free Accurate Calculator. All rights reserved.</p>
        <div class="flex flex-col items-center sm:items-end gap-1 font-medium">
          <div class="flex flex-wrap items-center gap-4 sm:gap-6">
            <a href="/guides/" class="hover:text-foreground transition-colors">Guides</a>
            <a href="/about/" class="hover:text-foreground transition-colors">About Us</a>
            <a href="/contact/" class="hover:text-foreground transition-colors">Contact Us</a>
          </div>
          <div class="flex flex-wrap items-center gap-4 sm:gap-6">
            <a href="/terms-of-use/" class="hover:text-foreground transition-colors">Terms &amp; Conditions</a>
            <a href="/privacy-policy/" class="hover:text-foreground transition-colors">Privacy Policy</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

---
// src/components/Logo.astro
export interface Props {
  className?: string;
  href?: string;
}

const { className = '', href } = Astro.props;
const currentLocale = Astro.currentLocale || 'en';
const isPortuguese = currentLocale === 'pt' || Astro.url.pathname.includes('/pt');
const isSpanish = currentLocale === 'es' || Astro.url.pathname.includes('/es/') || Astro.url.pathname.startsWith('/calculadora-edad/es');
const isFrench = currentLocale === 'fr' || Astro.url.pathname.startsWith('/fr/');
const defaultHref = currentLocale === 'en' ? '/' : `/${currentLocale}/`;
const targetHref = href || defaultHref;
const logoAria = isPortuguese
  ? "Free Accurate Calculator - Voltar para a página inicial"
  : isSpanish
  ? "Free Accurate Calculator - Volver a la página de inicio"
  : isFrench
  ? "Free Accurate Calculator - Retour à l'accueil"
  : "Free Accurate Calculator - Return to homepage";
---

<a
  href={targetHref}
  aria-label={logoAria}
  class={`group relative inline-flex items-center gap-2 sm:gap-3.5 select-none shrink-0 py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 rounded-2xl transition-all duration-300 hover:scale-[1.015] active:scale-[0.985] ${className}`}
>
  <!-- [BRAND LOGO ICON]: Sleek Minimalist Calculator Emblem -->
  <div class="relative shrink-0 flex items-center justify-center">
    <!-- Ambient Subtle Glow on Hover -->
    <div
      class="absolute -inset-1 rounded-2xl bg-slate-900/10 dark:bg-white/10 opacity-0 group-hover:opacity-100 blur-md transition-all duration-300 pointer-events-none"
      aria-hidden="true"
    ></div>

    <svg
      class="h-8.5 w-8.5 sm:h-10 sm:w-10 rounded-[13px] sm:rounded-[15px] shadow-sm ring-1 ring-black/5 dark:ring-white/20 transition-all duration-300 group-hover:scale-105"
      viewBox="0 0 600 600"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <rect x="45" y="45" width="510" height="510" rx="97" fill="#000000"></rect>
      <svg x="68" y="68" width="464" height="464" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.21" stroke-linecap="round" stroke-linejoin="round">
        <rect width="16" height="20" x="4" y="2" rx="2"></rect>
        <line x1="8" x2="16" y1="6" y2="6"></line>
        <line x1="16" x2="16" y1="14" y2="18"></line>
        <path d="M16 10h.01"></path>
        <path d="M12 10h.01"></path>
        <path d="M8 10h.01"></path>
        <path d="M12 14h.01"></path>
        <path d="M8 14h.01"></path>
        <path d="M12 18h.01"></path>
        <path d="M8 18h.01"></path>
      </svg>
    </svg>
  </div>

  <!-- [BRAND WORDMARK]: Unified Royal Two-Tier Typographic Lockup -->
  <div class="flex flex-col justify-center text-left min-w-0">
    <!-- Line 1: "Free" (Prominent, Highlighted with Animated Royal Gradient Shine) -->
    <div class="flex items-center gap-1.5 leading-none">
      <span
        class="font-outfit text-[21px] sm:text-[25px] font-black tracking-tight bg-gradient-to-r from-blue-600 via-indigo-600 via-purple-600 to-blue-600 dark:from-blue-400 dark:via-indigo-300 dark:via-purple-400 dark:to-blue-400 bg-[length:200%_auto] animate-royal-shine bg-clip-text text-transparent inline-block"
      >
        Free
      </span>

      <!-- Active Pulse Beacon Accent -->
      <span class="relative flex h-2 w-2 -mt-0.5" aria-hidden="true">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
      </span>
    </div>

    <!-- Line 2: "Accurate Calculator" -->
    <div class="flex items-center gap-1 leading-none mt-0.5 sm:mt-1">
      <span
        class="font-outfit text-[11.5px] sm:text-[13px] font-extrabold tracking-tight text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors whitespace-nowrap"
      >
        Accurate
      </span>
      <span
        class="font-outfit text-[11.5px] sm:text-[13px] font-medium tracking-tight text-slate-500 dark:text-slate-400 whitespace-nowrap"
      >
        Calculator
      </span>
    </div>
  </div>
</a>

<style>
  @keyframes royal-shine {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.85;
    }
  }
  .animate-royal-shine {
    animation: royal-shine 3.5s ease-in-out infinite;
    will-change: opacity;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-royal-shine {
      animation: none !important;
    }
  }
</style>



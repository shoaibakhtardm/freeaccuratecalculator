---
// src/components/Logo.astro
export interface Props {
  className?: string;
  href?: string;
}

const { className = '', href } = Astro.props;
const currentLocale = Astro.currentLocale || 'en';
const defaultHref = currentLocale === 'en' ? '/' : `/${currentLocale}/`;
const targetHref = href || defaultHref;
---

<a
  href={targetHref}
  aria-label="Free Accurate Calculator - Return to homepage"
  class={`group relative inline-flex items-center gap-2 sm:gap-3.5 select-none shrink-0 py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 rounded-2xl transition-all duration-300 hover:scale-[1.015] active:scale-[0.985] ${className}`}
>
  <!-- [ROYAL JEWEL EMBLEM]: Bespoke Gradient Squircle + Luxury Bevel + Ambient Glow -->
  <div class="relative shrink-0 flex items-center justify-center">
    <!-- Ambient Royal Glow on Hover -->
    <div
      class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 opacity-25 dark:opacity-40 blur-md group-hover:opacity-75 group-hover:blur-lg transition-all duration-500 pointer-events-none"
      aria-hidden="true"
    ></div>

    <!-- Outer Beveled Border Frame -->
    <div
      class="relative p-[1.2px] sm:p-[1.5px] rounded-2xl bg-gradient-to-b from-blue-400/80 via-indigo-500/60 to-purple-700/80 shadow-sm sm:shadow-md shadow-indigo-500/20 group-hover:shadow-xl group-hover:shadow-indigo-500/40 group-hover:scale-105 group-hover:rotate-[-1.5deg] transition-all duration-300 ease-out"
    >
      <!-- Inner Jewel Body -->
      <div
        class="relative flex h-8.5 w-8.5 sm:h-10.5 sm:w-10.5 items-center justify-center rounded-[13px] sm:rounded-[14.5px] bg-gradient-to-br from-blue-600 via-indigo-800 to-slate-950 text-white overflow-hidden"
      >
        <!-- Glass Sheen Diagonal Glint -->
        <div
          class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/10 to-white/30 pointer-events-none"
          aria-hidden="true"
        ></div>

        <!-- Royal Calculator Glyph -->
        <svg
          class="h-4.5 w-4.5 sm:h-5.5 sm:w-5.5 text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)] transition-transform duration-300 group-hover:scale-105"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <!-- Calculator Outer Body -->
          <rect
            x="3.5"
            y="2.5"
            width="17"
            height="19"
            rx="3.5"
            stroke="currentColor"
            stroke-width="1.8"
            class="text-blue-100"
          ></rect>

          <!-- LCD Precision Screen -->
          <rect
            x="6.5"
            y="5.5"
            width="11"
            height="4"
            rx="1.5"
            fill="currentColor"
            fill-opacity="0.2"
            stroke="currentColor"
            stroke-width="1.4"
            class="text-cyan-300"
          ></rect>
          <!-- LCD Indicator Beam -->
          <line
            x1="8.5"
            y1="7.5"
            x2="15.5"
            y2="7.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            class="text-cyan-200"
          ></line>

          <!-- Keypad Matrix -->
          <!-- Row 1 -->
          <circle cx="8" cy="13" r="1.1" fill="currentColor" class="text-white"></circle>
          <circle cx="12" cy="13" r="1.1" fill="currentColor" class="text-white"></circle>
          <rect x="15" y="12" width="2.2" height="2.2" rx="0.6" fill="currentColor" class="text-amber-400"></rect>

          <!-- Row 2 -->
          <circle cx="8" cy="17" r="1.1" fill="currentColor" class="text-white"></circle>
          <circle cx="12" cy="17" r="1.1" fill="currentColor" class="text-white"></circle>
          <rect x="15" y="16" width="2.2" height="2.2" rx="0.6" fill="currentColor" class="text-cyan-400"></rect>
        </svg>

        <!-- Royal Diamond Sparkle in Corner -->
        <svg
          class="absolute top-0.5 right-0.5 sm:top-1 sm:right-1 h-2 sm:h-2.5 w-2 sm:w-2.5 text-amber-300 animate-pulse pointer-events-none opacity-90 group-hover:opacity-100 group-hover:rotate-45 transition-transform duration-500"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"></path>
        </svg>
      </div>
    </div>
  </div>

  <!-- [BRAND WORDMARK]: Unified Royal Two-Tier Typographic Lockup -->
  <div class="flex flex-col justify-center text-left min-w-0">
    <!-- Line 1: "Free" (Prominent, Highlighted with Animated Royal Gradient Shine) -->
    <div class="flex items-center gap-1.5 leading-none">
      <span
        class="font-outfit text-[21px] sm:text-[25px] font-black tracking-tight bg-gradient-to-r from-blue-600 via-indigo-600 via-purple-600 to-blue-600 dark:from-blue-400 dark:via-indigo-300 dark:via-purple-400 dark:to-blue-400 bg-[length:200%_auto] animate-royal-shine bg-clip-text text-transparent inline-block"
      >
        Free
      </span>

      <!-- Active Pulse Beacon Accent -->
      <span class="relative flex h-2 w-2 -mt-0.5" aria-hidden="true">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
      </span>
    </div>

    <!-- Line 2: "Accurate Calculator" -->
    <div class="flex items-center gap-1 leading-none mt-0.5 sm:mt-1">
      <span
        class="font-outfit text-[11.5px] sm:text-[13px] font-extrabold tracking-tight text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors whitespace-nowrap"
      >
        Accurate
      </span>
      <span
        class="font-outfit text-[11.5px] sm:text-[13px] font-medium tracking-tight text-slate-500 dark:text-slate-400 whitespace-nowrap"
      >
        Calculator
      </span>
    </div>
  </div>
</a>

<style>
  @keyframes royal-shine {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
  .animate-royal-shine {
    animation: royal-shine 4s ease-in-out infinite;
  }
</style>


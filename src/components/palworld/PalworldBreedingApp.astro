  // REVERSE BREEDING PANEL
  function renderReverseHeader() {
    const pal = getPalById(state.reverseTargetId);
    if (!pal) return;
    const img = document.getElementById('img-reverse-target') as HTMLImageElement;
    const name = document.getElementById('name-reverse-target');
    const num = document.getElementById('num-reverse-target');
    if (img) { img.src = pal.image; img.alt = pal.name; }
    if (name) name.textContent = pal.name;
    if (num) num.textContent = `#${pal.palDexNo} • ${pal.elements.join(', ')}`;
  }

  function renderReverseResults() {
    renderReverseHeader();
    const container = document.getElementById('container-reverse-results');
    if (!container) return;

    const allPairs = findParentCombinations(state.reverseTargetId, {
      ownedPalIds: state.ownedPalIds,
    });

    const specialCount = allPairs.filter((p) => p.isSpecial).length;
    const ownedCount = allPairs.filter((p) => p.bothOwned).length;

    const countAll = document.getElementById('count-all-combos');
    const countSpecial = document.getElementById('count-special-combos');
    const countOwned = document.getElementById('count-owned-combos');

    if (countAll) countAll.textContent = String(allPairs.length);
    if (countSpecial) countSpecial.textContent = String(specialCount);
    if (countOwned) countOwned.textContent = String(ownedCount);

    let filtered = allPairs;
    if (state.reverseFilter === 'special') {
      filtered = allPairs.filter((p) => p.isSpecial);
    } else if (state.reverseFilter === 'owned') {
      filtered = allPairs.filter((p) => p.bothOwned);
    }

    if (state.reverseSearch) {
      const q = state.reverseSearch.toLowerCase().trim();
      filtered = filtered.filter(
        (p) =>
          p.parent1.name.toLowerCase().includes(q) ||
          p.parent2.name.toLowerCase().includes(q)
      );
    }

    if (filtered.length === 0) {
      container.innerHTML = `
        <div class="col-span-full rounded-[14px] bg-canvas border border-hairline p-8 text-center space-y-2">
          <p class="text-sm font-semibold text-ink">No combinations found with current filter</p>
          <p class="text-xs text-mute">Try switching back to "All Combinations" or clearing your search query.</p>
        </div>
      `;
      return;
    }

    container.innerHTML = filtered
      .map(
        (item) => `
        <div class="rounded-[14px] border border-hairline bg-canvas p-3 hover:border-link transition-colors space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono ${item.bothOwned ? 'text-emerald-500 font-bold' : 'text-mute'}">
              ${item.bothOwned ? '✅ Both in Farm' : 'Breeding Pair'}
            </span>
            ${item.isSpecial ? '<span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-600 dark:text-amber-400">⭐ Unique Combo</span>' : ''}
          </div>

          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 min-w-0">
              <img src="${item.parent1.image}" alt="${item.parent1.name}" class="w-9 h-9 rounded-[8px] bg-canvas-elevated object-contain p-0.5 shrink-0" loading="lazy" />
              <div class="min-w-0">
                <div class="text-xs font-bold text-ink truncate">${item.parent1.name}</div>
                <div class="text-[10px] font-mono text-mute">#${item.parent1.palDexNo}</div>
              </div>
            </div>

            <span class="text-mute font-bold text-xs shrink-0">+</span>

            <div class="flex items-center gap-2 min-w-0">
              <img src="${item.parent2.image}" alt="${item.parent2.name}" class="w-9 h-9 rounded-[8px] bg-canvas-elevated object-contain p-0.5 shrink-0" loading="lazy" />
              <div class="min-w-0">
                <div class="text-xs font-bold text-ink truncate">${item.parent2.name}</div>
                <div class="text-[10px] font-mono text-mute">#${item.parent2.palDexNo}</div>
              </div>
            </div>
          </div>

          <button
            type="button"
            class="btn-select-pair-from-reverse w-full py-1.5 rounded-[8px] bg-hairline-soft hover:bg-link hover:text-white text-xs font-medium text-ink transition-colors cursor-pointer text-center"
            data-p1="${item.parent1.id}"
            data-p2="${item.parent2.id}"
          >
            Calculate This Pair →
          </button>
        </div>
      `
      )
      .join('');

    // Attach click listeners to "Calculate This Pair"
    container.querySelectorAll('.btn-select-pair-from-reverse').forEach((btn) => {
      btn.addEventListener('click', () => {
        const p1 = btn.getAttribute('data-p1');
        const p2 = btn.getAttribute('data-p2');
        if (p1 && p2) {
          state.parentAId = p1;
          state.parentBId = p2;
          saveState();
          setMode('pair');
          renderPairCalculator();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    });
  }

  // Reverse Filter Buttons
  document.querySelectorAll('.btn-reverse-filter').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-reverse-filter').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.getAttribute('data-filter') as any;
      if (f) {
        state.reverseFilter = f;
        renderReverseResults();
      }
    });
  });

  document.getElementById('input-reverse-search')?.addEventListener('input', (e) => {
    state.reverseSearch = (e.target as HTMLInputElement).value;
    renderReverseResults();
  });

  // BREEDING PATH & PLANNER PANEL
  function renderPathHeader() {
    const pal = getPalById(state.pathTargetId);
    if (!pal) return;
    const img = document.getElementById('img-path-target') as HTMLImageElement;
    const name = document.getElementById('name-path-target');
    const num = document.getElementById('num-path-target');
    if (img) { img.src = pal.image; img.alt = pal.name; }
    if (name) name.textContent = pal.name;
    if (num) num.textContent = `#${pal.palDexNo} • ${pal.elements.join(', ')}`;
  }

  function renderOwnedChips() {
    const container = document.getElementById('container-owned-chips');
    const countEl = document.getElementById('count-owned-pals');
    if (!container) return;

    if (countEl) countEl.textContent = String(state.ownedPalIds.length);

    if (state.ownedPalIds.length === 0) {
      container.innerHTML = `<span class="text-xs text-mute italic">No Pals added yet. Click "+ Add Pal to Collection" or load the Starter Pack.</span>`;
      return;
    }

    container.innerHTML = state.ownedPalIds
      .map((id) => {
        const pal = getPalById(id);
        if (!pal) return '';
        return `
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-canvas-elevated border border-hairline text-xs font-medium text-ink shadow-whisper">
            <img src="${pal.image}" alt="" class="w-4 h-4 rounded-full object-contain" />
            <span>${pal.name}</span>
            <button type="button" class="btn-remove-owned text-mute hover:text-red-500 font-bold ml-0.5 cursor-pointer" data-id="${id}">×</button>
          </span>
        `;
      })
      .join('');

    container.querySelectorAll('.btn-remove-owned').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-id');
        if (id) {
          state.ownedPalIds = state.ownedPalIds.filter((x) => x !== id);
          saveState();
          renderOwnedChips();
        }
      });
    });
  }

  // Load Starter Pack
  document.getElementById('btn-load-starter-pack')?.addEventListener('click', () => {
    state.ownedPalIds = ['001', '002', '003', '004', '005', '006', '007', '011', '014', '020', '026', '038'];
    saveState();
    renderOwnedChips();
  });

  // Clear Owned Pals
  document.getElementById('btn-clear-owned-pals')?.addEventListener('click', () => {
    state.ownedPalIds = [];
    saveState();
    renderOwnedChips();
  });

  function renderPathResults() {
    renderPathHeader();
    renderOwnedChips();
    const container = document.getElementById('container-path-results');
    if (!container) return;

    const targetPal = getPalById(state.pathTargetId);
    if (!targetPal) return;

    const depthSelect = document.getElementById('select-max-depth') as HTMLSelectElement;
    const maxDepth = depthSelect ? parseInt(depthSelect.value, 10) : 3;

    const result = findShortestBreedingPath(state.ownedPalIds, state.pathTargetId, { maxDepth });

    if (result.found && result.chain.length > 0) {
      container.innerHTML = `
        <div class="rounded-[20px] border-2 border-emerald-500/40 bg-canvas-elevated p-5 sm:p-6 shadow-whisper space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-hairline pb-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 font-mono text-xs font-bold">
                  ROUTE FOUND: ${result.depth} ${result.depth === 1 ? 'STEP' : 'STEPS'}
                </span>
                <span class="text-xs text-mute font-mono">Computed in ${result.timeMs.toFixed(1)}ms</span>
              </div>
              <h4 class="text-base sm:text-lg font-bold text-ink mt-1">Shortest Breeding Chain to ${result.target.name}</h4>
            </div>

            <button
              type="button"
              id="btn-copy-route-plan"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-[8px] border border-hairline bg-canvas text-xs font-medium text-mute hover:text-ink cursor-pointer shrink-0"
            >
              <span>📋</span>
              <span>Copy Route</span>
            </button>
          </div>

          <!-- Step Progression Cards -->
          <div class="space-y-3">
            ${result.chain
              .map(
                (step, idx) => `
              <div class="rounded-[14px] bg-canvas border border-hairline p-4 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold text-link uppercase tracking-wider">Step ${step.step} of ${result.chain.length}</span>
                  ${step.isSpecial ? '<span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-amber-500/15 text-amber-600 dark:text-amber-400">⭐ Unique Recipe</span>' : ''}
                </div>

                <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
                  <!-- Parent 1 -->
                  <div class="flex items-center gap-2">
                    <img src="${step.parent1.image}" alt="${step.parent1.name}" class="w-10 h-10 rounded-[8px] bg-canvas-elevated object-contain p-1" />
                    <div>
                      <div class="text-xs font-bold text-ink">${step.parent1.name}</div>
                      <div class="text-[10px] font-mono ${state.ownedPalIds.includes(step.parent1.id) ? 'text-emerald-500' : 'text-blue-500'}">
                        ${state.ownedPalIds.includes(step.parent1.id) ? '✔ In Farm' : 'Bred from step ' + (step.step - 1)}
                      </div>
                    </div>
                  </div>

                  <span class="text-mute font-bold text-base">+</span>

                  <!-- Parent 2 -->
                  <div class="flex items-center gap-2">
                    <img src="${step.parent2.image}" alt="${step.parent2.name}" class="w-10 h-10 rounded-[8px] bg-canvas-elevated object-contain p-1" />
                    <div>
                      <div class="text-xs font-bold text-ink">${step.parent2.name}</div>
                      <div class="text-[10px] font-mono ${state.ownedPalIds.includes(step.parent2.id) ? 'text-emerald-500' : 'text-blue-500'}">
                        ${state.ownedPalIds.includes(step.parent2.id) ? '✔ In Farm' : 'Bred from step ' + (step.step - 1)}
                      </div>
                    </div>
                  </div>

                  <span class="text-link font-bold text-base">➔</span>

                  <!-- Child Result -->
                  <div class="flex items-center gap-2 bg-canvas-elevated px-3 py-1.5 rounded-[10px] border border-hairline">
                    <img src="${step.child.image}" alt="${step.child.name}" class="w-10 h-10 rounded-[8px] object-contain" />
                    <div>
                      <div class="text-xs font-bold ${idx === result.chain.length - 1 ? 'text-emerald-600 dark:text-emerald-400 font-extrabold text-sm' : 'text-ink'}">${step.child.name}</div>
                      <div class="text-[10px] font-mono text-mute">#${step.child.palDexNo}</div>
                    </div>
                  </div>
                </div>
              </div>
            `
              )
              .join('')}
          </div>
        </div>
      `;
    } else {
      // Empty or Impossible state
      container.innerHTML = `
        <div class="rounded-[20px] border border-amber-500/30 bg-amber-500/5 p-6 text-center space-y-3">
          <div class="w-12 h-12 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center mx-auto text-xl font-bold">!</div>
          <h4 class="text-base font-bold text-ink">No Breeding Route Found within ${maxDepth} Generations</h4>
          <p class="text-xs sm:text-sm text-body max-w-lg mx-auto leading-relaxed">
            ${result.message || 'Try adding more Pals to your farm, increasing the maximum generations to 4, or checking if your target requires a specific legendary parent.'}
          </p>
          <div class="pt-2 flex flex-wrap items-center justify-center gap-2">
            <button type="button" id="btn-path-fallback-direct" class="px-3.5 py-2 rounded-[10px] bg-link text-white text-xs font-semibold cursor-pointer">
              View All Direct Combinations for ${targetPal.name}
            </button>
          </div>
        </div>
      `;

      document.getElementById('btn-path-fallback-direct')?.addEventListener('click', () => {
        state.reverseTargetId = targetPal.id;
        setMode('reverse');
      });
    }
  }

  document.getElementById('btn-compute-route')?.addEventListener('click', () => {
    renderPathResults();
  });

  // IV / TALENTS PANEL
  function renderIVCalculator() {
    const valAHp = parseInt((document.getElementById('slider-iv-a-hp') as HTMLInputElement).value, 10);
    const valAAtk = parseInt((document.getElementById('slider-iv-a-atk') as HTMLInputElement).value, 10);
    const valADef = parseInt((document.getElementById('slider-iv-a-def') as HTMLInputElement).value, 10);

    const valBHp = parseInt((document.getElementById('slider-iv-b-hp') as HTMLInputElement).value, 10);
    const valBAtk = parseInt((document.getElementById('slider-iv-b-atk') as HTMLInputElement).value, 10);
    const valBDef = parseInt((document.getElementById('slider-iv-b-def') as HTMLInputElement).value, 10);

    (document.getElementById('val-iv-a-hp') as HTMLElement).textContent = String(valAHp);
    (document.getElementById('val-iv-a-atk') as HTMLElement).textContent = String(valAAtk);
    (document.getElementById('val-iv-a-def') as HTMLElement).textContent = String(valADef);

    (document.getElementById('val-iv-b-hp') as HTMLElement).textContent = String(valBHp);
    (document.getElementById('val-iv-b-atk') as HTMLElement).textContent = String(valBAtk);
    (document.getElementById('val-iv-b-def') as HTMLElement).textContent = String(valBDef);

    const result = calculateIVInheritance(
      { hp: valAHp, attack: valAAtk, defense: valADef },
      { hp: valBHp, attack: valBAtk, defense: valBDef }
    );

    (document.getElementById('odds-iv-hp') as HTMLElement).textContent = `${result.hp.targetOdds}%`;
    (document.getElementById('odds-iv-atk') as HTMLElement).textContent = `${result.attack.targetOdds}%`;
    (document.getElementById('odds-iv-def') as HTMLElement).textContent = `${result.defense.targetOdds}%`;
    (document.getElementById('odds-iv-triple') as HTMLElement).textContent = `${result.perfectTripleOdds}%`;
    (document.getElementById('odds-iv-summary') as HTMLElement).textContent = result.summary;
  }

  ['slider-iv-a-hp', 'slider-iv-a-atk', 'slider-iv-a-def', 'slider-iv-b-hp', 'slider-iv-b-atk', 'slider-iv-b-def'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', renderIVCalculator);
  });

  document.querySelectorAll('.btn-preset-iv').forEach((btn) => {
    btn.addEventListener('click', () => {
      const parent = btn.getAttribute('data-parent');
      const val = btn.getAttribute('data-val') || '100';
      if (parent === 'a') {
        (document.getElementById('slider-iv-a-hp') as HTMLInputElement).value = val;
        (document.getElementById('slider-iv-a-atk') as HTMLInputElement).value = val;
        (document.getElementById('slider-iv-a-def') as HTMLInputElement).value = val;
      } else {
        (document.getElementById('slider-iv-b-hp') as HTMLInputElement).value = val;
        (document.getElementById('slider-iv-b-atk') as HTMLInputElement).value = val;
        (document.getElementById('slider-iv-b-def') as HTMLInputElement).value = val;
      }
      renderIVCalculator();
    });
  });

  // PALDECK DATABASE PANEL

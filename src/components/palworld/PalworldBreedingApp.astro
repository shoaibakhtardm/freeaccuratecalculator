---
// src/components/palworld/PalworldBreedingApp.astro
import {
  PALWORLD_PALS,
  PALWORLD_SPECIAL_COMBINATIONS,
  DATA_VERSION,
  DATASET_UPDATED,
} from '../../data/palworldData.ts';

// Pre-serialize full Pal dataset to embed cleanly for instant client-side execution
const palsJson = JSON.stringify(
  PALWORLD_PALS.map((p) => ({
    id: p.id,
    name: p.name,
    slug: p.slug,
    palDexNo: p.palDexNo,
    elements: p.elements,
    breedingPower: p.breedingPower,
    rarity: p.rarity,
    hp: p.hp,
    attack: p.attack,
    defense: p.defense,
    image: p.image,
    description: p.description,
    isSpecial: p.isSpecial,
  }))
);

const specialCombosJson = JSON.stringify(PALWORLD_SPECIAL_COMBINATIONS);
---

<div id="palworld-app" class="space-y-6">
  <!-- Top Navigation & Mode Switcher -->
  <div class="rounded-[16px] border border-hairline bg-canvas-elevated p-2 shadow-whisper">
    <div class="flex flex-wrap items-center justify-between gap-2" role="tablist" aria-label="Breeding Modes">
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
        <button
          type="button"
          role="tab"
          id="tab-btn-pair"
          data-mode="pair"
          aria-selected="true"
          aria-controls="panel-pair"
          class="mode-tab-btn active inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[10px] text-xs sm:text-sm font-semibold transition-all cursor-pointer min-h-[44px]"
        >
          <span class="text-base">⚡</span>
          <span>Pair Calculator</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-reverse"
          data-mode="reverse"
          aria-selected="false"
          aria-controls="panel-reverse"
          class="mode-tab-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[10px] text-xs sm:text-sm font-medium text-mute hover:text-ink hover:bg-hairline-soft transition-all cursor-pointer min-h-[44px]"
        >
          <span class="text-base">🔍</span>
          <span>Find Parents</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-path"
          data-mode="path"
          aria-selected="false"
          aria-controls="panel-path"
          class="mode-tab-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[10px] text-xs sm:text-sm font-medium text-mute hover:text-ink hover:bg-hairline-soft transition-all cursor-pointer min-h-[44px]"
        >
          <span class="text-base">🗺️</span>
          <span>Breeding Path</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-iv"
          data-mode="iv"
          aria-selected="false"
          aria-controls="panel-iv"
          class="mode-tab-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[10px] text-xs sm:text-sm font-medium text-mute hover:text-ink hover:bg-hairline-soft transition-all cursor-pointer min-h-[44px]"
        >
          <span class="text-base">🧬</span>
          <span>IVs & Talents</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-database"
          data-mode="database"
          aria-selected="false"
          aria-controls="panel-database"
          class="mode-tab-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[10px] text-xs sm:text-sm font-medium text-mute hover:text-ink hover:bg-hairline-soft transition-all cursor-pointer min-h-[44px]"
        >
          <span class="text-base">📖</span>
          <span>Paldeck ({PALWORLD_PALS.length})</span>
        </button>
      </div>

      <!-- Quick Action Controls -->
      <div class="flex items-center gap-2 px-2 py-1 text-xs">
        <span class="hidden md:inline-flex items-center gap-1 text-[11px] font-mono text-mute bg-hairline-soft px-2 py-1 rounded">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          v{DATA_VERSION} • {DATASET_UPDATED}
        </span>
        <button
          type="button"
          id="btn-copy-share-url"
          class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-[8px] border border-hairline bg-canvas text-xs font-medium text-mute hover:text-ink hover:border-mute transition-colors cursor-pointer min-h-[36px]"
          title="Copy shareable link"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span id="copy-url-label">Share Plan</span>
        </button>
        <button
          type="button"
          id="btn-reset-app"
          class="inline-flex items-center gap-1 px-2 py-1.5 rounded-[8px] text-mute hover:text-ink hover:bg-hairline-soft transition-colors cursor-pointer min-h-[36px]"
          title="Reset Calculator"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span class="sr-only sm:not-sr-only">Reset</span>
        </button>
      </div>
    </div>
  </div>

  <!-- PANEL 1: PAIR CALCULATOR (Instant Answer) -->
  <div id="panel-pair" role="tabpanel" aria-labelledby="tab-btn-pair" class="space-y-6">
    <div class="rounded-[20px] border border-hairline bg-canvas-elevated p-4 sm:p-6 shadow-whisper relative overflow-hidden">
      <!-- Glow ambient accent -->
      <div class="pointer-events-none absolute -top-24 -right-24 w-72 h-72 rounded-full bg-link/10 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-emerald-500/10 blur-3xl"></div>

      <!-- Selector Grid: Parent A + Parent B -->
      <div class="grid grid-cols-1 md:grid-cols-11 gap-4 items-center">
        <!-- Parent A Slot -->
        <div class="md:col-span-5">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label for="btn-parent-a" class="text-xs font-mono font-semibold uppercase tracking-wider text-mute flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                Parent Pal 1
              </label>
              <button type="button" class="btn-clear-slot text-[11px] font-mono text-mute hover:text-ink cursor-pointer" data-slot="a">Clear</button>
            </div>
            <button
              type="button"
              id="btn-parent-a"
              class="w-full text-left rounded-[14px] border-2 border-hairline hover:border-link bg-canvas p-3.5 transition-all duration-200 cursor-pointer flex items-center justify-between gap-3 group min-h-[72px]"
            >
              <div class="flex items-center gap-3 min-w-0">
                <img id="img-parent-a" src="https://static.wikia.nocookie.net/palworld/images/b/be/Penking_menu.png/" alt="Penking" class="w-12 h-12 rounded-[10px] bg-canvas-elevated border border-hairline object-contain p-1 shrink-0" loading="eager" />
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span id="name-parent-a" class="font-bold text-ink text-sm sm:text-base truncate">Penking</span>
                    <span id="num-parent-a" class="text-[10px] font-mono text-mute px-1.5 py-0.5 rounded bg-hairline-soft shrink-0">#011</span>
                  </div>
                  <div id="types-parent-a" class="flex items-center gap-1 mt-1 text-[11px]">
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-blue-500/15 text-blue-600 dark:text-blue-400">Water</span>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-cyan-500/15 text-cyan-600 dark:text-cyan-400">Ice</span>
                  </div>
                </div>
              </div>
              <span class="text-xs font-mono text-link group-hover:underline shrink-0">Change ▾</span>
            </button>
          </div>
        </div>

        <!-- Center Operator & Swap Button -->
        <div class="md:col-span-1 flex flex-col items-center justify-center my-1 md:my-0">
          <button
            type="button"
            id="btn-swap-parents"
            class="w-10 h-10 rounded-full border border-hairline bg-canvas hover:bg-hairline-soft flex items-center justify-center text-mute hover:text-ink transition-transform active:scale-95 cursor-pointer shadow-sm"
            title="Swap Parents"
            aria-label="Swap Parent 1 and Parent 2"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
          </button>
        </div>

        <!-- Parent B Slot -->
        <div class="md:col-span-5">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label for="btn-parent-b" class="text-xs font-mono font-semibold uppercase tracking-wider text-mute flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                Parent Pal 2
              </label>
              <button type="button" class="btn-clear-slot text-[11px] font-mono text-mute hover:text-ink cursor-pointer" data-slot="b">Clear</button>
            </div>
            <button
              type="button"
              id="btn-parent-b"
              class="w-full text-left rounded-[14px] border-2 border-hairline hover:border-link bg-canvas p-3.5 transition-all duration-200 cursor-pointer flex items-center justify-between gap-3 group min-h-[72px]"
            >
              <div class="flex items-center gap-3 min-w-0">
                <img id="img-parent-b" src="https://static.wikia.nocookie.net/palworld/images/d/df/Bushi_menu.png/" alt="Bushi" class="w-12 h-12 rounded-[10px] bg-canvas-elevated border border-hairline object-contain p-1 shrink-0" loading="eager" />
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span id="name-parent-b" class="font-bold text-ink text-sm sm:text-base truncate">Bushi</span>
                    <span id="num-parent-b" class="text-[10px] font-mono text-mute px-1.5 py-0.5 rounded bg-hairline-soft shrink-0">#072</span>
                  </div>
                  <div id="types-parent-b" class="flex items-center gap-1 mt-1 text-[11px]">
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-orange-500/15 text-orange-600 dark:text-orange-400">Fire</span>
                  </div>
                </div>
              </div>
              <span class="text-xs font-mono text-link group-hover:underline shrink-0">Change ▾</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Quick Preset Picks -->
      <div class="mt-4 pt-3 border-t border-hairline flex flex-wrap items-center gap-2 text-xs">
        <span class="text-mute font-mono text-[11px]">Popular Pairs:</span>
        <button type="button" class="btn-preset-pair text-[11px] px-2 py-1 rounded bg-canvas border border-hairline hover:border-link text-body hover:text-ink transition-colors cursor-pointer" data-p1="011" data-p2="072">Penking + Bushi (Anubis)</button>
        <button type="button" class="btn-preset-pair text-[11px] px-2 py-1 rounded bg-canvas border border-hairline hover:border-link text-body hover:text-ink transition-colors cursor-pointer" data-p1="085" data-p2="007">Relaxaurus + Sparkit (Lux)</button>
        <button type="button" class="btn-preset-pair text-[11px] px-2 py-1 rounded bg-canvas border border-hairline hover:border-link text-body hover:text-ink transition-colors cursor-pointer" data-p1="097" data-p2="110">Helzephyr + Frostallion</button>
        <button type="button" class="btn-preset-pair text-[11px] px-2 py-1 rounded bg-canvas border border-hairline hover:border-link text-body hover:text-ink transition-colors cursor-pointer" data-p1="033" data-p2="060">Mossanda + Rayhound</button>
      </div>
    </div>

    <!-- RESULT CARD: THE DOMINANT ANSWER -->
    <div id="result-child-card" class="rounded-[20px] border-2 border-hairline bg-canvas-elevated p-6 sm:p-8 shadow-whisper space-y-6 transition-all duration-300">
      <div class="flex items-center justify-between border-b border-hairline pb-4">
        <div class="flex items-center gap-2">
          <span class="mono-eyebrow text-link">OFFSPRING RESULT</span>
          <span class="text-xs text-mute font-mono">• 100% Deterministic Match</span>
        </div>
        <div id="result-special-badge" class="hidden items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400 text-xs font-semibold">
          <span>⭐</span>
          <span>Unique Breeding Combo</span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
        <div class="relative shrink-0">
          <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-[18px] bg-canvas border-2 border-hairline p-2 flex items-center justify-center relative overflow-hidden shadow-inner">
            <div id="result-child-glow" class="pointer-events-none absolute inset-0 bg-amber-500/10 blur-xl"></div>
            <img
              id="result-child-img"
              src="https://static.wikia.nocookie.net/palworld/images/6/64/Anubis_menu.png/"
              alt="Anubis"
              class="w-full h-full object-contain relative z-10 transition-transform duration-300 hover:scale-105"
              loading="eager"
            />
          </div>
        </div>

        <div class="space-y-3 flex-1 text-center sm:text-left min-w-0">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
            <h2 id="result-child-name" class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">Anubis</h2>
            <span id="result-child-number" class="text-xs font-mono px-2 py-0.5 rounded-full bg-hairline text-mute font-semibold">#100</span>
          </div>

          <div id="result-child-types" class="flex flex-wrap items-center justify-center sm:justify-start gap-1.5">
            <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-amber-600/15 text-amber-700 dark:text-amber-300">Ground</span>
          </div>

          <p id="result-child-desc" class="text-xs sm:text-sm text-body leading-relaxed max-w-xl">
            One of the most sought-after Pals in Palworld, renowned for Level 4 Handiwork and incredible combat strength.
          </p>

          <!-- Breeding Power Computation Metric -->
          <div class="rounded-[10px] bg-canvas border border-hairline p-3 text-xs space-y-1 font-mono">
            <div class="flex flex-wrap items-center justify-between text-mute">
              <span>Breeding Power Equation:</span>
              <span id="result-child-bp" class="text-ink font-semibold">Breeding Score: 570</span>
            </div>
            <div id="result-child-math" class="text-[11px] text-body">
              (Penking 2070 + Bushi 1560) ÷ 2 = Target 1815 → Special Combination Override
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-hairline">
        <button
          type="button"
          id="btn-goto-reverse-from-child"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[10px] bg-link text-white text-xs sm:text-sm font-semibold hover:bg-link-deep transition-colors cursor-pointer shadow-sm min-h-[44px]"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span>Find All Parents for <span id="btn-child-target-name">Anubis</span></span>
        </button>

        <button
          type="button"
          id="btn-goto-path-from-child"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[10px] border border-hairline bg-canvas hover:bg-hairline-soft text-xs sm:text-sm font-medium text-ink transition-colors cursor-pointer min-h-[44px]"
        >
          <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          <span>Build Breeding Route</span>
        </button>

        <button
          type="button"
          id="btn-toggle-owned-from-child"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-[10px] border border-hairline bg-canvas hover:bg-hairline-soft text-xs sm:text-sm font-medium text-mute hover:text-ink transition-colors cursor-pointer min-h-[44px]"
        >
          <span class="text-emerald-500">✔</span>
          <span id="btn-owned-label">Add to My Farm</span>
        </button>
      </div>
    </div>
  </div>

  <!-- PANEL 2: REVERSE BREEDING (Find Parents for Target Pal) -->
  <div id="panel-reverse" role="tabpanel" aria-labelledby="tab-btn-reverse" class="hidden space-y-6">
    <div class="rounded-[20px] border border-hairline bg-canvas-elevated p-4 sm:p-6 shadow-whisper space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h3 class="text-lg font-bold text-ink">Reverse Breeding Lookup</h3>
          <p class="text-xs text-mute">Select any target Pal to discover every possible 2-parent breeding combination in the game.</p>
        </div>

        <!-- Target Selector Button -->
        <button
          type="button"
          id="btn-reverse-target"
          class="inline-flex items-center justify-between gap-3 px-4 py-2.5 rounded-[12px] border-2 border-link/40 bg-canvas hover:border-link transition-colors cursor-pointer min-h-[48px] shrink-0"
        >
          <div class="flex items-center gap-2.5">
            <img id="img-reverse-target" src="https://static.wikia.nocookie.net/palworld/images/6/64/Anubis_menu.png/" alt="Target" class="w-8 h-8 rounded-[8px] bg-canvas-elevated object-contain" />
            <div class="text-left">
              <div class="text-xs font-bold text-ink" id="name-reverse-target">Anubis</div>
              <div class="text-[10px] font-mono text-mute" id="num-reverse-target">#100 • Ground</div>
            </div>
          </div>
          <span class="text-xs text-link font-medium">Select Pal ▾</span>
        </button>
      </div>

      <!-- Filters Row -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-hairline">
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" class="btn-reverse-filter active px-2.5 py-1.5 rounded-[8px] text-xs font-semibold cursor-pointer" data-filter="all">All Combinations (<span id="count-all-combos">0</span>)</button>
          <button type="button" class="btn-reverse-filter px-2.5 py-1.5 rounded-[8px] text-xs font-medium text-mute hover:text-ink hover:bg-hairline cursor-pointer" data-filter="special">⭐ Unique Combos (<span id="count-special-combos">0</span>)</button>
          <button type="button" class="btn-reverse-filter px-2.5 py-1.5 rounded-[8px] text-xs font-medium text-mute hover:text-ink hover:bg-hairline cursor-pointer" data-filter="owned">✅ I Own Both (<span id="count-owned-combos">0</span>)</button>
        </div>

        <div class="relative w-full sm:w-64">
          <input
            type="text"
            id="input-reverse-search"
            placeholder="Filter parents (e.g. Bushi)..."
            class="w-full rounded-[8px] border border-hairline bg-canvas px-3 py-1.5 text-xs text-ink placeholder-mute focus:outline-none focus:border-link"
          />
        </div>
      </div>
    </div>

    <!-- Parent Pairs Results Grid -->
    <div id="container-reverse-results" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <!-- Injected dynamically via client script -->
    </div>
  </div>

  <!-- PANEL 3: BREEDING PATH & FARM PLANNER -->
  <div id="panel-path" role="tabpanel" aria-labelledby="tab-btn-path" class="hidden space-y-6">
    <div class="rounded-[20px] border border-hairline bg-canvas-elevated p-4 sm:p-6 shadow-whisper space-y-5">
      <div>
        <h3 class="text-lg font-bold text-ink">Shortest Breeding Path Finder (Graph BFS Engine)</h3>
        <p class="text-xs text-body leading-relaxed">
          Tell us which Pals you currently own in your Paldeck. Our graph algorithm will compute the minimum breeding generations needed to produce your target Pal.
        </p>
      </div>

      <!-- Farm / Owned Pals Management -->
      <div class="rounded-[14px] bg-canvas border border-hairline p-4 space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono font-bold text-ink uppercase tracking-wider">Pals in Your Farm (<span id="count-owned-pals">0</span>)</span>
          </div>
          <div class="flex items-center gap-1.5">
            <button type="button" id="btn-load-starter-pack" class="text-[11px] font-mono text-link hover:underline cursor-pointer">+ Starter Pack</button>
            <span class="text-mute text-xs">•</span>
            <button type="button" id="btn-clear-owned-pals" class="text-[11px] font-mono text-mute hover:text-red-500 cursor-pointer">Clear All</button>
          </div>
        </div>

        <!-- Owned Pal Chips -->
        <div id="container-owned-chips" class="flex flex-wrap gap-1.5 min-h-[40px] items-center">
          <span class="text-xs text-mute italic">No Pals added yet. Click "+ Add Pal" or load the Starter Pack below.</span>
        </div>

        <!-- Add Pal Input Button -->
        <div class="pt-2 flex items-center gap-2">
          <button
            type="button"
            id="btn-open-add-owned-modal"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-[8px] border border-dashed border-hairline hover:border-link bg-canvas-elevated text-xs font-medium text-mute hover:text-ink transition-colors cursor-pointer min-h-[36px]"
          >
            <span>+</span>
            <span>Add Pal to Collection</span>
          </button>
        </div>
      </div>

      <!-- Target Selection & Route Controls -->
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-center pt-2">
        <div class="sm:col-span-6 space-y-1.5">
          <label for="btn-path-target" class="text-xs font-mono font-semibold uppercase text-mute">Desired Target Pal</label>
          <button
            type="button"
            id="btn-path-target"
            class="w-full text-left rounded-[12px] border border-hairline hover:border-link bg-canvas p-3 flex items-center justify-between cursor-pointer min-h-[52px]"
          >

  document.getElementById('input-database-search')?.addEventListener('input', (e) => {
    state.dbSearch = (e.target as HTMLInputElement).value;
    renderDatabaseGrid();
  });

  // MODAL / COMMAND PALETTE IMPLEMENTATION
  const modal = document.getElementById('pal-selection-modal');
  const modalSearchInput = document.getElementById('modal-search-input') as HTMLInputElement;
  const modalPalList = document.getElementById('modal-pal-list');
  let modalSelectedElem = 'all';

  function openPalModal(slot: 'a' | 'b' | 'reverse' | 'path' | 'owned') {
    state.activeModalSlot = slot;
    if (modal) modal.classList.remove('hidden');
    if (modalSearchInput) {
      modalSearchInput.value = '';
      setTimeout(() => modalSearchInput.focus(), 50);
    }
    renderModalList();
  }

  function closePalModal() {
    if (modal) modal.classList.add('hidden');
    state.activeModalSlot = null;
  }

  function renderModalList() {
    if (!modalPalList) return;
    const q = modalSearchInput?.value?.toLowerCase().trim() || '';

    let list = getAllPals();
    if (modalSelectedElem !== 'all') {
      list = list.filter((p) => p.elements.includes(modalSelectedElem));
    }
    if (q) {
      list = list.filter(
        (p) =>
          p.name.toLowerCase().includes(q) ||
          p.palDexNo.includes(q) ||
          p.elements.some((e) => e.includes(q))
      );
    }

    modalPalList.innerHTML = list
      .map(
        (p) => `
        <button
          type="button"
          class="btn-modal-pick-pal w-full text-left rounded-[12px] border border-hairline hover:border-link bg-canvas p-2.5 flex items-center justify-between gap-2.5 transition-colors cursor-pointer group"
          data-id="${p.id}"
        >
          <div class="flex items-center gap-2.5 min-w-0">
            <img src="${p.image}" alt="${p.name}" class="w-10 h-10 rounded-[8px] bg-canvas-elevated object-contain p-1 shrink-0" loading="lazy" />
            <div class="min-w-0">
              <div class="flex items-center gap-1.5">
                <span class="text-xs sm:text-sm font-bold text-ink truncate group-hover:text-link">${p.name}</span>
                <span class="text-[10px] font-mono text-mute">#${p.palDexNo}</span>
              </div>
              <div class="flex items-center gap-1 mt-0.5">
                ${p.elements.map((el) => `<span class="px-1.5 py-0.2 rounded text-[9px] font-medium capitalize ${getElementBadge(el)}">${el}</span>`).join('')}
                <span class="text-[10px] font-mono text-mute ml-1">BP: ${p.breedingPower}</span>
              </div>
            </div>
          </div>
          <span class="text-xs font-mono text-link opacity-0 group-hover:opacity-100 transition-opacity">Select ➔</span>
        </button>
      `
      )
      .join('');

    modalPalList.querySelectorAll('.btn-modal-pick-pal').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (!id) return;

        if (state.activeModalSlot === 'a') {
          state.parentAId = id;
          renderPairCalculator();
        } else if (state.activeModalSlot === 'b') {
          state.parentBId = id;
          renderPairCalculator();
        } else if (state.activeModalSlot === 'reverse') {
          state.reverseTargetId = id;
          renderReverseResults();
        } else if (state.activeModalSlot === 'path') {
          state.pathTargetId = id;
          renderPathResults();
        } else if (state.activeModalSlot === 'owned') {
          if (!state.ownedPalIds.includes(id)) {
            state.ownedPalIds.push(id);
            renderOwnedChips();
          }
        }

        saveState();
        closePalModal();
      });
    });
  }

  modalSearchInput?.addEventListener('input', renderModalList);

  document.querySelectorAll('.btn-modal-elem-filter').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-modal-elem-filter').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      modalSelectedElem = btn.getAttribute('data-elem') || 'all';
      renderModalList();
    });
  });

  document.getElementById('btn-close-modal')?.addEventListener('click', closePalModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closePalModal();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closePalModal();
    }
  });

  // Slot trigger buttons
  document.getElementById('btn-parent-a')?.addEventListener('click', () => openPalModal('a'));
  document.getElementById('btn-parent-b')?.addEventListener('click', () => openPalModal('b'));
  document.getElementById('btn-reverse-target')?.addEventListener('click', () => openPalModal('reverse'));
  document.getElementById('btn-path-target')?.addEventListener('click', () => openPalModal('path'));
  document.getElementById('btn-open-add-owned-modal')?.addEventListener('click', () => openPalModal('owned'));

  // Clear slot buttons
  document.querySelectorAll('.btn-clear-slot').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const slot = btn.getAttribute('data-slot');
      if (slot === 'a') openPalModal('a');
      if (slot === 'b') openPalModal('b');
    });
  });

  // Share URL button
  document.getElementById('btn-copy-share-url')?.addEventListener('click', () => {
    const origin = window.location.origin;
    const url = `${origin}/palworld-breeding-calculator/?p1=${state.parentAId}&p2=${state.parentBId}&target=${state.pathTargetId}&mode=${state.mode}`;
    navigator.clipboard.writeText(url).then(() => {
      const label = document.getElementById('copy-url-label');
      if (label) {
        label.textContent = 'Link Copied!';
        setTimeout(() => (label.textContent = 'Share Plan'), 2000);
      }
    });
  });

  // Reset Calculator
  document.getElementById('btn-reset-app')?.addEventListener('click', () => {
    state.parentAId = '011'; // Penking
    state.parentBId = '072'; // Bushi
    state.reverseTargetId = '100';
    state.pathTargetId = '100';
    state.ownedPalIds = ['001', '002', '003', '005', '011', '014', '038'];
    saveState();
    renderPairCalculator();
    renderReverseResults();
    renderPathResults();
    renderIVCalculator();
  });

  // Initial Boot
  setMode(state.mode);
  renderPairCalculator();
  renderIVCalculator();
</script>

            <img src="${p.image}" alt="${p.name}" class="w-full h-full object-contain group-hover:scale-105 transition-transform" loading="lazy" />
          </div>
          <div>
            <div class="flex items-center justify-center gap-1">
              <span class="text-xs font-bold text-ink truncate">${p.name}</span>

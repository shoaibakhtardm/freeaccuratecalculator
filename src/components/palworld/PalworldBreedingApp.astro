<!-- Data bridge for client script -->
<script id="palworld-embedded-data" type="application/json" set:html={palsJson}></script>
<script id="palworld-embedded-specials" type="application/json" set:html={specialCombosJson}></script>

<script>
  import {
    calculateChild,
    findParentCombinations,
    findShortestBreedingPath,
    calculateIVInheritance,
    searchPals,
    getPalById,
    getAllPals,
    getSpecialCombinations,
    type Pal,
  } from '../../engines/palworldBreedingEngine.ts';

  // State Management
  const STORAGE_KEY = 'fac_palworld_breeding_v1';
  let state = {
    mode: 'pair',
    parentAId: '011', // Penking default
    parentBId: '072', // Bushi default
    reverseTargetId: '100', // Anubis default
    pathTargetId: '100', // Anubis default
    ownedPalIds: ['001', '002', '003', '005', '011', '014', '038'], // starter farm
    maxDepth: 3,
    activeModalSlot: null as 'a' | 'b' | 'reverse' | 'path' | 'owned' | null,
    reverseFilter: 'all' as 'all' | 'special' | 'owned',
    reverseSearch: '',
    dbElement: 'all',
    dbSearch: '',
  };

  // Load from localStorage if available
  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      const parsed = JSON.parse(saved);
      if (parsed.ownedPalIds && Array.isArray(parsed.ownedPalIds)) {
        state.ownedPalIds = parsed.ownedPalIds;
      }
      if (parsed.parentAId && getPalById(parsed.parentAId)) state.parentAId = parsed.parentAId;
      if (parsed.parentBId && getPalById(parsed.parentBId)) state.parentBId = parsed.parentBId;
    }
  } catch (e) {
    console.warn('LocalStorage unavailable or corrupted', e);
  }

  // Read URL search params
  const urlParams = new URLSearchParams(window.location.search);
  const p1Param = urlParams.get('p1') || urlParams.get('parent1');
  const p2Param = urlParams.get('p2') || urlParams.get('parent2');
  const targetParam = urlParams.get('target');
  const modeParam = urlParams.get('mode');

  if (p1Param && getPalById(p1Param)) state.parentAId = p1Param;
  if (p2Param && getPalById(p2Param)) state.parentBId = p2Param;
  if (targetParam && getPalById(targetParam)) {
    state.reverseTargetId = targetParam;
    state.pathTargetId = targetParam;
  }
  if (modeParam && ['pair', 'reverse', 'path', 'iv', 'database'].includes(modeParam)) {
    state.mode = modeParam;
  }

  function saveState() {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          ownedPalIds: state.ownedPalIds,
          parentAId: state.parentAId,
          parentBId: state.parentBId,
        })
      );
    } catch (e) {}
  }

  // Element Color Helpers
  function getElementBadge(elem: string) {
    const e = elem.toLowerCase();
    const map: Record<string, string> = {
      neutral: 'bg-slate-500/15 text-slate-700 dark:text-slate-300',
      fire: 'bg-orange-500/15 text-orange-700 dark:text-orange-400',
      water: 'bg-blue-500/15 text-blue-700 dark:text-blue-400',
      grass: 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-400',
      electric: 'bg-amber-500/15 text-amber-700 dark:text-amber-400',
      ice: 'bg-cyan-500/15 text-cyan-700 dark:text-cyan-400',
      ground: 'bg-amber-700/15 text-amber-800 dark:text-amber-300',
      dark: 'bg-purple-500/15 text-purple-700 dark:text-purple-400',
      dragon: 'bg-indigo-500/15 text-indigo-700 dark:text-indigo-400',
    };
    return map[e] || 'bg-hairline text-ink';
  }

  // DOM Elements
  const tabButtons = document.querySelectorAll('.mode-tab-btn');
  const panels = {
    pair: document.getElementById('panel-pair'),
    reverse: document.getElementById('panel-reverse'),
    path: document.getElementById('panel-path'),
    iv: document.getElementById('panel-iv'),
    database: document.getElementById('panel-database'),
  };

  // Switch Mode
  function setMode(mode: string) {
    state.mode = mode;
    tabButtons.forEach((btn) => {
      const active = btn.getAttribute('data-mode') === mode;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
    });

    Object.entries(panels).forEach(([m, panel]) => {
      if (!panel) return;
      if (m === mode) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });

    if (mode === 'reverse') renderReverseResults();
    if (mode === 'path') renderPathResults();
    if (mode === 'database') renderDatabaseGrid();
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const m = btn.getAttribute('data-mode');
      if (m) setMode(m);
    });
  });

  // Render Pair Calculator
  function renderPairCalculator() {
    const palA = getPalById(state.parentAId);
    const palB = getPalById(state.parentBId);

    if (palA) {
      const img = document.getElementById('img-parent-a') as HTMLImageElement;
      const name = document.getElementById('name-parent-a');
      const num = document.getElementById('num-parent-a');
      const types = document.getElementById('types-parent-a');
      if (img) { img.src = palA.image; img.alt = palA.name; }
      if (name) name.textContent = palA.name;
      if (num) num.textContent = `#${palA.palDexNo}`;
      if (types) {
        types.innerHTML = palA.elements
          .map((el) => `<span class="px-1.5 py-0.5 rounded text-[10px] font-medium capitalize ${getElementBadge(el)}">${el}</span>`)
          .join('');
      }
    }

    if (palB) {
      const img = document.getElementById('img-parent-b') as HTMLImageElement;
      const name = document.getElementById('name-parent-b');
      const num = document.getElementById('num-parent-b');
      const types = document.getElementById('types-parent-b');
      if (img) { img.src = palB.image; img.alt = palB.name; }
      if (name) name.textContent = palB.name;
      if (num) num.textContent = `#${palB.palDexNo}`;
      if (types) {
        types.innerHTML = palB.elements
          .map((el) => `<span class="px-1.5 py-0.5 rounded text-[10px] font-medium capitalize ${getElementBadge(el)}">${el}</span>`)
          .join('');
      }
    }

    // Compute Offspring
    if (palA && palB) {
      const result = calculateChild(palA.id, palB.id);
      if (result && result.child) {
        const child = result.child;
        const resImg = document.getElementById('result-child-img') as HTMLImageElement;
        const resName = document.getElementById('result-child-name');
        const resNum = document.getElementById('result-child-number');
        const resTypes = document.getElementById('result-child-types');
        const resDesc = document.getElementById('result-child-desc');
        const resBp = document.getElementById('result-child-bp');
        const resMath = document.getElementById('result-child-math');
        const resSpecial = document.getElementById('result-special-badge');
        const btnChildName = document.getElementById('btn-child-target-name');
        const btnOwnedLabel = document.getElementById('btn-owned-label');

        if (resImg) { resImg.src = child.image; resImg.alt = child.name; }
        if (resName) resName.textContent = child.name;
        if (resNum) resNum.textContent = `#${child.palDexNo}`;
        if (btnChildName) btnChildName.textContent = child.name;

        if (resTypes) {
          resTypes.innerHTML = child.elements
            .map((el) => `<span class="px-2.5 py-1 rounded-md text-xs font-semibold capitalize ${getElementBadge(el)}">${el}</span>`)
            .join('');
        }

        if (resDesc) {
          resDesc.textContent = child.description || `Offspring of ${palA.name} and ${palB.name}.`;
        }

        if (resBp) resBp.textContent = `Breeding Score: ${child.breedingPower}`;

        if (resMath) {
          if (result.isSpecial) {
            resMath.innerHTML = `<strong>Special Combination Recipe:</strong> ${palA.name} + ${palB.name} overrides the breeding formula to produce ${child.name}.`;
          } else {
            resMath.innerHTML = `(${palA.name} ${palA.breedingPower} + ${palB.name} ${palB.breedingPower}) ÷ 2 = Target ${result.calculatedPowerTarget} → Closest Match: <strong>${child.name}</strong> (${child.breedingPower})`;
          }
        }

        if (resSpecial) {
          if (result.isSpecial) {
            resSpecial.classList.remove('hidden');
            resSpecial.classList.add('inline-flex');
          } else {
            resSpecial.classList.add('hidden');
            resSpecial.classList.remove('inline-flex');
          }
        }

        if (btnOwnedLabel) {
          const isOwned = state.ownedPalIds.includes(child.id);
          btnOwnedLabel.textContent = isOwned ? 'Owned in Farm' : 'Add to My Farm';
        }
      }
    }
  }

  // Swap Parents
  document.getElementById('btn-swap-parents')?.addEventListener('click', () => {
    const tmp = state.parentAId;
    state.parentAId = state.parentBId;
    state.parentBId = tmp;
    saveState();
    renderPairCalculator();
  });

  // Presets in Pair Calculator
  document.querySelectorAll('.btn-preset-pair').forEach((btn) => {
    btn.addEventListener('click', () => {
      const p1 = btn.getAttribute('data-p1');
      const p2 = btn.getAttribute('data-p2');
      if (p1 && p2) {
        state.parentAId = p1;
        state.parentBId = p2;
        saveState();
        renderPairCalculator();
      }
    });
  });

  // Result Card Action: Goto Reverse Lookup
  document.getElementById('btn-goto-reverse-from-child')?.addEventListener('click', () => {
    const res = calculateChild(state.parentAId, state.parentBId);
    if (res?.child) {
      state.reverseTargetId = res.child.id;
      setMode('reverse');
      renderReverseHeader();
      renderReverseResults();
    }
  });

  // Result Card Action: Goto Path Route
  document.getElementById('btn-goto-path-from-child')?.addEventListener('click', () => {
    const res = calculateChild(state.parentAId, state.parentBId);
    if (res?.child) {
      state.pathTargetId = res.child.id;
      setMode('path');
      renderPathHeader();
      renderPathResults();
    }
  });

  // Result Card Action: Toggle Owned
  document.getElementById('btn-toggle-owned-from-child')?.addEventListener('click', () => {
    const res = calculateChild(state.parentAId, state.parentBId);
    if (res?.child) {
      const id = res.child.id;
      if (state.ownedPalIds.includes(id)) {
        state.ownedPalIds = state.ownedPalIds.filter((x) => x !== id);
      } else {
        state.ownedPalIds.push(id);
      }
      saveState();
      renderPairCalculator();
      renderOwnedChips();
    }

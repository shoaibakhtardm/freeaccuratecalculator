    if (state.dbSearch) {
      const q = state.dbSearch.toLowerCase().trim();
      pals = pals.filter(
        (p) =>
          p.name.toLowerCase().includes(q) ||
          p.palDexNo.includes(q) ||
          p.elements.some((e) => e.includes(q))
      );

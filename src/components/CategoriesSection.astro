---
// src/components/CategoriesSection.astro
import type { CountryConfig } from '../data/countries';
import { getCountryCategories, type CategoryItem } from '../data/categories';
import { frCategories } from '../data/i18n';
import AutocompleteSearch from './common/AutocompleteSearch.astro';

interface Props {
  country?: CountryConfig;
  title?: string;
  icon?: string;
  class?: string;
  showSearch?: boolean;
}

const {
  country,
  title,
  icon = '📁',
  class: className = '',
  showSearch = country ? true : false,
} = Astro.props;

const isFrancePage = Astro.url.pathname.startsWith('/countries/france') || Astro.url.pathname.startsWith('/fr/');
const isFrench = country?.slug === 'france' || isFrancePage || Astro.currentLocale === 'fr';
const categories: CategoryItem[] = getCountryCategories(country);
const sectionHeading = title || (isFrench ? 'Catégories' : 'Categories');
const sectionAriaLabel = country
  ? (isFrench ? `Catégories de simulateurs France` : `${country.name} Calculator Categories`)
  : (isFrench ? 'Catégories de simulateurs et calculateurs' : 'Calculator Categories');
---

<!-- 3-by-3 Category Navigation Grid ("tin tin karke" - UI/UX Designer Scaled Edition) -->
<nav
  aria-label={sectionAriaLabel}
  class:list={[
    "w-full max-w-2xl sm:max-w-3xl lg:max-w-4xl mx-auto rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-800/90 bg-white/80 dark:bg-slate-900/80 p-3 sm:p-5 md:p-6 shadow-sm dark:shadow-xl backdrop-blur-xl box-border text-center",
    className
  ]}
>
  <div class="flex items-center justify-center border-b border-slate-200/80 dark:border-slate-800/80 pb-3 sm:pb-3.5 mb-3.5 sm:mb-4 px-1 text-center">
    <h2 class="font-outfit text-xs sm:text-sm font-black uppercase tracking-[0.2em] text-slate-900 dark:text-white flex items-center justify-center gap-2">
      <span class="text-base sm:text-lg">{icon}</span>
      <span>{sectionHeading}</span>
    </h2>
  </div>

  <!-- Live Spotlight Search Bar: Directly below Categories Header -->
  {showSearch && (
    <div class="mb-4 sm:mb-5 max-w-xl mx-auto w-full px-1">
      <AutocompleteSearch
        id={country ? `categories-search-${country.slug}` : 'categories-search'}
        country={country}
        isFrench={isFrench}
      />
    </div>
  )}

  <!-- 20 Categories in 3-Column Grid Layout (Top Emoji, Bottom Single-Line Text) -->
  <div class="grid grid-cols-3 gap-2 sm:gap-3 md:gap-3.5">
    {categories.map((cat) => {
      const href = country ? `/countries/${country.slug}/${cat.id}/` : `/${cat.id}/`;
      const catDisplayName = isFrench ? (frCategories[cat.id] || cat.name) : cat.name;
      const linkTitle = country
        ? (isFrench ? `Explorer les simulateurs et calculateurs France ${catDisplayName}` : `Explore ${country.name} ${cat.name} Calculators`)
        : (isFrench ? `Explorer les simulateurs et calculateurs ${catDisplayName}` : `Explore ${cat.name} Calculators`);

      return (
        <a
          href={href}
          data-category={cat.id}
          title={linkTitle}
          class="category-filter-btn group relative flex flex-col items-center justify-center text-center w-full min-w-0 min-h-[68px] sm:min-h-[78px] md:min-h-[86px] rounded-xl sm:rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white/90 dark:bg-slate-950/70 hover:bg-slate-50 dark:hover:bg-slate-800/80 hover:border-indigo-500/50 dark:hover:border-indigo-400/50 p-2 sm:p-3 cursor-pointer transition-all duration-200 shadow-2xs hover:shadow-md hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-indigo-500 active:scale-[0.97]"
        >
          <span class="flex h-8 w-8 sm:h-9 sm:w-9 md:h-10 md:w-10 shrink-0 items-center justify-center rounded-xl sm:rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 text-base sm:text-lg md:text-xl shadow-2xs group-hover:scale-110 group-hover:border-indigo-400/50 transition-transform mb-1 sm:mb-1.5">
            {cat.icon}
          </span>
          <span class="w-full text-center font-semibold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors text-[11px] sm:text-xs md:text-sm leading-tight whitespace-nowrap overflow-hidden">
            {catDisplayName}
          </span>
        </a>
      );
    })}
  </div>
</nav>

---
// File: src/components/love/RomanticBackground.astro
---

<!-- ULTRA-ELITE AMBIENT ROMANCE BACKGROUND: GPU-ACCELERATED 3D ROSE PETALS + GLOWING RED HEARTS + STARDUST -->
<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden select-none" aria-hidden="true">
  <!-- Multi-layered Warm Velvet Ambient Glow Orbs with Hardware-Accelerated Compositing -->
  <div class="absolute -top-24 left-1/4 w-[32rem] sm:w-[46rem] h-[32rem] sm:h-[46rem] bg-gradient-to-br from-rose-600/25 via-red-600/15 to-transparent rounded-full blur-[100px] sm:blur-[140px] dark:from-rose-950/50 dark:via-purple-950/40 animate-pulse transform-gpu" style="animation-duration: 9s;"></div>
  <div class="absolute top-1/3 right-5 sm:right-10 w-[26rem] sm:w-[38rem] h-[26rem] sm:h-[38rem] bg-gradient-to-bl from-pink-500/20 via-rose-500/15 to-transparent rounded-full blur-[90px] sm:blur-[130px] dark:from-rose-900/30 dark:via-red-950/30 transform-gpu" style="animation-duration: 13s;"></div>
  <div class="absolute bottom-10 left-5 sm:left-1/3 w-[30rem] h-[30rem] bg-gradient-to-t from-red-600/15 via-purple-600/10 to-transparent rounded-full blur-[110px] dark:from-purple-950/40 dark:via-rose-950/30 transform-gpu"></div>

  <!-- Ultra-Elite Canvas for 3D Rose Petals + Rotating Red Hearts + Sparkle Stardust -->
  <canvas id="ultra-romantic-canvas" class="w-full h-full opacity-85 dark:opacity-95 transform-gpu"></canvas>
</div>

<script is:inline>
  (function initUltraRomanticEngine() {
    const canvas = document.getElementById('ultra-romantic-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      }, 150);
    }, { passive: true });

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const isMobile = window.innerWidth < 768;
    const numPetals = isMobile ? 12 : 22;
    const numHearts = isMobile ? 10 : 18;
    const numSparkles = isMobile ? 12 : 20;

    const petals = [];
    const hearts = [];
    const sparkles = [];
    const interactiveParticles = [];

    // 1. 3D Botanical Rose Petals (Optimized Draw Paths)
    class RosePetal {
      constructor() {
        this.reset(true);
      }
      reset(initial = false) {
        this.x = Math.random() * width;
        this.y = initial ? Math.random() * height : -35;
        this.size = Math.random() * 14 + 10;
        this.speedY = Math.random() * 0.9 + 0.4;
        this.speedX = Math.random() * 0.6 - 0.3;
        this.rotation = Math.random() * 360;
        this.rotationSpeed = (Math.random() - 0.5) * 1.2;
        this.roll = Math.random() * Math.PI;
        this.rollSpeed = Math.random() * 0.025 + 0.012;
        this.opacity = Math.random() * 0.4 + 0.3;
        this.swaySpeed = Math.random() * 0.018 + 0.008;
        this.swayOffset = Math.random() * Math.PI * 2;
        
        const colors = [
          ['#E11D48', '#BE123C'],
          ['#F43F5E', '#9F1239'],
          ['#FB7185', '#E11D48'],
          ['#881337', '#4C0519'],
        ];
        this.palette = colors[Math.floor(Math.random() * colors.length)];
      }
      update() {
        this.y += this.speedY;
        this.swayOffset += this.swaySpeed;
        this.x += Math.sin(this.swayOffset) * 1.0 + this.speedX;
        this.rotation += this.rotationSpeed;
        this.roll += this.rollSpeed;

        if (this.y > height + 40 || this.x < -40 || this.x > width + 40) {
          this.reset(false);
        }
      }
      draw() {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate((this.rotation * Math.PI) / 180);
        
        const scaleY = Math.sin(this.roll);
        ctx.scale(1, Math.abs(scaleY) * 0.75 + 0.25);

        const grad = ctx.createLinearGradient(-this.size / 2, -this.size / 2, this.size / 2, this.size / 2);
        grad.addColorStop(0, this.palette[0]);
        grad.addColorStop(1, this.palette[1]);

        ctx.fillStyle = grad;
        ctx.globalAlpha = this.opacity;

        ctx.beginPath();
        ctx.moveTo(0, -this.size / 2);
        ctx.bezierCurveTo(this.size / 1.5, -this.size / 2, this.size / 1.5, this.size / 2, 0, this.size);
        ctx.bezierCurveTo(-this.size / 1.5, this.size / 2, -this.size / 1.5, -this.size / 2, 0, -this.size / 2);
        ctx.fill();

        ctx.restore();
      }
    }

    // 2. Swirling & Floating Glowing Red Hearts (Clean Bézier Curves)
    class RedHeart {
      constructor() {
        this.reset(true);
      }
      reset(initial = false) {
        this.x = Math.random() * width;
        this.y = initial ? Math.random() * height : height + 30;
        this.size = Math.random() * 12 + 7;
        this.speedY = Math.random() * 0.75 + 0.35;
        this.rotation = Math.random() * 360;
        this.rotationSpeed = (Math.random() - 0.5) * 1.4;
        this.roll = Math.random() * Math.PI;
        this.rollSpeed = Math.random() * 0.02 + 0.01;
        this.opacity = Math.random() * 0.45 + 0.25;
        this.pulse = Math.random() * Math.PI;
        this.pulseSpeed = Math.random() * 0.035 + 0.015;
        this.swaySpeed = Math.random() * 0.016 + 0.008;
        this.swayOffset = Math.random() * Math.PI * 2;

        const redVariants = [
          ['#DC2626', '#991B1B'],
          ['#EF4444', '#B91C1C'],
          ['#E11D48', '#881337'],
          ['#F43F5E', '#BE123C'],
        ];
        this.palette = redVariants[Math.floor(Math.random() * redVariants.length)];
      }
      update() {
        this.y -= this.speedY;
        this.swayOffset += this.swaySpeed;
        this.x += Math.sin(this.swayOffset) * 0.7;
        this.rotation += this.rotationSpeed;
        this.roll += this.rollSpeed;
        this.pulse += this.pulseSpeed;

        if (this.y < -35 || this.x < -35 || this.x > width + 35) {
          this.reset(false);
        }
      }
      draw() {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate((this.rotation * Math.PI) / 180);

        const scaleX = Math.cos(this.roll) * 0.25 + 0.75;
        const pulseScale = (Math.sin(this.pulse) * 0.12 + 1) * (this.size / 20);
        ctx.scale(scaleX * pulseScale, pulseScale);

        const grad = ctx.createLinearGradient(-10, -10, 10, 15);
        grad.addColorStop(0, this.palette[0]);
        grad.addColorStop(1, this.palette[1]);

        ctx.fillStyle = grad;
        ctx.globalAlpha = this.opacity;

        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.bezierCurveTo(-10, -12, -22, 2, 0, 20);
        ctx.bezierCurveTo(22, 2, 10, -12, 0, 0);
        ctx.fill();

        ctx.restore();
      }
    }

    // 3. Ambient Stardust Sparkles
    class StardustSparkle {
      constructor() {
        this.reset();
      }
      reset() {
        this.x = Math.random() * width;
        this.y = Math.random() * height;
        this.size = Math.random() * 2 + 0.8;
        this.alpha = Math.random() * 0.5 + 0.2;
        this.twinkleSpeed = Math.random() * 0.025 + 0.01;
        this.twinkleOffset = Math.random() * Math.PI * 2;
      }
      update() {
        this.twinkleOffset += this.twinkleSpeed;
        this.alpha = Math.sin(this.twinkleOffset) * 0.35 + 0.45;
        this.y -= 0.12;
        if (this.y < 0) this.y = height;
      }
      draw() {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.fillStyle = '#FFD1DC';
        ctx.globalAlpha = Math.max(0.1, this.alpha);
        
        ctx.beginPath();
        ctx.arc(0, 0, this.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
    }

    // 4. Interactive Cursor Burst on Move/Tap
    class CursorSparkle {
      constructor(x, y) {
        this.x = x;
        this.y = y;
        this.vx = (Math.random() - 0.5) * 2;
        this.vy = (Math.random() - 0.5) * 2 - 0.4;
        this.size = Math.random() * 5 + 2.5;
        this.alpha = 0.85;
        this.color = Math.random() > 0.4 ? '#EF4444' : '#FB7185';
        this.isHeart = Math.random() > 0.5;
      }
      update() {
        this.x += this.vx;
        this.y += this.vy;
        this.alpha -= 0.03;
      }
      draw() {
        if (this.alpha <= 0) return;
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.globalAlpha = this.alpha;
        ctx.fillStyle = this.color;

        if (this.isHeart) {
          const s = this.size / 15;
          ctx.scale(s, s);
          ctx.beginPath();
          ctx.moveTo(0, 0);
          ctx.bezierCurveTo(-6, -8, -12, 2, 0, 12);
          ctx.bezierCurveTo(12, 2, 6, -8, 0, 0);
          ctx.fill();
        } else {
          ctx.beginPath();
          ctx.arc(0, 0, this.size / 2, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }
    }

    // Initialize Particle Arrays
    for (let i = 0; i < numPetals; i++) petals.push(new RosePetal());
    for (let i = 0; i < numHearts; i++) hearts.push(new RedHeart());
    for (let i = 0; i < numSparkles; i++) sparkles.push(new StardustSparkle());

    // If reduced motion is requested, render one static aesthetic frame and exit loop
    if (prefersReducedMotion) {
      ctx.clearRect(0, 0, width, height);
      for (let i = 0; i < sparkles.length; i++) sparkles[i].draw();
      for (let i = 0; i < hearts.length; i++) hearts[i].draw();
      for (let i = 0; i < petals.length; i++) petals[i].draw();
      return;
    }

    // Mouse & Touch Interaction Listeners
    let lastSpawn = 0;
    function addInteractiveSparkles(x, y) {
      const now = performance.now();
      if (now - lastSpawn < 40) return;
      lastSpawn = now;
      if (interactiveParticles.length < 20) {
        interactiveParticles.push(new CursorSparkle(x, y));
      }
    }

    window.addEventListener('mousemove', (e) => addInteractiveSparkles(e.clientX, e.clientY), { passive: true });
    window.addEventListener('touchmove', (e) => {
      if (e.touches[0]) addInteractiveSparkles(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });

    let animFrameId = null;
    let isRunning = true;

    // Master Animation Loop (Pauses automatically when tab is hidden)
    function renderFrame() {
      if (!isRunning) return;
      ctx.clearRect(0, 0, width, height);

      // Render Stardust
      for (let i = 0; i < sparkles.length; i++) {
        sparkles[i].update();
        sparkles[i].draw();
      }

      // Render Floating Red Hearts
      for (let i = 0; i < hearts.length; i++) {
        hearts[i].update();
        hearts[i].draw();
      }

      // Render 3D Rose Petals
      for (let i = 0; i < petals.length; i++) {
        petals[i].update();
        petals[i].draw();
      }

      // Render Cursor Burst Particles
      for (let i = interactiveParticles.length - 1; i >= 0; i--) {
        const p = interactiveParticles[i];
        p.update();
        p.draw();
        if (p.alpha <= 0) {
          interactiveParticles.splice(i, 1);
        }
      }

      animFrameId = requestAnimationFrame(renderFrame);
    }

    // Handle Page Visibility changes to save CPU/GPU cycles
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        isRunning = false;
        if (animFrameId) {
          cancelAnimationFrame(animFrameId);
          animFrameId = null;
        }
      } else {
        if (!isRunning) {
          isRunning = true;
          animFrameId = requestAnimationFrame(renderFrame);
        }
      }
    });

    animFrameId = requestAnimationFrame(renderFrame);
  })();
</script>

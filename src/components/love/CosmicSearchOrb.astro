---
// File: src/components/love/CosmicSearchOrb.astro
import { LOVE_CALCULATORS } from '../../data/loveCalculators';

const searchableCalculators = LOVE_CALCULATORS.map((calc) => ({
  id: calc.slug,
  name: calc.name,
  shortName: calc.shortName,
  keyword: calc.keyword,
  volume: calc.volume,
  category: calc.category,
  icon: calc.icon,
  badge: calc.badge,
  href: `/love/${calc.slug}/`,
  description: calc.description,
  fields: calc.fields,
  formulaTitle: calc.formulaTitle,
}));

const searchableJson = JSON.stringify(searchableCalculators);
---

<!-- COSMIC SEARCH ORB CONTAINER -->
<div class="relative w-full max-w-2xl mx-auto my-4 z-30" id="cosmic-search-root">
  
  <!-- Glowing Cosmic Halo & 3D Rotating Orb Icon -->
  <div class="relative group/orb">
    <!-- Shimmering Aurora Border Glow (GPU composited) -->
    <div class="absolute -inset-1 bg-gradient-to-r from-red-600 via-rose-500 to-amber-500 rounded-3xl blur-lg opacity-40 group-hover/orb:opacity-80 group-focus-within/orb:opacity-95 transition-opacity duration-300 animate-pulse transform-gpu"></div>

    <!-- Main Glassmorphic Input Bar -->
    <div 
      id="cosmic-search-bar"
      class="relative flex items-center justify-between bg-[#1a001e]/95 hover:bg-[#2E003E]/95 backdrop-blur-2xl border border-rose-500/50 focus-within:border-red-400 focus-within:ring-2 focus-within:ring-red-400/30 rounded-2xl sm:rounded-3xl p-2 sm:p-2.5 transition-all duration-200 shadow-xl"
    >
      <!-- Left: Interactive 3D Cosmic Orb Globe -->
      <div 
        class="relative flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11 shrink-0 rounded-2xl bg-gradient-to-tr from-rose-950 via-red-900 to-purple-900 border border-rose-400/50 shadow-inner group-hover/orb:rotate-12 transition-transform duration-300 cursor-pointer transform-gpu" 
        id="orb-globe-trigger" 
        title="Cosmic Search Hub (Press '/' to focus)"
      >
        <span class="text-xl sm:text-2xl animate-spin cosmic-orb-icon transform-gpu" style="animation-duration: 16s;">🔮</span>
        <div class="absolute -inset-0.5 rounded-2xl bg-rose-500/20 blur-xs pointer-events-none"></div>
      </div>

      <!-- Center: High-Precision Search Input -->
      <div class="flex-1 mx-3 relative">
        <label for="cosmic-input" class="sr-only">Search Love Calculators</label>
        <input 
          type="search"
          id="cosmic-input"
          autocomplete="off"
          spellcheck="false"
          placeholder="Search by keyword, sign, or name (Press '/' to focus)..."
          class="w-full bg-transparent border-none text-white placeholder:text-rose-200/50 text-xs sm:text-sm font-semibold tracking-wide outline-none pr-8 transition-colors"
        />
        <!-- Live Clear Button -->
        <button 
          type="button" 
          id="cosmic-clear-btn" 
          class="hidden absolute right-1 top-1/2 -translate-y-1/2 text-rose-400 hover:text-white cursor-pointer text-sm p-1 transition-colors"
          aria-label="Clear search"
        >✕</button>
      </div>

      <!-- Right: Voice Search Button & Keyboard Badge -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <!-- Voice Search Button (Web Speech API) -->
        <button 
          type="button" 
          id="cosmic-voice-btn"
          class="relative flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-white/10 hover:bg-rose-500/30 text-rose-300 hover:text-white border border-rose-400/30 transition-all duration-150 active:scale-95 cursor-pointer transform-gpu"
          title="Voice Search (Click and speak)"
        >
          <svg class="w-4 h-4 fill-current pointer-events-none" viewBox="0 0 24 24">
            <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/>
            <path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
          </svg>
          <span id="voice-pulse-ring" class="hidden absolute -inset-1 rounded-xl border border-red-500 animate-ping"></span>
        </button>

        <!-- Keyboard Shortcut Hint -->
        <kbd class="hidden sm:inline-flex items-center px-2 py-1 text-[10px] font-mono font-bold text-rose-300 bg-white/10 rounded-lg border border-white/15 select-none">
          /
        </kbd>
      </div>
    </div>

    <!-- FLOATING LIVE SEARCH DROPDOWN WITH HARDWARE COMPOSITING -->
    <div 
      id="cosmic-dropdown"
      class="fac-cosmic-dropdown absolute top-full left-0 right-0 mt-3 p-3 sm:p-4 rounded-3xl bg-[#1a001e]/95 backdrop-blur-2xl border border-rose-500/40 shadow-2xl space-y-3 z-50 text-left transition-all duration-200 ease-out transform-gpu opacity-0 scale-98 -translate-y-1 pointer-events-none invisible"
    >
      <!-- TRENDING SEARCHES CHIPS -->
      <div id="cosmic-trending-section" class="space-y-2">
        <div class="flex items-center justify-between text-[11px] font-bold text-rose-300 uppercase tracking-wider">
          <span class="flex items-center gap-1">
            <span class="animate-bounce">🔥</span>
            <span>Trending Love Searches</span>
          </span>
          <span class="text-[10px] text-slate-400 font-normal">Updated Live</span>
        </div>
        <div class="flex flex-wrap gap-1.5" id="trending-chips-container">
          <button type="button" class="trending-chip px-2.5 py-1 rounded-lg text-xs bg-rose-500/20 hover:bg-rose-500/40 hover:scale-[1.02] active:scale-95 text-rose-200 border border-rose-400/30 transition-all duration-150 cursor-pointer transform-gpu" data-term="Kundli">
            💍 Kundli (368K)
          </button>
          <button type="button" class="trending-chip px-2.5 py-1 rounded-lg text-xs bg-rose-500/20 hover:bg-rose-500/40 hover:scale-[1.02] active:scale-95 text-rose-200 border border-rose-400/30 transition-all duration-150 cursor-pointer transform-gpu" data-term="FLAMES">
            🕹️ FLAMES (250K)
          </button>
          <button type="button" class="trending-chip px-2.5 py-1 rounded-lg text-xs bg-rose-500/20 hover:bg-rose-500/40 hover:scale-[1.02] active:scale-95 text-rose-200 border border-rose-400/30 transition-all duration-150 cursor-pointer transform-gpu" data-term="Zodiac">
            ✨ Zodiac (300K)
          </button>
          <button type="button" class="trending-chip px-2.5 py-1 rounded-lg text-xs bg-rose-500/20 hover:bg-rose-500/40 hover:scale-[1.02] active:scale-95 text-rose-200 border border-rose-400/30 transition-all duration-150 cursor-pointer transform-gpu" data-term="Crush">
            💘 Crush Test (200K)
          </button>
          <button type="button" class="trending-chip px-2.5 py-1 rounded-lg text-xs bg-rose-500/20 hover:bg-rose-500/40 hover:scale-[1.02] active:scale-95 text-rose-200 border border-rose-400/30 transition-all duration-150 cursor-pointer transform-gpu" data-term="Twin Flame">
            🔥 Twin Flame (110K)
          </button>
        </div>
      </div>

      <!-- RECENT SEARCHES (localStorage) -->
      <div id="cosmic-recents-section" class="hidden space-y-2 border-t border-white/10 pt-2">
        <div class="flex items-center justify-between text-[11px] font-bold text-slate-400 uppercase tracking-wider">
          <span>🕒 Recent Searches</span>
          <button type="button" id="clear-recents-btn" class="text-[10px] text-rose-400 hover:underline cursor-pointer">Clear</button>
        </div>
        <div class="flex flex-wrap gap-1.5" id="recents-chips-container"></div>
      </div>

      <!-- LIVE RESULTS LIST -->
      <div id="cosmic-results-section" class="hidden space-y-2 max-h-80 overflow-y-auto pr-1">
        <div class="text-[11px] font-bold text-rose-300 uppercase tracking-wider pb-1 flex items-center justify-between">
          <span>✨ Matching Love Engines</span>
          <span id="results-count-text" class="text-[10px] font-mono text-slate-400">0 found</span>
        </div>
        <div id="cosmic-results-list" class="space-y-2" role="listbox"></div>
      </div>

      <!-- NO RESULTS (Shake Animation + Suggestions) -->
      <div id="cosmic-no-match" class="hidden py-6 text-center space-y-2 transform-gpu">
        <div class="text-3xl animate-bounce">💔</div>
        <div class="text-xs font-bold text-white">No exact match found for your query</div>
        <div class="text-[11px] text-rose-300/80">Try these popular tests instead:</div>
        <div class="flex justify-center gap-1.5 pt-1">
          <button type="button" class="trending-chip px-2 py-0.5 rounded bg-rose-500/20 hover:bg-rose-500/40 text-rose-200 text-xs border border-rose-400/30 transition-colors cursor-pointer" data-term="Name">🌹 Name Match</button>
          <button type="button" class="trending-chip px-2 py-0.5 rounded bg-rose-500/20 hover:bg-rose-500/40 text-rose-200 text-xs border border-rose-400/30 transition-colors cursor-pointer" data-term="Zodiac">✨ Zodiac</button>
          <button type="button" class="trending-chip px-2 py-0.5 rounded bg-rose-500/20 hover:bg-rose-500/40 text-rose-200 text-xs border border-rose-400/30 transition-colors cursor-pointer" data-term="Tarot">🔮 Tarot</button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- CLIENT COSMIC SEARCH ORB ENGINE -->
<script is:inline define:vars={{ searchableJson }}>
  document.addEventListener('DOMContentLoaded', () => {
    const data = JSON.parse(searchableJson);
    const input = document.getElementById('cosmic-input');
    const dropdown = document.getElementById('cosmic-dropdown');
    const clearBtn = document.getElementById('cosmic-clear-btn');
    const voiceBtn = document.getElementById('cosmic-voice-btn');
    const voicePulse = document.getElementById('voice-pulse-ring');
    const trendingSection = document.getElementById('cosmic-trending-section');
    const recentsSection = document.getElementById('cosmic-recents-section');
    const recentsContainer = document.getElementById('recents-chips-container');
    const resultsSection = document.getElementById('cosmic-results-section');
    const resultsList = document.getElementById('cosmic-results-list');
    const resultsCountText = document.getElementById('results-count-text');
    const noMatch = document.getElementById('cosmic-no-match');
    const clearRecentsBtn = document.getElementById('clear-recents-btn');
    const orbRoot = document.getElementById('cosmic-search-root');

    let activeIndex = -1;
    const STORAGE_KEY = 'fac_love_recent_searches';

    function openDropdown() {
      if (!dropdown) return;
      dropdown.classList.remove('opacity-0', 'scale-98', '-translate-y-1', 'pointer-events-none', 'invisible');
      dropdown.classList.add('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto', 'visible');
    }

    function closeDropdown() {
      if (!dropdown) return;
      dropdown.classList.remove('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto', 'visible');
      dropdown.classList.add('opacity-0', 'scale-98', '-translate-y-1', 'pointer-events-none', 'invisible');
    }

    function getRecents() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
      } catch {
        return [];
      }
    }

    function addRecent(term) {
      if (!term || term.length < 2) return;
      let recents = getRecents().filter(t => t.toLowerCase() !== term.toLowerCase());
      recents.unshift(term);
      if (recents.length > 5) recents.pop();
      localStorage.setItem(STORAGE_KEY, JSON.stringify(recents));
      renderRecents();
    }

    function renderRecents() {
      const recents = getRecents();
      if (!recents.length) {
        recentsSection?.classList.add('hidden');
        return;
      }
      recentsSection?.classList.remove('hidden');
      if (recentsContainer) {
        recentsContainer.innerHTML = recents.map(t => `
          <button type="button" class="recent-chip px-2.5 py-1 rounded-lg text-xs bg-white/10 hover:bg-white/20 active:scale-95 text-slate-200 border border-white/15 transition-all duration-150 cursor-pointer transform-gpu" data-term="${t}">
            ${t}
          </button>
        `).join('');

        recentsContainer.querySelectorAll('.recent-chip').forEach(btn => {
          btn.onclick = () => {
            input.value = btn.getAttribute('data-term');
            handleSearch(input.value);
            input.focus();
          };
        });
      }
    }

    clearRecentsBtn?.addEventListener('click', () => {
      localStorage.removeItem(STORAGE_KEY);
      renderRecents();
    });

    // Highlight text with gradient underline
    function highlightMatch(text, query) {
      if (!query) return text;
      const regex = new RegExp(`(${query.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&')})`, 'gi');
      return text.replace(regex, `<span class="bg-gradient-to-r from-red-400 via-rose-300 to-amber-300 bg-clip-text text-transparent font-bold border-b border-rose-400/80 pb-0.5">$1</span>`);
    }

    function fuzzyScore(query, text) {
      const q = query.toLowerCase();
      const t = text.toLowerCase();
      if (t.startsWith(q)) return 100;
      if (t.includes(q)) return 75;
      
      let score = 0;
      let tIdx = 0;
      for (let i = 0; i < q.length; i++) {
        const char = q[i];
        const matchIdx = t.indexOf(char, tIdx);
        if (matchIdx !== -1) {
          score += 10;
          tIdx = matchIdx + 1;
        }
      }
      return score;
    }

    // High-performance Instant Search Execution (<0.1ms with Zero Stutter)
    function handleSearch(query) {
      activeIndex = -1;
      const q = query.trim().toLowerCase();
      clearBtn?.classList.toggle('hidden', q.length === 0);

      if (q.length === 0) {
        resultsSection?.classList.add('hidden');
        noMatch?.classList.add('hidden');
        trendingSection?.classList.remove('hidden');
        renderRecents();
        return;
      }

      const scored = data.map(item => {
        const s1 = fuzzyScore(q, item.name);
        const s2 = fuzzyScore(q, item.keyword);
        const s3 = fuzzyScore(q, item.shortName);
        const s4 = fuzzyScore(q, item.description);
        const maxScore = Math.max(s1 * 2, s2 * 1.8, s3 * 1.5, s4);
        return { ...item, score: maxScore };
      }).filter(item => item.score > 20)
        .sort((a, b) => b.score - a.score);

      if (scored.length > 0) {
        resultsSection?.classList.remove('hidden');
        noMatch?.classList.add('hidden');
        trendingSection?.classList.add('hidden');
        recentsSection?.classList.add('hidden');

        if (resultsCountText) resultsCountText.textContent = `${scored.length} matching engines`;
        if (resultsList) {
          resultsList.innerHTML = scored.slice(0, 6).map((item, idx) => `
            <a 
              href="${item.href}" 
              class="cosmic-result-row group relative flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-2xl bg-white/5 hover:bg-rose-500/20 border border-white/10 hover:border-red-400/60 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_4px_16px_rgba(244,63,94,0.25)] cursor-pointer select-none transform-gpu"
              data-idx="${idx}"
              data-name="${item.name}"
            >
              <div class="flex items-center gap-3 min-w-0">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gradient-to-tr from-rose-950 to-red-900 text-lg border border-rose-400/30 group-hover:scale-105 transition-transform duration-200 transform-gpu">
                  ${item.icon}
                </span>
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="text-xs sm:text-sm font-bold text-white group-hover:text-rose-300 transition-colors truncate">
                      ${highlightMatch(item.name, q)}
                    </span>
                    <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-rose-400/20 text-rose-300 border border-rose-400/30">
                      ${item.volume}/mo
                    </span>
                  </div>
                  <p class="text-[11px] text-slate-300/80 truncate mt-0.5">
                    ${highlightMatch(item.description, q)}
                  </p>
                </div>
              </div>

              <!-- Hover Quick-Preview Pill -->
              <div class="mt-2 sm:mt-0 flex items-center gap-1.5 shrink-0">
                <span class="text-[10px] font-semibold text-rose-300/90 bg-white/5 px-2 py-1 rounded-lg border border-white/10 group-hover:border-red-400/40">
                  ${item.fields?.p1 || 'Test'} + ${item.fields?.p2 || 'Partner'}
                </span>
                <span class="text-xs text-rose-400 group-hover:translate-x-0.5 transition-transform duration-150">→</span>
              </div>
            </a>
          `).join('');

          resultsList.querySelectorAll('.cosmic-result-row').forEach(row => {
            row.addEventListener('click', () => {
              addRecent(q);
            });
          });
        }
      } else {
        resultsSection?.classList.add('hidden');
        noMatch?.classList.remove('hidden');
        
        // Trigger subtle shake animation
        noMatch.classList.remove('animate-shake');
        void noMatch.offsetWidth;
        noMatch.classList.add('animate-shake');
      }
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== input) {
        e.preventDefault();
        input.focus();
        openDropdown();
        renderRecents();
      }

      if (e.key === 'Escape') {
        closeDropdown();
        input.blur();
      }

      const rows = resultsList?.querySelectorAll('.cosmic-result-row');
      if (!rows || !rows.length) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % rows.length;
        updateActiveRow(rows);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + rows.length) % rows.length;
        updateActiveRow(rows);
      } else if (e.key === 'Enter' && activeIndex >= 0 && rows[activeIndex]) {
        e.preventDefault();
        addRecent(input.value);
        rows[activeIndex].click();
      }
    });

    function updateActiveRow(rows) {
      rows.forEach((r, idx) => {
        if (idx === activeIndex) {
          r.classList.add('bg-rose-500/30', 'border-red-400', '-translate-y-0.5');
          r.scrollIntoView({ block: 'nearest' });
        } else {
          r.classList.remove('bg-rose-500/30', 'border-red-400', '-translate-y-0.5');
        }
      });
    }

    input?.addEventListener('input', (e) => {
      handleSearch(e.target.value);
    });

    input?.addEventListener('focus', () => {
      openDropdown();
      renderRecents();
    });

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      handleSearch('');
      input.focus();
    });

    document.addEventListener('click', (e) => {
      if (!orbRoot?.contains(e.target)) {
        closeDropdown();
      }
    });

    document.querySelectorAll('.trending-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        const term = btn.getAttribute('data-term');
        input.value = term;
        handleSearch(term);
        input.focus();
      });
    });

    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      const recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = false;
      recognition.lang = 'en-US';

      voiceBtn?.addEventListener('click', () => {
        try {
          voicePulse?.classList.remove('hidden');
          input.placeholder = 'Listening... Speak your crush or sign 🎙️';
          recognition.start();
        } catch {
          recognition.stop();
          voicePulse?.classList.add('hidden');
        }
      });

      recognition.onresult = (event) => {
        const transcript = event.results[0][0].transcript;
        input.value = transcript;
        handleSearch(transcript);
        addRecent(transcript);
        voicePulse?.classList.add('hidden');
        input.placeholder = "Search by keyword, sign, or name (Press '/' to focus)...";
      };

      recognition.onerror = () => {
        voicePulse?.classList.add('hidden');
        input.placeholder = "Search by keyword, sign, or name (Press '/' to focus)...";
      };

      recognition.onend = () => {
        voicePulse?.classList.add('hidden');
        input.placeholder = "Search by keyword, sign, or name (Press '/' to focus)...";
      };
    } else {
      voiceBtn?.classList.add('opacity-50', 'cursor-not-allowed');
      voiceBtn?.setAttribute('title', 'Voice search not supported on this browser');
    }
  });
</script>

<style>
  @keyframes shakeAnim {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    75% { transform: translateX(4px); }
  }
  .animate-shake {
    animation: shakeAnim 0.25s ease-in-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .cosmic-orb-icon,
    .animate-spin,
    .animate-bounce,
    .animate-pulse,
    .animate-ping,
    .animate-shake {
      animation: none !important;
    }
    .fac-cosmic-dropdown {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

---
// src/components/TableOfContents.astro
interface HeadingItem {
  id?: string;
  slug?: string;
  text: string;
  level?: number;
  depth?: number;
}

interface Props {
  headings?: HeadingItem[];
}

const { headings = [] } = Astro.props;

// Normalize headings to work with either id/slug and level/depth
const normalizedHeadings = headings
  .map((h) => ({
    id: h.id || h.slug || '',
    text: h.text,
    level: h.level ?? h.depth ?? 2,
  }))
  .filter((h) => (h.level === 2 || h.level === 3) && h.id);
---

<nav class="sticky top-20 bg-white dark:bg-canvas-elevated border border-gray-200 dark:border-hairline rounded-xl p-5 mb-8 shadow-whisper">
  <h3 class="font-bold mb-3 text-xs uppercase tracking-wider text-gray-600 dark:text-mute font-mono">
    Table of Contents
  </h3>
  <ul id="toc-list" class="space-y-2 text-sm">
    {normalizedHeadings.map((heading) => (
      <li style={`padding-left: ${Math.max(0, (heading.level - 2) * 12)}px`}>
        <a
          href={`#${heading.id}`}
          class="text-gray-700 dark:text-body hover:text-cyan-600 dark:hover:text-cyan transition-colors block py-0.5 leading-snug"
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Dynamic client fallback if server props weren't provided
  (function () {
    const list = document.getElementById('toc-list');
    if (list && list.children.length === 0) {
      const prose = document.querySelector('.prose');
      if (prose) {
        const found = prose.querySelectorAll('h2, h3');
        found.forEach((h) => {
          if (!h.id) {
            h.id = (h.textContent || '')
              .toLowerCase()
              .replace(/[^\w\s-]/g, '')
              .replace(/\s+/g, '-');
          }
          const level = h.tagName.toLowerCase() === 'h3' ? 3 : 2;
          const li = document.createElement('li');
          li.style.paddingLeft = `${Math.max(0, (level - 2) * 12)}px`;
          
          const a = document.createElement('a');
          a.href = `#${h.id}`;
          a.textContent = h.textContent;
          a.className = 'text-gray-700 dark:text-body hover:text-cyan-600 dark:hover:text-cyan transition-colors block py-0.5 leading-snug';
          
          li.appendChild(a);
          list.appendChild(li);
        });
      }
    }

    // Smooth scroll for TOC links
    document.querySelectorAll('nav a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', function (e) {
        const href = this.getAttribute('href');
        if (href && href.startsWith('#') && href.length > 1) {
          const target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.pushState(null, '', href);
          }
        }
      });
    });
  })();
</script>

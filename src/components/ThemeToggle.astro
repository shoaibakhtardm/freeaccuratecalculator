---
// src/components/ThemeToggle.astro
export interface Props {
  className?: string;
  id?: string;
}

const { className = '', id = 'theme-toggle' } = Astro.props;
---

<button
  id={id}
  type="button"
  role="button"
  data-theme-toggle
  aria-label="Switch theme mode"
  aria-pressed="false"
  title="Switch theme"
  class={`fac-theme-toggle-btn group relative inline-flex items-center justify-center min-h-[44px] min-w-[44px] sm:min-h-[38px] sm:min-w-[38px] h-11 w-11 sm:h-9 sm:w-9 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white/85 dark:bg-slate-900/85 text-slate-700 dark:text-slate-200 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-50 dark:hover:bg-slate-800/90 hover:border-indigo-500/40 dark:hover:border-indigo-400/40 shadow-xs hover:shadow-md hover:shadow-indigo-500/10 hover:scale-105 active:scale-95 transition-all duration-200 ease-out cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-950 overflow-hidden shrink-0 ${className}`}
>
  <!-- Sun ☀️ Icon (Displayed in Dark Mode to switch to Light) -->
  <svg
    class="theme-toggle-sun absolute h-5 w-5 text-amber-400 pointer-events-none transition-all duration-200 transform"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>

  <!-- Moon 🌙 Icon (Displayed in Light Mode to switch to Dark) -->
  <svg
    class="theme-toggle-moon absolute h-5 w-5 text-indigo-600 dark:text-blue-300 pointer-events-none transition-all duration-200 transform"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>

  <span class="sr-only">Toggle theme</span>
</button>

<style>
  .theme-toggle-sun,
  .theme-toggle-moon {
    transition: opacity 180ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  /* In Light Mode: Moon visible, Sun hidden */
  :global(:not(.dark)) .theme-toggle-sun {
    opacity: 0 !important;
    transform: rotate(-45deg) scale(0.5) !important;
    pointer-events: none;
  }

  :global(:not(.dark)) .theme-toggle-moon {
    opacity: 1 !important;
    transform: rotate(0deg) scale(1) !important;
  }

  /* In Dark Mode: Sun visible, Moon hidden */
  :global(.dark) .theme-toggle-sun {
    opacity: 1 !important;
    transform: rotate(0deg) scale(1) !important;
  }

  :global(.dark) .theme-toggle-moon {
    opacity: 0 !important;
    transform: rotate(45deg) scale(0.5) !important;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle-sun,
    .theme-toggle-moon {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function initGlobalThemeToggle() {
    if (window.__facThemeToggleInitialized) return;
    window.__facThemeToggleInitialized = true;

    function syncAllThemeButtons() {
      const isDark = document.documentElement.classList.contains('dark');
      const targetMode = isDark ? 'light' : 'dark';
      document.querySelectorAll('.fac-theme-toggle-btn, [data-theme-toggle]').forEach((btn) => {
        btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
        btn.setAttribute('aria-label', `Switch to ${targetMode} theme`);
        btn.setAttribute('title', `Switch to ${targetMode} theme`);
      });
    }

    // Toggle function
    window.facToggleTheme = function () {
      const isCurrentlyDark = document.documentElement.classList.contains('dark');
      const nextIsDark = !isCurrentlyDark;

      if (nextIsDark) {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      }

      syncAllThemeButtons();

      window.dispatchEvent(
        new CustomEvent('themechange', {
          detail: { theme: nextIsDark ? 'dark' : 'light' },
        })
      );
    };

    // Event delegation on document to catch all clicks regardless of dynamic DOM updates
    document.addEventListener('click', (e) => {
      const toggleBtn = e.target.closest('.fac-theme-toggle-btn, [data-theme-toggle]');
      if (toggleBtn) {
        e.preventDefault();
        window.facToggleTheme();
      }
    });

    // Initial sync
    syncAllThemeButtons();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncAllThemeButtons);
    }

    // Listen for system theme changes if no manual preference is saved
    const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
    mediaQuery.addEventListener('change', (e) => {
      if (!localStorage.getItem('theme')) {
        if (e.matches) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        syncAllThemeButtons();
      }
    });
  })();
</script>

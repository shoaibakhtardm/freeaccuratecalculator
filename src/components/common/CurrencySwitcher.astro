---
// src/components/common/CurrencySwitcher.astro
import { CURRENCY_LIST } from '../../data/currencies';

interface Props {
  className?: string;
  selectId?: string;
  showFullName?: boolean;
}

const {
  className = '',
  selectId = 'currency-select',
  showFullName = false,
} = Astro.props;
---

<div class={`relative inline-flex items-center ${className}`}>
  <label for={selectId} class="sr-only">Select Currency</label>
  <div class="flex items-center w-full rounded-[6px] border border-hairline bg-canvas-elevated shadow-whisper hover:border-mute focus-within:ring-1 focus-within:ring-link transition-colors">
    <span class="fac-currency-badge pl-2.5 text-xs font-mono font-medium text-mute select-none">$</span>
    <select
      id={selectId}
      aria-label="Currency"
      class="fac-currency-select appearance-none bg-transparent min-h-[44px] sm:min-h-[36px] h-11 sm:h-9 py-1 pl-1.5 pr-6 text-sm sm:text-xs font-medium text-ink cursor-pointer focus:outline-none w-full"
    >
      {CURRENCY_LIST.map((c) => (
        <option
          value={c.code}
          data-symbol={c.symbol}
          data-flag={c.flag}
          class="bg-canvas-elevated text-ink"
        >
          {c.flag} {c.code} ({c.symbol}) {showFullName ? `— ${c.name}` : ''}
        </option>
      ))}
    </select>
    <svg
      class="pointer-events-none absolute right-2 h-3.5 w-3.5 text-mute"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
        clip-rule="evenodd"
      />
    </svg>
  </div>
</div>

<script is:inline>
  (function () {
    const selects = document.querySelectorAll('.fac-currency-select');
    const badges = document.querySelectorAll('.fac-currency-badge');
    if (!selects || selects.length === 0) return;

    function syncState() {
      const active = (typeof window.facGetActiveCurrency === 'function'
        ? window.facGetActiveCurrency()
        : localStorage.getItem('fac_currency') || 'USD'
      ).toUpperCase();

      const info = typeof window.facGetCurrencyInfo === 'function'
        ? window.facGetCurrencyInfo(active)
        : { symbol: '$' };

      selects.forEach((sel) => {
        if (sel.value !== active) sel.value = active;
      });
      badges.forEach((badge) => {
        badge.textContent = info.symbol || '$';
      });
    }

    // Initialize to current active currency
    syncState();

    // Listen for currency changes
    window.addEventListener('currencychange', (e) => {
      const code = e.detail.currency;
      const symbol = e.detail.symbol;
      selects.forEach((sel) => {
        if (sel.value !== code) sel.value = code;
      });
      badges.forEach((badge) => {
        badge.textContent = symbol;
      });
    });

    // Handle user manual interaction
    selects.forEach((sel) => {
      sel.addEventListener('change', (e) => {
        const newCode = e.target.value;
        if (typeof window.facSetActiveCurrency === 'function') {
          window.facSetActiveCurrency(newCode);
        } else {
          localStorage.setItem('fac_currency', newCode);
          window.dispatchEvent(
            new CustomEvent('currencychange', {
              detail: { currency: newCode, symbol: '$', isIndian: newCode === 'INR' },
            })
          );
        }
      });
    });
  })();
</script>

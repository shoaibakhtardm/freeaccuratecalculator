---
// src/components/common/Toast.astro
// Lightweight, framework-agnostic accessible toast notification system
---

<div
  id="fac-toast-container"
  class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none max-w-sm w-full px-4 sm:px-0"
  aria-live="polite"
  aria-atomic="true"
  role="status"
></div>

<script is:inline>
  (function () {
    const container = document.getElementById('fac-toast-container');
    if (!container) return;

    window.facShowToast = function (message, type = 'info', duration = 3000) {
      const toast = document.createElement('div');
      toast.className =
        'pointer-events-auto flex items-center gap-2.5 rounded-[8px] border bg-canvas-elevated px-4 py-3 text-xs font-medium shadow-whisper transition-all duration-300 transform translate-y-2 opacity-0';

      let borderColor = 'border-hairline';
      let iconSvg = '';

      if (type === 'success') {
        borderColor = 'border-cyan/40 text-ink';
        iconSvg = `<svg class="h-4 w-4 text-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>`;
      } else if (type === 'error') {
        borderColor = 'border-error/40 text-ink';
        iconSvg = `<svg class="h-4 w-4 text-error shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>`;
      } else if (type === 'warning') {
        borderColor = 'border-warning/40 text-ink';
        iconSvg = `<svg class="h-4 w-4 text-warning shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>`;
      } else {
        borderColor = 'border-link/40 text-ink';
        iconSvg = `<svg class="h-4 w-4 text-link shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>`;
      }

      toast.className += ` ${borderColor}`;
      toast.innerHTML = `
        ${iconSvg}
        <span class="flex-1">${message}</span>
      `;

      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
      });

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-2', 'opacity-0');
        setTimeout(() => {
          if (toast.parentNode) {
            toast.parentNode.removeChild(toast);
          }
        }, 300);
      }, duration);
    };

    window.showToast = window.facShowToast;

    window.addEventListener('show-toast', (e) => {
      if (e.detail && e.detail.message) {
        window.facShowToast(e.detail.message, e.detail.type || 'info', e.detail.duration || 3000);
      }
    });
  })();
</script>

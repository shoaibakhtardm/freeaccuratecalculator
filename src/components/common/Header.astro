---
// src/components/common/Header.astro
import ThemeToggle from './ThemeToggle.astro';
import CurrencySwitcher from './CurrencySwitcher.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, type SupportedLanguage } from '../../i18n/ui';

const currentLocale = (Astro.currentLocale || 'en') as SupportedLanguage;
const t = useTranslations(currentLocale);
const localePrefix = currentLocale === 'en' ? '' : `/${currentLocale}`;

const navItems = [
  { label: t('nav.finance'), href: `${localePrefix}/finance/` },
  { label: t('nav.health'), href: `${localePrefix}/health/` },
  { label: t('nav.math'), href: `${localePrefix}/math/` },
  { label: t('nav.everyday'), href: `${localePrefix}/everyday/` },
  { label: 'Guides', href: '/blog/' },
  { label: 'Countries', href: '/countries/' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md transition-colors">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-3 sm:px-6 lg:px-8">
    <!-- Brand Wordmark -->
    <div class="flex items-center gap-2 sm:gap-6 min-w-0">
      <a href={localePrefix ? `${localePrefix}/` : '/'} class="group flex items-center gap-2 transition-opacity hover:opacity-90 shrink-0">
        <!-- Logo SVG -->
        <div class="flex h-7 w-7 items-center justify-center rounded-[6px] bg-ink text-canvas transition-transform group-hover:scale-105 shrink-0">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="2" width="16" height="20" rx="3"></rect>
            <line x1="8" y1="6" x2="16" y2="6"></line>
            <line x1="16" y1="14" x2="16" y2="18"></line>
            <path d="M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M8 18h.01M12 18h.01"></path>
          </svg>
        </div>
        <span class="text-xs sm:text-sm font-semibold tracking-tight text-ink whitespace-nowrap">
          Free <span class="bg-gradient-to-r from-link to-cyan bg-clip-text text-transparent">Accurate</span><span class="hidden sm:inline"> Calculator</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1 pl-4 border-l border-hairline" aria-label="Main Navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="rounded-full px-3 py-1.5 text-xs font-medium text-body hover:text-ink hover:bg-hairline-soft transition-colors"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Right Controls: Language Selector -> Currency Selector -> Theme Toggle -> Mobile Menu -->
    <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
      <LanguageSwitcher className="hidden sm:inline-flex" />
      <CurrencySwitcher className="hidden sm:inline-flex" />
      <ThemeToggle />

      <!-- Mobile Hamburger Button (44px Touch Target) -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="inline-flex md:hidden items-center justify-center min-h-[44px] min-w-[44px] sm:min-h-[36px] sm:min-w-[36px] h-11 w-11 sm:h-9 sm:w-9 rounded-[6px] border border-hairline bg-canvas-elevated text-ink hover:bg-hairline-soft cursor-pointer transition-colors shadow-whisper"
      >
        <svg id="hamburger-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-hairline bg-canvas-elevated px-4 py-4 space-y-4 shadow-card transition-all">
    <div>
      <div class="text-[11px] font-mono uppercase text-mute tracking-wider mb-2">Navigation Categories</div>
      <div class="grid grid-cols-2 gap-2">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="flex items-center min-h-[44px] rounded-[8px] border border-hairline bg-canvas px-3 py-2 text-sm font-medium text-ink hover:border-mute hover:bg-hairline-soft transition-colors"
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile Regional Preferences (Visible on narrow screens where header icons collapse) -->
    <div class="pt-3 border-t border-hairline sm:hidden">
      <div class="text-[11px] font-mono uppercase text-mute tracking-wider mb-2">Regional Preferences</div>
      <div class="grid grid-cols-2 gap-2">
        <LanguageSwitcher selectId="mobile-language-select" className="w-full" />
        <CurrencySwitcher selectId="mobile-currency-select" className="w-full" />
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const newExpanded = !isExpanded;
      btn.setAttribute('aria-expanded', String(newExpanded));
      menu.classList.toggle('hidden');
      if (hamburgerIcon && closeIcon) {
        if (newExpanded) {
          hamburgerIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
        } else {
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        }
      }
    });
  }
</script>

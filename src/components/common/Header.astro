---
// src/components/common/Header.astro
import Logo from '../Logo.astro';
import ThemeToggle from '../ThemeToggle.astro';
import LanguageSelector from '../LanguageSelector.astro';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const pathname = Astro.url.pathname;
const isFranceRoute = pathname.includes('/countries/france');
const isFranceEnglish = isFranceRoute && pathname.includes('/countries/france/en/');
---

<header
  id="main-header"
  class={`sticky top-0 left-0 right-0 z-50 w-full bg-white/90 dark:bg-gray-950/90 backdrop-blur-xl border-b border-slate-200/80 dark:border-slate-800/80 transition-all duration-300 ${className}`}
>
  <!-- Royal Jewel Ribbon at Top -->
  <div
    class="h-[2.5px] w-full bg-gradient-to-r from-blue-600 via-indigo-600 via-purple-600 to-pink-500 shadow-[0_1px_6px_rgba(99,102,241,0.4)]"
    aria-hidden="true"
  ></div>

  <div
    class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 flex items-center justify-between h-[66px] sm:h-20 gap-2 sm:gap-4"
  >
    <!-- [LEFT SECTION]: Logo + France Badge -->
    <div class="flex items-center gap-2.5 shrink-0">
      <Logo />
      {isFranceRoute && (
        <a
          href={isFranceEnglish ? "/countries/france/en/" : "/countries/france/fr/"}
          class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg border border-slate-200/90 dark:border-slate-800/90 bg-slate-50 dark:bg-slate-900/80 text-[11px] sm:text-xs font-bold text-slate-800 dark:text-slate-200 shadow-2xs select-none hover:border-indigo-500/40 transition-colors"
          title={isFranceEnglish ? "France Hub" : "Portail France"}
        >
          <span>🇫🇷</span>
          <span>France</span>
        </a>
      )}
    </div>

    <!-- [RIGHT SECTION]: Language Selector / France Toggle + Sun/Moon Button -->
    <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
      {isFranceRoute ? (
        <button
          type="button"
          id="fac-france-lang-toggle"
          class="group relative flex items-center justify-between gap-1.5 sm:gap-2 px-2.5 sm:px-3 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white/90 dark:bg-slate-900/90 hover:bg-slate-50 dark:hover:bg-slate-800/90 hover:border-indigo-500/40 dark:hover:border-indigo-400/40 shadow-xs hover:shadow-md hover:shadow-indigo-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-950 min-h-[44px] sm:min-h-[38px] h-11 sm:h-9 cursor-pointer transition-all duration-300 select-none text-xs font-semibold"
          aria-label={isFranceEnglish ? "Switch to French (Passer en Français)" : "Switch to English (Passer en Anglais)"}
          data-current-lang={isFranceEnglish ? "en" : "fr"}
        >
          <span
            id="header-lang-fr"
            aria-current={!isFranceEnglish ? "true" : undefined}
            class={!isFranceEnglish
              ? "inline-flex items-center gap-1 font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/60 px-1.5 py-0.5 rounded-md transition-colors"
              : "inline-flex items-center gap-1 font-medium text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-colors"}
          >
            <span class="text-sm">🇫🇷</span>
            <span>FR</span>
          </span>
          <span class="text-slate-300 dark:text-slate-600 select-none">|</span>
          <span
            id="header-lang-en"
            aria-current={isFranceEnglish ? "true" : undefined}
            class={isFranceEnglish
              ? "inline-flex items-center gap-1 font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/60 px-1.5 py-0.5 rounded-md transition-colors"
              : "inline-flex items-center gap-1 font-medium text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-colors"}
          >
            <span class="text-sm">🇬🇧</span>
            <span>EN</span>
          </span>
        </button>
      ) : (
        <LanguageSelector
          selectId="language-select"
          className="inline-flex"
        />
      )}

      <!-- Theme Toggle: Sun ☀️ / Moon 🌙 button -->
      <ThemeToggle id="theme-toggle" />
    </div>
  </div>
</header>

<!-- Scroll & URL-Level Language Toggle Script -->
<script is:inline>
  (function () {
    const header = document.getElementById('main-header');
    const toggleBtn = document.getElementById('fac-france-lang-toggle');

    if (toggleBtn) {
      toggleBtn.addEventListener('click', function () {
        const path = window.location.pathname;
        const currentLang = toggleBtn.getAttribute('data-current-lang') || (path.includes('/countries/france/en/') ? 'en' : 'fr');
        const targetLang = currentLang === 'en' ? 'fr' : 'en';

        // 1. Check if page has explicit reciprocal hreflang alternate tag
        const alternateTag = document.querySelector(`link[rel="alternate"][hreflang="${targetLang}"]`);
        if (alternateTag && alternateTag.href) {
          try {
            const parsed = new URL(alternateTag.href);
            window.location.href = parsed.pathname + window.location.search + window.location.hash;
            return;
          } catch (_) {}
        }

        // 2. Deterministic URL mapping
        let target = `/countries/france/${targetLang}/`;
        if (path.includes('/countries/france/fr/')) {
          target = path.replace('/countries/france/fr/', '/countries/france/en/');
        } else if (path.includes('/countries/france/en/')) {
          target = path.replace('/countries/france/en/', '/countries/france/fr/');
        } else if (path === '/countries/france' || path === '/countries/france/') {
          target = `/countries/france/${targetLang}/`;
        } else if (path.startsWith('/countries/france/')) {
          // French specialized tool or Notaire page without direct English equivalent
          target = '/countries/france/en/';
        }

        window.location.href = target + window.location.search + window.location.hash;
      });
    }

    // Subtle shadow on scroll
    function onScroll() {
      if (!header) return;
      if (window.scrollY > 8) {
        header.classList.add('shadow-md', 'dark:shadow-gray-950/60');
      } else {
        header.classList.remove('shadow-md', 'dark:shadow-gray-950/60');
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

---
// src/components/common/LanguageSwitcher.astro
import { languages } from '../../i18n/ui';

interface Props {
  className?: string;
  selectId?: string;
}

const { className = '', selectId = 'language-select' } = Astro.props;

// Determine current locale from Astro.currentLocale or URL
const currentLocale = Astro.currentLocale || 'en';
---

<div class={`relative inline-flex items-center ${className}`}>
  <label for={selectId} class="sr-only">Select Language</label>
  <div class="flex items-center w-full rounded-[6px] border border-hairline bg-canvas-elevated shadow-whisper hover:border-mute focus-within:ring-1 focus-within:ring-link transition-colors">
    <!-- Globe Icon -->
    <span class="pl-2.5 text-mute select-none flex items-center">
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
    </span>

    <select
      id={selectId}
      aria-label="Language"
      class="fac-language-select notranslate appearance-none bg-transparent min-h-[44px] sm:min-h-[36px] h-11 sm:h-9 py-1 pl-1.5 pr-6 text-sm sm:text-xs font-medium text-ink cursor-pointer focus:outline-none w-full"
    >
      {Object.entries(languages).map(([code, lang]) => (
        <option
          value={code}
          selected={code === currentLocale}
          class="bg-canvas-elevated text-ink"
          title={lang.label}
        >
          {lang.short} — {lang.label}
        </option>
      ))}
    </select>

    <!-- Down chevron -->
    <svg
      class="pointer-events-none absolute right-2 h-3.5 w-3.5 text-mute"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
        clip-rule="evenodd"
      />
    </svg>
  </div>
</div>

<script is:inline>
  (function () {
    const selects = document.querySelectorAll('.fac-language-select');
    if (!selects || selects.length === 0) return;

    function syncLanguageUI() {
      const active = (typeof window.facGetActiveLanguage === 'function'
        ? window.facGetActiveLanguage()
        : localStorage.getItem('fac_locale') || 'en'
      ).toLowerCase();

      selects.forEach((sel) => {
        if (sel.value !== active) sel.value = active;
      });
    }

    // Sync initial state
    syncLanguageUI();

    selects.forEach((select) => {
      select.addEventListener('change', (e) => {
        const targetLang = e.target.value;
        if (typeof window.facSetActiveLanguage === 'function') {
          window.facSetActiveLanguage(targetLang);
        } else {
          localStorage.setItem('fac_locale', targetLang);
          window.location.reload();
        }
      });
    });
  })();
</script>

---
// src/components/common/AutocompleteSearch.astro
import { SEARCHABLE_CALCULATORS } from '../../data/searchDatabase';

interface Props {
  id?: string;
  placeholder?: string;
  categoryFilter?: string;
  className?: string;
}

const {
  id = 'autocomplete-search',
  placeholder = "Search 📈 SIP Calculator...",
  categoryFilter,
  className = '',
} = Astro.props;

const searchDataJson = JSON.stringify(SEARCHABLE_CALCULATORS);
---

<div
  class={`fac-autocomplete-container relative max-w-xl mx-auto w-full ${className}`}
  data-filter={categoryFilter || ''}
  data-search-id={id}
>
  <div class="fac-search-wrapper relative flex items-center group rounded-2xl sm:rounded-full transition-shadow duration-300">
    <!-- Authentic Corner-Revolving Neon Border Beam ("corner pe ghumna") -->
    <div class="fac-neon-orbit-wrapper absolute -inset-[2px] rounded-2xl sm:rounded-full overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="fac-neon-orbit-beam"></div>
    </div>

    <!-- Base Structural Border Track -->
    <div
      class="fac-search-track absolute inset-0 rounded-2xl sm:rounded-full border border-slate-200/90 dark:border-slate-800/90 bg-white/95 dark:bg-slate-900/95 pointer-events-none transition-colors duration-300 group-hover:border-slate-300 dark:group-hover:border-slate-700 z-10"
      aria-hidden="true"
    ></div>

    <!-- Search Glass Icon (Clean, modern slate/indigo) -->
    <svg
      class="absolute left-4 sm:left-4.5 h-4.5 w-4.5 sm:h-5 sm:w-5 text-slate-400 dark:text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-300 group-focus-within:text-blue-600 dark:group-focus-within:text-sky-400 transition-colors duration-200 pointer-events-none z-30"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>

    <!-- Beautifully Optimized Typewriter Suggestion Overlay -->
    <div
      class="fac-typewriter-container absolute left-11 sm:left-12 right-24 pointer-events-none overflow-hidden flex items-center h-full z-20 select-none transition-opacity duration-200"
      aria-hidden="true"
    >
      <div class="flex items-center whitespace-nowrap overflow-hidden">
        <span class="fac-typewriter-text font-semibold text-slate-700 dark:text-slate-200 text-xs sm:text-sm md:text-base tracking-tight sm:tracking-normal"></span>
        <span class="fac-typewriter-cursor inline-block w-[2px] h-3.5 sm:h-4.5 bg-cyan-500 dark:bg-cyan-400 ml-0.5 rounded-full"></span>
      </div>
    </div>

    <!-- Search Input (Bold & High-Contrast) -->
    <input
      id={id}
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder=""
      class="fac-search-input relative z-20 w-full rounded-2xl sm:rounded-full bg-transparent py-3 sm:py-3.5 pl-11 sm:pl-12 pr-24 text-xs sm:text-sm md:text-base font-bold text-slate-900 dark:text-white placeholder:font-medium placeholder-slate-400 dark:placeholder-slate-400 shadow-sm outline-none border-none ring-0 transition-all tracking-tight sm:tracking-normal"
      aria-label="Search all calculators"
      aria-autocomplete="list"
      aria-controls={`${id}-dropdown`}
      aria-expanded="false"
    />

    <!-- Shortcut Chip (Desktop) & Clear Button -->
    <div class="absolute right-3.5 top-1/2 -translate-y-1/2 z-20 flex items-center gap-1.5">
      <button
        type="button"
        class="fac-clear-btn hidden p-1.5 rounded-full text-slate-400 hover:text-cyan-500 dark:hover:text-cyan-400 hover:bg-cyan-500/10 dark:hover:bg-cyan-500/20 transition-all cursor-pointer focus:outline-none"
        aria-label="Clear search"
        title="Clear search"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      <kbd class="fac-kbd-shortcut hidden sm:inline-flex items-center px-2 py-0.5 text-[10px] font-mono font-semibold text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 rounded-md shadow-2xs pointer-events-none transition-opacity">
        Ctrl K
      </kbd>
    </div>
  </div>

  <!-- FLOATING SUGGESTIONS POPUP PANEL -->
  <div
    id={`${id}-dropdown`}
    class="fac-suggestions-panel absolute left-0 right-0 top-full mt-2.5 z-50 rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-2xl shadow-2xl shadow-slate-900/15 dark:shadow-black/50 overflow-hidden text-left transition-all duration-200 origin-top opacity-0 scale-95 pointer-events-none invisible"
    role="listbox"
  >
    <!-- Dynamic Results Header -->
    <div class="fac-results-header px-4 py-2.5 border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
      <span class="fac-results-count">Suggested Calculators</span>
      <span class="text-[10px] lowercase font-normal hidden sm:inline">press enter ↵ to open</span>
    </div>

    <!-- Scrollable Results Container -->
    <div class="fac-results-list max-h-[300px] sm:max-h-[360px] overflow-y-auto p-1.5 space-y-1">
      <!-- Injected dynamically by client JS -->
    </div>

    <!-- Empty State -->
    <div class="fac-no-results hidden p-6 text-center space-y-1.5">
      <div class="text-2xl">🔍</div>
      <p class="text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-200">
        No calculators found
      </p>
      <p class="text-[11px] text-slate-400 dark:text-slate-500">
        Try searching for "sip", "emi", "tax", "percentage", or "mortgage"
      </p>
    </div>

    <!-- Footer Quick Help -->
    <div class="px-4 py-2 border-t border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/50 flex items-center justify-between text-[10px] text-slate-400 dark:text-slate-500">
      <span class="flex items-center gap-1">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Verified Calculator Links
      </span>
      <div class="flex items-center gap-2">
        <span class="hidden sm:inline"><kbd class="px-1 py-0.5 rounded bg-slate-200/80 dark:bg-slate-800">↑</kbd> <kbd class="px-1 py-0.5 rounded bg-slate-200/80 dark:bg-slate-800">↓</kbd> navigate</span>
        <span><kbd class="px-1 py-0.5 rounded bg-slate-200/80 dark:bg-slate-800">esc</kbd> close</span>
      </div>
    </div>
  </div>

  <!-- Inlined JSON Data Store -->
  <script type="application/json" class="fac-search-data" set:html={searchDataJson}></script>
</div>

<!-- Autocomplete Client-side Engine -->
<script is:inline>
  (function () {
    function initAutocomplete(container) {
      if (!container || container.dataset.initialized === 'true') return;
      container.dataset.initialized = 'true';

      const input = container.querySelector('.fac-search-input');
      const panel = container.querySelector('.fac-suggestions-panel');
      const resultsList = container.querySelector('.fac-results-list');
      const resultsCount = container.querySelector('.fac-results-count');
      const noResults = container.querySelector('.fac-no-results');
      const clearBtn = container.querySelector('.fac-clear-btn');
      const kbdShortcut = container.querySelector('.fac-kbd-shortcut');
      const dataEl = container.querySelector('.fac-search-data');
      const categoryScope = (container.dataset.filter || '').toLowerCase();

      if (!input || !panel || !resultsList || !dataEl) return;

      let dataset = [];
      try {
        dataset = JSON.parse(dataEl.textContent || '[]');
      } catch (_) {
        dataset = [];
      }

      let activeIndex = -1;
      let currentMatches = [];

      function escapeHtml(str) {
        return (str || '').replace(/[&<>"']/g, (m) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        }[m]));
      }

      function highlightMatch(text, query) {
        if (!query) return escapeHtml(text);
        const idx = text.toLowerCase().indexOf(query.toLowerCase());
        if (idx === -1) return escapeHtml(text);
        const before = escapeHtml(text.slice(0, idx));
        const matched = escapeHtml(text.slice(idx, idx + query.length));
        const after = escapeHtml(text.slice(idx + query.length));
        return `${before}<span class="font-black text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/80 rounded px-0.5">${matched}</span>${after}`;
      }

      function openPanel() {
        panel.classList.remove('opacity-0', 'scale-95', 'pointer-events-none', 'invisible');
        panel.classList.add('opacity-100', 'scale-100', 'pointer-events-auto', 'visible');
        input.setAttribute('aria-expanded', 'true');
      }

      function closePanel() {
        panel.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto', 'visible');
        panel.classList.add('opacity-0', 'scale-95', 'pointer-events-none', 'invisible');
        input.setAttribute('aria-expanded', 'false');
        activeIndex = -1;
      }

      function updateActiveItem() {
        const items = resultsList.querySelectorAll('.fac-suggestion-link');
        items.forEach((item, idx) => {
          if (idx === activeIndex) {
            item.classList.add('bg-indigo-50', 'dark:bg-indigo-950/70', 'ring-1', 'ring-indigo-500/30');
            item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          } else {
            item.classList.remove('bg-indigo-50', 'dark:bg-indigo-950/70', 'ring-1', 'ring-indigo-500/30');
          }
        });
      }

      function renderSuggestions(query) {
        const q = (query || '').toLowerCase().trim();

        if (!q) {
          closePanel();
          if (clearBtn) clearBtn.classList.add('hidden');
          if (kbdShortcut) kbdShortcut.classList.remove('hidden');
          return;
        }

        if (clearBtn) clearBtn.classList.remove('hidden');
        if (kbdShortcut) kbdShortcut.classList.add('hidden');

        // Score & rank matches
        const scored = [];
        for (const item of dataset) {
          const nameLower = item.name.toLowerCase();
          const catLower = (item.categoryName || item.category).toLowerCase();
          const keywords = item.keywords || [];

          let score = 0;

          if (nameLower === q) {
            score += 100;
          } else if (nameLower.startsWith(q)) {
            score += 80;
          } else if (nameLower.includes(` ${q}`)) {
            score += 60;
          } else if (nameLower.includes(q)) {
            score += 40;
          } else if (keywords.some((k) => k.toLowerCase().includes(q))) {
            score += 35;
          } else if (catLower.includes(q)) {
            score += 20;
          }

          // Apply category bonus ONLY if the tool actually matched the query
          if (score > 0) {
            if (categoryScope && item.category.toLowerCase() === categoryScope) {
              score += 15;
            }
            scored.push({ item, score });
          }
        }

        scored.sort((a, b) => b.score - a.score);
        currentMatches = scored.slice(0, 8).map((s) => s.item);
        activeIndex = -1;

        if (currentMatches.length === 0) {
          resultsList.innerHTML = '';
          if (resultsCount) resultsCount.textContent = 'No suggestions';
          if (noResults) noResults.classList.remove('hidden');
          openPanel();
          return;
        }

        if (noResults) noResults.classList.add('hidden');
        if (resultsCount) {
          resultsCount.textContent = 'Suggested Calculators';
        }

        // Render HTML for suggestions
        let html = '';
        currentMatches.forEach((calc, idx) => {
          const highlightedName = highlightMatch(calc.name, q);
          html += `
            <a
              href="${escapeHtml(calc.href)}"
              class="fac-suggestion-link group flex items-center justify-between w-full p-2.5 sm:p-3 rounded-xl hover:bg-indigo-50/80 dark:hover:bg-indigo-950/50 border border-transparent hover:border-indigo-500/20 transition-all text-left cursor-pointer"
              data-index="${idx}"
              role="option"
              title="Open ${escapeHtml(calc.name)}"
            >
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <span class="flex h-7 w-7 sm:h-8 sm:w-8 shrink-0 items-center justify-center rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 text-sm shadow-2xs group-hover:scale-110 transition-transform">
                  ${calc.icon || '🧮'}
                </span>
                <div class="min-w-0">
                  <div class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">
                    ${highlightedName}
                  </div>
                  <div class="text-[10px] sm:text-[11px] text-slate-400 dark:text-slate-500 font-medium">
                    ${escapeHtml(calc.categoryName || calc.category)}
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-1 shrink-0 ml-2">
                <span class="hidden sm:inline-flex text-[10.5px] font-semibold text-indigo-600 dark:text-indigo-400 group-hover:translate-x-0.5 transition-transform">
                  Open →
                </span>
                <svg class="h-3.5 w-3.5 text-slate-400 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 sm:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          `;
        });

        resultsList.innerHTML = html;
        openPanel();
      }

      // Input event
      input.addEventListener('input', (e) => {
        renderSuggestions(e.target.value);
      });

      // Focus event (show recent or query matches)
      input.addEventListener('focus', () => {
        if (input.value.trim()) {
          renderSuggestions(input.value);
        }
      });

      // Keyboard navigation
      input.addEventListener('keydown', (e) => {
        if (!panel.classList.contains('visible')) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (currentMatches.length > 0) {
            activeIndex = (activeIndex + 1) % currentMatches.length;
            updateActiveItem();
          }
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (currentMatches.length > 0) {
            activeIndex = activeIndex <= 0 ? currentMatches.length - 1 : activeIndex - 1;
            updateActiveItem();
          }
        } else if (e.key === 'Enter') {
          if (currentMatches.length > 0) {
            e.preventDefault();
            const targetIdx = activeIndex >= 0 ? activeIndex : 0;
            const target = currentMatches[targetIdx];
            if (target && target.href) {
              window.location.href = target.href;
            }
          }
        } else if (e.key === 'Escape') {
          e.preventDefault();
          closePanel();
        }
      });

      // Clear button
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          input.value = '';
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.focus();
          closePanel();
          clearBtn.classList.add('hidden');
          if (kbdShortcut) kbdShortcut.classList.remove('hidden');
        });
      }

      // Masterpiece Typewriter Animation Engine (Always Random & Natural Cadence)
      const DIVERSE_PROMPTS = [
        'Search 📈 SIP Calculator...',
        'Search 🎂 Age Calculator...',
        'Search 🏦 EMI Calculator...',
        'Search 🩺 BMI Calculator...',
        'Search 🏠 Mortgage Calculator...',
        'Search 📑 Income Tax Calculator...',
        'Search 🍎 Calorie & TDEE...',
        'Search 📐 Percentage Calculator...',
        'Search 🔬 Scientific Calculator...',
        'Search 🚗 Auto Loan Calculator...',
        'Search 💰 Lumpsum Calculator...',
        'Search ⏱️ Time Calculator...',
        'Search 📊 Compound Interest...',
        'Search 🏢 Rental Yield...',
        'Search 🔄 Unit Converter...',
        'Search 🛡️ Term Life Insurance...',
        'Search ⚖️ Child Support...',
        'Search 💼 Break-Even Analysis...',
        'Search 🎓 GPA Calculator...',
        'Search 📅 Date Difference...',
        'Search 🪙 PPF & EPF...',
        'Search 🚀 Step-Up SIP...',
        'Search 🏗️ Square Footage...',
        'Search 🍕 Recipe Scaler...',
        'Search 🏃 Heart Rate Zone...',
        'Search 🌍 Carbon Footprint...',
        'Search 🧪 Dilution & pH...',
        'Search 🤖 AI Token Cost...'
      ];

      // Always pick a random calculator to start with!
      let promptIndex = Math.floor(Math.random() * DIVERSE_PROMPTS.length);
      let charIndex = 0;
      let isDeleting = false;
      let typewriterTimer = null;

      const typeContainer = container.querySelector('.fac-typewriter-container');
      const typeText = container.querySelector('.fac-typewriter-text');

      function getNextRandomIndex(prev) {
        let next = prev;
        while (next === prev) {
          next = Math.floor(Math.random() * DIVERSE_PROMPTS.length);
        }
        return next;
      }

      function stepTypewriter() {
        if (document.activeElement === input || (input.value && input.value.trim().length > 0)) {
          if (typeContainer) typeContainer.classList.add('opacity-0');
          return;
        }

        if (typeContainer) typeContainer.classList.remove('opacity-0');

        const phrase = DIVERSE_PROMPTS[promptIndex];
        const chars = Array.from(phrase);

        let delay = 60;

        if (isDeleting) {
          charIndex--;
          delay = 24; // Fast, satisfying backspace
        } else {
          charIndex++;
          // Slight realistic human typing cadence variation
          delay = charIndex % 3 === 0 ? 80 : 55;
        }

        if (typeText) {
          typeText.textContent = chars.slice(0, charIndex).join('');
        }

        if (!isDeleting && charIndex === chars.length) {
          // Pause when completely typed so user can easily read
          delay = 2100;
          isDeleting = true;
        } else if (isDeleting && charIndex === 0) {
          // Finished deleting, pick NEXT completely random calculator!
          isDeleting = false;
          promptIndex = getNextRandomIndex(promptIndex);
          delay = 280;
        }

        typewriterTimer = setTimeout(stepTypewriter, delay);
      }

      // Start typewriter immediately
      typewriterTimer = setTimeout(stepTypewriter, 300);

      input.addEventListener('focus', () => {
        if (typewriterTimer) clearTimeout(typewriterTimer);
        if (typeContainer) typeContainer.classList.add('opacity-0');
        if (!input.value.trim()) {
          input.placeholder = 'Search any calculator (e.g. sip, emi, age)...';
        }
      });

      input.addEventListener('blur', () => {
        if (!input.value.trim()) {
          input.placeholder = '';
          if (typeContainer) typeContainer.classList.remove('opacity-0');
          charIndex = 0;
          isDeleting = false;
          if (typewriterTimer) clearTimeout(typewriterTimer);
          typewriterTimer = setTimeout(stepTypewriter, 200);
        }
      });

      input.addEventListener('input', () => {
        if (input.value.trim().length > 0) {
          if (typeContainer) typeContainer.classList.add('opacity-0');
        } else if (document.activeElement !== input) {
          if (typeContainer) typeContainer.classList.remove('opacity-0');
        }
      });

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (!container.contains(e.target)) {
          closePanel();
        }
      });

      // Global shortcut Ctrl+K / Cmd+K
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          input.focus();
          input.select();
        }
      });
    }

    // Initialize all autocomplete containers on page
    document.querySelectorAll('.fac-autocomplete-container').forEach(initAutocomplete);
  })();
</script>

<style>
  /* Remove duplicate browser native search cancel/clear button */
  .fac-search-input::-webkit-search-cancel-button,
  .fac-search-input::-webkit-search-decoration,
  .fac-search-input::-webkit-search-results-button,
  .fac-search-input::-webkit-search-results-decoration {
    -webkit-appearance: none !important;
    appearance: none !important;
    display: none !important;
  }

  .fac-search-input::-ms-clear,
  .fac-search-input::-ms-reveal {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }

  /* Bold Typography for Dynamic Typewriter & User Input */
  .fac-search-input {
    font-weight: 600 !important;
  }
  .fac-search-input::placeholder {
    font-weight: 500 !important;
    opacity: 0.92;
  }

  /* ==========================================================================
     UI/UX Elite Standard: Overhead Neon Light + Left-to-Right Hairline Beam
     - Overhead Neon Runner: Glides left-to-right across the top layout
     - Hairline Beam: 1.25px delicate stream travelling Left to Right in slow-mo
     - Top Crown Accent: Refined luminous neon reflection on the card roof
     ========================================================================== */

  /* ==========================================================================
     UI/UX Elite Standard: 360° Neon Corner Orbit + Continuous Left-to-Right Text
     ========================================================================== */

  .fac-search-wrapper {
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
  }

  /* ==========================================================================
     Neon Color Revolving Round and Round the Corners ("corner pe ghumna")
     ========================================================================== */
  .fac-neon-orbit-wrapper {
    position: absolute;
    inset: -2.5px;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .fac-neon-orbit-beam {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 320%;
    height: 320%;
    transform: translate(-50%, -50%) rotate(0deg);
    will-change: transform;
    background: conic-gradient(
      from 0deg at 50% 50%,
      transparent 0deg,
      transparent 260deg,
      rgba(0, 243, 255, 0.2) 290deg,
      #00f3ff 330deg,
      #0070ff 348deg,
      #00f3ff 360deg
    );
    animation: facSpinNeonCorners 4.5s linear infinite;
    filter: drop-shadow(0 0 10px #00f3ff) drop-shadow(0 0 22px rgba(0, 243, 255, 0.85));
  }

  @keyframes facSpinNeonCorners {
    0% {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    100% {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  .fac-search-wrapper:hover .fac-neon-orbit-beam {
    animation-duration: 3.2s;
    filter: drop-shadow(0 0 14px #00f3ff) drop-shadow(0 0 30px rgba(0, 243, 255, 0.95));
  }

  .fac-search-wrapper:focus-within .fac-neon-orbit-beam {
    animation-duration: 2.8s;
    filter: drop-shadow(0 0 18px #00f3ff) drop-shadow(0 0 35px #00f3ff);
  }

  .fac-search-wrapper:focus-within {
    box-shadow: 
      0 0 0 1px rgba(56, 189, 248, 0.25),
      0 8px 24px -4px rgba(56, 189, 248, 0.12),
      0 2px 6px -1px rgba(0, 0, 0, 0.04);
  }

  /* ==========================================================================
     Masterpiece Typewriter Suggestion Typography & Cursor
     ========================================================================== */
  .fac-typewriter-container {
    mask-image: linear-gradient(90deg, transparent 0%, #000 2%, #000 98%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 2%, #000 98%, transparent 100%);
  }

  .fac-typewriter-text {
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  .fac-typewriter-cursor {
    animation: facCursorBlink 0.95s ease-in-out infinite;
    box-shadow: 0 0 6px rgba(0, 243, 255, 0.6);
  }

  @keyframes facCursorBlink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fac-neon-orbit-beam,
    .fac-typewriter-cursor {
      animation: none !important;
      opacity: 0.9 !important;
    }
  }
</style>

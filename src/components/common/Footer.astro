---
// src/components/common/Footer.astro
const currentYear = new Date().getFullYear();

const categories = [
  {
    title: 'Finance',
    links: [
      { label: 'Mortgage Calculator', href: '/finance/mortgage-calculator/' },
      { label: 'Compound Interest', href: '/finance/compound-interest-calculator/' },
      { label: 'EMI Calculator', href: '/finance/emi-calculator/' },
      { label: 'Loan Amortization', href: '/finance/amortization-calculator/' },
      { label: 'All 16 Finance Tools →', href: '/finance/' },
    ],
  },
  {
    title: 'Health & Fitness',
    links: [
      { label: 'Calorie & TDEE', href: '/health/calorie-calculator/' },
      { label: 'BMI Calculator', href: '/health/bmi-calculator/' },
      { label: 'Body Fat %', href: '/health/body-fat-calculator/' },
      { label: 'BMR Calculator', href: '/health/bmr-calculator/' },
      { label: 'All 9 Health Tools →', href: '/health/' },
    ],
  },
  {
    title: 'Math & Tools',
    links: [
      { label: 'Percentage Calculator', href: '/math/percentage-calculator/' },
      { label: 'Scientific Calculator', href: '/math/scientific-calculator/' },
      { label: 'Fraction Calculator', href: '/math/fraction-calculator/' },
      { label: 'Standard Deviation', href: '/math/standard-deviation-calculator/' },
      { label: 'All 7 Math Tools →', href: '/math/' },
    ],
  },
  {
    title: 'Everyday',
    links: [
      { label: 'Age Calculator', href: '/everyday/age-calculator/' },
      { label: 'Work Hours & Timesheet', href: '/everyday/hours-calculator/' },
      { label: 'Subnet Calculator', href: '/everyday/subnet-calculator/' },
      { label: 'Password Generator', href: '/everyday/password-generator/' },
      { label: 'All 10 Utility Tools →', href: '/everyday/' },
    ],
  },
  {
    title: 'Countries',
    links: [
      { label: 'India Calculators 🇮🇳', href: '/countries/india/' },
      { label: 'United States 🇺🇸', href: '/countries/united-states/' },
      { label: 'United Kingdom 🇬🇧', href: '/countries/united-kingdom/' },
      { label: 'Canada 🇨🇦', href: '/countries/canada/' },
      { label: 'Australia 🇦🇺', href: '/countries/australia/' },
      { label: 'Browse 100+ Nations →', href: '/countries/' },
    ],
  },
];
---

<footer class="mt-24 border-t border-hairline bg-canvas transition-colors">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 sm:gap-8">
      <!-- Brand & Mission Column -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2">
          <div class="flex h-6 w-6 items-center justify-center rounded-[5px] bg-ink text-canvas">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <rect x="4" y="2" width="16" height="20" rx="3"></rect>
              <line x1="8" y1="6" x2="16" y2="6"></line>
              <path d="M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M8 18h.01M12 18h.01"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold tracking-tight text-ink">Free Accurate Calculator</span>
        </a>
        <p class="mt-3 text-xs leading-relaxed text-body max-w-xs">
          Industrial-grade, instant calculators with client-side calculation processing, verified mathematical formulas, and international currency support.
        </p>
        <div class="mt-4 flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-elevated px-2.5 py-1 text-[11px] font-medium text-mute">
            <span class="h-1.5 w-1.5 rounded-full bg-cyan"></span> Edge Hosted (Cloudflare)
          </span>
        </div>
      </div>

      <!-- Links Columns -->
      {categories.map((col) => (
        <div>
          <h3 class="mono-eyebrow text-ink">{col.title}</h3>
          <ul class="mt-3 space-y-1">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-block py-1 text-xs text-body hover:text-ink transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="mt-12 border-t border-hairline pt-8">
      <p class="text-[11px] leading-relaxed text-mute">
        <strong>Disclaimer:</strong> All calculations provided by Free Accurate Calculator are intended strictly for educational, informational, and general planning purposes. Calculations do not constitute formal financial, tax, legal, or medical advice. Verify all critical results with a qualified professional before making contractual or clinical decisions.
      </p>
      <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mute">
        <p>© {currentYear} Free Accurate Calculator (freeaccuratecalculator.com). All rights reserved.</p>
        <div class="flex flex-wrap items-center gap-4 sm:gap-6">
          <a href="/about/" class="hover:text-ink transition-colors py-1">About Us</a>
          <a href="/privacy-policy/" class="hover:text-ink transition-colors py-1">Privacy Policy</a>
          <a href="/terms-of-use/" class="hover:text-ink transition-colors py-1">Terms of Use</a>
          <a href="/contact/" class="hover:text-ink transition-colors py-1">Contact Us</a>
        </div>
      </div>
    </div>
  </div>
</footer>

---
// src/components/common/Footer.astro
const currentYear = new Date().getFullYear();

const companyLinks = [
  { name: 'About Us', href: '/about/', icon: '👥' },
  { name: 'Contact Us', href: '/contact/', icon: '✉️' },
];

const legalLinks = [
  { name: 'Terms & Conditions', href: '/terms-of-use/', icon: '📜' },
  { name: 'Privacy Policy', href: '/privacy-policy/', icon: '🛡️' },
];
---

<footer class="mt-6 sm:mt-8 border-t border-hairline bg-canvas transition-colors">
  <div class="mx-auto max-w-7xl px-3 py-8 sm:px-6 lg:px-8 flex flex-col items-center justify-center text-center space-y-6">
    <!-- 1. Navigation Links in 3 Perfectly Aligned Tiers -->
    <nav aria-label="Footer Navigation" class="flex flex-col items-center justify-center gap-2.5 sm:gap-3 w-full max-w-md sm:max-w-lg mx-auto">
      <!-- Line 1: Big Featured Guides Box on Top -->
      <div class="w-full flex justify-center">
        <a
          href="/guides/"
          title="Browse All Guides"
          class="group relative flex items-center justify-center gap-3 w-full h-12 sm:h-14 rounded-2xl border border-hairline bg-canvas hover:bg-canvas-elevated hover:border-link/60 px-4 sm:px-6 text-sm sm:text-base font-semibold cursor-pointer transition-all duration-200 shadow-whisper hover:shadow-card hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link active:scale-[0.98]"
        >
          <span class="flex h-8 w-8 sm:h-9 sm:w-9 shrink-0 items-center justify-center rounded-full bg-canvas-elevated border border-hairline text-base sm:text-lg shadow-xs group-hover:scale-110 group-hover:bg-hairline-soft transition-transform">
            📚
          </span>
          <span class="font-semibold text-ink group-hover:text-link transition-colors whitespace-nowrap">
            Guides
          </span>
          <span class="w-2 h-2 rounded-full bg-cyan animate-pulse group-hover:bg-link transition-colors ml-1"></span>
          <svg class="h-3.5 w-3.5 text-mute group-hover:text-link group-hover:translate-x-0.5 transition-all" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

      <!-- Line 2: About Us, Contact Us (Equal Box Sizes, Centered Content) -->
      <div class="grid grid-cols-2 gap-2.5 sm:gap-3 w-full">
        {companyLinks.map((item) => (
          <a
            href={item.href}
            class="group relative flex items-center justify-center gap-2 sm:gap-2.5 w-full h-11 sm:h-12 rounded-xl border border-hairline bg-canvas hover:bg-canvas-elevated hover:border-mute px-2 sm:px-3 text-xs sm:text-sm font-medium cursor-pointer transition-all duration-150 shadow-whisper hover:shadow-card hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-link active:scale-[0.98]"
          >
            <span class="flex h-6 w-6 sm:h-7 sm:w-7 shrink-0 items-center justify-center rounded-full bg-canvas-elevated border border-hairline text-xs sm:text-sm shadow-xs group-hover:scale-110 group-hover:bg-hairline-soft transition-transform">
              {item.icon}
            </span>
            <span class="font-medium text-ink group-hover:text-link transition-colors whitespace-nowrap text-center">
              {item.name}
            </span>
            <span class="w-1.5 h-1.5 rounded-full bg-hairline group-hover:bg-link transition-colors shrink-0"></span>
          </a>
        ))}
      </div>

      <!-- Line 3: Terms & Conditions, Privacy Policy (Equal Box Sizes, Centered Content) -->
      <div class="grid grid-cols-2 gap-2.5 sm:gap-3 w-full">
        {legalLinks.map((item) => (
          <a
            href={item.href}
            class="group relative flex items-center justify-center gap-2 sm:gap-2.5 w-full h-11 sm:h-12 rounded-xl border border-hairline bg-canvas hover:bg-canvas-elevated hover:border-mute px-2 sm:px-3 text-xs sm:text-sm font-medium cursor-pointer transition-all duration-150 shadow-whisper hover:shadow-card hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-link active:scale-[0.98]"
          >
            <span class="flex h-6 w-6 sm:h-7 sm:w-7 shrink-0 items-center justify-center rounded-full bg-canvas-elevated border border-hairline text-xs sm:text-sm shadow-xs group-hover:scale-110 group-hover:bg-hairline-soft transition-transform">
              {item.icon}
            </span>
            <span class="font-medium text-ink group-hover:text-link transition-colors whitespace-nowrap text-center">
              {item.name}
            </span>
            <span class="w-1.5 h-1.5 rounded-full bg-hairline group-hover:bg-link transition-colors shrink-0"></span>
          </a>
        ))}
      </div>
    </nav>

    <!-- 2. Tech Startup Style Architecture Statement -->
    <div class="border-t border-hairline/60 pt-5 w-full max-w-4xl mx-auto text-center">
      <p class="text-[11px] sm:text-xs md:text-sm text-ink/90 font-medium tracking-tight leading-relaxed max-w-2xl mx-auto">
        <span class="inline-flex items-center gap-1.5 align-baseline">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-cyan animate-pulse shrink-0"></span>
          <span>&copy; {currentYear} Free Accurate Calculator</span>
        </span>
        <span class="text-faint mx-1">&mdash;</span>
        <span>Engineered for Mathematical Accuracy, Zero Latency &amp; Complete Client-Side Privacy.</span>
      </p>
    </div>
  </div>
</footer>

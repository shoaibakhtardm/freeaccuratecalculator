---
// src/components/common/AdSlot.astro
interface Props {
  slotType?: 'leaderboard' | 'rectangle' | 'in-content' | 'sidebar';
  format?: 'horizontal' | 'rectangle' | 'sidebar';
  slotId?: string;
  className?: string;
}

const {
  slotType: propSlotType,
  format,
  slotId = 'FAC-AD-01',
  className = '',
} = Astro.props;

// Normalize format vs slotType prop
const effectiveSlotType: 'leaderboard' | 'rectangle' | 'in-content' | 'sidebar' =
  propSlotType || (format === 'horizontal' ? 'leaderboard' : (format as any)) || 'rectangle';

// Reserve exact sizes with responsive mobile dimensions to prevent Cumulative Layout Shift (CLS)
const sizeClasses = {
  leaderboard: 'w-full max-w-[728px] min-h-[50px] sm:min-h-[90px]',
  rectangle: 'w-full max-w-[300px] sm:max-w-[336px] min-h-[250px] sm:min-h-[280px]',
  sidebar: 'w-full max-w-[300px] min-h-[250px] sm:min-h-[600px]',
  'in-content': 'w-full max-w-[728px] min-h-[90px] sm:min-h-[120px]',
}[effectiveSlotType];
---

<div
  class={`ad-placeholder max-w-full overflow-hidden mx-auto flex flex-col items-center justify-center ${sizeClasses} ${className}`}
  data-ad-slot={slotId}
  data-ad-type={effectiveSlotType}
>
  <!-- AdSense injection target: clean & zero-clutter container -->
</div>

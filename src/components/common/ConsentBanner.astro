---
// src/components/common/ConsentBanner.astro
---

<div
  id="consent-banner"
  class="fixed bottom-2 left-2 right-2 sm:bottom-4 sm:left-4 sm:right-4 z-50 mx-auto max-w-xl hidden rounded-[12px] border border-hairline bg-canvas-elevated/95 p-4 shadow-2xl backdrop-blur-md transition-all duration-300"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie consent"
>
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-link"></span>
        <h3 class="text-xs font-semibold text-ink">Privacy & Cookies</h3>
      </div>
      <p class="text-xs text-body leading-relaxed">
        We use essential cookies and privacy-respecting analytics to optimize calculator precision and serve contextual ads in accordance with our
        <a href="/privacy-policy/" class="text-link hover:underline">Privacy Policy</a>.
      </p>
    </div>

    <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto">
      <button
        id="consent-reject-btn"
        type="button"
        class="flex-1 sm:flex-initial inline-flex items-center justify-center min-h-[44px] sm:min-h-[34px] rounded-[6px] border border-hairline bg-canvas-elevated px-3 py-2 text-xs font-medium text-ink hover:bg-hairline-soft transition-colors cursor-pointer"
      >
        Necessary Only
      </button>
      <button
        id="consent-accept-btn"
        type="button"
        class="flex-1 sm:flex-initial inline-flex items-center justify-center min-h-[44px] sm:min-h-[34px] rounded-[6px] bg-primary px-3.5 py-2 text-xs font-medium text-on-primary hover:opacity-90 transition-opacity cursor-pointer shadow-whisper"
      >
        Accept All
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const banner = document.getElementById('consent-banner');
    const acceptBtn = document.getElementById('consent-accept-btn');
    const rejectBtn = document.getElementById('consent-reject-btn');
    if (!banner || !acceptBtn || !rejectBtn) return;

    const consent = localStorage.getItem('fac_consent');
    if (!consent) {
      // Reveal banner smoothly after small delay
      setTimeout(() => {
        banner.classList.remove('hidden');
      }, 750);
    }

    const saveChoice = (choice) => {
      localStorage.setItem('fac_consent', choice);
      banner.classList.add('opacity-0', 'translate-y-4');
      setTimeout(() => {
        banner.classList.add('hidden');
      }, 300);
      window.dispatchEvent(new CustomEvent('consentchange', { detail: { consent: choice } }));
    };

    acceptBtn.addEventListener('click', () => saveChoice('accepted'));
    rejectBtn.addEventListener('click', () => saveChoice('essential_only'));
  })();
</script>

---
// src/components/LanguageSelector.astro
import { ALL_SUPPORTED_LOCALES, LOCALES, type SupportedLocale } from '../i18n/config';

export interface Props {
  className?: string;
  selectId?: string;
}

const { className = '', selectId = 'language-select' } = Astro.props;

// Current locale resolution
const currentLocale = (Astro.currentLocale || 'en').toLowerCase();

// Core languages formatted for the dropdown
const languages = ALL_SUPPORTED_LOCALES.map((code) => ({
  code,
  flag: LOCALES[code].flag,
  name: LOCALES[code].nativeName,
  englishName: LOCALES[code].name,
  short: LOCALES[code].short,
  dir: LOCALES[code].dir,
}));

const activeLang = languages.find((l) => l.code === currentLocale) || languages[0];
---

<div class={`fac-lang-wrapper relative inline-flex items-center notranslate shrink-0 ${className}`}>
  <!-- Trigger Button: Globe Icon + Flag + Full Language Name + Chevron -->
  <button
    type="button"
    class="fac-lang-btn group relative flex items-center justify-between gap-1.5 sm:gap-2 px-2.5 sm:px-3.5 rounded-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white/85 dark:bg-slate-900/85 hover:bg-slate-50 dark:hover:bg-slate-800/90 hover:border-indigo-500/40 dark:hover:border-indigo-400/40 shadow-xs hover:shadow-md hover:shadow-indigo-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-950 min-h-[44px] sm:min-h-[38px] h-11 sm:h-9 cursor-pointer transition-all duration-300 select-none min-w-[120px] sm:min-w-[145px]"
    aria-label="Select Language"
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
      <!-- Globe Icon -->
      <span class="text-slate-400 dark:text-slate-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 items-center shrink-0 pointer-events-none transition-colors duration-200" aria-hidden="true">
        <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </span>

      <!-- Flag Emoji -->
      <span class="fac-active-flag text-sm select-none leading-none shrink-0" aria-hidden="true">
        {activeLang.flag}
      </span>

      <!-- Active Language: Full Name -->
      <span class="fac-active-name font-semibold text-xs text-slate-800 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">
        {activeLang.name}
      </span>
    </div>

    <!-- Chevron Down with Smooth 180deg Flip -->
    <svg
      class="fac-chevron pointer-events-none h-3.5 w-3.5 text-slate-400 dark:text-slate-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-transform duration-200 ease-out shrink-0 ml-1"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
        clip-rule="evenodd"
      />
    </svg>
  </button>

  <!-- Animated Dropdown Menu Panel -->
  <div
    class="fac-lang-dropdown absolute right-0 top-full mt-2 w-64 max-h-[80vh] overflow-y-auto rounded-2xl border border-gray-200/90 dark:border-gray-800 bg-white/95 dark:bg-gray-900/95 backdrop-blur-xl shadow-xl shadow-gray-900/10 dark:shadow-black/50 p-1.5 z-50 transition-all duration-200 ease-out origin-top-right transform opacity-0 scale-95 -translate-y-1 pointer-events-none invisible"
    role="listbox"
    aria-label="Languages"
  >
    <!-- Search Language Header with Search Box & Counter -->
    <div class="p-1.5 border-b border-gray-100 dark:border-gray-800/80 mb-1 space-y-1.5">
      <div class="flex items-center px-1 text-[10px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">
        <span class="flex items-center gap-1.5 text-slate-800 dark:text-slate-200">
          <span class="text-xs">🔍</span>
          <span>Search Language</span>
        </span>
      </div>

      <!-- Search Input with Clear Button -->
      <div class="relative flex items-center">
        <span class="absolute left-2.5 text-xs text-slate-400 pointer-events-none select-none">🌐</span>
        <input
          type="search"
          class="fac-lang-search-input w-full pl-7 pr-7 py-1.5 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 dark:focus:border-indigo-400 transition-all"
          placeholder="Search language (e.g. Hindi, es)..."
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="button"
          class="fac-lang-search-clear hidden absolute right-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xs p-0.5 rounded-full cursor-pointer"
          aria-label="Clear language search"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- Options List Container with Realtime Search Filtering -->
    <div class="fac-lang-options-list max-h-[240px] overflow-y-auto space-y-0.5 pr-0.5">
      {languages.map((lang) => {
        const isCurrent = lang.code === currentLocale;
        const searchKeywords = `${lang.name} ${lang.englishName} ${lang.code} ${lang.short}`.toLowerCase();
        return (
          <button
            type="button"
            data-code={lang.code}
            data-search={searchKeywords}
            role="option"
            aria-selected={isCurrent ? 'true' : 'false'}
            class={`fac-lang-opt flex items-center justify-between w-full px-2.5 py-1.5 rounded-xl text-xs font-semibold transition-all duration-150 cursor-pointer ${
              isCurrent
                ? 'bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 font-bold'
                : 'text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800/80 hover:text-indigo-600 dark:hover:text-indigo-400'
            }`}
          >
            <span class="flex items-center gap-2 truncate">
              <span class="text-sm select-none shrink-0">{lang.flag}</span>
              <span class="truncate">{lang.name}</span>
              {lang.dir === 'rtl' && (
                <span class="text-[9px] font-bold uppercase px-1 py-0.2 bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 rounded shrink-0">
                  RTL
                </span>
              )}
            </span>
            <span class="font-mono text-[10px] font-bold uppercase px-1.5 py-0.5 rounded bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 shrink-0 ml-1">
              {lang.short}
            </span>
          </button>
        );
      })}

      <!-- Empty state when query does not match any language -->
      <div class="fac-no-lang hidden py-3 px-2 text-center text-xs text-slate-500 dark:text-slate-400 space-y-1">
        <span class="text-base">🔍</span>
        <p class="font-medium text-slate-700 dark:text-slate-300">No language found</p>
      </div>
    </div>
  </div>

  <!-- Hidden native select for automated test compatibility -->
  <select id={selectId} class="fac-language-select sr-only" aria-hidden="true" tabindex="-1">
    {languages.map((lang) => (
      <option value={lang.code} selected={lang.code === currentLocale}>
        {lang.flag} {lang.name}
      </option>
    ))}
  </select>
</div>

<script is:inline>
  (function () {
    const wrappers = document.querySelectorAll('.fac-lang-wrapper');
    if (!wrappers || wrappers.length === 0) return;

    // Detect currently active locale
    function getActiveLocale() {
      const path = window.location.pathname.toLowerCase();
      const match = path.match(/^\/(fr|de|es|ar|nl|pt|it|ru|ja|hi)(\/|$)/);
      if (match) return match[1];
      return localStorage.getItem('fac_locale') || 'en';
    }

    const currentActive = getActiveLocale();
    const langMeta = {
      en: { flag: '🇺🇸', name: 'English' },
      fr: { flag: '🇫🇷', name: 'Français' },
      de: { flag: '🇩🇪', name: 'Deutsch' },
      es: { flag: '🇪🇸', name: 'Español' },
      ar: { flag: '🇸🇦', name: 'العربية' },
      nl: { flag: '🇳🇱', name: 'Nederlands' },
      pt: { flag: '🇵🇹', name: 'Português' },
      it: { flag: '🇮🇹', name: 'Italiano' },
      ru: { flag: '🇷🇺', name: 'Русский' },
      ja: { flag: '🇯🇵', name: '日本語' },
      hi: { flag: '🇮🇳', name: 'हिन्दी' },
    };

    wrappers.forEach((wrapper) => {
      const btn = wrapper.querySelector('.fac-lang-btn');
      const dropdown = wrapper.querySelector('.fac-lang-dropdown');
      const chevron = wrapper.querySelector('.fac-chevron');
      const activeFlagSpan = wrapper.querySelector('.fac-active-flag');
      const activeNameSpan = wrapper.querySelector('.fac-active-name');
      const hiddenSelect = wrapper.querySelector('.fac-language-select');
      const options = wrapper.querySelectorAll('.fac-lang-opt');
      const openModalBtn = wrapper.querySelector('.fac-open-all-modal');
      const searchInput = wrapper.querySelector('.fac-lang-search-input');
      const clearSearchBtn = wrapper.querySelector('.fac-lang-search-clear');
      const counterBadge = wrapper.querySelector('.fac-lang-counter');
      const noLangBox = wrapper.querySelector('.fac-no-lang');
      const searchAllRegionsBtn = wrapper.querySelector('.fac-search-all-regions');

      // Sync active language flag & name in button
      if (langMeta[currentActive]) {
        if (activeFlagSpan) activeFlagSpan.textContent = langMeta[currentActive].flag;
        if (activeNameSpan) activeNameSpan.textContent = langMeta[currentActive].name;
      }
      if (hiddenSelect) {
        hiddenSelect.value = currentActive;
      }

      // Live search and filter logic
      function filterLanguages() {
        if (!searchInput) return;
        const q = searchInput.value.trim().toLowerCase();

        if (clearSearchBtn) {
          clearSearchBtn.classList.toggle('hidden', q.length === 0);
        }

        let matchCount = 0;
        options.forEach((opt) => {
          const searchKeywords = opt.getAttribute('data-search') || '';
          const matches = q.length === 0 || searchKeywords.includes(q);
          opt.classList.toggle('hidden', !matches);
          if (matches) matchCount++;
        });

        if (noLangBox) {
          noLangBox.classList.toggle('hidden', matchCount > 0);
        }


      }

      if (searchInput) {
        searchInput.addEventListener('input', filterLanguages);
        searchInput.addEventListener('click', (e) => e.stopPropagation());
        searchInput.addEventListener('keydown', (e) => {
          e.stopPropagation();
          if (e.key === 'Enter') {
            e.preventDefault();
            const firstVisible = Array.from(options).find((opt) => !opt.classList.contains('hidden'));
            if (firstVisible) {
              firstVisible.click();
            }
          } else if (e.key === 'Escape') {
            closeDropdown();
          }
        });
      }

      if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (searchInput) {
            searchInput.value = '';
            filterLanguages();
            searchInput.focus();
          }
        });
      }

      if (searchAllRegionsBtn) {
        searchAllRegionsBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          closeDropdown();
          if (typeof window.facOpenLanguageModal === 'function') {
            window.facOpenLanguageModal();
          }
        });
      }

      function openDropdown() {
        if (!dropdown || !btn) return;
        btn.setAttribute('aria-expanded', 'true');
        dropdown.classList.remove('opacity-0', 'scale-95', '-translate-y-1', 'pointer-events-none', 'invisible');
        dropdown.classList.add('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto', 'visible');
        if (chevron) chevron.classList.add('rotate-180');
        setTimeout(() => {
          if (searchInput) searchInput.focus();
        }, 50);
      }

      function closeDropdown() {
        if (!dropdown || !btn) return;
        btn.setAttribute('aria-expanded', 'false');
        dropdown.classList.remove('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto', 'visible');
        dropdown.classList.add('opacity-0', 'scale-95', '-translate-y-1', 'pointer-events-none', 'invisible');
        if (chevron) chevron.classList.remove('rotate-180');
        if (searchInput) {
          searchInput.value = '';
          filterLanguages();
        }
      }

      function toggleDropdown(e) {
        e.stopPropagation();
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          closeDropdown();
        } else {
          // Close any other open dropdowns first
          document.querySelectorAll('.fac-lang-dropdown.visible').forEach((d) => {
            d.classList.remove('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto', 'visible');
            d.classList.add('opacity-0', 'scale-95', '-translate-y-1', 'pointer-events-none', 'invisible');
          });
          document.querySelectorAll('.fac-lang-btn[aria-expanded="true"]').forEach((b) => {
            b.setAttribute('aria-expanded', 'false');
          });
          openDropdown();
        }
      }

      btn.addEventListener('click', toggleDropdown);

      if (openModalBtn) {
        openModalBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          closeDropdown();
          if (typeof window.facOpenLanguageModal === 'function') {
            window.facOpenLanguageModal();
          }
        });
      }

      // Handle language option selection
      options.forEach((opt) => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const targetLang = opt.getAttribute('data-code');
          if (!targetLang) return;

          closeDropdown();

          if (hiddenSelect) {
            hiddenSelect.value = targetLang;
          }

          try {
            localStorage.setItem('fac_locale', targetLang);
            localStorage.setItem('preferred_locale', targetLang);
          } catch (_) {}

          if (typeof window.facSetActiveLanguage === 'function') {
            window.facSetActiveLanguage(targetLang);
          } else {
            const currentPath = window.location.pathname;
            const cleanPath = currentPath.replace(/^\/(fr|de|es|ar|nl|pt|it|ru|ja|hi)(\/|$)/i, '/') || '/';
            let targetPath = '';
            if (targetLang === 'en') {
              targetPath = cleanPath;
            } else {
              targetPath = `/${targetLang}${cleanPath === '/' ? '/' : cleanPath}`;
            }
            if (!targetPath.endsWith('/') && !targetPath.includes('.')) targetPath += '/';
            window.location.href = targetPath + window.location.search;
          }
        });
      });
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      wrappers.forEach((w) => {
        if (!w.contains(e.target)) {
          const btn = w.querySelector('.fac-lang-btn');
          const dropdown = w.querySelector('.fac-lang-dropdown');
          const chevron = w.querySelector('.fac-chevron');
          if (btn && dropdown) {
            btn.setAttribute('aria-expanded', 'false');
            dropdown.classList.remove('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto', 'visible');
            dropdown.classList.add('opacity-0', 'scale-95', '-translate-y-1', 'pointer-events-none', 'invisible');
            if (chevron) chevron.classList.remove('rotate-180');
          }
        }
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        wrappers.forEach((w) => {
          const btn = w.querySelector('.fac-lang-btn');
          const dropdown = w.querySelector('.fac-lang-dropdown');
          const chevron = w.querySelector('.fac-chevron');
          if (btn && dropdown) {
            btn.setAttribute('aria-expanded', 'false');
            dropdown.classList.remove('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto', 'visible');
            dropdown.classList.add('opacity-0', 'scale-95', '-translate-y-1', 'pointer-events-none', 'invisible');
            if (chevron) chevron.classList.remove('rotate-180');
          }
        });
      }
    });
  })();
</script>

---
import { LOCALES, SUPPORTED_LOCALES } from '../i18n/localeConfig';
import type { SupportedLocale } from '../types/i18n';

interface Props {
  locale?: SupportedLocale;
}

const currentLocale = Astro.props.locale || 'en';
---

<div class="relative" id="country-selector">
  <button 
    id="country-btn"
    class="flex items-center gap-2 px-3 py-2 rounded-lg border border-hairline bg-canvas hover:bg-canvas-elevated transition-colors min-h-[44px]"
    aria-label="Select language"
    aria-expanded="false"
    aria-haspopup="listbox"
  >
    <span class="text-lg" aria-hidden="true">{LOCALES[currentLocale as SupportedLocale]?.flag}</span>
    <span class="text-sm font-medium hidden sm:inline">{LOCALES[currentLocale as SupportedLocale]?.name}</span>
    <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>
  
  <div 
    id="country-dropdown"
    class="absolute right-0 mt-2 w-64 bg-canvas-elevated border border-hairline rounded-lg shadow-lg hidden z-50 max-h-96 overflow-y-auto"
    role="listbox"
    aria-label="Available languages"
  >
    <div class="p-2">
      {SUPPORTED_LOCALES.map((code) => {
        const config = LOCALES[code];
        const isActive = code === currentLocale;
        return (
          <button
            class={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-canvas transition-colors text-left min-h-[44px] ${
              isActive ? 'bg-canvas font-semibold' : ''
            }`}
            data-locale={code}
            role="option"
            aria-selected={isActive}
          >
            <span class="text-xl" aria-hidden="true">{config.flag}</span>
            <div class="flex-1">
              <div class="text-sm font-medium">{config.name}</div>
              <div class="text-xs text-mute">{config.englishName}</div>
            </div>
            {isActive && (
              <svg class="w-4 h-4 text-cyan-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            )}
          </button>
        );
      })}
    </div>
  </div>
</div>

<script>
  import { initializeAutoDetection } from '../utils/countryDetector';
  
  initializeAutoDetection();
  
  const btn = document.getElementById('country-btn');
  const dropdown = document.getElementById('country-dropdown');
  const icon = btn?.querySelector('svg');
  
  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = dropdown?.classList.contains('hidden');
    dropdown?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(isHidden));
    icon?.classList.toggle('rotate-180');
  });
  
  document.addEventListener('click', (e) => {
    if (!document.getElementById('country-selector')?.contains(e.target as Node)) {
      dropdown?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      icon?.classList.remove('rotate-180');
    }
  });
  
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      dropdown?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      icon?.classList.remove('rotate-180');
    }
  });
  
  dropdown?.querySelectorAll('[data-locale]').forEach((button) => {
    button.addEventListener('click', () => {
      const locale = (button as HTMLElement).dataset.locale;
      if (locale) {
        localStorage.setItem('fac_manual_locale_selection', 'true');
        const currentPath = window.location.pathname;
        const pathWithoutLocale = currentPath.replace(/^\/(en|fr|de|es|ar|nl|pt|it|ru|ja)(\/|$)/, '/') || '/';
        const newPath = locale === 'en' ? pathWithoutLocale : `/${locale}${pathWithoutLocale === '/' ? '' : pathWithoutLocale}`;
        window.location.href = newPath;
      }
    });
  });
</script>

---
// src/components/CalculatorComparison.astro
export interface ComparisonItem {
  name: string;
  slug: string;
  description: string;
  pros: string[];
  cons: string[];
}

interface Props {
  calculators: ComparisonItem[];
}

const { calculators = [] } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
  {calculators.map((calc) => {
    const cleanHref = calc.slug.startsWith('/') ? calc.slug : `/${calc.slug}`;
    const finalHref = cleanHref.endsWith('/') ? cleanHref : `${cleanHref}/`;

    return (
      <div class="flex flex-col justify-between border border-gray-200 dark:border-hairline bg-white dark:bg-canvas-elevated rounded-xl p-6 shadow-whisper hover:shadow-lg transition-all">
        <div>
          <h3 class="text-xl font-bold mb-2 text-ink">{calc.name}</h3>
          <p class="text-sm text-gray-600 dark:text-body mb-5 leading-relaxed">{calc.description}</p>
          
          <div class="space-y-2 mb-4">
            <h4 class="font-semibold text-xs font-mono uppercase tracking-wider text-green-600 dark:text-emerald-400 flex items-center gap-1.5">
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Advantages / Pros:</span>
            </h4>
            <ul class="space-y-1.5 text-xs sm:text-sm text-gray-700 dark:text-body pl-2">
              {calc.pros.map((pro) => (
                <li class="flex items-start gap-2">
                  <span class="text-green-500 font-bold">•</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          </div>
          
          <div class="space-y-2 mb-6">
            <h4 class="font-semibold text-xs font-mono uppercase tracking-wider text-red-600 dark:text-rose-400 flex items-center gap-1.5">
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span>Limitations / Cons:</span>
            </h4>
            <ul class="space-y-1.5 text-xs sm:text-sm text-gray-700 dark:text-body pl-2">
              {calc.cons.map((con) => (
                <li class="flex items-start gap-2">
                  <span class="text-red-500 font-bold">•</span>
                  <span>{con}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        
        <div class="pt-4 border-t border-gray-100 dark:border-hairline">
          <a
            href={finalHref}
            class="inline-flex items-center justify-center gap-2 w-full sm:w-auto bg-cyan-600 hover:bg-cyan-700 text-white font-semibold text-sm px-5 py-2.5 rounded-lg transition-colors shadow-xs"
          >
            <span>Try {calc.name}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    );
  })}
</div>

---
import '../styles/critical.css';
import '../styles/global.css';
import '../styles/rtl.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import ConsentBanner from '../components/common/ConsentBanner.astro';
import Toast from '../components/common/Toast.astro';
import LanguageCountryModal from '../components/LanguageCountryModal.astro';
import LocaleDetectionToast from '../components/common/LocaleDetectionToast.astro';
import LocalizedCalculatorBridge from '../components/calculator/LocalizedCalculatorBridge.astro';
import CountrySelector from '../components/CountrySelector.astro';
import { EXCHANGE_RATE_SNAPSHOT } from '../data/exchangeRates';
import { getLocaleDirection, ALL_SUPPORTED_LOCALES } from '../i18n/config';
import { LOCALES, DEFAULT_LOCALE } from '../i18n/localeConfig';
import type { SupportedLocale } from '../types/i18n';

interface Props {
  title: string;
  description?: string;
  metaDescription?: string;
  canonicalUrl?: string;
  image?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
  lang?: string;
  locale?: SupportedLocale;
}

const siteOrigin = 'https://freeaccuratecalculator.com';
const pathname = Astro.url.pathname;
const normalizedPathname = pathname.endsWith('/') ? pathname : `${pathname}/`;

const {
  title,
  description,
  metaDescription,
  canonicalUrl = `${siteOrigin}${normalizedPathname}`,
  image = `${siteOrigin}/og-image.svg`,
  jsonLd,
  noindex = false,
  lang,
  locale,
} = Astro.props;

const pageDescription = metaDescription || description || 'Free, accurate online calculators for finance, health, math, and everyday calculations.';
const socialImage = image.startsWith('http') ? image : `${siteOrigin}${image.startsWith('/') ? image : `/${image}`}`;

// Ensure any passed-in canonicalUrl using localhost is normalized to production siteOrigin
const finalCanonical = canonicalUrl.includes('localhost')
  ? `${siteOrigin}${normalizedPathname}`
  : canonicalUrl;

const currentLocale = (locale || lang || Astro.currentLocale || DEFAULT_LOCALE) as SupportedLocale;
const localeConfig = LOCALES[currentLocale] || LOCALES[DEFAULT_LOCALE];
const currentDir = localeConfig.dir || getLocaleDirection(currentLocale);
const siteName = 'Free Accurate Calculator';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// Compute technical SEO hreflangs
const cleanPath = pathname.replace(/^\/(fr|de|es|ar|nl|pt|it|ru|ja|hi|zh)(\/|$)/i, '/');
const normalizedPath = cleanPath.startsWith('/') ? cleanPath : `/${cleanPath}`;

const hreflangLinks = [
  { lang: 'en', href: `${siteOrigin}${normalizedPath}` },
  { lang: 'fr', href: `${siteOrigin}/fr${normalizedPath === '/' ? '/' : normalizedPath}` },
  { lang: 'de', href: `${siteOrigin}/de${normalizedPath === '/' ? '/' : normalizedPath}` },
  { lang: 'es', href: `${siteOrigin}/es${normalizedPath === '/' ? '/' : normalizedPath}` },
  { lang: 'ar', href: `${siteOrigin}/ar${normalizedPath === '/' ? '/' : normalizedPath}` },
  { lang: 'nl', href: `${siteOrigin}/nl${normalizedPath === '/' ? '/' : normalizedPath}` },
  { lang: 'pt', href: `${siteOrigin}/pt${normalizedPath === '/' ? '/' : normalizedPath}` },
  { lang: 'it', href: `${siteOrigin}/it${normalizedPath === '/' ? '/' : normalizedPath}` },
  { lang: 'ru', href: `${siteOrigin}/ru${normalizedPath === '/' ? '/' : normalizedPath}` },
  { lang: 'ja', href: `${siteOrigin}/ja${normalizedPath === '/' ? '/' : normalizedPath}` },
  { lang: 'zh', href: `${siteOrigin}/zh${normalizedPath === '/' ? '/' : normalizedPath}` },
  { lang: 'x-default', href: `${siteOrigin}${normalizedPath}` },
];

const ogLocaleMap: Record<string, string> = {
  en: 'en_US',
  fr: 'fr_FR',
  de: 'de_DE',
  es: 'es_ES',
  ar: 'ar_SA',
  nl: 'nl_NL',
  pt: 'pt_PT',
  it: 'it_IT',
  ru: 'ru_RU',
  ja: 'ja_JP',
  hi: 'hi_IN',
};
const ogLocale = ogLocaleMap[currentLocale] || 'en_US';
---

<!doctype html>
<html lang={currentLocale} dir={currentDir} class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FHX771KJTN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-FHX771KJTN');

      // Global calculator analytics tracking helper
      window.facTrackCalc = function(calculatorName, details) {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'calculator_used', {
            calculator_name: calculatorName,
            currency: window.facCurrentCurrency || 'USD',
            ...details,
          });
        }
      };
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0070f3" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preconnect & DNS-Prefetch to external domains for sub-second DNS resolution -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;600;700;800&family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;600;700;800&family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;600;700;800&family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    </noscript>

    <!-- Inline Critical Above-The-Fold CSS (0ms FCP, 0.00 CLS) -->
    <style is:inline>
      body { margin: 0; font-family: 'Plus Jakarta Sans', 'Cairo', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
      .calculator-container { max-width: 1280px; margin: 0 auto; padding: 1.5rem; }
      .result-display { background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); }
      .dark .result-display { background: linear-gradient(135deg, #141414 0%, #1e293b 100%); }
    </style>

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={finalCanonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}

    <!-- Multilingual Hreflang SEO -->
    {hreflangLinks.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
    ))}

    <script is:inline>
      const currentLocale = document.documentElement.lang || 'en';
      import(`/src/i18n/locales/${currentLocale}.json`).then((translations) => {
        window.__translations = {
          [currentLocale]: translations.default || translations
        };
      }).catch(() => {});
    </script>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={finalCanonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={finalCanonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <!-- Anti-FOUT Dark Mode Script: Runs immediately before paint -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>

    <!-- Global Currency Engine & Live/Snapshot State -->
    <script is:inline define:vars={{ exchangeSnapshot: EXCHANGE_RATE_SNAPSHOT }}>
      (function () {
        try {
          const currencyMap = {
            USD: { symbol: '$', name: 'US Dollar', isIndian: false, decimals: 2, locale: 'en-US' },
            INR: { symbol: '₹', name: 'Indian Rupee', isIndian: true, decimals: 2, locale: 'en-IN' },
            EUR: { symbol: '€', name: 'Euro', isIndian: false, decimals: 2, locale: 'de-DE' },
            GBP: { symbol: '£', name: 'British Pound', isIndian: false, decimals: 2, locale: 'en-GB' },
            CAD: { symbol: 'C$', name: 'Canadian Dollar', isIndian: false, decimals: 2, locale: 'en-CA' },
            AUD: { symbol: 'A$', name: 'Australian Dollar', isIndian: false, decimals: 2, locale: 'en-AU' },
            JPY: { symbol: '¥', name: 'Japanese Yen', isIndian: false, decimals: 0, locale: 'ja-JP' },
            CNY: { symbol: '¥', name: 'Chinese Yuan', isIndian: false, decimals: 2, locale: 'zh-CN' },
            SGD: { symbol: 'S$', name: 'Singapore Dollar', isIndian: false, decimals: 2, locale: 'en-SG' },
            AED: { symbol: 'د.إ', name: 'UAE Dirham', isIndian: false, decimals: 2, locale: 'ar-AE' },
            SAR: { symbol: 'ر.स', name: 'Saudi Riyal', isIndian: false, decimals: 2, locale: 'ar-SA' },
            CHF: { symbol: 'CHF', name: 'Swiss Franc', isIndian: false, decimals: 2, locale: 'de-CH' },
            NZD: { symbol: 'NZ$', name: 'New Zealand Dollar', isIndian: false, decimals: 2, locale: 'en-NZ' },
            ZAR: { symbol: 'R', name: 'South African Rand', isIndian: false, decimals: 2, locale: 'en-ZA' },
          };

          window.__facExchangeSnapshot = exchangeSnapshot;

          function detect() {
            const langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
            for (const l of langs) {
              const loc = (l || '').toLowerCase().trim();
              if (loc.endsWith('-in') || loc.includes('-in-') || loc === 'hi' || loc.startsWith('hi-')) return 'INR';
              if (loc.endsWith('-gb') || loc.endsWith('-uk')) return 'GBP';
              if (loc.endsWith('-ca')) return 'CAD';
              if (loc.endsWith('-au')) return 'AUD';
              if (loc.endsWith('-jp') || loc === 'ja' || loc.startsWith('ja-')) return 'JPY';
              if (loc.endsWith('-cn') || loc === 'zh-cn') return 'CNY';
              if (loc.endsWith('-sg')) return 'SGD';
              if (loc.endsWith('-ae') || loc === 'ar-ae') return 'AED';
              if (loc.endsWith('-sa') || loc === 'ar-sa') return 'SAR';
              if (loc.endsWith('-ch')) return 'CHF';
              if (loc.endsWith('-nz')) return 'NZD';
              if (loc.endsWith('-za')) return 'ZAR';
              if (loc.endsWith('-us')) return 'USD';
              if (loc.endsWith('-de') || loc.endsWith('-fr') || loc.endsWith('-es') || loc.endsWith('-it') || loc.endsWith('-nl')) return 'EUR';
            }
            return 'USD';
          }

          // 1. Check URL param ?currency=
          const params = new URLSearchParams(window.location.search);
          const urlCurr = (params.get('currency') || '').toUpperCase();
          let currentCode = null;

          if (urlCurr && currencyMap[urlCurr]) {
            currentCode = urlCurr;
            localStorage.setItem('fac_currency', currentCode);
          } else {
            // 2. Check localStorage
            const stored = (localStorage.getItem('fac_currency') || '').toUpperCase();
            if (stored && currencyMap[stored]) {
              currentCode = stored;
            } else {
              // 3. Browser locale detection
              currentCode = detect();
              localStorage.setItem('fac_currency', currentCode);
            }
          }

          window.__facCurrency = currentCode;

          window.facGetActiveCurrency = function () {
            return window.__facCurrency || 'USD';
          };

          window.facGetCurrencyInfo = function (code) {
            const c = (code || window.facGetActiveCurrency()).toUpperCase();
            return currencyMap[c] || currencyMap.USD;
          };

          window.facGetExchangeRates = function () {
            return window.__facExchangeSnapshot;
          };

          window.facConvertCurrency = function (amount, fromCode, toCode) {
            if (isNaN(amount) || !isFinite(amount) || amount === 0) return 0;
            const from = (fromCode || 'USD').toUpperCase();
            const to = (toCode || 'USD').toUpperCase();
            if (from === to) return amount;
            const rates = (window.__facExchangeSnapshot && window.__facExchangeSnapshot.rates) || {};
            const rFrom = rates[from] || 1;
            const rTo = rates[to] || 1;
            return (amount / rFrom) * rTo;
          };

          window.facSetActiveCurrency = function (code) {
            const upper = (code || 'USD').toUpperCase();
            if (!currencyMap[upper]) return;
            const prev = window.__facCurrency || 'USD';
            window.__facCurrency = upper;
            localStorage.setItem('fac_currency', upper);

            // Sync all currency select elements on page
            document.querySelectorAll('.fac-currency-select').forEach((sel) => {
              if (sel.value !== upper) sel.value = upper;
            });
            document.querySelectorAll('.fac-currency-badge').forEach((badge) => {
              badge.textContent = currencyMap[upper].symbol;
            });

            // Dispatch global event with both new and previous currency
            window.dispatchEvent(
              new CustomEvent('currencychange', {
                detail: {
                  currency: upper,
                  prevCurrency: prev,
                  symbol: currencyMap[upper].symbol,
                  name: currencyMap[upper].name,
                  isIndian: currencyMap[upper].isIndian,
                  decimals: currencyMap[upper].decimals,
                },
              })
            );
          };

          // Native Locale Management (Independent from Currency)
          let savedLocale = (localStorage.getItem('fac_locale') || '').toLowerCase();
          const pathMatch = window.location.pathname.match(/^\/(fr|de|es|ar|nl|pt|it|ru|ja|hi)(\/|$)/i);
          if (pathMatch) {
            savedLocale = pathMatch[1].toLowerCase();
            localStorage.setItem('fac_locale', savedLocale);
          }
          if (!savedLocale) savedLocale = 'en';
          window.__facLanguage = savedLocale;

          window.facGetActiveLanguage = function () {
            return window.__facLanguage || localStorage.getItem('fac_locale') || 'en';
          };

          window.facSetActiveLanguage = function (code) {
            const target = (code || 'en').toLowerCase();
            window.__facLanguage = target;
            localStorage.setItem('fac_locale', target);

            // Sync all language dropdowns on page
            document.querySelectorAll('.fac-language-select').forEach((sel) => {
              if (sel.value !== target) sel.value = target;
            });

            // Navigate to the equivalent localized page cleanly, preserving query params
            const currentPath = window.location.pathname;
            const cleanPath = currentPath.replace(/^\/(fr|de|es|ar|nl|pt|it|ru|ja|hi)(\/|$)/i, '/') || '/';
            let targetPath = '';
            if (target === 'en') {
              targetPath = cleanPath;
            } else {
              targetPath = `/${target}${cleanPath === '/' ? '/' : cleanPath}`;
            }
            if (!targetPath.endsWith('/') && !targetPath.includes('.')) targetPath += '/';
            window.location.href = targetPath + window.location.search;
          };
        } catch (_) {}
      })();
    </script>

    <!-- Schema.org Structured Data -->
    {jsonLd && (
      Array.isArray(jsonLd) ? (
        jsonLd.map((schema) => (
          <script type="application/ld+json" set:html={JSON.stringify(schema)} />
        ))
      ) : (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    )}
  </head>

  <body class={`min-h-screen bg-canvas text-ink antialiased selection:bg-link-soft selection:text-link-deep dark:selection:bg-link-deep dark:selection:text-link-soft flex flex-col transition-colors duration-200 ${currentDir === 'rtl' ? 'rtl-layout' : ''}`}>
    <Header />

    <main class="flex-1 w-full max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 pt-6 pb-2 md:pt-10 md:pb-4">
      <slot />
    </main>

    <Footer />
    <ConsentBanner />
    <Toast />
    <LanguageCountryModal />
    <LocaleDetectionToast />
    <LocalizedCalculatorBridge locale={currentLocale as any} />

    <!-- Service Worker Registration for Instant PWA & Offline Access -->
    <script is:inline>
      if ('serviceWorker' in navigator && (window.location.protocol === 'https:' || window.location.hostname === 'localhost')) {
        window.addEventListener('load', function () {
          navigator.serviceWorker
            .register('/sw.js')
            .catch(function (err) {
              console.debug('[SW] Registration failed:', err);
            });
        });
      }
    </script>
  </body>
</html>

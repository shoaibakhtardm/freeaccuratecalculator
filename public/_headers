# Long cache + immutable for hashed assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Assets in public
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/ads.txt
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=86400

# HTML pages and root
/*
  Cache-Control: public, max-age=0, must-revalidate
